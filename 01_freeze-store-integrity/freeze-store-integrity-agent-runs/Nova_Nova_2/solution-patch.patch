+        newStore(description -> description + "-derived").initialize(propertiesOf(
+                "default.path", folder.getAbsolutePath(),
+                "default.allowStoreUpdate", "true",
+                "default.integrity", "repair"));
+
+        assertThat(new File(folder, "old")).doesNotExist();
+        assertThat(new File(folder, "rule-derived")).hasContent("violation\n");
+        assertThat(readIndex(index).getProperty("rule")).isEqualTo("rule-derived");
+    }
