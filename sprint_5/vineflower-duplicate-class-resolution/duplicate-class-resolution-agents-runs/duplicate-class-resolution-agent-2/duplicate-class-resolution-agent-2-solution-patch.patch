+  @Test
+  void literalDollarDoesNotCreateFamilyLink() throws IOException {
+    byte[] rootBytes = compile("dollar-root", "dollar.Root", "package dollar; public class Root { }").get("dollar/Root");
+    byte[] firstBytes = compile("dollar-first", "dollar.Root$Member", "package dollar; public class Root$Member { public int value() { return 1; } }").get("dollar/Root$Member");
+    byte[] lastBytes = compile("dollar-last", "dollar.Root$Member", "package dollar; public class Root$Member { public int value() { return 2; } }").get("dollar/Root$Member");
+
+    ClassResolver resolver = new ClassResolver(DuplicateClassStrategy.LAST);
+    ContextUnit root = unit("root", true, 0, Map.of("dollar/Root", rootBytes));
+    ContextUnit first = unit("dollar", true, 1, Map.of("dollar/Root$Member", firstBytes));
+    ContextUnit last = unit("dollar", true, 2, Map.of("dollar/Root$Member", lastBytes));
+    resolver.register(root);
+    resolver.register(first);
+    resolver.register(last);
+
+    ClassResolver.Selection selection = resolver.select("dollar/Root$Member");
+    assertSame(last, selection.origin());
+    assertEquals("dollar/Root$Member", selection.familyRoot());
