index 0000000..588253b
--- /dev/null
+++ b/src/org/jetbrains/java/decompiler/struct/ClassResolver.java
@@ -0,0 +1,347 @@
+package org.jetbrains.java.decompiler.struct;
+
+import org.jetbrains.annotations.Nullable;
+import org.jetbrains.java.decompiler.main.DecompilerContext;
+import org.jetbrains.java.decompiler.main.extern.IFernflowerLogger;
+import org.jetbrains.java.decompiler.struct.attr.StructEnclosingMethodAttribute;
+import org.jetbrains.java.decompiler.struct.attr.StructGeneralAttribute;
+import org.jetbrains.java.decompiler.struct.attr.StructInnerClassesAttribute;
+import org.jetbrains.java.decompiler.util.DataInputFullStream;
+
+import java.io.IOException;
+import java.util.*;
+
+final class ClassResolver {
+  record Selection(ContextUnit origin, byte[] bytes, @Nullable String familyRoot) { }
+
+  private final DuplicateClassStrategy strategy;
+  private final Map<String, List<ContextUnit>> registeredCandidates = new LinkedHashMap<>();
+  private final List<ContextUnit> units = new ArrayList<>();
+  private final Map<ContextUnit, Map<String, Optional<byte[]>>> byteCache = new IdentityHashMap<>();
+  private final Map<String, Optional<Selection>> selections = new HashMap<>();
+  private final Map<String, String> familyRoots = new HashMap<>();
+  private final Map<String, ContextUnit> familyAnchors = new HashMap<>();
+  private boolean familyMetadataInitialized;
+
+  ClassResolver(DuplicateClassStrategy strategy) {
+    this.strategy = strategy;
+  }
+
+  synchronized void register(ContextUnit unit) {
+    this.units.add(unit);
+    if (unit.isLazy()) {
+      this.selections.clear();
+      return;
+    }
+
+    Set<String> addedNames = new LinkedHashSet<>();
+    for (String className : unit.getClassNames()) {
+      List<ContextUnit> origins = this.registeredCandidates.computeIfAbsent(className, ignored -> new ArrayList<>());
+      if (!origins.contains(unit)) {
+        origins.add(unit);
+        addedNames.add(className);
+      }
+    }
+
+    if (unit.isOwn()) {
+      this.familyRoots.clear();
+      this.familyAnchors.clear();
+      this.familyMetadataInitialized = false;
+      this.selections.keySet().removeIf(this::hasRegisteredOwnCandidate);
+    } else {
+      addedNames.forEach(this.selections::remove);
+    }
+  }
+
+  synchronized void reset() {
+    this.registeredCandidates.clear();
+    this.units.clear();
+    this.invalidateDecisions();
+  }
+
+  synchronized @Nullable Selection select(String className) throws IOException {
+    Optional<Selection> cached = this.selections.get(className);
+    if (cached != null) {
+      return cached.orElse(null);
+    }
+
+    this.initializeFamilyMetadata();
+    Selection selection = this.selectUncached(className);
+    this.selections.put(className, Optional.ofNullable(selection));
+    return selection;
+  }
+
+  synchronized boolean isSelected(String className, ContextUnit origin) throws IOException {
+    Selection selection = this.select(className);
+    return selection != null && selection.origin() == origin;
+  }
+
+  synchronized List<String> getOwnClassNames() {
+    LinkedHashSet<String> names = new LinkedHashSet<>();
+    for (Map.Entry<String, List<ContextUnit>> entry : this.registeredCandidates.entrySet()) {
+      if (entry.getValue().stream().anyMatch(ContextUnit::isOwn)) {
+        names.add(entry.getKey());
+      }
+    }
+    return List.copyOf(names);
+  }
+
+  private boolean hasRegisteredOwnCandidate(String className) {
+    return this.registeredCandidates.getOrDefault(className, List.of()).stream().anyMatch(ContextUnit::isOwn);
+  }
+
+  private void invalidateDecisions() {
+    this.byteCache.clear();
+    this.selections.clear();
+    this.familyRoots.clear();
+    this.familyAnchors.clear();
+    this.familyMetadataInitialized = false;
+  }
+
+  private @Nullable Selection selectUncached(String className) throws IOException {
+    String familyRoot = this.familyRoots.get(className);
+    if (familyRoot != null) {
+      ContextUnit anchor = this.familyAnchors.get(familyRoot);
+      if (anchor == null && !familyRoot.equals(className)) {
+        Selection rootSelection = this.select(familyRoot);
+        if (rootSelection != null) {
+          anchor = rootSelection.origin();
+          this.familyAnchors.put(familyRoot, anchor);
+        }
+      }
+
+      List<Candidate> ownCandidates = this.availableCandidates(className, true);
+      if (anchor != null && !ownCandidates.isEmpty()) {
+        Candidate anchoredCandidate = null;
+        for (Candidate candidate : ownCandidates) {
+          if (candidate.origin() == anchor) {
+            anchoredCandidate = candidate;
+            break;
+          }
+        }
+        if (anchoredCandidate == null) {
+          throw this.familyConflict(familyRoot, className, anchor, ownCandidates);
+        }
+        this.rejectDifferingCandidates(className, ownCandidates, familyRoot);
+        Selection selection = new Selection(anchor, anchoredCandidate.bytes(), familyRoot);
+        this.logDecision(className, selection, ownCandidates);
+        return selection;
+      }
+
+      Selection selection = this.chooseNormally(className, familyRoot, ownCandidates);
+      if (selection != null) {
+        this.familyAnchors.putIfAbsent(familyRoot, selection.origin());
+      }
+      return selection;
+    }
+
+    return this.chooseNormally(className, null, this.availableCandidates(className, true));
+  }
+
+  private @Nullable Selection chooseNormally(String className, @Nullable String familyRoot, List<Candidate> ownCandidates) throws IOException {
+    List<Candidate> candidates = ownCandidates.isEmpty() ? this.availableCandidates(className, false) : ownCandidates;
+    if (candidates.isEmpty()) {
+      return null;
+    }
+
+    this.rejectDifferingCandidates(className, candidates, familyRoot);
+    Candidate selected = this.strategy == DuplicateClassStrategy.LAST ? candidates.get(candidates.size() - 1) : candidates.get(0);
+    Selection selection = new Selection(selected.origin(), selected.bytes(), familyRoot);
+    this.logDecision(className, selection, candidates);
+    return selection;
+  }
+
+  private List<Candidate> availableCandidates(String className, boolean own) throws IOException {
+    List<Candidate> candidates = new ArrayList<>();
+    Set<ContextUnit> seen = Collections.newSetFromMap(new IdentityHashMap<>());
+    List<ContextUnit> registered = this.registeredCandidates.getOrDefault(className, List.of());
+    for (ContextUnit origin : registered) {
+      if (origin.isOwn() == own && seen.add(origin)) {
+        byte[] bytes = this.getBytes(origin, className);
+        if (bytes != null) {
+          candidates.add(new Candidate(origin, bytes));
+        }
+      }
+    }
+
+    if (!own) {
+      for (ContextUnit origin : this.units) {
+        if (!origin.isOwn() && origin.isLazy() && seen.add(origin)) {
+          byte[] bytes = this.getBytes(origin, className);
+          if (bytes != null) {
+            candidates.add(new Candidate(origin, bytes));
+          }
+        }
+      }
+    }
+
+    candidates.sort(Comparator.comparingInt(candidate -> candidate.origin().getRegistrationOrder()));
+    return candidates;
+  }
+
+  private byte @Nullable [] getBytes(ContextUnit origin, String className) throws IOException {
+    Map<String, Optional<byte[]>> originCache = this.byteCache.computeIfAbsent(origin, ignored -> new HashMap<>());
+    Optional<byte[]> cached = originCache.get(className);
+    if (cached == null) {
+      cached = Optional.ofNullable(origin.getClassBytes(className));
+      originCache.put(className, cached);
+    }
+    return cached.orElse(null);
+  }
+
+  private void rejectDifferingCandidates(String className, List<Candidate> candidates, @Nullable String familyRoot) {
+    if (this.strategy != DuplicateClassStrategy.ERROR || !hasDifferingBytes(candidates)) {
+      return;
+    }
+
+    String message = "Duplicate class conflict for " + className +
+      " using strategy error; conflicting highest-tier origins: " + joinOrigins(candidates) +
+      "; metadata family root: " + displayFamilyRoot(familyRoot);
+    DecompilerContext.getLogger().writeMessage(message, IFernflowerLogger.Severity.ERROR);
+    throw new IllegalStateException(message);
+  }
+
+  private void logDecision(String className, Selection selection, List<Candidate> candidates) {
+    DecompilerContext.getLogger().writeMessage(
+      "Selected class " + className + " from " + selection.origin().getDisplayName() +
+        " using duplicate-class-strategy=" + this.strategy.optionValue() +
+        "; metadata family root: " + displayFamilyRoot(selection.familyRoot()),
+      IFernflowerLogger.Severity.INFO
+    );
+
+    if (candidates.size() < 2 || !hasDifferingBytes(candidates) || this.strategy == DuplicateClassStrategy.ERROR) {
+      return;
+    }
+
+    List<Candidate> ignored = candidates.stream().filter(candidate -> candidate.origin() != selection.origin()).toList();
+    DecompilerContext.getLogger().writeMessage(
+      "Duplicate class " + className + " resolved using strategy " + this.strategy.optionValue() +
+        "; selected origin: " + selection.origin().getDisplayName() +
+        "; ignored origins: " + joinOrigins(ignored) +
+        "; metadata family root: " + displayFamilyRoot(selection.familyRoot()),
+      IFernflowerLogger.Severity.WARN
+    );
+  }
+
+  private IllegalStateException familyConflict(String familyRoot, String member, ContextUnit anchor, List<Candidate> alternatives) {
+    String message = "Class family origin conflict; family root: " + familyRoot +
+      "; member: " + member +
+      "; anchored origin: " + anchor.getDisplayName() +
+      "; alternative origins: " + joinOrigins(alternatives);
+    DecompilerContext.getLogger().writeMessage(message, IFernflowerLogger.Severity.ERROR);
+    return new IllegalStateException(message);
+  }
+
+  private void initializeFamilyMetadata() throws IOException {
+    if (this.familyMetadataInitialized) {
+      return;
+    }
+    Set<String> duplicateOwnNames = new LinkedHashSet<>();
+    for (Map.Entry<String, List<ContextUnit>> entry : this.registeredCandidates.entrySet()) {
+      long ownOrigins = entry.getValue().stream().filter(ContextUnit::isOwn).distinct().count();
+      if (ownOrigins > 1) {
+        duplicateOwnNames.add(entry.getKey());
+      }
+    }
+    if (duplicateOwnNames.isEmpty()) {
+      this.familyMetadataInitialized = true;
+      return;
+    }
+
+    Map<String, String> parents = new LinkedHashMap<>();
+    Map<String, Set<String>> links = new LinkedHashMap<>();
+    for (Map.Entry<String, List<ContextUnit>> entry : this.registeredCandidates.entrySet()) {
+      for (ContextUnit origin : entry.getValue()) {
+        if (!origin.isOwn()) {
+          continue;
+        }
+        byte[] bytes = this.getBytes(origin, entry.getKey());
+        if (bytes == null) {
+          continue;
+        }
+        StructClass structClass = StructClass.create(new DataInputFullStream(bytes), true);
+        links.computeIfAbsent(structClass.qualifiedName, ignored -> new LinkedHashSet<>());
+
+        StructInnerClassesAttribute innerClasses = structClass.getAttribute(StructGeneralAttribute.ATTRIBUTE_INNER_CLASSES);
+        if (innerClasses != null) {
+          for (StructInnerClassesAttribute.Entry inner : innerClasses.getEntries()) {
+            if (inner.enclosingName != null) {
+              addFamilyLink(inner.innerName, inner.enclosingName, parents, links);
+            }
+          }
+        }
+
+        StructEnclosingMethodAttribute enclosingMethod = structClass.getAttribute(StructGeneralAttribute.ATTRIBUTE_ENCLOSING_METHOD);
+        if (enclosingMethod != null) {
+          addFamilyLink(structClass.qualifiedName, enclosingMethod.getClassName(), parents, links);
+        }
+      }
+    }
+
+    Set<String> activatedRoots = new HashSet<>();
+    for (String duplicateName : duplicateOwnNames) {
+      String root = findRoot(duplicateName, parents);
+      if (!activatedRoots.add(root)) {
+        continue;
+      }
+      Set<String> family = collectFamily(duplicateName, links);
+      for (String member : family) {
+        this.familyRoots.putIfAbsent(member, root);
+      }
+      this.familyRoots.putIfAbsent(root, root);
+    }
+    this.familyMetadataInitialized = true;
+  }
+
+  private static void addFamilyLink(String child, String parent, Map<String, String> parents, Map<String, Set<String>> links) {
+    parents.putIfAbsent(child, parent);
+    links.computeIfAbsent(child, ignored -> new LinkedHashSet<>()).add(parent);
+    links.computeIfAbsent(parent, ignored -> new LinkedHashSet<>()).add(child);
+  }
+
+  private static String findRoot(String className, Map<String, String> parents) {
+    String current = className;
+    Set<String> seen = new HashSet<>();
+    while (seen.add(current)) {
+      String parent = parents.get(current);
+      if (parent == null) {
+        return current;
+      }
+      current = parent;
+    }
+    return className;
+  }
+
+  private static Set<String> collectFamily(String className, Map<String, Set<String>> links) {
+    Set<String> family = new LinkedHashSet<>();
+    ArrayDeque<String> queue = new ArrayDeque<>();
+    queue.add(className);
+    while (!queue.isEmpty()) {
+      String current = queue.removeFirst();
+      if (family.add(current)) {
+        queue.addAll(links.getOrDefault(current, Set.of()));
+      }
+    }
+    return family;
+  }
+
+  private static boolean hasDifferingBytes(List<Candidate> candidates) {
+    byte[] first = candidates.get(0).bytes();
+    for (int i = 1; i < candidates.size(); i++) {
+      if (!Arrays.equals(first, candidates.get(i).bytes())) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  private static String joinOrigins(List<Candidate> candidates) {
+    return candidates.stream().map(candidate -> candidate.origin().getDisplayName()).reduce((left, right) -> left + ", " + right).orElse("<none>");
+  }
+
+  private static String displayFamilyRoot(@Nullable String familyRoot) {
+    return familyRoot == null ? "<none>" : familyRoot;
+  }
+
+  private record Candidate(ContextUnit origin, byte[] bytes) { }
+}
