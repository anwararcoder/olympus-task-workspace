+  @Test
+  void metadataDoesNotCombineOriginsWithoutDuplicateName() throws IOException {
+    Map<String, byte[]> family = compile(
+      "split-family",
+      "family.Split",
+      "package family; public class Split { public static class Member { } }"
+    );
+    ClassResolver resolver = new ClassResolver(DuplicateClassStrategy.ERROR);
+    ContextUnit root = unit("root", true, 0, Map.of("family/Split", family.get("family/Split")));
+    ContextUnit member = unit("member", true, 1, Map.of("family/Split$Member", family.get("family/Split$Member")));
