+  private ContextUnit unit(String name, boolean own, int order, Map<String, byte[]> classes) {
+    return new ContextUnit(new MemorySource(name, classes, false, null), own, true, order, null, null);
+  }
+
+  private Map<String, byte[]> compile(String directory, String binaryName, String source) throws IOException {
+    Path output = this.tempDir.resolve(directory);
+    Path sourceFile = output.resolve("src").resolve(binaryName.replace('.', '/') + ".java");
+    Files.createDirectories(sourceFile.getParent());
+    Files.writeString(sourceFile, source, StandardCharsets.UTF_8);
+    Path classes = output.resolve("classes");
+    Files.createDirectories(classes);
+
+    JavaCompiler compiler = ToolProvider.getSystemJavaCompiler();
+    assertNotNull(compiler);
+    assertEquals(0, compiler.run(null, null, null, "-g", "-d", classes.toString(), sourceFile.toString()));
+
+    Map<String, byte[]> result = new LinkedHashMap<>();
+    try (var paths = Files.walk(classes)) {
+      for (Path path : paths.filter(file -> file.toString().endsWith(".class")).sorted().toList()) {
+        String className = classes.relativize(path).toString().replace(path.getFileSystem().getSeparator(), "/");
+        result.put(className.substring(0, className.length() - IContextSource.CLASS_SUFFIX.length()), Files.readAllBytes(path));
+      }
+    }
+    return result;
+  }
+
+  private static final class MemorySource implements IContextSource {
+    private final String name;
+    private final Map<String, byte[]> classes;
+    private final boolean lazy;
+    private final AtomicInteger probes;
+
+    private MemorySource(String name, Map<String, byte[]> classes, boolean lazy, AtomicInteger probes) {
+      this.name = name;
+      this.classes = classes;
+      this.lazy = lazy;
+      this.probes = probes;
+    }
+
+    @Override
+    public String getName() {
+      return this.name;
+    }
+
+    @Override
+    public Entries getEntries() {
+      if (this.lazy) {
+        return Entries.EMPTY;
+      }
+      return new Entries(this.classes.keySet().stream().map(Entry::atBase).toList(), List.of(), List.of());
+    }
+
+    @Override
+    public boolean isLazy() {
+      return this.lazy;
+    }
+
+    @Override
+    public byte[] getClassBytes(String className) {
+      if (this.probes != null) {
+        this.probes.incrementAndGet();
+      }
+      return this.classes.get(className);
+    }
+
+    @Override
+    public InputStream getInputStream(String resource) {
+      String className = resource.endsWith(CLASS_SUFFIX) ? resource.substring(0, resource.length() - CLASS_SUFFIX.length()) : resource;
+      byte[] bytes = this.classes.get(className);
+      return bytes == null ? null : new ByteArrayInputStream(bytes);
+    }
+  }
+}
