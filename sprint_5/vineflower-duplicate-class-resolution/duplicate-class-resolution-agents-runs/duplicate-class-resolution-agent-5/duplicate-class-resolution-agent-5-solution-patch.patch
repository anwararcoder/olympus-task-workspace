--- /dev/null
+++ b/test/org/jetbrains/java/decompiler/struct/DuplicateClassResolutionTest.java
@@ -0,0 +1,254 @@
+package org.jetbrains.java.decompiler.struct;
+
+import org.jetbrains.java.decompiler.main.ClassesProcessor;
+import org.jetbrains.java.decompiler.main.DecompilerContext;
+import org.jetbrains.java.decompiler.main.Fernflower;
+import org.jetbrains.java.decompiler.main.extern.IContextSource;
+import org.jetbrains.java.decompiler.main.extern.IFernflowerLogger;
+import org.jetbrains.java.decompiler.main.extern.IFernflowerPreferences;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.Test;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.atomic.AtomicInteger;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class DuplicateClassResolutionTest {
+  private static final String TARGET = "duplicate/Target";
+  private static final String FAMILY_ROOT = "org/jetbrains/java/decompiler/struct/DuplicateFamilyOne";
+  private static final String FAMILY_MEMBER = FAMILY_ROOT + "$Member";
+
+  @AfterEach
+  void tearDown() {
+    DecompilerContext.setCurrentContext(null);
+  }
+
+  @Test
+  void rejectsInvalidStrategyBeforeCreatingContext() {
+    IllegalArgumentException exception = assertThrows(IllegalArgumentException.class, () ->
+      new Fernflower(null, Map.of(IFernflowerPreferences.DUPLICATE_CLASS_STRATEGY, "middle"), IFernflowerLogger.NO_OP));
+
+    assertTrue(exception.getMessage().contains("first, last, error"));
+  }
+
+  @Test
+  void defersResolutionAndUsesFirstOrLastOrigin() {
+    byte[] first = classBytes(FirstPayload.class);
+    byte[] last = classBytes(SecondPayload.class);
+
+    TestLogger firstLogger = new TestLogger();
+    StructContext firstContext = context(DuplicateClassStrategy.FIRST, firstLogger);
+    MemorySource firstSource = eager("same-name", Map.of(TARGET, first));
+    MemorySource lastSource = eager("same-name", Map.of(TARGET, last));
+    firstContext.addSpace(firstSource, true);
+    firstContext.addSpace(lastSource, true);
+    assertEquals(0, firstSource.reads.get());
+    assertEquals(0, lastSource.reads.get());
+    assertTrue(firstContext.getClass(TARGET).hasField("FIRST", "I"));
+    assertEquals(1, firstContext.getOwnClasses().size());
+    assertEquals(1, firstLogger.warnings.size());
+    assertTrue(firstLogger.warnings.get(0).contains("same-name [origin #1]"));
+    assertTrue(firstLogger.warnings.get(0).contains("same-name [origin #2]"));
+
+    TestLogger lastLogger = new TestLogger();
+    StructContext lastContext = context(DuplicateClassStrategy.LAST, lastLogger);
+    lastContext.addSpace(eager("same-name", Map.of(TARGET, first)), true);
+    lastContext.addSpace(eager("same-name", Map.of(TARGET, last)), true);
+    assertTrue(lastContext.getClass(TARGET).hasField("SECOND", "I"));
+    assertEquals(1, lastLogger.warnings.size());
+  }
+
+  @Test
+  void ownSourceOutranksLibrariesWithoutLazyProbe() {
+    StructContext context = context(DuplicateClassStrategy.LAST, new TestLogger());
+    MemorySource own = eager("own", Map.of(TARGET, classBytes(FirstPayload.class)));
+    MemorySource library = eager("library", Map.of(TARGET, classBytes(SecondPayload.class)));
+    MemorySource lazy = lazy("lazy", Map.of(TARGET, classBytes(SecondPayload.class)));
+    context.addSpace(library, false);
+    context.addSpace(lazy, false);
+    context.addSpace(own, true);
+
+    assertTrue(context.getClass(TARGET).hasField("FIRST", "I"));
+    assertEquals(0, lazy.reads.get());
+  }
+
+  @Test
+  void errorAllowsIdenticalBytesAndRejectsEveryDifferingOrigin() {
+    byte[] first = classBytes(FirstPayload.class);
+    StructContext identical = context(DuplicateClassStrategy.ERROR, new TestLogger());
+    identical.addSpace(eager("same-name", Map.of(TARGET, first)), true);
+    identical.addSpace(eager("same-name", Map.of(TARGET, first)), true);
+    assertNotNull(identical.getClass(TARGET));
+
+    StructContext differing = context(DuplicateClassStrategy.ERROR, new TestLogger());
+    differing.addSpace(eager("same-name", Map.of(TARGET, first)), true);
+    differing.addSpace(eager("same-name", Map.of(TARGET, classBytes(SecondPayload.class))), true);
+    IllegalStateException exception = assertThrows(IllegalStateException.class, () -> differing.getClass(TARGET));
+    assertTrue(exception.getMessage().contains("same-name [origin #1]"));
+    assertTrue(exception.getMessage().contains("same-name [origin #2]"));
+  }
+
+  @Test
+  void repeatedEntriesInOneOriginAreNotAConflict() {
+    StructContext context = context(DuplicateClassStrategy.ERROR, new TestLogger());
+    byte[] bytes = classBytes(FirstPayload.class);
+    MemorySource source = new MemorySource("repeated", List.of(TARGET, TARGET), Map.of(TARGET, bytes), false);
+    context.addSpace(source, true);
+
+    assertNotNull(context.getClass(TARGET));
+    assertEquals(1, source.reads.get());
+  }
+
+  @Test
+  void cachesLazyProbesUntilReload() throws IOException {
+    StructContext context = context(DuplicateClassStrategy.FIRST, new TestLogger());
+    MemorySource lazy = lazy("lazy", Map.of(TARGET, classBytes(FirstPayload.class)));
+    context.addSpace(lazy, false);
+
+    assertTrue(context.hasClass(TARGET));
+    assertTrue(context.hasClass(TARGET));
+    assertEquals(1, lazy.reads.get());
+
+    context.reloadContext();
+    assertTrue(context.hasClass(TARGET));
+    assertEquals(2, lazy.reads.get());
+  }
+
+  @Test
+  void familyRootAnchorsLaterMembers() {
+    StructContext context = context(DuplicateClassStrategy.LAST, new TestLogger());
+    context.addSpace(eager("root-origin", Map.of(
+      FAMILY_ROOT, classBytes(DuplicateFamilyOne.class),
+      FAMILY_MEMBER, classBytes(DuplicateFamilyOne.Member.class)
+    )), true);
+    context.addSpace(eager("member-origin", Map.of(
+      FAMILY_MEMBER, classBytes(DuplicateFamilyTwo.Member.class)
+    )), true);
+
+    assertTrue(context.getClass(FAMILY_MEMBER).hasField("FIRST", "I"));
+  }
+
+  @Test
+  void familyMemberMissingFromAnchorReportsAlternatives() {
+    StructContext context = context(DuplicateClassStrategy.FIRST, new TestLogger());
+    context.addSpace(eager("root-origin", Map.of(FAMILY_ROOT, classBytes(DuplicateFamilyOne.class))), true);
+    context.addSpace(eager("member-one", Map.of(FAMILY_MEMBER, classBytes(DuplicateFamilyOne.Member.class))), true);
+    context.addSpace(eager("member-two", Map.of(FAMILY_MEMBER, classBytes(DuplicateFamilyTwo.Member.class))), true);
+
+    IllegalStateException exception = assertThrows(IllegalStateException.class, () -> context.getClass(FAMILY_MEMBER));
+    assertTrue(exception.getMessage().contains(FAMILY_ROOT));
+    assertTrue(exception.getMessage().contains(FAMILY_MEMBER));
+    assertTrue(exception.getMessage().contains("root-origin [origin #1]"));
+    assertTrue(exception.getMessage().contains("member-one [origin #2]"));
+    assertTrue(exception.getMessage().contains("member-two [origin #3]"));
+  }
+
+  private static StructContext context(DuplicateClassStrategy strategy, IFernflowerLogger logger) {
+    StructContext context = new StructContext(null, null, null, strategy);
+    DecompilerContext.setCurrentContext(new DecompilerContext(
+      new HashMap<>(IFernflowerPreferences.DEFAULTS), logger, context, new ClassesProcessor(context), null));
+    return context;
+  }
+
+  private static MemorySource eager(String name, Map<String, byte[]> classes) {
+    return new MemorySource(name, List.copyOf(classes.keySet()), classes, false);
+  }
+
+  private static MemorySource lazy(String name, Map<String, byte[]> classes) {
+    return new MemorySource(name, List.of(), classes, true);
+  }
+
+  private static byte[] classBytes(Class<?> type) {
+    String resource = "/" + type.getName().replace('.', '/') + ".class";
+    try (InputStream stream = type.getResourceAsStream(resource)) {
+      assertNotNull(stream, resource);
+      return stream.readAllBytes();
+    } catch (IOException exception) {
+      throw new AssertionError(exception);
+    }
+  }
+
+  private static final class MemorySource implements IContextSource {
+    private final String name;
+    private final List<String> entries;
+    private final Map<String, byte[]> classes;
+    private final boolean lazy;
+    private final AtomicInteger reads = new AtomicInteger();
+
+    private MemorySource(String name, List<String> entries, Map<String, byte[]> classes, boolean lazy) {
+      this.name = name;
+      this.entries = entries;
+      this.classes = classes;
+      this.lazy = lazy;
+    }
+
+    @Override
+    public String getName() {
+      return this.name;
+    }
+
+    @Override
+    public Entries getEntries() {
+      return new Entries(this.entries.stream().map(Entry::atBase).toList(), List.of(), List.of());
+    }
+
+    @Override
+    public boolean isLazy() {
+      return this.lazy;
+    }
+
+    @Override
+    public byte[] getClassBytes(String className) {
+      this.reads.incrementAndGet();
+      return this.classes.get(className);
+    }
+
+    @Override
+    public InputStream getInputStream(String resource) {
+      return null;
+    }
+  }
+
+  private static final class TestLogger extends IFernflowerLogger {
+    private final List<String> warnings = new ArrayList<>();
+
+    @Override
+    public void writeMessage(String message, Severity severity) {
+      if (severity == Severity.WARN) {
+        this.warnings.add(message);
+      }
+    }
+
+    @Override
+    public void writeMessage(String message, Severity severity, Throwable throwable) {
+      writeMessage(message, severity);
+    }
+  }
+
+  static class FirstPayload {
+    static final int FIRST = 1;
+  }
+
+  static class SecondPayload {
+    static final int SECOND = 2;
+  }
+
+}
+
+class DuplicateFamilyOne {
+  static class Member {
+    static final int FIRST = 1;
+  }
+}
+
+class DuplicateFamilyTwo {
+  static class Member {
+    static final int SECOND = 2;
+  }
+}
