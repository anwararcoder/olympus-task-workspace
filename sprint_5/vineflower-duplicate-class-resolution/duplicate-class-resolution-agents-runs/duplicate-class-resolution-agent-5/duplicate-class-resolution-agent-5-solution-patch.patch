--- /dev/null
+++ b/src/org/jetbrains/java/decompiler/struct/DuplicateClassStrategy.java
@@ -0,0 +1,20 @@
+package org.jetbrains.java.decompiler.struct;
+
+public enum DuplicateClassStrategy {
+  FIRST,
+  LAST,
+  ERROR;
+
+  public static DuplicateClassStrategy parse(Object value) {
+    return switch (String.valueOf(value)) {
+      case "first" -> FIRST;
+      case "last" -> LAST;
+      case "error" -> ERROR;
+      default -> throw new IllegalArgumentException("Invalid duplicate-class-strategy '" + value + "'; accepted values are: first, last, error");
+    };
+  }
+
+  public String optionValue() {
+    return name().toLowerCase(java.util.Locale.ROOT);
+  }
+}
