+    List<String> ignored = candidates.stream()
+      .filter(candidate -> candidate != selection.candidate)
+      .map(candidate -> candidate.unit.getOriginDescription())
+      .toList();
+    String message = "Duplicate class decision: binary name " + name + ", strategy " + this.duplicateClassStrategy +
+      ", selected origin " + selection.candidate.unit.getOriginDescription() + ", ignored origins: " + ignored +
+      ", metadata family root " + selection.familyRoot;
+    DecompilerContext.getLogger().writeMessage(
+      message,
+      differing ? IFernflowerLogger.Severity.WARN : IFernflowerLogger.Severity.INFO
+    );
+  }
