+  private static boolean candidatesDiffer(List<Candidate> candidates) {
+    if (candidates.size() < 2) {
+      return false;
+    }
+    byte[] first = candidates.get(0).getBytes();
+    for (int index = 1; index < candidates.size(); index++) {
+      if (!Arrays.equals(first, candidates.get(index).getBytes())) {
+        return true;
+      }
+    }
+    return false;
+  }
