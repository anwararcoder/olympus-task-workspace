+  private static String findFamilyRoot(
+    String name,
+    Map<String, LinkedHashSet<String>> parents,
+    Map<String, String> roots
+  ) {
+    String cached = roots.get(name);
+    if (cached != null) {
+      return cached;
+    }
+
+    LinkedHashSet<String> path = new LinkedHashSet<>();
+    String current = name;
+    while (path.add(current)) {
+      LinkedHashSet<String> directParents = parents.get(current);
+      if (directParents == null || directParents.isEmpty()) {
+        break;
+      }
+      current = directParents.iterator().next();
+    }
+    for (String member : path) {
+      roots.put(member, current);
+    }
+    return current;
+  }
