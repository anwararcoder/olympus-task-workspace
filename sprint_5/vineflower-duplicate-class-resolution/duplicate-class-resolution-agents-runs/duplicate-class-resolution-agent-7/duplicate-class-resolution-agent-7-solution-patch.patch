+  private static byte[] changeSourceFile(byte[] original) {
+    byte[] changed = original.clone();
+    byte[] sourceName = "TestPatternMatchingLoops.java".getBytes(StandardCharsets.UTF_8);
+    outer:
+    for (int i = 0; i <= changed.length - sourceName.length; i++) {
+      for (int j = 0; j < sourceName.length; j++) {
+        if (changed[i + j] != sourceName[j]) {
+          continue outer;
+        }
+      }
+      changed[i] = 'U';
+      return changed;
+    }
