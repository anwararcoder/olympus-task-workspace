+        } catch (IOException ex) {
+          throw new UncheckedIOException("Failed to inspect family metadata for " + entry.getKey() + " from " + originName(unit), ex);
+        }
+        StructInnerClassesAttribute innerClasses = metadataClass.getAttribute(StructGeneralAttribute.ATTRIBUTE_INNER_CLASSES);
+        if (innerClasses != null) {
+          for (StructInnerClassesAttribute.Entry inner : innerClasses.getEntries()) {
+            if (inner.enclosingName != null) {
+              addFamilyEdge(graph, parents, inner.innerName, inner.enclosingName);
+            }
+          }
+        }
+        StructEnclosingMethodAttribute enclosingMethod = metadataClass.getAttribute(StructGeneralAttribute.ATTRIBUTE_ENCLOSING_METHOD);
+        if (enclosingMethod != null && enclosingMethod.getClassName() != null) {
+          addFamilyEdge(graph, parents, metadataClass.qualifiedName, enclosingMethod.getClassName());
+        }
+      }
+    }
+
+    for (Map.Entry<String, List<ContextUnit>> entry : this.candidatesByClassName.entrySet()) {
+      List<ContextUnit> own = entry.getValue().stream().filter(ContextUnit::isOwn).distinct().toList();
+      if (own.size() < 2) {
+        continue;
+      }
+      Set<String> family = connectedFamily(graph, entry.getKey());
+      String root = findFamilyRoot(entry.getKey(), parents);
+      for (String member : family) {
+        this.familyRoots.putIfAbsent(member, root);
+        this.familyTriggers.putIfAbsent(root, entry.getKey());
+      }
     }
   }
 
+  private static void addFamilyEdge(Map<String, Set<String>> graph, Map<String, String> parents, String child, String parent) {
+    graph.computeIfAbsent(child, ignored -> new LinkedHashSet<>()).add(parent);
+    graph.computeIfAbsent(parent, ignored -> new LinkedHashSet<>()).add(child);
+    parents.putIfAbsent(child, parent);
+  }
+
+  private static Set<String> connectedFamily(Map<String, Set<String>> graph, String start) {
+    Set<String> result = new LinkedHashSet<>();
+    Deque<String> pending = new ArrayDeque<>();
+    pending.add(start);
+    while (!pending.isEmpty()) {
+      String current = pending.removeFirst();
+      if (result.add(current)) {
+        pending.addAll(graph.getOrDefault(current, Set.of()));
+      }
+    }
+    return result;
+  }
+
+  private static String findFamilyRoot(String member, Map<String, String> parents) {
+    Set<String> seen = new HashSet<>();
+    String current = member;
+    while (seen.add(current)) {
+      String parent = parents.get(current);
+      if (parent == null) {
+        return current;
+      }
+      current = parent;
+    }
+    return member;
+  }
+
+  private ContextUnit ensureFamilyAnchor(String familyRoot) {
+    ContextUnit cached = this.familyAnchors.get(familyRoot);
+    if (cached != null) {
+      return cached;
+    }
+    String anchorName = familyRoot;
+    List<ContextUnit> rootCandidates = this.candidatesByClassName.getOrDefault(familyRoot, List.of()).stream()
+      .filter(ContextUnit::isOwn).sorted(Comparator.comparingInt(ContextUnit::getOriginIndex)).toList();
+    List<ContextUnit> anchorCandidates = rootCandidates;
+    if (anchorCandidates.isEmpty()) {
+      anchorName = Objects.requireNonNull(this.familyTriggers.get(familyRoot));
+      anchorCandidates = this.candidatesByClassName.getOrDefault(anchorName, List.of()).stream()
+        .filter(ContextUnit::isOwn).sorted(Comparator.comparingInt(ContextUnit::getOriginIndex)).toList();
+    }
+    ContextUnit anchor = selectByStrategy(anchorName, anchorCandidates, familyRoot);
+    this.familyAnchors.put(familyRoot, anchor);
+    this.selections.put(anchorName, anchor);
+    return anchor;
+  }
+
+  private IllegalStateException familyConflict(String familyRoot, String member, ContextUnit anchor, List<ContextUnit> alternatives) {
+    return new IllegalStateException("Class family origin conflict; family root: " + familyRoot + "; member: " + member +
+      "; anchored origin: " + originName(anchor) + "; alternative origins: " + joinOrigins(alternatives));
+  }
+
+  private byte[] requireClassBytes(ContextUnit unit, String className) {
+    byte[] bytes = getClassBytes(unit, className);
+    if (bytes == null) {
+      throw new IllegalStateException("Class " + className + " disappeared from " + originName(unit));
+    }
+    return bytes;
+  }
+
+  private @Nullable byte[] getClassBytes(ContextUnit unit, String className) {
+    Map<String, byte[]> byName = this.classBytes.computeIfAbsent(unit, ignored -> new HashMap<>());
+    byte[] cached = byName.get(className);
+    if (cached != null) {
+      return cached == MISSING_BYTES ? null : cached;
+    }
+    try {
+      byte[] bytes = unit.getClassBytes(className);
+      byName.put(className, bytes == null ? MISSING_BYTES : bytes);
+      return bytes;
+    } catch (IOException ex) {
+      String message = "Failed to read class " + className + " from " + originName(unit);
+      DecompilerContext.getLogger().writeMessage(message, IFernflowerLogger.Severity.ERROR, ex);
+      throw new UncheckedIOException(message, ex);
+    }
+  }
+
+  private DuplicateClassStrategy duplicateClassStrategy() {
+    Object value = DecompilerContext.getProperty(IFernflowerPreferences.DUPLICATE_CLASS_STRATEGY);
+    return validateDuplicateClassStrategy(value);
+  }
+
+  private static String displayFamilyRoot(@Nullable String familyRoot) {
+    return familyRoot == null ? "<none>" : familyRoot;
+  }
+
+  private static String joinOrigins(List<ContextUnit> origins) {
+    return origins.stream().map(StructContext::originName).reduce((left, right) -> left + ", " + right).orElse("<none>");
+  }
+
+  private static String originName(ContextUnit unit) {
+    return unit.getName() + " [origin " + (unit.getOriginIndex() + 1) + "]";
+  }
