+  @Test
+  void firstAndLastUseRegistrationOrderAndWarnOnce() throws IOException {
+    byte[] firstBytes = classBytes("java17", SAMPLE);
+    byte[] lastBytes = changeSourceFile(firstBytes);
+
+    CapturingLogger firstLogger = setup("first");
+    StructContext firstContext = DecompilerContext.getStructContext();
+    firstContext.addSpace(new MemorySource("same", Map.of(SAMPLE, firstBytes), false), false);
+    firstContext.addSpace(new MemorySource("same", Map.of(SAMPLE, lastBytes), false), false);
+    assertEquals("TestPatternMatchingLoops.java", sourceFile(firstContext.getClass(SAMPLE)));
+    assertEquals(1, firstLogger.warnings.size());
+    assertTrue(firstLogger.warnings.get(0).contains("strategy first"));
+    assertTrue(firstLogger.warnings.get(0).contains("same [origin 1]"));
+    assertTrue(firstLogger.warnings.get(0).contains("same [origin 2]"));
+    assertTrue(firstLogger.warnings.get(0).contains("metadata family root: <none>"));
+    firstContext.getClass(SAMPLE);
+    assertEquals(1, firstLogger.warnings.size());
+
+    setup("last");
+    StructContext lastContext = DecompilerContext.getStructContext();
+    lastContext.addSpace(new MemorySource("same", Map.of(SAMPLE, firstBytes), false), false);
+    lastContext.addSpace(new MemorySource("same", Map.of(SAMPLE, lastBytes), false), false);
+    assertEquals("UestPatternMatchingLoops.java", sourceFile(lastContext.getClass(SAMPLE)));
+  }
