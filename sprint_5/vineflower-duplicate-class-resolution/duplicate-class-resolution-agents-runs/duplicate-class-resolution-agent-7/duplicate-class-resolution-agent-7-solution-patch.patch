+  private static final class MemorySource implements IContextSource {
+    private final String name;
+    private final Map<String, byte[]> classes;
+    private final boolean lazy;
+    private final AtomicInteger reads = new AtomicInteger();
+
+    private MemorySource(String name, Map<String, byte[]> classes, boolean lazy) {
+      this.name = name;
+      this.classes = new LinkedHashMap<>(classes);
+      this.lazy = lazy;
+    }
+
+    @Override
+    public String getName() {
+      return this.name;
+    }
+
+    @Override
+    public Entries getEntries() {
+      if (this.lazy) {
+        return Entries.EMPTY;
+      }
+      return new Entries(this.classes.keySet().stream().map(Entry::atBase).toList(), List.of(), List.of());
+    }
+
+    @Override
+    public boolean isLazy() {
+      return this.lazy;
+    }
+
+    @Override
+    public byte[] getClassBytes(String className) {
+      this.reads.incrementAndGet();
+      return this.classes.get(className);
+    }
+
+    @Override
+    public InputStream getInputStream(String resource) {
+      String className = resource.endsWith(CLASS_SUFFIX) ? resource.substring(0, resource.length() - CLASS_SUFFIX.length()) : resource;
+      byte[] bytes = this.classes.get(className);
+      return bytes == null ? null : new ByteArrayInputStream(bytes);
+    }
+  }
