+    differingContext.addSpace(new MemorySource("duplicate", Map.of(SAMPLE, bytes), false), false);
+    differingContext.addSpace(new MemorySource("duplicate", Map.of(SAMPLE, different), false), false);
+    IllegalStateException conflict = assertThrows(IllegalStateException.class, () -> differingContext.getClass(SAMPLE));
+    assertTrue(conflict.getMessage().contains("duplicate [origin 1]"));
+    assertTrue(conflict.getMessage().contains("duplicate [origin 2]"));
+
+    setup("error");
+    StructContext identicalContext = DecompilerContext.getStructContext();
+    identicalContext.addSpace(new MemorySource("duplicate", Map.of(SAMPLE, bytes), false), false);
+    identicalContext.addSpace(new MemorySource("duplicate", Map.of(SAMPLE, bytes), false), false);
+    assertNotNull(identicalContext.getClass(SAMPLE));
+  }
