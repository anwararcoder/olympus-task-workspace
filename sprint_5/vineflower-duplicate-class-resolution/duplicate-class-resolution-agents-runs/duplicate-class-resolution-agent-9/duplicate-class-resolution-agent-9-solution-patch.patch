+++ b/src/org/jetbrains/java/decompiler/struct/ClassResolver.java
@@ -0,0 +1,346 @@
+package org.jetbrains.java.decompiler.struct;
+
+import org.jetbrains.annotations.Nullable;
+import org.jetbrains.java.decompiler.main.DecompilerContext;
+import org.jetbrains.java.decompiler.main.extern.IFernflowerLogger;
+import org.jetbrains.java.decompiler.struct.attr.StructEnclosingMethodAttribute;
+import org.jetbrains.java.decompiler.struct.attr.StructGeneralAttribute;
+import org.jetbrains.java.decompiler.struct.attr.StructInnerClassesAttribute;
+import org.jetbrains.java.decompiler.util.DataInputFullStream;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeSet;
+
+final class ClassResolver {
+  private final StructContext.DuplicateClassStrategy strategy;
+  private final Map<String, LinkedHashSet<ContextUnit>> eagerCandidates = new LinkedHashMap<>();
+  private final List<ContextUnit> lazyUnits = new ArrayList<>();
+  private final Map<ContextUnit, Map<String, Candidate>> lazyProbes = new HashMap<>();
+  private final Map<String, Selection> selections = new HashMap<>();
+  private final Map<String, ContextUnit> familyAnchors = new HashMap<>();
+  private FamilyIndex familyIndex;
+
+  ClassResolver(StructContext.DuplicateClassStrategy strategy) {
+    this.strategy = strategy;
+  }
+
+  synchronized void register(ContextUnit unit) {
+    if (unit.isLazy()) {
+      this.lazyUnits.add(unit);
+    } else {
+      for (String className : unit.getClassNames()) {
+        this.eagerCandidates.computeIfAbsent(className, ignored -> new LinkedHashSet<>()).add(unit);
+      }
+    }
+    this.invalidate();
+  }
+
+  synchronized void reset() {
+    this.eagerCandidates.clear();
+    this.lazyUnits.clear();
+    this.lazyProbes.clear();
+    this.invalidate();
+  }
+
+  synchronized @Nullable Selection resolve(String className) {
+    if (this.selections.containsKey(className)) {
+      return this.selections.get(className);
+    }
+
+    List<Candidate> candidates = this.collectCandidates(className);
+    if (candidates.isEmpty()) {
+      this.selections.put(className, null);
+      return null;
+    }
+
+    boolean hasOwn = candidates.stream().anyMatch(candidate -> candidate.unit.isOwn());
+    List<Candidate> eligible = candidates.stream().filter(candidate -> candidate.unit.isOwn() == hasOwn).toList();
+    String familyRoot = className;
+    Candidate forced = null;
+
+    if (hasOwn) {
+      FamilyIndex index = this.getFamilyIndex();
+      familyRoot = index.rootByName.getOrDefault(className, className);
+      if (index.activeRoots.contains(familyRoot)) {
+        ContextUnit anchor = this.familyAnchors.get(familyRoot);
+        if (anchor == null) {
+          anchor = this.selectFamilyAnchor(familyRoot, index, className);
+          this.familyAnchors.put(familyRoot, anchor);
+        }
+
+        Selection anchoredSelection = this.selections.get(className);
+        if (anchoredSelection != null) {
+          return anchoredSelection;
+        }
+
+        for (Candidate candidate : eligible) {
+          if (candidate.unit == anchor) {
+            forced = candidate;
+            break;
+          }
+        }
+
+        if (forced == null) {
+          String alternatives = eligible.stream().map(candidate -> candidate.unit.getOriginName()).distinct().reduce((a, b) -> a + ", " + b).orElse("none");
+          throw new IllegalStateException("Class family origin conflict: family root " + familyRoot + ", member " + className
+            + ", anchored origin " + anchor.getOriginName() + ", alternative origins " + alternatives);
+        }
+      }
+    }
+
+    Selection selection = this.select(className, eligible, forced, familyRoot);
+    this.selections.put(className, selection);
+    return selection;
+  }
+
+  synchronized boolean isSelectedFrom(ContextUnit unit, String className) {
+    Selection selection = this.resolve(className);
+    return selection != null && selection.unit() == unit;
+  }
+
+  private void invalidate() {
+    this.selections.clear();
+    this.familyAnchors.clear();
+    this.familyIndex = null;
+  }
+
+  private List<Candidate> collectCandidates(String className) {
+    List<Candidate> candidates = new ArrayList<>();
+    Set<ContextUnit> seen = new HashSet<>();
+    for (ContextUnit unit : this.eagerCandidates.getOrDefault(className, new LinkedHashSet<>())) {
+      Candidate candidate = new Candidate(unit, className, null, true, false);
+      if (candidate.bytes() != null && seen.add(unit)) {
+        candidates.add(candidate);
+      }
+    }
+
+    for (ContextUnit unit : this.lazyUnits) {
+      Candidate candidate = this.lazyProbes.computeIfAbsent(unit, ignored -> new HashMap<>()).computeIfAbsent(className, name -> this.probe(unit, name));
+      if (candidate.present && seen.add(unit)) {
+        candidates.add(candidate);
+      }
+    }
+
+    candidates.sort(Comparator.comparingInt(candidate -> candidate.unit.getOriginIndex()));
+    return candidates;
+  }
+
+  private Candidate probe(ContextUnit unit, String className) {
+    try {
+      byte[] bytes = unit.getClassBytes(className);
+      return new Candidate(unit, className, bytes, bytes != null, true);
+    } catch (IOException exception) {
+      DecompilerContext.getLogger().writeMessage("Failed to probe class " + className + " in " + unit.getOriginName(), IFernflowerLogger.Severity.ERROR, exception);
+      return new Candidate(unit, className, null, false, true);
+    }
+  }
+
+  private Selection select(String className, List<Candidate> candidates, @Nullable Candidate forced, String familyRoot) {
+    boolean differing = bytesDiffer(candidates);
+    if (this.strategy == StructContext.DuplicateClassStrategy.ERROR && differing) {
+      throw new IllegalStateException("Duplicate class conflict for " + className + " with strategy error; highest-precedence origins: "
+        + joinOrigins(candidates) + "; metadata family root " + familyRoot);
+    }
+
+    Candidate selected;
+    if (forced != null) {
+      selected = forced;
+    } else if (this.strategy == StructContext.DuplicateClassStrategy.LAST) {
+      selected = candidates.get(candidates.size() - 1);
+    } else {
+      selected = candidates.get(0);
+    }
+
+    if (differing) {
+      String ignored = candidates.stream().filter(candidate -> candidate != selected).map(candidate -> candidate.unit.getOriginName())
+        .reduce((a, b) -> a + ", " + b).orElse("none");
+      DecompilerContext.getLogger().writeMessage("Duplicate class " + className + " resolved with strategy " + this.strategy.optionValue
+        + ": selected origin " + selected.unit.getOriginName() + "; ignored origins " + ignored + "; metadata family root " + familyRoot,
+        IFernflowerLogger.Severity.WARN);
+    }
+
+    return new Selection(selected.unit, selected.bytes());
+  }
+
+  private ContextUnit selectFamilyAnchor(String familyRoot, FamilyIndex index, String requestedName) {
+    List<Candidate> rootCandidates = this.collectCandidates(familyRoot).stream().filter(candidate -> candidate.unit.isOwn()).toList();
+    if (!rootCandidates.isEmpty()) {
+      Selection rootSelection = this.select(familyRoot, rootCandidates, null, familyRoot);
+      this.selections.put(familyRoot, rootSelection);
+      return rootSelection.unit();
+    }
+
+    String duplicateName = index.duplicateNamesByRoot.getOrDefault(familyRoot, Set.of()).stream().sorted().findFirst().orElse(requestedName);
+    List<Candidate> duplicateCandidates = this.collectCandidates(duplicateName).stream().filter(candidate -> candidate.unit.isOwn()).toList();
+    Selection duplicateSelection = this.select(duplicateName, duplicateCandidates, null, familyRoot);
+    this.selections.put(duplicateName, duplicateSelection);
+    return duplicateSelection.unit();
+  }
+
+  private FamilyIndex getFamilyIndex() {
+    if (this.familyIndex != null) {
+      return this.familyIndex;
+    }
+
+    DisjointSet families = new DisjointSet();
+    Map<String, Set<String>> parents = new HashMap<>();
+    Set<String> duplicateNames = new HashSet<>();
+
+    for (Map.Entry<String, LinkedHashSet<ContextUnit>> entry : this.eagerCandidates.entrySet()) {
+      List<ContextUnit> ownOrigins = entry.getValue().stream().filter(ContextUnit::isOwn).toList();
+      if (ownOrigins.isEmpty()) {
+        continue;
+      }
+      families.add(entry.getKey());
+      if (ownOrigins.size() > 1) {
+        duplicateNames.add(entry.getKey());
+      }
+
+      for (ContextUnit unit : ownOrigins) {
+        Candidate candidate = new Candidate(unit, entry.getKey(), null, true, false);
+        byte[] bytes = candidate.bytes();
+        if (bytes == null) {
+          continue;
+        }
+        try {
+          StructClass clazz = StructClass.create(new DataInputFullStream(bytes), false);
+          families.add(clazz.qualifiedName);
+          StructInnerClassesAttribute innerClasses = clazz.getAttribute(StructGeneralAttribute.ATTRIBUTE_INNER_CLASSES);
+          if (innerClasses != null) {
+            for (StructInnerClassesAttribute.Entry inner : innerClasses.getEntries()) {
+              if (inner.innerName != null && inner.enclosingName != null && !inner.innerName.equals(inner.enclosingName)) {
+                families.union(inner.innerName, inner.enclosingName);
+                parents.computeIfAbsent(inner.innerName, ignored -> new LinkedHashSet<>()).add(inner.enclosingName);
+              }
+            }
+          }
+          StructEnclosingMethodAttribute enclosingMethod = clazz.getAttribute(StructGeneralAttribute.ATTRIBUTE_ENCLOSING_METHOD);
+          if (enclosingMethod != null && enclosingMethod.getClassName() != null && !clazz.qualifiedName.equals(enclosingMethod.getClassName())) {
+            families.union(clazz.qualifiedName, enclosingMethod.getClassName());
+            parents.computeIfAbsent(clazz.qualifiedName, ignored -> new LinkedHashSet<>()).add(enclosingMethod.getClassName());
+          }
+        } catch (IOException exception) {
+          DecompilerContext.getLogger().writeMessage("Failed to inspect class family metadata for " + entry.getKey() + " from " + unit.getOriginName(),
+            IFernflowerLogger.Severity.ERROR, exception);
+        }
+      }
+    }
+
+    Map<String, Set<String>> components = new HashMap<>();
+    for (String name : families.names()) {
+      components.computeIfAbsent(families.find(name), ignored -> new TreeSet<>()).add(name);
+    }
+
+    Map<String, String> rootByName = new HashMap<>();
+    for (Set<String> component : components.values()) {
+      String root = component.stream().filter(name -> parents.getOrDefault(name, Set.of()).stream().noneMatch(component::contains)).findFirst()
+        .orElse(component.iterator().next());
+      for (String name : component) {
+        rootByName.put(name, root);
+      }
+    }
+
+    Set<String> activeRoots = new HashSet<>();
+    Map<String, Set<String>> duplicateNamesByRoot = new HashMap<>();
+    for (String duplicateName : duplicateNames) {
+      String root = rootByName.getOrDefault(duplicateName, duplicateName);
+      activeRoots.add(root);
+      duplicateNamesByRoot.computeIfAbsent(root, ignored -> new TreeSet<>()).add(duplicateName);
+    }
+
+    this.familyIndex = new FamilyIndex(rootByName, activeRoots, duplicateNamesByRoot);
+    return this.familyIndex;
+  }
+
+  private static boolean bytesDiffer(List<Candidate> candidates) {
+    if (candidates.size() < 2) {
+      return false;
+    }
+    byte[] first = candidates.get(0).bytes();
+    for (int index = 1; index < candidates.size(); index++) {
+      if (!Arrays.equals(first, candidates.get(index).bytes())) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  private static String joinOrigins(List<Candidate> candidates) {
+    return candidates.stream().map(candidate -> candidate.unit.getOriginName()).reduce((a, b) -> a + ", " + b).orElse("none");
+  }
+
+  record Selection(ContextUnit unit, byte[] bytes) { }
+
+  private static final class Candidate {
+    private final ContextUnit unit;
+    private final String className;
+    private byte[] bytes;
+    private boolean loaded;
+    private final boolean present;
+
+    private Candidate(ContextUnit unit, String className, byte @Nullable [] bytes, boolean present, boolean loaded) {
+      this.unit = unit;
+      this.className = className;
+      this.bytes = bytes;
+      this.loaded = loaded;
+      this.present = present;
+    }
+
+    private byte @Nullable [] bytes() {
+      if (!this.loaded) {
+        try {
+          this.bytes = this.unit.getClassBytes(this.className);
+        } catch (IOException exception) {
+          DecompilerContext.getLogger().writeMessage("Failed to read class " + this.className + " from " + this.unit.getOriginName(),
+            IFernflowerLogger.Severity.ERROR, exception);
+        }
+        this.loaded = true;
+      }
+      return this.bytes;
+    }
+  }
+
+  private record FamilyIndex(Map<String, String> rootByName, Set<String> activeRoots, Map<String, Set<String>> duplicateNamesByRoot) { }
+
+  private static final class DisjointSet {
+    private final Map<String, String> parents = new HashMap<>();
+
+    void add(String name) {
+      this.parents.putIfAbsent(name, name);
+    }
+
+    void union(String first, String second) {
+      this.add(first);
+      this.add(second);
+      String firstRoot = this.find(first);
+      String secondRoot = this.find(second);
+      if (!firstRoot.equals(secondRoot)) {
+        this.parents.put(firstRoot, secondRoot);
+      }
+    }
+
+    String find(String name) {
+      String parent = this.parents.get(name);
+      if (parent.equals(name)) {
+        return name;
+      }
+      String root = this.find(parent);
+      this.parents.put(name, root);
+      return root;
+    }
+
+    Set<String> names() {
+      return this.parents.keySet();
+    }
+  }
+}
