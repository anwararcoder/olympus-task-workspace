+package org.jetbrains.java.decompiler.struct;
+
+import org.jetbrains.java.decompiler.main.ClassesProcessor;
+import org.jetbrains.java.decompiler.main.DecompilerContext;
+import org.jetbrains.java.decompiler.main.Init;
+import org.jetbrains.java.decompiler.main.extern.IContextSource;
+import org.jetbrains.java.decompiler.main.extern.IFernflowerLogger;
+import org.jetbrains.java.decompiler.main.extern.IFernflowerPreferences;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+import java.io.ByteArrayInputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class ClassResolverTest {
+  private RecordingLogger logger;
+
+  @BeforeEach
+  void setUp() {
+    Init.init();
+    this.logger = new RecordingLogger();
+    StructContext context = new StructContext(null, null, null);
+    DecompilerContext.setCurrentContext(new DecompilerContext(
+      new HashMap<>(IFernflowerPreferences.DEFAULTS),
+      this.logger,
+      context,
+      new ClassesProcessor(context),
+      null
+    ));
+  }
+
+  @AfterEach
+  void tearDown() {
+    DecompilerContext.setCurrentContext(null);
+  }
+
+  @Test
+  void selectsFirstAndLastOriginsDeterministically() {
+    ContextUnit first = unit("same", false, 1, source("same", false, Map.of("pkg/Test", new byte[] {1})));
+    ContextUnit last = unit("same", false, 2, source("same", false, Map.of("pkg/Test", new byte[] {2})));
+
+    ClassResolver firstResolver = resolver(StructContext.DuplicateClassStrategy.FIRST, first, last);
+    ClassResolver lastResolver = resolver(StructContext.DuplicateClassStrategy.LAST, first, last);
+
+    assertSame(first, firstResolver.resolve("pkg/Test").unit());
+    assertSame(last, lastResolver.resolve("pkg/Test").unit());
+    assertEquals(2, this.logger.warnings.size());
+    assertTrue(this.logger.warnings.get(0).contains("same [origin 1]"));
+    assertTrue(this.logger.warnings.get(0).contains("same [origin 2]"));
+  }
+
+  @Test
+  void rejectsInvalidStrategyWithAcceptedValues() {
+    IllegalArgumentException exception = assertThrows(IllegalArgumentException.class,
+      () -> StructContext.DuplicateClassStrategy.parse("middle"));
+    assertTrue(exception.getMessage().contains("first, last, error"));
+  }
+
+  @Test
+  void errorAllowsIdenticalBytesAndRejectsDifferingBytes() {
+    byte[] bytes = {1, 2, 3};
+    ContextUnit first = unit("first", false, 1, source("first", false, Map.of("pkg/Test", bytes)));
+    ContextUnit identical = unit("identical", false, 2, source("identical", false, Map.of("pkg/Test", bytes.clone())));
+    ContextUnit differing = unit("differing", false, 3, source("differing", false, Map.of("pkg/Test", new byte[] {3, 2, 1})));
+
+    assertSame(first, resolver(StructContext.DuplicateClassStrategy.ERROR, first, identical).resolve("pkg/Test").unit());
+
+    IllegalStateException exception = assertThrows(IllegalStateException.class,
+      () -> resolver(StructContext.DuplicateClassStrategy.ERROR, first, identical, differing).resolve("pkg/Test"));
+    assertTrue(exception.getMessage().contains("first [origin 1]"));
+    assertTrue(exception.getMessage().contains("identical [origin 2]"));
+    assertTrue(exception.getMessage().contains("differing [origin 3]"));
+  }
+
+  @Test
+  void cachesLazyProbesAndInvalidatesSelectionsWhenRegistered() {
+    MapSource lazySource = source("lazy", true, Map.of("pkg/Test", new byte[] {1}));
+    ContextUnit lazy = unit("lazy", false, 1, lazySource);
+    ClassResolver resolver = resolver(StructContext.DuplicateClassStrategy.LAST, lazy);
+
+    assertArrayEquals(new byte[] {1}, resolver.resolve("pkg/Test").bytes());
+    assertArrayEquals(new byte[] {1}, resolver.resolve("pkg/Test").bytes());
+    assertEquals(1, lazySource.reads);
+
+    ContextUnit added = unit("added", false, 2, source("added", false, Map.of("pkg/Test", new byte[] {2})));
+    resolver.register(added);
+    assertSame(added, resolver.resolve("pkg/Test").unit());
+    assertEquals(1, lazySource.reads);
+  }
+
+  @Test
+  void ownOriginOutranksLibraries() {
+    ContextUnit library = unit("library", false, 1, source("library", false, Map.of("pkg/Test", new byte[] {1})));
+    ContextUnit own = unit("own", true, 2, source("own", false, Map.of("pkg/Test", new byte[] {2})));
+
+    assertSame(own, resolver(StructContext.DuplicateClassStrategy.FIRST, library, own).resolve("pkg/Test").unit());
+  }
+
+  @Test
+  void familyRootAnchorsDuplicateMember() throws IOException {
+    String rootName = "pkg/TestInnerClassGeneric";
+    String memberName = rootName + "$Inner";
+    byte[] rootBytes = Files.readAllBytes(Path.of("testData/classes/java8", rootName + ".class"));
+    byte[] memberBytes = Files.readAllBytes(Path.of("testData/classes/java8", memberName + ".class"));
+    byte[] changedMemberBytes = replaceAscii(memberBytes, "TestInnerClassGeneric.java", "TestInnerClassGenerix.java");
+
+    ContextUnit rootOrigin = unit("root", true, 1, source("root", false, Map.of(rootName, rootBytes, memberName, memberBytes)));
+    ContextUnit laterOrigin = unit("later", true, 2, source("later", false, Map.of(memberName, changedMemberBytes)));
+    ClassResolver resolver = resolver(StructContext.DuplicateClassStrategy.LAST, rootOrigin, laterOrigin);
+
+    assertSame(rootOrigin, resolver.resolve(memberName).unit());
+    assertTrue(this.logger.warnings.stream().anyMatch(message -> message.contains("metadata family root " + rootName)));
+  }
+
+  private static byte[] replaceAscii(byte[] input, String from, String to) {
+    byte[] output = input.clone();
+    byte[] search = from.getBytes(StandardCharsets.UTF_8);
+    byte[] replacement = to.getBytes(StandardCharsets.UTF_8);
+    assertEquals(search.length, replacement.length);
+    outer:
+    for (int index = 0; index <= output.length - search.length; index++) {
+      for (int offset = 0; offset < search.length; offset++) {
+        if (output[index + offset] != search[offset]) {
+          continue outer;
+        }
+      }
+      System.arraycopy(replacement, 0, output, index, replacement.length);
+      return output;
+    }
+    throw new AssertionError("Could not find classfile text " + from);
+  }
+
+  private static ClassResolver resolver(StructContext.DuplicateClassStrategy strategy, ContextUnit... units) {
+    ClassResolver resolver = new ClassResolver(strategy);
+    for (ContextUnit unit : units) {
+      resolver.register(unit);
+    }
+    return resolver;
+  }
+
+  private static ContextUnit unit(String name, boolean own, int originIndex, MapSource source) {
+    ContextUnit unit = new ContextUnit(source, own, true, null, null);
+    unit.setOriginIndex(originIndex);
+    return unit;
+  }
+
+  private static MapSource source(String name, boolean lazy, Map<String, byte[]> classes) {
+    return new MapSource(name, lazy, classes);
+  }
+
+  private static final class MapSource implements IContextSource {
+    private final String name;
+    private final boolean lazy;
+    private final Map<String, byte[]> classes;
+    private int reads;
+
+    private MapSource(String name, boolean lazy, Map<String, byte[]> classes) {
+      this.name = name;
+      this.lazy = lazy;
+      this.classes = new LinkedHashMap<>(classes);
+    }
+
+    @Override
+    public String getName() {
+      return this.name;
+    }
+
+    @Override
+    public Entries getEntries() {
+      if (this.lazy) {
+        return Entries.EMPTY;
+      }
+      return new Entries(this.classes.keySet().stream().map(Entry::atBase).toList(), List.of(), List.of());
+    }
+
+    @Override
+    public boolean isLazy() {
+      return this.lazy;
+    }
+
+    @Override
+    public InputStream getInputStream(String resource) {
+      if (!resource.endsWith(CLASS_SUFFIX)) {
+        return null;
+      }
+      this.reads++;
+      byte[] bytes = this.classes.get(resource.substring(0, resource.length() - CLASS_SUFFIX.length()));
+      return bytes == null ? null : new ByteArrayInputStream(bytes);
+    }
+  }
+
+  private static final class RecordingLogger extends IFernflowerLogger {
+    private final List<String> warnings = new ArrayList<>();
+
+    @Override
+    public void writeMessage(String message, Severity severity) {
+      if (severity == Severity.WARN) {
+        this.warnings.add(message);
+      }
+    }
+
+    @Override
+    public void writeMessage(String message, Severity severity, Throwable throwable) {
+      this.writeMessage(message, severity);
+    }
+  }
