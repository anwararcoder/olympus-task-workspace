new file mode 100644
index 0000000..917d2ee
--- /dev/null
+++ b/src/org/jetbrains/java/decompiler/struct/DuplicateClassStrategy.java
@@ -0,0 +1,28 @@
+package org.jetbrains.java.decompiler.struct;
+
+public enum DuplicateClassStrategy {
+  FIRST,
+  LAST,
+  ERROR;
+
+  public static DuplicateClassStrategy parse(Object value) {
+    String name = String.valueOf(value);
+    try {
+      return switch (name) {
+        case "first" -> FIRST;
+        case "last" -> LAST;
+        case "error" -> ERROR;
+        default -> throw new IllegalArgumentException();
+      };
+    } catch (IllegalArgumentException exception) {
+      throw new IllegalArgumentException(
+        "Invalid duplicate-class-strategy '" + name + "'; accepted values are: first, last, error",
+        exception
+      );
+    }
+  }
+
+  public String optionValue() {
+    return name().toLowerCase(java.util.Locale.ROOT);
+  }
+}
