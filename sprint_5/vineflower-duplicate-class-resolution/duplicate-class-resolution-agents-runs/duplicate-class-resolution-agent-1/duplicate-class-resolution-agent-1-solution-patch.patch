diff --git a/test/org/jetbrains/java/decompiler/DuplicateClassResolutionTest.java b/test/org/jetbrains/java/decompiler/DuplicateClassResolutionTest.java
new file mode 100644
index 0000000..2b704af
--- /dev/null
+++ b/test/org/jetbrains/java/decompiler/DuplicateClassResolutionTest.java
@@ -0,0 +1,352 @@
+package org.jetbrains.java.decompiler;
+
+import org.jetbrains.java.decompiler.main.ClassesProcessor;
+import org.jetbrains.java.decompiler.main.DecompilerContext;
+import org.jetbrains.java.decompiler.main.extern.IContextSource;
+import org.jetbrains.java.decompiler.main.extern.IFernflowerLogger;
+import org.jetbrains.java.decompiler.main.extern.IFernflowerPreferences;
+import org.jetbrains.java.decompiler.struct.DuplicateClassStrategy;
+import org.jetbrains.java.decompiler.struct.StructClass;
+import org.jetbrains.java.decompiler.struct.StructContext;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.Test;
+
+import java.io.ByteArrayInputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.atomic.AtomicInteger;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+public class DuplicateClassResolutionTest {
+  @AfterEach
+  public void clearContext() {
+    DecompilerContext.setCurrentContext(null);
+  }
+
+  @Test
+  public void firstAndLastUseRegistrationOrderAndOwnOutranksLibraries() {
+    byte[] first = classBytes(Aaaaa.class);
+    byte[] last = renamedClassBytes(Bbbbb.class, "Bbbbb", "Aaaaa");
+    String name = binaryName(Aaaaa.class);
+
+    StructContext firstContext = context(DuplicateClassStrategy.FIRST, new RecordingLogger());
+    firstContext.addSpace(source("same", Map.of(name, first)), false);
+    firstContext.addSpace(source("same", Map.of(name, last)), true);
+    firstContext.addSpace(source("same", Map.of(name, first)), true);
+    assertEquals("java/util/HashMap", requireClass(firstContext, name).superClass.getString());
+
+    StructContext lastContext = context(DuplicateClassStrategy.LAST, new RecordingLogger());
+    lastContext.addSpace(source("same", Map.of(name, first)), false);
+    lastContext.addSpace(source("same", Map.of(name, last)), true);
+    lastContext.addSpace(source("same", Map.of(name, first)), true);
+    assertEquals("java/util/ArrayList", requireClass(lastContext, name).superClass.getString());
+  }
+
+  @Test
+  public void errorAllowsIdenticalBytesAndRejectsEveryDifferingOrigin() {
+    byte[] first = classBytes(Aaaaa.class);
+    byte[] different = renamedClassBytes(Bbbbb.class, "Bbbbb", "Aaaaa");
+    String name = binaryName(Aaaaa.class);
+
+    StructContext identicalContext = context(DuplicateClassStrategy.ERROR, new RecordingLogger());
+    identicalContext.addSpace(source("copy", Map.of(name, first)), true);
+    identicalContext.addSpace(source("copy", Map.of(name, first)), true);
+    assertNotNull(identicalContext.getClass(name));
+
+    StructContext differingContext = context(DuplicateClassStrategy.ERROR, new RecordingLogger());
+    differingContext.addSpace(source("copy", Map.of(name, first)), true);
+    differingContext.addSpace(source("copy", Map.of(name, different)), true);
+    differingContext.addSpace(source("copy", Map.of(name, first)), true);
+    IllegalStateException exception = assertThrows(IllegalStateException.class, () -> differingContext.getClass(name));
+    assertTrue(exception.getMessage().contains("origin 1"));
+    assertTrue(exception.getMessage().contains("origin 2"));
+    assertTrue(exception.getMessage().contains("origin 3"));
+  }
+
+  @Test
+  public void differingDecisionWarnsOnceAndInvalidatesWhenSourceIsAdded() {
+    byte[] first = classBytes(Aaaaa.class);
+    byte[] last = renamedClassBytes(Bbbbb.class, "Bbbbb", "Aaaaa");
+    String name = binaryName(Aaaaa.class);
+    RecordingLogger logger = new RecordingLogger();
+    StructContext context = context(DuplicateClassStrategy.LAST, logger);
+
+    context.addSpace(source("first", Map.of(name, first)), true);
+    assertEquals("java/util/ArrayList", requireClass(context, name).superClass.getString());
+    context.addSpace(source("last", Map.of(name, last)), true);
+    assertEquals("java/util/HashMap", requireClass(context, name).superClass.getString());
+    assertEquals(1, logger.messages.stream().filter(message -> message.contains("Duplicate class '")).count());
+    assertTrue(logger.messages.stream().anyMatch(message -> message.contains("metadata family root: '" + name + "'")));
+  }
+
+  @Test
+  public void lazyProbesArePositiveAndNegativeCachedPerContext() {
+    byte[] bytes = classBytes(Aaaaa.class);
+    String name = binaryName(Aaaaa.class);
+    AtomicInteger firstProbes = new AtomicInteger();
+    AtomicInteger secondProbes = new AtomicInteger();
+    StructContext context = context(DuplicateClassStrategy.FIRST, new RecordingLogger());
+
+    context.addSpace(lazySource("lazy-one", Map.of(name, bytes), firstProbes), false);
+    context.addSpace(lazySource("lazy-two", Map.of(), secondProbes), false);
+    assertTrue(context.hasClass(name));
+    assertNotNull(context.getClass(name));
+    assertEquals(1, firstProbes.get());
+    assertEquals(1, secondProbes.get());
+
+    try {
+      context.reloadContext();
+    } catch (IOException exception) {
+      throw new RuntimeException(exception);
+    }
+    assertTrue(context.hasClass(name));
+    assertEquals(2, firstProbes.get());
+    assertEquals(2, secondProbes.get());
+  }
+
+  @Test
+  public void duplicateMemberUsesAvailableFamilyRootOrigin() {
+    String root = binaryName(FamilyOne.class);
+    String member = binaryName(FamilyOne.Member.class);
+    byte[] secondMember = renamedClassBytes(classBytes(FamilyTwo.Member.class), "FamilyTwo", "FamilyOne");
+    StructContext context = context(DuplicateClassStrategy.LAST, new RecordingLogger());
+
+    context.addSpace(source("root-origin", orderedMap(
+      root, classBytes(FamilyOne.class),
+      member, classBytes(FamilyOne.Member.class)
+    )), true);
+    context.addSpace(source("later-origin", Map.of(member, secondMember)), true);
+
+    assertEquals("java/util/ArrayList", requireClass(context, member).superClass.getString());
+  }
+
+  @Test
+  public void anonymousMemberUsesEnclosingMethodFamilyRoot() {
+    String root = binaryName(LocalOne.class);
+    String member = root + "$1";
+    StructContext context = context(DuplicateClassStrategy.LAST, new RecordingLogger());
+
+    context.addSpace(source("root-origin", orderedMap(
+      root, classBytes(LocalOne.class),
+      member, classBytes(member)
+    )), true);
+    context.addSpace(source("later-origin", Map.of(
+      member, renamedClassBytes(classBytes(binaryName(LocalTwo.class) + "$1"), "LocalTwo", "LocalOne")
+    )), true);
+
+    assertEquals("java/util/ArrayList", requireClass(context, member).superClass.getString());
+  }
+
+  @Test
+  public void familyMemberMissingFromAnchorReportsAlternatives() {
+    String root = binaryName(FamilyOne.class);
+    String member = binaryName(FamilyOne.Member.class);
+    String sibling = binaryName(FamilyOne.Sibling.class);
+    StructContext context = context(DuplicateClassStrategy.FIRST, new RecordingLogger());
+
+    context.addSpace(source("anchor", orderedMap(
+      root, classBytes(FamilyOne.class),
+      member, classBytes(FamilyOne.Member.class)
+    )), true);
+    context.addSpace(source("alternative", orderedMap(
+      member, renamedClassBytes(classBytes(FamilyTwo.Member.class), "FamilyTwo", "FamilyOne"),
+      sibling, renamedClassBytes(classBytes(FamilyTwo.Sibling.class), "FamilyTwo", "FamilyOne")
+    )), true);
+
+    assertNotNull(context.getClass(member));
+    IllegalStateException exception = assertThrows(IllegalStateException.class, () -> context.getClass(sibling));
+    assertTrue(exception.getMessage().contains(root));
+    assertTrue(exception.getMessage().contains(sibling));
+    assertTrue(exception.getMessage().contains("'anchor' [origin 1]"));
+    assertTrue(exception.getMessage().contains("'alternative' [origin 2]"));
+  }
+
+  @Test
+  public void invalidStrategyListsAcceptedValues() {
+    IllegalArgumentException exception = assertThrows(IllegalArgumentException.class, () -> DuplicateClassStrategy.parse("newest"));
+    assertTrue(exception.getMessage().contains("first, last, error"));
+  }
+
+  private static StructContext context(DuplicateClassStrategy strategy, IFernflowerLogger logger) {
+    StructContext context = new StructContext(null, null, null, strategy);
+    Map<String, Object> properties = new HashMap<>(IFernflowerPreferences.DEFAULTS);
+    DecompilerContext.setCurrentContext(new DecompilerContext(properties, logger, context, new ClassesProcessor(context), null));
+    return context;
+  }
+
+  private static StructClass requireClass(StructContext context, String name) {
+    StructClass result = context.getClass(name);
+    assertNotNull(result);
+    return result;
+  }
+
+  private static IContextSource source(String name, Map<String, byte[]> classes) {
+    return new ByteMapSource(name, classes, false, null);
+  }
+
+  private static IContextSource lazySource(String name, Map<String, byte[]> classes, AtomicInteger probes) {
+    return new ByteMapSource(name, classes, true, probes);
+  }
+
+  private static Map<String, byte[]> orderedMap(String firstName, byte[] firstBytes, String secondName, byte[] secondBytes) {
+    Map<String, byte[]> result = new LinkedHashMap<>();
+    result.put(firstName, firstBytes);
+    result.put(secondName, secondBytes);
+    return result;
+  }
+
+  private static String binaryName(Class<?> type) {
+    return type.getName().replace('.', '/');
+  }
+
+  private static byte[] classBytes(Class<?> type) {
+    return classBytes(binaryName(type));
+  }
+
+  private static byte[] classBytes(String binaryName) {
+    String resource = "/" + binaryName + ".class";
+    try (InputStream stream = DuplicateClassResolutionTest.class.getResourceAsStream(resource)) {
+      if (stream == null) {
+        throw new IllegalStateException("Missing test class resource " + resource);
+      }
+      return stream.readAllBytes();
+    } catch (IOException exception) {
+      throw new RuntimeException(exception);
+    }
+  }
+
+  private static byte[] renamedClassBytes(Class<?> type, String from, String to) {
+    return renamedClassBytes(classBytes(type), from, to);
+  }
+
+  private static byte[] renamedClassBytes(byte[] input, String from, String to) {
+    byte[] search = from.getBytes(StandardCharsets.UTF_8);
+    byte[] replacement = to.getBytes(StandardCharsets.UTF_8);
+    if (search.length != replacement.length) {
+      throw new IllegalArgumentException("Classfile replacement must preserve length");
+    }
+    byte[] result = Arrays.copyOf(input, input.length);
+    int replacements = 0;
+    for (int index = 0; index <= result.length - search.length; index++) {
+      if (matches(result, index, search)) {
+        System.arraycopy(replacement, 0, result, index, replacement.length);
+        replacements++;
+        index += search.length - 1;
+      }
+    }
+    if (replacements == 0) {
+      throw new IllegalArgumentException("Classfile text not found: " + from);
+    }
+    return result;
+  }
+
+  private static boolean matches(byte[] input, int offset, byte[] expected) {
+    for (int index = 0; index < expected.length; index++) {
+      if (input[offset + index] != expected[index]) {
+        return false;
+      }
+    }
+    return true;
+  }
+
+  private static final class ByteMapSource implements IContextSource {
+    private final String name;
+    private final Map<String, byte[]> classes;
+    private final boolean lazy;
+    private final AtomicInteger probes;
+
+    private ByteMapSource(String name, Map<String, byte[]> classes, boolean lazy, AtomicInteger probes) {
+      this.name = name;
+      this.classes = new LinkedHashMap<>(classes);
+      this.lazy = lazy;
+      this.probes = probes;
+    }
+
+    @Override
+    public String getName() {
+      return this.name;
+    }
+
+    @Override
+    public Entries getEntries() {
+      if (this.lazy) {
+        return Entries.EMPTY;
+      }
+      return new Entries(this.classes.keySet().stream().map(Entry::atBase).toList(), List.of(), List.of());
+    }
+
+    @Override
+    public boolean isLazy() {
+      return this.lazy;
+    }
+
+    @Override
+    public InputStream getInputStream(String resource) {
+      if (!resource.endsWith(CLASS_SUFFIX)) {
+        return null;
+      }
+      if (this.probes != null) {
+        this.probes.incrementAndGet();
+      }
+      byte[] bytes = this.classes.get(resource.substring(0, resource.length() - CLASS_SUFFIX.length()));
+      return bytes == null ? null : new ByteArrayInputStream(bytes);
+    }
+  }
+
+  private static final class RecordingLogger extends IFernflowerLogger {
+    private final List<String> messages = new ArrayList<>();
+
+    @Override
+    public void writeMessage(String message, Severity severity) {
+      this.messages.add(message);
+    }
+
+    @Override
+    public void writeMessage(String message, Severity severity, Throwable throwable) {
+      this.messages.add(message);
+    }
+  }
+}
+
+class Aaaaa extends ArrayList<Object> {
+}
+
+class Bbbbb extends HashMap<Object, Object> {
+}
+
+class FamilyOne {
+  class Member extends ArrayList<Object> {
+  }
+
+  class Sibling extends ArrayList<Object> {
+  }
+}
+
+class FamilyTwo {
+  class Member extends HashMap<Object, Object> {
+  }
+
+  class Sibling extends HashMap<Object, Object> {
+  }
+}
+
+class LocalOne {
+  Object member = new ArrayList<Object>() {
+  };
+}
+
+class LocalTwo {
+  Object member = new HashMap<Object, Object>() {
+  };
+}
