+ */
+package org.mapstruct.ap.test.inheritsupermappings;
+
+import org.mapstruct.BeanMapping;
+import org.mapstruct.Mapper;
+import org.mapstruct.Mapping;
+import org.mapstruct.factory.Mappers;
+
+interface RootMapper<S, T> {
+
+    @Mapping(target = "first", source = "left.value")
+    @Mapping(target = "second", source = "right.value")
+    T map(S left, S right);
+}
+
+interface SpecificMapper<S, T> extends RootMapper<S, T> {
+
+    @Override
+    @Mapping(target = "first", source = "right.value")
+    T map(S left, S right);
+}
+
+interface AdditionalMapper<S, T> {
+
+    @Mapping(target = "third", source = "left.value")
+    T map(S left, S right);
+}
+
+@Mapper
+public interface InheritedSuperMappingsMapper
+    extends SpecificMapper<Source, Target>, AdditionalMapper<Source, Target> {
+
+    InheritedSuperMappingsMapper INSTANCE = Mappers.getMapper( InheritedSuperMappingsMapper.class );
+
+    @Override
+    @BeanMapping(inheritSuperMappings = true)
+    @Mapping(target = "second", source = "first.value")
+    Target map(Source first, Source second);
+}
