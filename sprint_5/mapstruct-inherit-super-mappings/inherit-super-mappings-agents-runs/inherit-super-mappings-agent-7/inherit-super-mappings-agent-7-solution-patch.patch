+    private void inheritSuperMappings(SourceMethod method, TypeElement mapperToImplement,
+                                      MapperOptions mapperOptions) {
+        List<SuperMappingMethod> superMethods = new ArrayList<>();
+        collectSuperMappingMethods(
+            method.getExecutable(),
+            (DeclaredType) mapperToImplement.asType(),
+            mapperToImplement,
+            mapperOptions,
+            new HashSet<>(),
+            new HashSet<>(),
+            superMethods
+        );
+
+        if ( superMethods.isEmpty() ) {
+            messager.printMessage(
+                method.getExecutable(),
+                method.getOptions().getBeanMapping().getMirror(),
+                Message.BEANMAPPING_INHERIT_SUPER_MAPPINGS_NO_OVERRIDE
+            );
+            return;
+        }
+
+        Set<String> currentTargets = new HashSet<>();
+        for ( MappingOptions mapping : method.getOptions().getMappings() ) {
+            if ( !".".equals( mapping.getTargetName() ) ) {
+                currentTargets.add( mapping.getTargetName() );
+            }
+        }
+
+        Map<String, List<InheritedMapping>> inheritedMappings = new LinkedHashMap<>();
+        for ( SuperMappingMethod superMethod : superMethods ) {
+            for ( MappingOptions mapping : superMethod.method.getOptions().getMappings() ) {
+                String target = mapping.getTargetName();
+                if ( ".".equals( target ) ) {
+                    addInheritedMapping( method, superMethod.method, mapping );
+                }
+                else if ( !currentTargets.contains( target ) ) {
+                    inheritedMappings.computeIfAbsent( target, key -> new ArrayList<>() )
+                        .add( new InheritedMapping( superMethod, mapping ) );
+                }
+            }
+        }
+
+        for ( Map.Entry<String, List<InheritedMapping>> entry : inheritedMappings.entrySet() ) {
+            List<InheritedMapping> mostSpecific = mostSpecificMappings( entry.getValue() );
+            if ( mostSpecific.size() == 1 ) {
+                InheritedMapping inheritedMapping = mostSpecific.get( 0 );
+                addInheritedMapping( method, inheritedMapping.method.method, inheritedMapping.mapping );
+            }
+            else if ( mostSpecific.size() > 1 ) {
+                SuperMappingMethod first = mostSpecific.get( 0 ).method;
+                SuperMappingMethod second = mostSpecific.get( 1 ).method;
+                messager.printMessage(
+                    method.getExecutable(),
+                    method.getOptions().getBeanMapping().getMirror(),
+                    Message.BEANMAPPING_INHERIT_SUPER_MAPPINGS_CONFLICT,
+                    entry.getKey(),
+                    first.declaringType.getQualifiedName(),
+                    second.declaringType.getQualifiedName()
+                );
+            }
+        }
+    }
+
+    private void collectSuperMappingMethods(ExecutableElement overridingMethod, DeclaredType mapperType,
+                                            TypeElement mapperToImplement, MapperOptions mapperOptions,
+                                            Set<String> visitedTypes, Set<ExecutableElement> visitedMethods,
+                                            List<SuperMappingMethod> superMethods) {
+        for ( TypeMirror superType : typeUtils.directSupertypes( mapperType ) ) {
+            if ( superType.getKind() != TypeKind.DECLARED ) {
+                continue;
+            }
+
+            DeclaredType declaredSuperType = (DeclaredType) superType;
+            TypeElement superTypeElement = (TypeElement) declaredSuperType.asElement();
+            if ( !visitedTypes.add( superTypeElement.getQualifiedName().toString() ) ) {
+                continue;
+            }
+
+            for ( ExecutableElement candidate : methodsIn( superTypeElement.getEnclosedElements() ) ) {
+                if ( visitedMethods.add( candidate )
+                    && elementUtils.overrides( overridingMethod, candidate, mapperToImplement ) ) {
+                    superMethods.add( new SuperMappingMethod(
+                        createSuperMappingMethod( candidate, declaredSuperType, mapperOptions ),
+                        superTypeElement
+                    ) );
+                }
+            }
+
+            collectSuperMappingMethods(
+                overridingMethod,
+                declaredSuperType,
+                mapperToImplement,
+                mapperOptions,
+                visitedTypes,
+                visitedMethods,
+                superMethods
+            );
+        }
+    }
+
+    private SourceMethod createSuperMappingMethod(ExecutableElement method, DeclaredType mapperType,
+                                                   MapperOptions mapperOptions) {
+        ExecutableType methodType = typeFactory.getMethodType( mapperType, method );
+        List<Parameter> parameters = typeFactory.getParameters( methodType, method );
+        BeanMappingOptions beanMappingOptions = BeanMappingOptions.getInstanceOn(
+            BeanMappingGem.instanceOn( method ),
+            mapperOptions,
+            method,
+            messager,
+            typeUtils,
+            typeFactory
+        );
+
+        return new SourceMethod.Builder()
+            .setExecutable( method )
+            .setParameters( parameters )
+            .setReturnType( typeFactory.getReturnType( methodType ) )
+            .setExceptionTypes( typeFactory.getThrownTypes( methodType ) )
+            .setMapper( mapperOptions )
+            .setBeanMappingOptions( beanMappingOptions )
+            .setMappingOptions( getMappings( method, beanMappingOptions ) )
+            .setTypeUtils( typeUtils )
+            .setTypeFactory( typeFactory )
+            .build();
+    }
+
+    private List<InheritedMapping> mostSpecificMappings(List<InheritedMapping> mappings) {
+        List<InheritedMapping> result = new ArrayList<>();
+        for ( InheritedMapping candidate : mappings ) {
+            boolean overridden = false;
+            for ( InheritedMapping other : mappings ) {
+                if ( candidate != other && typeUtils.isSubtypeErased(
+                    other.method.declaringType.asType(),
+                    candidate.method.declaringType.asType()
+                ) ) {
+                    overridden = true;
+                    break;
+                }
+            }
+            if ( !overridden ) {
+                result.add( candidate );
+            }
+        }
+        return result;
+    }
+
+    private void addInheritedMapping(SourceMethod method, SourceMethod superMethod, MappingOptions mapping) {
+        String sourceName = rebindSuperSourceName( method, superMethod, mapping.getSourceName() );
+        method.getOptions().getMappings().add(
+            mapping.copyForSuperInheritance( superMethod, method.getOptions().getBeanMapping(), sourceName )
+        );
+    }
+
+    private String rebindSuperSourceName(SourceMethod method, SourceMethod superMethod, String sourceName) {
+        if ( sourceName == null || sourceName.isEmpty() ) {
+            return sourceName;
+        }
+
+        String trimmedSourceName = sourceName.trim();
+        String[] segments = trimmedSourceName.split( "\\." );
+        Parameter sourceParameter = sourceParameterForSuperMapping( superMethod, segments );
+        if ( sourceParameter == null ) {
+            return sourceName;
+        }
+
+        int parameterIndex = superMethod.getParameters().indexOf( sourceParameter );
+        if ( parameterIndex < 0 || parameterIndex >= method.getParameters().size() ) {
+            return sourceName;
+        }
+
+        Parameter overridingParameter = method.getParameters().get( parameterIndex );
+        return overridingParameter.getName() + trimmedSourceName.substring( segments[0].length() );
+    }
+
+    private Parameter sourceParameterForSuperMapping(SourceMethod superMethod, String[] segments) {
+        List<Parameter> sourceParameters = superMethod.getSourceParameters();
+        if ( sourceParameters.size() > 1 ) {
+            return Parameter.getSourceParameter( sourceParameters, segments[0] );
+        }
+        if ( sourceParameters.size() == 1 ) {
+            Parameter sourceParameter = sourceParameters.get( 0 );
+            if ( !isPropertyPath( sourceParameter, segments ) && sourceParameter.getName().equals( segments[0] ) ) {
+                return sourceParameter;
+            }
+        }
+        return null;
+    }
+
+    private boolean isPropertyPath(Parameter sourceParameter, String[] segments) {
+        Type sourceType = sourceParameter.getType();
+        boolean allowedMapToBean = sourceType.isMapType() && !segments[0].equals( sourceParameter.getName() );
+        Type currentType = sourceType;
+        for ( int i = 0; i < segments.length; i++ ) {
+            Type noBoundsType = currentType.withoutBounds();
+            if ( noBoundsType.isOptionalType() ) {
+                noBoundsType = noBoundsType.getOptionalBaseType();
+            }
+            ReadAccessor readAccessor = noBoundsType.getReadAccessor( segments[i], i > 0 || allowedMapToBean );
+            if ( readAccessor == null || noBoundsType.getTypeMirror().getKind() != TypeKind.DECLARED ) {
+                return false;
+            }
+            currentType = typeFactory.getReturnType( (DeclaredType) noBoundsType.getTypeMirror(), readAccessor );
+        }
+        return true;
+    }
+
+    private static class SuperMappingMethod {
+        private final SourceMethod method;
+        private final TypeElement declaringType;
+
+        private SuperMappingMethod(SourceMethod method, TypeElement declaringType) {
+            this.method = method;
+            this.declaringType = declaringType;
+        }
+    }
+
+    private static class InheritedMapping {
+        private final SuperMappingMethod method;
+        private final MappingOptions mapping;
+
+        private InheritedMapping(SuperMappingMethod method, MappingOptions mapping) {
+            this.method = method;
+            this.mapping = mapping;
+        }
     }
 
