+import static org.assertj.core.api.Assertions.assertThat;
+
+@WithClasses({ Source.class, Target.class })
+public class InheritedSuperMappingsTest {
+
+    @ProcessorTest
+    @WithClasses(InheritedSuperMappingsMapper.class)
+    public void shouldInheritMappingsUsingSpecificityAndCurrentPrecedence() {
+        Target target = InheritedSuperMappingsMapper.INSTANCE.map( new Source( "first" ), new Source( "second" ) );
+
+        assertThat( target.getFirst() ).isEqualTo( "second" );
+        assertThat( target.getSecond() ).isEqualTo( "first" );
+        assertThat( target.getThird() ).isEqualTo( "first" );
+    }
+
+    @ProcessorTest
+    @WithClasses(FlatteningMapper.class)
+    public void shouldAccumulateFlatteningMappings() {
+        LeftPart left = new LeftPart();
+        left.setFirst( "first" );
+        RightPart right = new RightPart();
+        right.setThird( "third" );
+
+        Target target = FlatteningMapper.INSTANCE.map( left, right );
+
+        assertThat( target.getFirst() ).isEqualTo( "first" );
+        assertThat( target.getThird() ).isEqualTo( "third" );
+    }
+
+    @ProcessorTest
+    @WithClasses(PropertyNamedLikeParameterMapper.class)
+    public void shouldKeepAPropertyPathNamedLikeTheLoneSuperParameter() {
+        SourceWithSourceProperty source = new SourceWithSourceProperty();
+        source.setSource( "property" );
+
+        Target target = PropertyNamedLikeParameterMapper.INSTANCE.map( source );
+
+        assertThat( target.getFirst() ).isEqualTo( "property" );
+    }
+
+    @ProcessorTest
+    @WithClasses(ConflictingSuperMappingsMapper.class)
+    @ExpectedCompilationOutcome(
+        value = CompilationResult.FAILED,
+        diagnostics = @Diagnostic(
+            type = ConflictingSuperMappingsMapper.class,
+            kind = Kind.ERROR,
+            line = 29,
+            message = "Inherited mappings for target \"first\" are declared by incomparable mapper types "
+                + "org.mapstruct.ap.test.inheritsupermappings.FirstConflictingMapper and "
+                + "org.mapstruct.ap.test.inheritsupermappings.SecondConflictingMapper."
+        )
+    )
+    public void shouldReportConflictingMappingsFromIncomparableBranches() {
+    }
+
+    @ProcessorTest
+    @WithClasses(NoSuperMappingMapper.class)
+    @ExpectedCompilationOutcome(
+        value = CompilationResult.FAILED,
+        diagnostics = @Diagnostic(
+            type = NoSuperMappingMapper.class,
+            kind = Kind.ERROR,
+            line = 15,
+            message = "@BeanMapping( inheritSuperMappings = true ) requires the method to override a mapping method."
+        )
+    )
+    public void shouldRequireAnOverriddenMappingMethod() {
+    }
+}
