+import org.mapstruct.ap.testutil.compilation.annotation.ExpectedCompilationOutcome;
+
+import static javax.tools.Diagnostic.Kind.ERROR;
+import static org.assertj.core.api.Assertions.assertThat;
+
+@WithClasses({ Source.class, Nested.class, Details.class, MappingTarget.class })
+public class InheritedSuperMappingsTest {
+
+    @ProcessorTest
+    @WithClasses(InheritedMapper.class)
+    public void shouldInheritMappingsFromOverriddenMethods() {
+        Source first = new Source();
+        first.setValue( "inherited" );
+        first.setOther( "ignored" );
+        first.setNested( nested( "from first" ) );
+
+        Source second = new Source();
+        second.setValue( "expression" );
+        second.setDetails( details( "from second" ) );
+
+        MappingTarget target = InheritedMapper.INSTANCE.map( first, second );
+
+        assertThat( target.getInherited() ).isEqualTo( "inherited" );
+        assertThat( target.getSpecific() ).isNull();
+        assertThat( target.getExpression() ).isEqualTo( "expression" );
+        assertThat( target.getNestedValue() ).isEqualTo( "from first" );
+        assertThat( target.getDetailValue() ).isEqualTo( "from second" );
+    }
+
+    @ProcessorTest
+    @WithClasses(InheritedMapper.class)
+    public void shouldKeepPropertyMeaningAndAcceptEmptySuperMappings() {
+        Source source = new Source();
+        source.setSource( "property" );
+        source.setValue( "automatic" );
+
+        assertThat( InheritedMapper.INSTANCE.single( source ).getPropertyName() ).isEqualTo( "property" );
+        assertThat( InheritedMapper.INSTANCE.empty( source ).getValue() ).isEqualTo( "automatic" );
+    }
+
+    @ProcessorTest
+    @WithClasses(NoOverrideMapper.class)
+    @ExpectedCompilationOutcome(
+        value = CompilationResult.FAILED,
+        diagnostics = @Diagnostic(
+            type = NoOverrideMapper.class,
