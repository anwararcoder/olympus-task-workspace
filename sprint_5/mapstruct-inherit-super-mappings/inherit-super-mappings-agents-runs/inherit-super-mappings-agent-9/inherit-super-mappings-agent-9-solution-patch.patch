+    private void inheritSuperMappings(ExecutableElement method, List<Parameter> parameters, Type returnType,
+                                      TypeElement mapperToImplement, BeanMappingOptions beanMapping,
+                                      Set<MappingOptions> mappings) {
+        List<SuperMappingMethod> superMethods = new ArrayList<>();
+        collectSuperMappingMethods(
+            method,
+            (DeclaredType) mapperToImplement.asType(),
+            mapperToImplement,
+            beanMapping,
+            new HashSet<>(),
+            superMethods
+        );
+
+        if ( superMethods.isEmpty() ) {
+            messager.printMessage(
+                method,
+                beanMapping.getMirror(),
+                Message.PROPERTYMAPPING_INHERIT_SUPER_NO_OVERRIDE
+            );
+            return;
+        }
+
+        SourceMethod overridingMethod = createSuperSourceMethod(
+            method, parameters, returnType, mappings, beanMapping
+        );
+        Set<String> currentTargets = new HashSet<>();
+        for ( MappingOptions mapping : mappings ) {
+            if ( !".".equals( mapping.getTargetName() ) ) {
+                currentTargets.add( mapping.getTargetName() );
+            }
+        }
+
+        Map<String, List<InheritedMapping>> inheritedByTarget = new LinkedHashMap<>();
+        List<MappingOptions> flatteningMappings = new ArrayList<>();
+        for ( SuperMappingMethod superMethod : superMethods ) {
+            for ( MappingOptions mapping : superMethod.mappings ) {
+                MappingOptions inheritedMapping = copySuperMapping( mapping, superMethod.method, overridingMethod,
+                    beanMapping );
+                if ( ".".equals( mapping.getTargetName() ) ) {
+                    flatteningMappings.add( inheritedMapping );
+                }
+                else if ( !currentTargets.contains( mapping.getTargetName() ) ) {
+                    inheritedByTarget.computeIfAbsent( mapping.getTargetName(), key -> new ArrayList<>() )
+                        .add( new InheritedMapping( superMethod, inheritedMapping ) );
+                }
+            }
+        }
+
+        mappings.addAll( flatteningMappings );
+        for ( Map.Entry<String, List<InheritedMapping>> entry : inheritedByTarget.entrySet() ) {
+            List<InheritedMapping> mostSpecific = mostSpecificMappings( entry.getValue() );
+            if ( mostSpecific.size() == 1 ) {
+                mappings.add( mostSpecific.get( 0 ).mapping );
+            }
+            else if ( mostSpecific.size() > 1 ) {
+                messager.printMessage(
+                    method,
+                    beanMapping.getMirror(),
+                    Message.PROPERTYMAPPING_INHERIT_SUPER_CONFLICT,
+                    entry.getKey(),
+                    mostSpecific.get( 0 ).superMethod.declaringType.getQualifiedName(),
+                    mostSpecific.get( 1 ).superMethod.declaringType.getQualifiedName()
+                );
+            }
+        }
+    }
+
+    private void collectSuperMappingMethods(ExecutableElement overridingMethod, DeclaredType currentType,
+                                            TypeElement mapperToImplement, BeanMappingOptions beanMapping,
+                                            Set<TypeElement> visited, List<SuperMappingMethod> superMethods) {
+        for ( TypeMirror superTypeMirror : typeUtils.directSupertypes( currentType ) ) {
+            if ( superTypeMirror.getKind() != TypeKind.DECLARED ) {
+                continue;
+            }
+            DeclaredType superType = (DeclaredType) superTypeMirror;
+            TypeElement superElement = (TypeElement) superType.asElement();
+            if ( !visited.add( superElement ) ) {
+                continue;
+            }
+
+            for ( ExecutableElement candidate : ElementFilter.methodsIn( superElement.getEnclosedElements() ) ) {
+                if ( candidate.getModifiers().contains( Modifier.ABSTRACT )
+                    && elementUtils.overrides( overridingMethod, candidate, mapperToImplement ) ) {
+                    ExecutableType candidateType = typeFactory.getMethodType( superType, candidate );
+                    List<Parameter> candidateParameters = typeFactory.getParameters( candidateType, candidate );
+                    SourceMethod sourceMethod = createSuperSourceMethod(
+                        candidate,
+                        candidateParameters,
+                        typeFactory.getReturnType( candidateType ),
+                        Collections.emptySet(),
+                        beanMapping
+                    );
+                    superMethods.add( new SuperMappingMethod(
+                        sourceMethod,
+                        superElement,
+                        getMappings( candidate, beanMapping )
+                    ) );
+                }
+            }
+            collectSuperMappingMethods(
+                overridingMethod,
+                superType,
+                mapperToImplement,
+                beanMapping,
+                visited,
+                superMethods
+            );
+        }
+    }
+
+    private SourceMethod createSuperSourceMethod(ExecutableElement executable, List<Parameter> parameters,
+                                                 Type returnType, Set<MappingOptions> mappings,
+                                                 BeanMappingOptions beanMapping) {
+        ExecutableType executableType = (ExecutableType) executable.asType();
+        return new SourceMethod.Builder()
+            .setExecutable( executable )
+            .setParameters( parameters )
+            .setReturnType( returnType )
+            .setExceptionTypes( typeFactory.getThrownTypes( executableType ) )
+            .setMappingOptions( mappings )
+            .setBeanMappingOptions( beanMapping )
+            .setTypeUtils( typeUtils )
+            .setTypeFactory( typeFactory )
+            .build();
+    }
+
+    private MappingOptions copySuperMapping(MappingOptions mapping, SourceMethod superMethod,
+                                            SourceMethod overridingMethod, BeanMappingOptions beanMapping) {
+        Integer sourceParameterPosition = sourceParameterPosition( mapping.getSourceName(), superMethod );
+        String sourceName = mapping.getSourceName();
+        if ( sourceParameterPosition != null ) {
+            String firstSegment = firstSegment( sourceName );
+            sourceName = overridingMethod.getParameters().get( sourceParameterPosition ).getName()
+                + sourceName.substring( firstSegment.length() );
+        }
+        return mapping.copyForSuperInheritance(
+            superMethod,
+            beanMapping,
+            sourceName,
+            sourceParameterPosition
+        );
+    }
+
+    private Integer sourceParameterPosition(String sourceName, SourceMethod method) {
+        if ( sourceName == null ) {
+            return null;
+        }
+        String firstSegment = firstSegment( sourceName );
+        for ( int i = 0; i < method.getParameters().size(); i++ ) {
+            Parameter parameter = method.getParameters().get( i );
+            if ( parameter.getName().equals( firstSegment ) && method.getSourceParameters().contains( parameter ) ) {
+                if ( method.getSourceParameters().size() > 1
+                    || !resolvesAsPropertyPath( method.getSourceParameters().get( 0 ), sourceName ) ) {
+                    return i;
+                }
+                return null;
+            }
+        }
+        return null;
+    }
+
+    private boolean resolvesAsPropertyPath(Parameter parameter, String sourceName) {
+        String[] segments = sourceName.split( "\\." );
+        Type currentType = parameter.getType();
+        boolean allowedMapToBean = currentType.isMapType() && !segments[0].equals( parameter.getName() );
+        for ( int i = 0; i < segments.length; i++ ) {
+            Type noBoundsType = currentType.withoutBounds();
+            if ( noBoundsType.isOptionalType() ) {
+                noBoundsType = noBoundsType.getOptionalBaseType();
+            }
+            ReadAccessor readAccessor = noBoundsType.getReadAccessor( segments[i], i > 0 || allowedMapToBean );
+            if ( readAccessor == null || noBoundsType.getTypeMirror().getKind() != TypeKind.DECLARED ) {
+                return false;
+            }
+            currentType = typeFactory.getReturnType( (DeclaredType) noBoundsType.getTypeMirror(), readAccessor );
+        }
+        return true;
+    }
+
+    private String firstSegment(String sourceName) {
+        int separator = sourceName.indexOf( '.' );
+        return separator < 0 ? sourceName : sourceName.substring( 0, separator );
+    }
+
+    private List<InheritedMapping> mostSpecificMappings(List<InheritedMapping> mappings) {
+        List<InheritedMapping> result = new ArrayList<>();
+        for ( InheritedMapping candidate : mappings ) {
+            boolean overridden = false;
+            for ( InheritedMapping other : mappings ) {
+                if ( candidate != other && typeUtils.isSubtype(
+                    other.superMethod.declaringType.asType(),
+                    candidate.superMethod.declaringType.asType()
+                ) ) {
+                    overridden = true;
+                    break;
+                }
+            }
+            if ( !overridden ) {
+                result.add( candidate );
+            }
+        }
+        return result;
+    }
+
+    private static class SuperMappingMethod {
+        private final SourceMethod method;
+        private final TypeElement declaringType;
+        private final Set<MappingOptions> mappings;
+
+        private SuperMappingMethod(SourceMethod method, TypeElement declaringType, Set<MappingOptions> mappings) {
+            this.method = method;
+            this.declaringType = declaringType;
+            this.mappings = mappings;
+        }
+    }
+
+    private static class InheritedMapping {
+        private final SuperMappingMethod superMethod;
+        private final MappingOptions mapping;
+
+        private InheritedMapping(SuperMappingMethod superMethod, MappingOptions mapping) {
+            this.superMethod = superMethod;
+            this.mapping = mapping;
+        }
+    }
+
