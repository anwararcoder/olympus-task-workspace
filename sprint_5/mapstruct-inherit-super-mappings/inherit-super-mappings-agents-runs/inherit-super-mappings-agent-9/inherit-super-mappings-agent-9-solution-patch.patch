+package org.mapstruct.ap.test.inheritsupermappings;
+
+import org.mapstruct.ap.test.inheritsupermappings.erroneous.ConflictingMapper;
+import org.mapstruct.ap.test.inheritsupermappings.erroneous.NoOverrideMapper;
+import org.mapstruct.ap.testutil.ProcessorTest;
