+
+@Mapper
+public interface InheritedMapper extends IntermediateMapper<Source>, SingleMapper, EmptyMapper {
+
+    InheritedMapper INSTANCE = Mappers.getMapper( InheritedMapper.class );
+
+    @Override
+    @BeanMapping(inheritSuperMappings = true, unmappedTargetPolicy = ReportingPolicy.IGNORE)
+    @Mapping(target = "specific", ignore = true)
+    @Mapping(target = "value", ignore = true)
+    @Mapping(target = "propertyName", ignore = true)
+    @Mapping(target = ".", source = "second.details")
+    MappingTarget map(Source renamedFirst, Source second);
+
+    @Override
+    @BeanMapping(inheritSuperMappings = true, unmappedTargetPolicy = ReportingPolicy.IGNORE)
+    MappingTarget single(Source renamed);
+
+    @Override
+    @BeanMapping(inheritSuperMappings = true, unmappedTargetPolicy = ReportingPolicy.IGNORE)
+    MappingTarget empty(Source source);
+}
+
+interface RootMapper<S> {
+
+    @ComposedMappings
+    @BeanMapping(ignoreByDefault = true)
+    @Mapping(target = ".", source = "first.nested")
+    MappingTarget map(S first, Source second);
+}
+
+interface IntermediateMapper<S> extends RootMapper<S> {
+
+    @Override
+    @Mapping(target = "specific", source = "first.other")
+    MappingTarget map(S first, Source second);
+}
+
+interface SingleMapper {
+
+    @Mapping(target = "propertyName", source = "source")
+    MappingTarget single(Source source);
+}
+
+interface EmptyMapper {
+
+    MappingTarget empty(Source source);
+}
+
+@Target({ ElementType.METHOD, ElementType.ANNOTATION_TYPE })
+@Retention(RetentionPolicy.CLASS)
+@Mapping(target = "inherited", source = "first.value")
+@Mapping(target = "expression", expression = "java(second.getValue())")
+@interface ComposedMappings {
+}
