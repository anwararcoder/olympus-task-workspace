+/*
+ * Copyright MapStruct Authors.
+ *
+ * Licensed under the Apache License version 2.0, available at http://www.apache.org/licenses/LICENSE-2.0
+ */
+package org.mapstruct.ap.test.inheritsupermappings;
+
+import javax.tools.Diagnostic.Kind;
+
+import org.mapstruct.ap.testutil.ProcessorTest;
+import org.mapstruct.ap.testutil.WithClasses;
+import org.mapstruct.ap.testutil.compilation.annotation.CompilationResult;
+import org.mapstruct.ap.testutil.compilation.annotation.Diagnostic;
+import org.mapstruct.ap.testutil.compilation.annotation.ExpectedCompilationOutcome;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+class InheritedSuperMappingsTest {
+
+    @ProcessorTest
+    @WithClasses(InheritedSuperMappingsMapper.class)
+    void shouldInheritAndMergeSuperMappings() {
+        InheritedSuperMappingsMapper.Source source = source();
+
+        InheritedSuperMappingsMapper.Target basic = InheritedSuperMappingsMapper.INSTANCE.basic( source );
+        assertThat( basic.getDisplay() ).isEqualTo( "name" );
+        assertThat( basic.getAge() ).isEqualTo( 10 );
+        assertThat( basic.getIgnored() ).isNull();
+
+        InheritedSuperMappingsMapper.PropertySource propertySource =
+            new InheritedSuperMappingsMapper.PropertySource();
+        propertySource.setSource( "property" );
+        propertySource.setName( "whole-parameter" );
+        assertThat( InheritedSuperMappingsMapper.INSTANCE.property( propertySource ).getValue() )
+            .isEqualTo( "property" );
+
+        InheritedSuperMappingsMapper.Source second = source();
+        second.setName( "second" );
+        InheritedSuperMappingsMapper.PairTarget pair = InheritedSuperMappingsMapper.INSTANCE.pair( source, second );
+        assertThat( pair.getLeft() ).isEqualTo( "name" );
+        assertThat( pair.getRight() ).isSameAs( second );
+
+        assertThat( InheritedSuperMappingsMapper.INSTANCE.generic( source ).getValue() ).isEqualTo( "name" );
+        assertThat( InheritedSuperMappingsMapper.INSTANCE.automatic( source ).getAge() ).isEqualTo( 10 );
+        assertThat( InheritedSuperMappingsMapper.INSTANCE.disabled( source ).getDisplay() ).isEqualTo( "display" );
+        assertThat( InheritedSuperMappingsMapper.INSTANCE.expression( source ).getDisplay() ).isEqualTo( "source" );
+
+        InheritedSuperMappingsMapper.Target configured =
+            InheritedSuperMappingsMapper.INSTANCE.configured( source );
+        assertThat( configured.getDisplay() ).isEqualTo( "name" );
+        assertThat( configured.getAge() ).isEqualTo( 20 );
+        assertThat( InheritedSuperMappingsMapper.INSTANCE.configured( null ) ).isNotNull();
+
+        InheritedSuperMappingsMapper.Target specific = InheritedSuperMappingsMapper.INSTANCE.specific( source );
+        assertThat( specific.getDisplay() ).isEqualTo( "alias" );
+        assertThat( specific.getAge() ).isEqualTo( 10 );
+
+        InheritedSuperMappingsMapper.Target branches = InheritedSuperMappingsMapper.INSTANCE.branches( source );
+        assertThat( branches.getDisplay() ).isEqualTo( "name" );
+        assertThat( branches.getAge() ).isEqualTo( 20 );
+
+        InheritedSuperMappingsMapper.Target resolvedBranches =
+            InheritedSuperMappingsMapper.INSTANCE.resolvedBranches( source );
+        assertThat( resolvedBranches.getDisplay() ).isEqualTo( "alias" );
+    }
+
+    @ProcessorTest
+    @WithClasses(SuperclassInheritedSuperMappingsMapper.class)
+    void shouldInheritMappingsFromSuperclass() {
+        SuperclassInheritedSuperMappingsMapper.Source source =
+            new SuperclassInheritedSuperMappingsMapper.Source();
+        source.setName( "superclass" );
+
+        assertThat( SuperclassInheritedSuperMappingsMapper.INSTANCE.map( source ).getValue() )
+            .isEqualTo( "superclass" );
+    }
+
+    @ProcessorTest
+    @WithClasses(FlatteningSuperMappingsMapper.class)
+    void shouldAccumulateFlatteningMappingsAcrossDiamond() {
+        FlatteningSuperMappingsMapper.Container source = new FlatteningSuperMappingsMapper.Container();
+        FlatteningSuperMappingsMapper.RootPart root = new FlatteningSuperMappingsMapper.RootPart();
+        root.setRootValue( "root" );
+        source.setRoot( root );
+        FlatteningSuperMappingsMapper.LeftPart left = new FlatteningSuperMappingsMapper.LeftPart();
+        left.setLeftValue( "left" );
+        source.setLeft( left );
+        FlatteningSuperMappingsMapper.RightPart right = new FlatteningSuperMappingsMapper.RightPart();
+        right.setRightValue( "right" );
+        source.setRight( right );
+        FlatteningSuperMappingsMapper.CurrentPart current = new FlatteningSuperMappingsMapper.CurrentPart();
+        current.setCurrentValue( "current" );
+        source.setCurrent( current );
+
+        FlatteningSuperMappingsMapper.FlatTarget target = FlatteningSuperMappingsMapper.INSTANCE.map( source );
+
+        assertThat( target.getRootValue() ).isEqualTo( "root" );
+        assertThat( target.getLeftValue() ).isEqualTo( "left" );
+        assertThat( target.getRightValue() ).isEqualTo( "right" );
+        assertThat( target.getCurrentValue() ).isEqualTo( "current" );
+    }
+
+    @ProcessorTest
+    @WithClasses(ErroneousInheritedSuperMappingsMapper.class)
+    @ExpectedCompilationOutcome(
+        value = CompilationResult.FAILED,
+        diagnostics = {
+            @Diagnostic(
+                type = ErroneousInheritedSuperMappingsMapper.class,
+                kind = Kind.ERROR,
+                line = 15,
+                message = "@BeanMapping( inheritSuperMappings = true ) requires the method to override at least " +
+                    "one mapping method."
+            ),
+            @Diagnostic(
+                type = ErroneousInheritedSuperMappingsMapper.class,
+                kind = Kind.ERROR,
+                line = 19,
+                message = "Cannot inherit mapping for target \"value\" from unrelated mapper types " +
+                    "org.mapstruct.ap.test.inheritsupermappings.ConflictLeft, " +
+                    "org.mapstruct.ap.test.inheritsupermappings.ConflictRight."
+            )
+        }
+    )
+    void shouldReportInvalidSuperMappingInheritance() {
+    }
+
+    private InheritedSuperMappingsMapper.Source source() {
+        InheritedSuperMappingsMapper.Source source = new InheritedSuperMappingsMapper.Source();
+        source.setName( "name" );
+        source.setDisplay( "display" );
+        source.setAlias( "alias" );
+        source.setAge( 10 );
+        source.setConfiguredAge( 20 );
+        source.setIgnored( "ignored" );
+        return source;
+    }
+}
