+    private void collectOverriddenMappingMethods(ExecutableElement method,
+                                                 TypeElement declaringType,
+                                                 TypeElement overrideContextType,
+                                                 Set<ExecutableElement> visitedMethods,
+                                                 List<ExecutableElement> overriddenMethods) {
+        for ( TypeMirror supertype : typeUtils.directSupertypes( declaringType.asType() ) ) {
+            Element supertypeElement = typeUtils.asElement( supertype );
+            if ( !( supertypeElement instanceof TypeElement ) ) {
+                continue;
+            }
+
+            TypeElement supertypeDeclaration = (TypeElement) supertypeElement;
+            List<ExecutableElement> declaredMethods = ElementFilter.methodsIn(
+                supertypeDeclaration.getEnclosedElements()
+            );
+            for ( ExecutableElement candidate : declaredMethods ) {
+                if ( candidate.getModifiers().contains( Modifier.ABSTRACT )
+                    && elementUtils.overrides( method, candidate, overrideContextType )
+                    && visitedMethods.add( candidate ) ) {
+                    overriddenMethods.add( candidate );
+                }
+            }
+            collectOverriddenMappingMethods(
+                method,
+                supertypeDeclaration,
+                overrideContextType,
+                visitedMethods,
+                overriddenMethods
+            );
+        }
+    }
+
+    private List<SuperMapping> getMostSpecificMappings(List<SuperMapping> mappings) {
+        List<SuperMapping> mostSpecificMappings = new ArrayList<>();
+        for ( SuperMapping candidate : mappings ) {
+            boolean overridden = false;
+            for ( SuperMapping other : mappings ) {
+                TypeElement candidateDeclaringType = (TypeElement) candidate.method.getEnclosingElement();
+                TypeElement otherDeclaringType = (TypeElement) other.method.getEnclosingElement();
+                if ( candidate != other
+                    && typeUtils.isSubtypeErased( otherDeclaringType.asType(), candidateDeclaringType.asType() ) ) {
+                    overridden = true;
+                    break;
+                }
+            }
+            if ( !overridden ) {
+                mostSpecificMappings.add( candidate );
+            }
+        }
+        return mostSpecificMappings;
+    }
+
+    private Integer getSuperMappingSourceParameterPosition(String sourceName,
+                                                           List<Parameter> overriddenParameters,
+                                                           List<Parameter> overridingParameters) {
+        if ( sourceName == null ) {
+            return null;
+        }
+
+        String trimmedSourceName = sourceName.trim();
+        String[] sourceSegments = trimmedSourceName.split( "\\." );
+        if ( sourceSegments.length == 0 ) {
+            return null;
+        }
+
+        List<Parameter> sourceParameters = Parameter.getSourceParameters( overriddenParameters );
+        Parameter referencedParameter = null;
+        if ( sourceParameters.size() > 1 ) {
+            referencedParameter = Parameter.getSourceParameter( overriddenParameters, sourceSegments[0] );
+        }
+        else if ( sourceParameters.size() == 1 ) {
+            Parameter sourceParameter = sourceParameters.get( 0 );
+            boolean allowedMapToBean = !sourceParameter.getType().isMapType()
+                || !sourceSegments[0].equals( sourceParameter.getName() );
+            if ( !matchesSourceProperties( sourceParameter.getType(), sourceSegments, allowedMapToBean )
+                && sourceSegments[0].equals( sourceParameter.getName() ) ) {
+                referencedParameter = sourceParameter;
+            }
+        }
+
+        if ( referencedParameter == null ) {
+            return null;
+        }
+
+        int parameterPosition = overriddenParameters.indexOf( referencedParameter );
+        if ( parameterPosition < 0 || parameterPosition >= overridingParameters.size() ) {
+            return null;
+        }
+        return parameterPosition;
+    }
+
+    private boolean matchesSourceProperties(Type sourceType, String[] sourceSegments, boolean allowedMapToBean) {
+        Type currentType = sourceType;
+        for ( int i = 0; i < sourceSegments.length; i++ ) {
+            Type noBoundsType = currentType.withoutBounds();
+            if ( noBoundsType.isOptionalType() ) {
+                noBoundsType = noBoundsType.getOptionalBaseType();
+            }
+            ReadAccessor readAccessor = noBoundsType.getReadAccessor(
+                sourceSegments[i],
+                i > 0 || allowedMapToBean
+            );
+            if ( readAccessor == null ) {
+                return false;
+            }
+            currentType = typeFactory.getReturnType(
+                (DeclaredType) noBoundsType.getTypeMirror(),
+                readAccessor
+            );
+        }
+        return true;
+    }
+
+    private static class SuperMapping {
