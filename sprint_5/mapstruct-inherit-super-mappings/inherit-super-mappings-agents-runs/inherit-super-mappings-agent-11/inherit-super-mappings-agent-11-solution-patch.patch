+    @BeanMapping(inheritSuperMappings = true)
+    Target specific(Source source);
+
+    @Override
+    @BeanMapping(inheritSuperMappings = true)
+    Target branches(Source source);
+
+    @Override
+    @BeanMapping(inheritSuperMappings = true)
+    @Mapping(target = "display", source = "alias")
+    Target resolvedBranches(Source source);
+
