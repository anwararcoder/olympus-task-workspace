+    private void applySuperMappings(SourceMethod sourceMethod, BeanMappingGem beanMapping,
+                                    MapperOptions mapperOptions, List<SourceMethod> prototypeMethods,
+                                    TypeElement mapperToImplement) {
+        List<SourceMethod> overriddenMethods = new ArrayList<>();
+        collectOverriddenMappingMethods(
+            sourceMethod.getExecutable(),
+            mapperToImplement.asType(),
+            mapperOptions,
+            prototypeMethods,
+            mapperToImplement,
+            new HashSet<>(),
+            overriddenMethods
+        );
+
+        if ( overriddenMethods.isEmpty() ) {
+            messager.printMessage(
+                sourceMethod.getExecutable(),
+                beanMapping.mirror(),
+                beanMapping.inheritSuperMappings().getAnnotationValue(),
+                Message.BEANMAPPING_INHERIT_SUPER_MAPPINGS_NO_OVERRIDE
+            );
+            return;
+        }
+
+        Set<String> currentTargets = MappingOptions.getMappingTargetNamesBy(
+            mapping -> true,
+            sourceMethod.getOptions().getMappings()
+        );
+        Map<String, List<InheritedMapping>> mappingsByTarget = new LinkedHashMap<>();
+        List<InheritedMapping> flatteningMappings = new ArrayList<>();
+        for ( SourceMethod overriddenMethod : overriddenMethods ) {
+            for ( MappingOptions mapping : overriddenMethod.getOptions().getMappings() ) {
+                InheritedMapping inheritedMapping = new InheritedMapping( overriddenMethod, mapping );
+                if ( ".".equals( mapping.getTargetName() ) ) {
+                    flatteningMappings.add( inheritedMapping );
+                }
+                else if ( !currentTargets.contains( mapping.getTargetName() ) ) {
+                    mappingsByTarget.computeIfAbsent( mapping.getTargetName(), key -> new ArrayList<>() )
+                        .add( inheritedMapping );
+                }
+            }
+        }
+
+        for ( InheritedMapping flatteningMapping : flatteningMappings ) {
+            sourceMethod.getOptions().applySuperMapping(
+                flatteningMapping.method,
+                flatteningMapping.mapping
+            );
+        }
+        for ( Map.Entry<String, List<InheritedMapping>> mappings : mappingsByTarget.entrySet() ) {
+            List<InheritedMapping> mostSpecificMappings = mostSpecificMappings( mappings.getValue() );
+            if ( mostSpecificMappings.size() == 1 ) {
+                InheritedMapping inheritedMapping = mostSpecificMappings.get( 0 );
+                sourceMethod.getOptions().applySuperMapping( inheritedMapping.method, inheritedMapping.mapping );
+            }
+            else {
+                TypeElement firstDeclaringType = declaringType( mostSpecificMappings.get( 0 ) );
+                TypeElement secondDeclaringType = declaringType( mostSpecificMappings.get( 1 ) );
+                messager.printMessage(
+                    sourceMethod.getExecutable(),
+                    beanMapping.mirror(),
+                    beanMapping.inheritSuperMappings().getAnnotationValue(),
+                    Message.BEANMAPPING_INHERIT_SUPER_MAPPINGS_CONFLICT,
+                    mappings.getKey(),
+                    firstDeclaringType.getQualifiedName(),
+                    secondDeclaringType.getQualifiedName()
+                );
+            }
+        }
+        sourceMethod.getOptions().finishSuperMappingInheritance();
