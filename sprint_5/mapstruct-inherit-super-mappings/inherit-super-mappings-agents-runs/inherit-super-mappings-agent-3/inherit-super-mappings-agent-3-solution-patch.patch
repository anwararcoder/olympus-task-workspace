+
+interface SpecificMid extends SpecificRoot {
+    @Override
+    @Mapping(target = "chosen", source = "other")
+    Target specific(Source source);
+}
+
+interface FlattenLeft {
+    @Mapping(target = ".", source = "first")
+    Target flatten(FirstFlattenSource first, SecondFlattenSource second);
+}
+
+interface FlattenRight {
+    @Mapping(target = ".", source = "second")
+    Target flatten(FirstFlattenSource first, SecondFlattenSource second);
+}
+
+interface ConfigBase {
+    @Mapping(target = "right", source = "other")
+    Target configured(Source source);
+}
+
+@MapperConfig
+interface SuperMappingsConfig {
+    @Mapping(target = "right", source = "value")
+    @Mapping(target = "root", source = "other")
+    Target configuredPrototype(Source source);
+}
+
+class FirstFlattenSource {
+    private String firstFlatten;
+
+    public String getFirstFlatten() {
+        return firstFlatten;
+    }
+
+    public void setFirstFlatten(String firstFlatten) {
+        this.firstFlatten = firstFlatten;
+    }
+}
+
+class SecondFlattenSource {
+    private String secondFlatten;
+
+    public String getSecondFlatten() {
+        return secondFlatten;
+    }
+
+    public void setSecondFlatten(String secondFlatten) {
+        this.secondFlatten = secondFlatten;
+    }
+}
