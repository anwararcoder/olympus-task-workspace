+                                                 TypeElement mapperToImplement,
+                                                 Set<String> visitedTypes,
+                                                 List<SourceMethod> overriddenMethods) {
+        for ( TypeMirror superType : typeUtils.directSupertypes( type ) ) {
+            DeclaredType declaredSuperType = (DeclaredType) superType;
+            TypeElement superTypeElement = asTypeElement( declaredSuperType );
+            if ( !visitedTypes.add( superTypeElement.getQualifiedName().toString() ) ) {
+                continue;
+            }
+
+            for ( ExecutableElement candidate : ElementFilter.methodsIn( superTypeElement.getEnclosedElements() ) ) {
+                if ( elementUtils.overrides( overridingMethod, candidate, mapperToImplement ) ) {
+                    ExecutableType methodType = typeFactory.getMethodType( declaredSuperType, candidate );
+                    List<Parameter> parameters = typeFactory.getParameters( methodType, candidate );
+                    SourceMethod overriddenMethod = getMethodRequiringImplementation(
+                        methodType,
+                        candidate,
+                        parameters,
+                        SourceMethod.containsTargetTypeParameter( parameters ),
+                        mapperOptions,
+                        prototypeMethods,
+                        mapperToImplement,
+                        false
+                    );
+                    if ( overriddenMethod != null ) {
+                        overriddenMethods.add( overriddenMethod );
+                    }
+                }
+            }
+
+            collectOverriddenMappingMethods(
+                overridingMethod,
+                declaredSuperType,
+                mapperOptions,
+                prototypeMethods,
+                mapperToImplement,
+                visitedTypes,
+                overriddenMethods
+            );
+        }
+    }
+
+    private List<InheritedMapping> mostSpecificMappings(List<InheritedMapping> mappings) {
+        List<InheritedMapping> result = new ArrayList<>();
+        for ( InheritedMapping candidate : mappings ) {
+            TypeMirror candidateType = declaringType( candidate ).asType();
+            boolean overridden = false;
+            for ( InheritedMapping other : mappings ) {
+                if ( candidate != other && typeUtils.isSubtype( declaringType( other ).asType(), candidateType ) ) {
+                    overridden = true;
+                    break;
+                }
+            }
+            if ( !overridden ) {
+                result.add( candidate );
+            }
+        }
+        return result;
+    }
