+/*
+ * Copyright MapStruct Authors.
+ *
+ * Licensed under the Apache License version 2.0, available at http://www.apache.org/licenses/LICENSE-2.0
+ */
+package org.mapstruct.ap.test.inheritsupermappings;
+
+import org.mapstruct.ap.testutil.ProcessorTest;
+import org.mapstruct.ap.testutil.WithClasses;
+import org.mapstruct.ap.testutil.compilation.annotation.CompilationResult;
+import org.mapstruct.ap.testutil.compilation.annotation.Diagnostic;
+import org.mapstruct.ap.testutil.compilation.annotation.ExpectedCompilationOutcome;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+@WithClasses({ Source.class, Target.class, InheritedSuperMappingsMapper.class })
+public class InheritedSuperMappingsTest {
+
+    @ProcessorTest
+    public void shouldInheritMappingsFromOverriddenMethods() {
+        Source first = source( "first", "first-other" );
+        Source second = source( "second", "second-other" );
+        Target target = InheritedSuperMappingsMapper.INSTANCE.renamed( first, second );
+        assertThat( target.getLeft() ).isEqualTo( "first" );
+        assertThat( target.getRight() ).isEqualTo( "first" );
+    }
+
+    @ProcessorTest
+    public void shouldKeepPropertyMeaningAndNotInheritBeanMappingOptions() {
+        Source nested = source( "nested", null );
+        Source source = source( "outer", null );
+        source.setSource( nested );
+        source.setAutomatic( "automatic" );
+        Target target = InheritedSuperMappingsMapper.INSTANCE.property( source );
+        Target wholeTarget = InheritedSuperMappingsMapper.INSTANCE.whole( source );
+        assertThat( target.getProperty() ).isEqualTo( "nested" );
+        assertThat( target.getAutomatic() ).isEqualTo( "automatic" );
+        assertThat( wholeTarget.getWhole() ).isSameAs( source );
+    }
+
+    @ProcessorTest
+    public void shouldCombineDiamondMappingsAndPreferSpecificDeclarations() {
+        Source source = source( "value", "other" );
+        Target diamond = InheritedSuperMappingsMapper.INSTANCE.diamond( source );
+        Target specific = InheritedSuperMappingsMapper.INSTANCE.specific( source );
+        assertThat( diamond.getRoot() ).isEqualTo( "value" );
+        assertThat( diamond.getLeftBranch() ).isEqualTo( "value" );
+        assertThat( diamond.getRightBranch() ).isEqualTo( "other" );
+        assertThat( specific.getChosen() ).isEqualTo( "other" );
+    }
+
+    @ProcessorTest
+    public void shouldAccumulateFlatteningMappings() {
+        FirstFlattenSource first = new FirstFlattenSource();
+        first.setFirstFlatten( "first" );
+        SecondFlattenSource second = new SecondFlattenSource();
+        second.setSecondFlatten( "second" );
+        Target target = InheritedSuperMappingsMapper.INSTANCE.flatten( first, second );
+        assertThat( target.getFirstFlatten() ).isEqualTo( "first" );
+        assertThat( target.getSecondFlatten() ).isEqualTo( "second" );
+    }
+
+    @ProcessorTest
+    public void shouldApplyConfigurationInheritanceAfterSuperMappings() {
+        Source source = source( "value", "other" );
+
+        Target target = InheritedSuperMappingsMapper.INSTANCE.configured( source );
+
+        assertThat( target.getRight() ).isEqualTo( "other" );
+        assertThat( target.getRoot() ).isEqualTo( "other" );
+    }
+
+    @ProcessorTest
+    @WithClasses({ Source.class, Target.class, ErroneousConflictMapper.class })
+    @ExpectedCompilationOutcome(
+        value = CompilationResult.FAILED,
+        diagnostics = @Diagnostic(
+            type = ErroneousConflictMapper.class,
+            kind = javax.tools.Diagnostic.Kind.ERROR,
+            line = 16,
+            message = "Inherited mapping for target \"chosen\" is declared by unrelated mapper types "
+                + "org.mapstruct.ap.test.inheritsupermappings.ConflictLeft and "
+                + "org.mapstruct.ap.test.inheritsupermappings.ConflictRight."
+        )
+    )
+    public void shouldReportConflictingDiamondMappings() {
+    }
+
+    @ProcessorTest
+    @WithClasses({ Source.class, Target.class, ErroneousNoOverrideMapper.class })
+    @ExpectedCompilationOutcome(
+        value = CompilationResult.FAILED,
+        diagnostics = @Diagnostic(
+            type = ErroneousNoOverrideMapper.class,
+            kind = javax.tools.Diagnostic.Kind.ERROR,
+            line = 14,
+            message = "@BeanMapping(inheritSuperMappings = true) requires an overridden mapping method."
+        )
+    )
+    public void shouldRequireOverriddenMappingMethod() {
+    }
+
+    private Source source(String value, String other) {
+        Source source = new Source();
+        source.setValue( value );
+        source.setOther( other );
+        return source;
+    }
+}
