+    }
+
+    private void collectOverriddenMappingMethods(ExecutableElement method, TypeElement mapperToImplement,
+                                                 TypeMirror type, BeanMappingOptions beanMappingOptions,
+                                                 Set<TypeElement> visitedTypes,
+                                                 List<OverriddenMappingMethod> overriddenMethods) {
+        if ( type.getKind() != TypeKind.DECLARED ) {
+            return;
+        }
+
+        DeclaredType declaredType = (DeclaredType) type;
+        TypeElement typeElement = (TypeElement) declaredType.asElement();
+        if ( typeElement.getQualifiedName().contentEquals( "java.lang.Object" ) || !visitedTypes.add( typeElement ) ) {
+            return;
+        }
+
+        for ( ExecutableElement candidate : ElementFilter.methodsIn( typeElement.getEnclosedElements() ) ) {
+            if ( candidate != method
+                && candidate.getModifiers().contains( Modifier.ABSTRACT )
+                && elementUtils.overrides( method, candidate, mapperToImplement ) ) {
+                ExecutableType candidateType = typeFactory.getMethodType(
+                    (DeclaredType) mapperToImplement.asType(),
+                    candidate
+                );
+                List<Parameter> candidateParameters = typeFactory.getParameters( candidateType, candidate );
+                overriddenMethods.add( new OverriddenMappingMethod(
+                    typeElement,
+                    candidateParameters,
+                    getMappings( candidate, beanMappingOptions )
+                ) );
+            }
+        }
+
+        for ( TypeMirror superType : typeUtils.directSupertypes( declaredType ) ) {
+            collectOverriddenMappingMethods(
+                method,
+                mapperToImplement,
+                superType,
+                beanMappingOptions,
+                visitedTypes,
+                overriddenMethods
+            );
+        }
+    }
+
+    private List<InheritedMapping> mostSpecificMappings(List<InheritedMapping> inheritedMappings) {
+        List<InheritedMapping> mostSpecificMappings = new ArrayList<>();
+        for ( InheritedMapping candidate : inheritedMappings ) {
+            boolean hasMoreSpecificMapping = false;
+            for ( InheritedMapping other : inheritedMappings ) {
+                if ( candidate != other && isMoreSpecific(
+                    other.declaringMethod.declaringType,
+                    candidate.declaringMethod.declaringType
+                ) ) {
+                    hasMoreSpecificMapping = true;
+                    break;
+                }
+            }
+            if ( !hasMoreSpecificMapping ) {
+                mostSpecificMappings.add( candidate );
+            }
+        }
+        return mostSpecificMappings;
+    }
+
+    private boolean isMoreSpecific(TypeElement candidate, TypeElement other) {
+        return !candidate.equals( other ) && typeUtils.isSubtype(
+            typeUtils.erasure( candidate.asType() ),
