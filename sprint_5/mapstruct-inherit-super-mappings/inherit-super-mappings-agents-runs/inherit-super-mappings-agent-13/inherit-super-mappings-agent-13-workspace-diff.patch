+/*
+ * Copyright MapStruct Authors.
+ *
+ * Licensed under the Apache License version 2.0, available at http://www.apache.org/licenses/LICENSE-2.0
+ */
+package org.mapstruct.ap.test.inheritance.supermappings;
+
+import org.mapstruct.ap.testutil.ProcessorTest;
+import org.mapstruct.ap.testutil.WithClasses;
+import org.mapstruct.ap.testutil.compilation.annotation.CompilationResult;
+import org.mapstruct.ap.testutil.compilation.annotation.Diagnostic;
+import org.mapstruct.ap.testutil.compilation.annotation.ExpectedCompilationOutcome;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+public class InheritedSuperMappingsTest {
+
+    @ProcessorTest
+    @WithClasses({
+        SuperMappingSource.class,
+        SuperMappingTarget.class,
+        InheritedMappingComposition.class,
+        BasicSuperMapper.class,
+        BasicChildMapper.class,
+        PropertySuperMapper.class,
+        PropertyChildMapper.class,
+        MultiSuperMapper.class,
+        MultiChildMapper.class,
+        DiamondRootMapper.class,
+        DiamondLeftMapper.class,
+        DiamondRightMapper.class,
+        DiamondChildMapper.class,
+        SuperMappingConfig.class,
+        ConfigSuperMapper.class,
+        ConfigChildMapper.class,
+        GenericSuperMapper.class,
+        GenericIntermediateMapper.class,
+        GenericChildMapper.class,
+        FalseSuperMapper.class,
+        FalseChildMapper.class,
+        EmptySuperMapper.class,
+        EmptyChildMapper.class
+    })
+    public void shouldInheritMappingsFromOverriddenMethods() {
+        SuperMappingSource source = source();
+
+        SuperMappingTarget basic = BasicChildMapper.INSTANCE.map( source );
+        assertThat( basic.getInherited() ).isEqualTo( "inherited" );
+        assertThat( basic.getCurrent() ).isEqualTo( "child-current" );
+        assertThat( basic.getAutomatic() ).isEqualTo( "automatic" );
+        assertThat( basic.getIgnored() ).isNull();
+        assertThat( basic.getWhole() ).isSameAs( source );
+        assertThat( basic.getRootFlat() ).isEqualTo( "root-flat" );
+        assertThat( BasicChildMapper.INSTANCE.map( null ) ).isNull();
+
+        SuperMappingTarget property = PropertyChildMapper.INSTANCE.mapProperty( source );
+        assertThat( property.getProperty() ).isEqualTo( "property-inherited" );
+
+        SuperMappingSource secondSource = new SuperMappingSource();
+        secondSource.setSecond( "second" );
+        SuperMappingTarget multiple = MultiChildMapper.INSTANCE.mapMultiple( source, secondSource );
+        assertThat( multiple.getFirst() ).isEqualTo( "first" );
+        assertThat( multiple.getSecond() ).isEqualTo( "second" );
+        assertThat( multiple.getWhole() ).isSameAs( source );
+
+        SuperMappingTarget diamond = DiamondChildMapper.INSTANCE.mapDiamond( source );
+        assertThat( diamond.getRoot() ).isEqualTo( "root" );
+        assertThat( diamond.getLeft() ).isEqualTo( "left" );
+        assertThat( diamond.getRight() ).isEqualTo( "right" );
+        assertThat( diamond.getSelected() ).isEqualTo( "selected-left" );
+        assertThat( diamond.getCurrentOverride() ).isEqualTo( "current-child" );
+        assertThat( diamond.getRootFlat() ).isEqualTo( "root-flat" );
+        assertThat( diamond.getLeftFlat() ).isEqualTo( "left-flat" );
+        assertThat( diamond.getRightFlat() ).isEqualTo( "right-flat" );
+        assertThat( diamond.getCurrentFlat() ).isEqualTo( "current-flat" );
+
+        SuperMappingTarget configured = ConfigChildMapper.INSTANCE.mapConfigured( source );
+        assertThat( configured.getValue() ).isEqualTo( "super-value" );
+        assertThat( configured.getConfigOnly() ).isEqualTo( "config-only" );
+
+        SuperMappingTarget generic = GenericChildMapper.INSTANCE.mapGeneric( source );
+        assertThat( generic.getValue() ).isEqualTo( "value" );
+
+        SuperMappingTarget notInherited = FalseChildMapper.INSTANCE.mapFalse( source );
+        assertThat( notInherited.getValue() ).isEqualTo( "value" );
+
+        assertThat( EmptyChildMapper.INSTANCE.mapEmpty( source ) ).isNotNull();
+    }
+
+    @ProcessorTest
+    @WithClasses({
+        SuperMappingSource.class,
+        SuperMappingTarget.class,
+        ConflictLeftMapper.class,
+        ConflictRightMapper.class,
+        ConflictChildMapper.class
+    })
+    @ExpectedCompilationOutcome(
+        value = CompilationResult.FAILED,
+        diagnostics = @Diagnostic(
+            type = ConflictChildMapper.class,
+            kind = javax.tools.Diagnostic.Kind.ERROR,
+            line = 15,
+            message = "Inherited mappings for target \"value\" are declared in incomparable mapper types " +
+                "org.mapstruct.ap.test.inheritance.supermappings.ConflictLeftMapper, " +
+                "org.mapstruct.ap.test.inheritance.supermappings.ConflictRightMapper."
+        )
+    )
+    public void shouldReportCompetingMappingsFromIncomparableBranches() {
+    }
+
+    @ProcessorTest
+    @WithClasses({ SuperMappingSource.class, SuperMappingTarget.class, NoSuperMapper.class })
+    @ExpectedCompilationOutcome(
+        value = CompilationResult.FAILED,
+        diagnostics = @Diagnostic(
+            type = NoSuperMapper.class,
+            kind = javax.tools.Diagnostic.Kind.ERROR,
+            line = 14,
+            message = "@BeanMapping#inheritSuperMappings is enabled, but this method does not override a mapping " +
+                "method."
+        )
+    )
+    public void shouldRequireAnOverriddenMappingMethod() {
+    }
+
+    private SuperMappingSource source() {
+        SuperMappingSource source = new SuperMappingSource();
+        source.setInherited( "inherited" );
+        source.setParentCurrent( "parent-current" );
+        source.setChildCurrent( "child-current" );
+        source.setAutomatic( "automatic" );
+        source.setIgnored( "ignored" );
+        source.setFirst( "first" );
+        source.setRoot( "root" );
+        source.setLeft( "left" );
+        source.setRight( "right" );
+        source.setSelectedRoot( "selected-root" );
+        source.setSelectedLeft( "selected-left" );
+        source.setCurrentRoot( "current-root" );
+        source.setCurrentChild( "current-child" );
+        source.setSuperValue( "super-value" );
+        source.setConfigValue( "config-value" );
+        source.setConfigOnly( "config-only" );
+        source.setValue( "value" );
+
+        SuperMappingSource renamed = new SuperMappingSource();
+        renamed.setInherited( "wrong-inherited" );
+        renamed.setChildCurrent( "wrong-child-current" );
+        source.setRenamed( renamed );
+
+        SuperMappingSource property = new SuperMappingSource();
+        property.setInherited( "property-inherited" );
+        source.setSource( property );
+
+        SuperMappingSource.RootFlat rootFlat = new SuperMappingSource.RootFlat();
+        rootFlat.setRootFlat( "root-flat" );
+        source.setRootBean( rootFlat );
+        SuperMappingSource.LeftFlat leftFlat = new SuperMappingSource.LeftFlat();
+        leftFlat.setLeftFlat( "left-flat" );
+        source.setLeftBean( leftFlat );
+        SuperMappingSource.RightFlat rightFlat = new SuperMappingSource.RightFlat();
+        rightFlat.setRightFlat( "right-flat" );
+        source.setRightBean( rightFlat );
+        SuperMappingSource.CurrentFlat currentFlat = new SuperMappingSource.CurrentFlat();
+        currentFlat.setCurrentFlat( "current-flat" );
+        source.setCurrentBean( currentFlat );
+        return source;
+    }
+}
