+        if ( sourceParameter == null ) {
+            return new SourceRebinding( sourceName, null );
+        }
+
+        int sourceParameterPosition = parameterPosition( overriddenParameters, sourceParameter );
+        if ( sourceParameterPosition < 0 || sourceParameterPosition >= overridingParameters.size()
+            || !overridingParameters.get( sourceParameterPosition ).isSourceParameter() ) {
+            return new SourceRebinding( sourceName, null );
+        }
