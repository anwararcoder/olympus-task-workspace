+    }
+
+    private SourceRebinding rebindSource(String sourceName, List<Parameter> overriddenParameters,
+                                         List<Parameter> overridingParameters) {
+        if ( sourceName == null ) {
+            return new SourceRebinding( null, null );
+        }
+
+        String trimmedSourceName = sourceName.trim();
+        String[] segments = trimmedSourceName.split( "\\." );
+        List<Parameter> sourceParameters = Parameter.getSourceParameters( overriddenParameters );
+        Parameter sourceParameter = null;
+        if ( sourceParameters.size() > 1 ) {
+            sourceParameter = Parameter.getSourceParameter( overriddenParameters, segments[0] );
+        }
+        else if ( sourceParameters.size() == 1 ) {
+            Parameter onlySourceParameter = sourceParameters.get( 0 );
+            if ( !sourcePathResolvesToProperty( onlySourceParameter, segments )
+                && onlySourceParameter.getName().equals( segments[0] ) ) {
+                sourceParameter = onlySourceParameter;
+            }
+        }
