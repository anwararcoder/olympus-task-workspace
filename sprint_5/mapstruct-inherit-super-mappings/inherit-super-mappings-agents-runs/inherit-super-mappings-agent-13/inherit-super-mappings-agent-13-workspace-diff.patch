+        String sourceSuffix = trimmedSourceName.substring( segments[0].length() );
+        String reboundSourceName = overridingParameters.get( sourceParameterPosition ).getName() + sourceSuffix;
+        return new SourceRebinding( reboundSourceName, sourceParameterPosition );
+    }
+
+    private boolean sourcePathResolvesToProperty(Parameter sourceParameter, String[] segments) {
+        Type currentType = sourceParameter.getType();
+        boolean allowedMapToBean = currentType.isMapType() && !segments[0].equals( sourceParameter.getName() );
+        for ( int i = 0; i < segments.length; i++ ) {
