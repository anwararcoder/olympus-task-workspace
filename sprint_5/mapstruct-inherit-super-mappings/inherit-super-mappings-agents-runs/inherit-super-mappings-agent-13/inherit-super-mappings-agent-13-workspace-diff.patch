new file mode 100644
index 0000000..9150a79
--- /dev/null
+++ b/processor/src/test/java/org/mapstruct/ap/test/inheritsupermappings/k7p4/InheritSuperMappingsAdditionalK7p4Test.java
@@ -0,0 +1,254 @@
+/*
+ * Copyright MapStruct Authors.
+ *
+ * Licensed under the Apache License version 2.0, available at http://www.apache.org/licenses/LICENSE-2.0
+ */
+package org.mapstruct.ap.test.inheritsupermappings.k7p4;
+
+import java.util.HashMap;
+import java.util.Map;
+import javax.tools.Diagnostic.Kind;
+
+import org.mapstruct.BeanMapping;
+import org.mapstruct.ap.testutil.ProcessorTest;
+import org.mapstruct.ap.testutil.WithClasses;
+import org.mapstruct.ap.testutil.compilation.annotation.CompilationResult;
+import org.mapstruct.ap.testutil.compilation.annotation.Diagnostic;
+import org.mapstruct.ap.testutil.compilation.annotation.ExpectedCompilationOutcome;
+import org.mapstruct.ap.testutil.runner.Compiler;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+public class InheritSuperMappingsAdditionalK7p4Test {
+
+    @ProcessorTest
+    @WithClasses({ ExplicitFalseMapperK7p4.class, SourceK7p4.class, NestedSourceK7p4.class, TargetK7p4.class })
+    public void explicitFalseDisablesSuperMappingInheritance() {
+        SourceK7p4 source = source();
+        TargetK7p4 target = ExplicitFalseMapperK7p4.INSTANCE.map( source );
+        assertThat( target.getFirst() ).isNull();
+        assertThat( target.getSecond() ).isEqualTo( "beta" );
+    }
+
+    @ProcessorTest
+    @WithClasses({ DefaultBeanMapperK7p4.class, SourceK7p4.class, NestedSourceK7p4.class, TargetK7p4.class })
+    public void beanMappingOptionDefaultsToFalseWhenOmitted() {
+        TargetK7p4 target = DefaultBeanMapperK7p4.INSTANCE.map( source() );
+        assertThat( target.getFirst() ).isNull();
+        assertThat( target.getSecond() ).isEqualTo( "beta" );
+        assertThat( defaultValue() ).isFalse();
+    }
+
+    @ProcessorTest
+    @WithClasses({ InheritedIgnoreMapperK7p4.class, TargetK7p4.class })
+    public void inheritedIgnoreDeclarationSuppressesAutomaticMapping() {
+        IgnoreSourceK7p4 source = new IgnoreSourceK7p4();
+        source.setFirst( "automatic" );
+        source.setSecond( "explicit" );
+        TargetK7p4 target = InheritedIgnoreMapperK7p4.INSTANCE.map( source );
+        assertThat( target.getFirst() ).isNull();
+        assertThat( target.getSecond() ).isEqualTo( "explicit" );
+    }
+
+    @ProcessorTest
+    @WithClasses({ WholeParameterMapperK7p4.class, TargetK7p4.class })
+    public void wholeSourceParameterReferenceRebindsByPosition() {
+        TargetK7p4 target = WholeParameterMapperK7p4.INSTANCE.map( "left", "right" );
+        assertThat( target.getFirst() ).isEqualTo( "left" );
+        assertThat( target.getSecond() ).isEqualTo( "right" );
+    }
+
+    @ProcessorTest
+    @WithClasses({ NestedSiblingMapperK7p4.class, SourceK7p4.class, NestedSourceK7p4.class })
+    public void nestedSiblingTargetPathsRemainIndependent() {
+        NestedTargetK7p4 target = NestedSiblingMapperK7p4.INSTANCE.map( source() );
+        assertThat( target.getDetails().getFirst() ).isEqualTo( "alpha" );
+        assertThat( target.getDetails().getSecond() ).isEqualTo( "beta" );
+    }
+
+    @ProcessorTest(Compiler.JDK)
+    @WithClasses({ IdenticalConflictMapperK7p4.class, SourceK7p4.class, NestedSourceK7p4.class,
+        TargetK7p4.class })
+    @ExpectedCompilationOutcome(
+        value = CompilationResult.FAILED,
+        diagnostics = @Diagnostic(
+            type = IdenticalConflictMapperK7p4.class,
+            kind = Kind.ERROR,
+            messageRegExp = "(?=.*first)(?=.*IdenticalLeftK7p4)(?=.*IdenticalRightK7p4).*"
+        )
+    )
+    public void identicalMappingsFromIncomparableBranchesConflict() {
+    }
+
+    @ProcessorTest
+    @WithClasses({ PrefixBoundaryMapperK7p4.class, TargetK7p4.class })
+    public void unqualifiedPropertySharingParameterPrefixIsNotRebound() {
+        PrefixBoundarySourceK7p4 source = new PrefixBoundarySourceK7p4();
+        source.setSourceValue( "boundary" );
+        TargetK7p4 target = PrefixBoundaryMapperK7p4.INSTANCE.map( source );
+        assertThat( target.getFirst() ).isEqualTo( "boundary" );
+    }
+
+    @ProcessorTest
+    @WithClasses({ LocalFlatteningMapperK7p4.class, FlatSourceK7p4.class, LeftPartK7p4.class,
+        RightPartK7p4.class, TargetK7p4.class })
+    public void localAndInheritedFlatteningDeclarationsAccumulate() {
+        LeftPartK7p4 left = new LeftPartK7p4();
+        left.setFirst( "left" );
+        RightPartK7p4 right = new RightPartK7p4();
+        right.setSecond( "right" );
