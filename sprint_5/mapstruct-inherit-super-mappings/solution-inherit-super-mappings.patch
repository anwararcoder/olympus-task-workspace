+    private boolean containsSameErasure(List<HierarchyType> hierarchy, DeclaredType candidate) {
+        TypeMirror candidateErasure = typeUtils.erasure( candidate );
+        for ( HierarchyType type : hierarchy ) {
+            if ( typeUtils.isSameType( typeUtils.erasure( type.declaredType ), candidateErasure ) ) {
+                return true;
+            }
+        }
+        return false;
+    }
