+    private Set<MappingOptions> getSuperMappings(ExecutableElement method, List<Parameter> parameters,
+                                                 TypeElement mapperToImplement,
+                                                 BeanMappingOptions beanMappingOptions,
+                                                 Set<MappingOptions> localMappings) {
+        List<OverriddenMethod> overriddenMethods = getOverriddenMethods( method, mapperToImplement );
+        if ( overriddenMethods.isEmpty() ) {
+            messager.printMessage(
+                method,
+                beanMappingOptions.getMirror(),
+                Message.BEANMAPPING_NO_SUPER_MAPPING_METHOD,
+                method.getSimpleName()
+            );
+            return Collections.emptySet();
+        }
+
+        Set<String> localTargets = new HashSet<>();
+        for ( MappingOptions localMapping : localMappings ) {
+            if ( !".".equals( localMapping.getTargetName() ) ) {
+                localTargets.add( localMapping.getTargetName() );
+            }
+        }
+
+        Map<String, List<SuperMapping>> mappingsByTarget = new LinkedHashMap<>();
+        List<SuperMapping> flatteningMappings = new ArrayList<>();
+
+        for ( OverriddenMethod overriddenMethod : overriddenMethods ) {
+            List<Parameter> overriddenParameters = typeFactory.getParameters(
+                overriddenMethod.type,
+                overriddenMethod.method
+            );
+            Set<MappingOptions> mappings = getMappings( overriddenMethod.method, beanMappingOptions );
+
+            for ( MappingOptions mapping : mappings ) {
+                String target = mapping.getTargetName();
+                String source = rebindSource( mapping.getSourceName(), overriddenParameters, parameters );
+                MappingOptions inherited = mapping.copyForSuperInheritance( source, beanMappingOptions );
+                SuperMapping superMapping = new SuperMapping(
+                    overriddenMethod.method,
+                    overriddenMethod.declaringTypeName,
+                    inherited
+                );
+
+                if ( ".".equals( target ) ) {
+                    flatteningMappings.add( superMapping );
+                }
+                else if ( !localTargets.contains( target ) ) {
+                    mappingsByTarget.computeIfAbsent( target, ignored -> new ArrayList<>() )
+                        .add( superMapping );
+                }
+            }
+        }
+
+        Set<MappingOptions> inheritedMappings = new LinkedHashSet<>();
+        for ( SuperMapping flatteningMapping : flatteningMappings ) {
+            inheritedMappings.add( flatteningMapping.mapping );
+        }
+
+        for ( Map.Entry<String, List<SuperMapping>> entry : mappingsByTarget.entrySet() ) {
+            List<SuperMapping> mostSpecific = mostSpecificMappings( entry.getValue(), mapperToImplement );
+            if ( mostSpecific.size() == 1 ) {
+                inheritedMappings.add( mostSpecific.get( 0 ).mapping );
+            }
+            else {
