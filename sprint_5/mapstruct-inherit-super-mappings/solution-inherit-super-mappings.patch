+    private static final class HierarchyType {
+        private final DeclaredType declaredType;
+        private final TypeElement element;
+        private final String name;
+
+        private HierarchyType(DeclaredType declaredType, TypeElement element, String name) {
+            this.declaredType = declaredType;
+            this.element = element;
+            this.name = name;
+        }
+    }
+
+    private static final class SourceParameterBinding {
+        private final Parameter overridden;
+        private final Parameter overriding;
+
+        private SourceParameterBinding(Parameter overridden, Parameter overriding) {
+            this.overridden = overridden;
+            this.overriding = overriding;
+        }
+    }
+
+    private static final class OverriddenMethod {
+        private final ExecutableElement method;
+        private final ExecutableType type;
+        private final String declaringTypeName;
+
+        private OverriddenMethod(ExecutableElement method, ExecutableType type, String declaringTypeName) {
