+    private List<OverriddenMethod> getOverriddenMethods(ExecutableElement method, TypeElement mapperToImplement) {
+        List<OverriddenMethod> overriddenMethods = new ArrayList<>();
+        DeclaredType mapperType = (DeclaredType) mapperToImplement.asType();
+        for ( HierarchyType hierarchyType : getSuperTypes( mapperToImplement ) ) {
+            for ( ExecutableElement candidate : ElementFilter.methodsIn(
+                hierarchyType.element.getEnclosedElements()
+            ) ) {
+                if ( elementUtils.overrides( method, candidate, mapperToImplement ) ) {
+                    OverriddenMethod overriddenMethod = new OverriddenMethod(
+                        candidate,
+                        typeFactory.getMethodType( mapperType, candidate ),
+                        hierarchyType.name
+                    );
+                    if ( !containsSameDeclaration( overriddenMethods, overriddenMethod ) ) {
+                        overriddenMethods.add( overriddenMethod );
+                    }
+                }
+            }
+        }
+
+        overriddenMethods.sort(
+            Comparator.comparing( (OverriddenMethod overridden) -> overridden.declaringTypeName )
+                .thenComparing( overridden -> overridden.method.toString() )
+        );
+        return overriddenMethods;
+    }
+
+    private boolean containsSameDeclaration(List<OverriddenMethod> methods, OverriddenMethod candidate) {
+        for ( OverriddenMethod method : methods ) {
+            if ( isSameDeclaration( method, candidate ) ) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private boolean isSameDeclaration(OverriddenMethod first, OverriddenMethod second) {
+        if ( first.method.equals( second.method ) ) {
+            return true;
+        }
+
+        TypeMirror firstDeclaringType = first.method.getEnclosingElement().asType();
+        TypeMirror secondDeclaringType = second.method.getEnclosingElement().asType();
+        if ( !typeUtils.isSameType(
+            typeUtils.erasure( firstDeclaringType ),
+            typeUtils.erasure( secondDeclaringType )
+        ) ) {
+            return false;
+        }
+
+        return first.method.getSimpleName().contentEquals( second.method.getSimpleName() )
+            && hasSameParameterTypes( first.type, second.type );
+    }
+
+    private boolean hasSameParameterTypes(ExecutableType first, ExecutableType second) {
+        List<? extends TypeMirror> firstParameters = first.getParameterTypes();
+        List<? extends TypeMirror> secondParameters = second.getParameterTypes();
+        if ( firstParameters.size() != secondParameters.size() ) {
+            return false;
+        }
+
+        for ( int i = 0; i < firstParameters.size(); i++ ) {
+            if ( !typeUtils.isSameType( firstParameters.get( i ), secondParameters.get( i ) ) ) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private List<HierarchyType> getSuperTypes(TypeElement mapperToImplement) {
+        List<HierarchyType> result = new ArrayList<>();
+        Deque<DeclaredType> pending = new ArrayDeque<>();
+        pending.addAll( directDeclaredSupertypes( mapperToImplement.asType() ) );
+
+        while ( !pending.isEmpty() ) {
+            DeclaredType declaredType = pending.removeFirst();
+            if ( containsSameErasure( result, declaredType ) ) {
+                continue;
+            }
+
+            TypeElement element = (TypeElement) typeUtils.asElement( declaredType );
+            if ( element == null ) {
+                continue;
+            }
+
+            HierarchyType hierarchyType = new HierarchyType(
+                declaredType,
+                element,
+                declaringTypeName( element, declaredType )
+            );
+            result.add( hierarchyType );
+            pending.addAll( directDeclaredSupertypes( declaredType ) );
+        }
+
+        result.sort( Comparator.comparing( hierarchyType -> hierarchyType.name ) );
+        return result;
+    }
+
+    private List<DeclaredType> directDeclaredSupertypes(TypeMirror type) {
+        List<DeclaredType> result = new ArrayList<>();
+        for ( TypeMirror superType : typeUtils.directSupertypes( type ) ) {
+            if ( superType.getKind() == TypeKind.DECLARED ) {
+                result.add( (DeclaredType) superType );
+            }
+        }
+
+        result.sort(
+            Comparator.comparing(
+                superType -> declaringTypeName(
+                    (TypeElement) typeUtils.asElement( superType ),
+                    superType
+                )
+            )
+        );
+        return result;
+    }
