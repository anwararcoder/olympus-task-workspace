+    private List<SourceParameterBinding> sourceParameterBindings(List<Parameter> overriddenParameters,
+                                                                 List<Parameter> overridingParameters) {
+        List<SourceParameterBinding> bindings = new ArrayList<>();
+        int parameterCount = Math.min( overriddenParameters.size(), overridingParameters.size() );
+        for ( int i = 0; i < parameterCount; i++ ) {
+            Parameter overridden = overriddenParameters.get( i );
+            Parameter overriding = overridingParameters.get( i );
+            if ( overridden.isSourceParameter() && overriding.isSourceParameter() ) {
+                bindings.add( new SourceParameterBinding( overridden, overriding ) );
+            }
+        }
+        return bindings;
+    }
+
+    private String rebindSource(String source, List<Parameter> overriddenParameters,
+                                List<Parameter> overridingParameters) {
+        if ( source == null ) {
+            return null;
+        }
+
+        int sourceParameterCount = Parameter.getSourceParameters( overriddenParameters ).size();
+        for ( SourceParameterBinding binding : sourceParameterBindings(
+            overriddenParameters,
+            overridingParameters
+        ) ) {
+            String overriddenName = binding.overridden.getName();
+            String overridingName = binding.overriding.getName();
+            if ( !source.equals( overriddenName ) && !source.startsWith( overriddenName + "." ) ) {
+                continue;
+            }
+            if ( denotesSourceParameter( source, binding.overridden, sourceParameterCount ) ) {
+                return overridingName + source.substring( overriddenName.length() );
+            }
+        }
+        return source;
+    }
+
+    /**
+     * A leading segment spelled like a source parameter only denotes that parameter when the path cannot be
+     * resolved as a property path of the parameter type, mirroring how a source reference of a method with a
+     * single source parameter is resolved.
+     *
+     * @param source the inherited source path
+     * @param parameter the source parameter of the overridden method the leading segment is spelled like
+     * @param sourceParameterCount the number of source parameters of the overridden method
+     * @return {@code true} if the leading segment denotes the source parameter
+     */
+    private boolean denotesSourceParameter(String source, Parameter parameter, int sourceParameterCount) {
+        return sourceParameterCount > 1
+            || !resolvesAsPropertyPath( parameter.getType(), source.split( "\\." ) );
+    }
+
+    private boolean resolvesAsPropertyPath(Type type, String[] propertyNames) {
+        Type currentType = type;
+        for ( int i = 0; i < propertyNames.length; i++ ) {
+            Type noBoundsType = currentType.withoutBounds();
+            ReadAccessor readAccessor = noBoundsType.getReadAccessor( propertyNames[i], i > 0 );
+            if ( readAccessor == null ) {
+                return false;
+            }
+            currentType = typeFactory.getReturnType( (DeclaredType) noBoundsType.getTypeMirror(), readAccessor );
+        }
+        return true;
+    }
+
+    private List<SuperMapping> mostSpecificMappings(List<SuperMapping> mappings,
+                                                    TypeElement mapperToImplement) {
+        List<SuperMapping> mostSpecific = new ArrayList<>();
+        for ( SuperMapping candidate : mappings ) {
+            boolean overridden = false;
+            for ( SuperMapping other : mappings ) {
+                if ( candidate != other
+                    && isMoreSpecific( other.method, candidate.method, mapperToImplement ) ) {
+                    overridden = true;
+                    break;
+                }
+            }
+            if ( !overridden ) {
+                mostSpecific.add( candidate );
+            }
+        }
+        return mostSpecific;
+    }
+
+    private boolean isMoreSpecific(ExecutableElement candidate, ExecutableElement other,
+                                   TypeElement mapperToImplement) {
+        if ( elementUtils.overrides( candidate, other, mapperToImplement ) ) {
+            return true;
+        }
+
+        TypeMirror candidateType = candidate.getEnclosingElement().asType();
+        TypeMirror otherType = other.getEnclosingElement().asType();
+        return typeUtils.isSubtype( candidateType, otherType );
+    }
+
+    private String declaringTypes(List<SuperMapping> mappings) {
+        Set<String> types = new LinkedHashSet<>();
+        for ( SuperMapping mapping : mappings ) {
+            types.add( mapping.declaringTypeName );
+        }
+        return String.join( ", ", types );
+    }
+
+    private String declaringTypeName(TypeElement declaringType, TypeMirror declaredType) {
+        String name = declaringType.getQualifiedName().toString();
+        if ( !name.isEmpty() ) {
+            return name;
+        }
+
+        name = elementUtils.getBinaryName( declaringType ).toString();
+        if ( !name.isEmpty() ) {
+            return name;
+        }
+
+        name = declaringType.toString();
+        if ( !name.isEmpty() ) {
+            return name;
+        }
+
+        name = typeUtils.erasure( declaredType ).toString();
+        if ( !name.isEmpty() ) {
+            return name;
+        }
+
+        return declaringType.getSimpleName().toString();
+    }
