+        public class FieldPair {
+          private static class Parent {
+            static int needed = 31;
+            static int discarded = 97;
+          }
+          private static class Child extends Parent {
+          }
+          private static int withCollision(int discarded) {
+            return Child.needed + discarded;
+          }
+          public static int value() {
+            return withCollision(0);
+          }
+        }
+        """
+    );
+    scenario.markFields("Parent", ACC_SYNTHETIC, "needed", "discarded");
+
+    Output output = scenario.decompile();
+    assertEquals(Set.of("needed"), output.declarations.fieldsWithin(Set.of("needed", "discarded")));
+    assertTrue(output.declarations.parameterNames.contains("discarded"));
+    assertBehaviorMatches(scenario.originalClass(), output.type);
+
+    Output removalDisabled = scenario.decompile(
+      IFernflowerPreferences.REMOVE_SYNTHETIC, "0"
+    );
+    assertEquals(
+      Set.of("needed", "discarded"),
+      removalDisabled.declarations.fieldsWithin(Set.of("needed", "discarded"))
+    );
+    assertBehaviorMatches(scenario.originalClass(), removalDisabled.type);
+  }
