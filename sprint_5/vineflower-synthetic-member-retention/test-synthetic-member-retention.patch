+  @Test
+  public void assertionFieldTracksTheReconstructionSetting() throws Exception {
+    Scenario scenario = scenario(
+      "probe.assertion.AssertionField",
+      """
+        package probe.assertion;
+        public class AssertionField {
+          public static int value() {
+            int number = 6;
+            assert number > 0;
+            return number * 7;
+          }
+        }
+        """
+    );
+
+    Set<String> generated = generatedFieldNames(scenario.originalClass());
+
+    Declarations byDefault = scenario.declarationsWithOptions(
+      IFernflowerPreferences.DECOMPILE_ASSERTIONS, "0"
+    );
+    Declarations explicitlyDisabled = scenario.declarationsWithOptions(
+      RETAIN_REFERENCED_SYNTHETICS, "0",
+      IFernflowerPreferences.DECOMPILE_ASSERTIONS, "0"
+    );
+    assertEquals(Set.of(), byDefault.fieldsWithin(generated));
+    assertEquals(byDefault.normalizedSource, explicitlyDisabled.normalizedSource);
+
+    Output reconstructed = scenario.decompile();
+    assertEquals(Set.of(), reconstructed.declarations.fieldsWithin(generated));
+    assertBehaviorMatches(scenario.originalClass(), reconstructed.type);
+
+    Output literal = scenario.decompile(
+      IFernflowerPreferences.DECOMPILE_ASSERTIONS, "0"
+    );
+    assertEquals(generated, literal.declarations.fieldsWithin(generated));
+    assertBehaviorMatches(scenario.originalClass(), literal.type);
+  }
