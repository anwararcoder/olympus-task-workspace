+  private Scenario scenario(String binaryName, String source) throws Exception {
+    Path root = Files.createTempDirectory(tempDir, "scenario-");
+    Path classes = root.resolve("classes");
+    compile(binaryName, source, classes);
+    return new Scenario(binaryName, classes, root);
