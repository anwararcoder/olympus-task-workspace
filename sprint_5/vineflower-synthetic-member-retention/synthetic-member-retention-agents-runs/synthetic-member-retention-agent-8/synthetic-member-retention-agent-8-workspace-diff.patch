+  private final class Scenario {
+    private final String binaryName;
+    private final Path classes;
+    private final Path root;
+
+    private Scenario(String binaryName, Path classes, Path root) {
+      this.binaryName = binaryName;
+      this.classes = classes;
+      this.root = root;
+    }
+
+    private Class<?> originalClass() throws Exception {
+      return load(classes, binaryName);
+    }
+
+    private void markFields(int flags, String... names) throws IOException {
+      rewrite(rootClassFile(), MemberArea.FIELD, Set.of(names), flags);
+    }
+
+    private void markFields(String className, int flags, String... names) throws IOException {
+      Path classFile = classes.resolve(binaryName.replace('.', '/') + "$" + className + ".class");
+      rewrite(classFile, MemberArea.FIELD, Set.of(names), flags);
+    }
+
+    private void markMethods(int flags, String... names) throws IOException {
+      rewrite(rootClassFile(), MemberArea.METHOD, Set.of(names), flags);
+    }
+
+    private void markMethods(String className, int flags, String... names) throws IOException {
+      Path classFile = classes.resolve(binaryName.replace('.', '/') + "$" + className + ".class");
+      rewrite(classFile, MemberArea.METHOD, Set.of(names), flags);
+    }
+
+    private void markClasses(int flags, String... simpleNames) throws IOException {
+      for (String simpleName : simpleNames) {
+        Path classFile = classes.resolve(binaryName.replace('.', '/') + "$" + simpleName + ".class");
+        rewrite(classFile, MemberArea.CLASS, Set.of(), flags);
+      }
+    }
+
+    private Output decompile(Object... options) throws Exception {
+      Object[] enabledOptions = new Object[options.length + 2];
+      enabledOptions[0] = RETAIN_REFERENCED_SYNTHETICS;
+      enabledOptions[1] = "1";
+      System.arraycopy(options, 0, enabledOptions, 2, options.length);
+      return decompile(enabledOptions, (sources, declarations) -> {
+        Path compiled = Files.createTempDirectory(root, "decompiled-classes-");
+        compileFiles(sources, compiled);
+        return new Output(load(compiled, binaryName), declarations, compiled);
+      });
+    }
+
+    private Declarations declarationsWithOptions(Object... options) throws Exception {
+      return decompile(options, (sources, declarations) -> declarations);
+    }
+
+    private <T> T decompile(Object[] options, DecompiledResult<T> result) throws Exception {
+      DecompilerTestFixture fixture = new DecompilerTestFixture();
+      fixture.setUp(options);
+      try {
+        ConsoleDecompiler decompiler = fixture.getDecompiler();
+        try (Stream<Path> files = Files.walk(classes)) {
+          files.filter(path -> path.toString().endsWith(".class"))
+            .sorted()
+            .forEach(path -> decompiler.addSource(path.toFile()));
+        }
+        decompiler.decompileContext();
+        TextBuffer.checkLeaks();
+
+        List<Path> sources;
+        try (Stream<Path> files = Files.walk(fixture.getTargetDir())) {
+          sources = files.filter(path -> path.toString().endsWith(".java")).sorted().toList();
+        }
+        assertFalse(sources.isEmpty());
+
+        Declarations declarations = Declarations.read(sources, simpleName(binaryName));
+        return result.create(sources, declarations);
+      }
+      finally {
+        fixture.tearDown();
+      }
+    }
+
+    private Scenario fromCompiledOutput(Output output) throws Exception {
+      Path copy = Files.createTempDirectory(root, "round-trip-");
+      try (Stream<Path> files = Files.walk(output.classes)) {
+        for (Path source : files.filter(Files::isRegularFile).toList()) {
+          Path target = copy.resolve(output.classes.relativize(source).toString());
+          Files.createDirectories(target.getParent());
+          Files.copy(source, target);
+        }
+      }
+      return new Scenario(binaryName, copy, root);
+    }
+
+    private Path rootClassFile() {
+      return classes.resolve(binaryName.replace('.', '/') + ".class");
+    }
+  }
+
+  private record Output(Class<?> type, Declarations declarations, Path classes) {
+  }
+
+  @FunctionalInterface
+  private interface DecompiledResult<T> {
+    T create(List<Path> sources, Declarations declarations) throws Exception;
+  }
+
+  private record Declarations(
+    Set<String> fields,
+    Set<DeclaredMethod> methods,
+    Set<String> classes,
+    Set<String> parameterNames,
+    Set<String> stringLiterals,
+    String normalizedSource,
+    String rawSource
+  ) {
+    private static Declarations read(List<Path> sources, String rootName) throws IOException {
+      JavaCompiler compiler = ToolProvider.getSystemJavaCompiler();
+      try (StandardJavaFileManager files = compiler.getStandardFileManager(null, null, StandardCharsets.UTF_8)) {
+        Iterable<? extends JavaFileObject> units = files.getJavaFileObjectsFromPaths(sources);
+        JavacTask task = (JavacTask)compiler.getTask(null, files, null, List.of("-proc:none"), null, units);
+        for (var unit : task.parse()) {
+          for (Tree declaration : unit.getTypeDecls()) {
+            if (declaration instanceof ClassTree clazz &&
+                clazz.getSimpleName().contentEquals(rootName)) {
+              Set<String> fields = new HashSet<>();
+              Set<DeclaredMethod> methods = new HashSet<>();
+              Set<String> classes = new HashSet<>();
+              Set<String> parameterNames = new HashSet<>();
+              Set<String> stringLiterals = new HashSet<>();
+              collect(clazz, fields, methods, classes, parameterNames);
+              new TreeScanner<Void, Set<String>>() {
+                @Override
+                public Void visitLiteral(LiteralTree literal, Set<String> values) {
+                  if (literal.getValue() instanceof String value) {
+                    values.add(value);
+                  }
+                  return super.visitLiteral(literal, values);
+                }
+              }.scan(unit, stringLiterals);
+              return new Declarations(
+                fields,
+                methods,
+                classes,
+                parameterNames,
+                stringLiterals,
+                unit.toString(),
+                unit.getSourceFile().getCharContent(true).toString()
+              );
+            }
+          }
+        }
+      }
+      throw new IOException("Root declaration not found for " + rootName);
+    }
+
+    private static void collect(
+      ClassTree owner,
+      Set<String> fields,
+      Set<DeclaredMethod> methods,
+      Set<String> classes,
+      Set<String> parameterNames
+    ) {
+      for (Tree member : owner.getMembers()) {
+        if (member instanceof VariableTree field) {
+          fields.add(field.getName().toString());
+        }
+        else if (member instanceof MethodTree method) {
+          methods.add(new DeclaredMethod(
+            method.getName().toString(),
+            method.getParameters().size()
+          ));
+          for (VariableTree parameter : method.getParameters()) {
+            parameterNames.add(parameter.getName().toString());
+          }
+        }
+        else if (member instanceof ClassTree nested) {
+          classes.add(nested.getSimpleName().toString());
+          collect(nested, fields, methods, classes, parameterNames);
+        }
+      }
+    }
+
+    private Set<String> fieldsWithin(Set<String> selected) {
+      return intersection(fields, selected);
+    }
+
+    private Set<String> methodsWithin(Set<String> selected) {
+      Set<String> names = new HashSet<>();
+      for (DeclaredMethod method : methods) {
+        names.add(method.name);
+      }
+      return intersection(names, selected);
+    }
+
+    private Set<Integer> methodParameterCounts(String name) {
+      Set<Integer> counts = new HashSet<>();
+      for (DeclaredMethod method : methods) {
+        if (method.name.equals(name)) {
+          counts.add(method.parameterCount);
+        }
+      }
+      return counts;
+    }
+
+    private Set<String> classesWithin(Set<String> selected) {
+      return intersection(classes, selected);
+    }
+
+    private static Set<String> intersection(Set<String> values, Set<String> selected) {
+      Set<String> result = new HashSet<>(values);
+      result.retainAll(selected);
+      return result;
+    }
+  }
+
+  private record DeclaredMethod(String name, int parameterCount) {
+  }
+
+  private static Class<?> load(Path classes, String binaryName) throws Exception {
+    URL[] urls = {classes.toUri().toURL()};
+    URLClassLoader loader = new URLClassLoader(urls, ClassLoader.getPlatformClassLoader());
+    return Class.forName(binaryName, true, loader);
+  }
+
+  private static String simpleName(String binaryName) {
+    return binaryName.substring(binaryName.lastIndexOf('.') + 1);
+  }
+
+  private static void rewrite(Path classFile, MemberArea area, Set<String> names, int flags) throws IOException {
+    byte[] bytes = Files.readAllBytes(classFile);
+    ClassLayout layout = ClassLayout.read(bytes);
+
+    if (area == MemberArea.CLASS) {
+      putU2(bytes, layout.classAccessOffset, u2(bytes, layout.classAccessOffset) | flags);
+    }
+    else {
+      List<MemberLayout> members = area == MemberArea.FIELD ? layout.fields : layout.methods;
+      for (MemberLayout member : members) {
+        if (names.contains(layout.utf8[member.nameIndex])) {
+          putU2(bytes, member.accessOffset, u2(bytes, member.accessOffset) | flags);
+        }
+      }
+    }
+
+    Files.write(classFile, bytes);
+  }
+
+  private enum MemberArea {
+    CLASS,
+    FIELD,
+    METHOD
+  }
+
+  private record MemberLayout(int accessOffset, int nameIndex) {
+  }
+
+  private static final class ClassLayout {
+    private final String[] utf8;
+    private final int classAccessOffset;
+    private final List<MemberLayout> fields;
+    private final List<MemberLayout> methods;
+
+    private ClassLayout(
+      String[] utf8,
+      int classAccessOffset,
+      List<MemberLayout> fields,
+      List<MemberLayout> methods
+    ) {
+      this.utf8 = utf8;
+      this.classAccessOffset = classAccessOffset;
+      this.fields = fields;
+      this.methods = methods;
+    }
+
+    private static ClassLayout read(byte[] bytes) throws IOException {
+      Cursor cursor = new Cursor(bytes);
+      if (cursor.u4() != 0xCAFEBABE) {
+        throw new IOException("Not a class file");
+      }
+      cursor.skip(4);
+
+      int constantPoolCount = cursor.u2();
+      String[] utf8 = new String[constantPoolCount];
+      for (int index = 1; index < constantPoolCount; index++) {
+        int tag = cursor.u1();
+        switch (tag) {
+          case 1 -> {
+            int length = cursor.u2();
+            utf8[index] = new String(cursor.bytes(length), StandardCharsets.UTF_8);
+          }
+          case 3, 4 -> cursor.skip(4);
+          case 5, 6 -> {
+            cursor.skip(8);
+            index++;
+          }
+          case 7, 8, 16, 19, 20 -> cursor.skip(2);
+          case 9, 10, 11, 12, 17, 18 -> cursor.skip(4);
+          case 15 -> cursor.skip(3);
+          default -> throw new IOException("Unknown constant-pool tag " + tag);
+        }
+      }
+
+      int classAccessOffset = cursor.position();
+      cursor.skip(6);
+      int interfaceCount = cursor.u2();
+      cursor.skip(interfaceCount * 2);
+      List<MemberLayout> fields = readMembers(cursor);
+      List<MemberLayout> methods = readMembers(cursor);
+      return new ClassLayout(utf8, classAccessOffset, fields, methods);
+    }
+
+    private static List<MemberLayout> readMembers(Cursor cursor) throws IOException {
+      int count = cursor.u2();
+      List<MemberLayout> members = new ArrayList<>(count);
+      for (int index = 0; index < count; index++) {
+        int accessOffset = cursor.position();
+        cursor.skip(2);
+        int nameIndex = cursor.u2();
+        cursor.skip(2);
+        members.add(new MemberLayout(accessOffset, nameIndex));
+        skipAttributes(cursor);
+      }
+      return members;
+    }
+
+    private static void skipAttributes(Cursor cursor) throws IOException {
+      int count = cursor.u2();
+      for (int index = 0; index < count; index++) {
+        cursor.skip(2);
+        int length = cursor.u4();
+        cursor.skip(length);
+      }
+    }
+  }
+
+  private static final class Cursor {
+    private final DataInputStream input;
+    private int position;
+
+    private Cursor(byte[] bytes) {
+      input = new DataInputStream(new ByteArrayInputStream(bytes));
+    }
+
+    private int position() {
+      return position;
+    }
+
+    private int u1() throws IOException {
+      position++;
+      return input.readUnsignedByte();
+    }
+
+    private int u2() throws IOException {
+      position += 2;
+      return input.readUnsignedShort();
+    }
+
+    private int u4() throws IOException {
+      position += 4;
+      return input.readInt();
+    }
+
+    private byte[] bytes(int length) throws IOException {
+      position += length;
+      return input.readNBytes(length);
+    }
+
+    private void skip(int length) throws IOException {
+      position += length;
+      input.skipNBytes(length);
+    }
+  }
+
+  private static int u2(byte[] bytes, int offset) {
+    return (bytes[offset] & 0xFF) << 8 | bytes[offset + 1] & 0xFF;
+  }
+
+  private static void putU2(byte[] bytes, int offset, int value) {
+    bytes[offset] = (byte)(value >>> 8);
+    bytes[offset + 1] = (byte)value;
+  }
+
+  private static final class StringSource extends SimpleJavaFileObject {
+    private final String source;
+
+    private StringSource(String binaryName, String source) {
+      super(URI.create("string:///" + binaryName.replace('.', '/') + Kind.SOURCE.extension), Kind.SOURCE);
+      this.source = source;
+    }
+
+    @Override
+    public CharSequence getCharContent(boolean ignoreEncodingErrors) {
+      return source;
+    }
+  }
+}
