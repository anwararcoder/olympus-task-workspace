+  private static void assertBehaviorMatches(Class<?> expected, Class<?> actual) throws Exception {
+    Method expectedMethod = expected.getMethod("value");
+    Method actualMethod = actual.getMethod("value");
+    assertEquals(expectedMethod.invoke(null), actualMethod.invoke(null));
+  }
