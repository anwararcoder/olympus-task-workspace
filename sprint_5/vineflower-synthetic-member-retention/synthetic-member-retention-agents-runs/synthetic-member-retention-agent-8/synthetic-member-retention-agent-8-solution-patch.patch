+  /**
+   * Determine which declarations that the normal removal/reconstruction pipeline would omit are
+   * still needed by the Java emitted for this output file.
+   *
+   * <p>The first rendering contains only declarations that would normally be emitted. References
+   * from that rendering are the roots of the decision. Rendering is repeated after each expansion
+   * because a retained declaration can itself contain a reference to another omitted declaration.
+   * This gives the least fixed point, so declarations reachable only through omitted code remain
+   * omitted.</p>
+   */
+  private void decideReferenceAwareRetention(ClassNode root) {
+    root.setReferenceAwareRetentionInProgress(true);
+
+    try {
+      Set<String> candidates = new LinkedHashSet<>();
+      collectOmittedGeneratedMembers(root, root, Collections.newSetFromMap(new IdentityHashMap<>()), candidates);
+
+      if (candidates.isEmpty()) {
+        return;
+      }
+
+      Set<String> retained = root.getReferenceAwareRetainedMembers();
+      boolean changed;
+      do {
+        TextBuffer candidate = new TextBuffer(ClassesProcessor.AVERAGE_CLASS_SIZE);
+        writeClassInternal(root, candidate, 0);
+        changed = collectGeneratedReferences(candidate, candidates, retained);
+      }
+      while (changed);
+    }
+    finally {
+      root.setReferenceAwareRetentionInProgress(false);
+      root.setReferenceAwareRetentionDecided(true);
+    }
+  }
+
+  private void collectOmittedGeneratedMembers(ClassNode node,
+                                              ClassNode outputRoot,
+                                              Set<ClassNode> visited,
+                                              Set<String> candidates) {
+    if (!visited.add(node)) {
+      return;
+    }
+
+    ClassWrapper wrapper = node.getWrapper();
+    if (wrapper != null) {
+      for (StructField field : node.classStruct.getFields()) {
+        if (field.isSynthetic() && isOmittedSyntheticField(wrapper, field)) {
+          candidates.add(fieldKey(node.classStruct.qualifiedName, field.getName(), field.getDescriptor()));
+        }
+      }
+
+      String methodToDecompile = (String)DecompilerContext.getProperty(IFernflowerPreferences.METHOD_TO_DECOMPILE);
+      for (StructMethod method : node.classStruct.getMethods()) {
+        if ((method.isSynthetic() || method.hasModifier(CodeConstants.ACC_BRIDGE)) &&
+            methodToDecompile.isEmpty() && isOmittedGeneratedMethod(wrapper, method)) {
+          candidates.add(methodKey(node.classStruct.qualifiedName, method.getName(), method.getDescriptor()));
+        }
+      }
+    }
+
+    for (ClassNode child : node.nested) {
+      if (child.type == ClassNode.Type.MEMBER && isSyntheticMemberClass(node, child)) {
+        candidates.add(classKey(child.classStruct.qualifiedName));
+      }
+
+      collectOmittedGeneratedMembers(child, outputRoot, visited, candidates);
+    }
+  }
+
+  private boolean collectGeneratedReferences(TextBuffer buffer, Set<String> candidates, Set<String> retained) {
+    boolean changed = false;
+
+    for (TextToken token : buffer.getTokens()) {
+      if (token.isDeclaration()) {
+        continue;
+      }
+
+      String key = null;
+      if (token instanceof FieldTextToken field) {
+        key = fieldKey(field.className, field.name, field.descriptor.descriptorString);
+      }
+      else if (token instanceof MethodTextToken method) {
+        key = methodKey(method.className, method.name, method.descriptor.toString());
+      }
+      else if (token instanceof ClassTextToken clazz) {
+        key = classKey(clazz.qualifiedName);
+      }
+
+      if (key != null && candidates.contains(key)) {
+        changed |= retained.add(key);
+      }
+    }
+
+    return changed;
+  }
+
+  private static boolean isOmittedSyntheticField(ClassWrapper wrapper, StructField field) {
+    return DecompilerContext.getOption(IFernflowerPreferences.REMOVE_SYNTHETIC) ||
+           wrapper.getHiddenMembers().contains(InterpreterUtil.makeUniqueKey(field.getName(), field.getDescriptor()));
+  }
+
+  private static boolean isOmittedGeneratedMethod(ClassWrapper wrapper, StructMethod method) {
+    return method.isSynthetic() && DecompilerContext.getOption(IFernflowerPreferences.REMOVE_SYNTHETIC) ||
+           method.hasModifier(CodeConstants.ACC_BRIDGE) && DecompilerContext.getOption(IFernflowerPreferences.REMOVE_BRIDGE) ||
+           wrapper.getHiddenMembers().contains(InterpreterUtil.makeUniqueKey(method.getName(), method.getDescriptor()));
+  }
+
+  private static boolean isSyntheticMemberClass(ClassNode parent, ClassNode child) {
+    ClassWrapper wrapper = parent.getWrapper();
+    if (wrapper == null) {
+      return false;
+    }
+
+    StructClass childClass = child.classStruct;
+    return ((child.access & CodeConstants.ACC_SYNTHETIC) != 0 || childClass.isSynthetic()) &&
+           (DecompilerContext.getOption(IFernflowerPreferences.REMOVE_SYNTHETIC) ||
+            wrapper.getHiddenMembers().contains(childClass.qualifiedName));
+  }
+
+  private static boolean isRetainedGeneratedMember(ClassNode node, String key) {
+    if (!DecompilerContext.getOption(IFernflowerPreferences.REFERENCE_AWARE_SYNTHETIC_RETENTION)) {
+      return false;
+    }
+
+    ClassNode root = getOutputRoot(node);
+    return root.getReferenceAwareRetainedMembers().contains(key);
+  }
+
+  private static ClassNode getOutputRoot(ClassNode node) {
+    ClassNode root = node;
+    while (root.parent != null) {
+      root = root.parent;
+    }
+    return root;
+  }
+
+  private static String fieldKey(String className, String name, String descriptor) {
+    return "field\0" + className + "\0" + name + "\0" + descriptor;
+  }
+
+  private static String methodKey(String className, String name, String descriptor) {
+    return "method\0" + className + "\0" + name + "\0" + descriptor;
+  }
+
+  private static String classKey(String className) {
+    return "class\0" + className;
+  }
