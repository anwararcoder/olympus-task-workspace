+package org.jetbrains.java.decompiler;
+
+import org.jetbrains.java.decompiler.main.extern.IFernflowerPreferences;
+import org.junit.jupiter.api.Test;
+
+import java.io.IOException;
+import java.nio.file.Path;
+
+import static org.jetbrains.java.decompiler.DecompilerTestFixture.getContent;
+import static org.junit.jupiter.api.Assertions.*;
+
+public class ReferenceAwareSyntheticRetentionTest {
+  private static final String CLASS_NAME = "TestReferenceAwareSyntheticRetention";
+
+  @Test
+  public void retainsOnlyMembersStillReferencedByEmittedJava() throws IOException {
+    String disabled = decompile();
+    String enabled = decompile(IFernflowerPreferences.REFERENCE_AWARE_SYNTHETIC_RETENTION, "1");
+
+    assertEquals(disabled, decompile(IFernflowerPreferences.REFERENCE_AWARE_SYNTHETIC_RETENTION, "0"));
+
+    assertFalse(disabled.contains("private int retainedField;"));
+    assertFalse(disabled.contains("private void retainedMethod()"));
+
+    assertTrue(enabled.contains("private int retainedField;"));
+    assertTrue(enabled.contains("private void retainedMethod()"));
+    assertTrue(enabled.contains("public TestReferenceAwareSyntheticRetention()"));
+    assertFalse(enabled.contains("unusedField"));
+    assertFalse(enabled.contains("optimizedField;"));
+    assertFalse(enabled.contains("private void unusedMethod()"));
+    assertTrue(enabled.contains("return \"unusedMethod\";"));
+  }
+
+  @Test
+  public void isDeterministicAcrossDecompilerContexts() throws IOException {
+    String first = decompile(IFernflowerPreferences.REFERENCE_AWARE_SYNTHETIC_RETENTION, "1");
+    String second = decompile(IFernflowerPreferences.REFERENCE_AWARE_SYNTHETIC_RETENTION, "1");
+
+    assertEquals(first, second);
+  }
+
+  private static String decompile(Object... options) throws IOException {
+    DecompilerTestFixture fixture = new DecompilerTestFixture();
+    fixture.setUp(options);
+    try {
+      Path classFile = fixture.getTestDataDir().resolve("classes/jasm/pkg/" + CLASS_NAME + ".class");
