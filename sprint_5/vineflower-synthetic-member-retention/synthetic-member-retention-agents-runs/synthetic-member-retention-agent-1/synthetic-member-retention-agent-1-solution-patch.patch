+      wrapper.getHiddenMembers().contains(InterpreterUtil.makeUniqueKey(fd.getName(), fd.getDescriptor()));
+    return hide && !shouldRetain(RetentionMember.field(node.classStruct.qualifiedName, fd.getName(), fd.getDescriptor()));
+  }
