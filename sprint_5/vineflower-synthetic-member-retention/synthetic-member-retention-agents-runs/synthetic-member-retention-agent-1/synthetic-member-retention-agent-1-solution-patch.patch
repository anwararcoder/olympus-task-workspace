+  private static void collectRetentionCandidates(ClassNode node,
+                                                 Set<RetentionMember> candidates,
+                                                 Set<ClassNode> visited) {
+    if (!visited.add(node)) {
+      return;
+    }
+
+    if (node.type != ClassNode.Type.LAMBDA) {
+      StructClass cl = node.classStruct;
+      for (StructField fd : cl.getFields()) {
+        if (fd.isSynthetic()) {
+          candidates.add(RetentionMember.field(cl.qualifiedName, fd.getName(), fd.getDescriptor()));
+        }
+      }
+      for (StructMethod mt : cl.getMethods()) {
+        if (mt.isSynthetic() || mt.hasModifier(CodeConstants.ACC_BRIDGE)) {
+          candidates.add(RetentionMember.method(cl.qualifiedName, mt.getName(), mt.getDescriptor()));
+        }
+      }
+    }
+
+    for (ClassNode child : node.nested) {
+      if (child.type == ClassNode.Type.MEMBER) {
+        StructClass cl = child.classStruct;
+        if ((child.access & CodeConstants.ACC_SYNTHETIC) != 0 || cl.isSynthetic()) {
+          candidates.add(RetentionMember.clazz(cl.qualifiedName));
+        }
+      }
+      collectRetentionCandidates(child, candidates, visited);
+    }
+  }
+
+  private static void collectReferencedMembers(TextBuffer buffer,
+                                               Set<RetentionMember> candidates,
+                                               Set<RetentionMember> referenced) {
+    for (TextToken token : buffer.getTokens()) {
+      if (token.isDeclaration()) {
+        continue;
+      }
+
+      RetentionMember member = null;
+      if (token instanceof FieldTextToken field) {
+        member = RetentionMember.field(field.className, field.name, field.descriptor.descriptorString);
+      }
+      else if (token instanceof MethodTextToken method) {
+        member = RetentionMember.method(method.className, method.name, method.descriptor.toString());
+      }
+      else if (token instanceof ClassTextToken clazz) {
+        member = RetentionMember.clazz(clazz.qualifiedName);
+      }
+
+      if (member != null && candidates.contains(member)) {
+        referenced.add(member);
+      }
+    }
+  }
