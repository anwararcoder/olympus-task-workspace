diff --git a/src/org/jetbrains/java/decompiler/main/ReferenceAwareSyntheticRetention.java b/src/org/jetbrains/java/decompiler/main/ReferenceAwareSyntheticRetention.java
new file mode 100644
index 0000000..5eba0d7
--- /dev/null
+++ b/src/org/jetbrains/java/decompiler/main/ReferenceAwareSyntheticRetention.java
@@ -0,0 +1,152 @@
+package org.jetbrains.java.decompiler.main;
+
+import org.jetbrains.java.decompiler.code.CodeConstants;
+import org.jetbrains.java.decompiler.main.ClassesProcessor.ClassNode;
+import org.jetbrains.java.decompiler.main.DecompilerContext;
+import org.jetbrains.java.decompiler.main.extern.IFernflowerPreferences;
+import org.jetbrains.java.decompiler.struct.StructClass;
+import org.jetbrains.java.decompiler.struct.StructField;
+import org.jetbrains.java.decompiler.struct.StructMethod;
+import org.jetbrains.java.decompiler.util.InterpreterUtil;
+import org.jetbrains.java.decompiler.util.TextBuffer;
+import org.jetbrains.java.decompiler.util.token.ClassTextToken;
+import org.jetbrains.java.decompiler.util.token.FieldTextToken;
+import org.jetbrains.java.decompiler.util.token.MethodTextToken;
+import org.jetbrains.java.decompiler.util.token.TextToken;
+
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Map;
+import java.util.Set;
+
+final class ReferenceAwareSyntheticRetention {
+  private static final String FIELD_PREFIX = "field:";
+  private static final String METHOD_PREFIX = "method:";
+  private static final String CLASS_PREFIX = "class:";
+
+  private ReferenceAwareSyntheticRetention() {
+  }
+
+  static String fieldKey(StructClass owner, StructField field) {
+    return fieldKey(owner.qualifiedName, field.getName(), field.getDescriptor());
+  }
+
+  private static String fieldKey(String owner, String name, String descriptor) {
+    return FIELD_PREFIX + owner + '#' + InterpreterUtil.makeUniqueKey(name, descriptor);
+  }
+
+  static String methodKey(StructClass owner, StructMethod method) {
+    return methodKey(owner.qualifiedName, method.getName(), method.getDescriptor());
+  }
+
+  private static String methodKey(String owner, String name, String descriptor) {
+    return METHOD_PREFIX + owner + '#' + InterpreterUtil.makeUniqueKey(name, descriptor);
+  }
+
+  static String classKey(StructClass clazz) {
+    return CLASS_PREFIX + clazz.qualifiedName;
+  }
+
+  static Set<String> findCandidates(ClassNode root) {
+    Set<String> candidates = new HashSet<>();
+    collectCandidates(root, candidates);
+    return candidates;
+  }
+
+  private static void collectCandidates(ClassNode node, Set<String> candidates) {
+    if (node.type != ClassNode.Type.LAMBDA) {
+      String methodToDecompile = (String) DecompilerContext.getProperty(IFernflowerPreferences.METHOD_TO_DECOMPILE);
+
+      if (node.getWrapper() != null) {
+        for (StructField field : node.classStruct.getFields()) {
+          if (methodToDecompile.isEmpty() && field.isSynthetic() &&
+            ClassWriter.isFieldHidden(node, field, node.getWrapper())) {
+            candidates.add(fieldKey(node.classStruct, field));
+          }
+        }
+
+        for (StructMethod method : node.classStruct.getMethods()) {
+          boolean normalMethodOutput = methodToDecompile.isEmpty() ||
+            (node.type != ClassNode.Type.ROOT && node.type != ClassNode.Type.MEMBER);
+          if (normalMethodOutput && (method.isSynthetic() || method.hasModifier(CodeConstants.ACC_BRIDGE)) &&
+            ClassWriter.isMethodHidden(node, method, node.getWrapper(), methodToDecompile)) {
+            candidates.add(methodKey(node.classStruct, method));
+          }
+        }
+      }
+    }
+
+    for (ClassNode child : node.nested) {
+      if (child.type == ClassNode.Type.MEMBER && child.getWrapper() != null &&
+        ClassWriter.isMemberClassHidden(node, child, node.getWrapper(),
+          (String) DecompilerContext.getProperty(IFernflowerPreferences.METHOD_TO_DECOMPILE))) {
+        boolean isSynthetic = (child.access & CodeConstants.ACC_SYNTHETIC) != 0 || child.classStruct.isSynthetic();
+        if (isSynthetic) {
+          candidates.add(classKey(child.classStruct));
+        }
+      }
+
+      collectCandidates(child, candidates);
+    }
+  }
+
+  static Set<String> findReferencedCandidates(TextBuffer buffer, Set<String> candidates) {
+    Set<String> referenced = new HashSet<>();
+
+    for (TextToken token : buffer.getTokens()) {
+      if (token.isDeclaration()) {
+        continue;
+      }
+
+      String key = null;
+      if (token instanceof FieldTextToken field) {
+        key = fieldKey(field.className, field.name, field.descriptor.descriptorString);
+      }
+      else if (token instanceof MethodTextToken method) {
+        key = methodKey(method.className, method.name, method.descriptor.toString());
+      }
+      else if (token instanceof ClassTextToken clazz) {
+        key = CLASS_PREFIX + clazz.qualifiedName;
+      }
+
+      if (key != null && candidates.contains(key)) {
+        referenced.add(key);
+      }
+    }
+
+    return referenced;
+  }
+
+  static void retainRequiredEnclosingClasses(ClassNode root, Set<String> retained, Set<String> candidates) {
+    Map<String, ClassNode> classes = new HashMap<>();
+    collectClasses(root, classes);
+
+    boolean changed;
+    do {
+      changed = false;
+      for (String key : new HashSet<>(retained)) {
+        if (!key.startsWith(CLASS_PREFIX)) {
+          continue;
+        }
+
+        ClassNode node = classes.get(key.substring(CLASS_PREFIX.length()));
+        if (node == null || node.parent == null || node.parent.type != ClassNode.Type.MEMBER) {
+          continue;
+        }
+
+        String parentKey = classKey(node.parent.classStruct);
+        if (candidates.contains(parentKey) && retained.add(parentKey)) {
+          changed = true;
+        }
+      }
+    }
+    while (changed);
+  }
+
+  private static void collectClasses(ClassNode node, Map<String, ClassNode> classes) {
+    classes.put(node.classStruct.qualifiedName, node);
+    for (ClassNode child : node.nested) {
+      collectClasses(child, classes);
+    }
+  }
+}
