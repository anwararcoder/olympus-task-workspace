+package org.jetbrains.java.decompiler.main;
+
+import org.jetbrains.java.decompiler.code.CodeConstants;
+import org.jetbrains.java.decompiler.main.ClassesProcessor.ClassNode;
+import org.jetbrains.java.decompiler.main.extern.IFernflowerPreferences;
+import org.jetbrains.java.decompiler.main.rels.ClassWrapper;
+import org.jetbrains.java.decompiler.struct.StructField;
+import org.jetbrains.java.decompiler.struct.StructMethod;
+import org.jetbrains.java.decompiler.util.InterpreterUtil;
+import org.jetbrains.java.decompiler.util.TextBuffer;
+import org.jetbrains.java.decompiler.util.token.ClassTextToken;
+import org.jetbrains.java.decompiler.util.token.FieldTextToken;
+import org.jetbrains.java.decompiler.util.token.MethodTextToken;
+import org.jetbrains.java.decompiler.util.token.TextToken;
+
+import java.util.HashSet;
+import java.util.Objects;
+import java.util.Set;
+
+/**
+ * Finds references to generated members in the Java text produced by {@link ClassWriter}.
+ *
+ * <p>The writer's text tokens are deliberately used here instead of searching the resulting
+ * text.  Tokens distinguish code references from comments and literals, and retain the JVM
+ * owner/name/descriptor of a member even when its source spelling is shortened or renamed.</p>
+ */
+final class ReferenceAwareSyntheticRetention {
+  private ReferenceAwareSyntheticRetention() { }
+
+  enum Kind {
+    FIELD,
+    METHOD,
+    MEMBER_CLASS
+  }
+
+  static final class MemberKey {
+    private final Kind kind;
+    private final String owner;
+    private final String name;
+    private final String descriptor;
+
+    private MemberKey(Kind kind, String owner, String name, String descriptor) {
+      this.kind = kind;
+      this.owner = owner;
+      this.name = name;
+      this.descriptor = descriptor;
+    }
+
+    static MemberKey field(String owner, String name, String descriptor) {
+      return new MemberKey(Kind.FIELD, owner, name, descriptor);
+    }
+
+    static MemberKey method(String owner, String name, String descriptor) {
+      return new MemberKey(Kind.METHOD, owner, name, descriptor);
+    }
+
+    static MemberKey memberClass(String qualifiedName) {
+      return new MemberKey(Kind.MEMBER_CLASS, qualifiedName, null, null);
+    }
+
+    @Override
+    public boolean equals(Object o) {
+      if (this == o) return true;
+      if (!(o instanceof MemberKey)) return false;
+      MemberKey key = (MemberKey)o;
+      return kind == key.kind &&
+        Objects.equals(owner, key.owner) &&
+        Objects.equals(name, key.name) &&
+        Objects.equals(descriptor, key.descriptor);
+    }
+
+    @Override
+    public int hashCode() {
+      return Objects.hash(kind, owner, name, descriptor);
+    }
+  }
+
+  /**
+   * Adds generated members referenced by the current emitted file to the root's retention set.
+   * Only members that the normal writer would omit are candidates.  The return value indicates
+   * whether the file needs to be emitted again so that bodies of newly retained members can be
+   * inspected on the next pass.
+   */
+  static boolean retainReferencedMembers(ClassNode root, TextBuffer buffer) {
+    if (!DecompilerContext.getOption(IFernflowerPreferences.REFERENCE_AWARE_SYNTHETIC_RETENTION)) {
+      return false;
+    }
+
+    Set<MemberKey> candidates = new HashSet<>();
+    collectCandidates(root, candidates);
+    if (candidates.isEmpty()) {
+      return false;
+    }
+
+    Set<MemberKey> retained = root.getReferenceAwareRetainedMembers();
+    boolean changed = false;
+    for (TextToken token : buffer.getTokens()) {
+      if (token.isDeclaration()) {
+        continue;
+      }
+
+      MemberKey referenced = referencedMember(token);
+      if (referenced != null && candidates.contains(referenced) && retained.add(referenced)) {
+        changed = true;
+      }
+    }
+
+    return changed;
+  }
+
+  static boolean isRetainedField(ClassNode node, StructField field) {
+    return isRetained(node, MemberKey.field(node.classStruct.qualifiedName, field.getName(), field.getDescriptor()));
+  }
+
+  static boolean isRetainedMethod(ClassNode node, StructMethod method) {
+    return isRetained(node, MemberKey.method(node.classStruct.qualifiedName, method.getName(), method.getDescriptor()));
+  }
+
+  static boolean isRetainedMemberClass(ClassNode node) {
+    return isRetained(node, MemberKey.memberClass(node.classStruct.qualifiedName));
+  }
+
+  private static boolean isRetained(ClassNode node, MemberKey key) {
+    if (!DecompilerContext.getOption(IFernflowerPreferences.REFERENCE_AWARE_SYNTHETIC_RETENTION)) {
+      return false;
+    }
+    return rootOf(node).getReferenceAwareRetainedMembers().contains(key);
+  }
+
+  private static void collectCandidates(ClassNode node, Set<MemberKey> candidates) {
+    if (node.type != ClassNode.Type.LAMBDA) {
+      ClassWrapper wrapper = node.getWrapper();
+      if (wrapper != null) {
+        String owner = node.classStruct.qualifiedName;
+
+        if (methodToDecompileIsEmpty()) {
+          for (StructField field : node.classStruct.getFields()) {
+            boolean hidden = wrapper.getHiddenMembers().contains(InterpreterUtil.makeUniqueKey(field.getName(), field.getDescriptor()));
+            if (field.isSynthetic() &&
+                (DecompilerContext.getOption(IFernflowerPreferences.REMOVE_SYNTHETIC) || hidden)) {
+              candidates.add(MemberKey.field(owner, field.getName(), field.getDescriptor()));
+            }
+          }
+        }
+
+        if (methodToDecompileIsEmpty() || (node.type != ClassNode.Type.ROOT && node.type != ClassNode.Type.MEMBER)) {
+          for (StructMethod method : node.classStruct.getMethods()) {
+            boolean hidden = wrapper.getHiddenMembers().contains(InterpreterUtil.makeUniqueKey(method.getName(), method.getDescriptor()));
+            boolean synthetic = method.isSynthetic();
+            boolean bridge = method.hasModifier(CodeConstants.ACC_BRIDGE);
+            if ((synthetic || bridge) &&
+                ((synthetic && DecompilerContext.getOption(IFernflowerPreferences.REMOVE_SYNTHETIC)) ||
+                 (bridge && DecompilerContext.getOption(IFernflowerPreferences.REMOVE_BRIDGE)) ||
+                 hidden)) {
+              candidates.add(MemberKey.method(owner, method.getName(), method.getDescriptor()));
+            }
+          }
+        }
+      }
+    }
+
+    for (ClassNode child : node.nested) {
+      if (child.type == ClassNode.Type.MEMBER && methodToDecompileIsEmpty()) {
+        boolean synthetic = (child.access & CodeConstants.ACC_SYNTHETIC) != 0 || child.classStruct.isSynthetic();
+        ClassWrapper parentWrapper = child.parent == null ? null : child.parent.getWrapper();
+        boolean hidden = parentWrapper != null && parentWrapper.getHiddenMembers().contains(child.classStruct.qualifiedName);
+        if (synthetic &&
+            (DecompilerContext.getOption(IFernflowerPreferences.REMOVE_SYNTHETIC) || hidden)) {
+          candidates.add(MemberKey.memberClass(child.classStruct.qualifiedName));
+        }
+      }
+
+      collectCandidates(child, candidates);
+    }
+  }
+
+  private static MemberKey referencedMember(TextToken token) {
+    if (token instanceof FieldTextToken field) {
+      return MemberKey.field(field.className, field.name, field.descriptor.descriptorString);
+    }
+    if (token instanceof MethodTextToken method) {
+      return MemberKey.method(method.className, method.name, method.descriptor.toString());
+    }
+    if (token instanceof ClassTextToken clazz) {
+      return MemberKey.memberClass(clazz.qualifiedName);
+    }
+    return null;
+  }
+
+  private static boolean methodToDecompileIsEmpty() {
+    Object value = DecompilerContext.getProperty(IFernflowerPreferences.METHOD_TO_DECOMPILE);
+    return value == null || value.toString().isEmpty();
+  }
+
+  private static ClassNode rootOf(ClassNode node) {
+    while (node.parent != null) {
+      node = node.parent;
+    }
+    return node;
+  }
+}
