@@ -0,0 +1,55 @@
+package org.jetbrains.java.decompiler;
+
+import org.jetbrains.java.decompiler.main.extern.IFernflowerPreferences;
+import org.junit.jupiter.api.Test;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+public class ReferenceAwareSyntheticRetentionTest {
+  @Test
+  public void retainsOnlyReferencedGeneratedMembers() throws IOException {
+    String withoutRetention = decompile(Map.of());
+    assertFalse(withoutRetention.contains("synthetic field"));
+    assertFalse(withoutRetention.contains("synthetic method"));
+    assertFalse(withoutRetention.contains("class Generated"));
+
+    String withRetention = decompile(Map.of(IFernflowerPreferences.REFERENCE_AWARE_SYNTHETIC_RETENTION, "1"));
+    assertTrue(withRetention.contains("int generated"));
+    assertFalse(withRetention.contains("int unused"));
+    assertTrue(withRetention.contains("int bridge()"));
+    assertTrue(withRetention.contains("int chained()"));
+    assertTrue(withRetention.contains("int deep()"));
+    assertTrue(withRetention.contains("class Generated"));
+  }
+
+  private static String decompile(Map<String, Object> options) throws IOException {
+    DecompilerTestFixture fixture = new DecompilerTestFixture();
+    Object[] optionPairs = options.entrySet().stream()
+      .flatMap(entry -> java.util.stream.Stream.of(entry.getKey(), entry.getValue()))
+      .toArray();
+    fixture.setUp(optionPairs);
+    try {
+      Path classFile = fixture.getTestDataDir().resolve("classes/jasm/pkg/TestReferenceAwareSyntheticRetention.class");
+      fixture.getDecompiler().addSource(classFile.toFile());
+      Path memberClassFile = fixture.getTestDataDir().resolve("classes/jasm/pkg/TestReferenceAwareSyntheticRetention$Generated.class");
+      fixture.getDecompiler().addSource(memberClassFile.toFile());
+      fixture.getDecompiler().decompileContext();
+
+      try (var files = Files.walk(fixture.getTargetDir())) {
+        Path output = files
+          .filter(path -> path.getFileName().toString().equals("TestReferenceAwareSyntheticRetention.java"))
+          .findFirst()
+          .orElseThrow();
+        return Files.readString(output);
+      }
+    } finally {
+      fixture.tearDown();
+    }
+  }
+}
