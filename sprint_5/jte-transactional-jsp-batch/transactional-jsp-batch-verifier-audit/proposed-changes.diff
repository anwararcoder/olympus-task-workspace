+    @Test
+    void jakartaNestedApprovedIncludesParticipateInDependencyOrdering() throws Throwable {
+        tag("a", "<%@ include file=\"/WEB-INF/one.jsp.inc\" %>");
+        tag("z", "z");
+        write(jspRoot.resolve("one.jsp.inc"), "<%@ include file=\"/WEB-INF/two.jsp.inc\" %>");
+        write(jspRoot.resolve("two.jsp.inc"), "<my:z/>");
+        Consumer<Converter> setup = value -> {
+            value.setPrefix("");
+            value.addInlinedInclude("/WEB-INF/one.jsp.inc");
+            value.addInlinedInclude("/WEB-INF/two.jsp.inc");
+        };
+
+        Object plan = plan(List.of("my/a.tag", "my/z.tag"), setup);
+
+        assertThat(order(plan)).containsExactly(tagPath("z"), tagPath("a"));
+        assertThat(writes(plan).get(jteRoot.resolve("my/a.jte"))).contains("@template.my.z(");
+    }
+
+    @Test
+    void jakartaApprovedIncludeSymlinkToOutsideRootIsRejected() throws Exception {
+        tag("root", "<%@ include file=\"/WEB-INF/linked.jsp.inc\" %>");
+        Path outside = write(tempDir.resolve("outside.jsp.inc"), "outside");
+        Files.createSymbolicLink(jspRoot.resolve("linked.jsp.inc"), outside);
+        Consumer<Converter> setup = value -> {
+            value.setPrefix("");
+            value.addInlinedInclude("/WEB-INF/linked.jsp.inc");
+        };
+
+        assertThat(catchPlanFailure(List.of("my/root.tag"), setup))
+                .isInstanceOf(IllegalArgumentException.class);
+    }
+
+    @Test
+    void jakartaCommitRethrowsTheOriginalIOExceptionInstance() throws Throwable {
+        tag("a", "a");
+        Path usage = write(jspRoot.resolve("usage.jsp"), "<my:a/>");
+        FailingPathFileSystem fileSystem = new FailingPathFileSystem(Set.of(usage, tagPath("a")), false);
+        converter = new TestConverter(fileSystem.wrap(jspRoot), fileSystem.wrap(jteRoot), tempDir.toUri().toURL());
+        Object plan = plan(List.of("my/a.tag"), noPrefix());
+
+        Throwable failure = catchCommitFailure(plan);
+
+        assertThat(failure).isSameAs(fileSystem.getPrimaryFailure());
+    }
+
     private Consumer<Converter> noPrefix() {
         return value -> value.setPrefix("");
