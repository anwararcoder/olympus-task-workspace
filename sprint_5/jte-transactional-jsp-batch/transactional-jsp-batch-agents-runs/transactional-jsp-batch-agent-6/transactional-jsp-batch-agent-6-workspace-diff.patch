+    private Consumer<Converter> markSetup(AtomicInteger conversions) {
+        return value -> {
+            value.setPrefix("");
+            value.register("my:mark", (jtp, tag, output, bodyConverter) ->
+                    output.append("mark-" + conversions.incrementAndGet()));
+        };
+    }
+
+    private Consumer<Converter> noPrefix() {
+        return value -> value.setPrefix("");
+    }
+
+    private Consumer<Converter> withInclude() {
+        return value -> {
+            value.setPrefix("");
+            value.addInlinedInclude("/WEB-INF/fragment.jsp.inc");
+        };
+    }
+
+    private Object plan(Collection<String> tags, Consumer<Converter> setup) throws Throwable {
+        try {
+            Method method = JspToJteConverter.class.getMethod("planTags", Collection.class, Consumer.class);
+            return method.invoke(converter, tags, setup);
+        } catch (InvocationTargetException e) {
+            throw e.getCause();
+        }
+    }
+
+    private Throwable catchPlanFailure(Collection<String> tags, Consumer<Converter> setup) {
+        try {
+            plan(tags, setup);
+        } catch (Throwable throwable) {
+            return throwable;
+        }
+        throw new AssertionError("Expected planning to fail.");
+    }
+
+    private void commit(Object plan) throws Throwable {
+        try {
+            plan.getClass().getMethod("commit").invoke(plan);
+        } catch (InvocationTargetException e) {
+            throw e.getCause();
+        }
+    }
+
+    private Throwable catchCommitFailure(Object plan) {
+        try {
+            commit(plan);
+        } catch (Throwable throwable) {
+            return throwable;
+        }
+        throw new AssertionError("Expected commit to fail.");
+    }
+
+    private List<Path> order(Object plan) throws Exception {
+        return new ArrayList<>(collection(plan, "getConversionOrder"));
+    }
+
+    @SuppressWarnings("unchecked")
+    private Collection<Path> collection(Object target, String getter) throws Exception {
+        return (Collection<Path>) target.getClass().getMethod(getter).invoke(target);
+    }
+
+    @SuppressWarnings("unchecked")
+    private Map<Path, String> writes(Object plan) throws Exception {
+        return (Map<Path, String>) plan.getClass().getMethod("getWrites").invoke(plan);
+    }
+
+    private List<Path> deletes(Object plan) throws Exception {
+        return new ArrayList<>(collection(plan, "getDeletes"));
+    }
+
+    @SuppressWarnings("unchecked")
+    private void assertChangedPaths(Throwable failure, Path... paths) throws Exception {
+        assertThat(failure.getClass().getSimpleName()).isEqualTo("StaleJspMigrationPlanException");
+        List<Path> changed = new ArrayList<>(collection(failure, "getChangedPaths"));
+        assertNormalizedAbsolute(changed);
+        assertThat(changed).containsExactly(paths);
+    }
+
+    private Path tag(String name, String body) throws IOException {
+        return write(tagPath(name), header() + body);
+    }
+
+    private Path tagPath(String name) {
+        return jspRoot.resolve("my/" + name + ".tag");
+    }
+
+    private String header() {
+        return """
+                <%@ taglib uri="urn:test" prefix="my" %>
+                <%@ attribute name="value" required="false" type="java.lang.String" %>
+                """;
+    }
+
+    private void writeTagLibrary() throws IOException {
+        List<String> names = List.of(
+                "a", "a-b", "aB", "b", "external", "foo", "foobar",
+                "independent", "jte", "leaf", "mark", "parent", "root", "z"
+        );
+        StringBuilder tags = new StringBuilder();
+        for (String name : names) {
+            tags.append("<tag><name>").append(name).append("</name>")
+                    .append("<tag-class>example.JteTag</tag-class>")
+                    .append("<body-content>scriptless</body-content>")
+                    .append("<dynamic-attributes>true</dynamic-attributes></tag>\n");
+        }
+        write(jspRoot.resolve("tld/my.tld"), """
+                <?xml version="1.0" encoding="UTF-8" ?>
+                <taglib xmlns="http://java.sun.com/xml/ns/j2ee" version="2.0">
+                  <tlib-version>1.0</tlib-version>
+                  <short-name>my</short-name>
+                  <uri>urn:test</uri>
+                """ + tags + "</taglib>\n");
+    }
+
+    private Path write(Path path, String content) throws IOException {
+        Files.createDirectories(path.getParent());
+        Files.writeString(path, content, StandardCharsets.UTF_8);
+        return path;
+    }
+
+    private Map<Path, String> snapshot(Path root) throws IOException {
+        Map<Path, String> result = new LinkedHashMap<>();
+        try (Stream<Path> stream = Files.walk(root)) {
+            stream.filter(Files::isRegularFile)
+                    .sorted()
+                    .forEach(path -> {
+                        try {
+                            result.put(root.relativize(path), Files.readString(path, StandardCharsets.UTF_8));
+                        } catch (IOException e) {
+                            throw new RuntimeException(e);
+                        }
+                    });
+        }
+        return result;
+    }
+
+    private void assertNoTransactionFiles() throws IOException {
+        try (Stream<Path> stream = Files.walk(tempDir)) {
+            assertThat(stream.filter(Files::isRegularFile).map(path -> path.getFileName().toString()))
+                    .allMatch(name -> name.endsWith(".tag")
+                            || name.endsWith(".jsp")
+                            || name.endsWith(".jsp.inc")
+                            || name.endsWith(".jte")
+                            || name.endsWith(".tld")
+                            || name.endsWith(".partial"));
+        }
+    }
+
+    private int countOccurrences(String text, String token) {
+        int count = 0;
+        for (int index = text.indexOf(token); index >= 0; index = text.indexOf(token, index + token.length())) {
+            count++;
+        }
+        return count;
+    }
+
+    private void assertNormalizedAbsolute(List<Path> paths) {
+        assertThat(paths).isNotEmpty();
+        for (Path path : paths) {
+            assertThat(path.isAbsolute()).isTrue();
+            assertThat(path).isEqualTo(path.normalize());
+        }
+    }
+
+    private List<String> suppressedMessages(Throwable failure) {
+        List<String> messages = new ArrayList<>();
+        collectSuppressedMessages(failure, messages);
+        return messages;
+    }
+
+    private void collectSuppressedMessages(Throwable failure, List<String> messages) {
+        for (Throwable suppressed : failure.getSuppressed()) {
+            if (suppressed.getMessage() != null) {
+                messages.add(suppressed.getMessage());
+            }
+            collectSuppressedMessages(suppressed, messages);
+        }
+    }
+
+    private static class TestConverter extends JspToJteConverter {
+        private final URL resourceBase;
+        private final Map<Path, String> readOverrides = new LinkedHashMap<>();
+        private String[] notConvertedTags;
+        private Function<String, String> outputName;
+
+        private TestConverter(Path jspRoot, Path jteRoot, URL resourceBase) {
+            super(jspRoot, jteRoot, "my:jte");
+            this.resourceBase = resourceBase;
+        }
+
+        @Override
+        protected URL getResourceBase() {
+            return resourceBase;
+        }
+
+        @Override
+        protected String readFile(Path path) {
+            return readOverrides.getOrDefault(path.toAbsolutePath().normalize(), super.readFile(path));
+        }
+
+        @Override
+        protected String[] getNotConvertedTags() {
+            return notConvertedTags;
+        }
+
+        @Override
+        public String suggestJteFile(String jspFile) {
+            return outputName == null ? super.suggestJteFile(jspFile) : outputName.apply(jspFile);
+        }
+    }
+}
