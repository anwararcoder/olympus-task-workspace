+    private boolean isReallyWithin(Path path, Path root) {
+        try {
+            return resolveWithExistingAncestors(path).startsWith(resolveWithExistingAncestors(root));
+        } catch (IOException e) {
+            throw new UncheckedIOException(e);
+        }
+    }
