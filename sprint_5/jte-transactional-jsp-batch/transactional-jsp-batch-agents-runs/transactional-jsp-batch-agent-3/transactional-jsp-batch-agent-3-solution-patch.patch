+    private List<Path> topologicalOrder(Map<Path, Set<Path>> dependencies) {
+        List<Path> result = new ArrayList<>(dependencies.size());
+        Set<Path> converted = new HashSet<>();
+        while (result.size() < dependencies.size()) {
+            Path next = null;
+            for (Map.Entry<Path, Set<Path>> entry : dependencies.entrySet()) {
+                if (!converted.contains(entry.getKey()) && converted.containsAll(entry.getValue())) {
+                    next = entry.getKey();
+                    break;
+                }
+            }
+            if (next == null) {
+                throw new IllegalArgumentException("Cyclic JSP tag dependency: " + formatCycle(dependencies, converted));
+            }
+            converted.add(next);
+            result.add(next);
+        }
+        return result;
+    }
+
+    private String formatCycle(Map<Path, Set<Path>> dependencies, Set<Path> converted) {
+        Path start = dependencies.keySet().stream().filter(path -> !converted.contains(path)).findFirst().orElseThrow();
+        List<Path> path = new ArrayList<>();
