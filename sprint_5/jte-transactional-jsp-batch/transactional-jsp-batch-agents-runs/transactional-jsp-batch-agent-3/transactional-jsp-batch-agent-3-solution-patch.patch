+    private List<Path> topologicalOrder(Map<Path, Set<Path>> dependencies) {
+        List<Path> result = new ArrayList<>(dependencies.size());
+        Set<Path> converted = new HashSet<>();
+        while (result.size() < dependencies.size()) {
+            Path next = null;
+            for (Map.Entry<Path, Set<Path>> entry : dependencies.entrySet()) {
+                if (!converted.contains(entry.getKey()) && converted.containsAll(entry.getValue())) {
+                    next = entry.getKey();
