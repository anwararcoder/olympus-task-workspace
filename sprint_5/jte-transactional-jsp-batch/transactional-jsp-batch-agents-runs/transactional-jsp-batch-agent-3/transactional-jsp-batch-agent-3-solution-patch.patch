+    @Test
+    void parserSetupFailureSurfacesUnchanged() throws IOException {
+        Path jspRoot = Files.createDirectories(tempDir.resolve("jsp"));
+        write(jspRoot.resolve("WEB-INF/tags/my/a.tag"), "A");
+        TestConverter converter = new TestConverter(jspRoot, tempDir.resolve("jte"));
+        RuntimeException expected = new RuntimeException("setup failed");
+
+        assertThat(catchThrowable(() -> converter.planTags(List.of("WEB-INF/tags/my/a.tag"), c -> { throw expected; }))).isSameAs(expected);
+    }
+
+    private Path write(Path path, String content) throws IOException {
+        Files.createDirectories(path.getParent());
+        Files.writeString(path, content, StandardCharsets.UTF_8);
+        return path.toAbsolutePath().normalize();
+    }
+
+    private static class TestConverter extends JspToJteConverter {
+        private final Path jspRoot;
+
+        private TestConverter(Path jspRoot, Path jteRoot) {
+            super(jspRoot, jteRoot, "my:jte");
+            this.jspRoot = jspRoot;
+        }
+
+        @Override
+        protected URL getResourceBase() {
+            try {
+                return jspRoot.toUri().toURL();
+            } catch (MalformedURLException e) {
+                throw new RuntimeException(e);
+            }
+        }
+
+        @Override
+        public String suggestJteFile(String jspFile) {
+            return super.suggestJteFile(jspFile.replace("WEB-INF/tags/", ""));
+        }
+    }
