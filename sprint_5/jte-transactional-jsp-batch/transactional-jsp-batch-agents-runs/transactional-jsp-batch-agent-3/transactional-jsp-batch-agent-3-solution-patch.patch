+    private Path resolveApprovedInclude(URL resourceBaseUrl, String include) {
+        if (include == null || include.isBlank()) {
+            throw new IllegalArgumentException("Approved include paths must not be null or blank.");
+        }
+        Path resourceBase;
+        try {
+            if (!"file".equalsIgnoreCase(resourceBaseUrl.getProtocol())) {
+                throw new IllegalArgumentException("Approved includes require a file resource base: " + resourceBaseUrl);
+            }
+            resourceBase = Paths.get(resourceBaseUrl.toURI()).toAbsolutePath().normalize();
+        } catch (URISyntaxException e) {
+            throw new IllegalArgumentException("Invalid resource base", e);
+        }
+        String rootRelative = include.replace('\\', '/');
+        while (rootRelative.startsWith("/")) {
+            rootRelative = rootRelative.substring(1);
+        }
+        Path resolved = resourceBase.resolve(rootRelative).toAbsolutePath().normalize();
+        if (!resolved.startsWith(jspRoot) || !isReallyWithin(resolved, jspRoot)) {
+            throw new IllegalArgumentException("Approved include is outside the JSP root: " + resolved);
+        }
+        return resolved;
+    }
