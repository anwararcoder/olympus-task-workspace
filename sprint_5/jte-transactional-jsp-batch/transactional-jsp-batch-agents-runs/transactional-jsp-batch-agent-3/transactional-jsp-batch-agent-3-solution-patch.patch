+package gg.jte.convert.jsp;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.LinkOption;
+import java.nio.file.Path;
+import java.nio.file.StandardOpenOption;
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeSet;
+
+public final class JspMigrationPlan {
+    private static final Comparator<Path> PATH_COMPARATOR = Comparator.comparing(Path::toString);
+
+    private final List<Path> conversionOrder;
+    private final Set<Path> deletes;
+    private final Map<Path, String> writes;
+    private final Map<Path, byte[]> snapshots;
+    private final Set<Path> generatedDestinations;
+    private boolean committed;
+
+    JspMigrationPlan(Collection<Path> conversionOrder, Collection<Path> deletes, Map<Path, String> writes,
+                     Map<Path, byte[]> snapshots, Collection<Path> generatedDestinations) {
+        this.conversionOrder = List.copyOf(conversionOrder);
+        this.deletes = immutablePathSet(deletes);
+        this.writes = immutableWrites(writes);
+        this.snapshots = copySnapshots(snapshots);
+        this.generatedDestinations = immutablePathSet(generatedDestinations);
+    }
+
+    public List<Path> getConversionOrder() {
+        return conversionOrder;
+    }
+
+    public Set<Path> getDeletes() {
+        return deletes;
+    }
+
+    public Map<Path, String> getWrites() {
+        return writes;
+    }
+
+    public synchronized void commit() throws IOException {
+        if (committed) {
+            throw new IllegalStateException("This JSP migration plan has already been committed.");
+        }
+
+        List<Path> changedPaths = findChangedPaths();
+        if (!changedPaths.isEmpty()) {
+            throw new StaleJspMigrationPlanException(changedPaths);
+        }
+
+        Set<Path> affectedPaths = new TreeSet<>(PATH_COMPARATOR);
+        affectedPaths.addAll(writes.keySet());
+        affectedPaths.addAll(deletes);
+        Map<Path, OriginalPath> originals = captureOriginals(affectedPaths);
+        List<Path> createdDirectories = new ArrayList<>();
+        Set<Path> mutatedPaths = new LinkedHashSet<>();
+
+        try {
+            for (Map.Entry<Path, String> write : writes.entrySet()) {
+                createParentDirectories(write.getKey(), createdDirectories);
+                mutatedPaths.add(write.getKey());
+                if (generatedDestinations.contains(write.getKey())) {
+                    Files.write(write.getKey(), write.getValue().getBytes(StandardCharsets.UTF_8), StandardOpenOption.CREATE_NEW, StandardOpenOption.WRITE);
+                } else {
+                    Files.write(write.getKey(), write.getValue().getBytes(StandardCharsets.UTF_8), StandardOpenOption.CREATE, StandardOpenOption.TRUNCATE_EXISTING, StandardOpenOption.WRITE);
+                }
+            }
+            for (Path delete : deletes) {
+                mutatedPaths.add(delete);
+                Files.delete(delete);
+            }
+            committed = true;
+        } catch (IOException failure) {
+            restore(originals, mutatedPaths, createdDirectories, failure);
+            throw failure;
+        }
+    }
+
+    private List<Path> findChangedPaths() throws IOException {
+        Set<Path> changed = new TreeSet<>(PATH_COMPARATOR);
+        for (Map.Entry<Path, byte[]> snapshot : snapshots.entrySet()) {
+            Path path = snapshot.getKey();
+            try {
+                if (Files.isSymbolicLink(path) || !Files.isRegularFile(path, LinkOption.NOFOLLOW_LINKS)
+                        || !java.util.Arrays.equals(snapshot.getValue(), Files.readAllBytes(path))) {
+                    changed.add(path);
+                }
+            } catch (IOException e) {
+                changed.add(path);
+            }
+        }
+        for (Path generatedDestination : generatedDestinations) {
+            if (Files.exists(generatedDestination, LinkOption.NOFOLLOW_LINKS)) {
+                changed.add(generatedDestination);
+            }
+        }
+        return List.copyOf(changed);
+    }
+
+    private Map<Path, OriginalPath> captureOriginals(Set<Path> affectedPaths) throws IOException {
+        Map<Path, OriginalPath> originals = new LinkedHashMap<>();
+        for (Path path : affectedPaths) {
+            if (Files.exists(path, LinkOption.NOFOLLOW_LINKS)) {
+                if (Files.isSymbolicLink(path) || !Files.isRegularFile(path, LinkOption.NOFOLLOW_LINKS)) {
+                    throw new IOException("Affected path is no longer a regular file: " + path);
+                }
+                originals.put(path, new OriginalPath(true, Files.readAllBytes(path)));
+            } else {
+                originals.put(path, new OriginalPath(false, null));
+            }
+        }
+        return originals;
+    }
+
+    private void createParentDirectories(Path path, List<Path> createdDirectories) throws IOException {
+        List<Path> missing = new ArrayList<>();
+        Path parent = path.getParent();
+        while (parent != null && !Files.exists(parent, LinkOption.NOFOLLOW_LINKS)) {
+            missing.add(parent);
+            parent = parent.getParent();
+        }
+        for (int i = missing.size() - 1; i >= 0; i--) {
+            Path directory = missing.get(i);
+            Files.createDirectory(directory);
+            createdDirectories.add(directory);
+        }
+    }
+
+    private void restore(Map<Path, OriginalPath> originals, Set<Path> mutatedPaths, List<Path> createdDirectories, IOException failure) {
+        List<Path> reverseMutations = new ArrayList<>(mutatedPaths);
+        for (int i = reverseMutations.size() - 1; i >= 0; i--) {
+            Path path = reverseMutations.get(i);
+            OriginalPath original = originals.get(path);
+            try {
+                if (original.existed) {
+                    Files.write(path, original.content, StandardOpenOption.CREATE, StandardOpenOption.TRUNCATE_EXISTING, StandardOpenOption.WRITE);
+                } else {
+                    Files.deleteIfExists(path);
+                }
+            } catch (IOException restorationFailure) {
+                failure.addSuppressed(restorationFailure);
+            }
+        }
+        for (int i = createdDirectories.size() - 1; i >= 0; i--) {
+            try {
+                Files.deleteIfExists(createdDirectories.get(i));
+            } catch (IOException restorationFailure) {
+                failure.addSuppressed(restorationFailure);
+            }
+        }
+    }
+
+    private static Set<Path> immutablePathSet(Collection<Path> paths) {
+        Set<Path> sorted = new TreeSet<>(PATH_COMPARATOR);
+        sorted.addAll(paths);
+        return java.util.Collections.unmodifiableSet(sorted);
+    }
+
+    private static Map<Path, String> immutableWrites(Map<Path, String> writes) {
+        Map<Path, String> sorted = new java.util.TreeMap<>(PATH_COMPARATOR);
+        sorted.putAll(writes);
+        return java.util.Collections.unmodifiableMap(sorted);
+    }
+
+    private static Map<Path, byte[]> copySnapshots(Map<Path, byte[]> snapshots) {
+        Map<Path, byte[]> result = new java.util.TreeMap<>(PATH_COMPARATOR);
+        snapshots.forEach((path, content) -> result.put(path, content.clone()));
+        return java.util.Collections.unmodifiableMap(result);
+    }
+
+    private static final class OriginalPath {
+        private final boolean existed;
+        private final byte[] content;
+
+        private OriginalPath(boolean existed, byte[] content) {
+            this.existed = existed;
+            this.content = content;
+        }
+    }
+}
