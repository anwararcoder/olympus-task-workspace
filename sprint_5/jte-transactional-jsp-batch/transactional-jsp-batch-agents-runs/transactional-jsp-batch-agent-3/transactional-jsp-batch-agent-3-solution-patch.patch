+    private String formatCycle(Map<Path, Set<Path>> dependencies, Set<Path> converted) {
+        Path start = dependencies.keySet().stream().filter(path -> !converted.contains(path)).findFirst().orElseThrow();
+        List<Path> path = new ArrayList<>();
+        Map<Path, Integer> indexes = new HashMap<>();
+        Path current = start;
+        while (!indexes.containsKey(current)) {
+            indexes.put(current, path.size());
+            path.add(current);
+            current = dependencies.get(current).stream()
+                    .filter(dependency -> !converted.contains(dependency))
+                    .findFirst()
+                    .orElseThrow();
+        }
+        List<Path> cycle = new ArrayList<>(path.subList(indexes.get(current), path.size()));
+        cycle.add(current);
+        List<String> portable = new ArrayList<>(cycle.size());
+        for (Path element : cycle) {
+            portable.add(toPortablePath(element));
+        }
