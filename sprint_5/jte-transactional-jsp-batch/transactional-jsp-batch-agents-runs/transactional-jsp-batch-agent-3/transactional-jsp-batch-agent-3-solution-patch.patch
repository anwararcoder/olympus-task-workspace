+    @Test
+    void stalePlanReportsAllChangedPathsWithoutMutation() throws IOException {
+        Path jspRoot = Files.createDirectories(tempDir.resolve("jsp"));
+        Path jteRoot = tempDir.resolve("jte");
+        Path tag = write(jspRoot.resolve("WEB-INF/tags/my/a.tag"), "A");
+        Path usage = write(jspRoot.resolve("usage.jsp"), "<my:a/>");
+        TestConverter converter = new TestConverter(jspRoot, jteRoot);
+        JspMigrationPlan plan = converter.planTags(List.of("WEB-INF/tags/my/a.tag"), null);
+        Files.writeString(tag, "changed", StandardCharsets.UTF_8);
+        Files.writeString(usage, "changed usage", StandardCharsets.UTF_8);
+        Path destination = jteRoot.resolve("my/a.jte");
+        write(destination, "occupied");
+
+        Throwable throwable = catchThrowable(plan::commit);
+
+        assertThat(throwable).isInstanceOf(StaleJspMigrationPlanException.class);
+        assertThat(((StaleJspMigrationPlanException) throwable).getChangedPaths()).containsExactly(tag, usage, destination);
+        assertThat(tag).hasContent("changed");
+        assertThat(usage).hasContent("changed usage");
+        assertThat(destination).hasContent("occupied");
+    }
