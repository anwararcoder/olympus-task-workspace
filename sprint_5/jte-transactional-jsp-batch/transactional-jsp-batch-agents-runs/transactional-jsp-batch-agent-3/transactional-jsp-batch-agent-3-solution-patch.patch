+        }
+        for (String include : converter.getEncounteredInlinedIncludes()) {
+            Path includePath = resolveApprovedInclude(converter.getResourceBase(), include);
+            if (Files.isSymbolicLink(includePath) || !Files.isRegularFile(includePath, LinkOption.NOFOLLOW_LINKS)) {
+                throw new IllegalArgumentException("Approved include is missing or not a regular file: " + includePath);
