+    @Test
+    void rollsBackWritesAndCreatedDirectoriesAfterIoFailure() throws IOException {
+        Path jspRoot = Files.createDirectories(tempDir.resolve("jsp"));
+        Path jteRoot = tempDir.resolve("jte");
+        Path first = write(jspRoot.resolve("WEB-INF/tags/my/a.tag"), "A");
+        Path second = write(jspRoot.resolve("WEB-INF/tags/my/b.tag"), "B");
+        TestConverter converter = new TestConverter(jspRoot, jteRoot) {
+            @Override
+            public String suggestJteFile(String jspFile) {
+                return jspFile.endsWith("a.tag") ? "a.jte" : "blocked/b.jte";
+            }
+        };
+        JspMigrationPlan plan = converter.planTags(List.of("WEB-INF/tags/my/a.tag", "WEB-INF/tags/my/b.tag"), null);
+        Path blockingFile = write(jteRoot.resolve("blocked"), "unrelated");
+
+        assertThatThrownBy(plan::commit).isInstanceOf(IOException.class);
+
+        assertThat(first).hasContent("A");
+        assertThat(second).hasContent("B");
+        assertThat(jteRoot.resolve("a.jte")).doesNotExist();
+        assertThat(blockingFile).hasContent("unrelated");
+    }
