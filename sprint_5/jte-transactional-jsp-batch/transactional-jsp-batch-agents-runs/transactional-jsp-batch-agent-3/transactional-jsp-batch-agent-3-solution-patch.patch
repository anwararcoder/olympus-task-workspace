+        assertThat(plan.getWrites().get(jteRoot.resolve("my/a.jte"))).contains("@template.my.b(\n  value = name,\n  bodyContent = @`Hi ${name}`\n)", "A").doesNotContain("<my:b");
+        assertThat(Files.readString(usage)).isEqualTo("<my:a/><my:b/>");
+        assertThat(jteRoot).doesNotExist();
+        assertThatThrownBy(() -> plan.getWrites().put(usage, "changed")).isInstanceOf(UnsupportedOperationException.class);
+
+        plan.commit();
+
+        assertThat(jspRoot.resolve("WEB-INF/tags/my/a.tag")).doesNotExist();
+        assertThat(jspRoot.resolve("WEB-INF/tags/my/b.tag")).doesNotExist();
+        assertThat(jteRoot.resolve("my/a.jte")).hasContent(plan.getWrites().get(jteRoot.resolve("my/a.jte")));
+        assertThat(usage).hasContent(plan.getWrites().get(usage));
+        assertThatThrownBy(plan::commit).isInstanceOf(IllegalStateException.class);
