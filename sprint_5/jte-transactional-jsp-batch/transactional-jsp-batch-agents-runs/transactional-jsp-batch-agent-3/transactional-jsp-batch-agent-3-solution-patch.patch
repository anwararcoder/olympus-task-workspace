+    private Map<Path, Path> validateDestinations(Map<Path, String> selectedRelativePaths) {
+        Map<Path, Path> result = new TreeMap<>(PATH_COMPARATOR);
+        Set<Path> seen = new HashSet<>();
+        for (Map.Entry<Path, String> selected : selectedRelativePaths.entrySet()) {
+            String suggested = suggestJteFile(selected.getValue());
+            if (suggested == null || suggested.isBlank()) {
+                throw new IllegalArgumentException("Generated JTE destination must not be null or blank for " + selected.getKey());
+            }
+            Path suggestedPath = Paths.get(suggested);
+            Path destination = jteRoot.resolve(suggestedPath).toAbsolutePath().normalize();
+            if (suggestedPath.isAbsolute() || !destination.startsWith(jteRoot) || !isReallyWithin(destination, jteRoot)) {
+                throw new IllegalArgumentException("Generated JTE destination is outside the JTE root: " + destination);
+            }
+            if (!seen.add(destination)) {
+                throw new IllegalArgumentException("Generated JTE destinations collide at " + destination);
+            }
+            if (Files.exists(destination, LinkOption.NOFOLLOW_LINKS)) {
+                throw new IllegalArgumentException("Generated JTE destination is already taken: " + destination);
