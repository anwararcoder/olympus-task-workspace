+        JspMigrationPlan plan = new ResourceBasedConverter(webRoot, jteRoot)
+                .planTags(List.of("WEB-INF/tags/my/second.tag", "WEB-INF/tags/my/first.tag"),
+                        converter -> converter.addInlinedInclude("/WEB-INF/include.jsp.inc"));
+
+        assertThat(plan.getConversionOrder()).containsExactly(
+                first.toAbsolutePath().normalize(), second.toAbsolutePath().normalize());
+    }
+
+    @Test
+    void reportsDeterministicClosedDependencyCycle() throws IOException {
+        Path webRoot = Files.createDirectories(tempDir.resolve("web"));
+        Path jteRoot = tempDir.resolve("jte");
+        write(webRoot.resolve("WEB-INF/tld/my.tld"), tld());
+        write(webRoot.resolve("WEB-INF/tags/my/first.tag"), tagHeader() + "<my:second/>");
+        write(webRoot.resolve("WEB-INF/tags/my/second.tag"), tagHeader() + "<my:first/>");
+
+        assertThatThrownBy(() -> new ResourceBasedConverter(webRoot, jteRoot)
+                .planTags(List.of("WEB-INF/tags/my/second.tag", "WEB-INF/tags/my/first.tag"), null))
+                .isInstanceOf(IllegalArgumentException.class)
+                .hasMessage("Cyclic JSP tag dependency: WEB-INF/tags/my/first.tag -> WEB-INF/tags/my/second.tag -> WEB-INF/tags/my/first.tag");
+    }
+
+    @Test
+    void surfacesParserSetupFailureUnchanged() throws IOException {
+        Path jspRoot = Files.createDirectories(tempDir.resolve("jsp"));
+        Path jteRoot = tempDir.resolve("jte");
+        write(jspRoot.resolve("my/simple.tag"), "<p>Hello</p>");
+        IllegalStateException expected = new IllegalStateException("setup failed");
+
+        Throwable actual = catchThrowable(() -> new JspToJteConverter(jspRoot, jteRoot, "my:jte")
+                .planTags(List.of("my/simple.tag"), converter -> {
+                    throw expected;
+                }));
+
+        assertThat(actual).isSameAs(expected);
+    }
+
+    @Test
+    void ignoresTagLookingTextInJspComments() throws IOException {
+        Path jspRoot = Files.createDirectories(tempDir.resolve("jsp"));
+        Path jteRoot = tempDir.resolve("jte");
+        write(jspRoot.resolve("my/simple.tag"), "<%-- <other:missing/> --%><p>Hello</p>");
+
+        JspMigrationPlan plan = new JspToJteConverter(jspRoot, jteRoot, "my:jte")
+                .planTags(List.of("my/simple.tag"), null);
+
+        assertThat(plan.getWrites()).hasSize(1);
+    }
+
+    private Path write(Path path, String content) throws IOException {
+        Files.createDirectories(path.getParent());
+        return Files.writeString(path, content);
+    }
+
+    private String tagHeader() {
+        return "<%@ taglib uri=\"urn:my\" prefix=\"my\" %>\n";
+    }
+
+    private String tld() {
+        return """
+                <?xml version="1.0" encoding="UTF-8" ?>
+                <taglib xmlns="http://java.sun.com/xml/ns/j2ee" version="2.0">
+                  <tlib-version>1.0</tlib-version>
+                  <short-name>my</short-name>
+                  <uri>urn:my</uri>
+                  <tag-file><name>first</name><path>/WEB-INF/tags/my/first.tag</path></tag-file>
+                  <tag-file><name>second</name><path>/WEB-INF/tags/my/second.tag</path></tag-file>
+                  <tag>
+                    <name>jte</name>
+                    <tag-class>example.JteTag</tag-class>
+                    <body-content>scriptless</body-content>
+                    <attribute><name>jte</name><required>true</required><rtexprvalue>true</rtexprvalue></attribute>
+                    <dynamic-attributes>true</dynamic-attributes>
+                  </tag>
+                </taglib>
+                """;
+    }
+
+    private static class ResourceBasedConverter extends JspToJteConverter {
+        private final Path resourceBase;
+
+        private ResourceBasedConverter(Path jspRoot, Path jteRoot) {
+            super(jspRoot, jteRoot, "my:jte");
+            resourceBase = jspRoot;
+        }
+
+        @Override
+        protected URL getResourceBase() {
+            try {
+                return resourceBase.toUri().toURL();
+            } catch (IOException e) {
+                throw new RuntimeException(e);
+            }
+        }
+    }
+}
