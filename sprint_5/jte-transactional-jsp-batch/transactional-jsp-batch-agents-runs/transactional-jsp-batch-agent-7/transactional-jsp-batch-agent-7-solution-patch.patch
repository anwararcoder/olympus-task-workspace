+    @Test
+    void plansAndCommitsWithoutMutatingDuringPlanning() throws IOException {
+        Path jspRoot = Files.createDirectories(tempDir.resolve("jsp"));
+        Path jteRoot = tempDir.resolve("jte");
+        Path tag = write(jspRoot.resolve("my/simple.tag"), "<p>Hello</p>");
+        Path usage = write(jspRoot.resolve("usage.jsp"), "<my:simple/>");
+        Path unrelated = write(jspRoot.resolve("unrelated.txt"), "unchanged");
+
+        JspMigrationPlan plan = new JspToJteConverter(jspRoot, jteRoot, "my:jte")
+                .planTags(List.of("my/simple.tag"), converter -> converter.setPrefix("@import example.SimpleBean\n"));
+
+        Path destination = jteRoot.resolve("my/simple.jte").toAbsolutePath().normalize();
+        assertThat(plan.getConversionOrder()).containsExactly(tag.toAbsolutePath().normalize());
+        assertThat(plan.getDeletes()).containsExactly(tag.toAbsolutePath().normalize());
+        assertThat(plan.getWrites()).containsKeys(destination, usage.toAbsolutePath().normalize());
+        assertThat(plan.getWrites().get(destination)).startsWith("@import example.SimpleBean");
+        assertThat(tag).exists();
+        assertThat(destination).doesNotExist();
+        assertThat(usage).hasContent("<my:simple/>");
+        assertThatThrownBy(() -> plan.getWrites().put(destination, "changed")).isInstanceOf(UnsupportedOperationException.class);
+        assertThatThrownBy(() -> plan.getDeletes().clear()).isInstanceOf(UnsupportedOperationException.class);
+        assertThatThrownBy(() -> plan.getConversionOrder().clear()).isInstanceOf(UnsupportedOperationException.class);
+
+        plan.commit();
+
+        assertThat(tag).doesNotExist();
+        assertThat(destination).hasContent(plan.getWrites().get(destination));
+        assertThat(usage).hasContent("<my:jte jte=\"my/simple.jte\"/>");
+        assertThat(unrelated).hasContent("unchanged");
+        assertThatThrownBy(plan::commit).isInstanceOf(IllegalStateException.class);
+    }
