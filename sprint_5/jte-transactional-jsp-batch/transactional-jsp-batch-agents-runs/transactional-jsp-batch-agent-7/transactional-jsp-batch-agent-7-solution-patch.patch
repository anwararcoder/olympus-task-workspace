+package gg.jte.convert.jsp;
+
+import java.io.IOException;
+import java.nio.ByteBuffer;
+import java.nio.channels.SeekableByteChannel;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.LinkOption;
+import java.nio.file.Path;
+import java.nio.file.StandardOpenOption;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeSet;
+
+public final class JspMigrationPlan {
+    private final List<Path> conversionOrder;
+    private final Set<Path> deletes;
+    private final Map<Path, String> writes;
+    private final Map<Path, byte[]> snapshots;
+    private final Set<Path> generatedDestinations;
+    private boolean committed;
+
+    JspMigrationPlan(List<Path> conversionOrder, Set<Path> deletes, Map<Path, String> writes,
+                     Map<Path, byte[]> snapshots, Set<Path> generatedDestinations) {
+        this.conversionOrder = List.copyOf(conversionOrder);
+        this.deletes = Collections.unmodifiableSet(new LinkedHashSet<>(deletes));
+        this.writes = Collections.unmodifiableMap(new LinkedHashMap<>(writes));
+        this.snapshots = copyBytes(snapshots);
+        this.generatedDestinations = Set.copyOf(generatedDestinations);
+    }
+
+    public List<Path> getConversionOrder() {
+        return conversionOrder;
+    }
+
+    public Set<Path> getDeletes() {
+        return deletes;
+    }
+
+    public Map<Path, String> getWrites() {
+        return writes;
+    }
+
+    public synchronized void commit() throws IOException {
+        if (committed) {
+            throw new IllegalStateException("This JSP migration plan has already been committed.");
+        }
+
+        List<Path> changedPaths = findChangedPaths();
+        if (!changedPaths.isEmpty()) {
+            throw new StaleJspMigrationPlanException(changedPaths);
+        }
+
+        Map<Path, byte[]> originals = new LinkedHashMap<>();
+        Set<Path> originallyAbsent = new LinkedHashSet<>();
+        for (Path path : affectedPaths()) {
+            if (Files.exists(path, LinkOption.NOFOLLOW_LINKS)) {
+                originals.put(path, Files.readAllBytes(path));
+            } else {
+                originallyAbsent.add(path);
+            }
+        }
+
+        Set<Path> mutatedPaths = new LinkedHashSet<>();
+        Set<Path> createdDirectories = new LinkedHashSet<>();
+        try {
+            for (Map.Entry<Path, String> write : writes.entrySet()) {
+                createParentDirectories(write.getKey(), createdDirectories);
+                write(write.getKey(), write.getValue().getBytes(StandardCharsets.UTF_8),
+                        generatedDestinations.contains(write.getKey()), mutatedPaths);
+            }
+            for (Path delete : deletes) {
+                mutatedPaths.add(delete);
+                Files.delete(delete);
+            }
+            committed = true;
+        } catch (IOException failure) {
+            restore(originals, originallyAbsent, mutatedPaths, createdDirectories, failure);
+            throw failure;
+        }
+    }
+
+    private List<Path> findChangedPaths() {
+        Set<Path> changed = new TreeSet<>(Comparator.comparing(Path::toString));
+        for (Map.Entry<Path, byte[]> snapshot : snapshots.entrySet()) {
+            try {
+                if (!Files.isRegularFile(snapshot.getKey()) ||
+                        !Arrays.equals(snapshot.getValue(), Files.readAllBytes(snapshot.getKey()))) {
+                    changed.add(snapshot.getKey());
+                }
+            } catch (IOException e) {
+                changed.add(snapshot.getKey());
+            }
+        }
+        for (Path destination : generatedDestinations) {
+            if (Files.exists(destination, LinkOption.NOFOLLOW_LINKS)) {
+                changed.add(destination);
+            }
+        }
+        return List.copyOf(changed);
+    }
+
+    private Set<Path> affectedPaths() {
+        Set<Path> result = new LinkedHashSet<>(writes.keySet());
+        result.addAll(deletes);
+        return result;
+    }
+
+    private static void createParentDirectories(Path path, Set<Path> createdDirectories) throws IOException {
+        List<Path> missing = new ArrayList<>();
+        Path parent = path.getParent();
+        while (parent != null && !Files.exists(parent, LinkOption.NOFOLLOW_LINKS)) {
+            missing.add(parent);
+            parent = parent.getParent();
+        }
+        createdDirectories.addAll(missing);
+        Files.createDirectories(path.getParent());
+    }
+
+    private static void write(Path path, byte[] content, boolean createNew, Set<Path> mutatedPaths) throws IOException {
+        Set<StandardOpenOption> options = createNew
+                ? Set.of(StandardOpenOption.CREATE_NEW, StandardOpenOption.WRITE)
+                : Set.of(StandardOpenOption.WRITE, StandardOpenOption.TRUNCATE_EXISTING);
+        try (SeekableByteChannel channel = Files.newByteChannel(path, options)) {
+            mutatedPaths.add(path);
+            ByteBuffer buffer = ByteBuffer.wrap(content);
+            while (buffer.hasRemaining()) {
+                channel.write(buffer);
+            }
+        }
+    }
+
+    private static void restore(Map<Path, byte[]> originals, Set<Path> originallyAbsent, Set<Path> mutatedPaths,
+                                Set<Path> createdDirectories, IOException failure) {
+        List<Path> paths = new ArrayList<>(mutatedPaths);
+        Collections.reverse(paths);
+        for (Path path : paths) {
+            try {
+                byte[] original = originals.get(path);
+                if (original != null) {
+                    Files.write(path, original, StandardOpenOption.CREATE, StandardOpenOption.WRITE, StandardOpenOption.TRUNCATE_EXISTING);
+                } else if (originallyAbsent.contains(path)) {
+                    Files.deleteIfExists(path);
+                }
+            } catch (IOException restorationFailure) {
+                failure.addSuppressed(restorationFailure);
+            }
+        }
+
+        List<Path> directories = new ArrayList<>(createdDirectories);
+        directories.sort(Comparator.comparingInt(Path::getNameCount).reversed());
+        for (Path directory : directories) {
+            try {
+                Files.deleteIfExists(directory);
+            } catch (IOException restorationFailure) {
+                failure.addSuppressed(restorationFailure);
+            }
+        }
+    }
+
+    private static Map<Path, byte[]> copyBytes(Map<Path, byte[]> source) {
+        Map<Path, byte[]> result = new LinkedHashMap<>();
+        source.forEach((path, bytes) -> result.put(path, bytes.clone()));
+        return Collections.unmodifiableMap(result);
+    }
+}
