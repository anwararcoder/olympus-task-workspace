+package gg.jte.convert.jsp;
+
+import java.io.IOException;
+import java.nio.file.FileAlreadyExistsException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardOpenOption;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeSet;
+
+import static java.nio.file.LinkOption.NOFOLLOW_LINKS;
+
+public final class JspMigrationPlan {
+    private static final Comparator<Path> PATH_ORDER = Comparator.comparing(Path::toString);
+
+    private final List<Path> conversionOrder;
+    private final Set<Path> deletes;
+    private final Map<Path, String> writes;
+    private final Map<Path, byte[]> snapshots;
+    private final Set<Path> symbolicLinkSnapshots;
+    private final Set<Path> generatedDestinations;
+    private boolean committed;
+
+    JspMigrationPlan(List<Path> conversionOrder, Set<Path> deletes, Map<Path, String> writes,
+                     Map<Path, byte[]> snapshots, Set<Path> symbolicLinkSnapshots, Set<Path> generatedDestinations) {
+        this.conversionOrder = List.copyOf(conversionOrder);
+        this.deletes = Collections.unmodifiableSet(new LinkedHashSet<>(deletes));
+        this.writes = Collections.unmodifiableMap(new LinkedHashMap<>(writes));
+        Map<Path, byte[]> snapshotCopies = new LinkedHashMap<>();
+        snapshots.forEach((path, bytes) -> snapshotCopies.put(path, bytes.clone()));
+        this.snapshots = Collections.unmodifiableMap(snapshotCopies);
+        this.symbolicLinkSnapshots = Set.copyOf(symbolicLinkSnapshots);
+        this.generatedDestinations = Set.copyOf(generatedDestinations);
+    }
+
+    public List<Path> getConversionOrder() {
+        return conversionOrder;
+    }
+
+    public Set<Path> getDeletes() {
+        return deletes;
+    }
+
+    public Map<Path, String> getWrites() {
+        return writes;
+    }
+
+    public synchronized void commit() throws IOException {
+        if (committed) {
+            throw new IllegalStateException("JSP migration plan has already been committed.");
+        }
+
+        List<Path> changedPaths = findChangedPaths();
+        if (!changedPaths.isEmpty()) {
+            throw new StaleJspMigrationPlanException(changedPaths);
+        }
+
+        Map<Path, byte[]> originals = new LinkedHashMap<>();
+        Set<Path> affectedPaths = new TreeSet<>(PATH_ORDER);
+        affectedPaths.addAll(writes.keySet());
+        affectedPaths.addAll(deletes);
+        for (Path path : affectedPaths) {
+            originals.put(path, Files.exists(path, NOFOLLOW_LINKS) ? Files.readAllBytes(path) : null);
+        }
+
+        List<Path> createdDirectories = new ArrayList<>();
+        boolean mutationStarted = false;
+        try {
+            for (Map.Entry<Path, String> write : writes.entrySet()) {
+                mutationStarted = true;
+                createParentDirectories(write.getKey(), createdDirectories);
+                Files.writeString(write.getKey(), write.getValue(), StandardOpenOption.CREATE, StandardOpenOption.TRUNCATE_EXISTING);
+            }
+            for (Path delete : deletes) {
+                mutationStarted = true;
+                Files.delete(delete);
+            }
+            committed = true;
+        } catch (IOException failure) {
+            if (mutationStarted) {
+                restore(originals, createdDirectories, failure);
+            }
+            throw failure;
+        }
+    }
+
+    private List<Path> findChangedPaths() throws IOException {
+        Set<Path> changed = new TreeSet<>(PATH_ORDER);
+        for (Map.Entry<Path, byte[]> snapshot : snapshots.entrySet()) {
+            Path path = snapshot.getKey();
+            boolean expectedSymbolicLink = symbolicLinkSnapshots.contains(path);
+            if (!Files.isRegularFile(path)
+                    || Files.isSymbolicLink(path) != expectedSymbolicLink
+                    || !Arrays.equals(snapshot.getValue(), Files.readAllBytes(path))) {
+                changed.add(path);
+            }
+        }
+        for (Path destination : generatedDestinations) {
+            if (Files.exists(destination, NOFOLLOW_LINKS)) {
+                changed.add(destination);
+            }
+        }
+        return List.copyOf(changed);
+    }
+
+    private static void createParentDirectories(Path path, List<Path> createdDirectories) throws IOException {
+        List<Path> missing = new ArrayList<>();
+        Path parent = path.getParent();
+        while (parent != null && !Files.exists(parent, NOFOLLOW_LINKS)) {
+            missing.add(parent);
+            parent = parent.getParent();
+        }
+        for (int i = missing.size() - 1; i >= 0; i--) {
+            Path directory = missing.get(i);
+            try {
+                Files.createDirectory(directory);
+                createdDirectories.add(directory);
+            } catch (FileAlreadyExistsException e) {
+                if (!Files.isDirectory(directory, NOFOLLOW_LINKS)) {
+                    throw e;
+                }
+            }
+        }
+    }
+
+    private static void restore(Map<Path, byte[]> originals, List<Path> createdDirectories, IOException failure) {
+        List<Map.Entry<Path, byte[]>> paths = new ArrayList<>(originals.entrySet());
+        Collections.reverse(paths);
+        for (Map.Entry<Path, byte[]> original : paths) {
+            try {
+                if (original.getValue() == null) {
+                    Files.deleteIfExists(original.getKey());
+                } else {
+                    Files.write(original.getKey(), original.getValue(), StandardOpenOption.CREATE, StandardOpenOption.TRUNCATE_EXISTING);
+                }
+            } catch (IOException restoreFailure) {
+                failure.addSuppressed(restoreFailure);
+            }
+        }
+        Collections.reverse(createdDirectories);
+        for (Path directory : createdDirectories) {
+            try {
+                Files.deleteIfExists(directory);
+            } catch (IOException restoreFailure) {
+                failure.addSuppressed(restoreFailure);
+            }
+        }
+    }
+}
