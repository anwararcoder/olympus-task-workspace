+package gg.jte.convert.jsp;
+
+import gg.jte.convert.ConverterOutput;
+import gg.jte.convert.CustomTagConverter;
+import gg.jte.convert.jsp.converter.JspNoopConverter;
+import org.apache.jasper.JasperException;
+import org.apache.jasper.compiler.JtpConverter;
+import org.apache.jasper.compiler.JtpCustomTag;
+import org.xml.sax.Attributes;
+
+import java.io.IOException;
+import java.io.UncheckedIOException;
+import java.net.URI;
+import java.net.URISyntaxException;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.EnumSet;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeMap;
+import java.util.TreeSet;
+import java.util.function.Consumer;
+import java.util.stream.Stream;
+
+import static java.nio.file.LinkOption.NOFOLLOW_LINKS;
+import static gg.jte.convert.jsp.converter.JspExpressionConverter.convertAttributeValue;
+
+final class JspMigrationPlanner {
+    private static final Comparator<Path> PATH_ORDER = Comparator.comparing(path -> path.toString().replace('\\', '/'));
+
+    private final JspToJteConverter owner;
+    private final Path jspRoot;
+    private final Path jteRoot;
+
+    JspMigrationPlanner(JspToJteConverter owner) {
+        this.owner = owner;
+        this.jspRoot = owner.getJspRoot().toAbsolutePath().normalize();
+        this.jteRoot = owner.getJteRoot().toAbsolutePath().normalize();
+    }
+
+    JspMigrationPlan plan(Collection<String> requestedTags, Consumer<Converter> parserSetup) {
+        Map<Path, Path> selected = validateSelected(requestedTags);
+        Map<String, Path> invocations = selectedInvocations(selected.keySet());
+        Map<Path, Path> destinations = validateDestinations(selected);
+        Map<Path, byte[]> snapshots = scanUsageFiles();
+        Set<Path> symbolicLinkSnapshots = new HashSet<>();
+        selected.keySet().forEach(path -> snapshots.computeIfAbsent(path, this::readBytes));
+
+        Map<Path, TagState> states = new TreeMap<>(PATH_ORDER);
+        for (Path selectedPath : selected.keySet()) {
+            TagState state = discover(selectedPath, invocations, parserSetup);
+            states.put(selectedPath, state);
+            for (String include : state.setup.includes) {
+                Path includePath = resolveInclude(include);
+                snapshots.computeIfAbsent(includePath, this::readBytes);
+                if (Files.isSymbolicLink(includePath)) {
+                    symbolicLinkSnapshots.add(includePath);
+                }
+            }
+        }
+
+        List<Path> relativeOrder = conversionOrder(states);
+        Map<Path, String> virtualUsageFiles = new TreeMap<>(PATH_ORDER);
+        snapshots.forEach((path, bytes) -> {
+            if (isUsageFile(path)) {
+                virtualUsageFiles.put(path, new String(bytes, StandardCharsets.UTF_8));
+            }
+        });
+        Map<Path, String> conversionSources = new HashMap<>();
+        selected.keySet().forEach(path -> conversionSources.put(path, owner.readFile(path)));
+
+        Map<Path, String> writes = new TreeMap<>(PATH_ORDER);
+        Map<String, String> convertedInvocations = new HashMap<>();
+        for (Path selectedPath : relativeOrder) {
+            TagState state = states.get(selectedPath);
+            String relativeName = relativeName(selectedPath);
+            JtpConverter converter = owner.createConverter(relativeName, conversionSources.get(selectedPath));
+            owner.registerConverters(converter, state.notConvertedTags);
+            state.setup.replay(converter);
+            convertedInvocations.forEach((tagName, destination) -> converter.register(tagName, new MigratedTagConverter(destination)));
+
+            String jte = converter.convert();
+            owner.checkDependencies(jte);
+            writes.put(destinations.get(selectedPath), jte);
+
+            String invocation = invocationName(selectedPath);
+            String destination = jteRoot.relativize(destinations.get(selectedPath)).toString().replace('\\', '/');
+            convertedInvocations.put(invocation, destination);
+            replaceUsages(virtualUsageFiles, selectedPath, destination);
+        }
+
+        Set<Path> deletes = new TreeSet<>(PATH_ORDER);
+        deletes.addAll(selected.keySet());
+        virtualUsageFiles.forEach((path, content) -> {
+            byte[] original = snapshots.get(path);
+            if (!deletes.contains(path) && !java.util.Arrays.equals(original, content.getBytes(StandardCharsets.UTF_8))) {
+                writes.put(path, content);
+            }
+        });
+
+        List<Path> absoluteOrder = new ArrayList<>();
+        relativeOrder.forEach(path -> absoluteOrder.add(path.toAbsolutePath().normalize()));
+        return new JspMigrationPlan(absoluteOrder, deletes, writes, snapshots, symbolicLinkSnapshots,
+                new LinkedHashSet<>(destinations.values()));
+    }
+
+    private Map<Path, Path> validateSelected(Collection<String> requestedTags) {
+        if (requestedTags == null || requestedTags.isEmpty()) {
+            throw new IllegalArgumentException("At least one JSP tag is required.");
+        }
+        Map<Path, Path> selected = new TreeMap<>(PATH_ORDER);
+        for (String requestedTag : requestedTags) {
+            if (requestedTag == null || requestedTag.isBlank()) {
+                throw new IllegalArgumentException("JSP tag paths must not be null or blank.");
+            }
+            Path relative = Path.of(requestedTag);
+            if (relative.isAbsolute()) {
+                throw new IllegalArgumentException("JSP tag paths must be root-relative: " + requestedTag);
+            }
+            relative = relative.normalize();
+            Path absolute = jspRoot.resolve(relative).normalize();
+            if (!absolute.startsWith(jspRoot)) {
+                throw new IllegalArgumentException("JSP tag path is outside the JSP root: " + requestedTag);
+            }
+            if (!relative.toString().replace('\\', '/').endsWith(".tag")) {
+                throw new IllegalArgumentException("JSP tag path must end in .tag: " + requestedTag);
+            }
+            if (selected.putIfAbsent(absolute, relative) != null) {
+                throw new IllegalArgumentException("Duplicate JSP tag path: " + requestedTag);
+            }
+            if (Files.isSymbolicLink(absolute)) {
+                throw new IllegalArgumentException("Selected JSP tag must not be a symbolic link: " + requestedTag);
+            }
+            if (!Files.isRegularFile(absolute, NOFOLLOW_LINKS)) {
+                throw new IllegalArgumentException("Selected JSP tag is missing or not a regular file: " + requestedTag);
+            }
+            try {
+                if (!absolute.toRealPath().startsWith(jspRoot.toRealPath())) {
+                    throw new IllegalArgumentException("JSP tag path is outside the JSP root: " + requestedTag);
+                }
+            } catch (IOException e) {
+                throw new IllegalArgumentException("Could not resolve JSP tag path: " + requestedTag, e);
+            }
+        }
+        return selected;
+    }
+
+    private Map<String, Path> selectedInvocations(Set<Path> selectedPaths) {
+        Map<String, Path> result = new HashMap<>();
+        for (Path path : selectedPaths) {
+            String invocation = invocationName(path);
+            Path previous = result.putIfAbsent(invocation, path);
+            if (previous != null) {
+                throw new IllegalArgumentException("Ambiguous selected invocation name " + invocation + ": " + previous + " and " + path);
+            }
+        }
+        return result;
+    }
+
+    private void validateDestinationAncestors(Path destination) {
+        Path existing = destination.getParent();
+        while (existing != null && !Files.exists(existing, NOFOLLOW_LINKS)) {
+            existing = existing.getParent();
+        }
+        if (existing == null) {
+            return;
+        }
+        try {
+            Path rootBoundary = projectedRealPath(jteRoot);
+            Path resolvedParent = projectedRealPath(destination.getParent());
+            if (!resolvedParent.startsWith(rootBoundary)) {
+                throw new IllegalArgumentException("Generated JTE destination is outside the JTE root: " + destination);
+            }
+        } catch (IOException e) {
+            throw new IllegalArgumentException("Could not resolve generated JTE destination: " + destination, e);
+        }
+    }
+
+    private Path projectedRealPath(Path path) throws IOException {
+        Path existing = path;
+        while (existing != null && !Files.exists(existing, NOFOLLOW_LINKS)) {
+            existing = existing.getParent();
+        }
+        if (existing == null) {
+            return path;
+        }
+        return existing.toRealPath().resolve(existing.relativize(path)).normalize();
+    }
+
+    private Map<Path, Path> validateDestinations(Map<Path, Path> selected) {
+        Map<Path, Path> result = new TreeMap<>(PATH_ORDER);
+        Set<Path> seen = new HashSet<>();
+        for (Map.Entry<Path, Path> entry : selected.entrySet()) {
+            String suggestion = owner.suggestJteFile(entry.getValue().toString().replace('\\', '/'));
+            if (suggestion == null || suggestion.isBlank()) {
+                throw new IllegalArgumentException("Generated JTE destination must not be blank for " + entry.getValue());
+            }
+            Path destination = jteRoot.resolve(suggestion).toAbsolutePath().normalize();
+            if (!destination.startsWith(jteRoot)) {
+                throw new IllegalArgumentException("Generated JTE destination is outside the JTE root: " + destination);
+            }
+            validateDestinationAncestors(destination);
+            if (!seen.add(destination)) {
+                throw new IllegalArgumentException("Generated JTE destinations collide at " + destination);
+            }
+            if (Files.exists(destination, NOFOLLOW_LINKS)) {
+                throw new IllegalArgumentException("Generated JTE destination is already taken: " + destination);
+            }
+            result.put(entry.getKey(), destination);
+        }
+        return result;
+    }
+
+    private Map<Path, byte[]> scanUsageFiles() {
+        Map<Path, byte[]> result = new TreeMap<>(PATH_ORDER);
+        try (Stream<Path> paths = Files.walk(jspRoot)) {
+            paths.filter(path -> Files.isRegularFile(path, NOFOLLOW_LINKS))
+                    .map(path -> path.toAbsolutePath().normalize())
+                    .filter(JspMigrationPlanner::isUsageFile)
+                    .forEach(path -> result.put(path, readBytes(path)));
+        } catch (IOException e) {
+            throw new UncheckedIOException(e);
+        }
+        return result;
+    }
+
+    private TagState discover(Path selectedPath, Map<String, Path> invocations, Consumer<Converter> parserSetup) {
+        String relativeName = relativeName(selectedPath);
+        JtpConverter converter = owner.createConverter(relativeName, owner.readFile(selectedPath));
+        String[] notConvertedTags = owner.getNotConvertedTags();
+        if (notConvertedTags != null) {
+            notConvertedTags = notConvertedTags.clone();
+        }
+        owner.registerConverters(converter, notConvertedTags);
+        RecordedSetup setup = new RecordedSetup(converter);
+        if (parserSetup != null) {
+            parserSetup.accept(setup);
+        }
+        setup.includes.forEach(this::resolveInclude);
+
+        Set<Path> dependencies = new TreeSet<>(PATH_ORDER);
+        JspNoopConverter noop = new JspNoopConverter();
+        invocations.forEach((tagName, path) -> converter.register(tagName, (jspConverter, tag, output, body) -> {
+            dependencies.add(path);
+            noop.convert(jspConverter, tag, output, body);
+        }));
+        converter.convert();
+        return new TagState(dependencies, setup, notConvertedTags);
+    }
+
+    private List<Path> conversionOrder(Map<Path, TagState> states) {
+        List<Path> result = new ArrayList<>();
+        Set<Path> converted = new HashSet<>();
+        while (result.size() < states.size()) {
+            Path next = states.entrySet().stream()
+                    .filter(entry -> !converted.contains(entry.getKey()))
+                    .filter(entry -> converted.containsAll(entry.getValue().dependencies))
+                    .map(Map.Entry::getKey)
+                    .findFirst()
+                    .orElse(null);
+            if (next == null) {
+                List<Path> cycle = findCycle(states, converted);
+                throw new IllegalArgumentException("Cyclic JSP tag dependency: " + formatCycle(cycle));
+            }
+            result.add(next);
+            converted.add(next);
+        }
+        return result;
+    }
+
+    private List<Path> findCycle(Map<Path, TagState> states, Set<Path> converted) {
+        Set<Path> visiting = new LinkedHashSet<>();
+        Set<Path> visited = new HashSet<>();
+        for (Path path : states.keySet()) {
+            if (!converted.contains(path)) {
+                List<Path> cycle = findCycle(path, states, converted, visiting, visited);
+                if (cycle != null) {
+                    return cycle;
+                }
+            }
+        }
+        throw new IllegalStateException("Failed to identify dependency cycle.");
+    }
+
+    private List<Path> findCycle(Path path, Map<Path, TagState> states, Set<Path> converted,
+                                 Set<Path> visiting, Set<Path> visited) {
+        if (visiting.contains(path)) {
+            List<Path> cycle = new ArrayList<>();
+            boolean collect = false;
+            for (Path candidate : visiting) {
+                if (candidate.equals(path)) {
+                    collect = true;
+                }
+                if (collect) {
+                    cycle.add(candidate);
+                }
+            }
+            cycle.add(path);
+            return cycle;
+        }
+        if (converted.contains(path) || !visited.add(path)) {
+            return null;
+        }
+        visiting.add(path);
+        for (Path dependency : states.get(path).dependencies) {
+            List<Path> cycle = findCycle(dependency, states, converted, visiting, visited);
+            if (cycle != null) {
+                return cycle;
+            }
+        }
+        visiting.remove(path);
+        return null;
+    }
+
+    private String formatCycle(List<Path> cycle) {
+        List<String> relative = new ArrayList<>();
+        cycle.forEach(path -> relative.add(relativeName(path).replace('\\', '/')));
+        return String.join(" -> ", relative);
+    }
+
+    private Path resolveInclude(String include) {
+        if (include == null || include.isBlank()) {
+            throw new IllegalArgumentException("Approved include path must not be null or blank.");
+        }
+        URL resourceBase = owner.getResourceBase();
+        if (!"file".equalsIgnoreCase(resourceBase.getProtocol())) {
+            throw new IllegalArgumentException("Approved includes require a file resource base: " + resourceBase);
+        }
+        try {
+            URI uri = resourceBase.toURI();
+            Path base = Path.of(uri).toAbsolutePath().normalize();
+            String relativeInclude = include.startsWith("/") || include.startsWith("\\") ? include.substring(1) : include;
+            Path resolved = base.resolve(relativeInclude).toAbsolutePath().normalize();
+            if (!resolved.startsWith(jspRoot)) {
+                throw new IllegalArgumentException("Approved include is outside the JSP root: " + include);
+            }
+            if (!Files.isRegularFile(resolved)) {
+                throw new IllegalArgumentException("Approved include is missing or not a regular file: " + include);
+            }
+            if (!resolved.toRealPath().startsWith(jspRoot.toRealPath())) {
+                throw new IllegalArgumentException("Approved include is outside the JSP root: " + include);
+            }
+            return resolved;
+        } catch (URISyntaxException | IOException e) {
+            throw new IllegalArgumentException("Could not resolve approved include: " + include, e);
+        }
+    }
+
+    private byte[] readBytes(Path path) {
+        try {
+            return Files.readAllBytes(path);
+        } catch (IOException e) {
+            throw new UncheckedIOException(e);
+        }
+    }
+
+    private String relativeName(Path path) {
+        return jspRoot.relativize(path).toString();
+    }
+
+    private String invocationName(Path path) {
+        String fileName = path.getFileName().toString();
+        String tagName = fileName.substring(0, fileName.indexOf('.'));
+        Path parent = path.getParent();
+        String namespace = parent == null ? "" : parent.getFileName().toString();
+        if ("tags".equals(namespace)) {
+            namespace = "include";
+        }
+        return namespace + ":" + tagName;
+    }
+
+    private void replaceUsages(Map<Path, String> files, Path selectedPath, String destination) {
+        String prefix = "<" + invocationName(selectedPath);
+        String closing = "</" + invocationName(selectedPath) + ">";
+        files.replaceAll((path, content) -> replaceUsages(content, prefix, closing, destination));
+    }
+
+    private String replaceUsages(String content, String prefix, String closing, String destination) {
+        StringBuilder result = new StringBuilder(content);
+        int index = 0;
+        while ((index = result.indexOf(prefix, index)) >= 0) {
+            int boundary = index + prefix.length();
+            if (boundary < result.length()) {
+                char character = result.charAt(boundary);
+                if (Character.isWhitespace(character) || character == '/' || character == '>') {
+                    result.replace(index, boundary, "<" + owner.getJteTag() + " jte=\"" + destination + "\"");
+                    index += owner.getJteTag().length() + destination.length() + 9;
+                    continue;
+                }
+            }
+            index = boundary;
+        }
+        index = 0;
+        String newClosing = "</" + owner.getJteTag() + ">";
+        while ((index = result.indexOf(closing, index)) >= 0) {
+            result.replace(index, index + closing.length(), newClosing);
+            index += newClosing.length();
+        }
+        return result.toString();
+    }
+
+    private static boolean isUsageFile(Path path) {
+        String name = path.toString();
+        return name.endsWith(".jsp") || name.endsWith(".jsp.inc") || name.endsWith(".tag");
+    }
+
+    private static final class TagState {
+        private final Set<Path> dependencies;
+        private final RecordedSetup setup;
+        private final String[] notConvertedTags;
+
+        private TagState(Set<Path> dependencies, RecordedSetup setup, String[] notConvertedTags) {
+            this.dependencies = dependencies;
+            this.setup = setup;
+            this.notConvertedTags = notConvertedTags;
+        }
+    }
+
+    private static final class RecordedSetup implements Converter {
+        private final Converter delegate;
+        private final List<Consumer<Converter>> actions = new ArrayList<>();
+        private final Set<String> includes = new LinkedHashSet<>();
+
+        private RecordedSetup(Converter delegate) {
+            this.delegate = delegate;
+        }
+
+        private void replay(Converter converter) {
+            actions.forEach(action -> action.accept(converter));
+        }
+
+        @Override
+        public void register(String tagName, CustomTagConverter converter) {
+            delegate.register(tagName, converter);
+            actions.add(target -> target.register(tagName, converter));
+        }
+
+        @Override
+        public void addInlinedInclude(String path) {
+            delegate.addInlinedInclude(path);
+            includes.add(path);
+            actions.add(target -> target.addInlinedInclude(path));
+        }
+
+        @Override
+        public void addSuppressions(String path, EnumSet<JspElementType> suppressions) {
+            EnumSet<JspElementType> copy = suppressions.clone();
+            delegate.addSuppressions(path, copy);
+            actions.add(target -> target.addSuppressions(path, copy.clone()));
+        }
+
+        @Override
+        public void setLineSeparator(String lineSeparator) {
+            delegate.setLineSeparator(lineSeparator);
+            actions.add(target -> target.setLineSeparator(lineSeparator));
+        }
+
+        @Override
+        public void setIndentationCount(int indentationCount) {
+            delegate.setIndentationCount(indentationCount);
+            actions.add(target -> target.setIndentationCount(indentationCount));
+        }
+
+        @Override
+        public void setIndentationChar(char indentationChar) {
+            delegate.setIndentationChar(indentationChar);
+            actions.add(target -> target.setIndentationChar(indentationChar));
+        }
+
+        @Override
+        public String convert() {
+            return delegate.convert();
+        }
+
+        @Override
+        public void setPrefix(String prefix) {
+            delegate.setPrefix(prefix);
+            actions.add(target -> target.setPrefix(prefix));
+        }
+    }
+
+    private static final class MigratedTagConverter implements CustomTagConverter {
+        private final String destination;
+
+        private MigratedTagConverter(String destination) {
+            this.destination = destination;
+        }
+
+        @Override
+        public void convert(JtpConverter converter, JtpCustomTag tag, ConverterOutput output, BodyConverter bodyConverter) throws JasperException {
+            Attributes attributes = tag.getAttributes();
+            String pathWithoutExtension = destination.substring(0, destination.length() - 4);
+            String tagCall = pathWithoutExtension.replace('/', '.');
+            int tagStartPos = output.getCurrentLineCharCount();
+            String tagStartIndent = String.valueOf(output.getIndentationChar()).repeat(tagStartPos);
+            output.append("@template.").append(tagCall).append("(");
+
+            boolean first = true;
+            for (int i = 0; i < attributes.getLength(); i++) {
+                if ("jte".equals(attributes.getLocalName(i))) {
+                    continue;
+                }
+                if (!first) {
+                    output.append(",");
+                }
+                output.newLine(tagStartIndent);
+                output.indent(1);
+                first = false;
+                output.append(attributes.getLocalName(i)).append(" = ").append(convertAttributeValue(attributes.getValue(i)));
+            }
+            if (tag.hasBody()) {
+                if (!first) {
+                    output.append(",");
+                }
+                output.newLine(tagStartIndent);
+                output.indent(1);
+                first = false;
+                output.append("bodyContent = @`");
+                bodyConverter.convert();
+                output.append("`");
+            }
+            if (!first) {
+                output.newLine(tagStartIndent);
+            }
+            output.append(")");
+        }
+    }
+}
