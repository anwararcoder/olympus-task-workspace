+package gg.jte.convert.jsp;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+import java.io.IOException;
+import java.net.URL;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+import java.util.Map;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+import static org.assertj.core.api.Assertions.catchThrowable;
+
+class JspMigrationPlanTest {
+    @TempDir
+    Path tempDir;
+
+    @Test
+    void plansAndCommitsDependenciesTransactionally() throws IOException {
+        Fixture fixture = fixture();
+        Path first = fixture.writeTag("a/first.tag", "first");
+        Path second = fixture.writeTag("a/second.tag", "<%@ taglib uri=\"urn:test\" prefix=\"a\" %><a:first/>");
+        Path usage = fixture.writeJsp("usage.jsp", "<%@ taglib uri=\"urn:test\" prefix=\"a\" %><a:second/>");
+
+        JspMigrationPlan plan = fixture.converter().planTags(List.of("a/second.tag", "a/first.tag"), null);
+
+        assertThat(plan.getConversionOrder()).containsExactly(first, second);
+        assertThat(plan.getDeletes()).containsExactlyInAnyOrder(first, second);
+        assertThat(plan.getWrites()).containsKeys(
+                fixture.jteRoot.resolve("a/first.jte"),
+                fixture.jteRoot.resolve("a/second.jte"),
+                usage
+        );
+        assertThat(plan.getWrites().get(fixture.jteRoot.resolve("a/second.jte"))).contains("@template.a.first()");
+        assertThat(first).exists();
+        assertThat(fixture.jteRoot).doesNotExist();
+        assertThatThrownBy(() -> plan.getWrites().put(usage, "changed")).isInstanceOf(UnsupportedOperationException.class);
+
+        plan.commit();
+
+        assertThat(first).doesNotExist();
+        assertThat(second).doesNotExist();
+        assertThat(fixture.jteRoot.resolve("a/first.jte")).content().isEqualTo("first");
+        assertThat(usage).content().contains("<my:jte jte=\"a/second.jte\"/>");
+        assertThatThrownBy(plan::commit).isInstanceOf(IllegalStateException.class);
+    }
+
+    @Test
+    void stalePlanReportsEveryChangedPathBeforeMutation() throws IOException {
+        Fixture fixture = fixture();
+        Path first = fixture.writeTag("a/first.tag", "first");
+        Path usage = fixture.writeJsp("usage.jsp", "unchanged");
+        JspMigrationPlan plan = fixture.converter().planTags(List.of("a/first.tag"), null);
+        Path destination = fixture.jteRoot.resolve("a/first.jte");
+
+        Files.writeString(first, "changed tag");
+        Files.writeString(usage, "changed usage");
+        Files.createDirectories(destination.getParent());
+        Files.writeString(destination, "occupied");
+
+        Throwable failure = catchThrowable(plan::commit);
+
+        assertThat(failure).isInstanceOf(StaleJspMigrationPlanException.class);
+        assertThat(((StaleJspMigrationPlanException) failure).getChangedPaths())
+                .containsExactly(first, usage, destination);
+        assertThat(first).content().isEqualTo("changed tag");
+        assertThat(destination).content().isEqualTo("occupied");
+    }
+
+    @Test
+    void failedCommitRestoresFilesAndCreatedDirectories() throws IOException {
+        Fixture fixture = fixture();
+        Path first = fixture.writeTag("a/first.tag", "first");
+        Path second = fixture.writeTag("a/second.tag", "second");
+        JspToJteConverter converter = fixture.converter(Map.of(
+                "a/first.tag", "a/first.jte",
+                "a/second.tag", "z/second.jte"
+        ));
+        JspMigrationPlan plan = converter.planTags(List.of("a/first.tag", "a/second.tag"), null);
+        Files.createDirectories(fixture.jteRoot);
+        Path blocker = fixture.jteRoot.resolve("z");
+        Files.writeString(blocker, "unrelated");
+
+        assertThatThrownBy(plan::commit).isInstanceOf(IOException.class);
+
+        assertThat(first).content().isEqualTo("first");
+        assertThat(second).content().isEqualTo("second");
+        assertThat(fixture.jteRoot.resolve("a/first.jte")).doesNotExist();
+        assertThat(fixture.jteRoot.resolve("a")).doesNotExist();
+        assertThat(blocker).content().isEqualTo("unrelated");
+    }
+
+    @Test
+    void parserSetupFailureSurfacesUnchanged() throws IOException {
+        Fixture fixture = fixture();
+        fixture.writeTag("a/first.tag", "first");
+        RuntimeException expected = new RuntimeException("setup failed");
+
+        Throwable actual = catchThrowable(() -> fixture.converter().planTags(List.of("a/first.tag"), converter -> {
+            throw expected;
+        }));
+
+        assertThat(actual).isSameAs(expected);
+    }
+
+    @Test
+    void jspCommentsDoNotCreateDependencies() throws IOException {
+        Fixture fixture = fixture();
+        Path first = fixture.writeTag("a/first.tag", "<%-- <a:second/> --%>first");
+        Path second = fixture.writeTag("a/second.tag", "second");
+
+        JspMigrationPlan plan = fixture.converter().planTags(List.of("a/second.tag", "a/first.tag"), null);
+
+        assertThat(plan.getConversionOrder()).containsExactly(first, second);
+    }
+
+    @Test
+    void cycleReportsDeterministicClosedRootRelativePath() throws IOException {
+        Fixture fixture = fixture();
+        fixture.writeTag("a/first.tag", "<%@ taglib uri=\"urn:test\" prefix=\"a\" %><a:second/>");
+        fixture.writeTag("a/second.tag", "<%@ taglib uri=\"urn:test\" prefix=\"a\" %><a:first/>");
+
+        assertThatThrownBy(() -> fixture.converter().planTags(List.of("a/second.tag", "a/first.tag"), null))
+                .isInstanceOf(IllegalArgumentException.class)
+                .hasMessage("Cyclic JSP tag dependency: a/first.tag -> a/second.tag -> a/first.tag");
+    }
+
+    @Test
+    void approvedIncludeOutsideJspRootIsRejectedBeforeParsing() throws IOException {
+        Fixture fixture = fixture();
+        fixture.writeTag("a/first.tag", "<%@ include file=\"/outside.jsp.inc\" %>");
+        Files.writeString(tempDir.resolve("outside.jsp.inc"), "outside");
+
+        assertThatThrownBy(() -> fixture.converter().planTags(List.of("a/first.tag"), converter ->
+                converter.addInlinedInclude("../outside.jsp.inc")))
+                .isInstanceOf(IllegalArgumentException.class)
+                .hasMessageContaining("outside the JSP root");
+    }
+
+    @Test
+    void approvedIncludeContributesDependenciesAndIsSnapshotted() throws IOException {
+        Fixture fixture = fixture();
+        Path first = fixture.writeTag("a/first.tag", "first");
+        Path second = fixture.writeTag("a/second.tag", "<%@ include file=\"/includes/dependency.fragment\" %>");
+        Path include = fixture.jspRoot.resolve("includes/dependency.fragment");
+        Files.createDirectories(include.getParent());
+        Files.writeString(include, "<%@ taglib uri=\"urn:test\" prefix=\"a\" %><a:first/>");
+
+        JspMigrationPlan plan = fixture.converter().planTags(List.of("a/second.tag", "a/first.tag"), converter ->
+                converter.addInlinedInclude("/includes/dependency.fragment"));
+
+        assertThat(plan.getConversionOrder()).containsExactly(first, second);
+        Files.writeString(include, "changed");
+        Throwable failure = catchThrowable(plan::commit);
+        assertThat(failure).isInstanceOf(StaleJspMigrationPlanException.class);
+        assertThat(((StaleJspMigrationPlanException) failure).getChangedPaths()).containsExactly(include);
+    }
+
+    private Fixture fixture() throws IOException {
+        return new Fixture(tempDir.resolve("jsp").toAbsolutePath(), tempDir.resolve("jte").toAbsolutePath());
+    }
+
+    private static final class Fixture {
+        private final Path jspRoot;
+        private final Path jteRoot;
+
+        private Fixture(Path jspRoot, Path jteRoot) throws IOException {
+            this.jspRoot = jspRoot;
+            this.jteRoot = jteRoot;
+            Files.createDirectories(jspRoot.resolve("WEB-INF/tld"));
+            Files.writeString(jspRoot.resolve("WEB-INF/tld/test.tld"), tld());
+        }
+
+        private Path writeTag(String relative, String content) throws IOException {
+            Path path = jspRoot.resolve(relative);
+            Files.createDirectories(path.getParent());
+            Files.writeString(path, content);
+            return path.toAbsolutePath().normalize();
+        }
+
+        private Path writeJsp(String relative, String content) throws IOException {
+            Path path = jspRoot.resolve(relative);
+            Files.createDirectories(path.getParent());
+            Files.writeString(path, content);
+            return path.toAbsolutePath().normalize();
+        }
+
+        private JspToJteConverter converter() {
+            return converter(Map.of());
+        }
+
+        private JspToJteConverter converter(Map<String, String> suggestions) {
+            return new JspToJteConverter(jspRoot, jteRoot, "my:jte") {
+                @Override
+                protected URL getResourceBase() {
+                    try {
+                        return jspRoot.toUri().toURL();
+                    } catch (IOException e) {
+                        throw new RuntimeException(e);
+                    }
+                }
+
+                @Override
+                public String suggestJteFile(String jspFile) {
+                    return suggestions.getOrDefault(jspFile, super.suggestJteFile(jspFile));
+                }
+            };
+        }
+
+        private static String tld() {
+            return """
+                    <?xml version="1.0" encoding="UTF-8" ?>
+                    <taglib xmlns="http://java.sun.com/xml/ns/javaee" version="2.1">
+                        <tlib-version>1.0</tlib-version>
+                        <short-name>a</short-name>
+                        <uri>urn:test</uri>
+                        <tag><name>first</name><tag-class>example.JteTag</tag-class><body-content>scriptless</body-content><dynamic-attributes>true</dynamic-attributes></tag>
+                        <tag><name>second</name><tag-class>example.JteTag</tag-class><body-content>scriptless</body-content><dynamic-attributes>true</dynamic-attributes></tag>
+                    </taglib>
+                    """;
+        }
+    }
+}
