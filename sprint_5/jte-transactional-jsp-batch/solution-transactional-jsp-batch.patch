+            Path normalizedJspRoot,
+            Set<Path> visited,
+            List<Path> stack,
+            Set<Path> active
+    ) {
+        if (active.contains(path)) {
+            int start = stack.indexOf(path);
+            List<String> cycle = new ArrayList<>();
+            for (int i = start; i < stack.size(); i++) {
+                cycle.add(normalizedJspRoot.relativize(stack.get(i)).toString().replace('\\', '/'));
+            }
