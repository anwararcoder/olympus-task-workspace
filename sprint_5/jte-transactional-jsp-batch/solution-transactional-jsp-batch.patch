+        if (!visited.add(path)) {
+            return null;
+        }
+
+        active.add(path);
+        stack.add(path);
+        Set<Path> sortedDependencies = new TreeSet<>(PATH_ORDER);
+        sortedDependencies.addAll(dependencies.getOrDefault(path, Collections.emptySet()));
+        for (Path dependency : sortedDependencies) {
+            String cycle = findCycle(dependency, dependencies, normalizedJspRoot, visited, stack, active);
+            if (cycle != null) {
