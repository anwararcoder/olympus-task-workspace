+public final class JspMigrationPlan {
+    private static final Comparator<Path> PATH_ORDER = Comparator.comparing(Path::toString);
+
+    private final List<Path> conversionOrder;
+    private final Map<Path, String> writes;
+    private final List<Path> deletes;
+    private final Map<Path, byte[]> contentSnapshots;
+    private final Set<Path> absentSnapshots;
+    private boolean committed;
+
+    JspMigrationPlan(
+            List<Path> conversionOrder,
+            Map<Path, String> writes,
+            List<Path> deletes,
+            Map<Path, byte[]> contentSnapshots,
+            Set<Path> absentSnapshots
+    ) {
+        this.conversionOrder = Collections.unmodifiableList(new ArrayList<>(conversionOrder));
+        this.writes = Collections.unmodifiableMap(new LinkedHashMap<>(writes));
+        this.deletes = Collections.unmodifiableList(new ArrayList<>(deletes));
+
+        Map<Path, byte[]> snapshotCopies = new LinkedHashMap<>();
+        contentSnapshots.forEach((path, content) -> snapshotCopies.put(path, content.clone()));
+        this.contentSnapshots = Collections.unmodifiableMap(snapshotCopies);
+        this.absentSnapshots = Collections.unmodifiableSet(new LinkedHashSet<>(absentSnapshots));
+    }
+
+    public List<Path> getConversionOrder() {
+        return conversionOrder;
+    }
+
+    public Map<Path, String> getWrites() {
+        return writes;
+    }
+
+    public List<Path> getDeletes() {
+        return deletes;
+    }
+
+    public synchronized void commit() throws IOException {
+        if (committed) {
+            throw new IllegalStateException("This JSP migration plan has already been committed.");
+        }
+
+        List<Path> changedPaths = findChangedPaths();
+        if (!changedPaths.isEmpty()) {
+            throw new StaleJspMigrationPlanException(changedPaths);
+        }
+
+        new Transaction(writes, deletes, contentSnapshots).commit();
+        committed = true;
+    }
+
+    private List<Path> findChangedPaths() {
+        List<Path> changed = new ArrayList<>();
+
+        for (Map.Entry<Path, byte[]> snapshot : contentSnapshots.entrySet()) {
+            Path path = snapshot.getKey();
+            if (!Files.isRegularFile(path, LinkOption.NOFOLLOW_LINKS)) {
+                changed.add(path);
+                continue;
+            }
+
+            try {
+                if (!Arrays.equals(snapshot.getValue(), Files.readAllBytes(path))) {
+                    changed.add(path);
+                }
+            } catch (IOException e) {
+                changed.add(path);
+            }
+        }
+
+        for (Path path : absentSnapshots) {
+            if (Files.exists(path, LinkOption.NOFOLLOW_LINKS)) {
+                changed.add(path);
+            }
+        }
+
+        changed.sort(PATH_ORDER);
+        return changed;
+    }
+
+    private static final class Transaction {
+        private final Map<Path, byte[]> writeBytes = new LinkedHashMap<>();
+        private final List<Path> deletes;
+        private final Map<Path, byte[]> originals;
+        private final Map<Path, Path> staged = new LinkedHashMap<>();
+        private final List<Path> createdDirectories = new ArrayList<>();
+        private final List<Path> mutatedPaths = new ArrayList<>();
+
+        private Transaction(Map<Path, String> writes, List<Path> deletes, Map<Path, byte[]> originals) {
+            writes.forEach((path, content) -> writeBytes.put(path, content.getBytes(StandardCharsets.UTF_8)));
+            this.deletes = deletes;
+            this.originals = originals;
+        }
+
+        private void commit() throws IOException {
+            try {
+                stageWrites();
+                installWrites();
+                deleteSources();
+                IOException cleanupFailure = cleanupTemporaryFiles();
+                if (cleanupFailure != null) {
+                    throw cleanupFailure;
+                }
+            } catch (IOException failure) {
+                IOException rollbackFailure = rollback();
+                if (rollbackFailure != null) {
+                    failure.addSuppressed(rollbackFailure);
+                }
+                IOException cleanupFailure = cleanupTemporaryFiles();
+                if (cleanupFailure != null) {
+                    failure.addSuppressed(cleanupFailure);
+                }
+                throw failure;
+            }
+        }
+
+        private void stageWrites() throws IOException {
+            for (Map.Entry<Path, byte[]> write : writeBytes.entrySet()) {
+                Path stage = createTemporarySibling(write.getKey(), ".stage");
+                staged.put(write.getKey(), stage);
+                Files.write(stage, write.getValue(), StandardOpenOption.TRUNCATE_EXISTING);
+            }
+        }
+
+        private void installWrites() throws IOException {
+            for (Map.Entry<Path, Path> stage : staged.entrySet()) {
+                mutatedPaths.add(stage.getKey());
+                createParentDirectories(stage.getKey());
+                Files.move(stage.getValue(), stage.getKey(), StandardCopyOption.REPLACE_EXISTING);
+            }
+        }
+
+        private void deleteSources() throws IOException {
+            for (Path path : deletes) {
+                mutatedPaths.add(path);
+                Files.delete(path);
+            }
+        }
+
+        private IOException rollback() {
+            IOException failure = null;
+            List<Path> affected = new ArrayList<>(mutatedPaths);
+            Collections.reverse(affected);
+
+            for (Path path : affected) {
+                try {
+                    byte[] original = originals.get(path);
+                    if (original == null) {
+                        Files.deleteIfExists(path);
+                    } else {
+                        createParentDirectories(path);
+                        Files.write(
+                                path,
+                                original,
+                                StandardOpenOption.CREATE,
+                                StandardOpenOption.TRUNCATE_EXISTING
+                        );
+                    }
+                } catch (IOException rollbackFailure) {
+                    if (failure == null) {
+                        failure = new IOException("Failed to roll back JSP migration.");
+                    }
+                    failure.addSuppressed(rollbackFailure);
+                }
+            }
+
+            IOException directoryFailure = removeCreatedDirectories();
+            if (directoryFailure != null) {
+                if (failure == null) {
+                    failure = new IOException("Failed to roll back JSP migration.");
+                }
+                failure.addSuppressed(directoryFailure);
+            }
+            return failure;
+        }
+
+        private Path createTemporarySibling(Path target, String suffix) throws IOException {
+            Path directory = nearestExistingDirectory(target.toAbsolutePath().normalize().getParent());
+            return Files.createTempFile(directory, ".jte-migration-", suffix);
+        }
+
+        private Path nearestExistingDirectory(Path directory) throws IOException {
+            Path current = directory;
+            while (current != null && !Files.isDirectory(current)) {
+                current = current.getParent();
+            }
+            if (current == null) {
+                throw new IOException("No existing directory for migration path " + directory);
+            }
+            return current;
+        }
+
+        private void createParentDirectories(Path path) throws IOException {
+            Path parent = path.getParent();
+            if (parent == null || Files.isDirectory(parent)) {
+                return;
+            }
+
+            List<Path> missing = new ArrayList<>();
+            Path current = parent;
+            while (current != null && !Files.exists(current)) {
+                missing.add(current);
+                current = current.getParent();
+            }
+
+            try {
+                Files.createDirectories(parent);
+            } finally {
+                Collections.reverse(missing);
+                for (Path directory : missing) {
+                    if (Files.isDirectory(directory) && !createdDirectories.contains(directory)) {
+                        createdDirectories.add(directory);
+                    }
+                }
+            }
+        }
+
+        private IOException cleanupTemporaryFiles() {
+            IOException failure = null;
+            for (Path path : staged.values()) {
+                try {
+                    Files.deleteIfExists(path);
+                } catch (IOException cleanupFailure) {
+                    if (failure == null) {
+                        failure = new IOException("Failed to clean up JSP migration temporary files.");
+                    }
+                    failure.addSuppressed(cleanupFailure);
+                }
+            }
+            return failure;
+        }
+
+        private IOException removeCreatedDirectories() {
+            IOException failure = null;
+            List<Path> reverse = new ArrayList<>(createdDirectories);
+            Collections.reverse(reverse);
+            for (Path path : reverse) {
+                try {
+                    Files.delete(path);
+                } catch (IOException cleanupFailure) {
+                    if (failure == null) {
+                        failure = new IOException("Failed to restore pre-commit directory state.");
+                    }
+                    failure.addSuppressed(cleanupFailure);
+                }
+            }
+            return failure;
+        }
+
+    }
+}
