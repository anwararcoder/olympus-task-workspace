+"""Sparsification of classical AMG coarse operators."""
+
+import numpy as np
+from scipy.sparse import csr_array, issparse
+
+
+def _canonical_copy(A):
+    result = A.copy()
+    result.sum_duplicates()
+    result.sort_indices()
+    return result
+
+
+def _rows_to_csr(rows, shape, dtype):
+    indices = []
+    data = []
+    indptr = [0]
+    for i, row in enumerate(rows):
+        for col in sorted(row):
+            value = row[col]
+            if value != 0 or col == i:
+                indices.append(col)
+                data.append(value)
+        indptr.append(len(indices))
+    result = csr_array((np.asarray(data, dtype=dtype),
+                        np.asarray(indices, dtype=np.intc),
+                        np.asarray(indptr, dtype=np.intc)), shape=shape)
+    result.sort_indices()
+    return result
+
+
+def sparsify_coarse_operator(A, theta=0.1, lump='diagonal', symmetric=True,
+                             B=None, protect=None):
+    """Drop weak coarse-operator entries while optionally preserving ``A @ B``.
+
+    Parameters
+    ----------
+    A : csr_array
+        Square coarse operator.
+    theta : float, default 0.1
+        Relative row threshold for off-diagonal entries.
+    lump : {'diagonal', 'strong', 'none'}, default 'diagonal'
+        Where the image of dropped entries is put.
+    symmetric : bool, default True
+        Retain the transpose of every retained entry when it exists.
+    B : array_like, optional
+        Vector whose image is preserved when lumping.  Defaults to ones.
+    protect : csr_array, optional
+        Stored positions that must be retained when they also occur in ``A``.
+    """
+    if not issparse(A) or A.format != 'csr':
+        raise TypeError('expected csr_array for A')
+    if A.shape[0] != A.shape[1]:
+        raise ValueError(f'expected square matrix, shape={A.shape}')
+    try:
+        theta = float(theta)
+    except (TypeError, ValueError, OverflowError) as exc:
+        raise ValueError('theta must be in [0, 1)') from exc
+    if not np.isfinite(theta) or theta < 0 or theta >= 1:
+        raise ValueError('theta must be in [0, 1)')
+    if not isinstance(lump, str) or lump not in ('diagonal', 'strong', 'none'):
+        raise ValueError("lump must be 'diagonal', 'strong', or 'none'")
+    if not isinstance(symmetric, (bool, np.bool_)):
+        raise ValueError('symmetric must be a boolean')
+
+    A = _canonical_copy(A)
+    n = A.shape[0]
+    dtype = np.result_type(A.dtype, np.float64)
+
+    if B is None:
+        B = np.ones(n, dtype=dtype)
+    else:
+        B = np.asarray(B)
+        if B.ndim == 2 and 1 in B.shape:
+            B = np.ravel(B)
+        if B.ndim != 1 or B.size != n:
+            raise ValueError('B must hold one entry per point')
+        if not np.issubdtype(B.dtype, np.number):
+            raise ValueError('B must be numeric')
+        B = np.asarray(B, dtype=np.result_type(dtype, B.dtype))
+    if lump != 'none' and np.any(B == 0):
+        raise ValueError('B must be nonzero when lumping')
+
+    if protect is not None:
+        if not issparse(protect) or protect.format != 'csr':
+            raise TypeError('expected csr_array for protect')
+        if protect.shape != A.shape:
+            raise ValueError('protect has incompatible shape')
+        protect = _canonical_copy(protect)
+
+    rows = []
+    positions = []
+    for i in range(n):
+        row = {}
+        for k in range(A.indptr[i], A.indptr[i + 1]):
+            row[int(A.indices[k])] = np.asarray(A.data[k], dtype=dtype).item()
+        rows.append(row)
+        positions.append(set(row))
+
+    protected = [set() for _ in range(n)]
+    if protect is not None:
+        for i in range(n):
+            protected[i].update(int(j) for j in
+                                protect.indices[protect.indptr[i]:protect.indptr[i + 1]])
+
+    kept = [set() for _ in range(n)]
+    for i in range(n):
+        offdiag = [(j, value) for j, value in rows[i].items() if j != i]
+        largest = max((abs(value) for _, value in offdiag), default=0)
+        threshold = theta * largest
+        for j, value in offdiag:
+            if abs(value) >= threshold or j in protected[i]:
+                kept[i].add(j)
+
+    # Symmetrization is a union over the entries that would otherwise be kept.
+    # Only positions already present in A can be added by this operation.
+    if symmetric:
+        for i in range(n):
+            for j in tuple(kept[i]):
+                if i in positions[j]:
+                    kept[j].add(i)
+
+    rows_out = []
+    for i in range(n):
+        out = {}
+        diagonal = rows[i].get(i, np.asarray(0, dtype=dtype).item())
+        dropped_image = np.asarray(0, dtype=np.result_type(dtype, B.dtype)).item()
+
+        for j, value in rows[i].items():
+            if j != i and j not in kept[i]:
+                dropped_image += value * B[j]
+            elif j != i:
+                out[j] = value
+
+        if lump == 'diagonal' or lump == 'strong':
+            if lump == 'strong':
+                weights = {j: abs(rows[i][j]) for j in kept[i]}
+                share = sum((weight * B[j] for j, weight in weights.items()),
+                            np.asarray(0, dtype=np.result_type(dtype, B.dtype)).item())
+            else:
+                share = 0
+
+            if lump == 'strong' and share != 0 and kept[i]:
+                # The increment to each kept coefficient is proportional to
+                # its magnitude.  Its B-weighted image sums to dropped_image.
+                for j, weight in weights.items():
+                    out[j] = out.get(j, 0) + dropped_image * weight / share
+            else:
+                diagonal += dropped_image / B[i]
+
+        # The diagonal is deliberately inserted even if it was absent from A
+        # and no dropped value was lumped back.
+        out[i] = diagonal
+        rows_out.append(out)
+
+    return _rows_to_csr(rows_out, A.shape,
+                        np.result_type(dtype, B.dtype))
