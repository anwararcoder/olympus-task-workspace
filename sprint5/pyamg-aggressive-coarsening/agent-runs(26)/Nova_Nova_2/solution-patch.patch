diff --git a/pyamg/classical/interpolate.py b/pyamg/classical/interpolate.py
index f5a771a..5014005 100644
--- a/pyamg/classical/interpolate.py
+++ b/pyamg/classical/interpolate.py
@@ -9,6 +9,367 @@ from .. import amg_core
 from ..strength import classical_strength_of_connection
 
 
+def _validate_whole_number(value, name, minimum=0):
+    if isinstance(value, (bool, np.bool_)):
+        raise ValueError(f'{name} must be a whole number')
+    try:
+        integer = int(value)
+    except (TypeError, ValueError, OverflowError) as exc:
+        raise ValueError(f'{name} must be a whole number') from exc
+    if integer != value or integer < minimum:
+        raise ValueError(f'{name} must be a whole number >= {minimum}')
+    return integer
+
+
+def _validate_csr_matrix(matrix, name):
+    if not issparse(matrix) or matrix.format != 'csr':
+        raise TypeError(f'expected csr_array for {name}')
+
+
+def _canonical_copy(matrix):
+    result = matrix.copy()
+    result.sum_duplicates()
+    result.sort_indices()
+    return result
+
+
+def _rows_to_csr(rows, shape, dtype):
+    """Construct canonical CSR from row dictionaries."""
+    indices = []
+    data = []
+    indptr = [0]
+    for row in rows:
+        for col in sorted(row):
+            value = row[col]
+            if value != 0:
+                indices.append(col)
+                data.append(value)
+        indptr.append(len(indices))
+
+    result = csr_array((np.asarray(data, dtype=dtype),
+                        np.asarray(indices, dtype=np.intc),
+                        np.asarray(indptr, dtype=np.intc)), shape=shape)
+    result.eliminate_zeros()
+    result.sort_indices()
+    return result
+
+
+def _strength_pattern(A, C, theta, norm):
+    _validate_csr_matrix(A, 'A')
+    _validate_csr_matrix(C, 'C')
+    if A.shape[0] != A.shape[1]:
+        raise ValueError(f'expected square matrix, shape={A.shape}')
+    if C.shape != A.shape:
+        raise ValueError('C has incompatible shape')
+    if norm not in ('min', 'abs'):
+        raise ValueError("norm must be 'min' or 'abs'")
+
+    if theta is not None:
+        try:
+            theta_value = float(theta)
+        except (TypeError, ValueError, OverflowError) as exc:
+            raise ValueError('theta must be in [0, 1)') from exc
+        if not np.isfinite(theta_value) or theta_value < 0 or theta_value >= 1:
+            raise ValueError('theta must be in [0, 1)')
+        # The min measure is defined through ordering negative real entries.
+        # For complex matrices there is no such ordering; use magnitudes for
+        # the graph while retaining the complex values in the interpolation
+        # calculation.
+        strength_A = A
+        strength_norm = norm
+        if norm == 'min' and np.iscomplexobj(A.data):
+            strength_A = A.copy()
+            strength_A.data = np.abs(strength_A.data)
+            strength_norm = 'abs'
+        pattern = classical_strength_of_connection(strength_A,
+                                                    theta=theta_value,
+                                                    norm=strength_norm)
+    else:
+        pattern = _canonical_copy(C)
+        pattern.eliminate_zeros()
+    return _canonical_copy(pattern)
+
+
+def _multipass_unscaled(A, C, splitting, max_passes=None):
+    """Return pass numbers, unscaled rows, and the canonical strength pattern."""
+    n = A.shape[0]
+    splitting = np.asarray(splitting)
+    if splitting.ndim != 1 or splitting.size != n:
+        raise ValueError('splitting has incompatible shape')
+
+    A = _canonical_copy(A)
+    C = _canonical_copy(C)
+    dtype = np.result_type(A.dtype, np.float64)
+    zero = np.asarray(0, dtype=dtype).item()
+    one = np.asarray(1, dtype=dtype).item()
+
+    a_rows = []
+    for i in range(n):
+        row = {}
+        for offset in range(A.indptr[i], A.indptr[i + 1]):
+            row[int(A.indices[offset])] = np.asarray(A.data[offset],
+                                                      dtype=dtype).item()
+        a_rows.append(row)
+
+    # C is used as a pattern, not as a set of weights.  Stored diagonal
+    # entries have no role in a pass and are omitted from the graph lists.
+    strong = []
+    for i in range(n):
+        strong.append([int(j) for j in C.indices[C.indptr[i]:C.indptr[i + 1]]
+                       if int(j) != i])
+
+    coarse = splitting != 0
+    coarse_points = np.flatnonzero(coarse)
+    coarse_map = np.full(n, -1, dtype=np.intc)
+    coarse_map[coarse_points] = np.arange(coarse_points.size, dtype=np.intc)
+
+    pass_number = np.full(n, -1, dtype=np.intc)
+    unscaled = [{} for _ in range(n)]
+    for point in coarse_points:
+        pass_number[point] = 0
+        unscaled[point][int(coarse_map[point])] = one
+
+    current_pass = 1
+    while max_passes is None or current_pass <= max_passes:
+        candidates = []
+        for i in range(n):
+            if coarse[i] or pass_number[i] >= 0:
+                continue
+            if any(pass_number[j] >= 0 for j in strong[i]):
+                candidates.append(i)
+
+        if not candidates:
+            break
+
+        # Build every row from the state at the beginning of this pass.  In
+        # particular, points settling together cannot use one another.
+        new_rows = {}
+        for i in candidates:
+            row = {}
+            for j in strong[i]:
+                if pass_number[j] < 0:
+                    continue
+                aij = a_rows[i].get(j, zero)
+                if aij == 0:
+                    continue
+                if coarse[j]:
+                    column = int(coarse_map[j])
+                    row[column] = row.get(column, zero) + aij
+                else:
+                    for column, value in unscaled[j].items():
+                        row[column] = row.get(column, zero) + aij * value
+            new_rows[i] = row
+
+        for i in candidates:
+            pass_number[i] = current_pass
+            unscaled[i] = new_rows[i]
+        current_pass += 1
+
+    return pass_number, unscaled, strong, a_rows, coarse, coarse_map, dtype
+
+
+def interpolation_passes(A, C, splitting, theta=None, norm='min'):
+    """Report the pass in which each point is settled by multipass interpolation."""
+    _validate_csr_matrix(A, 'A')
+    _validate_csr_matrix(C, 'C')
+    pattern = _strength_pattern(A, C, theta, norm)
+    result = _multipass_unscaled(A, pattern, splitting)[0]
+    return np.asarray(result, dtype='intc')
+
+
+def multipass_interpolation(A, C, splitting, theta=None, norm='min',
+                            trunc=None, improve=0, strict=False, lump=False,
+                            max_passes=None):
+    """Create interpolation by repeatedly eliminating settled fine points.
+
+    Coarse points settle in pass zero.  A fine point settles when it has a
+    strong neighbour in an earlier pass, and its unscaled row is obtained by
+    substituting that neighbour's row into the corresponding matrix entry.
+    """
+    _validate_csr_matrix(A, 'A')
+    _validate_csr_matrix(C, 'C')
+    if not isinstance(strict, (bool, np.bool_)):
+        raise ValueError('strict must be a boolean')
+    if not isinstance(lump, (bool, np.bool_)):
+        raise ValueError('lump must be a boolean')
+    pattern = _strength_pattern(A, C, theta, norm)
+    improve = _validate_whole_number(improve, 'improve', minimum=0)
+    if max_passes is not None:
+        max_passes = _validate_whole_number(max_passes, 'max_passes', minimum=1)
+    if trunc is not None:
+        try:
+            trunc_value = float(trunc)
+        except (TypeError, ValueError, OverflowError) as exc:
+            raise ValueError('trunc must be in [0, 1)') from exc
+        if not np.isfinite(trunc_value) or trunc_value < 0 or trunc_value >= 1:
+            raise ValueError('trunc must be in [0, 1)')
+    else:
+        trunc_value = None
+
+    (pass_number, unscaled, strong, a_rows, coarse, coarse_map,
+     dtype) = _multipass_unscaled(A, pattern, splitting, max_passes)
+
+    unresolved = (~coarse) & (pass_number < 0)
+    if strict and np.any(unresolved):
+        raise ValueError('some fine points could not be settled')
+
+    # Scale only after all passes have completed.  A strong fine neighbour
+    # which was not available in an earlier pass can optionally be lumped
+    # into the row diagonal before this scale is calculated.
+    n = A.shape[0]
+    for i in range(n):
+        if coarse[i] or pass_number[i] < 0:
+            continue
+
+        diagonal = a_rows[i].get(i, np.asarray(0, dtype=dtype).item())
+        offdiag_sum = sum((value for j, value in a_rows[i].items() if j != i),
+                          np.asarray(0, dtype=dtype).item())
+        if lump:
+            point_pass = int(pass_number[i])
+            for j in strong[i]:
+                if pass_number[j] < 0 or pass_number[j] >= point_pass:
+                    value = a_rows[i].get(j, np.asarray(0, dtype=dtype).item())
+                    diagonal += value
+                    offdiag_sum -= value
+
+        row_sum = sum(unscaled[i].values(), np.asarray(0, dtype=dtype).item())
+        if diagonal != 0 and row_sum != 0:
+            scale = -offdiag_sum / (diagonal * row_sum)
+            for column in list(unscaled[i]):
+                unscaled[i][column] *= scale
+
+    P = _rows_to_csr(unscaled, (n, int(np.sum(coarse))), dtype)
+    if trunc_value is not None:
+        P = truncate_interpolation(P, trunc_value)
+    if improve:
+        P = jacobi_improve_interpolation(A, P, splitting,
+                                         degree=improve, C=pattern)
+    return P
+
+
+def truncate_interpolation(P, theta):
+    """Drop small entries from each interpolation row and preserve its row sum."""
+    _validate_csr_matrix(P, 'P')
+    try:
+        theta = float(theta)
+    except (TypeError, ValueError, OverflowError) as exc:
+        raise ValueError('theta must be in [0, 1)') from exc
+    if not np.isfinite(theta) or theta < 0 or theta >= 1:
+        raise ValueError('theta must be in [0, 1)')
+
+    P = _canonical_copy(P)
+    dtype = np.result_type(P.dtype, np.float64)
+    rows = []
+    for i in range(P.shape[0]):
+        values = {int(P.indices[k]): np.asarray(P.data[k], dtype=dtype).item()
+                  for k in range(P.indptr[i], P.indptr[i + 1])}
+        if not values:
+            rows.append({})
+            continue
+        largest = max(abs(value) for value in values.values())
+        kept = {j: value for j, value in values.items()
+                if abs(value) >= theta * largest}
+        old_sum = sum(values.values(), np.asarray(0, dtype=dtype).item())
+        new_sum = sum(kept.values(), np.asarray(0, dtype=dtype).item())
+        if new_sum == 0:
+            # There is no finite rescaling that preserves the old row sum.
+            # In that case truncation leaves the complete row untouched.
+            rows.append(values)
+        else:
+            factor = old_sum / new_sum
+            rows.append({j: value * factor for j, value in kept.items()})
+
+    return _rows_to_csr(rows, P.shape, dtype)
+
+
+def jacobi_improve_interpolation(A, P, splitting, omega=4.0/3.0,
+                                 degree=1, C=None):
+    """Improve interpolation with weighted-Jacobi sweeps."""
+    _validate_csr_matrix(A, 'A')
+    _validate_csr_matrix(P, 'P')
+    if A.shape[0] != A.shape[1]:
+        raise ValueError(f'expected square matrix, shape={A.shape}')
+    if P.shape[0] != A.shape[0]:
+        raise ValueError('P has incompatible shape')
+    degree = _validate_whole_number(degree, 'degree', minimum=0)
+    try:
+        omega = float(omega)
+    except (TypeError, ValueError, OverflowError) as exc:
+        raise ValueError('omega must be positive') from exc
+    if not np.isfinite(omega) or omega <= 0:
+        raise ValueError('omega must be positive')
+
+    if C is not None:
+        _validate_csr_matrix(C, 'C')
+        if C.shape != A.shape:
+            raise ValueError('C has incompatible shape')
+        C = _canonical_copy(C)
+        C.eliminate_zeros()
+
+    splitting = np.asarray(splitting)
+    if splitting.ndim != 1 or splitting.size != A.shape[0]:
+        raise ValueError('splitting has incompatible shape')
+    coarse = splitting != 0
+    coarse_points = np.flatnonzero(coarse)
+    if P.shape[1] != coarse_points.size:
+        raise ValueError('P has an incompatible number of coarse columns')
+
+    dtype = np.result_type(A.dtype, P.dtype, np.float64)
+    A = _canonical_copy(A)
+    a_rows = []
+    for i in range(A.shape[0]):
+        row = {}
+        cset = None
+        if C is not None:
+            cset = set(int(j) for j in C.indices[C.indptr[i]:C.indptr[i + 1]])
+        for k in range(A.indptr[i], A.indptr[i + 1]):
+            j = int(A.indices[k])
+            value = np.asarray(A.data[k], dtype=dtype).item()
+            target = j if cset is None or j in cset else i
+            row[target] = row.get(target, np.asarray(0, dtype=dtype).item()) + value
+        a_rows.append(row)
+    A_work = _rows_to_csr(a_rows, A.shape, dtype)
+
+    current = _canonical_copy(P)
+    if degree == 0:
+        return _rows_to_csr([
+            {int(current.indices[k]): current.data[k]
+             for k in range(current.indptr[i], current.indptr[i + 1])}
+            for i in range(current.shape[0])], current.shape,
+            np.result_type(current.dtype, np.float64))
+
+    diagonal = np.asarray(A_work.diagonal(), dtype=dtype)
+    if np.any(diagonal == 0):
+        raise ValueError('zero diagonal in Jacobi improvement matrix')
+
+    coarse_map = np.full(A.shape[0], -1, dtype=np.intc)
+    coarse_map[coarse_points] = np.arange(coarse_points.size, dtype=np.intc)
+    for _ in range(degree):
+        AP = (A_work @ current).tocsr()
+        update = AP.copy()
+        for i in range(update.shape[0]):
+            update.data[update.indptr[i]:update.indptr[i + 1]] *= \
+                -omega / diagonal[i]
+        current = (current + update).tocsr()
+        current.sum_duplicates()
+        current.eliminate_zeros()
+        current.sort_indices()
+
+        rows = []
+        for i in range(current.shape[0]):
+            if coarse[i]:
+                rows.append({int(coarse_map[i]):
+                             np.asarray(1, dtype=np.result_type(current.dtype,
+                                                                 np.float64)).item()})
+            else:
+                rows.append({int(current.indices[k]): current.data[k]
+                             for k in range(current.indptr[i], current.indptr[i + 1])})
+        current = _rows_to_csr(rows, current.shape,
+                               np.result_type(current.dtype, np.float64))
+
+    return current
+
