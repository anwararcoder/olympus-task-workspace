@@ -0,0 +1,152 @@
+"""Sparsification of classical AMG coarse-grid operators."""
+
+import numpy as np
+from scipy.sparse import csr_array, issparse
+
+
+def _validate_theta(theta):
+    try:
+        valid_theta = (np.isscalar(theta)
+                       and not np.iscomplexobj(theta)
+                       and np.isfinite(theta)
+                       and theta >= 0 and theta < 1)
+    except (TypeError, ValueError):
+        valid_theta = False
+    if not valid_theta:
+        raise ValueError('theta must be in [0, 1)')
+
+
+def _vector_per_point(B, n, dtype):
+    if B is None:
+        return np.ones(n, dtype=np.result_type(dtype, float))
+    if issparse(B):
+        raise ValueError('B must be a vector')
+    result = np.asarray(B)
+    if result.ndim == 2 and 1 in result.shape:
+        result = result.reshape(-1)
+    if result.ndim != 1 or result.size != n:
+        raise ValueError('B must have one entry per point')
+    return result
+
+
+def sparsify_coarse_operator(A, theta=0.1, lump='diagonal', symmetric=True,
+                             B=None, protect=None):
+    """Sparsify a CSR coarse-grid operator while optionally preserving ``B``.
+
+    Off-diagonal entries smaller than ``theta`` times the largest off-diagonal
+    magnitude in their row are removed.  The optional lumping modes transfer
+    the removed contribution back into the matrix while preserving the action
+    of the result on ``B``.
+    """
+    if not issparse(A) or A.format != 'csr':
+        raise TypeError('expected csr_array for A')
+    if A.shape[0] != A.shape[1]:
+        raise ValueError('expected square matrix')
+    _validate_theta(theta)
+    if lump not in ('diagonal', 'strong', 'none'):
+        raise ValueError("lump must be 'diagonal', 'strong', or 'none'")
+    if not isinstance(symmetric, (bool, np.bool_)):
+        raise ValueError('symmetric must be boolean')
+
+    n = A.shape[0]
+    if protect is not None:
+        if not issparse(protect) or protect.format != 'csr':
+            raise TypeError('expected csr_array for protect')
+        if protect.shape != A.shape:
+            raise ValueError('protect must have the shape of A')
+        protect_work = protect.copy()
+        protect_work.sum_duplicates()
+    else:
+        protect_work = None
+
+    vector = _vector_per_point(B, n, A.dtype)
