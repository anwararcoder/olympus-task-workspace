+
+
+def _rows_to_csr(rows, shape, dtype=None):
+    if dtype is None:
+        dtype = np.float64
+    indptr = np.zeros(shape[0] + 1, dtype=np.intc)
+    for i, row in enumerate(rows):
+        if row:
+            row_keys = [j for j, value in row.items() if value != 0]
+            indptr[i + 1] = indptr[i] + len(row_keys)
+        else:
+            indptr[i + 1] = indptr[i]
+
+    nnz = int(indptr[-1])
+    indices = np.empty(nnz, dtype=np.intc)
+    data = np.empty(nnz, dtype=dtype)
+    cursor = 0
+    for row in rows:
+        if row:
+            for col in sorted(row):
+                value = row[col]
+                if value != 0:
+                    indices[cursor] = col
+                    data[cursor] = value
+                    cursor += 1
+    result = csr_array((data, indices, indptr), shape=shape)
+    result.eliminate_zeros()
+    result.sort_indices()
+    return result
