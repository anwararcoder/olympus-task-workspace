+"""Sparsification of classical AMG coarse operators."""
+
+import numpy as np
+from scipy.sparse import csr_array, issparse
+
+
+def _validate_theta(theta):
+    try:
+        if not np.isfinite(theta) or theta < 0 or theta >= 1:
+            raise ValueError('theta must be in [0,1)')
+    except (TypeError, ValueError) as e:
+        if isinstance(e, ValueError) and str(e) == 'theta must be in [0,1)':
+            raise
+        raise ValueError('theta must be a scalar') from e
+
+
+def _rows_to_csr(rows, shape, dtype, always_diagonal=False):
+    indptr = np.zeros(shape[0] + 1, dtype=np.intc)
+    for i, row in enumerate(rows):
+        indptr[i + 1] = indptr[i] + sum(
+            (value != 0) or (always_diagonal and col == i)
+            for col, value in row.items())
+    nnz = int(indptr[-1])
+    indices = np.empty(nnz, dtype=np.intc)
+    data = np.empty(nnz, dtype=dtype)
+    cursor = 0
+    for i, row in enumerate(rows):
+        for col in sorted(row):
+            value = row[col]
+            if value != 0 or (always_diagonal and col == i):
+                indices[cursor] = col
+                data[cursor] = value
+                cursor += 1
+    result = csr_array((data, indices, indptr), shape=shape)
+    if not always_diagonal:
+        result.eliminate_zeros()
+    result.sort_indices()
+    return result
