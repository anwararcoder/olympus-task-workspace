+def sparsify_coarse_operator(A, theta=0.1, lump='diagonal', symmetric=True,
+                             B=None, protect=None):
+    """Drop weak coarse-operator connections, optionally lumping them.
+
+    Parameters
+    ----------
+    A : csr_array
+        Square coarse operator.
+    theta : float in [0, 1), default 0.1
+        Relative row threshold for off-diagonal entries.
+    lump : {'diagonal', 'strong', 'none'}, default 'diagonal'
+        How dropped entries are treated.
+    symmetric : bool, default True
+        Keep the transpose of every retained off-diagonal entry when true.
+    B : array, optional
+        One value per point used when lumping.  Ones are used by default.
+    protect : csr_array, optional
+        Stored positions that must be retained when they already occur in A.
+    """
+    if not issparse(A) or A.format != 'csr':
+        raise TypeError('expected csr_array for A')
+    if A.shape[0] != A.shape[1]:
+        raise ValueError('expected square matrix for A')
+    _validate_theta(theta)
+    if lump not in ('diagonal', 'strong', 'none'):
+        raise ValueError("lump must be 'diagonal', 'strong', or 'none'")
+    if not isinstance(symmetric, (bool, np.bool_)):
+        raise ValueError('symmetric must be a boolean')
+    if protect is not None:
+        if not issparse(protect) or protect.format != 'csr':
+            raise TypeError('expected csr_array for protect')
+        if protect.shape != A.shape:
+            raise ValueError('protect has incompatible shape')
+
+    n = A.shape[0]
+    source = A.copy()
+    source.sum_duplicates()
+    source.sort_indices()
+
+    if B is None:
+        weights_vector = np.ones(n, dtype=np.result_type(A.dtype, np.float64))
+    else:
+        weights_vector = np.asarray(B)
+        if weights_vector.ndim == 2 and 1 in weights_vector.shape:
+            weights_vector = weights_vector.reshape(-1)
+        if weights_vector.ndim != 1 or weights_vector.size != n:
+            raise ValueError('B must contain one entry per point')
+        weights_vector = weights_vector.copy()
+        if not np.issubdtype(weights_vector.dtype, np.number):
+            raise ValueError('B must be numeric')
+    if lump != 'none' and np.any(weights_vector == 0):
+        raise ValueError('B may not contain zero entries when lumping')
+
+    rows = []
+    existing = []
+    for i in range(n):
+        row = {}
+        for p in range(source.indptr[i], source.indptr[i + 1]):
+            row[int(source.indices[p])] = source.data[p]
+        rows.append(row)
+        existing.append(set(row))
+
+    protected = [set() for _ in range(n)]
+    if protect is not None:
+        for i in range(n):
+            protected[i] = set(map(int, protect.indices[
+                protect.indptr[i]:protect.indptr[i + 1]]))
+
+    keep = [set() for _ in range(n)]
+    for i in range(n):
+        offdiag = [(j, value) for j, value in rows[i].items() if j != i]
+        largest = max((abs(value) for _, value in offdiag), default=0)
+        threshold = theta * largest
+        keep[i].update(j for j, value in offdiag if abs(value) >= threshold)
+        keep[i].update(j for j in protected[i] if j in existing[i] and j != i)
+
+    if symmetric:
+        # The transpose relation is an involution, so one union pass gives
+        # the symmetric closure while never inventing a missing A entry.
+        for i in range(n):
+            for j in tuple(keep[i]):
+                if i in existing[j]:
+                    keep[j].add(i)
+
+    result_rows = []
+    for i in range(n):
+        diagonal = rows[i].get(i, 0)
+        kept = {j: rows[i][j] for j in keep[i]}
+        dropped = [(j, value) for j, value in rows[i].items()
+                   if j != i and j not in keep[i]]
+
+        if lump != 'none':
+            dropped_image = sum((value * weights_vector[j]
+                                 for j, value in dropped),
+                                np.result_type(A.dtype, weights_vector.dtype).type(0))
+            if lump == 'diagonal':
+                diagonal += dropped_image / weights_vector[i]
+            elif dropped_image != 0:
+                share = sum((abs(value) * weights_vector[j]
+                             for j, value in kept.items()),
+                            np.result_type(A.dtype, weights_vector.dtype).type(0))
+                if share == 0:
+                    diagonal += dropped_image / weights_vector[i]
+                else:
+                    for j, value in kept.items():
+                        kept[j] = value + dropped_image * abs(value) / share
+
+        # A diagonal is mandatory, including a zero diagonal.
+        out = dict(kept)
+        out[i] = diagonal
+        result_rows.append(out)
+
+    dtype = np.result_type(A.dtype, weights_vector.dtype, np.float64)
+    # Off-diagonal numerical zeros are removed, while the diagonal remains
+    # stored even when its value is zero.
+    return _rows_to_csr(result_rows, A.shape, dtype, always_diagonal=True)
