+        new_points = []
+        new_rows = {}
+        new_lump = {}
+        for i in np.flatnonzero(~settled):
+            i = int(i)
+            row = {}
+            can_settle = False
+            for j, value in neighbours[i]:
+                if settled[j]:
+                    can_settle = True
+                    if coarse[j]:
+                        col = int(coarse_columns[j])
+                        row[col] = row.get(col, 0) + value
