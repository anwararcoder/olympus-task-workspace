+    offdiag_sum = np.zeros(n, dtype=A.dtype)
+    for i in range(n):
+        for p in range(A.indptr[i], A.indptr[i + 1]):
+            if A.indices[p] != i:
+                offdiag_sum[i] += A.data[p]
