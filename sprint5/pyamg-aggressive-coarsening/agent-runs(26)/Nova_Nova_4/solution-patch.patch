+def _validate_csr_square(A, name):
+    if not issparse(A) or A.format != 'csr':
+        raise TypeError(f'expected csr_array for {name}')
+    if A.shape[0] != A.shape[1]:
+        raise ValueError(f'expected square matrix for {name}')
+
+
+def _interpolation_pattern(A, C, theta, norm):
+    """Return a copy of the requested strength pattern."""
+    _validate_csr_square(A, 'A')
+    _validate_csr_square(C, 'C')
+    if A.shape != C.shape:
+        raise ValueError('A and C have incompatible shapes')
+    if norm not in ('min', 'abs'):
+        raise ValueError("norm must be either 'min' or 'abs'")
+    if theta is not None:
