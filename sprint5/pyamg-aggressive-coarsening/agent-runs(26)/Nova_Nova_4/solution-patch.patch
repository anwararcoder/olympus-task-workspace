+def aggressive_strength_of_connection(S, splitting, degree=2, paths=1):
+    """Build the coarse-point graph used by aggressive coarsening.
+
+    The graph is formed from the off-diagonal sparsity pattern of ``S``.  An
+    entry ``(i, j)`` counts fine points which occur on a path from coarse
+    point ``i`` to coarse point ``j`` of length no greater than ``degree``.
+    A fine point is counted only once for a given ordered pair, even if more
+    than one path contains it.
+    """
+    if not issparse(S) or S.format != 'csr':
+        raise TypeError('expected csr_array')
+    if S.shape[0] != S.shape[1]:
+        raise ValueError(f'expected square matrix, shape={S.shape}')
+    degree = _whole_number(degree, 'degree', minimum=2)
+    paths = _whole_number(paths, 'paths', minimum=1)
+    coarse = _validate_splitting(splitting, S.shape[0])
+
+    n = S.shape[0]
+    # Use the stored pattern deliberately.  In particular, this routine is a
+    # graph operation and does not inspect the values in S.
+    adjacency = [[] for _ in range(n)]
+    for i in range(n):
+        row = S.indices[S.indptr[i]:S.indptr[i + 1]]
+        adjacency[i] = sorted({int(j) for j in row if j != i})
+
+    fine = ~coarse
+
+    # Each row is a map from a coarse destination to the set of distinct
+    # fine witnesses.  Enumerating simple paths makes the meaning of "path"
+    # precise even when the strong graph contains directed cycles.  The
+    # default degree is two, so this remains a local edge-neighbour operation
+    # for the usual AMG case.
+    witnesses = {}
+    for source in np.flatnonzero(coarse):
+        source = int(source)
+        stack = [(source, 0, {source}, ())]
+        while stack:
+            current, distance, visited, fine_path = stack.pop()
+            for destination in adjacency[current]:
+                next_distance = distance + 1
+                if destination in visited:
+                    continue
+                if coarse[destination]:
+                    if (destination != source and fine_path and
+                            next_distance <= degree):
+                        witnesses.setdefault((source, int(destination)), set()).update(
+                            fine_path)
+                elif next_distance < degree:
+                    stack.append((int(destination), next_distance,
+                                  visited | {int(destination)},
+                                  fine_path + (int(destination),)))
+
+    rows = [[] for _ in range(n)]
+    for (source, destination), fine_witnesses in witnesses.items():
+        if len(fine_witnesses) >= paths:
+            rows[source].append((destination, len(fine_witnesses)))
+
+    indptr = np.zeros(n + 1, dtype=np.intc)
+    for i, row in enumerate(rows):
+        row.sort(key=lambda item: item[0])
+        indptr[i + 1] = indptr[i] + len(row)
+    nnz = int(indptr[-1])
+    indices = np.empty(nnz, dtype=np.intc)
+    data = np.empty(nnz, dtype=np.intc)
+    cursor = 0
+    for row in rows:
+        for col, value in row:
+            indices[cursor] = col
+            data[cursor] = value
+            cursor += 1
+
+    return csr_array((data, indices, indptr), shape=(n, n))
+
+
+def aggressive_coarsening(S, degree=2, paths=1, second_pass=False, method='RS'):
+    """Perform two-stage, or aggressive, classical AMG coarsening."""
+    if not issparse(S) or S.format != 'csr':
+        raise TypeError('expected csr_array')
+    if S.shape[0] != S.shape[1]:
+        raise ValueError(f'expected square matrix, shape={S.shape}')
+    degree = _whole_number(degree, 'degree', minimum=2)
+    paths = _whole_number(paths, 'paths', minimum=1)
+    if not isinstance(second_pass, (bool, np.bool_)):
+        raise ValueError('second_pass must be a boolean')
+    if method not in ('RS', 'PMIS', 'CLJP'):
+        raise ValueError(f'Unknown aggressive coarsening method {method}')
+
+    if method == 'RS':
+        first = RS(S, second_pass=bool(second_pass))
+    elif method == 'PMIS':
+        first = PMIS(S)
+    else:
+        first = CLJP(S)
+
+    long_range = aggressive_strength_of_connection(S, first, degree, paths)
+    if method == 'RS':
+        second = RS(long_range, second_pass=bool(second_pass))
+    elif method == 'PMIS':
+        second = PMIS(long_range)
+    else:
+        second = CLJP(long_range)
+
+    has_connection = (np.diff(long_range.indptr) != 0)
+    has_connection |= (np.diff(long_range.T.tocsr().indptr) != 0)
+    result = np.zeros(S.shape[0], dtype='intc')
+    # Isolated first-stage coarse points are retained.  First-stage fine
+    # points can never become coarse in the second stage.
+    result[first != 0] = 1
+    result[first != 0] &= (~has_connection[first != 0] |
+                            (second[first != 0] != 0))
+    return result
