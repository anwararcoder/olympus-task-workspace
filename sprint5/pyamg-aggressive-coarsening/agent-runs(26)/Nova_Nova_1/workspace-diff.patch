+                                  max_coarse=10)
+    assert len(ml.levels) >= 3
+    assert ml.levels[0].A.nnz == A.nnz
+    dropped = 0
+    for fine, coarse in zip(ml.levels[:-1], ml.levels[1:]):
+        galerkin = (fine.R @ fine.A @ fine.P).tocsr()
+        dropped += galerkin.nnz - coarse.A.nnz
