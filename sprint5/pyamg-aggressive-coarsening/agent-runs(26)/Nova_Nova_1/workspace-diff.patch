+def _csr_from_row_maps(rows, shape, dtype, index_dtype):
+    indptr = np.zeros(shape[0] + 1, dtype=index_dtype)
+    indices = []
+    data = []
+    for i, row in enumerate(rows):
+        clean = [(int(j), value) for j, value in row.items() if value != 0]
+        clean.sort(key=lambda item: item[0])
+        indices.extend(j for j, _ in clean)
+        data.extend(value for _, value in clean)
