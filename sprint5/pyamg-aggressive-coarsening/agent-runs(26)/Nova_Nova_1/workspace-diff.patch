+    C.eliminate_zeros()
+    C.sum_duplicates()
+    C.sort_indices()
+    C.data[:] = 1
+    strong = C.multiply(A).tocsr()
+    strong.eliminate_zeros()
+    strong.sum_duplicates()
+    strong.sort_indices()
