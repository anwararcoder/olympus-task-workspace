+def _threshold(value, name):
+    if isinstance(value, (bool, np.bool_)) or not isinstance(
+            value, (int, float, np.integer, np.floating)):
+        raise ValueError(f'{name} must be in [0, 1)')
+    value = float(value)
+    if not np.isfinite(value) or value < 0 or value >= 1:
+        raise ValueError(f'{name} must be in [0, 1)')
