+"""Sparsification of classical AMG coarse operators."""
+
+import numpy as np
+from scipy.sparse import csr_array, issparse
+
+
+def _threshold(theta):
+    if isinstance(theta, (bool, np.bool_)) or not isinstance(
+            theta, (int, float, np.integer, np.floating)):
+        raise ValueError('theta must be in [0, 1)')
+    theta = float(theta)
+    if not np.isfinite(theta) or theta < 0 or theta >= 1:
+        raise ValueError('theta must be in [0, 1)')
+    return theta
+
+
+def sparsify_coarse_operator(A, theta=0.1, lump='diagonal', symmetric=True,
+                             B=None, protect=None):
+    """Drop weak coarse-operator couplings and optionally lump their image.
+
+    The retained pattern is selected row by row and then made symmetric when
+    requested.  Lumping is performed on the image of ``B`` so that the
+    resulting operator has the same action on that vector.
+    """
+    if not issparse(A) or A.format != 'csr':
+        raise TypeError('expected csr_array for A')
+    if A.shape[0] != A.shape[1]:
+        raise ValueError('expected square matrix')
+    theta = _threshold(theta)
+    if lump not in ('diagonal', 'strong', 'none'):
+        raise ValueError("lump must be 'diagonal', 'strong', or 'none'")
+    if not isinstance(symmetric, (bool, np.bool_)):
+        raise ValueError('symmetric must be a boolean')
+    if protect is not None:
+        if not issparse(protect) or protect.format != 'csr':
+            raise TypeError('expected csr_array for protect')
+        if protect.shape != A.shape:
+            raise ValueError('protect must have the same shape as A')
+
+    A_work = A.copy()
+    A_work.eliminate_zeros()
+    A_work.sum_duplicates()
+    A_work.sort_indices()
+    n = A.shape[0]
+
+    if B is None:
+        B = np.ones(n, dtype=np.result_type(A.dtype, np.float64))
+    else:
+        B = np.asarray(B)
+        if B.ndim == 2 and B.shape == (n, 1):
+            B = B[:, 0]
+        if B.ndim != 1 or B.size != n:
+            raise ValueError('B must have one entry per point')
+        if not np.issubdtype(B.dtype, np.number):
+            raise ValueError('B must be numeric')
+        if not np.all(np.isfinite(B)):
+            raise ValueError('B must be finite')
+        B = B.copy()
+    if lump != 'none' and np.any(B == 0):
+        raise ValueError('B may not contain zero entries when lumping')
+
+    protected = [set() for _ in range(n)]
+    if protect is not None:
+        for i in range(n):
+            start, stop = protect.indptr[i:i + 2]
+            protected[i].update(int(j) for j in protect.indices[start:stop])
+
+    entries = []
+    selected = [set() for _ in range(n)]
+    for i in range(n):
+        start, stop = A_work.indptr[i:i + 2]
+        row = {int(j): value for j, value in
+               zip(A_work.indices[start:stop], A_work.data[start:stop])}
+        entries.append(row)
+        offdiag = [(j, value) for j, value in row.items() if j != i]
+        maximum = max((abs(value) for _, value in offdiag), default=0)
+        for j, value in offdiag:
+            if abs(value) >= theta * maximum or j in protected[i]:
+                selected[i].add(j)
+
+    if symmetric:
+        for i in range(n):
+            for j in tuple(selected[i]):
+                if i in entries[j]:
+                    selected[j].add(i)
+
+    dtype = np.result_type(A.dtype, B.dtype, np.float64)
+    result_rows = []
+    for i in range(n):
+        row = entries[i]
+        output = {}
+        diagonal = row.get(i, dtype.type(0))
+        kept = []
+        dropped_image = dtype.type(0)
+        for j, value in row.items():
+            if j == i:
+                continue
+            if j in selected[i]:
+                output[j] = value
+                kept.append((j, value))
+            else:
+                dropped_image += value * B[j]
+
+        if lump == 'diagonal':
+            diagonal += dropped_image / B[i]
+        elif lump == 'strong' and dropped_image != 0:
+            share = sum((abs(value) * B[j] for j, value in kept),
+                        dtype.type(0))
+            if share != 0:
+                for j, value in kept:
+                    output[j] += dropped_image * abs(value) / share
+            else:
+                diagonal += dropped_image / B[i]
+
+        # The diagonal is retained even when A did not store one.  In
+        # particular, this makes a sparsified operator's pattern explicit.
+        output[i] = diagonal
+        result_rows.append(output)
+
+    indptr = np.zeros(n + 1, dtype=A_work.indptr.dtype)
+    indices = []
+    data = []
+    for i, row in enumerate(result_rows):
+        clean = [(j, value) for j, value in row.items()
+                 if j == i or value != 0]
+        clean.sort(key=lambda item: item[0])
+        indices.extend(j for j, _ in clean)
+        data.extend(value for _, value in clean)
+        indptr[i + 1] = len(indices)
+    result = csr_array((np.asarray(data, dtype=dtype),
+                        np.asarray(indices, dtype=A_work.indices.dtype),
+                        indptr), shape=A.shape)
+    result.eliminate_zeros()
+    # eliminate_zeros deliberately removes zero off-diagonal entries; restore
+    # a missing/zero diagonal because it is part of this routine's contract.
+    missing = np.diff(result.indptr) == 0
+    if np.any(missing):
+        result = result.tolil()
+        for i in np.flatnonzero(missing):
+            result.rows[i] = [int(i)]
+            result.data[i] = [dtype.type(0)]
+        result = result.tocsr()
+    else:
+        diagonal_present = np.zeros(n, dtype=bool)
+        for i in range(n):
+            start, stop = result.indptr[i:i + 2]
+            diagonal_present[i] = i in result.indices[start:stop]
+        if not np.all(diagonal_present):
+            result = result.tolil()
+            for i in np.flatnonzero(~diagonal_present):
+                result.rows[i].append(int(i))
+                result.data[i].append(dtype.type(0))
+            result = result.tocsr()
+    result.sum_duplicates()
+    result.sort_indices()
+    return csr_array(result)
