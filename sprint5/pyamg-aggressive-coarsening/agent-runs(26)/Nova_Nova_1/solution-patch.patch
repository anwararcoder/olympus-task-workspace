+        pattern.eliminate_zeros()
+        pattern.sum_duplicates()
+        pattern.data[:] = 1
+        restricted = pattern.multiply(A).tocsr()
+        restricted.eliminate_zeros()
+        # A - restricted consists of entries outside C's pattern.  Adding its
+        # row sums to the diagonal is the requested Jacobi lumping.
+        remaining_sum = np.asarray((A - restricted).sum(axis=1)).ravel()
+        effective = restricted.copy()
+        effective.setdiag(effective.diagonal() + remaining_sum)
+        effective.sum_duplicates()
+        effective.eliminate_zeros()
+        effective.sort_indices()
+    else:
+        effective = A.copy()
+
+    result = P.copy()
+    result.eliminate_zeros()
+    result.sum_duplicates()
+    result.sort_indices()
+
+    if degree == 0:
+        return result
+    diagonal = np.asarray(effective.diagonal())
+    if np.any(diagonal == 0):
+        raise ValueError('zero diagonal in Jacobi improvement matrix')
+
+    inverse_diagonal = 1.0 / diagonal
+    coarse_columns = np.full(A.shape[0], -1, dtype=np.intp)
+    coarse_columns[coarse] = np.arange(np.count_nonzero(coarse), dtype=np.intp)
+    for _ in range(degree):
+        result = result - omega * (diags(inverse_diagonal) @
+                                   (effective @ result))
+        result = result.tolil()
+        for i in np.flatnonzero(coarse):
+            result.rows[i] = [int(coarse_columns[i])]
+            result.data[i] = [1]
+        result = result.tocsr()
+        result.eliminate_zeros()
+        result.sort_indices()
+    return csr_array(result)
+
