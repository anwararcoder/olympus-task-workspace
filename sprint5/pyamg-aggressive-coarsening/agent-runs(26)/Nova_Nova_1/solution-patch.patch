+def _whole_number(value, name, minimum=0):
+    """Validate an integer-valued option used by the pure-Python routines."""
+    if isinstance(value, (bool, np.bool_)) or not isinstance(value,
+                                                              (int, np.integer)):
+        raise ValueError(f'{name} must be a whole number')
+    value = int(value)
+    if value < minimum:
+        raise ValueError(f'{name} must be at least {minimum}')
+    return value
+
+
+def _validate_splitting(splitting, n):
+    splitting = np.asarray(splitting)
+    if splitting.ndim != 1 or splitting.size != n:
+        raise ValueError('splitting must have one entry per point')
+    return splitting != 0
+
+
+def aggressive_strength_of_connection(S, splitting, degree=2, paths=1):
+    """Build the long-range strength graph used by aggressive coarsening.
+
+    An entry ``(i, j)`` counts the distinct fine points on strong paths from
+    coarse point ``i`` to coarse point ``j``.  Paths have at most ``degree``
+    edges and all of their intermediate points are fine.  The graph is
+    directed: the pattern of ``S`` is used as supplied.
+    """
+    if not issparse(S) or S.format != 'csr':
+        raise TypeError('expected csr_array')
+    if S.shape[0] != S.shape[1]:
+        raise ValueError('expected square matrix')
+    degree = _whole_number(degree, 'degree', minimum=2)
+    paths = _whole_number(paths, 'paths', minimum=1)
+    coarse = _validate_splitting(splitting, S.shape[0])
+
+    # Only the off-diagonal, nonzero pattern is a graph edge.  Work from a
+    # copy so that elimination and sorting do not change the caller's matrix.
+    graph = S.copy()
+    graph.eliminate_zeros()
+    graph = remove_diagonal(graph)
+    graph.sort_indices()
+
+    rows = []
+    cols = []
+    data = []
+    for source in np.flatnonzero(coarse):
+        found = {}
+        stack = [(source, 0, frozenset())]
+        while stack:
+            node, depth, visited = stack.pop()
+            start, stop = graph.indptr[node:node + 2]
+            for target in graph.indices[start:stop]:
+                edge_depth = depth + 1
+                if edge_depth > degree:
+                    continue
+                if coarse[target]:
+                    # A direct C-C edge has no fine point to count.  The
+                    # diagonal is deliberately never emitted.
+                    if target != source and visited:
+                        found.setdefault(int(target), set()).update(visited)
+                elif edge_depth < degree and target not in visited:
+                    stack.append((int(target), edge_depth,
+                                  visited | frozenset((int(target),))))
+
+        for target in sorted(found):
+            count = len(found[target])
+            if count >= paths:
+                rows.append(source)
+                cols.append(target)
+                data.append(count)
+
+    if data:
+        indptr = np.zeros(S.shape[0] + 1, dtype=graph.indptr.dtype)
+        np.add.at(indptr, np.asarray(rows, dtype=np.intp) + 1, 1)
+        np.cumsum(indptr, out=indptr)
+        result = csr_array((np.asarray(data, dtype='intc'),
+                            np.asarray(cols, dtype=graph.indices.dtype),
+                            indptr), shape=S.shape)
+    else:
+        result = csr_array((S.shape[0], S.shape[1]), dtype='intc')
+    result.eliminate_zeros()
+    result.sort_indices()
+    return result
+
+
+def aggressive_coarsening(S, degree=2, paths=1, second_pass=False,
+                          method='RS'):
+    """Perform two-stage aggressive classical AMG coarsening.
+
+    The first splitting is used to build a long-range C-point graph.  The
+    second splitting is applied to that graph, while first-stage F-points
+    remain fine and isolated first-stage C-points remain coarse.
+    """
+    if not issparse(S) or S.format != 'csr':
+        raise TypeError('expected csr_array')
+    if S.shape[0] != S.shape[1]:
+        raise ValueError('expected square matrix')
+    degree = _whole_number(degree, 'degree', minimum=2)
+    paths = _whole_number(paths, 'paths', minimum=1)
+    if not isinstance(second_pass, (bool, np.bool_)):
+        raise ValueError('second_pass must be a boolean')
+    if method not in ('RS', 'PMIS', 'CLJP'):
+        raise ValueError(f'Unknown aggressive coarsening method {method}')
+
+    def split_method(graph):
+        if method == 'RS':
+            return RS(graph, second_pass=second_pass)
+        if method == 'PMIS':
+            return PMIS(graph)
+        return CLJP(graph)
+
+    first = split_method(S)
+    first_coarse = first != 0
+    long_range = aggressive_strength_of_connection(S, first, degree, paths)
+    second = split_method(long_range)
+
+    # The long-range graph contains only first-stage C-points.  Its isolated
+    # points are explicitly retained as C-points; any point that was fine in
+    # stage one is explicitly retained as an F-point.
+    active = (np.diff(long_range.indptr) != 0)
+    active |= (np.diff(long_range.T.tocsr().indptr) != 0)
+    result = np.zeros(S.shape[0], dtype='intc')
+    result[first_coarse & ~active] = 1
+    result[first_coarse & active] = (second[first_coarse & active] != 0)
+    return result
+
