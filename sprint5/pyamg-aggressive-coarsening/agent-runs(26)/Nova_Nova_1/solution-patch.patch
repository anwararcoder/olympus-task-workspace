+def _whole_number(value, name, minimum=0):
+    if isinstance(value, (bool, np.bool_)) or not isinstance(value,
+                                                              (int, np.integer)):
+        raise ValueError(f'{name} must be a whole number')
+    value = int(value)
+    if value < minimum:
+        raise ValueError(f'{name} must be at least {minimum}')
+    return value
+
+
+def _threshold(value, name):
+    if isinstance(value, (bool, np.bool_)) or not isinstance(
+            value, (int, float, np.integer, np.floating)):
+        raise ValueError(f'{name} must be in [0, 1)')
+    value = float(value)
+    if not np.isfinite(value) or value < 0 or value >= 1:
+        raise ValueError(f'{name} must be in [0, 1)')
+    return value
+
+
+def _validate_interpolation_inputs(A, C, splitting):
+    if not issparse(A) or A.format != 'csr':
+        raise TypeError('expected csr_array for A')
+    if not issparse(C) or C.format != 'csr':
+        raise TypeError('expected csr_array for C')
+    if A.shape[0] != A.shape[1] or C.shape != A.shape:
+        raise ValueError('A and C must be square matrices of the same shape')
+    splitting = np.asarray(splitting)
+    if splitting.ndim != 1 or splitting.size != A.shape[0]:
+        raise ValueError('splitting must have one entry per point')
+    return splitting != 0
+
+
+def _strength_entries(A, C, theta, norm):
+    """Return A restricted to the requested strength pattern."""
+    if norm not in ('min', 'abs'):
+        raise ValueError("norm must be either 'min' or 'abs'")
+    if theta is not None:
+        theta = _threshold(theta, 'theta')
+        C = classical_strength_of_connection(A, theta=theta, norm=norm)
+    else:
+        C = C.copy()
+
+    C.eliminate_zeros()
+    C.sum_duplicates()
+    C.sort_indices()
+    C.data[:] = 1
+    strong = C.multiply(A).tocsr()
+    strong.eliminate_zeros()
+    strong.sum_duplicates()
+    strong.sort_indices()
+    return strong, C
+
+
+def _csr_from_row_maps(rows, shape, dtype, index_dtype):
+    indptr = np.zeros(shape[0] + 1, dtype=index_dtype)
+    indices = []
+    data = []
+    for i, row in enumerate(rows):
+        clean = [(int(j), value) for j, value in row.items() if value != 0]
+        clean.sort(key=lambda item: item[0])
+        indices.extend(j for j, _ in clean)
+        data.extend(value for _, value in clean)
+        indptr[i + 1] = len(indices)
+    result = csr_array((np.asarray(data, dtype=dtype),
+                        np.asarray(indices, dtype=index_dtype), indptr),
+                       shape=shape)
+    result.eliminate_zeros()
+    result.sort_indices()
+    return result
+
+
+def _multipass_rows(A, C, splitting, theta, norm, lump, max_passes):
+    coarse = _validate_interpolation_inputs(A, C, splitting)
+    strong, C_pattern = _strength_entries(A, C, theta, norm)
+    n = A.shape[0]
+    nc = int(np.count_nonzero(coarse))
+    coarse_column = np.full(n, -1, dtype=np.intp)
+    coarse_column[coarse] = np.arange(nc, dtype=np.intp)
+    dtype = np.result_type(A.dtype, np.float64)
+
+    rows = [dict() for _ in range(n)]
+    for i in np.flatnonzero(coarse):
+        rows[i][int(coarse_column[i])] = dtype.type(1)
+
+    # Strong neighbours are taken from A restricted to C, rather than from C's
+    # values.  A diagonal is not a neighbour for the pass construction.
+    neighbours = []
+    for i in range(n):
+        start, stop = strong.indptr[i:i + 2]
+        neighbours.append([(int(j), value) for j, value in
+                           zip(strong.indices[start:stop],
+                               strong.data[start:stop]) if j != i])
+
+    settled = coarse.copy()
+    pass_number = -np.ones(n, dtype='intc')
+    pass_number[coarse] = 0
+    effective_diagonal = np.asarray(A.diagonal(), dtype=dtype)
+    if lump:
+        for i in range(n):
+            if not settled[i]:
+                # This is updated at the pass on which i settles.  Keeping a
+                # separate vector avoids changing A or the strength pattern.
+                effective_diagonal[i] = A.diagonal()[i]
+
+    current_pass = 1
+    while max_passes is None or current_pass <= max_passes:
+        old_settled = settled.copy()
+        new_points = []
+        for i in np.flatnonzero(~old_settled):
+            usable = [(j, value) for j, value in neighbours[i]
+                      if old_settled[j]]
+            if not usable:
+                continue
+
+            row = {}
+            diagonal = A.diagonal()[i]
+            for j, value in neighbours[i]:
+                if old_settled[j]:
+                    if coarse[j]:
+                        column = int(coarse_column[j])
+                        row[column] = row.get(column, 0) + value
+                    else:
+                        for column, neighbour_value in rows[j].items():
+                            row[column] = (row.get(column, 0) +
+                                           value * neighbour_value)
+                elif lump:
+                    diagonal += value
+            rows[i] = row
+            effective_diagonal[i] = diagonal
+            new_points.append(i)
+
+        if not new_points:
+            break
+        settled[new_points] = True
+        pass_number[new_points] = current_pass
+        current_pass += 1
+
+    return (rows, pass_number, settled, effective_diagonal, C_pattern,
+            coarse, dtype)
+
+
+def interpolation_passes(A, C, splitting, theta=None, norm='min'):
+    """Report the pass on which each point becomes available to interpolate."""
+    rows, passes, _, _, _, _, _ = _multipass_rows(A, C, splitting, theta,
+                                                   norm, False, None)
+    del rows
+    return passes
+
+
+def multipass_interpolation(A, C, splitting, theta=None, norm='min',
+                            trunc=None, improve=0, strict=False, lump=False,
+                            max_passes=None):
+    """Create interpolation by repeatedly extending settled fine points."""
+    if max_passes is not None:
+        max_passes = _whole_number(max_passes, 'max_passes', minimum=1)
+    improve = _whole_number(improve, 'improve', minimum=0)
+    if not isinstance(lump, (bool, np.bool_)):
+        raise ValueError('lump must be a boolean')
+    if not isinstance(strict, (bool, np.bool_)):
+        raise ValueError('strict must be a boolean')
+    if trunc is not None:
+        trunc = _threshold(trunc, 'trunc')
+
+    rows, passes, settled, diagonal, C_pattern, coarse, dtype = \
+        _multipass_rows(A, C, splitting, theta, norm, bool(lump), max_passes)
+    if strict and not np.all(settled):
+        raise ValueError('some fine points were not settled by multipass interpolation')
+
+    # Scaling is deliberately delayed until all passes have been constructed.
+    for i in np.flatnonzero((passes > 0)):
+        row_sum = sum(rows[i].values(), dtype.type(0))
+        if row_sum == 0 or diagonal[i] == 0:
+            continue
+        off_diagonal_sum = 0
+        start, stop = A.indptr[i:i + 2]
+        for j, value in zip(A.indices[start:stop], A.data[start:stop]):
+            if j != i:
+                off_diagonal_sum += value
+        scale = -off_diagonal_sum / (diagonal[i] * row_sum)
+        for column in list(rows[i]):
+            rows[i][column] *= scale
+
+    P = _csr_from_row_maps(rows, (A.shape[0], int(np.count_nonzero(coarse))),
+                            dtype, A.indptr.dtype)
+    if trunc is not None:
+        P = truncate_interpolation(P, trunc)
+    if improve:
+        P = jacobi_improve_interpolation(A, P, splitting, degree=improve,
+                                         C=C_pattern)
+    return P
+
+
+def truncate_interpolation(P, theta):
+    """Drop small interpolation entries and preserve each retained row sum."""
+    if not issparse(P) or P.format != 'csr':
+        raise TypeError('expected csr_array for P')
+    theta = _threshold(theta, 'theta')
+    rows = []
+    for i in range(P.shape[0]):
+        start, stop = P.indptr[i:i + 2]
+        indices = P.indices[start:stop]
+        values = P.data[start:stop]
+        if values.size == 0:
+            rows.append({})
+            continue
+        maximum = np.max(np.abs(values))
+        keep = np.abs(values) >= theta * maximum
+        old_sum = values.sum()
+        kept_sum = values[keep].sum()
+        if kept_sum == 0:
+            # A zero denominator means that this row cannot be rescaled while
+            # retaining its row sum.  Keep the original row intact.
+            rows.append({int(j): value for j, value in zip(indices, values)
+                         if value != 0})
+            continue
+        values = values[keep] * (old_sum / kept_sum)
+        rows.append({int(j): value for j, value in zip(indices[keep], values)
+                     if value != 0})
+    return _csr_from_row_maps(rows, P.shape, P.dtype, P.indptr.dtype)
+
+
+def jacobi_improve_interpolation(A, P, splitting, omega=4.0 / 3.0,
+                                  degree=1, C=None):
+    """Improve interpolation with weighted-Jacobi sweeps."""
+    if not issparse(A) or A.format != 'csr':
+        raise TypeError('expected csr_array for A')
+    if not issparse(P) or P.format != 'csr':
+        raise TypeError('expected csr_array for P')
+    if A.shape[0] != A.shape[1] or P.shape[0] != A.shape[0]:
+        raise ValueError('A and P have incompatible shapes')
+    splitting = np.asarray(splitting)
+    if splitting.ndim != 1 or splitting.size != A.shape[0]:
+        raise ValueError('splitting must have one entry per point')
+    coarse = splitting != 0
+    if P.shape[1] != np.count_nonzero(coarse):
+        raise ValueError('P has the wrong number of coarse columns')
+    degree = _whole_number(degree, 'degree', minimum=0)
+    if isinstance(omega, (bool, np.bool_)):
+        raise ValueError('omega must be positive')
+    try:
+        omega = float(omega)
+    except (TypeError, ValueError):
+        raise ValueError('omega must be positive') from None
+    if not np.isfinite(omega) or omega <= 0:
+        raise ValueError('omega must be positive')
+    if C is not None:
+        if not issparse(C) or C.format != 'csr':
+            raise TypeError('expected csr_array for C')
+        if C.shape != A.shape:
+            raise ValueError('C must have the same shape as A')
