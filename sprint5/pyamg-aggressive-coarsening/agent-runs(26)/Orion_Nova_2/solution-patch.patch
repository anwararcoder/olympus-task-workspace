+"""Sparsification of coarse operators for classical AMG."""
+
+import numpy as np
+from scipy.sparse import csr_array, issparse
+
+
+def _valid_theta(theta):
+    """Validate and return a sparsification threshold."""
+    if (not np.isscalar(theta) or isinstance(theta, (str, bytes))
+            or np.iscomplexobj(theta)):
+        raise ValueError('theta must be in [0, 1)')
+    try:
+        valid = np.isfinite(theta) and 0 <= theta < 1
+    except TypeError as error:
+        raise ValueError('theta must be in [0, 1)') from error
+    if not valid:
+        raise ValueError('theta must be in [0, 1)')
+    return theta
+
+
+def sparsify_coarse_operator(A, theta=0.1, lump='diagonal', symmetric=True,
+                             B=None, protect=None):
+    """Drop weak coarse-operator entries and optionally lump their action."""
+    if not issparse(A) or A.format != 'csr':
+        raise TypeError('expected csr_array for A')
+    if A.shape[0] != A.shape[1]:
+        raise ValueError('expected a square matrix')
+    theta = _valid_theta(theta)
+    if lump not in ('diagonal', 'strong', 'none'):
+        raise ValueError("lump must be 'diagonal', 'strong', or 'none'")
+    if not isinstance(symmetric, (bool, np.bool_)):
+        raise ValueError('symmetric must be a boolean')
+    if protect is not None:
+        if not issparse(protect) or protect.format != 'csr':
+            raise TypeError('expected csr_array for protect')
+        if protect.shape != A.shape:
+            raise ValueError('protect has incompatible shape')
+
+    n = A.shape[0]
+    if B is None:
+        B = np.ones(n, dtype=A.dtype)
+    else:
+        B = np.asarray(B)
+        if B.size != n:
+            raise ValueError('B must hold one entry per point')
+        B = B.reshape(-1)
+    if not (np.issubdtype(B.dtype, np.number) or np.issubdtype(B.dtype, np.bool_)):
+        raise ValueError('B must be numeric')
+    if lump != 'none' and np.any(B == 0):
+        raise ValueError('B must be nonzero when lumping')
+
+    source = A.copy()
+    source.sum_duplicates()
+    source.eliminate_zeros()
+    source.sort_indices()
+    dtype = np.result_type(source.dtype, B.dtype)
+    if not np.issubdtype(dtype, np.inexact):
+        dtype = np.dtype(float)
+
+    protected = [set() for _ in range(n)]
+    if protect is not None:
+        for row in range(n):
+            protected[row].update(map(int, protect.indices[
+                protect.indptr[row]:protect.indptr[row + 1]]))
+
+    keep = [set() for _ in range(n)]
+    for row in range(n):
+        start, end = source.indptr[row], source.indptr[row + 1]
+        columns = source.indices[start:end]
+        values = source.data[start:end]
+        offdiag = columns != row
+        maximum = np.max(np.abs(values[offdiag]), initial=0)
+        for column, value in zip(columns[offdiag], values[offdiag], strict=True):
+            if (np.abs(value) >= theta * maximum) or (int(column) in protected[row]):
+                keep[row].add(int(column))
+
+    if symmetric:
+        threshold_keep = [row.copy() for row in keep]
+        for row in range(n):
+            start, end = source.indptr[row], source.indptr[row + 1]
+            for column in source.indices[start:end]:
+                column = int(column)
+                if column != row and row in threshold_keep[column]:
+                    keep[row].add(column)
+
+    indptr = np.zeros(n + 1, dtype=source.indptr.dtype)
+    indices = []
+    data = []
+    for row in range(n):
+        start, end = source.indptr[row], source.indptr[row + 1]
+        entries = {int(column): value for column, value in
+                   zip(source.indices[start:end], source.data[start:end], strict=True)}
+        diagonal = dtype.type(entries.get(row, 0))
