+
+def test_the_entry_counts_distinct_fine_points():
+    S = star()
+    result = long_range(S, marks(1, 0, 0, 1, 1))
+    assert result[[0], [3]] == 1.0
+    assert result[[0], [4]] == 1.0
+
+
+def test_two_paths_through_one_fine_point_count_once():
+    S = matrix([[2.0, -1.0, 0.0], [-1.0, 2.0, -1.0], [0.0, -1.0, 2.0]])
+    result = long_range(S, marks(1, 0, 1))
+    assert result[[0], [2]] == 1.0
+
+
