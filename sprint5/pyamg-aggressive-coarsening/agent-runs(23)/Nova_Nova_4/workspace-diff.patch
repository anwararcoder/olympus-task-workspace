+    each ordered pair of coarse points, the value is the number of distinct
+    fine points occurring on at least one strong path between the pair whose
+    length is no greater than ``degree``.  Paths are allowed to share fine
+    points; a shared point is counted only once.
+
+    Parameters
+    ----------
+    S : csr_array
+        Strength-of-connection graph.
+    splitting : array_like
+        Nonzero entries identify coarse points.
+    degree : int, default 2
+        Maximum path length.  Must be at least two.
+    paths : int, default 1
+        Minimum number of distinct fine points needed to retain an entry.
+
+    Returns
+    -------
+    csr_array
+        A square integer matrix with entries only in coarse rows and columns.
+    """
+    if not issparse(S) or S.format != 'csr':
+        raise TypeError('expected csr_array')
+    if S.shape[0] != S.shape[1]:
+        raise ValueError(f'expected square matrix, shape={S.shape}')
+
+    degree = _whole_number(degree, 'degree', minimum=2)
+    paths = _whole_number(paths, 'paths', minimum=1)
+
+    splitting = np.asarray(splitting)
+    if splitting.ndim != 1 or splitting.shape[0] != S.shape[0]:
+        raise ValueError('splitting must have one entry per point')
+
+    n = S.shape[0]
+    coarse = splitting != 0
+    coarse_points = np.flatnonzero(coarse)
+    fine_points = ~coarse
+
+    # Work with the sparsity pattern only.  In particular, explicit zeros do
+    # not constitute strong graph edges, and the input must remain untouched.
+    graph = S.copy()
+    graph.sum_duplicates()
+    graph.eliminate_zeros()
+    graph.sort_indices()
+    adjacency = []
+    for i in range(n):
+        start, stop = graph.indptr[i], graph.indptr[i + 1]
+        adjacency.append(graph.indices[start:stop]
+                         [graph.indices[start:stop] != i])
+
+    # Give fine points bit positions.  A Python integer is a compact set of
+    # fine points and lets us union all paths without counting duplicate paths.
+    fine_number = np.full(n, -1, dtype=np.int64)
+    fine_number[np.flatnonzero(fine_points)] = np.arange(np.count_nonzero(fine_points))
+
+    rows = []
+    cols = []
+    data = []
+
+    for source in coarse_points:
+        # States at a fixed depth are (fine endpoint -> all fine points on any
+        # path reaching that endpoint).  Coarse endpoints are recorded and do
+        # not become intermediate states.
+        states = {}
+        for neighbour in adjacency[source]:
+            neighbour = int(neighbour)
+            if fine_points[neighbour]:
+                states[neighbour] = states.get(neighbour, 0) | \
+                    (1 << int(fine_number[neighbour]))
+
+        target_masks = {}
+        for depth in range(1, degree):
+            if not states:
+                break
+            next_states = {}
+            for point, mask in states.items():
+                for neighbour in adjacency[point]:
+                    neighbour = int(neighbour)
+                    if coarse[neighbour]:
+                        # A direct C-C edge has no fine point and is therefore
+                        # deliberately not represented in this matrix.
+                        if neighbour != source and mask:
+                            target_masks[neighbour] = \
+                                target_masks.get(neighbour, 0) | mask
+                    else:
+                        new_mask = mask | (1 << int(fine_number[neighbour]))
+                        next_states[neighbour] = \
+                            next_states.get(neighbour, 0) | new_mask
+            states = next_states
+
+        for target, mask in target_masks.items():
+            count = int(mask.bit_count())
+            if count >= paths:
+                rows.append(int(source))
+                cols.append(int(target))
+                data.append(count)
+
+    if data:
+        # Constructing row pointers separately keeps the result canonical even
+        # when multiple paths reach the same ordered pair.
+        row_counts = np.bincount(np.asarray(rows, dtype=np.int64), minlength=n)
+        indptr = np.empty(n + 1, dtype=graph.indptr.dtype)
+        indptr[0] = 0
+        np.cumsum(row_counts, out=indptr[1:])
+        result = csr_array((np.asarray(data, dtype=np.intc),
+                            np.asarray(cols, dtype=graph.indices.dtype), indptr),
+                           shape=(n, n))
+    else:
+        result = csr_array((n, n), dtype=np.intc)
+
+    result.sum_duplicates()
+    result.eliminate_zeros()
+    result.sort_indices()
+    return result
+
+
+def aggressive_coarsening(S, degree=2, paths=1, second_pass=False, method='RS'):
+    """Perform two-stage aggressive coarsening.
+
+    The first split is used to form a long-range coarse-point graph.  A second
+    split of that graph selects the final coarse points; points fine in the
+    first split remain fine, while isolated first-stage coarse points are
+    retained as coarse points.
+    """
+    if not issparse(S) or S.format != 'csr':
+        raise TypeError('expected csr_array')
+    if S.shape[0] != S.shape[1]:
+        raise ValueError(f'expected square matrix, shape={S.shape}')
+    if method not in ('RS', 'PMIS', 'CLJP'):
+        raise ValueError(f'Unknown aggressive coarsening method {method}')
+    if not isinstance(second_pass, (bool, np.bool_)):
+        raise ValueError('second_pass must be boolean')
+
+    degree = _whole_number(degree, 'degree', minimum=2)
+    paths = _whole_number(paths, 'paths', minimum=1)
+
+    if method == 'RS':
+        first = RS(S, second_pass=second_pass)
+        def splitter(matrix):
+            return RS(matrix, second_pass=second_pass)
+    elif method == 'PMIS':
+        first = PMIS(S)
+        splitter = PMIS
+    else:
+        first = CLJP(S)
+        splitter = CLJP
+
+    first = np.asarray(first) != 0
+    long_range = aggressive_strength_of_connection(S, first, degree, paths)
+    second = np.asarray(splitter(long_range)) != 0
+
+    # The second splitter sees isolated zero-degree rows/columns differently
+    # across the available algorithms.  The aggressive rule is explicit:
+    # isolated first-stage C-points remain C-points.
+    has_connection = (np.diff(long_range.indptr) != 0)
+    has_connection |= (np.diff(long_range.T.tocsr().indptr) != 0)
+    final = np.zeros(S.shape[0], dtype=np.intc)
+    final[first & (~has_connection)] = 1
+    final[first & has_connection & second] = 1
+    return final
+
+
 def RS(S, second_pass=False):
