+        return P_use
+
+    A_use = _canonical_csr(A)
+    if C is not None:
+        if C.shape != A.shape:
+            raise ValueError('A and C must have the same shape')
+        mask = _canonical_csr(C)
+        mask.data[:] = 1
+        restricted = _canonical_csr(A_use.multiply(mask))
+        remaining = (np.asarray(A_use.sum(axis=1)).ravel()
+                     - np.asarray(restricted.sum(axis=1)).ravel())
+        restricted.setdiag(restricted.diagonal() + remaining)
+        A_use = _canonical_csr(restricted)
+
+    diagonal = A_use.diagonal()
+    if np.any(diagonal == 0):
+        raise ValueError('zero diagonal in A')
