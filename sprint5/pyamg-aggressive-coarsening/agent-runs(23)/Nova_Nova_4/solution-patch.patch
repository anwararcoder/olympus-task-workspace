+    result.sum_duplicates()
+    result.eliminate_zeros()
+    result.sort_indices()
+    return result
+
+
+def aggressive_coarsening(S, degree=2, paths=1, second_pass=False, method='RS'):
+    """Perform two-stage aggressive coarsening.
+
+    The first split is used to form a long-range coarse-point graph.  A second
+    split of that graph selects the final coarse points; points fine in the
+    first split remain fine, while isolated first-stage coarse points are
+    retained as coarse points.
+    """
+    if not issparse(S) or S.format != 'csr':
+        raise TypeError('expected csr_array')
+    if S.shape[0] != S.shape[1]:
+        raise ValueError(f'expected square matrix, shape={S.shape}')
+    if method not in ('RS', 'PMIS', 'CLJP'):
+        raise ValueError(f'Unknown aggressive coarsening method {method}')
+    if not isinstance(second_pass, (bool, np.bool_)):
+        raise ValueError('second_pass must be boolean')
+
+    degree = _whole_number(degree, 'degree', minimum=2)
+    paths = _whole_number(paths, 'paths', minimum=1)
+
+    if method == 'RS':
+        first = RS(S, second_pass=second_pass)
+        def splitter(matrix):
+            return RS(matrix, second_pass=second_pass)
+    elif method == 'PMIS':
+        first = PMIS(S)
+        splitter = PMIS
+    else:
+        first = CLJP(S)
+        splitter = CLJP
+
+    first = np.asarray(first) != 0
+    long_range = aggressive_strength_of_connection(S, first, degree, paths)
+    second = np.asarray(splitter(long_range)) != 0
+
+    # The second splitter sees isolated zero-degree rows/columns differently
+    # across the available algorithms.  The aggressive rule is explicit:
+    # isolated first-stage C-points remain C-points.
+    has_connection = (np.diff(long_range.indptr) != 0)
+    has_connection |= (np.diff(long_range.T.tocsr().indptr) != 0)
+    final = np.zeros(S.shape[0], dtype=np.intc)
+    final[first & (~has_connection)] = 1
+    final[first & has_connection & second] = 1
+    return final
+
