+def sparsify_coarse_operator(A, theta=0.1, lump='diagonal', symmetric=True,
+                             B=None, protect=None):
+    """Drop weak coarse-operator entries while optionally preserving ``A @ B``.
+
+    Parameters
+    ----------
+    A : csr_array
+        Square coarse operator.
+    theta : float, default 0.1
+        Row-wise off-diagonal drop tolerance in ``[0, 1)``.
+    lump : {'diagonal', 'strong', 'none'}, default 'diagonal'
+        Destination for the contribution of dropped entries.
+    symmetric : bool, default True
+        If true, close the retained off-diagonal pattern under transpose.
+    B : array_like, optional
+        Vector whose image is preserved.  Ones are used by default.
+    protect : csr_array, optional
+        Stored positions that must be retained.
+    """
+    if not issparse(A) or A.format != 'csr':
+        raise TypeError('expected csr_array')
+    if A.shape[0] != A.shape[1]:
+        raise ValueError(f'expected square matrix, shape={A.shape}')
+    theta = _real_scalar(theta, 'theta')
+    if theta < 0 or theta >= 1:
+        raise ValueError('theta must be in [0,1)')
+    if lump not in ('diagonal', 'strong', 'none'):
+        raise ValueError("lump must be 'diagonal', 'strong', or 'none'")
+    if not isinstance(symmetric, (bool, np.bool_)):
+        raise ValueError('symmetric must be boolean')
+    if protect is not None:
+        if not issparse(protect) or protect.format != 'csr':
+            raise TypeError('expected csr_array for protect')
+        if protect.shape != A.shape:
+            raise ValueError('protect must have the same shape as A')
+
+    A_use = _canonical(A)
+    n = A.shape[0]
+    if B is None:
+        B_use = np.ones(n, dtype=A_use.dtype)
+    else:
+        B_use = np.asarray(B)
+        if B_use.ndim == 2 and B_use.shape[1] == 1:
+            B_use = B_use[:, 0]
+        if B_use.ndim != 1 or B_use.shape[0] != n:
+            raise ValueError('B must be a vector with one entry per row')
+        B_use = B_use.copy()
+
+    # A zero in B is only problematic when a dropped entry has to be moved.
+    # Keep the check after the pattern is known so lump='none' and an already
+    # fully retained matrix remain valid.
+    protected = [set() for _ in range(n)]
+    if protect is not None:
+        protect_use = protect.copy()
+        protect_use.sum_duplicates()
+        protect_use.sort_indices()
+        for i in range(n):
+            start, stop = protect_use.indptr[i], protect_use.indptr[i + 1]
+            protected[i].update(int(j) for j in protect_use.indices[start:stop])
+
+    rows = []
+    initial_keep = []
+    for i in range(n):
+        start, stop = A_use.indptr[i], A_use.indptr[i + 1]
+        offdiag = [(int(j), value) for j, value in
+                   zip(A_use.indices[start:stop], A_use.data[start:stop])
+                   if int(j) != i]
+        largest = max((abs(value) for _, value in offdiag), default=0.0)
+        keep = {j for j, value in offdiag
+                if abs(value) >= theta * largest or j in protected[i]}
+        initial_keep.append(keep)
+
+    keep_sets = [set(row) for row in initial_keep]
+    if symmetric:
+        for i in range(n):
+            start, stop = A_use.indptr[i], A_use.indptr[i + 1]
+            for j in A_use.indices[start:stop]:
+                j = int(j)
+                if j != i and i in initial_keep[j]:
+                    keep_sets[i].add(j)
+
+    diagonal = A_use.diagonal()
+    any_dropped = False
+    dtype = A_use.dtype
+    if lump != 'none':
+        dtype = np.result_type(dtype, B_use.dtype, np.float64)
+
+    for i in range(n):
+        start, stop = A_use.indptr[i], A_use.indptr[i + 1]
+        row_values = {int(j): value for j, value in
+                      zip(A_use.indices[start:stop], A_use.data[start:stop])}
+        kept = {j: row_values[j] for j in keep_sets[i] if j in row_values}
+        dropped = {j: value for j, value in row_values.items()
+                   if j != i and j not in kept}
+        any_dropped |= bool(dropped)
+        row = dict(kept)
+        row[i] = row_values.get(i, 0)
+
+        if dropped and lump != 'none':
+            if B_use[i] == 0:
+                raise ValueError('B must not contain zeros when lumping')
+            residual = sum((value * B_use[j] for j, value in dropped.items()),
+                           0)
+            if lump == 'diagonal':
+                row[i] += residual / B_use[i]
+            else:
+                share = sum((abs(value * B_use[j])
+                             for j, value in kept.items()), 0)
+                if share != 0:
+                    for j, value in kept.items():
+                        # Each added contribution is proportional to the
+                        # magnitude of the retained connection, while the
+                        # B-weighted row image is exactly preserved.
+                        row[j] += (residual * abs(value * B_use[j])
+                                   / (share * B_use[j]))
+                else:
+                    row[i] += residual / B_use[i]
+        rows.append(row)
+
+    if any_dropped and lump != 'none' and np.any(B_use == 0):
+        raise ValueError('B must not contain zeros when lumping')
+
+    return _rows_to_csr(rows, A.shape, dtype, A_use.indices.dtype)
