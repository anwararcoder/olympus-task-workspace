+def _whole_number(value, name, minimum=0):
+    """Validate an integer option used by interpolation post-processing."""
+    if (isinstance(value, (bool, np.bool_))
+            or not isinstance(value, numbers.Integral)):
+        raise ValueError(f'{name} must be a whole number')
+    value = int(value)
+    if value < minimum:
+        raise ValueError(f'{name} must be at least {minimum}')
+    return value
+
+
+def _real_scalar(value, name):
+    """Validate a finite real scalar and return it as a float."""
+    if isinstance(value, (bool, np.bool_)) or not np.isscalar(value):
+        raise ValueError(f'{name} must be a finite real scalar')
+    try:
+        if not np.isrealobj(value):
+            raise ValueError
+        value = float(value)
+    except (TypeError, ValueError, OverflowError) as exc:
+        raise ValueError(f'{name} must be a finite real scalar') from exc
+    if not np.isfinite(value):
+        raise ValueError(f'{name} must be a finite real scalar')
+    return value
+
+
+def _canonical_csr(A):
+    """Return a canonical copy without explicit zeros."""
+    result = A.copy()
+    result.sum_duplicates()
+    result.eliminate_zeros()
+    result.sort_indices()
+    return result
+
+
+def _rows_to_csr(rows, shape, dtype, index_dtype=np.int32):
+    """Build canonical CSR from row dictionaries."""
+    indptr = np.zeros(shape[0] + 1, dtype=index_dtype)
+    indices = []
+    data = []
+    for row_number, row in enumerate(rows):
+        for col in sorted(row):
+            value = row[col]
+            if value != 0:
+                indices.append(col)
+                data.append(value)
+        indptr[row_number + 1] = len(indices)
+
+    result = csr_array((np.asarray(data, dtype=dtype),
+                        np.asarray(indices, dtype=index_dtype), indptr),
+                       shape=shape)
+    result.sum_duplicates()
+    result.eliminate_zeros()
+    result.sort_indices()
+    return result
+
+
+def _splitting_data(splitting, n):
+    splitting = np.asarray(splitting)
+    if splitting.ndim != 1 or splitting.shape[0] != n:
+        raise ValueError('splitting must have one entry per point')
+    coarse = splitting != 0
+    coarse_points = np.flatnonzero(coarse)
+    coarse_number = np.full(n, -1, dtype=np.int64)
+    coarse_number[coarse_points] = np.arange(coarse_points.size)
+    return coarse, coarse_number
+
+
+def _multipass_graph(A, C, theta, norm):
+    """Return the A-valued off-diagonal entries in a strength pattern."""
+    if theta is not None:
+        theta = _real_scalar(theta, 'theta')
+        if theta < 0 or theta > 1:
+            raise ValueError('theta must be in [0,1]')
+        if norm not in ('min', 'abs'):
+            raise ValueError("norm must be 'min' or 'abs'")
+        # The signed minimum measure has no ordering for complex entries.  In
+        # that case its magnitude-based analogue is the meaningful pattern.
+        soc_norm = 'abs' if norm == 'min' and np.iscomplexobj(A.data) else norm
+        C_use = classical_strength_of_connection(A, theta=theta, norm=soc_norm)
+    else:
+        if norm not in ('min', 'abs'):
+            raise ValueError("norm must be 'min' or 'abs'")
+        C_use = C.copy()
+
+    C_use = _canonical_csr(C_use)
+    C_use.data[:] = 1
+    graph = _canonical_csr(C_use.multiply(A))
+
+    neighbours = []
+    for i in range(A.shape[0]):
+        start, stop = graph.indptr[i], graph.indptr[i + 1]
+        row = {}
+        for col, value in zip(graph.indices[start:stop],
+                              graph.data[start:stop]):
+            col = int(col)
+            if col != i and value != 0:
+                row[col] = row.get(col, 0) + value
+        neighbours.append(row)
+    return neighbours
+
+
+def _multipass_status(A, C, splitting, theta, norm, max_passes=None):
+    """Compute unscaled multipass rows and the pass number of every point."""
+    if not issparse(A) or A.format != 'csr':
+        raise TypeError('expected csr_array for A')
+    if not issparse(C) or C.format != 'csr':
+        raise TypeError('expected csr_array for C')
+    if A.shape[0] != A.shape[1]:
+        raise ValueError(f'expected square matrix, shape={A.shape}')
+    if C.shape != A.shape:
+        raise ValueError('A and C must have the same shape')
+
+    A_use = _canonical_csr(A)
+    coarse, coarse_number = _splitting_data(splitting, A.shape[0])
+    neighbours = _multipass_graph(A_use, C, theta, norm)
+    n = A.shape[0]
+    rows = [dict() for _ in range(n)]
+    status = np.full(n, -1, dtype=np.intc)
+    status[coarse] = 0
+    for point in np.flatnonzero(coarse):
+        rows[point][int(coarse_number[point])] = 1
+
+    settled = coarse.copy()
+    pass_number = 0
+    while True:
+        if max_passes is not None and pass_number >= max_passes:
+            break
+
+        # The candidate set is determined before any row in this pass is
+        # settled.  Thus a chain advances by exactly one pass per edge.
+        candidates = []
+        for point in np.flatnonzero(~settled):
+            if any(settled[neighbour] for neighbour in neighbours[point]):
+                candidates.append(int(point))
+        if not candidates:
+            break
+
+        pass_number += 1
+        for point in candidates:
+            row = {}
+            for neighbour, value in neighbours[point].items():
+                if not settled[neighbour]:
+                    continue
+                if coarse[neighbour]:
+                    column = int(coarse_number[neighbour])
+                    row[column] = row.get(column, 0) + value
+                else:
+                    for column, weight in rows[neighbour].items():
+                        row[column] = row.get(column, 0) + value * weight
+            rows[point] = row
+        settled[candidates] = True
+        status[candidates] = pass_number
+
+    return A_use, neighbours, rows, status, coarse, coarse_number
+
+
+def interpolation_passes(A, C, splitting, theta=None, norm='min'):
+    """Return the multipass interpolation pass reached by every point.
+
+    Coarse points are reported as zero, fine points are reported by their
+    one-based pass number, and fine points that cannot be reached are -1.
+    """
+    _, _, _, status, _, _ = _multipass_status(A, C, splitting, theta, norm)
+    return np.asarray(status, dtype=np.intc)
+
+
+def multipass_interpolation(A, C, splitting, theta=None, norm='min',
+                            trunc=None, improve=0, strict=False, lump=False,
+                            max_passes=None):
+    """Create interpolation by successively eliminating fine points.
+
+    A fine point is settled after a pass when it has a strong neighbour settled
+    in an earlier pass.  Its unscaled row is the corresponding row of ``A``
+    applied recursively to the already settled interpolation rows.  Rows are
+    scaled once after all passes have completed.
+    """
+    if not isinstance(strict, (bool, np.bool_)):
+        raise ValueError('strict must be boolean')
+    if not isinstance(lump, (bool, np.bool_)):
+        raise ValueError('lump must be boolean')
+    if trunc is not None:
+        trunc = _real_scalar(trunc, 'trunc')
+        if trunc < 0 or trunc >= 1:
+            raise ValueError('trunc must be in [0,1)')
+    improve = _whole_number(improve, 'improve', minimum=0)
+    if max_passes is not None:
+        max_passes = _whole_number(max_passes, 'max_passes', minimum=1)
+
+    A_use, neighbours, rows, status, coarse, coarse_number = _multipass_status(
+        A, C, splitting, theta, norm, max_passes=max_passes)
+    if strict and np.any((~coarse) & (status < 0)):
+        raise ValueError('some fine points could not be settled')
+
+    # The scaling is deliberately performed only once, after pass construction.
+    diagonal = A_use.diagonal()
+    off_diagonal_sum = np.asarray(A_use.sum(axis=1)).ravel() - diagonal
+    for point in np.flatnonzero((~coarse) & (status >= 0)):
+        row = rows[point]
+        row_sum = sum(row.values(), 0)
+        diagonal_value = diagonal[point]
+        if lump:
+            diagonal_value += sum(value for neighbour, value in
+                                  neighbours[point].items()
+                                  if status[neighbour] < 0)
+        if diagonal_value != 0 and row_sum != 0:
+            factor = -off_diagonal_sum[point] / (diagonal_value * row_sum)
+            for column in list(row):
+                row[column] *= factor
+
+    nc = int(np.count_nonzero(coarse))
+    dtype = np.result_type(A_use.dtype, np.float64)
+    P = _rows_to_csr(rows, (A.shape[0], nc), dtype, A_use.indices.dtype)
+    if trunc is not None:
+        P = truncate_interpolation(P, trunc)
+    if improve:
+        C_improve = C if theta is None else \
+            classical_strength_of_connection(
+                A_use, theta=theta,
+                norm='abs' if norm == 'min' and np.iscomplexobj(A_use.data)
+                else norm)
+        P = jacobi_improve_interpolation(A_use, P, splitting,
+                                         degree=improve, C=C_improve)
+    return P
+
+
+def truncate_interpolation(P, theta):
+    """Drop small entries in each interpolation row and preserve its row sum."""
+    if not issparse(P) or P.format != 'csr':
+        raise TypeError('expected csr_array for P')
+    theta = _real_scalar(theta, 'theta')
+    if theta < 0 or theta >= 1:
+        raise ValueError('theta must be in [0,1)')
+
+    P_use = _canonical_csr(P)
+    rows = []
+    for row_number in range(P_use.shape[0]):
+        start, stop = P_use.indptr[row_number], P_use.indptr[row_number + 1]
+        cols = P_use.indices[start:stop]
+        values = P_use.data[start:stop]
+        row = {int(col): value for col, value in zip(cols, values)}
+        if values.size:
+            largest = np.max(np.abs(values))
+            kept = np.abs(values) >= theta * largest
+            original_sum = np.sum(values)
+            kept_sum = np.sum(values[kept])
+            if kept_sum != 0:
+                factor = original_sum / kept_sum
+                row = {int(col): value * factor
+                       for col, value, use in zip(cols, values, kept) if use}
+            else:
+                row = {int(col): value
+                       for col, value, use in zip(cols, values, kept) if use}
+        rows.append(row)
+    return _rows_to_csr(rows, P_use.shape, P_use.dtype, P_use.indices.dtype)
+
+
+def jacobi_improve_interpolation(A, P, splitting, omega=4.0/3.0,
+                                 degree=1, C=None):
+    """Improve interpolation with weighted-Jacobi sweeps."""
+    if not issparse(A) or A.format != 'csr':
+        raise TypeError('expected csr_array for A')
+    if not issparse(P) or P.format != 'csr':
+        raise TypeError('expected csr_array for P')
+    if C is not None and (not issparse(C) or C.format != 'csr'):
+        raise TypeError('expected csr_array for C')
