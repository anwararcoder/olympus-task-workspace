+    indices = []
+    data = []
+    for i, row in enumerate(rows):
+        for j in sorted(row):
+            value = row[j]
+            if value != 0 or j == i:
+                indices.append(j)
+                data.append(value)
+        indptr[i + 1] = len(indices)
+    result = csr_array((np.asarray(data, dtype=dtype),
+                        np.asarray(indices, dtype=A.indptr.dtype), indptr),
+                       shape=A.shape)
+    result.sort_indices()
+    return result
