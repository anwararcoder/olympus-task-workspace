 """Classical AMG Interpolation methods."""
 
 from warnings import warn
+from numbers import Integral
 
 import numpy as np
 from scipy.sparse import csr_array, bsr_array, issparse, SparseEfficiencyWarning
@@ -9,6 +10,370 @@ from .. import amg_core
 from ..strength import classical_strength_of_connection
 
 
+def _validate_interpolation_inputs(A, C, splitting):
+    if not issparse(A) or A.format != 'csr':
+        raise TypeError('expected csr_array for A')
+    if not issparse(C) or C.format != 'csr':
+        raise TypeError('expected csr_array for C')
+    if A.shape[0] != A.shape[1]:
+        raise ValueError('expected square matrix for A')
+    if C.shape != A.shape:
+        raise ValueError('A and C must have the same shape')
+    splitting = np.asarray(splitting)
+    if splitting.ndim != 1 or splitting.size != A.shape[0]:
+        raise ValueError('splitting must have one entry per row of A')
+    return splitting != 0
+
+
+def _validate_norm_theta(theta, norm):
+    if norm not in ('min', 'abs'):
+        raise ValueError("norm must be either 'min' or 'abs'")
+    if theta is not None:
+        if isinstance(theta, (bool, np.bool_)):
+            raise ValueError('theta must be a number in [0, 1)')
+        try:
+            theta = float(theta)
+        except (TypeError, ValueError) as exc:
+            raise ValueError('theta must be a number in [0, 1)') from exc
+        if not np.isfinite(theta) or theta < 0.0 or theta >= 1.0:
+            raise ValueError('theta must be a number in [0, 1)')
+    return theta
+
+
+def _strength_pattern(A, C, theta, norm):
+    """Return a clean copy of the requested strength pattern."""
+    theta = _validate_norm_theta(theta, norm)
+    if theta is not None:
+        # The compiled ``min`` strength kernel is defined for real M-matrix
+        # entries.  For complex operators the only meaningful magnitude is
+        # the absolute value, which also keeps the complex interpolation path
+        # available with the default norm name.
+        strength_norm = 'abs' if (norm == 'min' and
+                                  np.iscomplexobj(A.data)) else norm
+        strength_A = A
+        if A.dtype.kind not in ('f', 'c') or A.dtype.itemsize not in (4, 8):
+            strength_A = A.astype(np.float64)
+        if A.indptr.dtype != np.int32 or A.indices.dtype != np.int32:
+            if A.nnz > np.iinfo(np.int32).max or A.shape[0] > np.iinfo(np.int32).max:
+                raise ValueError('CSR indices are too large for strength computation')
+            strength_A = csr_array((strength_A.data.copy(),
+                                    A.indices.astype(np.int32),
+                                    A.indptr.astype(np.int32)), shape=A.shape)
+        pattern = classical_strength_of_connection(strength_A, theta=theta,
+                                                    norm=strength_norm)
+    else:
+        pattern = C.copy()
+    pattern = pattern.tocsr()
+    pattern.sum_duplicates()
+    pattern.sort_indices()
+    pattern.eliminate_zeros()
+    # Interpolation is based on entries of A restricted to this graph.  This
+    # also removes a structural C edge when A has no nonzero entry there,
+    # matching direct_interpolation's masked strength pattern.
+    pattern.data[:] = 1
+    pattern = pattern.multiply(A).tocsr()
+    pattern.eliminate_zeros()
+    pattern.sort_indices()
+    return pattern
+
+
+def _canonical_csr(A):
+    result = A.copy().tocsr()
+    result.sum_duplicates()
+    result.sort_indices()
+    result.eliminate_zeros()
+    return result
+
+
+def _row_values(A):
+    """Return row dictionaries for a canonical CSR array."""
+    return [dict(zip(A.indices[A.indptr[i]:A.indptr[i + 1]],
+                     A.data[A.indptr[i]:A.indptr[i + 1]]))
+            for i in range(A.shape[0])]
+
+
+def _rows_to_csr(rows, shape, dtype, index_dtype=np.int32):
+    indptr = np.zeros(shape[0] + 1, dtype=index_dtype)
+    indices = []
+    data = []
+    for i, row in enumerate(rows):
+        for j in sorted(row):
+            value = row[j]
+            if value != 0:
+                indices.append(int(j))
+                data.append(value)
+        indptr[i + 1] = len(indices)
+    result = csr_array((np.asarray(data, dtype=dtype),
+                        np.asarray(indices, dtype=index_dtype), indptr),
+                       shape=shape)
+    result.sort_indices()
+    result.eliminate_zeros()
+    return result
+
+
+def _interpolation_pass_numbers(A, pattern, coarse, max_passes=None,
+                                lump=False):
+    """Build unscaled multipass rows and their settlement passes."""
+    A = _canonical_csr(A)
+    pattern = _canonical_csr(pattern)
+    n = A.shape[0]
+    arows = _row_values(A)
+    prow = [list(pattern.indices[pattern.indptr[i]:pattern.indptr[i + 1]])
+            for i in range(n)]
+    nc = int(np.count_nonzero(coarse))
+    coarse_column = np.full(n, -1, dtype=np.intp)
+    coarse_column[coarse] = np.arange(nc, dtype=np.intp)
+
+    settled = coarse.copy()
+    pass_numbers = np.full(n, -1, dtype=np.intc)
+    pass_numbers[coarse] = 0
+    rows = [{} for _ in range(n)]
+    effective_diagonal = np.empty(n, dtype=np.result_type(A.dtype, np.float64))
+    for i in range(n):
+        effective_diagonal[i] = arows[i].get(i, 0)
+
+    pass_number = 0
+    while True:
+        if max_passes is not None and pass_number >= max_passes:
+            break
+        pass_number += 1
+        newly_settled = []
+
+        # All decisions in one pass use the state at the beginning of the
+        # pass.  This is what makes a pass number a graph distance in the
+        # settled-neighbour graph.
+        for i in range(n):
+            if settled[i]:
+                continue
+            neighbours = [j for j in prow[i] if j != i]
+            usable = [j for j in neighbours if settled[j]]
+            if not usable:
+                continue
+
+            row = {}
+            for j in usable:
+                aij = arows[i].get(j, 0)
+                if coarse[j]:
+                    col = int(coarse_column[j])
+                    row[col] = row.get(col, 0) + aij
+                else:
+                    for col, value in rows[j].items():
+                        row[col] = row.get(col, 0) + aij * value
+
+            if lump:
+                unusable = [j for j in neighbours if not settled[j]]
+                effective_diagonal[i] = arows[i].get(i, 0) + sum(
+                    (arows[i].get(j, 0) for j in unusable),
+                    start=np.result_type(A.dtype, np.float64).type(0))
+
+            rows[i] = row
+            newly_settled.append(i)
+
+        if not newly_settled:
+            break
+        settled[newly_settled] = True
+        pass_numbers[newly_settled] = pass_number
+
+    return rows, pass_numbers, effective_diagonal, coarse_column
+
+
+def interpolation_passes(A, C, splitting, theta=None, norm='min'):
+    """Return the settlement pass of every point in multipass interpolation."""
+    coarse = _validate_interpolation_inputs(A, C, splitting)
+    pattern = _strength_pattern(A, C, theta, norm)
+    _, passes, _, _ = _interpolation_pass_numbers(A, pattern, coarse)
+    return passes.astype(np.intc, copy=False)
+
+
+def multipass_interpolation(A, C, splitting, theta=None, norm='min',
+                            trunc=None, improve=0, strict=False, lump=False,
+                            max_passes=None):
+    """Create a multipass classical interpolation operator.
+
+    Coarse points are injected in pass zero.  At each subsequent pass, a
+    fine point uses strong neighbours settled in an earlier pass, recursively
+    expanding fine-neighbour rows into coarse columns.
+    """
+    coarse = _validate_interpolation_inputs(A, C, splitting)
+    pattern = _strength_pattern(A, C, theta, norm)
+
+    if isinstance(improve, (bool, np.bool_)) or not isinstance(improve, Integral):
+        raise ValueError('improve must be a whole number')
+    improve = int(improve)
+    if improve < 0:
+        raise ValueError('improve must be a whole number')
+    if max_passes is not None:
+        if (isinstance(max_passes, (bool, np.bool_)) or
+                not isinstance(max_passes, Integral) or max_passes < 1):
+            raise ValueError('max_passes must be at least one')
+        max_passes = int(max_passes)
+    if not isinstance(lump, (bool, np.bool_)):
+        raise ValueError('lump must be boolean')
+    if not isinstance(strict, (bool, np.bool_)):
+        raise ValueError('strict must be boolean')
+    if trunc is not None:
+        if isinstance(trunc, (bool, np.bool_)):
+            raise ValueError('trunc must be in [0, 1)')
+        try:
+            trunc = float(trunc)
+        except (TypeError, ValueError) as exc:
+            raise ValueError('trunc must be in [0, 1)') from exc
+        if not np.isfinite(trunc) or trunc < 0.0 or trunc >= 1.0:
+            raise ValueError('trunc must be in [0, 1)')
+
+    rows, passes, diagonal, coarse_column = _interpolation_pass_numbers(
+        A, pattern, coarse, max_passes=max_passes, lump=lump)
+    if strict and np.any((~coarse) & (passes < 0)):
+        raise ValueError('some fine points could not be settled')
+
+    Aclean = _canonical_csr(A)
+    arows = _row_values(Aclean)
+    dtype = np.result_type(A.dtype, np.float64)
+
+    # Scale every settled fine row exactly once after all passes have been
+    # completed.  The original A supplies the off-diagonal row sum.
+    for i in range(A.shape[0]):
+        if coarse[i] or passes[i] < 0:
+            continue
+        offdiag = sum((value for j, value in arows[i].items() if j != i),
+                      dtype.type(0))
+        row_sum = sum(rows[i].values(), dtype.type(0))
+        if diagonal[i] != 0 and row_sum != 0:
+            scale = -offdiag / (diagonal[i] * row_sum)
+            rows[i] = {j: value * scale for j, value in rows[i].items()}
+
+    for i in np.flatnonzero(coarse):
+        rows[i] = {int(coarse_column[i]): dtype.type(1)}
+    for i in np.flatnonzero((~coarse) & (passes < 0)):
+        rows[i] = {}
+
+    P = _rows_to_csr(rows, (A.shape[0], int(np.count_nonzero(coarse))), dtype,
+                     index_dtype=A.indptr.dtype)
+    if trunc is not None:
+        P = truncate_interpolation(P, trunc)
+    if improve:
+        P = jacobi_improve_interpolation(A, P, splitting, degree=improve,
+                                         C=pattern)
+        # An unsettled fine row is intentionally not allowed to acquire a
+        # value merely from the optional Jacobi postprocessing.
+        if np.any((~coarse) & (passes < 0)):
+            keep_rows = [dict(zip(P.indices[P.indptr[i]:P.indptr[i + 1]],
+                                  P.data[P.indptr[i]:P.indptr[i + 1]]))
+                         if coarse[i] or passes[i] >= 0 else {}
+                         for i in range(P.shape[0])]
+            P = _rows_to_csr(keep_rows, P.shape, P.dtype,
+                             index_dtype=P.indptr.dtype)
+    return P
+
+
+def truncate_interpolation(P, theta):
+    """Drop small interpolation entries and preserve each row sum."""
+    if not issparse(P) or P.format != 'csr':
+        raise TypeError('expected csr_array for P')
+    if isinstance(theta, (bool, np.bool_)):
+        raise ValueError('theta must be in [0, 1)')
+    try:
+        theta = float(theta)
+    except (TypeError, ValueError) as exc:
+        raise ValueError('theta must be in [0, 1)') from exc
+    if not np.isfinite(theta) or theta < 0.0 or theta >= 1.0:
+        raise ValueError('theta must be in [0, 1)')
+
+    P = _canonical_csr(P)
+    rows = _row_values(P)
+    for i, row in enumerate(rows):
+        if not row:
+            continue
+        largest = max(abs(value) for value in row.values())
+        kept = {j: value for j, value in row.items()
+                if abs(value) >= theta * largest}
+        kept_sum = sum(kept.values(), np.result_type(P.dtype, np.float64).type(0))
+        if kept_sum != 0:
+            factor = sum(row.values(), np.result_type(P.dtype, np.float64).type(0)) / kept_sum
+            rows[i] = {j: value * factor for j, value in kept.items()}
+    return _rows_to_csr(rows, P.shape, np.result_type(P.dtype, np.float64),
+                        index_dtype=P.indptr.dtype)
+
+
+def _lumped_matrix_for_jacobi(A, C):
+    A = _canonical_csr(A)
+    C = _canonical_csr(C)
+    crows = [set(C.indices[C.indptr[i]:C.indptr[i + 1]])
+             for i in range(C.shape[0])]
+    rows = []
+    for i in range(A.shape[0]):
+        row = {}
+        diagonal = 0
+        for j, value in zip(A.indices[A.indptr[i]:A.indptr[i + 1]],
+                            A.data[A.indptr[i]:A.indptr[i + 1]]):
+            if int(j) in crows[i]:
+                row[int(j)] = row.get(int(j), 0) + value
+            else:
+                diagonal += value
+        if diagonal != 0 or i not in row:
+            row[i] = row.get(i, 0) + diagonal
+        rows.append(row)
+    return _rows_to_csr(rows, A.shape, A.dtype, index_dtype=A.indptr.dtype)
+
+
+def jacobi_improve_interpolation(A, P, splitting, omega=4.0 / 3.0,
+                                 degree=1, C=None):
+    """Improve interpolation using weighted Jacobi sweeps."""
+    if not issparse(A) or A.format != 'csr':
+        raise TypeError('expected csr_array for A')
+    if not issparse(P) or P.format != 'csr':
+        raise TypeError('expected csr_array for P')
+    if A.shape[0] != A.shape[1] or P.shape[0] != A.shape[0]:
+        raise ValueError('incompatible matrix shapes')
+    splitting = np.asarray(splitting)
+    if splitting.ndim != 1 or splitting.size != A.shape[0]:
+        raise ValueError('splitting must have one entry per row of A')
+    coarse = splitting != 0
+    if P.shape[1] != np.count_nonzero(coarse):
+        raise ValueError('P has the wrong number of coarse columns')
+    if isinstance(omega, (bool, np.bool_)):
+        raise ValueError('omega must be positive')
+    try:
+        omega = float(omega)
+    except (TypeError, ValueError) as exc:
+        raise ValueError('omega must be positive') from exc
+    if not np.isfinite(omega) or omega <= 0:
+        raise ValueError('omega must be positive')
+    if isinstance(degree, (bool, np.bool_)) or not isinstance(degree, Integral):
+        raise ValueError('degree must be a whole number')
