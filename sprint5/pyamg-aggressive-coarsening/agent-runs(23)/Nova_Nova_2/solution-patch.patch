+"""Sparsification of classical AMG coarse-grid operators."""
+
+import numpy as np
+from scipy.sparse import csr_array, issparse
+
+
+def _canonical(A):
+    A = A.copy().tocsr()
+    A.sum_duplicates()
+    A.sort_indices()
+    return A
+
+
+def _validate_theta(theta):
+    if isinstance(theta, (bool, np.bool_)):
+        raise ValueError('theta must be in [0, 1)')
+    try:
+        theta = float(theta)
+    except (TypeError, ValueError) as exc:
+        raise ValueError('theta must be in [0, 1)') from exc
+    if not np.isfinite(theta) or theta < 0.0 or theta >= 1.0:
+        raise ValueError('theta must be in [0, 1)')
+    return theta
+
+
+def sparsify_coarse_operator(A, theta=0.1, lump='diagonal', symmetric=True,
+                             B=None, protect=None):
+    """Drop weak off-diagonal entries from a coarse-grid operator.
+
+    Parameters
+    ----------
+    A : csr_array
+        Square coarse-grid operator.
+    theta : float in [0, 1)
+        Row-wise relative drop tolerance.
+    lump : {'diagonal', 'strong', 'none'}
+        Destination for the image of dropped entries.
+    symmetric : bool
+        Keep an entry when either it or its transpose passes the threshold.
+    B : ndarray, optional
+        Vector whose image is preserved by lumping.  Ones are used by
+        default.
+    protect : csr_array, optional
+        Structural mask of entries that must be retained.
+    """
+    if not issparse(A) or A.format != 'csr':
+        raise TypeError('expected csr_array for A')
+    if A.shape[0] != A.shape[1]:
+        raise ValueError('expected square matrix')
+    theta = _validate_theta(theta)
+    if lump not in ('diagonal', 'strong', 'none'):
+        raise ValueError("lump must be 'diagonal', 'strong', or 'none'")
+    if not isinstance(symmetric, (bool, np.bool_)):
+        raise ValueError('symmetric must be boolean')
+    symmetric = bool(symmetric)
+
+    if protect is not None:
+        if not issparse(protect) or protect.format != 'csr':
+            raise TypeError('expected csr_array for protect')
+        if protect.shape != A.shape:
+            raise ValueError('protect must have the shape of A')
+        protect = _canonical(protect)
+        protect_rows = [set(protect.indices[protect.indptr[i]:protect.indptr[i + 1]])
+                        for i in range(A.shape[0])]
+    else:
+        protect_rows = [set() for _ in range(A.shape[0])]
+
+    A = _canonical(A)
+    n = A.shape[0]
+    arows = [list(zip(A.indices[A.indptr[i]:A.indptr[i + 1]],
+                      A.data[A.indptr[i]:A.indptr[i + 1]]))
+             for i in range(n)]
+
+    if B is None:
+        B = np.ones(n, dtype=np.result_type(A.dtype, np.float64))
+    else:
+        B = np.asarray(B)
+        if B.ndim != 1 or B.size != n:
+            raise ValueError('B must be a vector with one entry per row of A')
+        B = B.copy()
+
+    # First determine the locally strong entries, before applying symmetry.
+    local_keep = [set() for _ in range(n)]
+    for i, row in enumerate(arows):
+        offdiag = [(int(j), value) for j, value in row if int(j) != i]
+        if offdiag:
+            largest = max(abs(value) for _, value in offdiag)
+            for j, value in offdiag:
+                if abs(value) >= theta * largest or j in protect_rows[i]:
+                    local_keep[i].add(j)
+        # A protected diagonal is already retained by the diagonal rule.
+
+    rows = []
+    dropped_exists = False
+    for i, row in enumerate(arows):
+        kept = set(local_keep[i])
+        if symmetric:
+            for j, _ in row:
+                j = int(j)
+                if j != i and i in local_keep[j]:
+                    kept.add(j)
+
+        diagonal = 0
+        offdiag_kept = []
+        dropped = []
+        for j, value in row:
+            j = int(j)
+            if j == i:
+                diagonal += value
+            elif j in kept:
+                offdiag_kept.append((j, value))
+            else:
+                dropped.append((j, value))
+
+        if dropped:
+            dropped_exists = True
+        out = {j: value for j, value in offdiag_kept if value != 0}
+        if lump != 'none' and dropped:
+            if np.any(B == 0):
+                raise ValueError('B may not contain zero when lumping is requested')
+            # q is the part of A[i,:] B that was removed from the row.
+            q = sum((value * B[j] for j, value in dropped),
+                    np.result_type(A.dtype, B.dtype, np.float64).type(0))
+            if lump == 'diagonal':
+                diagonal += q / B[i]
+            else:
+                weights = np.asarray([abs(value * B[j])
+                                      for j, value in offdiag_kept], dtype=float)
+                share = weights.sum() if weights.size else 0.0
+                if share != 0.0:
+                    for (j, value), weight in zip(offdiag_kept, weights):
+                        out[j] = value + q * (weight / share) / B[j]
+                        if out[j] == 0:
+                            out.pop(j, None)
+                else:
+                    diagonal += q / B[i]
+
+        # The diagonal is deliberately inserted even when its value is zero.
+        out[i] = diagonal
+        rows.append(out)
+
+    if lump != 'none' and dropped_exists and np.any(B == 0):
+        raise ValueError('B may not contain zero when lumping is requested')
+
+    # Build without eliminating the explicitly required diagonal entries.
+    dtype = (np.result_type(A.dtype, B.dtype, np.float64)
+             if lump != 'none' and dropped_exists else A.dtype)
