diff --git a/src/org/jetbrains/java/decompiler/struct/DuplicateClassResolver.java b/src/org/jetbrains/java/decompiler/struct/DuplicateClassResolver.java
new file mode 100644
index 0000000..f86f5d4
--- /dev/null
+++ b/src/org/jetbrains/java/decompiler/struct/DuplicateClassResolver.java
@@ -0,0 +1,389 @@
+package org.jetbrains.java.decompiler.struct;
+
+import org.jetbrains.annotations.Nullable;
+import org.jetbrains.java.decompiler.main.DecompilerContext;
+import org.jetbrains.java.decompiler.main.extern.IFernflowerLogger;
+import org.jetbrains.java.decompiler.main.extern.IFernflowerPreferences;
+import org.jetbrains.java.decompiler.struct.attr.StructEnclosingMethodAttribute;
+import org.jetbrains.java.decompiler.struct.attr.StructGeneralAttribute;
+import org.jetbrains.java.decompiler.struct.attr.StructInnerClassesAttribute;
+import org.jetbrains.java.decompiler.util.DataInputFullStream;
+
+import java.io.IOException;
+import java.io.UncheckedIOException;
+import java.util.*;
+
+final class DuplicateClassResolver {
+  private final List<ContextUnit> units;
+  private final Map<String, List<ContextUnit>> eagerCandidates = new LinkedHashMap<>();
+  private final Map<ProbeKey, Optional<byte[]>> lazyProbes = new HashMap<>();
+  private final Map<String, Selection> selections = new HashMap<>();
+  private final Map<String, Family> families = new HashMap<>();
+  private boolean familiesInitialized;
+
+  DuplicateClassResolver(List<ContextUnit> units) {
+    this.units = units;
+  }
+
+  synchronized void register(ContextUnit unit) {
+    for (String className : unit.getClassNames()) {
+      List<ContextUnit> candidates = this.eagerCandidates.computeIfAbsent(className, key -> new ArrayList<>());
+      if (!candidates.contains(unit)) {
+        candidates.add(unit);
+      }
+    }
+    invalidateDecisions();
+  }
+
+  synchronized void reset() {
+    this.eagerCandidates.clear();
+    invalidateDecisions();
+  }
+
+  synchronized void invalidateDecisions() {
+    this.lazyProbes.clear();
+    this.selections.clear();
+    this.families.clear();
+    this.familiesInitialized = false;
+  }
+
+  synchronized @Nullable Selection select(String className) {
+    Selection cached = this.selections.get(className);
+    if (cached != null) {
+      return cached.missing ? null : cached;
+    }
+
+    List<Candidate> candidates = highestTierCandidates(className);
+    if (candidates.isEmpty()) {
+      this.selections.put(className, Selection.MISSING);
+      return null;
+    }
+
+    Candidate selected;
+    Family family = null;
+    if (candidates.get(0).unit.isOwn()) {
+      initializeFamilies();
+      family = this.families.get(className);
+    }
+
+    if (family != null) {
+      if (strategy() == Strategy.ERROR) {
+        choose(className, candidates);
+      }
+      ContextUnit anchor;
+      if (className.equals(family.anchorName)) {
+        selected = choose(className, candidates);
+        family.anchoredOrigin = selected.unit;
+        anchor = selected.unit;
+      } else {
+        anchor = family.anchor(this);
+        selected = candidates.stream().filter(candidate -> candidate.unit == anchor).findFirst().orElse(null);
+      }
+      if (selected == null) {
+        throw new IllegalStateException("Class family '" + family.root + "' is anchored to " + origin(anchor)
+          + ", but member '" + className + "' is only available from " + origins(candidates) + ".");
+      }
+    } else {
+      selected = choose(className, candidates);
+    }
+
+    warnIfDifferent(className, candidates, selected, family == null ? null : family.root);
+    Selection result = new Selection(selected.unit, selected.bytes(this), false);
+    this.selections.put(className, result);
+    return result;
+  }
+
+  synchronized boolean isSelectedFrom(String className, ContextUnit unit) {
+    Selection selection = select(className);
+    return selection != null && selection.unit == unit;
+  }
+
+  private List<Candidate> highestTierCandidates(String className) {
+    List<ContextUnit> eager = this.eagerCandidates.getOrDefault(className, List.of());
+    List<Candidate> own = new ArrayList<>();
+    for (ContextUnit unit : eager) {
+      if (unit.isOwn()) {
+        own.add(new Candidate(className, unit, null));
+      }
+    }
+    if (!own.isEmpty()) {
+      return own;
+    }
+
+    List<Candidate> libraries = new ArrayList<>();
+    Set<ContextUnit> added = Collections.newSetFromMap(new IdentityHashMap<>());
+    for (ContextUnit unit : this.units) {
+      if (unit.isOwn()) {
+        continue;
+      }
+      if (eager.contains(unit)) {
+        libraries.add(new Candidate(className, unit, null));
+        added.add(unit);
+      } else if (unit.isLazy()) {
+        byte[] bytes = probe(unit, className);
+        if (bytes != null && added.add(unit)) {
+          libraries.add(new Candidate(className, unit, bytes));
+        }
+      }
+    }
+    return libraries;
+  }
+
+  private @Nullable byte[] probe(ContextUnit unit, String className) {
+    ProbeKey key = new ProbeKey(unit, className);
+    Optional<byte[]> cached = this.lazyProbes.get(key);
+    if (cached == null) {
+      try {
+        cached = Optional.ofNullable(unit.getClassBytes(className));
+      } catch (IOException exception) {
+        throw new UncheckedIOException("Failed to probe class " + className + " from " + origin(unit), exception);
+      }
+      this.lazyProbes.put(key, cached);
+    }
+    return cached.orElse(null);
+  }
+
+  private Candidate choose(String className, List<Candidate> candidates) {
+    Strategy strategy = strategy();
+    if (strategy == Strategy.ERROR) {
+      byte[] first = candidates.get(0).bytes(this);
+      boolean differs = false;
+      for (int index = 1; index < candidates.size(); index++) {
+        if (!Arrays.equals(first, candidates.get(index).bytes(this))) {
+          differs = true;
+        }
+      }
+      if (differs) {
+        throw new IllegalStateException("Conflicting class '" + className + "' in highest-precedence origins: " + origins(candidates) + ".");
+      }
+      return candidates.get(0);
+    }
+    return strategy == Strategy.LAST ? candidates.get(candidates.size() - 1) : candidates.get(0);
+  }
+
+  private void warnIfDifferent(String className, List<Candidate> candidates, Candidate selected, @Nullable String familyRoot) {
+    if (candidates.size() < 2 || strategy() == Strategy.ERROR) {
+      return;
+    }
+    byte[] selectedBytes = selected.bytes(this);
+    List<Candidate> ignored = new ArrayList<>();
+    for (Candidate candidate : candidates) {
+      if (candidate != selected && !Arrays.equals(selectedBytes, candidate.bytes(this))) {
+        ignored.add(candidate);
+      }
+    }
+    if (ignored.isEmpty()) {
+      return;
+    }
+    DecompilerContext.getLogger().writeMessage(
+      "Duplicate class '" + className + "' resolved with strategy '" + strategy().value + "': selected " + origin(selected.unit)
+        + "; ignored " + origins(ignored) + "; metadata family root " + (familyRoot == null ? "<none>" : "'" + familyRoot + "'") + ".",
+      IFernflowerLogger.Severity.WARN);
+  }
+
+  private void initializeFamilies() {
+    if (this.familiesInitialized) {
+      return;
+    }
+    this.familiesInitialized = true;
+
+    Set<String> duplicateNames = new LinkedHashSet<>();
+    for (Map.Entry<String, List<ContextUnit>> entry : this.eagerCandidates.entrySet()) {
+      if (entry.getValue().stream().filter(ContextUnit::isOwn).limit(2).count() == 2) {
+        duplicateNames.add(entry.getKey());
+      }
+    }
+    if (duplicateNames.isEmpty()) {
+      return;
+    }
+
+    Map<String, LinkedHashSet<String>> graph = new LinkedHashMap<>();
+    Map<String, String> parents = new LinkedHashMap<>();
+    for (Map.Entry<String, List<ContextUnit>> entry : this.eagerCandidates.entrySet()) {
+      for (ContextUnit unit : entry.getValue()) {
+        if (!unit.isOwn()) {
+          continue;
+        }
+        StructClass metadata = parseMetadata(entry.getKey(), unit);
+        StructInnerClassesAttribute innerClasses = metadata.getAttribute(StructGeneralAttribute.ATTRIBUTE_INNER_CLASSES);
+        if (innerClasses != null) {
+          for (StructInnerClassesAttribute.Entry inner : innerClasses.getEntries()) {
+            if (inner.enclosingName != null && (inner.innerName.equals(metadata.qualifiedName) || inner.enclosingName.equals(metadata.qualifiedName))) {
+              link(graph, parents, inner.innerName, inner.enclosingName);
+            }
+          }
+        }
+        StructEnclosingMethodAttribute enclosingMethod = metadata.getAttribute(StructGeneralAttribute.ATTRIBUTE_ENCLOSING_METHOD);
+        if (enclosingMethod != null) {
+          link(graph, parents, metadata.qualifiedName, enclosingMethod.getClassName());
+        }
+      }
+    }
+
+    Set<String> visited = new HashSet<>();
+    for (String duplicateName : duplicateNames) {
+      if (!visited.add(duplicateName)) {
+        continue;
+      }
+      LinkedHashSet<String> component = new LinkedHashSet<>();
+      ArrayDeque<String> queue = new ArrayDeque<>();
+      queue.add(duplicateName);
+      while (!queue.isEmpty()) {
+        String current = queue.removeFirst();
+        if (!component.add(current)) {
+          continue;
+        }
+        for (String linked : graph.getOrDefault(current, new LinkedHashSet<>())) {
+          queue.addLast(linked);
+        }
+      }
+      visited.addAll(component);
+      if (component.stream().noneMatch(duplicateNames::contains)) {
+        continue;
+      }
+      String root = familyRoot(duplicateName, component, parents);
+      String anchorName = hasOwnCandidate(root) ? root : firstDuplicate(component, duplicateNames);
+      Family family = new Family(root, anchorName);
+      for (String member : component) {
+        this.families.put(member, family);
+      }
+    }
+  }
+
+  private StructClass parseMetadata(String className, ContextUnit unit) {
+    try {
+      byte[] bytes = unit.getClassBytes(className);
+      if (bytes == null) {
+        throw new IllegalStateException("Class '" + className + "' disappeared from " + origin(unit) + ".");
+      }
+      return StructClass.create(new DataInputFullStream(bytes), true);
+    } catch (IOException exception) {
+      throw new UncheckedIOException("Failed to read class metadata for " + className + " from " + origin(unit), exception);
+    }
+  }
+
+  private static void link(Map<String, LinkedHashSet<String>> graph, Map<String, String> parents, String member, String enclosing) {
+    graph.computeIfAbsent(member, key -> new LinkedHashSet<>()).add(enclosing);
+    graph.computeIfAbsent(enclosing, key -> new LinkedHashSet<>()).add(member);
+    parents.putIfAbsent(member, enclosing);
+  }
+
+  private static String familyRoot(String duplicateName, Set<String> component, Map<String, String> parents) {
+    String root = duplicateName;
+    Set<String> seen = new HashSet<>();
+    while (seen.add(root)) {
+      String parent = parents.get(root);
+      if (parent == null || !component.contains(parent)) {
+        break;
+      }
+      root = parent;
+    }
+    return root;
+  }
+
+  private boolean hasOwnCandidate(String className) {
+    return this.eagerCandidates.getOrDefault(className, List.of()).stream().anyMatch(ContextUnit::isOwn);
+  }
+
+  private String firstDuplicate(Set<String> component, Set<String> duplicateNames) {
+    for (String className : this.eagerCandidates.keySet()) {
+      if (component.contains(className) && duplicateNames.contains(className)) {
+        return className;
+      }
+    }
+    throw new IllegalStateException("No duplicate class found for active family");
+  }
+
+  private byte[] bytes(ContextUnit unit, String className) {
+    try {
+      byte[] bytes = unit.getClassBytes(className);
+      if (bytes == null) {
+        throw new IllegalStateException("Class '" + className + "' disappeared from " + origin(unit) + ".");
+      }
+      return bytes;
+    } catch (IOException exception) {
+      throw new UncheckedIOException("Failed to read class " + className + " from " + origin(unit), exception);
+    }
+  }
+
+  private Strategy strategy() {
+    Object value = DecompilerContext.getProperty(IFernflowerPreferences.DUPLICATE_CLASS_STRATEGY);
+    return value == null ? Strategy.FIRST : Strategy.valueOf(value.toString().toUpperCase(Locale.ROOT));
+  }
+
+  private String origin(ContextUnit unit) {
+    return "origin '" + unit.getName() + "' (#" + (this.units.indexOf(unit) + 1) + ")";
+  }
+
+  private String origins(Collection<Candidate> candidates) {
+    return candidates.stream().map(candidate -> origin(candidate.unit)).toList().toString();
+  }
+
+  static final class Selection {
+    private static final Selection MISSING = new Selection(null, null, true);
+    final ContextUnit unit;
+    final byte[] bytes;
+    final boolean missing;
+
+    private Selection(ContextUnit unit, byte[] bytes, boolean missing) {
+      this.unit = unit;
+      this.bytes = bytes;
+      this.missing = missing;
+    }
+  }
+
+  private static final class Candidate {
+    final String className;
+    final ContextUnit unit;
+    private byte[] bytes;
+
+    private Candidate(String className, ContextUnit unit, byte[] bytes) {
+      this.className = className;
+      this.unit = unit;
+      this.bytes = bytes;
+    }
+
+    byte[] bytes(DuplicateClassResolver resolver) {
+      if (this.bytes == null) {
+        this.bytes = resolver.bytes(this.unit, this.className);
+      }
+      return this.bytes;
+    }
+  }
+
+
+  private final class Family {
+    final String root;
+    final String anchorName;
+    private ContextUnit anchoredOrigin;
+
+    private Family(String root, String anchorName) {
+      this.root = root;
+      this.anchorName = anchorName;
+    }
+
+    ContextUnit anchor(DuplicateClassResolver resolver) {
+      if (this.anchoredOrigin == null) {
+        List<Candidate> candidates = resolver.highestTierCandidates(this.anchorName);
+        Candidate selected = resolver.choose(this.anchorName, candidates);
+        resolver.warnIfDifferent(this.anchorName, candidates, selected, this.root);
+        this.anchoredOrigin = selected.unit;
+        resolver.selections.put(this.anchorName, new Selection(selected.unit, selected.bytes(resolver), false));
+      }
+      return this.anchoredOrigin;
+    }
+  }
+
+  private record ProbeKey(ContextUnit unit, String className) {
+  }
+
+  private enum Strategy {
+    FIRST("first"), LAST("last"), ERROR("error");
+
+    final String value;
+
+    Strategy(String value) {
+      this.value = value;
+    }
+  }
+}
