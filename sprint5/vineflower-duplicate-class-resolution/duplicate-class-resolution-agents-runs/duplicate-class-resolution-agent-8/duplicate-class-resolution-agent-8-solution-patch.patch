+package org.jetbrains.java.decompiler.struct;
+
+import org.jetbrains.java.decompiler.main.ClassesProcessor;
+import org.jetbrains.java.decompiler.main.DecompilerContext;
+import org.jetbrains.java.decompiler.main.Fernflower;
+import org.jetbrains.java.decompiler.main.extern.IContextSource;
+import org.jetbrains.java.decompiler.main.extern.IFernflowerLogger;
+import org.jetbrains.java.decompiler.main.extern.IFernflowerPreferences;
+import org.jetbrains.java.decompiler.main.extern.IResultSaver;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+import javax.tools.JavaCompiler;
+import javax.tools.StandardJavaFileManager;
+import javax.tools.ToolProvider;
+import java.io.ByteArrayInputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.*;
+import java.util.concurrent.atomic.AtomicInteger;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class DuplicateClassResolutionTest {
+  @TempDir
+  Path tempDir;
+
+  @AfterEach
+  void tearDown() {
+    DecompilerContext.setCurrentContext(null);
+  }
+
+  @Test
+  void rejectsInvalidStrategyBeforeCreatingContext() {
+    IllegalArgumentException exception = assertThrows(IllegalArgumentException.class, () ->
+      new Fernflower((IResultSaver)null, Map.of(IFernflowerPreferences.DUPLICATE_CLASS_STRATEGY, "middle"), IFernflowerLogger.NO_OP));
+
+    assertTrue(exception.getMessage().contains("first, last, error"));
+    assertNull(DecompilerContext.getCurrentContext());
+  }
+
+  @Test
+  void defaultsToFirstAndLastCanReplaceCachedSelection() throws IOException {
+    byte[] java21 = Files.readAllBytes(Path.of("testData/classes/java21/ext/RefsExt.class"));
+    byte[] java25 = Files.readAllBytes(Path.of("testData/classes/java25/ext/RefsExt.class"));
+    CapturingLogger logger = new CapturingLogger();
+    StructContext context = context("first", logger);
+
+    context.addSpace(source("same", Map.of("ext/RefsExt", java21)), true);
+    assertEquals(65, context.getClass("ext/RefsExt").getVersion().major);
+
+    DecompilerContext.getCurrentContext().properties.put(IFernflowerPreferences.DUPLICATE_CLASS_STRATEGY, "last");
+    context.addSpace(source("same", Map.of("ext/RefsExt", java25)), true);
+
+    assertEquals(69, context.getClass("ext/RefsExt").getVersion().major);
+    assertEquals(1, logger.warningCount("Duplicate class 'ext/RefsExt'"));
+    assertTrue(logger.messages.stream().anyMatch(message -> message.contains("origin 'same' (#2)")));
+  }
+
+  @Test
+  void errorAllowsIdenticalBytesButRejectsEveryDifferingOrigin() throws IOException {
+    byte[] java21 = Files.readAllBytes(Path.of("testData/classes/java21/ext/RefsExt.class"));
+    byte[] java25 = Files.readAllBytes(Path.of("testData/classes/java25/ext/RefsExt.class"));
+    StructContext identical = context("error", new CapturingLogger());
+    identical.addSpace(source("copy", Map.of("ext/RefsExt", java21)), true);
+    identical.addSpace(source("copy", Map.of("ext/RefsExt", java21)), true);
+    assertNotNull(identical.getClass("ext/RefsExt"));
+
+    StructContext differing = context("error", new CapturingLogger());
+    differing.addSpace(source("copy", Map.of("ext/RefsExt", java21)), true);
+    differing.addSpace(source("copy", Map.of("ext/RefsExt", java25)), true);
+    IllegalStateException exception = assertThrows(IllegalStateException.class, () -> differing.getClass("ext/RefsExt"));
+    assertTrue(exception.getMessage().contains("origin 'copy' (#1)"));
+    assertTrue(exception.getMessage().contains("origin 'copy' (#2)"));
+  }
+
+  @Test
+  void ownClassOutranksLibrariesWithoutProbingLazyOrigins() throws IOException {
+    byte[] java21 = Files.readAllBytes(Path.of("testData/classes/java21/ext/RefsExt.class"));
+    byte[] java25 = Files.readAllBytes(Path.of("testData/classes/java25/ext/RefsExt.class"));
+    AtomicInteger probes = new AtomicInteger();
+    StructContext context = context("last", new CapturingLogger());
+
+    context.addSpace(source("own", Map.of("ext/RefsExt", java21)), true);
+    context.addSpace(lazySource("lazy", "ext/RefsExt", java25, probes), false);
+
+    assertEquals(65, context.getClass("ext/RefsExt").getVersion().major);
+    assertEquals(0, probes.get());
+  }
+
+  @Test
+  void lazyPositiveAndNegativeProbesAreCachedAndInvalidatedByRegistration() throws IOException {
+    byte[] java21 = Files.readAllBytes(Path.of("testData/classes/java21/ext/RefsExt.class"));
+    AtomicInteger probes = new AtomicInteger();
+    StructContext context = context("first", new CapturingLogger());
+    context.addSpace(lazySource("lazy", "ext/RefsExt", java21, probes), false);
+
+    assertTrue(context.hasClass("ext/RefsExt"));
+    assertNotNull(context.getClass("ext/RefsExt"));
+    assertFalse(context.hasClass("missing/Type"));
+    assertFalse(context.hasClass("missing/Type"));
+    assertEquals(2, probes.get());
+
+    context.addSpace(source("empty", Map.of()), false);
+    assertTrue(context.hasClass("ext/RefsExt"));
+    assertFalse(context.hasClass("missing/Type"));
+    assertEquals(4, probes.get());
+  }
+
+  @Test
+  void availableFamilyRootAnchorsLaterMembers() throws IOException {
+    Path first = compileFamily("8", "return 8;", "return 80;");
+    Path last = compileFamily("17", "return 17;", "return 170;");
+    StructContext context = context("last", new CapturingLogger());
+
+    context.addSpace(source("first", classes(first, "dup/Family", "dup/Family$Member")), true);
+    context.addSpace(source("last", classes(last, "dup/Family$Member")), true);
+
+    assertEquals(52, context.getClass("dup/Family").getVersion().major);
+    assertEquals(52, context.getClass("dup/Family$Member").getVersion().major);
+  }
+
+  @Test
+  void familyFailsWhenAnchoredOriginDoesNotContainEncounteredMember() throws IOException {
+    Path first = compileFamily("8", "return 8;", "return 80;");
+    Path last = compileExtendedFamily();
+    StructContext context = context("last", new CapturingLogger());
+
+    context.addSpace(source("first", classes(first, "dup/Family", "dup/Family$Member")), true);
+    context.addSpace(source("last", classes(last, "dup/Family$Member", "dup/Family$OnlyLast")), true);
+
+    IllegalStateException exception = assertThrows(IllegalStateException.class, () -> context.getClass("dup/Family$OnlyLast"));
+    assertTrue(exception.getMessage().contains("dup/Family"));
+    assertTrue(exception.getMessage().contains("dup/Family$OnlyLast"));
+    assertTrue(exception.getMessage().contains("origin 'first' (#1)"));
+    assertTrue(exception.getMessage().contains("origin 'last' (#2)"));
+  }
+
+  private StructContext context(String strategy, CapturingLogger logger) {
+    Map<String, Object> properties = new HashMap<>(IFernflowerPreferences.DEFAULTS);
+    properties.put(IFernflowerPreferences.DUPLICATE_CLASS_STRATEGY, strategy);
+    properties.put(IFernflowerPreferences.INCLUDE_JAVA_RUNTIME, "");
+    StructContext context = new StructContext((IResultSaver)null, null);
+    DecompilerContext.setCurrentContext(new DecompilerContext(properties, logger, context, new ClassesProcessor(context), null));
+    return context;
+  }
+
+  private static IContextSource source(String name, Map<String, byte[]> classes) {
+    return new ByteSource(name, classes, false, null);
+  }
+
+  private static IContextSource lazySource(String name, String className, byte[] bytes, AtomicInteger probes) {
+    return new ByteSource(name, Map.of(className, bytes), true, probes);
+  }
+
+  private static Map<String, byte[]> classes(Path root, String... names) throws IOException {
+    Map<String, byte[]> classes = new LinkedHashMap<>();
+    for (String name : names) {
+      classes.put(name, Files.readAllBytes(root.resolve(name + ".class")));
+    }
+    return classes;
+  }
+
+  private Path compileFamily(String release, String rootBody, String memberBody) throws IOException {
+    return compile(release, "package dup; public class Family { public int root() { " + rootBody
+      + " } public static class Member { public int member() { " + memberBody + " } } }");
+  }
+
+  private Path compileExtendedFamily() throws IOException {
+    return compile("17", "package dup; public class Family { public static class Member { } public static class OnlyLast { } }");
+  }
+
+  private Path compile(String release, String source) throws IOException {
+    Path sourceRoot = Files.createTempDirectory(this.tempDir, "src");
+    Path outputRoot = Files.createTempDirectory(this.tempDir, "classes");
+    Path sourceFile = sourceRoot.resolve("dup/Family.java");
+    Files.createDirectories(sourceFile.getParent());
+    Files.writeString(sourceFile, source);
+
+    JavaCompiler compiler = ToolProvider.getSystemJavaCompiler();
+    assertNotNull(compiler);
+    try (StandardJavaFileManager files = compiler.getStandardFileManager(null, null, null)) {
+      boolean success = compiler.getTask(null, files, null, List.of("--release", release, "-d", outputRoot.toString()), null,
+        files.getJavaFileObjects(sourceFile.toFile())).call();
+      assertTrue(success);
+    }
+    return outputRoot;
+  }
+
+  private static final class ByteSource implements IContextSource {
+    private final String name;
+    private final Map<String, byte[]> classes;
+    private final boolean lazy;
+    private final AtomicInteger probes;
+
+    private ByteSource(String name, Map<String, byte[]> classes, boolean lazy, AtomicInteger probes) {
+      this.name = name;
+      this.classes = classes;
+      this.lazy = lazy;
+      this.probes = probes;
+    }
+
+    @Override
+    public String getName() {
+      return this.name;
+    }
+
+    @Override
+    public Entries getEntries() {
+      if (this.lazy) {
+        return Entries.EMPTY;
+      }
+      return new Entries(this.classes.keySet().stream().map(Entry::atBase).toList(), List.of(), List.of());
+    }
+
+    @Override
+    public boolean isLazy() {
+      return this.lazy;
+    }
+
+    @Override
+    public byte[] getClassBytes(String className) {
+      if (this.probes != null) {
+        this.probes.incrementAndGet();
+      }
+      return this.classes.get(className);
+    }
+
+    @Override
+    public InputStream getInputStream(String resource) {
+      byte[] bytes = resource.endsWith(CLASS_SUFFIX) ? this.classes.get(resource.substring(0, resource.length() - CLASS_SUFFIX.length())) : null;
+      return bytes == null ? null : new ByteArrayInputStream(bytes);
+    }
+  }
+
+  private static final class CapturingLogger extends IFernflowerLogger {
+    private final List<String> messages = new ArrayList<>();
+
+    @Override
+    public void writeMessage(String message, Severity severity) {
+      this.messages.add(severity + ": " + message);
+    }
+
+    @Override
+    public void writeMessage(String message, Severity severity, Throwable throwable) {
+      writeMessage(message, severity);
+    }
+
+    int warningCount(String fragment) {
+      return (int)this.messages.stream().filter(message -> message.startsWith("WARN") && message.contains(fragment)).count();
+    }
+  }
+}
