+    Harness harness = harness(null, 1);
+
+    harness.context.addSpace(first, true);
+    harness.context.addSpace(second, true);
+
+    List<StructClass> ownClasses = harness.context.getOwnClasses();
+    assertEquals(3, ownClasses.size());
+    assertHasMethod(harness.context.getClass(DUPLICATE), "firstMarker");
+    harness.context.saveContext();
+
+    assertEquals(2, first.sink.classNames.size());
+    assertEquals(Set.of(DUPLICATE, "sample/FirstOnly"), Set.copyOf(first.sink.classNames));
+    assertEquals(List.of("sample/SecondOnly"), second.sink.classNames);
+    assertEquals(List.of("resource-first-origin.txt"), first.sink.otherEntries);
+    assertEquals(List.of("resource-second-origin.txt"), second.sink.otherEntries);
+    assertEquals(1, harness.logger.warnings().size());
+  }
