+
+  @Test
+  void invalidStrategyListsAcceptedValues() {
+    IllegalArgumentException exception = assertThrows(IllegalArgumentException.class, () -> DuplicateClassStrategy.parse("middle"));
+    assertTrue(exception.getMessage().contains("first, last, error"));
