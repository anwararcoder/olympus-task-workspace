+
+  @Test
+  void selectsFirstAndLastDistinctOrigins() throws IOException {
+    byte[] firstBytes = compile("first", "pkg.Duplicate", "package pkg; public class Duplicate { public int value() { return 1; } }").get("pkg/Duplicate");
+    byte[] lastBytes = compile("last", "pkg.Duplicate", "package pkg; public class Duplicate { public int value() { return 2; } }").get("pkg/Duplicate");
+
+    ClassResolver first = new ClassResolver(DuplicateClassStrategy.FIRST);
+    ContextUnit firstOrigin = unit("same-name", true, 0, Map.of("pkg/Duplicate", firstBytes));
+    ContextUnit lastOrigin = unit("same-name", true, 1, Map.of("pkg/Duplicate", lastBytes));
+    first.register(firstOrigin);
+    first.register(lastOrigin);
+    assertSame(firstOrigin, first.select("pkg/Duplicate").origin());
+
+    ClassResolver last = new ClassResolver(DuplicateClassStrategy.LAST);
+    last.register(firstOrigin);
+    last.register(lastOrigin);
+    assertSame(lastOrigin, last.select("pkg/Duplicate").origin());
+  }
+
+  @Test
+  void ownCandidateOutranksLibrariesForEveryStrategy() throws IOException {
+    byte[] ownBytes = compile("own", "pkg.Priority", "package pkg; public class Priority { public int value() { return 1; } }").get("pkg/Priority");
+    byte[] libraryBytes = compile("library", "pkg.Priority", "package pkg; public class Priority { public int value() { return 2; } }").get("pkg/Priority");
+
+    for (DuplicateClassStrategy strategy : DuplicateClassStrategy.values()) {
+      ClassResolver resolver = new ClassResolver(strategy);
+      ContextUnit library = unit("library", false, 0, Map.of("pkg/Priority", libraryBytes));
+      ContextUnit own = unit("own", true, 1, Map.of("pkg/Priority", ownBytes));
+      resolver.register(library);
+      resolver.register(own);
+      assertSame(own, resolver.select("pkg/Priority").origin());
+    }
+  }
+
+  @Test
+  void errorAllowsIdenticalBytesAndRejectsAllDifferingOrigins() throws IOException {
+    byte[] firstBytes = compile("identical", "pkg.Conflict", "package pkg; public class Conflict { }").get("pkg/Conflict");
+    byte[] differingBytes = compile("differing", "pkg.Conflict", "package pkg; public class Conflict { public int value() { return 2; } }").get("pkg/Conflict");
+
+    ClassResolver identical = new ClassResolver(DuplicateClassStrategy.ERROR);
+    ContextUnit first = unit("duplicate", true, 0, Map.of("pkg/Conflict", firstBytes));
+    ContextUnit second = unit("duplicate", true, 1, Map.of("pkg/Conflict", firstBytes));
+    identical.register(first);
+    identical.register(second);
+    assertSame(first, identical.select("pkg/Conflict").origin());
+
+    ClassResolver differing = new ClassResolver(DuplicateClassStrategy.ERROR);
+    ContextUnit third = unit("duplicate", true, 2, Map.of("pkg/Conflict", differingBytes));
+    differing.register(first);
+    differing.register(second);
+    differing.register(third);
+    IllegalStateException exception = assertThrows(IllegalStateException.class, () -> differing.select("pkg/Conflict"));
+    assertTrue(exception.getMessage().contains("origin 1"));
+    assertTrue(exception.getMessage().contains("origin 2"));
+    assertTrue(exception.getMessage().contains("origin 3"));
+  }
+
+  @Test
+  void cachesPositiveAndNegativeLazyProbesUntilInvalidated() throws IOException {
+    byte[] bytes = compile("lazy", "pkg.Lazy", "package pkg; public class Lazy { }").get("pkg/Lazy");
+    AtomicInteger probes = new AtomicInteger();
+    IContextSource lazySource = new MemorySource("lazy", Map.of("pkg/Lazy", bytes), true, probes);
+    ContextUnit lazy = new ContextUnit(lazySource, false, true, 0, null, null);
+    ClassResolver resolver = new ClassResolver(DuplicateClassStrategy.FIRST);
+    resolver.register(lazy);
+
+    assertNotNull(resolver.select("pkg/Lazy"));
+    assertNotNull(resolver.select("pkg/Lazy"));
+    assertNull(resolver.select("pkg/Missing"));
+    assertNull(resolver.select("pkg/Missing"));
+    assertEquals(2, probes.get());
+
+    resolver.register(unit("other", false, 1, Map.of()));
+    assertNotNull(resolver.select("pkg/Lazy"));
+    assertNull(resolver.select("pkg/Missing"));
+    assertEquals(2, probes.get());
+  }
+
+  @Test
+  void familyRootAnchorsDuplicateMember() throws IOException {
+    Map<String, byte[]> firstFamily = compile(
+      "family-first",
+      "family.Root",
+      "package family; public class Root { public static class Member { public int value() { return 1; } } }"
+    );
+    Map<String, byte[]> lastFamily = compile(
+      "family-last",
+      "family.Root",
+      "package family; public class Root { public static class Member { public int value() { return 2; } } }"
+    );
+
+    ClassResolver resolver = new ClassResolver(DuplicateClassStrategy.LAST);
+    ContextUnit first = unit("family", true, 0, firstFamily);
+    ContextUnit last = unit("family", true, 1, lastFamily);
+    resolver.register(first);
+    resolver.register(last);
+
+    ClassResolver.Selection member = resolver.select("family/Root$Member");
+    assertSame(last, member.origin());
+    assertEquals("family/Root", member.familyRoot());
+    assertSame(last, resolver.select("family/Root").origin());
+  }
+
+  @Test
+  void missingAnchoredMemberReportsAlternativeOrigins() throws IOException {
+    Map<String, byte[]> firstFamily = compile(
+      "missing-first",
+      "family.Root",
+      "package family; public class Root { public static class Member { public int value() { return 1; } } }"
+    );
+    Map<String, byte[]> secondFamily = compile(
+      "missing-second",
+      "family.Root",
+      "package family; public class Root { public static class Member { public int value() { return 2; } } }"
+    );
+    Map<String, byte[]> thirdFamily = compile(
+      "missing-third",
+      "family.Root",
+      "package family; public class Root { public static class Member { public int value() { return 3; } } }"
+    );
+
+    ClassResolver resolver = new ClassResolver(DuplicateClassStrategy.FIRST);
+    ContextUnit root = unit("root", true, 0, Map.of("family/Root", firstFamily.get("family/Root")));
+    ContextUnit second = unit("member", true, 1, Map.of("family/Root$Member", secondFamily.get("family/Root$Member")));
+    ContextUnit third = unit("member", true, 2, Map.of("family/Root$Member", thirdFamily.get("family/Root$Member")));
+    resolver.register(root);
+    resolver.register(second);
+    resolver.register(third);
+
+    IllegalStateException exception = assertThrows(IllegalStateException.class, () -> resolver.select("family/Root$Member"));
+    assertTrue(exception.getMessage().contains("family root: family/Root"));
+    assertTrue(exception.getMessage().contains("member: family/Root$Member"));
+    assertTrue(exception.getMessage().contains("anchored origin: root [origin 1]"));
+    assertTrue(exception.getMessage().contains("member [origin 2]"));
+    assertTrue(exception.getMessage().contains("member [origin 3]"));
+  }
+
+  @Test
+  void enclosingMethodLinksLocalClassFamily() throws IOException {
+    Map<String, byte[]> firstFamily = compile(
+      "local-first",
+      "family.LocalRoot",
+      "package family; public class LocalRoot { public Object make() { class Local { int value() { return 1; } } return new Local(); } }"
+    );
+    Map<String, byte[]> secondFamily = compile(
+      "local-second",
+      "family.LocalRoot",
+      "package family; public class LocalRoot { public Object make() { class Local { int value() { return 2; } } return new Local(); } }"
+    );
+    Map<String, byte[]> thirdFamily = compile(
+      "local-third",
+      "family.LocalRoot",
+      "package family; public class LocalRoot { public Object make() { class Local { int value() { return 3; } } return new Local(); } }"
+    );
+    String localName = firstFamily.keySet().stream().filter(name -> !name.equals("family/LocalRoot")).findFirst().orElseThrow();
+
+    ClassResolver resolver = new ClassResolver(DuplicateClassStrategy.FIRST);
+    resolver.register(unit("root", true, 0, Map.of("family/LocalRoot", firstFamily.get("family/LocalRoot"))));
+    resolver.register(unit("local", true, 1, Map.of(localName, secondFamily.get(localName))));
+    resolver.register(unit("local", true, 2, Map.of(localName, thirdFamily.get(localName))));
+
+    IllegalStateException exception = assertThrows(IllegalStateException.class, () -> resolver.select(localName));
+    assertTrue(exception.getMessage().contains("family root: family/LocalRoot"));
