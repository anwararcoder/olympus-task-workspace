+      "package family;\n"
+        + "public class Siblings {\n"
+        + "  public static class One { public void " + oneMarker + "() {} }\n"
+        + "  public static class Two { public void " + twoMarker + "() {} }\n"
+        + "}\n"
+    );
+  }
+
+  private static Map<String, byte[]> nestedFamily(String rootMarker, String middleMarker, String leafMarker) {
+    return compileClasses(
+      "family/DeepOuter",
+      "package family;\n"
+        + "public class DeepOuter {\n"
+        + "  public void " + rootMarker + "() {}\n"
+        + "  public static class Middle {\n"
+        + "    public void " + middleMarker + "() {}\n"
+        + "    public static class Leaf { public void " + leafMarker + "() {} }\n"
+        + "  }\n"
+        + "}\n"
+    );
+  }
+
+  private static Map<String, byte[]> localFamily(String rootMarker, String memberMarker) {
+    return compileClasses(
+      "family/LocalOuter",
+      "package family;\n"
+        + "public class LocalOuter {\n"
+        + "  public void " + rootMarker + "() {}\n"
+        + "  public Object create() {\n"
+        + "    class Local { public void " + memberMarker + "() {} }\n"
+        + "    return new Local();\n"
+        + "  }\n"
+        + "}\n"
+    );
+  }
+
+  private static Map<String, byte[]> compileClasses(String binaryName, String sourceText) {
+    try {
+      Path compilation = Files.createTempDirectory(compilationRoot, "family-");
+      Path sourceRoot = compilation.resolve("src");
+      Path outputRoot = compilation.resolve("out");
+      Path source = sourceRoot.resolve(binaryName + ".java");
+      Files.createDirectories(source.getParent());
+      Files.createDirectories(outputRoot);
+      Files.writeString(source, sourceText);
+      JavaCompiler compiler = ToolProvider.getSystemJavaCompiler();
+      assertNotNull(compiler, "Tests require a JDK, not a JRE");
+      assertEquals(
+        0,
+        compiler.run(null, null, null, "-g:none", "-d", outputRoot.toString(), source.toString()),
+        "Could not compile " + binaryName
+      );
+
+      Map<String, byte[]> classes = new LinkedHashMap<>();
+      try (Stream<Path> files = Files.walk(outputRoot)) {
+        for (Path file : files.filter(path -> path.toString().endsWith(".class")).sorted().toList()) {
+          String relative = outputRoot.relativize(file).toString().replace(file.getFileSystem().getSeparator(), "/");
+          classes.put(relative.substring(0, relative.length() - ".class".length()), Files.readAllBytes(file));
+        }
+      }
+      return classes;
+    } catch (IOException ex) {
+      throw new RuntimeException(ex);
+    }
+  }
+
+  private static void assertHasMethod(StructClass clazz, String method) {
+    assertNotNull(clazz);
+    assertNotNull(clazz.getMethod(method, "()V"), "Missing method " + method);
+  }
+
+  private static void assertMessageContainsInOrder(String message, String... fragments) {
+    int offset = 0;
+    for (String fragment : fragments) {
+      int next = message.indexOf(fragment, offset);
+      assertTrue(next >= offset, "Expected '" + fragment + "' after offset " + offset + " in: " + message);
+      offset = next + fragment.length();
+    }
+  }
+
+  private record Harness(
+    StructContext context,
+    ClassesProcessor processor,
+    Map<String, Object> properties,
+    CollectingLogger logger
+  ) {
+  }
+
+  private static final class MemorySource implements IContextSource {
+    private final String name;
+    private final boolean lazy;
+    private final Map<String, byte[]> classes;
+    private final List<IContextSource> children;
+    private final boolean withResource;
+    private final RecordingSink sink = new RecordingSink();
+    private final AtomicInteger classReads = new AtomicInteger();
+    private List<String> entryNames;
+
+    private MemorySource(
+      String name,
+      boolean lazy,
+      Map<String, byte[]> classes,
+      List<IContextSource> children,
+      boolean withResource
+    ) {
+      this.name = name;
+      this.lazy = lazy;
+      this.classes = new LinkedHashMap<>(classes);
+      this.children = List.copyOf(children);
+      this.withResource = withResource;
+      this.entryNames = new ArrayList<>(classes.keySet());
+    }
+
+    private void put(String className, byte[] bytes) {
+      this.classes.put(className, bytes);
+      if (!this.entryNames.contains(className)) {
+        this.entryNames = new ArrayList<>(this.entryNames);
+        this.entryNames.add(className);
+      }
+    }
+
+    @Override
+    public String getName() {
+      return this.name;
+    }
+
+    @Override
+    public Entries getEntries() {
+      if (this.lazy) {
+        return Entries.EMPTY;
+      }
+
+      List<Entry> classEntries = this.entryNames.stream().map(Entry::atBase).toList();
+      List<Entry> others = this.withResource
+        ? List.of(Entry.atBase("resource-" + this.name + ".txt"))
+        : List.of();
+      return new Entries(classEntries, List.of(), others, this.children);
+    }
+
+    @Override
+    public boolean isLazy() {
+      return this.lazy;
+    }
+
+    @Override
+    public byte[] getClassBytes(String className) {
+      this.classReads.incrementAndGet();
+      byte[] bytes = this.classes.get(className);
+      return bytes == null ? null : bytes.clone();
+    }
+
+    @Override
+    public InputStream getInputStream(String resource) {
+      String className = resource.endsWith(CLASS_SUFFIX)
+        ? resource.substring(0, resource.length() - CLASS_SUFFIX.length())
+        : resource;
+      byte[] bytes = this.classes.get(className);
+      if (bytes != null) {
+        return new ByteArrayInputStream(bytes);
+      }
+      if (resource.equals("resource-" + this.name + ".txt")) {
+        return new ByteArrayInputStream(this.name.getBytes());
+      }
+      return null;
+    }
+
+    @Override
+    public IOutputSink createOutputSink(IResultSaver saver) {
+      return this.sink;
+    }
+  }
+
+  private static final class RecordingSink implements IContextSource.IOutputSink {
+    private final List<String> classNames = new ArrayList<>();
+    private final List<String> classContents = new ArrayList<>();
+    private final List<String> otherEntries = new ArrayList<>();
+
+    @Override
+    public void begin() {
+    }
+
+    @Override
+    public synchronized void acceptClass(
+      String qualifiedName,
+      String fileName,
+      String content,
+      int[] mapping
+    ) {
+      this.classNames.add(qualifiedName);
+      this.classContents.add(content);
+    }
+
+    @Override
+    public void acceptDirectory(String directory) {
+    }
+
+    @Override
+    public void acceptOther(String path) {
+      this.otherEntries.add(path);
+    }
+
+    @Override
+    public void close() {
+    }
+  }
+
+  private static final class CollectingLogger extends IFernflowerLogger {
+    private final List<Message> messages = new ArrayList<>();
+
+    @Override
+    public synchronized void writeMessage(String message, Severity severity) {
+      this.messages.add(new Message(message, severity));
+    }
+
+    @Override
+    public synchronized void writeMessage(String message, Severity severity, Throwable throwable) {
+      this.messages.add(new Message(message, severity));
+    }
+
+    private synchronized List<String> warnings() {
+      return this.messages.stream()
+        .filter(message -> message.severity() == Severity.WARN)
+        .map(Message::text)
+        .toList();
+    }
+  }
+
+  private record Message(String text, IFernflowerLogger.Severity severity) {
+  }
+
+  private static final class TestFernflower extends Fernflower {
+    private TestFernflower(Map<String, Object> properties, IFernflowerLogger logger) {
+      super(NO_OP_SAVER, properties, logger);
+    }
+
+    @Override
+    public String getClassEntryName(StructClass clazz, String entryName) {
+      return entryName + ".java";
+    }
+
+    @Override
+    public void processClass(StructClass clazz) {
+    }
+
+    @Override
+    public String getClassContent(StructClass clazz) {
+      return clazz.getMethods().stream()
+        .map(method -> method.getName())
+        .sorted()
+        .toList()
+        .toString();
+    }
+  }
+
+  private static final IResultSaver NO_OP_SAVER = new IResultSaver() {
+    @Override
+    public void saveFolder(String path) {
+    }
+
+    @Override
+    public void copyFile(String source, String path, String entryName) {
+    }
+
+    @Override
+    public void saveClassFile(String path, String qualifiedName, String entryName, String content, int[] mapping) {
+    }
+
+    @Override
+    public void createArchive(String path, String archiveName, Manifest manifest) {
+    }
+
+    @Override
+    public void saveDirEntry(String path, String archiveName, String entryName) {
+    }
+
+    @Override
+    public void copyEntry(String source, String path, String archiveName, String entry) {
+    }
+
+    @Override
+    public void saveClassEntry(
+      String path,
+      String archiveName,
+      String qualifiedName,
+      String entryName,
+      String content
+    ) {
+    }
+
+    @Override
+    public void closeArchive(String path, String archiveName) {
+    }
+  };
+}
