diff --git a/src/org/jetbrains/java/decompiler/struct/DuplicateClassStrategy.java b/src/org/jetbrains/java/decompiler/struct/DuplicateClassStrategy.java
new file mode 100644
index 0000000..ea9780f
--- /dev/null
+++ b/src/org/jetbrains/java/decompiler/struct/DuplicateClassStrategy.java
@@ -0,0 +1,29 @@
+package org.jetbrains.java.decompiler.struct;
+
+import java.util.Locale;
+
+public enum DuplicateClassStrategy {
+  FIRST("first"),
+  LAST("last"),
+  ERROR("error");
+
+  private final String optionValue;
+
+  DuplicateClassStrategy(String optionValue) {
+    this.optionValue = optionValue;
+  }
+
+  public String optionValue() {
+    return this.optionValue;
+  }
+
+  public static DuplicateClassStrategy parse(Object value) {
+    String option = String.valueOf(value).toLowerCase(Locale.ROOT);
+    for (DuplicateClassStrategy strategy : values()) {
+      if (strategy.optionValue.equals(option)) {
+        return strategy;
+      }
+    }
+    throw new IllegalArgumentException("Invalid duplicate-class-strategy '" + value + "'; accepted values are first, last, error");
+  }
+}
