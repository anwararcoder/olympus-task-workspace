+
+  @Test
+  void literalDollarDoesNotCreateFamilyLink() throws IOException {
+    byte[] rootBytes = compile("dollar-root", "dollar.Root", "package dollar; public class Root { }").get("dollar/Root");
+    byte[] firstBytes = compile("dollar-first", "dollar.Root$Member", "package dollar; public class Root$Member { public int value() { return 1; } }").get("dollar/Root$Member");
+    byte[] lastBytes = compile("dollar-last", "dollar.Root$Member", "package dollar; public class Root$Member { public int value() { return 2; } }").get("dollar/Root$Member");
