+  private static Harness harness(String strategy, int threads) {
+    Map<String, Object> properties = new HashMap<>(IFernflowerPreferences.DEFAULTS);
+    properties.put(IFernflowerPreferences.INCLUDE_JAVA_RUNTIME, "");
+    properties.put(IFernflowerPreferences.THREADS, Integer.toString(threads));
+    if (strategy != null) {
+      properties.put(OPTION, strategy);
+    }
+
+    CollectingLogger logger = new CollectingLogger();
+    new TestFernflower(properties, logger);
+    DecompilerContext current = DecompilerContext.getCurrentContext();
+    Harness harness = new Harness(current.structContext, current.classProcessor, current.properties, logger);
+    setCurrent(harness);
+    return harness;
+  }
