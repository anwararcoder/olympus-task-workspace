+package org.jetbrains.java.decompiler.struct;
+
+import org.jetbrains.java.decompiler.main.ClassesProcessor;
+import org.jetbrains.java.decompiler.main.DecompilerContext;
+import org.jetbrains.java.decompiler.main.Init;
+import org.jetbrains.java.decompiler.main.extern.IContextSource;
+import org.jetbrains.java.decompiler.main.extern.IFernflowerLogger;
+import org.jetbrains.java.decompiler.main.extern.IFernflowerPreferences;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.Test;
+
+import java.io.ByteArrayInputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+public class DuplicateClassResolutionTest {
+  private static final Path CLASSES = Path.of("testData", "classes");
+
+  @AfterEach
+  public void clearContext() {
+    DecompilerContext.setCurrentContext(null);
+  }
+
+  @Test
+  public void firstAndLastUseOriginRegistrationOrder() throws IOException {
+    byte[] java16 = Files.readAllBytes(CLASSES.resolve("java16/ext/Direction.class"));
+    byte[] java17 = Files.readAllBytes(CLASSES.resolve("java17preview/ext/Direction.class"));
+
+    StructContext first = context(DuplicateClassStrategy.FIRST, new RecordingLogger());
+    first.addSpace(source("same name", Map.of("ext/Direction", java16)), true);
+    first.addSpace(source("same name", Map.of("ext/Direction", java17)), true);
+    assertEquals(60, first.getClass("ext/Direction").getVersion().major);
+
+    StructContext last = context(DuplicateClassStrategy.LAST, new RecordingLogger());
+    last.addSpace(source("same name", Map.of("ext/Direction", java16)), true);
+    last.addSpace(source("same name", Map.of("ext/Direction", java17)), true);
+    assertEquals(61, last.getClass("ext/Direction").getVersion().major);
+  }
+
+  @Test
+  public void errorReportsEveryDifferingHighestTierOrigin() throws IOException {
+    byte[] java16 = Files.readAllBytes(CLASSES.resolve("java16/ext/Direction.class"));
+    byte[] java17 = Files.readAllBytes(CLASSES.resolve("java17preview/ext/Direction.class"));
+    StructContext context = context(DuplicateClassStrategy.ERROR, new RecordingLogger());
+    context.addSpace(source("same name", Map.of("ext/Direction", java16)), true);
+    context.addSpace(source("same name", Map.of("ext/Direction", java17)), true);
+
+    IllegalStateException exception = assertThrows(IllegalStateException.class, () -> context.getClass("ext/Direction"));
+    assertTrue(exception.getMessage().contains("same name [origin 1]"));
+    assertTrue(exception.getMessage().contains("same name [origin 2]"));
+  }
+
+  @Test
+  public void lazyProbesAreCachedAndRespectGlobalOrder() throws IOException {
+    byte[] java16 = Files.readAllBytes(CLASSES.resolve("java16/ext/Direction.class"));
+    byte[] java17 = Files.readAllBytes(CLASSES.resolve("java17preview/ext/Direction.class"));
+    StructContext context = context(DuplicateClassStrategy.FIRST, new RecordingLogger());
+    LazySource lazy = new LazySource("lazy", "ext/Direction", java16);
+    context.addSpace(lazy, false);
+    context.addSpace(source("eager", Map.of("ext/Direction", java17)), false);
+
+    assertTrue(context.hasClass("ext/Direction"));
+    assertEquals(60, context.getClass("ext/Direction").getVersion().major);
+    assertEquals(1, lazy.probes);
+  }
+
+  @Test
+  public void duplicateRootAnchorsItsFamily() throws IOException {
+    String root = "pkg/TestSwitchPatternMatching12";
+    String member = root + "$1";
+    byte[] rootBytes = Files.readAllBytes(CLASSES.resolve("java17preview/" + root + ".class"));
+    byte[] memberBytes = Files.readAllBytes(CLASSES.resolve("java17preview/" + member + ".class"));
+    StructContext context = context(DuplicateClassStrategy.FIRST, new RecordingLogger());
+    context.addSpace(source("first", Map.of(root, rootBytes)), true);
+    context.addSpace(source("second", Map.of(root, rootBytes, member, memberBytes)), true);
+
+    assertNotNull(context.getClass(root));
+    IllegalStateException exception = assertThrows(IllegalStateException.class, () -> context.getClass(member));
+    assertTrue(exception.getMessage().contains("family root " + root));
+    assertTrue(exception.getMessage().contains("member " + member));
+    assertTrue(exception.getMessage().contains("anchored origin first [origin 1]"));
+    assertTrue(exception.getMessage().contains("second [origin 2]"));
+  }
+
+  @Test
+  public void metadataAloneDoesNotCombineOrigins() throws IOException {
+    String root = "pkg/TestSwitchPatternMatching12";
+    String member = root + "$1";
+    byte[] rootBytes = Files.readAllBytes(CLASSES.resolve("java17preview/" + root + ".class"));
+    byte[] memberBytes = Files.readAllBytes(CLASSES.resolve("java17preview/" + member + ".class"));
+    StructContext context = context(DuplicateClassStrategy.FIRST, new RecordingLogger());
+    context.addSpace(source("first", Map.of(root, rootBytes)), true);
+    context.addSpace(source("second", Map.of(member, memberBytes)), true);
+
+    assertNotNull(context.getClass(root));
+    assertNotNull(context.getClass(member));
+  }
+
+  @Test
+  public void rootlessFamilyAnchorsOnStrategySelectedDuplicate() throws IOException {
+    String root = "pkg/TestSwitchPatternMatching19";
+    String duplicate = root + "$B";
+    String member = root + "$D";
+    byte[] duplicateBytes = Files.readAllBytes(CLASSES.resolve("java17preview/" + duplicate + ".class"));
+    byte[] memberBytes = Files.readAllBytes(CLASSES.resolve("java17preview/" + member + ".class"));
+    StructContext context = context(DuplicateClassStrategy.LAST, new RecordingLogger());
+    context.addSpace(source("first", Map.of(duplicate, duplicateBytes, member, memberBytes)), true);
+    context.addSpace(source("second", Map.of(duplicate, duplicateBytes)), true);
+
+    IllegalStateException exception = assertThrows(IllegalStateException.class, () -> context.getClass(member));
+    assertTrue(exception.getMessage().contains("family root " + root));
+    assertTrue(exception.getMessage().contains("anchored origin second [origin 2]"));
+  }
+
+  @Test
+  public void invalidStrategyListsAcceptedValues() {
+    IllegalArgumentException exception = assertThrows(IllegalArgumentException.class, () -> DuplicateClassStrategy.parse("middle"));
+    assertTrue(exception.getMessage().contains("first, last, error"));
+    assertThrows(IllegalArgumentException.class, () -> DuplicateClassStrategy.parse("FIRST"));
+  }
+
+  private static StructContext context(DuplicateClassStrategy strategy, IFernflowerLogger logger) {
+    Init.init();
+    StructContext context = new StructContext(null, null, null, strategy);
+    DecompilerContext.setCurrentContext(new DecompilerContext(
+      new HashMap<>(IFernflowerPreferences.DEFAULTS), logger, context, new ClassesProcessor(context), null
+    ));
+    return context;
+  }
+
+  private static IContextSource source(String name, Map<String, byte[]> classes) {
+    Map<String, byte[]> ordered = new LinkedHashMap<>(classes);
+    return new IContextSource() {
+      @Override
+      public String getName() {
+        return name;
+      }
+
+      @Override
+      public Entries getEntries() {
+        return new Entries(ordered.keySet().stream().map(Entry::atBase).toList(), List.of(), List.of());
+      }
+
+      @Override
+      public InputStream getInputStream(String resource) {
+        String className = resource.endsWith(CLASS_SUFFIX) ? resource.substring(0, resource.length() - CLASS_SUFFIX.length()) : resource;
+        byte[] bytes = ordered.get(className);
+        return bytes == null ? null : new ByteArrayInputStream(bytes);
+      }
+    };
+  }
+
+  private static final class LazySource implements IContextSource {
+    private final String name;
+    private final String className;
+    private final byte[] bytes;
+    private int probes;
+
+    private LazySource(String name, String className, byte[] bytes) {
+      this.name = name;
+      this.className = className;
+      this.bytes = bytes;
+    }
+
+    @Override
+    public String getName() {
+      return this.name;
+    }
+
+    @Override
+    public Entries getEntries() {
+      return Entries.EMPTY;
+    }
+
+    @Override
+    public boolean isLazy() {
+      return true;
+    }
+
+    @Override
+    public byte[] getClassBytes(String className) {
+      this.probes++;
+      return this.className.equals(className) ? this.bytes : null;
+    }
+
+    @Override
+    public InputStream getInputStream(String resource) {
+      return null;
+    }
+  }
+
+  private static final class RecordingLogger extends IFernflowerLogger {
+    private final List<String> messages = new ArrayList<>();
+
+    @Override
+    public void writeMessage(String message, Severity severity) {
+      this.messages.add(message);
+    }
+
+    @Override
+    public void writeMessage(String message, Severity severity, Throwable throwable) {
+      this.messages.add(message);
+    }
+  }
+}
