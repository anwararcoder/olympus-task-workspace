+  private ClassCandidate resolveFamilyAnchor(ClassFamily family) {
+    if (family.anchor != null) {
+      return family.anchor;
+    }
+
+    List<ClassCandidate> rootCandidates = loadableCandidates(family.root, ownCandidates(family.root));
+    String anchorName = family.root;
+    if (rootCandidates.isEmpty()) {
+      anchorName = family.anchorDuplicate;
+      rootCandidates = loadableCandidates(anchorName, ownCandidates(anchorName));
+    }
+
+    if (rootCandidates.isEmpty()) {
+      throw new IllegalStateException("No readable origin is available to anchor class family " + family.root);
+    }
+
+    ClassCandidate anchor = selectByStrategy(anchorName, rootCandidates, family.root);
+    family.anchor = anchor;
+    this.selections.put(anchorName, anchor);
+    return anchor;
+  }
