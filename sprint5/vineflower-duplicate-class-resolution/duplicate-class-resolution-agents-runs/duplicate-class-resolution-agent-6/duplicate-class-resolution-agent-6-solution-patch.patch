+      return;
+    }
+
+    Map<String, String> parents = new LinkedHashMap<>();
+    Map<String, LinkedHashSet<String>> links = new LinkedHashMap<>();
+    for (Map.Entry<String, LinkedHashMap<ContextUnit, ClassCandidate>> entry : this.candidates.entrySet()) {
+      for (ClassCandidate candidate : entry.getValue().values()) {
+        if (!candidate.unit.isOwn()) {
+          continue;
+        }
+        StructClass clazz = candidate.getStructClass();
+        if (clazz == null) {
+          continue;
+        }
+
+        links.computeIfAbsent(clazz.qualifiedName, ignored -> new LinkedHashSet<>());
+        StructInnerClassesAttribute innerClasses = clazz.getAttribute(StructGeneralAttribute.ATTRIBUTE_INNER_CLASSES);
+        if (innerClasses != null) {
+          for (StructInnerClassesAttribute.Entry inner : innerClasses.getEntries()) {
+            if (inner.enclosingName != null) {
+              addFamilyLink(inner.innerName, inner.enclosingName, parents, links);
+            }
+          }
+        }
+
+        StructEnclosingMethodAttribute enclosingMethod = clazz.getAttribute(StructGeneralAttribute.ATTRIBUTE_ENCLOSING_METHOD);
+        if (enclosingMethod != null) {
+          addFamilyLink(clazz.qualifiedName, enclosingMethod.getClassName(), parents, links);
+        }
+      }
+    }
+
+    Set<String> indexed = new HashSet<>();
+    for (String duplicateName : duplicateNames) {
+      if (indexed.contains(duplicateName)) {
+        continue;
+      }
+
+      LinkedHashSet<String> members = collectFamilyMembers(duplicateName, links);
+      String root = findFamilyRoot(duplicateName, members, parents);
+      String anchorDuplicate = duplicateNames.stream().filter(members::contains).findFirst().orElse(duplicateName);
+      ClassFamily family = new ClassFamily(root, anchorDuplicate);
+      for (String member : members) {
+        this.families.put(member, family);
+      }
+      indexed.addAll(members);
+    }
+  }
+
+  private static void addFamilyLink(
+    String member,
+    String enclosing,
+    Map<String, String> parents,
+    Map<String, LinkedHashSet<String>> links
+  ) {
+    parents.putIfAbsent(member, enclosing);
+    links.computeIfAbsent(member, ignored -> new LinkedHashSet<>()).add(enclosing);
+    links.computeIfAbsent(enclosing, ignored -> new LinkedHashSet<>()).add(member);
+  }
+
+  private static LinkedHashSet<String> collectFamilyMembers(String start, Map<String, LinkedHashSet<String>> links) {
+    LinkedHashSet<String> members = new LinkedHashSet<>();
+    ArrayDeque<String> pending = new ArrayDeque<>();
+    pending.add(start);
+    while (!pending.isEmpty()) {
+      String member = pending.removeFirst();
+      if (!members.add(member)) {
+        continue;
+      }
+      pending.addAll(links.getOrDefault(member, new LinkedHashSet<>()));
+    }
+    return members;
+  }
+
+  private static String findFamilyRoot(String fallback, Set<String> members, Map<String, String> parents) {
+    List<String> roots = members.stream()
+      .filter(member -> !members.contains(parents.get(member)))
+      .sorted()
+      .toList();
+    return roots.isEmpty() ? fallback : roots.get(0);
+  }
