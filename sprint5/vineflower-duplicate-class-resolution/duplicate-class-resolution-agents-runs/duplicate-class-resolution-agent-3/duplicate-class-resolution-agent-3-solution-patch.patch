+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+import javax.tools.ToolProvider;
+import java.io.ByteArrayInputStream;
+import java.io.File;
+import java.io.InputStream;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.*;
+import java.util.jar.Manifest;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class DuplicateClassResolutionTest {
+  @TempDir Path tempDir;
+
+  @AfterEach void reset() { DecompilerContext.setCurrentContext(null); }
+
+  @Test void precedenceAndStrategies() throws Exception {
+    byte[] firstBytes = compile("first", "dup.Same", "package dup; public class Same extends java.util.ArrayList<Object> {}").get("dup/Same");
+    byte[] lastBytes = compile("last", "dup.Same", "package dup; public class Same extends java.util.LinkedList<Object> {}").get("dup/Same");
+
+    StructContext first = context("first", new TestLogger());
+    first.addSpace(source("library", lastBytes, false), false);
+    first.addSpace(source("own", firstBytes, false), true);
+    assertEquals("java/util/ArrayList", first.getClass("dup/Same").superClass.getString());
+
+    StructContext last = context("last", new TestLogger());
+    last.addSpace(source("one", firstBytes, false), true);
+    last.addSpace(source("two", lastBytes, false), true);
+    assertEquals("java/util/LinkedList", last.getClass("dup/Same").superClass.getString());
+  }
+
+  @Test void errorUsesBytesAndNamesEveryOrigin() throws Exception {
+    byte[] same = compile("same", "dup.Same", "package dup; public class Same {}").get("dup/Same");
+    byte[] different = compile("different", "dup.Same", "package dup; public class Same { int value; }").get("dup/Same");
+
+    StructContext identical = context("error", new TestLogger());
+    identical.addSpace(source("same", same, false), true);
+    identical.addSpace(source("same", same, false), true);
+    assertNotNull(identical.getClass("dup/Same"));
+
+    StructContext conflict = context("error", new TestLogger());
+    conflict.addSpace(source("one", same, false), true);
+    conflict.addSpace(source("two", different, false), true);
+    var exception = assertThrows(IllegalStateException.class, () -> conflict.getClass("dup/Same"));
+    assertTrue(exception.getMessage().contains("one (origin 1)"));
+    assertTrue(exception.getMessage().contains("two (origin 2)"));
+  }
+
+  @Test void registrationAndLazyProbesAreDeferredAndCached() throws Exception {
+    byte[] bytes = compile("lazy", "dup.Lazy", "package dup; public class Lazy {}").get("dup/Lazy");
+    MemorySource eager = source("eager", bytes, false);
+    StructContext eagerContext = context("first", new TestLogger());
+    eagerContext.addSpace(eager, true);
+    assertEquals(0, eager.reads);
+    assertNotNull(eagerContext.getClass("dup/Lazy"));
+    assertEquals(1, eager.reads);
+
+    MemorySource lazy = source("lazy", bytes, true);
+    StructContext lazyContext = context("first", new TestLogger());
+    lazyContext.addSpace(lazy, false);
+    assertNull(lazyContext.getClass("dup/Missing"));
+    assertNull(lazyContext.getClass("dup/Missing"));
+    assertEquals(1, lazy.byName.get("dup/Missing"));
+    assertNotNull(lazyContext.getClass("dup/Lazy"));
+    assertNotNull(lazyContext.getClass("dup/Lazy"));
+    assertEquals(1, lazy.byName.get("dup/Lazy"));
+  }
+
+  @Test void addingSourcesAndReloadInvalidateAffectedState() throws Exception {
+    byte[] one = compile("invalidate-one", "dup.Same", "package dup; public class Same extends java.util.ArrayList<Object> {}").get("dup/Same");
+    byte[] two = compile("invalidate-two", "dup.Same", "package dup; public class Same extends java.util.LinkedList<Object> {}").get("dup/Same");
+    StructContext context = context("last", new TestLogger());
+    context.addSpace(source("one", one, false), true);
+    assertEquals("java/util/ArrayList", context.getClass("dup/Same").superClass.getString());
+    context.addSpace(source("two", two, false), true);
+    assertEquals("java/util/LinkedList", context.getClass("dup/Same").superClass.getString());
+
+    MemorySource lazy = source("lazy", one, true);
+    StructContext lazyContext = context("first", new TestLogger());
+    lazyContext.addSpace(lazy, false);
+    assertNull(lazyContext.getClass("dup/Missing"));
+    lazyContext.reloadContext();
+    assertNull(lazyContext.getClass("dup/Missing"));
+    assertEquals(2, lazy.byName.get("dup/Missing"));
+  }
+
+  @Test void duplicateFamilyCannotMixOrigins() throws Exception {
+    Map<String, byte[]> complete = compile("family", "dup.Outer", "package dup; public class Outer { public static class Inner {} }");
+    StructContext context = context("first", new TestLogger());
+    context.addSpace(new MemorySource("root-only", Map.of("dup/Outer", complete.get("dup/Outer")), false), true);
+    context.addSpace(new MemorySource("complete", complete, false), true);
+    assertNotNull(context.getClass("dup/Outer"));
+    var exception = assertThrows(IllegalStateException.class, () -> context.getClass("dup/Outer$Inner"));
+    assertTrue(exception.getMessage().contains("Class family dup/Outer"));
+    assertTrue(exception.getMessage().contains("member dup/Outer$Inner"));
+    assertTrue(exception.getMessage().contains("root-only (origin 1)"));
+    assertTrue(exception.getMessage().contains("complete (origin 2)"));
+  }
+
+  @Test void warningAppearsOnceAtSelection() throws Exception {
+    byte[] one = compile("warn-one", "dup.Same", "package dup; public class Same {}").get("dup/Same");
+    byte[] two = compile("warn-two", "dup.Same", "package dup; public class Same { int value; }").get("dup/Same");
+    TestLogger logger = new TestLogger();
+    StructContext context = context("first", logger);
+    context.addSpace(source("one", one, false), true);
+    context.addSpace(source("two", two, false), true);
+    assertTrue(logger.messages.stream().noneMatch(message -> message.startsWith("WARN:")));
+    context.getClass("dup/Same");
+    context.getClass("dup/Same");
+    List<String> warnings = logger.messages.stream().filter(message -> message.startsWith("WARN:")).toList();
+    assertEquals(1, warnings.size());
+    assertTrue(warnings.get(0).contains("strategy first"));
+    assertTrue(warnings.get(0).contains("metadata family root dup/Same"));
+  }
+
+  @Test void invalidStrategyIsRejectedImmediately() {
+    Map<String, Object> options = new HashMap<>();
+    options.put(IFernflowerPreferences.INCLUDE_JAVA_RUNTIME, "0");
+    options.put(IFernflowerPreferences.DUPLICATE_CLASS_STRATEGY, "middle");
+    var exception = assertThrows(IllegalArgumentException.class, () -> new Fernflower(SAVER, options, IFernflowerLogger.NO_OP));
+    assertTrue(exception.getMessage().contains("first, last, error"));
+  }
+
+  private MemorySource source(String name, byte[] bytes, boolean lazy) {
+    return new MemorySource(name, Map.of("dup/Same".replace("Same", name.equals("lazy") || name.equals("eager") ? "Lazy" : "Same"), bytes), lazy);
+  }
+
+  private StructContext context(String strategy, IFernflowerLogger logger) {
+    Init.init();
+    Map<String, Object> properties = new HashMap<>(IFernflowerPreferences.DEFAULTS);
+    properties.put(IFernflowerPreferences.DUPLICATE_CLASS_STRATEGY, strategy);
+    properties.put(IFernflowerPreferences.INCLUDE_JAVA_RUNTIME, "0");
+    IDecompiledData data = new IDecompiledData() {
+      public String getClassEntryName(StructClass cl, String entryname) { return null; }
+      public void processClass(StructClass cl) { }
+      public String getClassContent(StructClass cl) { return null; }
+    };
+    StructContext result = new StructContext(SAVER, data);
+    DecompilerContext.setCurrentContext(new DecompilerContext(properties, logger, result, new ClassesProcessor(result), null));
+    return result;
+  }
+
+  private Map<String, byte[]> compile(String directory, String className, String source) throws Exception {
+    Path root = tempDir.resolve(directory);
+    Path file = root.resolve(className.replace('.', '/') + ".java");
+    Files.createDirectories(file.getParent());
+    Files.writeString(file, source);
+    var compiler = ToolProvider.getSystemJavaCompiler();
+    assertNotNull(compiler);
+    assertEquals(0, compiler.run(null, null, null, "-d", root.toString(), file.toString()));
+    Map<String, byte[]> result = new HashMap<>();
+    try (var paths = Files.walk(root)) {
+      for (Path path : paths.filter(candidate -> candidate.toString().endsWith(".class")).toList()) {
+        String name = root.relativize(path).toString().replace(File.separatorChar, '/');
+        result.put(name.substring(0, name.length() - 6), Files.readAllBytes(path));
+      }
+    }
+    return result;
+  }
+
+  private static final class MemorySource implements IContextSource {
+    final String name; final Map<String, byte[]> classes; final boolean lazy;
+    final Map<String, Integer> byName = new HashMap<>(); int reads;
+    MemorySource(String name, Map<String, byte[]> classes, boolean lazy) { this.name = name; this.classes = classes; this.lazy = lazy; }
+    public String getName() { return name; }
+    public Entries getEntries() { return lazy ? Entries.EMPTY : new Entries(classes.keySet().stream().map(Entry::atBase).toList(), List.of(), List.of()); }
+    public boolean isLazy() { return lazy; }
+    public byte[] getClassBytes(String className) { reads++; byName.merge(className, 1, Integer::sum); return classes.get(className); }
+    public InputStream getInputStream(String resource) {
+      String name = resource.endsWith(CLASS_SUFFIX) ? resource.substring(0, resource.length() - CLASS_SUFFIX.length()) : resource;
+      byte[] bytes = classes.get(name); return bytes == null ? null : new ByteArrayInputStream(bytes);
+    }
+  }
+
+  private static final class TestLogger extends IFernflowerLogger {
+    final List<String> messages = new ArrayList<>();
+    public void writeMessage(String message, Severity severity) { messages.add(severity + ":" + message); }
+    public void writeMessage(String message, Severity severity, Throwable throwable) { writeMessage(message, severity); }
+  }
