+package org.jetbrains.java.decompiler.struct;
+
+import java.util.Locale;
+
+public enum DuplicateClassStrategy {
+  FIRST,
+  LAST,
+  ERROR;
+
+  public static DuplicateClassStrategy parse(Object value) {
+    String name = String.valueOf(value).toUpperCase(Locale.ENGLISH);
+    try {
+      return valueOf(name);
+    } catch (IllegalArgumentException exception) {
+      throw new IllegalArgumentException("Invalid duplicate-class-strategy '" + value + "'; accepted values are: first, last, error", exception);
+    }
+  }
+
+  public String optionValue() {
+    return name().toLowerCase(Locale.ENGLISH);
+  }
+}
