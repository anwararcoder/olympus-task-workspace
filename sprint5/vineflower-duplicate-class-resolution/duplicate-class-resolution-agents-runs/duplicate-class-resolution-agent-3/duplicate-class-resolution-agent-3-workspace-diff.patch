+    private List<String> entryNames;
+
+    private MemorySource(
+      String name,
+      boolean lazy,
+      Map<String, byte[]> classes,
+      List<IContextSource> children,
+      boolean withResource
+    ) {
+      this.name = name;
+      this.lazy = lazy;
+      this.classes = new LinkedHashMap<>(classes);
+      this.children = List.copyOf(children);
+      this.withResource = withResource;
+      this.entryNames = new ArrayList<>(classes.keySet());
+    }
+
+    private void put(String className, byte[] bytes) {
+      this.classes.put(className, bytes);
+      if (!this.entryNames.contains(className)) {
+        this.entryNames = new ArrayList<>(this.entryNames);
+        this.entryNames.add(className);
+      }
+    }
+
+    @Override
+    public String getName() {
+      return this.name;
+    }
+
+    @Override
+    public Entries getEntries() {
+      if (this.lazy) {
+        return Entries.EMPTY;
+      }
+
+      List<Entry> classEntries = this.entryNames.stream().map(Entry::atBase).toList();
+      List<Entry> others = this.withResource
+        ? List.of(Entry.atBase("resource-" + this.name + ".txt"))
+        : List.of();
+      return new Entries(classEntries, List.of(), others, this.children);
+    }
+
+    @Override
+    public boolean isLazy() {
+      return this.lazy;
+    }
+
+    @Override
+    public byte[] getClassBytes(String className) {
+      this.classReads.incrementAndGet();
+      byte[] bytes = this.classes.get(className);
+      return bytes == null ? null : bytes.clone();
+    }
+
+    @Override
+    public InputStream getInputStream(String resource) {
+      String className = resource.endsWith(CLASS_SUFFIX)
+        ? resource.substring(0, resource.length() - CLASS_SUFFIX.length())
+        : resource;
+      byte[] bytes = this.classes.get(className);
+      if (bytes != null) {
+        return new ByteArrayInputStream(bytes);
+      }
+      if (resource.equals("resource-" + this.name + ".txt")) {
+        return new ByteArrayInputStream(this.name.getBytes());
+      }
+      return null;
+    }
+
+    @Override
+    public IOutputSink createOutputSink(IResultSaver saver) {
+      return this.sink;
+    }
+  }
+
+  private static final class RecordingSink implements IContextSource.IOutputSink {
+    private final List<String> classNames = new ArrayList<>();
+    private final List<String> classContents = new ArrayList<>();
+    private final List<String> otherEntries = new ArrayList<>();
+
+    @Override
+    public void begin() {
+    }
+
+    @Override
+    public synchronized void acceptClass(
+      String qualifiedName,
+      String fileName,
+      String content,
+      int[] mapping
+    ) {
+      this.classNames.add(qualifiedName);
+      this.classContents.add(content);
+    }
+
+    @Override
+    public void acceptDirectory(String directory) {
+    }
+
+    @Override
+    public void acceptOther(String path) {
+      this.otherEntries.add(path);
+    }
+
+    @Override
+    public void close() {
+    }
+  }
+
+  private static final class CollectingLogger extends IFernflowerLogger {
+    private final List<Message> messages = new ArrayList<>();
+
+    @Override
+    public synchronized void writeMessage(String message, Severity severity) {
+      this.messages.add(new Message(message, severity));
+    }
+
+    @Override
+    public synchronized void writeMessage(String message, Severity severity, Throwable throwable) {
+      this.messages.add(new Message(message, severity));
+    }
+
+    private synchronized List<String> warnings() {
+      return this.messages.stream()
+        .filter(message -> message.severity() == Severity.WARN)
+        .map(Message::text)
+        .toList();
+    }
+  }
+
+  private record Message(String text, IFernflowerLogger.Severity severity) {
+  }
+
+  private static final class TestFernflower extends Fernflower {
+    private TestFernflower(Map<String, Object> properties, IFernflowerLogger logger) {
+      super(NO_OP_SAVER, properties, logger);
+    }
+
+    @Override
+    public String getClassEntryName(StructClass clazz, String entryName) {
+      return entryName + ".java";
+    }
+
+    @Override
+    public void processClass(StructClass clazz) {
+    }
+
+    @Override
+    public String getClassContent(StructClass clazz) {
+      return clazz.getMethods().stream()
+        .map(method -> method.getName())
+        .sorted()
+        .toList()
+        .toString();
+    }
+  }
+
+  private static final IResultSaver NO_OP_SAVER = new IResultSaver() {
+    @Override
+    public void saveFolder(String path) {
+    }
+
+    @Override
+    public void copyFile(String source, String path, String entryName) {
+    }
+
+    @Override
+    public void saveClassFile(String path, String qualifiedName, String entryName, String content, int[] mapping) {
+    }
+
+    @Override
+    public void createArchive(String path, String archiveName, Manifest manifest) {
+    }
+
+    @Override
+    public void saveDirEntry(String path, String archiveName, String entryName) {
+    }
+
+    @Override
