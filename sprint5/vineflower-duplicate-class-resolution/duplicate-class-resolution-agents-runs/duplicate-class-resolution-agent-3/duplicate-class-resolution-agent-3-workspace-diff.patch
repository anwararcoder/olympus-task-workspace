+  private static void assertMessageContainsInOrder(String message, String... fragments) {
+    int offset = 0;
+    for (String fragment : fragments) {
+      int next = message.indexOf(fragment, offset);
+      assertTrue(next >= offset, "Expected '" + fragment + "' after offset " + offset + " in: " + message);
+      offset = next + fragment.length();
+    }
+  }
