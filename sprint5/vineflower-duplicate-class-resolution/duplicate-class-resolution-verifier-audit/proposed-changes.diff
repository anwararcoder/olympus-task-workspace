+  @Test
+  public void lastKeepsNonduplicateClassesFromLosingOrigin() {
+    String unique = "sample/UniqueInLosingOrigin";
+    MemorySource first = source(
+      "last-losing-origin",
+      classes(
+        DUPLICATE, classBytes(DUPLICATE, "lastLosingDuplicate"),
+        unique, classBytes(unique, "uniqueMustRemain")
+      ),
+      false
+    );
+    MemorySource last = source(
+      "last-selected-origin",
+      classes(DUPLICATE, classBytes(DUPLICATE, "lastSelectedDuplicate")),
+      false
+    );
+    Harness harness = harness("last", 1);
+    harness.context.addSpace(first, true);
+    harness.context.addSpace(last, true);
+
+    assertEquals(2, harness.context.getOwnClasses().size());
+    assertHasMethod(harness.context.getClass(unique), "uniqueMustRemain");
+    harness.context.saveContext();
+
+    assertEquals(List.of(unique), first.sink.classNames);
+    assertEquals(List.of(DUPLICATE), last.sink.classNames);
+  }
