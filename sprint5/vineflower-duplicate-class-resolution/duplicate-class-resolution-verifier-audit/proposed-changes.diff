+  @Test
+  public void invalidOptionWhitespaceIsRejected() {
+    for (String invalid : List.of(" first", "first ", "\tlast", "error\n", "")) {
+      RuntimeException error = assertThrows(
+        RuntimeException.class,
+        () -> new Fernflower(NO_OP_SAVER, Map.of(OPTION, invalid), new CollectingLogger()),
+        "Expected an invalid option to be rejected: [" + invalid + "]"
+      );
+      assertTrue(error.getMessage().contains("first"), error.getMessage());
+      assertTrue(error.getMessage().contains("last"), error.getMessage());
+      assertTrue(error.getMessage().contains("error"), error.getMessage());
+    }
+  }
