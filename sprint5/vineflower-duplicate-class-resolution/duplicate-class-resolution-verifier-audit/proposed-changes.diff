+  @Test
+  public void errorIdenticalDuplicateStillAnchorsFamily() {
+    Map<String, byte[]> family = siblingFamily("errorIdenticalOne", "errorAlternativeTwo");
+    MemorySource anchor = source(
+      "error-identical-anchor",
+      classes("family/Siblings$One", family.get("family/Siblings$One")),
+      false
+    );
+    MemorySource alternative = source(
+      "error-identical-alternative",
+      classes(
+        "family/Siblings$One", family.get("family/Siblings$One"),
+        "family/Siblings$Two", family.get("family/Siblings$Two")
+      ),
+      false
+    );
+    Harness harness = harness("error", 1);
+    harness.context.addSpace(anchor, true);
+    harness.context.addSpace(alternative, true);
+
+    RuntimeException error = assertThrows(RuntimeException.class, harness.context::getOwnClasses);
+    assertTrue(error.getMessage().contains("family/Siblings"), error.getMessage());
+    assertTrue(error.getMessage().contains("family/Siblings$Two"), error.getMessage());
+    assertTrue(error.getMessage().contains("error-identical-anchor"), error.getMessage());
+    assertTrue(error.getMessage().contains("error-identical-alternative"), error.getMessage());
+  }
