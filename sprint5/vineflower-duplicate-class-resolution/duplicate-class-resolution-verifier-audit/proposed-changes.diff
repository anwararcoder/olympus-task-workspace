+  @Test
+  public void errorIdenticalDuplicatesKeepOtherClassesFromEveryOrigin() {
+    String unique = "sample/ErrorUniqueInLosingOrigin";
+    byte[] identical = classBytes(DUPLICATE, "errorIdenticalDuplicate");
+    MemorySource selected = source("error-identical-selected", classes(DUPLICATE, identical), true);
+    MemorySource coalesced = source(
+      "error-identical-coalesced",
+      classes(DUPLICATE, identical.clone(), unique, classBytes(unique, "errorUniqueMustRemain")),
+      true
+    );
+    Harness harness = harness("error", 1);
+    harness.context.addSpace(selected, true);
+    harness.context.addSpace(coalesced, true);
+
+    assertEquals(2, harness.context.getOwnClasses().size());
+    assertHasMethod(harness.context.getClass(unique), "errorUniqueMustRemain");
+    harness.context.saveContext();
+
+    assertEquals(List.of(DUPLICATE), selected.sink.classNames);
+    assertEquals(List.of(unique), coalesced.sink.classNames);
+    assertEquals(List.of("resource-error-identical-selected.txt"), selected.sink.otherEntries);
+    assertEquals(List.of("resource-error-identical-coalesced.txt"), coalesced.sink.otherEntries);
+  }
