+  @Test
+  public void identicalLibraryDuplicatesDoNotWarnForFirstOrLast() {
+    for (String strategy : List.of("first", "last")) {
+      byte[] identical = classBytes(DUPLICATE, "identicalLibrary" + strategy);
+      for (boolean lazy : List.of(false, true)) {
+        Harness harness = harness(strategy, 1);
+        MemorySource first = lazy
+          ? lazySource("identical-library-a-" + strategy, classes(DUPLICATE, identical))
+          : source("identical-library-a-" + strategy, classes(DUPLICATE, identical), false);
+        MemorySource second = lazy
+          ? lazySource("identical-library-b-" + strategy, classes(DUPLICATE, identical.clone()))
+          : source("identical-library-b-" + strategy, classes(DUPLICATE, identical.clone()), false);
+        harness.context.addSpace(first, false);
+        harness.context.addSpace(second, false);
+
+        assertHasMethod(harness.context.getClass(DUPLICATE), "identicalLibrary" + strategy);
+        assertTrue(harness.logger.warnings().isEmpty(), harness.logger.warnings().toString());
+      }
+    }
+  }
