--- /dev/null
+++ b/test.sh
@@ -0,0 +1,62 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+INVOKE_DIR="$PWD"
+cd "$(dirname "$0")"
+
+OUTPUT_PATH=""
+MODE=""
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --output_path)
+      OUTPUT_PATH="$2"
+      shift 2
+      ;;
+    base|new)
+      MODE="$1"
+      shift
+      ;;
+    *)
+      echo "Usage: $0 --output_path <path> {base|new}" >&2
+      exit 2
+      ;;
+  esac
+done
+
+if [[ -z "$OUTPUT_PATH" || -z "$MODE" ]]; then
+  echo "Usage: $0 --output_path <path> {base|new}" >&2
+  exit 2
+fi
+
+case "$OUTPUT_PATH" in
+  /*) ;;
+  *) OUTPUT_PATH="$INVOKE_DIR/$OUTPUT_PATH" ;;
+esac
+
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+
+case "$MODE" in
+  base)
+    GRADLE_TARGET="duplicateClassBaselineTest"
+    RESULT_DIR="build/test-results/duplicateClassBaselineTest"
+    ;;
+  new)
+    GRADLE_TARGET="duplicateClassResolutionTest"
+    RESULT_DIR="build/test-results/duplicateClassResolutionTest"
+    ;;
+esac
+
+set +e
+./gradlew --offline --no-daemon "$GRADLE_TARGET"
+STATUS=$?
+set -e
+
+RESULT_FILE="$(find "$RESULT_DIR" -maxdepth 1 -type f -name '*.xml' -print -quit 2>/dev/null || true)"
+if [[ -z "$RESULT_FILE" ]]; then
+  echo "No JUnit XML was produced by $GRADLE_TARGET" >&2
+  exit 1
+fi
+
+cp "$RESULT_FILE" "$OUTPUT_PATH"
+exit "$STATUS"
