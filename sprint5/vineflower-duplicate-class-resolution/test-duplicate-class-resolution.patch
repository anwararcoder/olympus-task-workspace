+  @Test
+  public void simultaneousLookupsAgreeOnOneWinnerAndResolveOnce() throws Exception {
+    MemorySource first = source("concurrent-first", classes(DUPLICATE, classBytes(DUPLICATE, "concurrentFirst")), false);
+    MemorySource second = source("concurrent-second", classes(DUPLICATE, classBytes(DUPLICATE, "concurrentSecond")), false);
+    Harness harness = harness("last", 1);
+    harness.context.addSpace(first, true);
+    harness.context.addSpace(second, true);
+
+    int workers = 8;
+    CyclicBarrier barrier = new CyclicBarrier(workers);
+    ExecutorService pool = Executors.newFixedThreadPool(workers);
+    List<Future<StructClass>> lookups = new ArrayList<>();
+    try {
+      for (int worker = 0; worker < workers; worker++) {
+        boolean probeFirst = worker % 2 == 0;
+        lookups.add(pool.submit(() -> {
+          setCurrent(harness);
+          barrier.await(30, TimeUnit.SECONDS);
+          if (probeFirst) {
+            assertTrue(harness.context.hasClass(DUPLICATE));
+          }
+          return harness.context.getClass(DUPLICATE);
+        }));
+      }
+
+      for (Future<StructClass> lookup : lookups) {
+        assertHasMethod(lookup.get(30, TimeUnit.SECONDS), "concurrentSecond");
+      }
+    } finally {
+      pool.shutdownNow();
+    }
+
+    List<String> warnings = harness.logger.warnings();
+    assertEquals(1, warnings.size(), warnings.toString());
+    assertTrue(warnings.get(0).contains(DUPLICATE), warnings.get(0));
+  }
