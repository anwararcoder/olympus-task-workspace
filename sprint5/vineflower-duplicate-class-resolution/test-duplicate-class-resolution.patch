+  private static byte[] classBytes(String binaryName, String markerMethod) {
+    return COMPILED_CLASSES.computeIfAbsent(binaryName + "#" + markerMethod, ignored -> {
+      try {
+        String dottedName = binaryName.replace('/', '.');
+        int separator = dottedName.lastIndexOf('.');
+        String packageName = separator < 0 ? "" : dottedName.substring(0, separator);
+        String simpleName = separator < 0 ? dottedName : dottedName.substring(separator + 1);
+        Path compilation = Files.createTempDirectory(compilationRoot, "class-");
+        Path sourceRoot = compilation.resolve("src");
+        Path outputRoot = compilation.resolve("out");
+        Path source = sourceRoot.resolve(binaryName + ".java");
+        Files.createDirectories(source.getParent());
+        Files.createDirectories(outputRoot);
+        Files.writeString(
+          source,
+          (packageName.isEmpty() ? "" : "package " + packageName + ";\n")
+            + "public class " + simpleName + " { public void " + markerMethod + "() {} }\n"
+        );
+
+        JavaCompiler compiler = ToolProvider.getSystemJavaCompiler();
+        assertNotNull(compiler, "Tests require a JDK, not a JRE");
+        int result = compiler.run(
+          null,
+          null,
+          null,
+          "-g:none",
+          "-d",
+          outputRoot.toString(),
+          source.toString()
+        );
+        assertEquals(0, result, "Could not compile " + dottedName);
+        return Files.readAllBytes(outputRoot.resolve(binaryName + ".class"));
+      } catch (IOException ex) {
+        throw new RuntimeException(ex);
+      }
+    });
+  }
