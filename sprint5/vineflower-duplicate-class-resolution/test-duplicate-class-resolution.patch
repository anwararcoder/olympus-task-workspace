+  private static Map<String, byte[]> compileClasses(String binaryName, String sourceText) {
+    try {
+      Path compilation = Files.createTempDirectory(compilationRoot, "family-");
+      Path sourceRoot = compilation.resolve("src");
+      Path outputRoot = compilation.resolve("out");
+      Path source = sourceRoot.resolve(binaryName + ".java");
+      Files.createDirectories(source.getParent());
+      Files.createDirectories(outputRoot);
+      Files.writeString(source, sourceText);
+      JavaCompiler compiler = ToolProvider.getSystemJavaCompiler();
+      assertNotNull(compiler, "Tests require a JDK, not a JRE");
+      assertEquals(
+        0,
+        compiler.run(null, null, null, "-g:none", "-d", outputRoot.toString(), source.toString()),
+        "Could not compile " + binaryName
+      );
+
+      Map<String, byte[]> classes = new LinkedHashMap<>();
+      try (Stream<Path> files = Files.walk(outputRoot)) {
+        for (Path file : files.filter(path -> path.toString().endsWith(".class")).sorted().toList()) {
+          String relative = outputRoot.relativize(file).toString().replace(file.getFileSystem().getSeparator(), "/");
+          classes.put(relative.substring(0, relative.length() - ".class".length()), Files.readAllBytes(file));
+        }
+      }
+      return classes;
+    } catch (IOException ex) {
+      throw new RuntimeException(ex);
+    }
+  }
