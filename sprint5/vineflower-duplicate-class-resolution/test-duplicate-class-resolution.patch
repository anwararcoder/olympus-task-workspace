+  private static final class MemorySource implements IContextSource {
+    private final String name;
+    private final boolean lazy;
+    private final Map<String, byte[]> classes;
+    private final List<IContextSource> children;
+    private final boolean withResource;
+    private final RecordingSink sink = new RecordingSink();
+    private final AtomicInteger classReads = new AtomicInteger();
+    private List<String> entryNames;
+
+    private MemorySource(
+      String name,
+      boolean lazy,
+      Map<String, byte[]> classes,
+      List<IContextSource> children,
+      boolean withResource
+    ) {
+      this.name = name;
+      this.lazy = lazy;
+      this.classes = new LinkedHashMap<>(classes);
+      this.children = List.copyOf(children);
+      this.withResource = withResource;
+      this.entryNames = new ArrayList<>(classes.keySet());
+    }
+
+    private void put(String className, byte[] bytes) {
+      this.classes.put(className, bytes);
+      if (!this.entryNames.contains(className)) {
+        this.entryNames = new ArrayList<>(this.entryNames);
+        this.entryNames.add(className);
+      }
+    }
+
+    @Override
+    public String getName() {
+      return this.name;
+    }
+
+    @Override
+    public Entries getEntries() {
+      if (this.lazy) {
+        return Entries.EMPTY;
+      }
+
+      List<Entry> classEntries = this.entryNames.stream().map(Entry::atBase).toList();
+      List<Entry> others = this.withResource
+        ? List.of(Entry.atBase("resource-" + this.name + ".txt"))
+        : List.of();
+      return new Entries(classEntries, List.of(), others, this.children);
+    }
+
+    @Override
+    public boolean isLazy() {
+      return this.lazy;
+    }
+
+    @Override
+    public byte[] getClassBytes(String className) {
+      this.classReads.incrementAndGet();
+      byte[] bytes = this.classes.get(className);
+      return bytes == null ? null : bytes.clone();
+    }
+
+    @Override
+    public InputStream getInputStream(String resource) {
+      String className = resource.endsWith(CLASS_SUFFIX)
+        ? resource.substring(0, resource.length() - CLASS_SUFFIX.length())
+        : resource;
+      byte[] bytes = this.classes.get(className);
+      if (bytes != null) {
+        return new ByteArrayInputStream(bytes);
+      }
+      if (resource.equals("resource-" + this.name + ".txt")) {
+        return new ByteArrayInputStream(this.name.getBytes());
+      }
+      return null;
+    }
+
+    @Override
+    public IOutputSink createOutputSink(IResultSaver saver) {
+      return this.sink;
+    }
+  }
+
+  private static final class RecordingSink implements IContextSource.IOutputSink {
+    private final List<String> classNames = new ArrayList<>();
+    private final List<String> classContents = new ArrayList<>();
+    private final List<String> otherEntries = new ArrayList<>();
+
+    @Override
+    public void begin() {
+    }
+
+    @Override
+    public synchronized void acceptClass(
+      String qualifiedName,
+      String fileName,
+      String content,
+      int[] mapping
+    ) {
+      this.classNames.add(qualifiedName);
+      this.classContents.add(content);
+    }
+
+    @Override
+    public void acceptDirectory(String directory) {
+    }
+
+    @Override
+    public void acceptOther(String path) {
+      this.otherEntries.add(path);
+    }
+
