@@ -0,0 +1,213 @@
+// Copyright 2000-2026 JetBrains s.r.o. Use of this source code is governed by the Apache 2.0 license that can be found in the LICENSE file.
+package org.jetbrains.java.decompiler.main;
+
+import org.jetbrains.java.decompiler.code.CodeConstants;
+import org.jetbrains.java.decompiler.main.ClassesProcessor.ClassNode;
+import org.jetbrains.java.decompiler.modules.renamer.PoolInterceptor;
+import org.jetbrains.java.decompiler.struct.StructClass;
+import org.jetbrains.java.decompiler.struct.StructField;
+import org.jetbrains.java.decompiler.struct.StructMethod;
+import org.jetbrains.java.decompiler.util.Key;
+import org.jetbrains.java.decompiler.util.TextBuffer;
+import org.jetbrains.java.decompiler.util.token.ClassTextToken;
+import org.jetbrains.java.decompiler.util.token.FieldTextToken;
+import org.jetbrains.java.decompiler.util.token.MethodTextToken;
+import org.jetbrains.java.decompiler.util.token.TextToken;
+
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.IdentityHashMap;
+import java.util.Map;
+import java.util.Set;
+import java.util.function.Function;
+
+/**
+ * Retains otherwise hidden generated declarations which are referenced by the Java that is actually emitted.
+ *
+ * <p>The first rendering uses the ordinary hiding decisions. Its semantic text tokens then identify references
+ * from emitted code without treating comments or literals as code. Retention is monotonic, so subsequent renderings
+ * expose the bodies of newly retained members and repeat until no additional generated declaration is referenced.</p>
+ */
+final class ReferenceAwareSyntheticRetention {
+  private static final Key<State> STATE = Key.of("REFERENCE_AWARE_SYNTHETIC_RETENTION");
+
+  private ReferenceAwareSyntheticRetention() {
+  }
+
+  static TextBuffer writeClass(ClassWriter writer, ClassNode root) {
+    State state = new State();
+    DecompilerContext.setProperty(STATE, state);
+
+    try {
+      while (true) {
+        TextBuffer buffer = new TextBuffer(ClassesProcessor.AVERAGE_CLASS_SIZE);
+        writer.writeClass(root, buffer, 0);
+        if (!state.retainReferencesFrom(buffer)) {
+          return buffer;
+        }
+      }
+    } finally {
+      DecompilerContext.setProperty(STATE, null);
+    }
+  }
+
+  static boolean claimProcessing(ClassNode node) {
+    State state = DecompilerContext.getContextProperty(STATE);
+    return state == null || state.processedNodes.add(node);
+  }
+
+  static void processingFailed(ClassNode node) {
+    State state = DecompilerContext.getContextProperty(STATE);
+    if (state != null) {
+      state.processedNodes.remove(node);
+    }
+  }
+
+  static boolean shouldHideField(StructClass owner, StructField field, boolean otherwiseHidden) {
+    State state = DecompilerContext.getContextProperty(STATE);
+    if (state == null || !field.isSynthetic()) {
+      return otherwiseHidden;
+    }
+
+    return state.shouldHide(MemberKey.field(owner.qualifiedName, field.getName(), field.getDescriptor()), otherwiseHidden);
+  }
+
+  static boolean shouldHideMethod(StructClass owner, StructMethod method, boolean otherwiseHidden) {
+    State state = DecompilerContext.getContextProperty(STATE);
+    if (state == null || !(method.isSynthetic() || method.hasModifier(CodeConstants.ACC_BRIDGE))) {
+      return otherwiseHidden;
+    }
+
+    return state.shouldHide(MemberKey.method(owner.qualifiedName, method.getName(), method.getDescriptor()), otherwiseHidden);
+  }
+
+  static boolean shouldHideMemberClass(ClassNode node, boolean otherwiseHidden) {
+    State state = DecompilerContext.getContextProperty(STATE);
+    boolean synthetic = (node.access & CodeConstants.ACC_SYNTHETIC) != 0 || node.classStruct.isSynthetic();
+    if (state == null || !synthetic) {
+      return otherwiseHidden;
+    }
+
+    return state.shouldHide(MemberKey.memberClass(node.classStruct.qualifiedName), otherwiseHidden);
+  }
+
+  private enum MemberKind {
+    CLASS,
+    FIELD,
+    METHOD
+  }
+
+  private record MemberKey(MemberKind kind, String owner, String name, String descriptor) {
+    private static MemberKey memberClass(String name) {
+      return new MemberKey(MemberKind.CLASS, name, "", "");
+    }
+
+    private static MemberKey field(String owner, String name, String descriptor) {
+      return new MemberKey(MemberKind.FIELD, owner, name, descriptor);
+    }
+
+    private static MemberKey method(String owner, String name, String descriptor) {
+      return new MemberKey(MemberKind.METHOD, owner, name, descriptor);
+    }
+  }
+
+  private static final class State {
+    private final Set<ClassNode> processedNodes = Collections.newSetFromMap(new IdentityHashMap<>());
+    private final Map<MemberKey, MemberKey> candidates = new HashMap<>();
+    private final Set<MemberKey> retained = new HashSet<>();
+
+    private boolean shouldHide(MemberKey member, boolean otherwiseHidden) {
+      if (!otherwiseHidden) {
+        return false;
+      }
+
+      candidates.putIfAbsent(member, member);
+      candidates.putIfAbsent(rename(member), member);
+      return !retained.contains(member);
+    }
+
+    private static MemberKey rename(MemberKey member) {
+      PoolInterceptor interceptor = DecompilerContext.getPoolInterceptor();
+      if (interceptor == null) {
+        return member;
+      }
+
+      if (member.kind == MemberKind.CLASS) {
+        String renamedClass = interceptor.getName(member.owner);
+        return renamedClass == null ? member : MemberKey.memberClass(renamedClass);
+      }
+
+      String renamedMember = interceptor.getName(member.owner + " " + member.name + " " + member.descriptor);
+      if (renamedMember != null) {
+        int firstSeparator = renamedMember.indexOf(' ');
+        int lastSeparator = renamedMember.lastIndexOf(' ');
+        return new MemberKey(member.kind,
+          renamedMember.substring(0, firstSeparator),
+          renamedMember.substring(firstSeparator + 1, lastSeparator),
+          renamedMember.substring(lastSeparator + 1));
+      }
+
+      String renamedOwner = interceptor.getName(member.owner);
+      String renamedDescriptor = transformDescriptor(member.descriptor, interceptor::getName);
+      return new MemberKey(member.kind,
+        renamedOwner == null ? member.owner : renamedOwner,
+        member.name,
+        renamedDescriptor);
+    }
+
+    private static String transformDescriptor(String descriptor, Function<String, String> rename) {
+      StringBuilder result = new StringBuilder(descriptor.length());
+      int copiedThrough = 0;
+      int searchFrom = 0;
+      boolean changed = false;
+
+      for (int classStart = descriptor.indexOf('L', searchFrom); classStart >= 0; classStart = descriptor.indexOf('L', searchFrom)) {
+        int classEnd = descriptor.indexOf(';', classStart);
+        if (classEnd < 0) {
+          break;
+        }
+
+        String className = descriptor.substring(classStart + 1, classEnd);
+        String renamedClass = rename.apply(className);
+        result.append(descriptor, copiedThrough, classStart + 1).append(renamedClass == null ? className : renamedClass);
+        copiedThrough = classEnd;
+        searchFrom = classEnd + 1;
+        changed |= renamedClass != null;
+      }
+
+      if (!changed) {
+        return descriptor;
+      }
+
+      result.append(descriptor, copiedThrough, descriptor.length());
+      return result.toString();
+    }
+
+    private boolean retainReferencesFrom(TextBuffer buffer) {
+      boolean changed = false;
+
+      for (TextToken token : buffer.getTokens()) {
+        if (token.isDeclaration()) {
+          continue;
+        }
+
+        MemberKey referenced = null;
+        if (token instanceof ClassTextToken classToken) {
+          referenced = MemberKey.memberClass(classToken.qualifiedName);
+        } else if (token instanceof FieldTextToken fieldToken) {
+          referenced = MemberKey.field(fieldToken.className, fieldToken.name, fieldToken.descriptor.descriptorString);
+        } else if (token instanceof MethodTextToken methodToken) {
+          referenced = MemberKey.method(methodToken.className, methodToken.name, methodToken.descriptor.toString());
+        }
+
+        MemberKey candidate = referenced == null ? null : candidates.get(referenced);
+        if (candidate != null) {
+          changed |= retained.add(candidate);
+        }
+      }
+
+      return changed;
+    }
+  }
+}
