@@ -0,0 +1,220 @@
+package org.jetbrains.java.decompiler.main;
+
+import org.jetbrains.java.decompiler.main.ClassesProcessor.ClassNode;
+import org.jetbrains.java.decompiler.util.TextBuffer;
+import org.jetbrains.java.decompiler.util.token.ClassTextToken;
+import org.jetbrains.java.decompiler.util.token.FieldTextToken;
+import org.jetbrains.java.decompiler.util.token.MethodTextToken;
+import org.jetbrains.java.decompiler.util.token.SyntheticRetentionMarkerTextToken;
+import org.jetbrains.java.decompiler.util.token.TextToken;
+
+import java.util.ArrayDeque;
+import java.util.BitSet;
+import java.util.Deque;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.LinkedHashSet;
+import java.util.Map;
+import java.util.Set;
+
+final class ReferenceAwareSyntheticRetention {
+  record Member(SyntheticRetentionMarkerTextToken.Kind kind, String className, String name, String descriptor) {
+    static Member classMember(String className) {
+      return new Member(SyntheticRetentionMarkerTextToken.Kind.CLASS, className, "", "");
+    }
+
+    static Member field(String className, String name, String descriptor) {
+      return new Member(SyntheticRetentionMarkerTextToken.Kind.FIELD, className, name, descriptor);
+    }
+
+    static Member method(String className, String name, String descriptor) {
+      return new Member(SyntheticRetentionMarkerTextToken.Kind.METHOD, className, name, descriptor);
+    }
+  }
+
+  private record Range(int start, int end) {
+    boolean contains(int position) {
+      return start <= position && position < end;
+    }
+
+    int length() {
+      return end - start;
+    }
+  }
+
+  private boolean analyzing = true;
+  private final Set<Member> candidates = new LinkedHashSet<>();
+  private final Set<Member> retained = new HashSet<>();
+  private final Set<ClassNode> processedClasses = new HashSet<>();
+
+  boolean isAnalyzing() {
+    return analyzing;
+  }
+
+  void markStart(TextBuffer buffer, Member member) {
+    buffer.addSyntheticRetentionMarker(member.kind(), member.className(), member.name(), member.descriptor(), true);
+  }
+
+  void markEnd(TextBuffer buffer, Member member) {
+    buffer.addSyntheticRetentionMarker(member.kind(), member.className(), member.name(), member.descriptor(), false);
+    candidates.add(member);
+  }
+
+  boolean shouldWrite(Member member) {
+    return analyzing || retained.contains(member);
+  }
+
+  void recordProcessing(ClassNode node, boolean successful) {
+    if (successful) {
+      processedClasses.add(node);
+    }
+  }
+
+  boolean wasProcessed(ClassNode node) {
+    return processedClasses.contains(node);
+  }
+
+  void resolve(TextBuffer buffer) {
+    Map<Member, Integer> starts = new HashMap<>();
+    Map<Member, Range> ranges = new HashMap<>();
+
+    for (TextToken token : buffer.getTokens()) {
+      if (token instanceof SyntheticRetentionMarkerTextToken marker) {
+        Member member = new Member(marker.kind, marker.className, marker.name, marker.descriptor);
+        if (marker.startMarker) {
+          starts.put(member, marker.getStart());
+        }
+        else {
+          Integer start = starts.get(member);
+          if (start != null && start < marker.getStart()) {
+            ranges.put(member, new Range(start, marker.getStart()));
+          }
+        }
+      }
+    }
+
+    Map<Member, Set<Member>> references = new HashMap<>();
+    Set<Member> roots = new LinkedHashSet<>();
+    BitSet code = findCode(buffer.getRawText());
+
+    for (TextToken token : buffer.getTokens()) {
+      if (token.isDeclaration() || token.getStart() >= code.length() || !code.get(token.getStart())) {
+        continue;
+      }
+
+      Member target = referencedMember(token);
+      if (target == null || !candidates.contains(target) || !ranges.containsKey(target)) {
+        continue;
+      }
+
+      Member source = containingCandidate(token.getStart(), ranges);
+      if (source == null) {
+        roots.add(target);
+      }
+      else {
+        references.computeIfAbsent(source, ignored -> new LinkedHashSet<>()).add(target);
+      }
+    }
+
+    Deque<Member> work = new ArrayDeque<>(roots);
+    while (!work.isEmpty()) {
+      Member member = work.removeFirst();
+      if (!retained.add(member)) {
+        continue;
+      }
+      work.addAll(references.getOrDefault(member, Set.of()));
+    }
+
+    analyzing = false;
+  }
+
+  private static Member referencedMember(TextToken token) {
+    if (token instanceof ClassTextToken classToken) {
+      return Member.classMember(classToken.qualifiedName);
+    }
+    if (token instanceof FieldTextToken fieldToken) {
+      return Member.field(fieldToken.className, fieldToken.name, fieldToken.descriptor.descriptorString);
+    }
+    if (token instanceof MethodTextToken methodToken) {
+      return Member.method(methodToken.className, methodToken.name, methodToken.descriptor.toString());
+    }
+    return null;
+  }
+
+  private static Member containingCandidate(int position, Map<Member, Range> ranges) {
+    Member result = null;
+    int resultLength = Integer.MAX_VALUE;
+    for (Map.Entry<Member, Range> entry : ranges.entrySet()) {
+      Range range = entry.getValue();
+      if (range.contains(position) && range.length() < resultLength) {
+        result = entry.getKey();
+        resultLength = range.length();
+      }
+    }
+    return result;
+  }
+
+  private static BitSet findCode(String text) {
+    BitSet result = new BitSet(text.length());
+    int index = 0;
+    while (index < text.length()) {
+      char current = text.charAt(index);
+      if (current == '/' && index + 1 < text.length()) {
+        char next = text.charAt(index + 1);
+        if (next == '/') {
+          index += 2;
+          while (index < text.length() && text.charAt(index) != '\n' && text.charAt(index) != '\r') {
+            index++;
+          }
+          continue;
+        }
+        if (next == '*') {
+          index += 2;
+          while (index + 1 < text.length() && !(text.charAt(index) == '*' && text.charAt(index + 1) == '/')) {
+            index++;
+          }
+          index = Math.min(text.length(), index + 2);
+          continue;
+        }
+      }
+      if (current == '"') {
+        if (index + 2 < text.length() && text.charAt(index + 1) == '"' && text.charAt(index + 2) == '"') {
+          index += 3;
+          while (index + 2 < text.length() && !(text.charAt(index) == '"' && text.charAt(index + 1) == '"' && text.charAt(index + 2) == '"')) {
+            index++;
+          }
+          index = Math.min(text.length(), index + 3);
+        }
+        else {
+          index = skipQuoted(text, index + 1, '"');
+        }
+        continue;
+      }
+      if (current == '\'') {
+        index = skipQuoted(text, index + 1, '\'');
+        continue;
+      }
+
+      result.set(index);
+      index++;
+    }
+    return result;
+  }
+
+  private static int skipQuoted(String text, int index, char quote) {
+    boolean escaped = false;
+    while (index < text.length()) {
+      char current = text.charAt(index++);
+      if (current == quote && !escaped) {
+        break;
+      }
+      if (current == '\\') {
+        escaped = !escaped;
+      }
+      else {
+        escaped = false;
+      }
+    }
+    return index;
+  }
+}
