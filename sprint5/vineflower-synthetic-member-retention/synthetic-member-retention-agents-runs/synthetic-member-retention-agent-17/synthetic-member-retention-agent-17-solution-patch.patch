@@ -0,0 +1,37 @@
+package org.jetbrains.java.decompiler.util.token;
+
+import org.jetbrains.java.decompiler.main.extern.TextTokenVisitor;
+
+/** Internal marker used while deciding which otherwise hidden generated members are referenced. */
+public final class SyntheticRetentionMarkerTextToken extends TextToken {
+  public enum Kind {
+    CLASS,
+    FIELD,
+    METHOD
+  }
+
+  public final Kind kind;
+  public final String className;
+  public final String name;
+  public final String descriptor;
+  public final boolean startMarker;
+
+  public SyntheticRetentionMarkerTextToken(int start, Kind kind, String className, String name, String descriptor, boolean startMarker) {
+    super(start, 0, false);
+    this.kind = kind;
+    this.className = className;
+    this.name = name;
+    this.descriptor = descriptor;
+    this.startMarker = startMarker;
+  }
+
+  @Override
+  public SyntheticRetentionMarkerTextToken copy() {
+    return new SyntheticRetentionMarkerTextToken(start, kind, className, name, descriptor, startMarker);
+  }
+
+  @Override
+  public void visit(TextTokenVisitor visitor) {
+    // This token is private writer metadata, not part of the public text-token stream.
+  }
+}
