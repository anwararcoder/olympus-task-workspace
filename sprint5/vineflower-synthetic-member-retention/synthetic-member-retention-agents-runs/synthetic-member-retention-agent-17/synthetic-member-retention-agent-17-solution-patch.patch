@@ -0,0 +1,71 @@
+package org.jetbrains.java.decompiler.main;
+
+import org.jetbrains.java.decompiler.MinimalFernflowerEnvironment;
+import org.jetbrains.java.decompiler.util.TextBuffer;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class ReferenceAwareSyntheticRetentionTest {
+  @BeforeEach
+  void setUp() {
+    MinimalFernflowerEnvironment.setup();
+  }
+
+  @AfterEach
+  void tearDown() {
+    DecompilerContext.setCurrentContext(null);
+  }
+
+  @Test
+  void followsReferencesOnlyFromReachableCode() {
+    ReferenceAwareSyntheticRetention retention = new ReferenceAwareSyntheticRetention();
+    ReferenceAwareSyntheticRetention.Member first = ReferenceAwareSyntheticRetention.Member.method("pkg/Test", "first", "()V");
+    ReferenceAwareSyntheticRetention.Member second = ReferenceAwareSyntheticRetention.Member.method("pkg/Test", "second", "()V");
+    ReferenceAwareSyntheticRetention.Member orphanA = ReferenceAwareSyntheticRetention.Member.method("pkg/Test", "orphanA", "()V");
+    ReferenceAwareSyntheticRetention.Member orphanB = ReferenceAwareSyntheticRetention.Member.method("pkg/Test", "orphanB", "()V");
+    TextBuffer buffer = new TextBuffer();
+
+    appendCandidateCalling(retention, buffer, first, second);
+    appendCandidateCalling(retention, buffer, second, second);
+    appendCandidateCalling(retention, buffer, orphanA, orphanB);
+    appendCandidateCalling(retention, buffer, orphanB, orphanA);
+    buffer.appendMethod("first", false, "pkg/Test", "first", "()V");
+    retention.resolve(buffer);
+
+    assertTrue(retention.shouldWrite(first));
+    assertTrue(retention.shouldWrite(second));
+    assertFalse(retention.shouldWrite(orphanA));
+    assertFalse(retention.shouldWrite(orphanB));
+  }
+
+  @Test
+  void ignoresReferencesInCommentsAndLiterals() {
+    ReferenceAwareSyntheticRetention retention = new ReferenceAwareSyntheticRetention();
+    ReferenceAwareSyntheticRetention.Member hidden = ReferenceAwareSyntheticRetention.Member.method("pkg/Test", "hidden", "()V");
+    TextBuffer buffer = new TextBuffer();
+
+    retention.markStart(buffer, hidden);
+    buffer.append("void hidden() {}");
+    retention.markEnd(buffer, hidden);
+    buffer.append(" /* ").appendMethod("hidden", false, "pkg/Test", "hidden", "()V").append(" */ ");
+    buffer.append('"').appendMethod("hidden", false, "pkg/Test", "hidden", "()V").append('"');
+    retention.resolve(buffer);
+
+    assertFalse(retention.shouldWrite(hidden));
+  }
+
+  private static void appendCandidateCalling(ReferenceAwareSyntheticRetention retention,
+                                             TextBuffer buffer,
+                                             ReferenceAwareSyntheticRetention.Member source,
+                                             ReferenceAwareSyntheticRetention.Member target) {
