+  private final class ReferenceAwareSyntheticRetention {
+    private final Set<MemberKey> potential = new HashSet<>();
+    private final Set<MemberKey> candidates = new HashSet<>();
+    private final Set<MemberKey> retained = new HashSet<>();
+    private final Set<ClassNode> processedNodes = Collections.newSetFromMap(new IdentityHashMap<>());
+    private boolean candidatesDetermined;
+
+    private ReferenceAwareSyntheticRetention(ClassNode root) {
+      collectPotentialMembers(root);
+    }
+
+    private boolean isOmittedCandidate(MemberKey member) {
+      return candidates.contains(member) && !retained.contains(member);
+    }
+
+    private void findOmittedCandidates(TextBuffer buffer) {
+      if (candidatesDetermined) {
+        return;
+      }
+
+      Set<MemberKey> declared = new HashSet<>();
+      for (TextToken token : buffer.getTokens()) {
+        if (token.isDeclaration()) {
+          MemberKey member = memberFromToken(token);
+          if (member != null) {
+            declared.add(member);
+          }
+        }
+      }
+
+      candidates.addAll(potential);
+      candidates.removeAll(declared);
+      candidatesDetermined = true;
+    }
+
+    private void collectPotentialMembers(ClassNode node) {
+      // Lambda nodes reuse their enclosing class's StructClass and wrapper. They are
+      // representation nodes, not declarations in their own right.
+      if (node.type != ClassNode.Type.LAMBDA) {
+        for (StructField field : node.classStruct.getFields()) {
+          if (field.isSynthetic()) {
+            potential.add(MemberKey.field(node.classStruct.qualifiedName, field.getName(), field.getDescriptor()));
+          }
+        }
+
+        for (StructMethod method : node.classStruct.getMethods()) {
+          if (method.isSynthetic() || method.hasModifier(CodeConstants.ACC_BRIDGE)) {
+            potential.add(MemberKey.method(node.classStruct.qualifiedName, method.getName(), method.getDescriptor()));
+          }
+        }
+
+        for (ClassNode inner : node.nested) {
+          if (inner.type == ClassNode.Type.MEMBER &&
+            ((inner.access & CodeConstants.ACC_SYNTHETIC) != 0 || inner.classStruct.isSynthetic())) {
+            potential.add(MemberKey.clazz(inner.classStruct.qualifiedName));
+          }
+        }
+      }
+
+      for (ClassNode inner : node.nested) {
+        collectPotentialMembers(inner);
+      }
+    }
+  }
+
+  private record MemberKey(Kind kind, String className, String name, String descriptor) {
+    private enum Kind { FIELD, METHOD, CLASS }
+
+    private static MemberKey field(String className, String name, String descriptor) {
+      return new MemberKey(Kind.FIELD, className, name, descriptor);
+    }
+
+    private static MemberKey method(String className, String name, String descriptor) {
+      return new MemberKey(Kind.METHOD, className, name, descriptor);
+    }
+
+    private static MemberKey clazz(String className) {
+      return new MemberKey(Kind.CLASS, className, null, null);
+    }
+  }
 }
