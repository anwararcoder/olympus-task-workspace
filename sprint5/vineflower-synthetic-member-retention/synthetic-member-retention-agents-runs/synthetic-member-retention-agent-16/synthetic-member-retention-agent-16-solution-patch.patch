+      if (className == null || !visited.add(className)) {
+        return null;
+      }
+
+      StructClass clazz = DecompilerContext.getStructContext().getClass(className);
+      if (clazz == null) {
+        return null;
+      }
+
+      boolean declared = referenced.kind == MemberKind.FIELD
+        ? clazz.getField(referenced.name, referenced.descriptor) != null
+        : clazz.getMethod(referenced.name, referenced.descriptor) != null;
+      if (declared) {
+        return new MemberKey(referenced.kind, clazz.qualifiedName, referenced.name, referenced.descriptor);
+      }
+
+      if (referenced.kind == MemberKind.FIELD) {
+        for (String interfaceName : clazz.getInterfaceNames()) {
+          MemberKey declaration = findDeclaration(referenced, interfaceName, visited);
+          if (declaration != null) {
+            return declaration;
+          }
+        }
