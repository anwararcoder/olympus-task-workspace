+    void preparePass(ClassNode root) {
+      resetAnnotationState(root);
+    }
+
+    boolean shouldHide(MemberKey member) {
+      candidates.add(member);
+      return !retained.contains(member);
+    }
+
+    boolean retainReferences(TextBuffer buffer) {
+      boolean changed = false;
+
+      for (TextToken token : buffer.getTokens()) {
+        if (token.isDeclaration()) {
+          continue;
+        }
+
+        MemberKey referenced = null;
+        if (token instanceof FieldTextToken field) {
+          referenced = MemberKey.field(field.className, field.name, field.descriptor.descriptorString);
+        }
+        else if (token instanceof MethodTextToken method) {
+          referenced = MemberKey.method(method.className, method.name, method.descriptor.toString());
+        }
+        else if (token instanceof ClassTextToken clazz) {
+          referenced = MemberKey.memberClass(clazz.qualifiedName);
+        }
+
+        if (referenced != null) {
+          MemberKey candidate = findCandidate(referenced);
+          if (candidate != null) {
+            changed |= retained.add(candidate);
+          }
+        }
+      }
+
+      return changed;
+    }
+
+    private MemberKey findCandidate(MemberKey referenced) {
+      if (candidates.contains(referenced)) {
+        return referenced;
+      }
+      if (referenced.kind == MemberKind.MEMBER_CLASS) {
+        return null;
+      }
+
+      MemberKey declaration = findDeclaration(referenced, referenced.owner, new HashSet<>());
+      return candidates.contains(declaration) ? declaration : null;
+    }
+
