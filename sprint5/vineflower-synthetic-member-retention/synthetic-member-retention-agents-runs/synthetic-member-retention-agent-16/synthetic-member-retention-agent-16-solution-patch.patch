+  static final class ReferenceAwareSyntheticRetention {
+    private final Set<MemberKey> candidates = new HashSet<>();
+    private final Set<MemberKey> retained = new HashSet<>();
+    private final Set<ClassNode> processedClasses = Collections.newSetFromMap(new IdentityHashMap<>());
+
+    boolean markClassProcessed(ClassNode node) {
