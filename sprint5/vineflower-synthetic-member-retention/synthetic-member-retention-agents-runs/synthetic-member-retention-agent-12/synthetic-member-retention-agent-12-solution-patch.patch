+  /**
+   * Text tokens are normally emitted only for Java syntax, but a few diagnostic forms deliberately put a token
+   * inside a comment or a literal. Keep those forms from becoming references for retention purposes.
+   */
+  private static boolean[] codePositions(String text) {
+    boolean[] code = new boolean[text.length()];
+    Arrays.fill(code, true);
+
+    final int normal = 0;
+    final int lineComment = 1;
+    final int blockComment = 2;
+    final int string = 3;
+    final int character = 4;
+    final int textBlock = 5;
+    int state = normal;
+
+    for (int i = 0; i < text.length(); i++) {
+      if (state == normal) {
+        if (text.charAt(i) == '/' && i + 1 < text.length() && text.charAt(i + 1) == '/') {
+          code[i] = false;
+          code[++i] = false;
+          state = lineComment;
+        }
+        else if (text.charAt(i) == '/' && i + 1 < text.length() && text.charAt(i + 1) == '*') {
+          code[i] = false;
+          code[++i] = false;
+          state = blockComment;
+        }
+        else if (text.charAt(i) == '"') {
+          if (i + 2 < text.length() && text.charAt(i + 1) == '"' && text.charAt(i + 2) == '"') {
+            code[i] = false;
+            code[++i] = false;
+            code[++i] = false;
+            state = textBlock;
+          }
+          else {
+            code[i] = false;
+            state = string;
+          }
+        }
+        else if (text.charAt(i) == '\'') {
+          code[i] = false;
+          state = character;
+        }
+      }
+      else if (state == lineComment) {
+        code[i] = false;
+        if (text.charAt(i) == '\n' || text.charAt(i) == '\r') {
+          state = normal;
+        }
+      }
+      else if (state == blockComment) {
+        code[i] = false;
+        if (text.charAt(i) == '*' && i + 1 < text.length() && text.charAt(i + 1) == '/') {
+          code[++i] = false;
+          state = normal;
+        }
+      }
+      else if (state == string || state == character) {
+        code[i] = false;
+        if (text.charAt(i) == '\\' && i + 1 < text.length()) {
+          code[++i] = false;
+        }
+        else if ((state == string && text.charAt(i) == '"') || (state == character && text.charAt(i) == '\'')) {
+          state = normal;
+        }
+      }
+      else {
+        code[i] = false;
+        if (text.charAt(i) == '"' && i + 2 < text.length() && text.charAt(i + 1) == '"' && text.charAt(i + 2) == '"') {
+          code[++i] = false;
+          code[++i] = false;
+          state = normal;
+        }
+        else if (text.charAt(i) == '\\' && i + 1 < text.length()) {
+          code[++i] = false;
+        }
+      }
+    }
+
+    return code;
+  }
