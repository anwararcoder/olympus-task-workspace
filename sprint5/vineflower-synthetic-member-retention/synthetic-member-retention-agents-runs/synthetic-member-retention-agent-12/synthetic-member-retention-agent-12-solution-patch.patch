+  private static void collectGeneratedMembers(ClassNode node, Set<String> candidates, Map<String, String> owners) {
+    if (node.type != ClassNode.Type.LAMBDA) {
+      StructClass cl = node.classStruct;
+
+      if (node.type == ClassNode.Type.MEMBER && isSyntheticClass(node)) {
+        candidates.add(classKey(cl.qualifiedName));
+      }
+
+      for (StructField fd : cl.getFields()) {
+        if (fd.isSynthetic()) {
+          String key = fieldKey(cl.qualifiedName, fd.getName(), fd.getDescriptor());
+          candidates.add(key);
+          owners.put(key, classKey(cl.qualifiedName));
+        }
+      }
+
+      for (StructMethod mt : cl.getMethods()) {
+        if (mt.isSynthetic() || mt.hasModifier(CodeConstants.ACC_BRIDGE)) {
+          String key = methodKey(cl.qualifiedName, mt.getName(), mt.getDescriptor());
+          candidates.add(key);
+          owners.put(key, classKey(cl.qualifiedName));
+        }
+      }
+    }
+
+    for (ClassNode child : node.nested) {
+      collectGeneratedMembers(child, candidates, owners);
+    }
+  }
