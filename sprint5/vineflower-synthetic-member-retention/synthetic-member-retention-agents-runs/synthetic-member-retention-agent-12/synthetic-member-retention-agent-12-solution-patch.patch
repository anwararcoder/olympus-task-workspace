+  private static Set<String> findReferencedGeneratedMembers(TextBuffer buffer, Set<String> candidates, Map<String, String> owners) {
+    String content = buffer.convertToStringAndAllowDataDiscard();
+    boolean[] code = codePositions(content);
+    Set<String> referenced = new HashSet<>();
+
+    for (TextToken token : buffer.getTokens()) {
+      if (token.isDeclaration() || !isCode(token, code)) {
+        continue;
+      }
+
+      String key = null;
+      if (token instanceof FieldTextToken field) {
+        key = fieldKey(field.className, field.name, field.descriptor.descriptorString);
+      }
+      else if (token instanceof MethodTextToken method) {
+        key = methodKey(method.className, method.name, method.descriptor.toString());
+      }
+      else if (token instanceof ClassTextToken clazz) {
+        key = classKey(clazz.qualifiedName);
+      }
+
+      if (key != null && candidates.contains(key)) {
+        referenced.add(key);
+        String owner = owners.get(key);
+        if (owner != null && candidates.contains(owner)) {
+          referenced.add(owner);
+        }
+      }
+    }
+
+    return referenced;
+  }
