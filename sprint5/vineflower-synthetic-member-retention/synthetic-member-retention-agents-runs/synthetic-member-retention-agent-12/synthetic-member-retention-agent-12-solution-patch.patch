+  /**
+   * Writes a class while retaining generated declarations that are referenced by the Java emitted for the
+   * complete source file. The first pass deliberately uses the normal omission rules. Subsequent passes only
+   * add declarations, so code in an omitted generated member cannot make another member reachable.
+   */
+  public void writeClassWithReferenceAwareRetention(ClassNode node, TextBuffer buffer, int indent) {
+    ReferenceAwareRetentionState state = new ReferenceAwareRetentionState();
+    collectGeneratedMembers(node, state.candidateMembers, state.candidateOwners);
+    DecompilerContext.setProperty(REFERENCE_AWARE_RETENTION_STATE, state);
+
+    try {
+      TextBuffer lastPass = null;
+
+      while (true) {
+        TextBuffer pass = new TextBuffer(ClassesProcessor.AVERAGE_CLASS_SIZE);
+        writeClass(node, pass, indent);
+        state.renderPass++;
+
+        lastPass = pass;
+        Set<String> newlyReferenced = findReferencedGeneratedMembers(pass, state.candidateMembers, state.candidateOwners);
+        boolean changed = state.retainedMembers.addAll(newlyReferenced);
+
+        if (!changed) {
+          break;
+        }
+
+      }
+
+      // The regular class-writing pipeline reformats this buffer once after the writer returns.
+      buffer.append(lastPass);
+    }
+    finally {
+      DecompilerContext.setProperty(REFERENCE_AWARE_RETENTION_STATE, null);
+    }
+  }
