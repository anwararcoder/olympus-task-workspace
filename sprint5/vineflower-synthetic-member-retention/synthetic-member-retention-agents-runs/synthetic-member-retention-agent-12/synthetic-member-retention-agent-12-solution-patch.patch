+  private static boolean isCode(TextToken token, boolean[] code) {
+    int start = Math.max(0, token.getStart());
+    int end = Math.min(code.length, start + token.getLength());
+    if (start >= end) {
+      return false;
+    }
+
+    for (int i = start; i < end; i++) {
+      if (!code[i]) {
+        return false;
+      }
+    }
+    return true;
+  }
