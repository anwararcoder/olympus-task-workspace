--- /dev/null
+++ b/src/org/jetbrains/java/decompiler/main/ReferenceAwareSyntheticRetention.java
@@ -0,0 +1,365 @@
+// Copyright 2000-2026 the Vineflower contributors
+package org.jetbrains.java.decompiler.main;
+
+import org.jetbrains.java.decompiler.code.CodeConstants;
+import org.jetbrains.java.decompiler.main.ClassesProcessor.ClassNode;
+import org.jetbrains.java.decompiler.main.collectors.ImportCollector;
+import org.jetbrains.java.decompiler.main.extern.IFernflowerPreferences;
+import org.jetbrains.java.decompiler.struct.StructField;
+import org.jetbrains.java.decompiler.struct.StructMethod;
+import org.jetbrains.java.decompiler.util.TextBuffer;
+import org.jetbrains.java.decompiler.util.token.ClassTextToken;
+import org.jetbrains.java.decompiler.util.token.FieldTextToken;
+import org.jetbrains.java.decompiler.util.token.MethodTextToken;
+import org.jetbrains.java.decompiler.util.token.TextToken;
+
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Deque;
+import java.util.IdentityHashMap;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * Finds the generated declarations which are still needed by the Java emitted for one class file.
+ *
+ * <p>The analysis deliberately works on the TextBuffer tokens rather than on rendered text. This
+ * makes comments and literal contents non-references and preserves the exact member descriptor
+ * used by the writer.</p>
+ */
+public final class ReferenceAwareSyntheticRetention {
+  private final ClassNode root;
+
+  private final IdentityHashMap<ClassNode, Candidate> classCandidates = new IdentityHashMap<>();
+  private final Map<String, Candidate> classCandidatesByName = new LinkedHashMap<>();
+  private final Map<String, Candidate> fieldCandidates = new LinkedHashMap<>();
+  private final Map<String, Candidate> methodCandidates = new LinkedHashMap<>();
+  private final List<Candidate> candidates = new ArrayList<>();
+
+  private final Set<Candidate> emittedCandidates = new LinkedHashSet<>();
+  private final Set<Candidate> rootReferences = new LinkedHashSet<>();
+  private final Map<Candidate, Set<Candidate>> references = new LinkedHashMap<>();
+  private final Set<Candidate> retained = new LinkedHashSet<>();
+  private final Set<ClassNode> processed = Collections.newSetFromMap(new IdentityHashMap<>());
+
+  private Candidate currentOwner;
+  private boolean analyzing;
+
+  private ReferenceAwareSyntheticRetention(ClassNode root) {
+    this.root = root;
+    registerNode(root, null);
+  }
+
+  static ReferenceAwareSyntheticRetention prepare(ClassWriter writer, ClassNode root) {
+    ReferenceAwareSyntheticRetention retention = new ReferenceAwareSyntheticRetention(root);
+    if (retention.candidates.isEmpty()) {
+      return null;
+    }
+
+    ImportCollector originalImports = DecompilerContext.getImportCollector();
+    DecompilerContext.setProperty(DecompilerContext.REFERENCE_AWARE_SYNTHETIC_RETENTION, retention);
+    retention.analyzing = true;
+
+    try {
+      // The first rendering is only an analysis. Keep all names/import decisions isolated from the
+      // final rendering, whose imports must describe only the declarations that survive.
+      if (originalImports != null) {
+        DecompilerContext.setImportCollector(new ImportCollector(originalImports));
+      }
+
+      TextBuffer analysisBuffer = new TextBuffer(ClassesProcessor.AVERAGE_CLASS_SIZE);
+      writer.writeClassInternal(root, analysisBuffer, 0);
+      analysisBuffer.convertToStringAndAllowDataDiscard();
+      retention.finishAnalysis();
+      return retention;
+    }
+    catch (RuntimeException | Error e) {
+      DecompilerContext.setProperty(DecompilerContext.REFERENCE_AWARE_SYNTHETIC_RETENTION, null);
+      throw e;
+    }
+    finally {
+      retention.analyzing = false;
+      if (originalImports != null) {
+        DecompilerContext.setImportCollector(originalImports);
+      }
+    }
+  }
+
+  public static boolean isAnalyzing() {
+    DecompilerContext context = DecompilerContext.getCurrentContext();
+    if (context == null) {
+      return false;
+    }
+
+    ReferenceAwareSyntheticRetention retention =
+      DecompilerContext.getContextProperty(DecompilerContext.REFERENCE_AWARE_SYNTHETIC_RETENTION);
+    return retention != null && retention.analyzing;
+  }
+
+  ClassNode getRoot() {
+    return root;
+  }
+
+  boolean markProcessed(ClassNode node) {
+    return processed.add(node);
+  }
+
+  boolean isAnalyzingPhase() {
+    return analyzing;
+  }
+
+  boolean isCandidate(ClassNode node, StructField field) {
+    return fieldCandidates.containsKey(fieldKey(node.classStruct.qualifiedName, field.getName(), field.getDescriptor()));
+  }
+
+  boolean isCandidate(ClassNode node, StructMethod method) {
+    return methodCandidates.containsKey(methodKey(node.classStruct.qualifiedName, method.getName(), method.getDescriptor()));
+  }
+
+  boolean isCandidate(ClassNode node) {
+    return classCandidates.containsKey(node);
+  }
+
+  boolean shouldWrite(Candidate candidate) {
+    return candidate != null && (analyzing || retained.contains(candidate));
+  }
+
+  boolean shouldWrite(ClassNode node, StructField field) {
+    return shouldWrite(fieldCandidates.get(fieldKey(node.classStruct.qualifiedName, field.getName(), field.getDescriptor())));
+  }
+
+  boolean shouldWrite(ClassNode node, StructMethod method) {
+    return shouldWrite(methodCandidates.get(methodKey(node.classStruct.qualifiedName, method.getName(), method.getDescriptor())));
+  }
+
+  boolean shouldWrite(ClassNode node) {
+    return shouldWrite(classCandidates.get(node));
+  }
+
+  Candidate enterClass(ClassNode node) {
+    Candidate previous = currentOwner;
+    Candidate candidate = classCandidates.get(node);
+    if (candidate != null) {
+      currentOwner = candidate;
+    }
+    return previous;
+  }
+
+  Candidate enterField(ClassNode node, StructField field) {
+    Candidate previous = currentOwner;
+    Candidate candidate = fieldCandidates.get(fieldKey(node.classStruct.qualifiedName, field.getName(), field.getDescriptor()));
+    if (candidate != null) {
+      currentOwner = candidate;
+    }
+    return previous;
+  }
+
+  Candidate enterMethod(ClassNode node, StructMethod method) {
+    Candidate previous = currentOwner;
+    Candidate candidate = methodCandidates.get(methodKey(node.classStruct.qualifiedName, method.getName(), method.getDescriptor()));
+    if (candidate != null) {
+      currentOwner = candidate;
+    }
+    return previous;
+  }
+
+  void exit(Candidate previous) {
+    currentOwner = previous;
+  }
+
+  void record(TextBuffer buffer) {
+    record(buffer, currentOwner);
+  }
+
+  void record(TextBuffer buffer, Candidate owner) {
+    if (!analyzing || buffer.length() == 0) {
+      return;
+    }
+
+    if (owner != null) {
+      emittedCandidates.add(owner);
+    }
+
+    for (TextToken token : buffer.getTokens()) {
+      if (token.isDeclaration()) {
+        continue;
+      }
+
+      if (token instanceof ClassTextToken classToken) {
+        addReference(owner, classCandidatesByName.get(normalizeClassName(classToken.qualifiedName)));
+      }
+      else if (token instanceof FieldTextToken fieldToken) {
+        addReference(owner, classCandidatesByName.get(normalizeClassName(fieldToken.className)));
+        addReference(owner, fieldCandidates.get(fieldKey(fieldToken.className, fieldToken.name, fieldToken.descriptor.descriptorString)));
+      }
+      else if (token instanceof MethodTextToken methodToken) {
+        addReference(owner, classCandidatesByName.get(normalizeClassName(methodToken.className)));
+        addReference(owner, methodCandidates.get(methodKey(methodToken.className, methodToken.name, methodToken.descriptor.toString())));
+      }
+    }
+  }
+
+  private void addReference(Candidate owner, Candidate target) {
+    if (target == null) {
+      return;
+    }
+
+    if (owner == null) {
+      rootReferences.add(target);
+    }
+    else {
+      references.computeIfAbsent(owner, ignored -> new LinkedHashSet<>()).add(target);
+    }
+  }
+
+  private void finishAnalysis() {
+    Deque<Candidate> work = new ArrayDeque<>();
+    for (Candidate target : rootReferences) {
+      retain(target, work);
+    }
+
+    while (!work.isEmpty()) {
+      Candidate source = work.removeFirst();
+      for (Candidate target : references.getOrDefault(source, Collections.emptySet())) {
+        retain(target, work);
+      }
+    }
+  }
+
+  private void retain(Candidate candidate, Deque<Candidate> work) {
+    if (!emittedCandidates.contains(candidate)) {
+      return;
+    }
+
+    if (candidate.parentClass != null) {
+      retain(candidate.parentClass, work);
+    }
+
+    if (retained.add(candidate)) {
+      work.addLast(candidate);
+    }
+  }
+
+  private void registerNode(ClassNode node, Candidate parentClass) {
+    Candidate currentClass = parentClass;
+
+    if (node.type == ClassNode.Type.MEMBER && isSyntheticClassCandidate(node)) {
+      Candidate candidate = new Candidate(Candidate.Kind.CLASS, node.classStruct.qualifiedName, node.classStruct.qualifiedName, null, parentClass);
+      classCandidates.put(node, candidate);
+      classCandidatesByName.put(normalizeClassName(node.classStruct.qualifiedName), candidate);
+      candidates.add(candidate);
+      currentClass = candidate;
+    }
+
+    for (StructField field : node.classStruct.getFields()) {
+      if (isSyntheticField(field, node)) {
+        Candidate candidate = new Candidate(
+          Candidate.Kind.FIELD,
+          node.classStruct.qualifiedName,
+          field.getName(),
+          field.getDescriptor(),
+          currentClass
+        );
+        fieldCandidates.put(fieldKey(node.classStruct.qualifiedName, field.getName(), field.getDescriptor()), candidate);
+        candidates.add(candidate);
+      }
+    }
+
+    for (StructMethod method : node.classStruct.getMethods()) {
+      if (isSyntheticMethod(method, node)) {
+        Candidate candidate = new Candidate(
+          Candidate.Kind.METHOD,
+          node.classStruct.qualifiedName,
+          method.getName(),
+          method.getDescriptor(),
+          currentClass
+        );
+        methodCandidates.put(methodKey(node.classStruct.qualifiedName, method.getName(), method.getDescriptor()), candidate);
+        candidates.add(candidate);
+      }
+    }
+
+    for (ClassNode child : node.nested) {
+      registerNode(child, currentClass);
+    }
+  }
+
+  private static boolean isSyntheticClass(ClassNode node) {
+    return (node.access & CodeConstants.ACC_SYNTHETIC) != 0 || node.classStruct.isSynthetic();
+  }
+
+  private static boolean isSyntheticClassCandidate(ClassNode node) {
+    if (!isSyntheticClass(node)) {
+      return false;
+    }
+
+    if (DecompilerContext.getOption(IFernflowerPreferences.REMOVE_SYNTHETIC)) {
+      return true;
+    }
+
+    return node.getWrapper() != null && node.getWrapper().getHiddenMembers().contains(node.classStruct.qualifiedName);
+  }
+
+  private static boolean isSyntheticField(StructField field, ClassNode node) {
+    if (!field.isSynthetic()) {
+      return false;
+    }
+
+    if (DecompilerContext.getOption(IFernflowerPreferences.REMOVE_SYNTHETIC)) {
+      return true;
+    }
+
+    return node.getWrapper() != null && node.getWrapper().getHiddenMembers()
+      .contains(org.jetbrains.java.decompiler.util.InterpreterUtil.makeUniqueKey(field.getName(), field.getDescriptor()));
+  }
+
+  private static boolean isSyntheticMethod(StructMethod method, ClassNode node) {
+    boolean generated = method.isSynthetic() || method.hasModifier(CodeConstants.ACC_BRIDGE);
+    if (!generated) {
+      return false;
+    }
+
+    boolean removed = method.isSynthetic() && DecompilerContext.getOption(IFernflowerPreferences.REMOVE_SYNTHETIC) ||
+                      method.hasModifier(CodeConstants.ACC_BRIDGE) && DecompilerContext.getOption(IFernflowerPreferences.REMOVE_BRIDGE);
+    if (removed) {
+      return true;
+    }
+
+    return node.getWrapper() != null && node.getWrapper().getHiddenMembers()
+      .contains(org.jetbrains.java.decompiler.util.InterpreterUtil.makeUniqueKey(method.getName(), method.getDescriptor()));
+  }
+
+  private static String fieldKey(String className, String name, String descriptor) {
+    return className + '\0' + name + '\0' + descriptor;
+  }
+
+  private static String methodKey(String className, String name, String descriptor) {
+    return className + '\0' + name + '\0' + descriptor;
+  }
+
+  private static String normalizeClassName(String className) {
+    return className.replace('.', '/');
+  }
+
+  static final class Candidate {
+    enum Kind { CLASS, FIELD, METHOD }
+
+    final Kind kind;
+    final String className;
+    final String name;
+    final String descriptor;
+    final Candidate parentClass;
+
+    Candidate(Kind kind, String className, String name, String descriptor, Candidate parentClass) {
+      this.kind = kind;
+      this.className = className;
+      this.name = name;
+      this.descriptor = descriptor;
+      this.parentClass = parentClass;
+    }
+  }
+}
