+++ b/src/org/jetbrains/java/decompiler/main/ReferenceAwareSyntheticRetention.java
@@ -0,0 +1,193 @@
+// Copyright 2000-2021 JetBrains s.r.o. Use of this source code is governed by the Apache 2.0 license that can be found in the LICENSE file.
+package org.jetbrains.java.decompiler.main;
+
+import org.jetbrains.java.decompiler.api.plugin.StatementWriter;
+import org.jetbrains.java.decompiler.code.CodeConstants;
+import org.jetbrains.java.decompiler.main.ClassesProcessor.ClassNode;
+import org.jetbrains.java.decompiler.main.extern.IFernflowerPreferences;
+import org.jetbrains.java.decompiler.struct.StructClass;
+import org.jetbrains.java.decompiler.struct.StructField;
+import org.jetbrains.java.decompiler.struct.StructMethod;
+import org.jetbrains.java.decompiler.util.Key;
+import org.jetbrains.java.decompiler.util.TextBuffer;
+import org.jetbrains.java.decompiler.util.token.ClassTextToken;
+import org.jetbrains.java.decompiler.util.token.FieldTextToken;
+import org.jetbrains.java.decompiler.util.token.MethodTextToken;
+import org.jetbrains.java.decompiler.util.token.TextToken;
+
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.IdentityHashMap;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * Computes the small amount of synthetic code that is needed by the Java in one output file.
+ *
+ * <p>The writer deliberately remains the source of truth for reconstruction.  Each iteration is
+ * therefore a normal write with only the members retained by the preceding iteration added back.
+ * Text tokens make the reference scan independent of spelling, comments, and literal contents.</p>
+ */
+final class ReferenceAwareSyntheticRetention {
+  private static final Key<ReferenceAwareSyntheticRetention> CONTEXT_KEY =
+    Key.of("REFERENCE_AWARE_SYNTHETIC_RETENTION");
+
+  private final Set<MemberKey> candidates = new HashSet<>();
+  private final Set<MemberKey> retained = new HashSet<>();
+  private final Map<String, String> enclosingClasses = new HashMap<>();
+  private final Set<ClassNode> processedNodes =
+    Collections.newSetFromMap(new IdentityHashMap<>());
+
+  private ReferenceAwareSyntheticRetention(ClassNode root) {
+    collectCandidates(root);
+  }
+
+  static void write(StatementWriter writer, ClassNode root, TextBuffer target) {
+    if (!DecompilerContext.getOption(IFernflowerPreferences.REFERENCE_AWARE_SYNTHETIC_RETENTION)) {
+      writer.writeClass(root, target, 0);
+      return;
+    }
+
+    ReferenceAwareSyntheticRetention previous = DecompilerContext.getContextProperty(CONTEXT_KEY);
+    ReferenceAwareSyntheticRetention retention = new ReferenceAwareSyntheticRetention(root);
+    DecompilerContext.setProperty(CONTEXT_KEY, retention);
+    try {
+      while (true) {
+        TextBuffer output = new TextBuffer(ClassesProcessor.AVERAGE_CLASS_SIZE);
+        writer.writeClass(root, output, 0);
+
+        boolean changed = retention.retainReferencedMembers(output);
+        if (!changed) {
+          target.append(output);
+          return;
+        }
+
+        // Intermediate buffers are deliberately discarded. Mark their debug traces as consumed
+        // so UNIT_TEST_MODE does not report the expected discarded render as a data loss.
+        output.convertToStringAndAllowDataDiscard();
+      }
+    }
+    finally {
+      DecompilerContext.setProperty(CONTEXT_KEY, previous);
+    }
+  }
+
+  static ReferenceAwareSyntheticRetention getCurrent() {
+    return DecompilerContext.getContextProperty(CONTEXT_KEY);
+  }
+
+  boolean invokeProcessors(ClassNode node) {
+    return processedNodes.add(node);
+  }
+
+  boolean retainField(StructClass owner, StructField field) {
+    return retained.contains(MemberKey.field(owner.qualifiedName, field.getName(), field.getDescriptor()));
+  }
+
+  boolean retainMethod(StructClass owner, StructMethod method) {
+    return retained.contains(MemberKey.method(owner.qualifiedName, method.getName(), method.getDescriptor()));
+  }
+
+  boolean retainClass(StructClass clazz) {
+    return retained.contains(MemberKey.clazz(clazz.qualifiedName));
+  }
+
+  private void collectCandidates(ClassNode node) {
+    if (node.type != ClassNode.Type.LAMBDA) {
+      StructClass clazz = node.classStruct;
+
+      for (StructField field : clazz.getFields()) {
+        if (field.isSynthetic()) {
+          candidates.add(MemberKey.field(clazz.qualifiedName, field.getName(), field.getDescriptor()));
+        }
+      }
+
+      for (StructMethod method : clazz.getMethods()) {
+        if (method.isSynthetic() || method.hasModifier(CodeConstants.ACC_BRIDGE)) {
+          candidates.add(MemberKey.method(clazz.qualifiedName, method.getName(), method.getDescriptor()));
+        }
+      }
+
+      if (node.type == ClassNode.Type.MEMBER &&
+          ((node.access & CodeConstants.ACC_SYNTHETIC) != 0 || clazz.isSynthetic())) {
+        candidates.add(MemberKey.clazz(clazz.qualifiedName));
+
+        ClassNode parent = node.parent;
+        while (parent != null && parent.type == ClassNode.Type.LAMBDA) {
+          parent = parent.parent;
+        }
+        if (parent != null) {
+          enclosingClasses.put(clazz.qualifiedName, parent.classStruct.qualifiedName);
+        }
+      }
+    }
+
+    for (ClassNode child : node.nested) {
+      collectCandidates(child);
+    }
+  }
+
+  private boolean retainReferencedMembers(TextBuffer output) {
+    boolean changed = false;
+    for (TextToken token : output.getTokens()) {
+      if (token.isDeclaration()) {
+        continue;
+      }
+
+      MemberKey key = null;
+      if (token instanceof FieldTextToken field) {
+        key = MemberKey.field(field.className, field.name, field.descriptor.descriptorString);
+      }
+      else if (token instanceof MethodTextToken method) {
+        key = MemberKey.method(method.className, method.name, method.descriptor.toString());
+      }
+      else if (token instanceof ClassTextToken clazz) {
+        key = MemberKey.clazz(clazz.qualifiedName);
+      }
+
+      if (key != null && candidates.contains(key)) {
+        changed |= retain(key);
+      }
+    }
+    return changed;
+  }
+
+  private boolean retain(MemberKey key) {
+    boolean changed = retained.add(key);
+    changed |= retainEnclosingClass(key.owner);
+    return changed;
+  }
+
+  private boolean retainEnclosingClass(String name) {
+    String enclosingName = enclosingClasses.get(name);
+    if (enclosingName == null) {
+      return false;
+    }
+
+    MemberKey enclosing = MemberKey.clazz(enclosingName);
+    if (!candidates.contains(enclosing)) {
+      return false;
+    }
+
+    return retain(enclosing);
+  }
+
+  private enum Kind {
+    FIELD, METHOD, CLASS
+  }
+
+  private record MemberKey(Kind kind, String owner, String name, String descriptor) {
+    static MemberKey field(String owner, String name, String descriptor) {
+      return new MemberKey(Kind.FIELD, owner, name, descriptor);
+    }
+
+    static MemberKey method(String owner, String name, String descriptor) {
+      return new MemberKey(Kind.METHOD, owner, name, descriptor);
+    }
+
+    static MemberKey clazz(String name) {
+      return new MemberKey(Kind.CLASS, name, "", "");
+    }
+  }
+}
