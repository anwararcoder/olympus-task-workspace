+package org.jetbrains.java.decompiler;
+
+import org.jetbrains.java.decompiler.main.decompiler.ConsoleDecompiler;
+import org.jetbrains.java.decompiler.main.extern.IFernflowerPreferences;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import javax.tools.ToolProvider;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+public class ReferenceAwareSyntheticRetentionTest {
+  @Test
+  public void retainsExactlyReferencedGeneratedMembers() throws IOException {
+    String source = decompile(true);
+
+    assertTrue(source.contains("int retainedField;"));
+    assertTrue(source.contains("int retainedMethod()"));
+    assertTrue(source.contains("int retainedDependency()"));
+    assertTrue(source.contains("int retainedBridge()"));
+    assertTrue(source.contains("int referencedFromLambdaBody;"));
+    assertTrue(source.contains("TestReferenceAwareSyntheticRetention(int"));
+
+    assertFalse(source.contains("int onlyFromOmittedCode;"));
+    assertFalse(source.contains("int onlyFromLiteral;"));
+    assertFalse(source.contains("int consumedBeforeJavaEmission;"));
+    assertFalse(source.contains("int omittedMethod()"));
+    assertFalse(source.contains("lambda$lambdaBodyReference$0"));
+  }
+
+  @Test
+  public void disabledOutputIsUnchangedAndSeparateContextsAgree() throws IOException {
+    String disabled = decompile(false);
+    assertFalse(disabled.contains("int retainedField;"));
+    assertFalse(disabled.contains("int retainedMethod()"));
+    assertFalse(disabled.contains("int retainedBridge()"));
+
+    assertEquals(decompile(true), decompile(true));
+  }
+
+  @Test
+  public void considersTheWholeOutputFileAndRetainsMemberClassesIndividually() throws IOException {
+    String source = decompileClasses();
+
+    assertTrue(source.contains("int referencedFromMemberClass;"));
+    assertFalse(source.contains("int unreferencedSibling;"));
+    assertTrue(source.contains("class Retained"));
+    assertTrue(source.contains("class Ordinary"));
+    assertFalse(source.contains("class Omitted"));
+  }
+
+  @Test
+  public void recompiledOutputRetainsTheSameMembers(@TempDir Path tempDir) throws IOException {
+    String first = decompile(true);
+    Path sourceFile = tempDir.resolve("TestReferenceAwareSyntheticRetention.java");
+    Path classes = tempDir.resolve("classes");
+    Files.writeString(sourceFile, first);
+    Files.createDirectories(classes);
+
+    int result = ToolProvider.getSystemJavaCompiler().run(null, null, null,
+      "-d", classes.toString(), sourceFile.toString());
+    assertEquals(0, result);
+
+    String second = decompile(classes.resolve("pkg/TestReferenceAwareSyntheticRetention.class"), true);
+    for (String retained : new String[] {
+      "int retainedField;", "int retainedMethod()", "int retainedDependency()", "int retainedBridge()",
+      "int referencedFromLambdaBody;", "TestReferenceAwareSyntheticRetention(int"
+    }) {
+      assertTrue(second.contains(retained), retained);
+    }
+    for (String omitted : new String[] {
+      "int onlyFromOmittedCode;", "int onlyFromLiteral;", "int consumedBeforeJavaEmission;", "int omittedMethod()"
+    }) {
+      assertFalse(second.contains(omitted), omitted);
+    }
+  }
+
+  private static String decompile(boolean referenceAware) throws IOException {
+    Path classFile = new DecompilerTestFixture().getTestDataDir()
+      .resolve("classes/jasm/pkg/TestReferenceAwareSyntheticRetention.class");
+    return decompile(classFile, referenceAware);
+  }
+
+  private static String decompile(Path classFile, boolean referenceAware) throws IOException {
+    DecompilerTestFixture fixture = new DecompilerTestFixture();
+    try {
+      fixture.setUp(IFernflowerPreferences.REFERENCE_AWARE_SYNTHETIC_RETENTION, referenceAware ? "1" : "0");
+      ConsoleDecompiler decompiler = fixture.getDecompiler();
+      decompiler.addSource(classFile.toFile());
+      decompiler.decompileContext();
+      return Files.readString(fixture.getTargetDir().resolve("TestReferenceAwareSyntheticRetention.java"));
+    }
+    finally {
+      fixture.tearDown();
+    }
+  }
+
+  private static String decompileClasses() throws IOException {
+    DecompilerTestFixture fixture = new DecompilerTestFixture();
+    try {
+      fixture.setUp(IFernflowerPreferences.REFERENCE_AWARE_SYNTHETIC_RETENTION, "1");
+      ConsoleDecompiler decompiler = fixture.getDecompiler();
+      Path classes = fixture.getTestDataDir().resolve("classes/jasm/pkg");
+      for (String suffix : new String[] {"", "$Retained", "$Omitted", "$Ordinary"}) {
+        decompiler.addSource(classes.resolve("TestReferenceAwareSyntheticRetentionClasses" + suffix + ".class").toFile());
+      }
+      decompiler.decompileContext();
+      return Files.readString(fixture.getTargetDir().resolve("TestReferenceAwareSyntheticRetentionClasses.java"));
+    }
+    finally {
+      fixture.tearDown();
+    }
+  }
+}
