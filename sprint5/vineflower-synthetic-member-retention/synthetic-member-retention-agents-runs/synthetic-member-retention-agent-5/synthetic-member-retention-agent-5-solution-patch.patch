+  private static final class ReferenceAwareRetention {
+    private final Set<ClassNode> processedNodes = Collections.newSetFromMap(new IdentityHashMap<>());
+    private final Set<MemberKey> candidates = new LinkedHashSet<>();
+    private Set<MemberKey> retained = Collections.emptySet();
+
+    private boolean apply(MemberKey key, boolean hide, boolean generated) {
+      if (hide && generated) {
+        MemberKey originalKey = toOriginalName(key);
+        candidates.add(originalKey);
+        return !retained.contains(originalKey);
+      }
+
+      return hide;
+    }
+
+    private Set<MemberKey> findReferences(TextBuffer buffer) {
+      TextBuffer formatted = new TextBuffer(buffer.length());
+      formatted.append(buffer);
+      formatted.reformat();
+
+      String content = formatted.convertToStringAndAllowDataDiscard();
+      Set<MemberKey> references = new LinkedHashSet<>();
+
+      for (TextToken token : formatted.getTokens()) {
+        if (token.isDeclaration() || !isCodePosition(content, token.getStart())) {
+          continue;
+        }
+
+        MemberKey key = null;
+        if (token instanceof FieldTextToken field) {
+          key = MemberKey.field(field.className, field.name, field.descriptor.descriptorString);
+        } else if (token instanceof MethodTextToken method) {
+          key = MemberKey.method(method.className, method.name, method.descriptor.toString());
+        } else if (token instanceof ClassTextToken clazz) {
+          key = MemberKey.clazz(clazz.qualifiedName);
+        }
+
+        if (key != null) {
+          MemberKey originalKey = toOriginalName(key);
+          if (candidates.contains(originalKey)) {
+            references.add(originalKey);
+          }
+        }
+      }
+
+      return references;
+    }
+
+    private static MemberKey toOriginalName(MemberKey key) {
+      PoolInterceptor interceptor = DecompilerContext.getPoolInterceptor();
+      if (interceptor == null) {
+        return key;
+      }
+
+      if (key.kind == MemberKind.CLASS) {
+        String originalOwner = interceptor.getOldName(key.owner);
+        return originalOwner == null ? key : MemberKey.clazz(originalOwner);
+      }
+
+      String originalMember = interceptor.getOldName(key.owner + " " + key.name + " " + key.descriptor);
+      if (originalMember != null) {
+        int firstSpace = originalMember.indexOf(' ');
+        int secondSpace = originalMember.indexOf(' ', firstSpace + 1);
+        if (firstSpace > 0 && secondSpace > firstSpace) {
+          return new MemberKey(key.kind,
+            originalMember.substring(0, firstSpace),
+            originalMember.substring(firstSpace + 1, secondSpace),
+            originalMember.substring(secondSpace + 1));
+        }
+      }
+
+      String originalOwner = interceptor.getOldName(key.owner);
+      return originalOwner == null ? key : new MemberKey(key.kind, originalOwner, key.name, key.descriptor);
+    }
+  }
+
+  private enum MemberKind {
+    FIELD,
+    METHOD,
+    CLASS
+  }
+
+  private static final class MemberKey {
+    private final MemberKind kind;
+    private final String owner;
+    private final String name;
+    private final String descriptor;
+
+    private MemberKey(MemberKind kind, String owner, String name, String descriptor) {
+      this.kind = kind;
+      this.owner = owner;
+      this.name = name;
+      this.descriptor = descriptor;
+    }
+
+    private static MemberKey field(String owner, String name, String descriptor) {
+      return new MemberKey(MemberKind.FIELD, owner, name, descriptor);
+    }
+
+    private static MemberKey method(String owner, String name, String descriptor) {
+      return new MemberKey(MemberKind.METHOD, owner, name, descriptor);
+    }
+
+    private static MemberKey clazz(String owner) {
+      return new MemberKey(MemberKind.CLASS, owner, null, null);
+    }
+
+    @Override
+    public boolean equals(Object o) {
+      if (this == o) return true;
+      if (!(o instanceof MemberKey)) return false;
+      MemberKey key = (MemberKey)o;
+      return kind == key.kind &&
+        Objects.equals(owner, key.owner) &&
+        Objects.equals(name, key.name) &&
+        Objects.equals(descriptor, key.descriptor);
+    }
+
+    @Override
+    public int hashCode() {
+      return Objects.hash(kind, owner, name, descriptor);
+    }
+  }
+
+  private static boolean isCodePosition(String content, int position) {
+    int state = 0; // 0: code, 1: line comment, 2: block comment, 3: string, 4: char, 5: text block
+
+    for (int i = 0; i < position && i < content.length(); i++) {
+      char c = content.charAt(i);
+      switch (state) {
+        case 0:
+          if (c == '/' && i + 1 < content.length()) {
+            char next = content.charAt(i + 1);
+            if (next == '/') {
+              state = 1;
+              i++;
+            } else if (next == '*') {
+              state = 2;
+              i++;
+            }
+          } else if (c == '"') {
+            if (i + 2 < content.length() && content.charAt(i + 1) == '"' && content.charAt(i + 2) == '"') {
+              state = 5;
+              i += 2;
+            } else {
+              state = 3;
+            }
+          } else if (c == '\'') {
+            state = 4;
+          }
+          break;
+        case 1:
+          if (c == '\n' || c == '\r') {
+            state = 0;
+          }
+          break;
+        case 2:
+          if (c == '*' && i + 1 < content.length() && content.charAt(i + 1) == '/') {
+            state = 0;
+            i++;
+          }
+          break;
+        case 3:
+          if (c == '\\') {
+            i++;
+          } else if (c == '"') {
+            state = 0;
+          }
+          break;
+        case 4:
+          if (c == '\\') {
+            i++;
+          } else if (c == '\'') {
+            state = 0;
+          }
+          break;
+        case 5:
+          if (c == '\\') {
+            i++;
+          } else if (c == '"' && i + 2 < content.length() && content.charAt(i + 1) == '"' && content.charAt(i + 2) == '"') {
+            state = 0;
+            i += 2;
+          }
+          break;
+        default:
+          throw new AssertionError(state);
+      }
+    }
+
+    return state == 0;
+  }
