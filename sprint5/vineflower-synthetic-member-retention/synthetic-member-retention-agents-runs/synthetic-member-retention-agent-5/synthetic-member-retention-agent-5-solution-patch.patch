+package org.jetbrains.java.decompiler;
+
+import org.jetbrains.java.decompiler.main.extern.IFernflowerPreferences;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+import java.io.IOException;
+import java.nio.file.Path;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+public class ReferenceAwareSyntheticRetentionTest {
+  private DecompilerTestFixture fixture;
+
+  @BeforeEach
+  public void setUp() throws IOException {
+    fixture = new DecompilerTestFixture();
+  }
+
+  @AfterEach
+  public void tearDown() {
+    fixture.tearDown();
+  }
+
+  @Test
+  public void retainsSyntheticFieldWhenReconstructionLeavesReferences() throws IOException {
+    fixture.setUp(
+      IFernflowerPreferences.DECOMPILE_ASSERTIONS, "0",
+      IFernflowerPreferences.REFERENCE_AWARE_SYNTHETIC_RETENTION, "1"
+    );
+    decompileAsserts();
+
+    String content = getOutput();
+    assertTrue(content.contains("synthetic field"));
+    assertTrue(content.contains("$assertionsDisabled"));
+  }
+
+  @Test
+  public void keepsSyntheticFieldOmittedWhenReconstructionConsumesReferences() throws IOException {
+    fixture.setUp(IFernflowerPreferences.REFERENCE_AWARE_SYNTHETIC_RETENTION, "1");
+    decompileAsserts();
+
+    assertFalse(getOutput().contains("synthetic field"));
+  }
+
+  private void decompileAsserts() {
+    fixture.getDecompiler().addSource(fixture.getTestDataDir().resolve("classes/java8/pkg/TestAsserts.class").toFile());
+    fixture.getDecompiler().decompileContext();
+  }
+
+  private String getOutput() {
+    Path output = fixture.getTargetDir().resolve("TestAsserts.java");
+    return DecompilerTestFixture.getContent(output);
+  }
+}
