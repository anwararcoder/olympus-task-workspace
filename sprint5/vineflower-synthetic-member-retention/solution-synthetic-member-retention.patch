+// Copyright 2000-2026 JetBrains s.r.o. and Vineflower contributors. Use of this source code is governed by the Apache 2.0 license that can be found in the LICENSE file.
+package org.jetbrains.java.decompiler.main.collectors;
+
+import org.jetbrains.java.decompiler.code.CodeConstants;
+import org.jetbrains.java.decompiler.main.ClassesProcessor.ClassNode;
+import org.jetbrains.java.decompiler.main.DecompilerContext;
+import org.jetbrains.java.decompiler.main.rels.ClassWrapper;
+import org.jetbrains.java.decompiler.struct.StructClass;
+import org.jetbrains.java.decompiler.struct.StructField;
+import org.jetbrains.java.decompiler.struct.StructMethod;
+import org.jetbrains.java.decompiler.util.InterpreterUtil;
+import org.jetbrains.java.decompiler.util.TextBuffer;
+import org.jetbrains.java.decompiler.util.token.ClassTextToken;
+import org.jetbrains.java.decompiler.util.token.FieldTextToken;
+import org.jetbrains.java.decompiler.util.token.MethodTextToken;
+import org.jetbrains.java.decompiler.util.token.TextToken;
+
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Deque;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.IdentityHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * Reconciles generated-member hiding with references in the Java that is
+ * actually written. A pass starts with the smallest declaration set. Each
+ * following pass adds declarations reached by the preceding pass, so code
+ * belonging only to an omitted member cannot keep another member alive.
+ */
+public final class SyntheticMemberRetention {
+  private final Set<Member> candidates = new LinkedHashSet<>();
+  private final Set<Member> retained = new LinkedHashSet<>();
+  private final Set<ClassNode> processedNodes =
+    Collections.newSetFromMap(new IdentityHashMap<>());
+  private final Set<ClassNode> reportedNodes =
+    Collections.newSetFromMap(new IdentityHashMap<>());
+  private final Map<Member, Set<Member>> resolvedReferences = new HashMap<>();
+  private final Map<Subtype, Boolean> subtypeResults = new HashMap<>();
+
+  public boolean shouldProcess(ClassNode node) {
+    return processedNodes.add(node);
+  }
+
+  public boolean shouldReportWrites(ClassNode node) {
+    return reportedNodes.add(node);
+  }
+
+  public boolean hideField(
+    String owner,
+    String name,
+    String descriptor,
+    boolean generated
+  ) {
+    return hide(Member.field(owner, name, descriptor), generated);
+  }
+
+  public boolean hideMethod(
+    String owner,
+    String name,
+    String descriptor,
+    boolean generated
+  ) {
+    return hide(Member.method(owner, name, descriptor), generated);
+  }
+
+  public boolean hideClass(String qualifiedName, boolean generated) {
+    return hide(Member.clazz(qualifiedName), generated);
+  }
+
+  private boolean hide(Member member, boolean generated) {
+    if (!generated) {
+      return false;
+    }
+
+    candidates.add(member);
+    return !retained.contains(member);
+  }
+
+  public boolean retainReferences(TextBuffer output) {
+    boolean changed = false;
+
+    for (TextToken token : output.getTokens()) {
+      if (token.isDeclaration()) {
+        continue;
+      }
+
+      Member reference = reference(token);
+      for (Member candidate : findCandidates(reference)) {
+        if (retained.add(candidate)) {
+          unhide(candidate);
+          changed = true;
+        }
+      }
+    }
+
+    return changed;
+  }
+
+  private static void unhide(Member member) {
+    ClassNode node = DecompilerContext.getClassProcessor()
+      .getMapRootClasses()
+      .get(member.owner);
+    if (node == null) {
+      return;
+    }
+
+    if (member.kind == Kind.CLASS) {
+      if (node.parent != null && node.parent.getWrapper() != null) {
+        node.parent.getWrapper().getHiddenMembers().remove(member.owner);
+      }
+      return;
+    }
+
+    ClassWrapper wrapper = node.getWrapper();
+    if (wrapper != null) {
+      wrapper.getHiddenMembers().remove(
+        InterpreterUtil.makeUniqueKey(member.name, member.descriptor)
+      );
+    }
+  }
+
+  private Set<Member> findCandidates(Member reference) {
+    if (reference == null) {
+      return Set.of();
+    }
+
+    Set<Member> resolved = resolvedReferences.computeIfAbsent(
+      reference,
+      this::resolveDeclarations
+    );
+    if (resolved.isEmpty()) {
+      return Set.of();
+    }
+
+    Set<Member> matches = new LinkedHashSet<>(resolved);
+    matches.retainAll(candidates);
+    return matches;
+  }
+
+  private Set<Member> resolveDeclarations(Member reference) {
+    if (reference.kind == Kind.CLASS) {
+      return Set.of(reference);
+    }
+
+    StructClass owner = DecompilerContext.getStructContext().getClass(reference.owner);
+    if (owner == null) {
+      return Set.of();
+    }
+
+    if (reference.name.equals("<init>") ||
+        reference.name.equals("<clinit>")) {
+      return declares(owner, reference) ? Set.of(reference) : Set.of();
+    }
+
+    return switch (reference.kind) {
+      case FIELD -> findFieldDeclaration(owner, owner, reference, new HashSet<>()).declarations;
+      case METHOD -> findMethodDeclarations(owner, reference);
+      case CLASS -> Set.of();
+    };
+  }
+
+  private FieldLookup findFieldDeclaration(
+    StructClass owner,
+    StructClass referenceOwner,
+    Member reference,
+    Set<String> visited
+  ) {
+    if (!visited.add(owner.qualifiedName)) {
+      return FieldLookup.NOT_FOUND;
+    }
+
+    Member declared = reference.withOwner(owner.qualifiedName);
+    StructField field = owner.getField(declared.name, declared.descriptor);
+    if (field != null &&
+        (owner == referenceOwner ||
+          isInherited(field.getAccessFlags(), owner, referenceOwner, false))) {
+      return new FieldLookup(true, Set.of(declared));
+    }
+
+    for (String interfaceName : owner.getInterfaceNames()) {
+      StructClass intf = DecompilerContext.getStructContext().getClass(interfaceName);
+      if (intf != null) {
+        FieldLookup result = findFieldDeclaration(
+          intf,
+          referenceOwner,
+          reference,
+          visited
+        );
+        if (result.found) {
+          return result;
+        }
+      }
+    }
+
+    StructClass parent = superClass(owner);
+    if (parent != null) {
+      return findFieldDeclaration(
+        parent,
+        referenceOwner,
+        reference,
+        visited
+      );
+    }
+
+    return FieldLookup.NOT_FOUND;
+  }
+
+  private Set<Member> findMethodDeclarations(
+    StructClass owner,
+    Member reference
+  ) {
+    for (StructClass current = owner; current != null; current = superClass(current)) {
+      Member declared = reference.withOwner(current.qualifiedName);
+      StructMethod method = current.getMethod(declared.name, declared.descriptor);
+      if (method != null &&
+          (current == owner ||
+            isInherited(method.getAccessFlags(), current, owner, false))) {
+        return Set.of(declared);
+      }
+    }
+
+    List<Member> interfaceDeclarations = new ArrayList<>();
+    collectInterfaceDeclarations(
+      owner,
+      owner,
+      reference,
+      new HashSet<>(),
+      interfaceDeclarations
+    );
+    if (interfaceDeclarations.isEmpty()) {
+      return Set.of();
+    }
+
+    Set<Member> maximallySpecific = new LinkedHashSet<>(interfaceDeclarations);
+    for (Member possibleParent : interfaceDeclarations) {
+      for (Member possibleChild : interfaceDeclarations) {
+        if (!possibleParent.equals(possibleChild) &&
+            isSubtype(possibleChild.owner, possibleParent.owner)) {
+          maximallySpecific.remove(possibleParent);
+          break;
+        }
+      }
+    }
+
+    return maximallySpecific;
+  }
+
+  private void collectInterfaceDeclarations(
+    StructClass owner,
+    StructClass referenceOwner,
+    Member reference,
+    Set<String> visited,
+    List<Member> declarations
+  ) {
+    if (!visited.add(owner.qualifiedName)) {
+      return;
+    }
+
+    for (String interfaceName : owner.getInterfaceNames()) {
+      StructClass intf = DecompilerContext.getStructContext().getClass(interfaceName);
+      if (intf == null) {
+        continue;
+      }
+
+      Member declared = reference.withOwner(intf.qualifiedName);
+      StructMethod method = intf.getMethod(declared.name, declared.descriptor);
+      if (method != null &&
+          isInherited(method.getAccessFlags(), intf, referenceOwner, true)) {
+        declarations.add(declared);
+      }
+      collectInterfaceDeclarations(
+        intf,
+        referenceOwner,
+        reference,
+        visited,
+        declarations
+      );
+    }
+
+    StructClass parent = superClass(owner);
+    if (parent != null) {
+      collectInterfaceDeclarations(
+        parent,
+        referenceOwner,
+        reference,
+        visited,
+        declarations
+      );
+    }
+  }
+
+  private static boolean isInherited(
+    int accessFlags,
+    StructClass declarationOwner,
+    StructClass referenceOwner,
+    boolean interfaceMethod
+  ) {
+    if ((accessFlags & CodeConstants.ACC_PRIVATE) != 0 ||
+        interfaceMethod && (accessFlags & CodeConstants.ACC_STATIC) != 0) {
+      return false;
+    }
+
+    if ((accessFlags & (CodeConstants.ACC_PUBLIC | CodeConstants.ACC_PROTECTED)) != 0) {
+      return true;
+    }
+
+    return packageName(declarationOwner.qualifiedName)
+      .equals(packageName(referenceOwner.qualifiedName));
+  }
+
+  private static String packageName(String qualifiedName) {
+    int separator = qualifiedName.lastIndexOf('/');
+    return separator < 0 ? "" : qualifiedName.substring(0, separator);
+  }
+
+  private boolean isSubtype(String childName, String parentName) {
+    return subtypeResults.computeIfAbsent(
+      new Subtype(childName, parentName),
+      this::calculateSubtype
+    );
+  }
+
+  private boolean calculateSubtype(Subtype subtype) {
+    Deque<StructClass> pending = new ArrayDeque<>();
+    Set<String> visited = new HashSet<>();
+    StructClass child = DecompilerContext.getStructContext().getClass(subtype.child);
+    if (child != null) {
+      pending.add(child);
+    }
+
+    while (!pending.isEmpty()) {
+      StructClass current = pending.removeFirst();
+      if (!visited.add(current.qualifiedName)) {
+        continue;
+      }
+      if (current.qualifiedName.equals(subtype.parent)) {
+        return true;
+      }
+
+      StructClass parent = superClass(current);
+      if (parent != null) {
+        pending.addLast(parent);
+      }
+
+      for (String interfaceName : current.getInterfaceNames()) {
+        StructClass intf = DecompilerContext.getStructContext().getClass(interfaceName);
+        if (intf != null) {
+          pending.addLast(intf);
+        }
+      }
+    }
+
+    return false;
+  }
+
+  private static StructClass superClass(StructClass owner) {
+    return owner.superClass == null
+      ? null
+      : DecompilerContext.getStructContext().getClass(owner.superClass.getString());
+  }
+
+  private static boolean declares(StructClass owner, Member member) {
+    return switch (member.kind) {
+      case FIELD -> owner.hasField(member.name, member.descriptor);
+      case METHOD -> owner.getMethod(member.name, member.descriptor) != null;
+      case CLASS -> false;
+    };
+  }
+
+  private static Member reference(TextToken token) {
+    if (token instanceof FieldTextToken field) {
+      return Member.field(
+        field.className,
+        field.name,
+        field.descriptor.descriptorString
+      );
+    }
+
+    if (token instanceof MethodTextToken method) {
+      return Member.method(
+        method.className,
+        method.name,
+        method.descriptor.toString()
+      );
+    }
+
+    if (token instanceof ClassTextToken clazz) {
+      return Member.clazz(clazz.qualifiedName);
+    }
+
+    return null;
+  }
+
+  private enum Kind {
+    CLASS,
+    FIELD,
+    METHOD
+  }
+
+  private record FieldLookup(boolean found, Set<Member> declarations) {
+    private static final FieldLookup NOT_FOUND =
+      new FieldLookup(false, Set.of());
+  }
+
+  private record Subtype(String child, String parent) {
+  }
+
+  private record Member(
+    Kind kind,
+    String owner,
+    String name,
+    String descriptor
+  ) {
+    private static Member clazz(String qualifiedName) {
+      return new Member(Kind.CLASS, qualifiedName, "", "");
+    }
+
+    private static Member field(
+      String owner,
+      String name,
+      String descriptor
+    ) {
+      return new Member(Kind.FIELD, owner, name, descriptor);
+    }
+
+    private static Member method(
+      String owner,
+      String name,
+      String descriptor
+    ) {
+      return new Member(Kind.METHOD, owner, name, descriptor);
+    }
+
+    private Member withOwner(String newOwner) {
+      return new Member(kind, newOwner, name, descriptor);
+    }
+  }
+}
