--- /dev/null
+++ b/polyfactory/defaults.py
@@ -0,0 +1,590 @@
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import TYPE_CHECKING, Any, Callable, Iterable, Mapping, Sequence
+
+from polyfactory.exceptions import MissingDefaultException
+from polyfactory.field_meta import Null
+
+if TYPE_CHECKING:
+    from polyfactory.field_meta import FieldMeta
+
+ALL = "all"
+NONE = "none"
+SELECTIONS = (ALL, NONE)
+
+
+def declared(field_meta: FieldMeta) -> bool:
+    """Determine whether a field declares a default at all.
+
+    :param field_meta: FieldMeta instance.
+
+    :returns: A boolean determining whether a default was declared.
+    """
+    return field_meta.default is not Null
+
+
+def value_of(field_meta: FieldMeta) -> Any:
+    """Return the default a field declares.
+
+    A field declaring nothing reads as ``None``, which ``declared`` tells apart
+    from a field whose declared default is ``None``.
+
+    :param field_meta: FieldMeta instance.
+
+    :returns: The declared default, or ``None``.
+    """
+    return field_meta.default if declared(field_meta) else None
+
+
+def is_none(field_meta: FieldMeta) -> bool:
+    """Determine whether a field declares ``None`` as its default.
+
+    :param field_meta: FieldMeta instance.
+
+    :returns: A boolean.
+    """
+    return declared(field_meta) and field_meta.default is None
+
+
+def is_mutable(value: Any) -> bool:
+    """Determine whether a value would be shared if it were handed out as it stands.
+
+    :param value: Any value.
+
+    :returns: A boolean.
+    """
+    return isinstance(value, (list, dict, set, bytearray))
+
+
+def fresh(value: Any) -> Any:
+    """Return a value safe to hand to one build.
+
+    A mutable default is copied so two builds never share it; anything else is
+    returned as it stands.
+
+    :param value: Any value.
+
+    :returns: The value, copied where it is mutable.
+    """
+    if isinstance(value, list):
+        return list(value)
+    if isinstance(value, dict):
+        return dict(value)
+    if isinstance(value, set):
+        return set(value)
+    if isinstance(value, bytearray):
+        return bytearray(value)
+    return value
+
+
+def is_factory(field_meta: FieldMeta) -> bool:
+    """Determine whether a field declares a factory to call rather than a value.
+
+    A model may hand over the callable it was given rather than what that
+    callable returns, so a default is read either way.
+
+    :param field_meta: FieldMeta instance.
+
+    :returns: A boolean.
+    """
+    return declared(field_meta) and callable(field_meta.default)
+
+
+
+def called(value: Any) -> Any:
+    """Return what a declared default amounts to, calling it where it is a factory.
+
+    A factory that raises amounts to nothing.
+
+    :param value: A declared default.
+
+    :returns: The value the default amounts to.
+    """
+    if not callable(value):
+        return value
+    try:
+        return value()
+    except Exception:  # noqa: BLE001
+        return None
+
+
+def taken_from(field_meta: FieldMeta) -> Any:
+    """Return the value one build takes for a field declaring a default.
+
+    A factory is called for this build alone, and a mutable value is copied, so
+    two builds never share what they were given.
+
+    :param field_meta: FieldMeta instance.
+
+    :returns: The value the declared default amounts to.
+    """
+    return fresh(called(value_of(field_meta)))
+
+
+def names_declaring(field_metas: Iterable[FieldMeta]) -> list[str]:
+    """List the fields declaring a default, in name order.
+
+    :param field_metas: FieldMeta instances.
+
+    :returns: A sorted list of field names.
+    """
+    return sorted(field_meta.name for field_meta in field_metas if declared(field_meta))
+
+
+def names_lacking(field_metas: Iterable[FieldMeta]) -> list[str]:
+    """List the fields declaring no default, in name order.
+
+    :param field_metas: FieldMeta instances.
+
+    :returns: A sorted list of field names.
+    """
+    return sorted(field_meta.name for field_meta in field_metas if not declared(field_meta))
+
+
+def defaults_of(field_metas: Iterable[FieldMeta]) -> dict[str, Any]:
+    """Map the name of each field declaring a default to what that default amounts to.
+
+    :param field_metas: FieldMeta instances.
+
+    :returns: A mapping of field name to value.
+    """
+    return {field_meta.name: taken_from(field_meta) for field_meta in field_metas if declared(field_meta)}
+
+
+def names_by_factory(field_metas: Iterable[FieldMeta]) -> list[str]:
+    """List the fields declaring a factory rather than a value, in name order.
+
+    :param field_metas: FieldMeta instances.
+
+    :returns: A sorted list of field names.
+    """
+    return sorted(field_meta.name for field_meta in field_metas if is_factory(field_meta))
+
+
+class Default:
+    """A factory field taking the model's declared default for that field."""
+
+
+class Generate:
+    """A factory field generating a value even where the default would be taken."""
+
+
+def is_selection(value: Any) -> bool:
+    """Determine whether a value names one of the whole-model selections.
+
+    :param value: Any value.
+
+    :returns: A boolean.
+    """
+    return isinstance(value, str) and value in SELECTIONS
+
+
+def readable(selection: Any) -> bool:
+    """Determine whether a selection can be read at all.
+
+    :param selection: A selection.
+
+    :returns: A boolean determining whether the selection can be read.
+    """
+    if isinstance(selection, bool):
+        return True
+    if isinstance(selection, str):
+        return is_selection(selection)
+    if isinstance(selection, Mapping):
+        return False
+    if isinstance(selection, (list, tuple, set, frozenset)):
+        return True
+    return callable(selection)
+
+
+def reaches(selection: Any, field_name: str) -> bool:
+    """Determine whether a selection asks a field to take its declared default.
+
+    :param selection: A selection.
+    :param field_name: The name of a field.
+
+    :returns: A boolean.
+    """
+    if not readable(selection):
+        return False
+    if isinstance(selection, bool):
+        return selection
+    if isinstance(selection, str):
+        return selection == ALL
+    if isinstance(selection, (list, tuple, set, frozenset)):
+        return field_name in set(selection)
+    return bool(selection(field_name))
+
+
+def named_by(selection: Any) -> list[str]:
+    """List the field names a selection spells out, in name order.
+
+    :param selection: A selection.
+
+    :returns: A sorted list of names, empty unless the selection lists them.
+    """
+    if isinstance(selection, (list, tuple, set, frozenset)):
+        return sorted(str(name) for name in selection)
+    return []
+
+
+def unknown_names(selection: Any, field_metas: Iterable[FieldMeta]) -> list[str]:
+    """List the names a selection spells out that a model has no field for, in name order.
+
+    :param selection: A selection.
+    :param field_metas: FieldMeta instances.
+
+    :returns: A sorted list of names.
+    """
+    known = {field_meta.name for field_meta in field_metas}
+    return [name for name in named_by(selection) if name not in known]
+
+
+def selected(selection: Any, field_metas: Iterable[FieldMeta]) -> list[str]:
+    """List the fields a selection takes the default for, in name order.
+
+    A field declaring no default is never taken, however it is selected.
+
+    :param selection: A selection.
+    :param field_metas: FieldMeta instances.
+
+    :returns: A sorted list of field names.
+    """
+    return sorted(
+        field_meta.name
+        for field_meta in list(field_metas)
+        if declared(field_meta) and reaches(selection, field_meta.name)
+    )
+
+
+def skipped(selection: Any, field_metas: Iterable[FieldMeta]) -> list[str]:
+    """List the fields a build generates rather than taking their default, in name order.
+
+    :param selection: A selection.
+    :param field_metas: FieldMeta instances.
+
+    :returns: A sorted list of field names.
+    """
+    metas = list(field_metas)
+    taken = set(selected(selection, metas))
+    return sorted(field_meta.name for field_meta in metas if field_meta.name not in taken)
+
+
+def applied(selection: Any, field_metas: Iterable[FieldMeta], given: Any = None) -> dict[str, Any]:
+    """Map each field taking its default to the value one build takes.
+
+    A name the caller supplied is left out, since the caller's value stands.
+
+    :param selection: A selection.
+    :param field_metas: FieldMeta instances.
+    :param given: A mapping of what the caller supplied.
+
+    :returns: A mapping of field name to value.
+    """
+    metas = list(field_metas)
+    supplied = set(given) if isinstance(given, Mapping) else set()
+    taken = set(selected(selection, metas))
+    return {
+        field_meta.name: taken_from(field_meta)
+        for field_meta in metas
+        if field_meta.name in taken and field_meta.name not in supplied
+    }
+
+
+def check(field_meta: FieldMeta, marker: Any) -> None:
+    """Refuse a marker asking for a default a field does not declare.
+
+    :param field_meta: FieldMeta instance.
+    :param marker: A factory field.
+
+    :raises MissingDefaultException: When a Default marker names a field declaring none.
+
+    :returns: None
+    """
+    if isinstance(marker, Default) and not declared(field_meta):
+        msg = f"{field_meta.name} declares no default to take"
+        raise MissingDefaultException(msg)
+
+
+def wanted(marker: Any) -> bool | None:
+    """Say what a factory field asks for, where it asks for anything.
+
+    :param marker: A factory field.
+
+    :returns: True to take the default, False to generate, ``None`` where it asks for neither.
+    """
+    if isinstance(marker, Default):
+        return True
+    if isinstance(marker, Generate):
+        return False
+    return None
+
+
+def resolve(selection: Any, field_meta: FieldMeta, marker: Any = None) -> bool:
+    """Decide whether one build takes a field's declared default.
+
+    A marker on the field answers for it; otherwise the selection does. A field
+    declaring no default is generated either way.
+
+    :param selection: A selection.
+    :param field_meta: FieldMeta instance.
+    :param marker: A factory field, where the field carries one.
+
+    :returns: A boolean.
+    """
+    if not declared(field_meta):
+        return False
+
+    asked = wanted(marker)
+    if asked is not None:
+        return asked
+    return reaches(selection, field_meta.name)
+
+
+
+def only(names: Sequence[str]) -> Callable[[str], bool]:
+    """Return a selection reaching the named fields alone.
+
+    :param names: Field names.
+
+    :returns: A callable selection.
+    """
+    wanted_names = set(names)
+
+    def reaching(field_name: str) -> bool:
+        return field_name in wanted_names
+
+    return reaching
+
+
+def excluding(names: Sequence[str]) -> Callable[[str], bool]:
+    """Return a selection reaching every field but the named ones.
+
+    :param names: Field names.
+
+    :returns: A callable selection.
+    """
+    unwanted = set(names)
+
+    def reaching(field_name: str) -> bool:
+        return field_name not in unwanted
+
+    return reaching
+
+
+def spells_out(selection: Any) -> bool:
+    """Determine whether a selection picks fields out by name rather than wholesale.
+
+    :param selection: A selection.
+
+    :returns: A boolean.
+    """
+    if not readable(selection):
+        return False
+    if isinstance(selection, bool) or isinstance(selection, str):
+        return False
+    return True
+
+
+def propagated(selection: Any) -> Any:
+    """Return the selection a factory hands to the ones it makes for nested models.
+
+    A selection picking fields out by name means those of the model it was
+    declared on, so nothing of it reaches a nested model.
+
+    :param selection: A selection.
+
+    :returns: A selection.
+    """
+    return NONE if spells_out(selection) else selection
+
+
+@dataclass
+class Summary:
+    """What a selection does to the fields of one model."""
+
+    declaring: tuple
+    lacking: tuple
+    taken: tuple
+    generated: tuple
+    by_factory: tuple
+    values: dict
+    suspect: tuple
+
+    @property
+    def by_value(self) -> list:
+        """Return the fields declaring a value rather than a factory, in name order."""
+        by_factory = set(self.by_factory)
+        return [name for name in self.declaring if name not in by_factory]
+
+    @property
+    def narrowed(self) -> bool:
+        """Return whether any field is left to generate."""
+        return bool(self.generated)
+
+    @property
+    def wholesale(self) -> bool:
+        """Return whether every field declaring a default takes it."""
+        return set(self.declaring) == set(self.taken)
+
+    @property
+    def untouched(self) -> bool:
+        """Return whether no field takes its declared default."""
+        return not self.taken
+
+    @property
+    def sound(self) -> bool:
+        """Return whether every declared default is of the type its field annotates."""
+        return not self.suspect
+
+    def takes(self, field_name: str) -> bool:
+        """Report whether one field takes its declared default.
+
+        :param field_name: The name of a field.
+
+        :returns: A boolean.
+        """
+        return field_name in set(self.taken)
+
+
+def summarise(selection: Any, field_metas: Iterable[FieldMeta]) -> Summary:
+    """Read what a selection does to the fields of one model.
+
+    :param selection: A selection.
+    :param field_metas: FieldMeta instances.
+
+    :returns: A Summary instance.
+    """
+    metas = list(field_metas)
+    return Summary(
+        tuple(names_declaring(metas)),
+        tuple(names_lacking(metas)),
+        tuple(selected(selection, metas)),
+        tuple(skipped(selection, metas)),
+        tuple(names_by_factory(metas)),
+        applied(selection, metas),
+        tuple(mismatched(metas)),
+    )
+
+
+def verify(selection: Any, field_metas: Iterable[FieldMeta]) -> None:
+    """Refuse a selection spelling out a field a model has not got.
+
+    :param selection: A selection.
+    :param field_metas: FieldMeta instances.
+
+    :raises MissingDefaultException: When a name is not a field of the model.
+
+    :returns: None
+    """
+    unknown = unknown_names(selection, field_metas)
+    if unknown:
+        msg = f"{unknown[0]} is not a field of the model"
+        raise MissingDefaultException(msg)
+
+
+def mutable_names(field_metas: Iterable[FieldMeta]) -> list[str]:
+    """List the fields whose declared default would be shared if handed out as it stands.
+
+    :param field_metas: FieldMeta instances.
+
+    :returns: A sorted list of field names.
+    """
+    return sorted(
+        field_meta.name for field_meta in field_metas if declared(field_meta) and is_mutable(value_of(field_meta))
+    )
+
+
+def takes_any(selection: Any, field_metas: Iterable[FieldMeta]) -> bool:
+    """Report whether any field takes its declared default.
+
+    :param selection: A selection.
+    :param field_metas: FieldMeta instances.
+
+    :returns: A boolean.
+    """
+    return bool(selected(selection, field_metas))
+
+
+def takes_all(selection: Any, field_metas: Iterable[FieldMeta]) -> bool:
+    """Report whether every field declaring a default takes it.
+
+    :param selection: A selection.
+    :param field_metas: FieldMeta instances.
+
+    :returns: A boolean.
+    """
+    metas = list(field_metas)
+    return names_declaring(metas) == selected(selection, metas)
+
+
+def fits(field_meta: FieldMeta) -> bool:
+    """Determine whether a field's declared default is of the type it annotates.
+
+    Only a plain class can be checked, so an annotation that is anything else
+    reads as fitting, as does a field declaring nothing.
+
+    :param field_meta: FieldMeta instance.
+
+    :returns: A boolean.
+    """
+    if not declared(field_meta) or is_factory(field_meta):
+        return True
+
+    annotation = field_meta.annotation
+    if not isinstance(annotation, type):
+        return True
+    try:
+        return isinstance(value_of(field_meta), annotation)
+    except TypeError:
+        return True
+
+
+def mismatched(field_metas: Iterable[FieldMeta]) -> list[str]:
+    """List the fields whose declared default is not of the type they annotate, in name order.
+
+    :param field_metas: FieldMeta instances.
+
+    :returns: A sorted list of field names.
+    """
+    return sorted(field_meta.name for field_meta in field_metas if not fits(field_meta))
+
+
+def takes_none(selection: Any, field_metas: Iterable[FieldMeta]) -> list[str]:
+    """List the fields taking a declared default of ``None``, in name order.
+
+    :param selection: A selection.
+    :param field_metas: FieldMeta instances.
+
+    :returns: A sorted list of field names.
+    """
+    metas = list(field_metas)
+    taken = set(selected(selection, metas))
+    return sorted(field_meta.name for field_meta in metas if field_meta.name in taken and is_none(field_meta))
+
+
+def takes_factory(selection: Any, field_metas: Iterable[FieldMeta]) -> list[str]:
+    """List the fields taking a default a factory produces, in name order.
+
+    :param selection: A selection.
+    :param field_metas: FieldMeta instances.
+
+    :returns: A sorted list of field names.
+    """
+    metas = list(field_metas)
+    taken = set(selected(selection, metas))
+    return sorted(field_meta.name for field_meta in metas if field_meta.name in taken and is_factory(field_meta))
+
+
+def takes_value(selection: Any, field_metas: Iterable[FieldMeta]) -> list[str]:
+    """List the fields taking a default declared as a plain value, in name order.
+
+    :param selection: A selection.
+    :param field_metas: FieldMeta instances.
+
+    :returns: A sorted list of field names.
+    """
+    metas = list(field_metas)
+    by_factory = set(takes_factory(selection, metas))
+    return [name for name in selected(selection, metas) if name not in by_factory]
