+#!/usr/bin/env bash
+set -uo pipefail
+
+OUTPUT_PATH=""
+MODE=""
+
+while [[ $# -gt 0 ]]; do
+    case "$1" in
+        --output_path)
+            OUTPUT_PATH="$2"
+            shift 2
+            ;;
+        base|new)
+            MODE="$1"
+            shift
+            ;;
+        *)
+            echo "Unknown argument: $1" >&2
+            exit 2
+            ;;
+    esac
+done
+
+if [[ -z "$OUTPUT_PATH" || -z "$MODE" ]]; then
+    echo "Usage: test.sh --output_path <path> base|new" >&2
+    exit 2
+fi
+
+cd "$(dirname "$0")"
+
+export PYTHONPATH="$(pwd)"
+
+NEW_TEST_FILE="tests/test_model_defaults_5b7e04.py"
+
+BASE_TESTS=(
+    tests/test_build.py
+    tests/test_factory_fields.py
+    tests/test_base_factories.py
+    tests/test_random_configuration.py
+    tests/test_type_coverage_generation.py
+    tests/test_complex_types.py
+    tests/test_dataclass_factory.py
+    tests/test_typeddict_factory.py
+    tests/test_factory_configuration.py
+    tests/test_factory_subclassing.py
+    tests/test_random_seed.py
+    tests/test_collection_length.py
+    tests/test_options_validation.py
+)
+
+if [[ "$MODE" == "base" ]]; then
+    pytest "${BASE_TESTS[@]}" \
+        --rootdir=. \
+        -p no:cacheprovider \
+        --junitxml="$OUTPUT_PATH" \
+        -q
+    STATUS=$?
+else
+    pytest "$NEW_TEST_FILE" \
+        --rootdir=. \
+        -p no:cacheprovider \
+        --junitxml="$OUTPUT_PATH" \
+        -q
+    STATUS=$?
+fi
+
+exit "$STATUS"
