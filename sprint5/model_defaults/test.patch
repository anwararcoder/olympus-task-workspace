+from polyfactory.factories.typed_dict_factory import TypedDictFactory
+from typing_extensions import TypedDict
+
+try:
+    from polyfactory import defaults
+except ImportError:
+    defaults = None
+
+try:
+    from polyfactory.defaults import Default, Generate
+except ImportError:
+    Default = None
+    Generate = None
+
+try:
+    from polyfactory.exceptions import MissingDefaultException
+except ImportError:
+    MissingDefaultException = None
+
+
+def module():
+    if defaults is None:
+        pytest.fail("polyfactory.defaults is not available")
+    return defaults
+
+
+def take():
+    if Default is None:
+        pytest.fail("polyfactory.defaults.Default is not available")
+    return Default
+
+
+def make():
+    if Generate is None:
+        pytest.fail("polyfactory.defaults.Generate is not available")
+    return Generate
+
+
+def default_error():
+    if MissingDefaultException is None:
+        pytest.fail("polyfactory.exceptions.MissingDefaultException is not available")
+    return MissingDefaultException
+
+
+@dataclass
+class Model:
+    plain: int
+    number: int = 7
+    text: str = "fixed"
+    items: List[int] = field(default_factory=lambda: [9])
+    absent: Optional[str] = None
+
+
+@dataclass
+class Probe:
+    number: int = 7
+    tag: int = "a default no generator produces"
+
+
+@dataclass
+class Inner:
+    number: int = 5
+
+
+@dataclass
+class Outer:
+    inner: Inner
+    number: int = 9
+
+
+@dataclass
+class Nested:
+    inner: Probe
+    number: int = 9
+    tag: int = "an outer default no generator produces"
+
+
+@dataclass
+class Mixed:
+    number: int = 3
+    wrong: int = "not an int"
+
+
+class Keyed(TypedDict):
+    number: int
+
+
+def metas_of(model):
+    class Reader(DataclassFactory[model]):
+        ...
+
+    return Reader.get_model_fields()
+
+
+def meta_named(model, name):
+    return next(meta for meta in metas_of(model) if meta.name == name)
+
+
+def built(selection):
+    class Built(DataclassFactory[Model]):
+        __use_defaults__ = selection
+
+    return Built.build()
+
+
+def probed(selection):
+    class Built(DataclassFactory[Probe]):
+        __use_defaults__ = selection
+
+    return Built.build()
+
+
+def generated(instance):
+    return isinstance(instance.tag, int)
+
+
+def taken(instance):
+    return instance.tag == "a default no generator produces"
+
+
+@pytest.mark.parametrize(
+    ("name", "expected"),
+    [("plain", False), ("number", True), ("text", True), ("items", True), ("absent", True)],
+)
+def test_declared_reports_whether_a_field_declares_a_default(name, expected):
+    assert module().declared(meta_named(Model, name)) is expected
+
+
+def test_a_field_declaring_none_is_told_from_one_declaring_nothing():
+    assert module().declared(meta_named(Model, "absent")) is True
+    assert module().is_none(meta_named(Model, "absent")) is True
+    assert module().declared(meta_named(Model, "plain")) is False
+    assert module().is_none(meta_named(Model, "plain")) is False
+
