diff --git a/test.sh b/test.sh
new file mode 100755
index 00000000..9e057410
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,128 @@
+#!/bin/bash
+set -uo pipefail
+
+cd "$(dirname "$0")"
+
+OUTPUT_PATH=""
+MODE=""
+while [[ $# -gt 0 ]]; do
+    case "$1" in
+        --output_path)
+            OUTPUT_PATH="$2"
+            shift 2
+            ;;
+        base|new)
+            MODE="$1"
+            shift
+            ;;
+        *)
+            echo "Usage: $0 --output_path <path> {base|new}"
+            exit 1
+            ;;
+    esac
+done
+
+if [[ -z "$MODE" ]]; then
+    echo "Usage: $0 --output_path <path> {base|new}"
+    exit 1
+fi
+
+export JAVA_HOME="${JAVA_HOME:-/opt/jdk-21}"
+export PATH="$JAVA_HOME/bin:$PATH"
+FOCUS_TEST="InheritSuperMappingsK7p4Test,InheritSuperMappingsErrorsK7p4Test,InheritSuperMappingsAdditionalK7p4Test"
+JVM_ARGS="-Xms1024m -Xmx3072m -Djunit.jupiter.execution.parallel.config.strategy=fixed -Djunit.jupiter.execution.parallel.config.fixed.parallelism=2"
+MVN=(mvn -o -B -Dstyle.color=never -Dmaven.repo.local=/opt/.m2/repository -pl processor -am \
+    -DskipDistribution=true -DfailIfNoTests=false -Dsurefire.failIfNoSpecifiedTests=false "-DargLine=$JVM_ARGS")
+MAVEN_LOG="$(mktemp "${TMPDIR:-/tmp}/inherit-super-mappings-maven.XXXXXX.log")"
+EXCLUDES=""
+TASK_TEST_DIR="processor/src/test/java/org/mapstruct/ap/test/inheritsupermappings/k7p4"
+BASE_HOLD=""
+
+restore_task_tests() {
+    if [[ -n "$BASE_HOLD" && -d "$BASE_HOLD/k7p4" ]]; then
+        mkdir -p "$(dirname "$TASK_TEST_DIR")"
+        mv "$BASE_HOLD/k7p4" "$TASK_TEST_DIR"
+        rmdir "$BASE_HOLD"
+        BASE_HOLD=""
+    fi
+}
+
+cleanup() {
+    restore_task_tests
+    rm -f "$MAVEN_LOG" "$EXCLUDES"
+}
+
+trap cleanup EXIT
+
+run_maven() {
+    : > "$MAVEN_LOG"
+    "${MVN[@]}" "$@" 2>&1 | tee "$MAVEN_LOG"
+    return "${PIPESTATUS[0]}"
+}
+
+xml_escape() {
+    sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
+}
+
+write_xml() {
+    local status="$1"
+    local report fallback_class fallback_test
+    local -a reports=()
+
+    [[ -z "$OUTPUT_PATH" ]] && return 0
+    mapfile -d '' -t reports < <(find . -path '*/target/surefire-reports/TEST-*.xml' -print0 2>/dev/null | sort -z)
+
+    echo '<testsuites>' > "$OUTPUT_PATH"
+    for report in "${reports[@]}"; do
+        sed '1{/^[[:space:]]*<?xml/d;}' "$report" >> "$OUTPUT_PATH"
+    done
+
+    if [[ ${#reports[@]} -eq 0 && $status -ne 0 ]]; then
+        if [[ "$MODE" == "base" ]]; then
+            fallback_class="org.mapstruct.factory.MappersTest"
+            fallback_test="findsNestedMapperImpl"
+        else
+            fallback_class="org.mapstruct.ap.test.inheritsupermappings.k7p4.InheritSuperMappingsK7p4Test"
+            fallback_test="directOverrideInheritsPropertyMappings()[1]"
+        fi
+        cat >> "$OUTPUT_PATH" <<XML
+<testsuite name="$MODE" tests="1" failures="1" errors="0" skipped="0">
+  <testcase classname="$fallback_class" name="$fallback_test">
+    <failure message="Maven failed before Surefire reports were produced">
+XML
+        if [[ -s "$MAVEN_LOG" ]]; then
+            tail -n 200 "$MAVEN_LOG" | xml_escape >> "$OUTPUT_PATH"
+        else
+            echo "Maven failed before Surefire reports were produced." >> "$OUTPUT_PATH"
+        fi
+        cat >> "$OUTPUT_PATH" <<XML
+    </failure>
+  </testcase>
+</testsuite>
+XML
+    fi
+    echo '</testsuites>' >> "$OUTPUT_PATH"
+}
+
+find . -path '*/target/surefire-reports' -type d -exec rm -rf {} + 2>/dev/null || true
+
+status=0
+case "$MODE" in
+    base)
+        BASE_HOLD="$(mktemp -d "${TMPDIR:-/tmp}/inherit-super-mappings-tests.XXXXXX")"
+        mv "$TASK_TEST_DIR" "$BASE_HOLD/k7p4"
+        EXCLUDES="$(mktemp)"
+        {
+            echo '**/InheritSuperMappingsK7p4Test.java'
+            echo '**/InheritSuperMappingsErrorsK7p4Test.java'
+        } > "$EXCLUDES"
+        run_maven test -Dsurefire.excludesFile="$EXCLUDES" || status=$?
