+ * Licensed under the Apache License version 2.0, available at http://www.apache.org/licenses/LICENSE-2.0
+ */
+package org.mapstruct.ap.test.inheritsupermappings.k7p4;
+
+public class DiamondTargetK7p4 {
+
+    private String first;
+    private String second;
+    private String third;
+    private int firstWriteCount;
+    private int thirdWriteCount;
+
+    public String getFirst() {
+        return first;
+    }
+
+    public void setFirst(String first) {
+        this.first = first;
+        this.firstWriteCount++;
+    }
+
+    public int getFirstWriteCount() {
+        return firstWriteCount;
+    }
+
+    public String getSecond() {
+        return second;
+    }
+
+    public void setSecond(String second) {
+        this.second = second;
+    }
+
+    public String getThird() {
+        return third;
+    }
+
+    public void setThird(String third) {
+        this.third = third;
+        this.thirdWriteCount++;
+    }
+
+    public int getThirdWriteCount() {
+        return thirdWriteCount;
+    }
+}
