+        );
+
+        assertThat( target.getFirst() ).isEqualTo( "super" );
+        assertThat( target.getSecond() ).isEqualTo( "configuration" );
+    }
+
+    @ProcessorTest
+    @WithClasses({
+        ParentBeanOptionsMapperK7p4.class, SourceK7p4.class, NestedSourceK7p4.class, TargetK7p4.class
+    })
+    public void parentBeanMappingOptionsAreNotImplicitlyCopied() {
+        TargetK7p4 target = ParentBeanOptionsMapperK7p4.INSTANCE.map(
+            source( "super", "b", "g", "automatic", "nested" )
+        );
+
+        assertThat( target.getFirst() ).isEqualTo( "super" );
+        assertThat( target.getNatural() ).isEqualTo( "automatic" );
+    }
+
+    @ProcessorTest
+    @WithClasses({
+        NullStrategyMapperK7p4.class, SourceK7p4.class, NestedSourceK7p4.class, TargetK7p4.class
+    })
+    public void parentNullValueMappingStrategyIsNotImplicitlyCopied() {
+        assertThat( NullStrategyMapperK7p4.INSTANCE.map( null ) ).isNull();
+
+        TargetK7p4 target = NullStrategyMapperK7p4.INSTANCE.map(
+            source( "super", "b", "g", "n", "nested" )
+        );
+
+        assertThat( target.getFirst() ).isEqualTo( "super" );
+    }
+
+    @ProcessorTest
+    @WithClasses({
+        ExpressionMapperK7p4.class, SourceK7p4.class, NestedSourceK7p4.class, TargetK7p4.class
+    })
+    public void rawJavaExpressionIsInheritedVerbatim() {
+        TargetK7p4 target = ExpressionMapperK7p4.INSTANCE.map(
+            source( "mixed", "b", "g", "n", "nested" )
+        );
+
+        assertThat( target.getFirst() ).isEqualTo( "MIXED" );
+    }
+
+    @ProcessorTest
+    @WithClasses({
+        SuperclassMapperK7p4.class, SourceK7p4.class, NestedSourceK7p4.class, TargetK7p4.class
+    })
+    public void abstractSuperclassMappingIsInherited() {
+        TargetK7p4 target = SuperclassMapperK7p4.INSTANCE.map(
+            source( "superclass", "b", "g", "n", "nested" )
+        );
+
+        assertThat( target.getFirst() ).isEqualTo( "superclass" );
+    }
+
+    @ProcessorTest
+    @WithClasses({
+        GenericSuperclassMapperK7p4.class, SourceK7p4.class, NestedSourceK7p4.class, TargetK7p4.class
+    })
+    public void genericSuperclassChainUsesMostSpecificDeclaration() {
+        TargetK7p4 target = GenericSuperclassMapperK7p4.INSTANCE.map(
+            source( "root", "middle", "root-third", "n", "nested" )
+        );
+
+        assertThat( target.getFirst() ).isEqualTo( "middle" );
+        assertThat( target.getThird() ).isEqualTo( "root-third" );
+    }
+
+    private SourceK7p4 source(String alpha, String beta, String gamma, String natural, String nestedValue) {
+        NestedSourceK7p4 nested = new NestedSourceK7p4();
+        nested.setValue( nestedValue );
+
+        SourceK7p4 source = new SourceK7p4();
+        source.setAlpha( alpha );
+        source.setBeta( beta );
+        source.setGamma( gamma );
+        source.setNatural( natural );
+        source.setNested( nested );
+        return source;
+    }
+}
