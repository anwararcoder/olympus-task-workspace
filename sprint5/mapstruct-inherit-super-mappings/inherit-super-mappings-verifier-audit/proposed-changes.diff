+/*
+ * Copyright MapStruct Authors.
+ *
+ * Licensed under the Apache License version 2.0, available at http://www.apache.org/licenses/LICENSE-2.0
+ */
+package org.mapstruct.ap.test.inheritsupermappings.k7p4;
+
+import org.mapstruct.BeanMapping;
+import org.mapstruct.Mapper;
+import org.mapstruct.Mapping;
+import org.mapstruct.factory.Mappers;
+
+class DependsOnProbeTarget {
+    private String first;
+    private String second;
+    private boolean firstSetBeforeSecond;
+
+    public String getFirst() { return first; }
+    public void setFirst(String first) { this.first = first; }
+    public String getSecond() { return second; }
+    public void setSecond(String second) {
+        firstSetBeforeSecond = first != null;
+        this.second = second;
+    }
+    public boolean isFirstSetBeforeSecond() { return firstSetBeforeSecond; }
+}
+
+interface DependsOnProbeParent {
+    @Mapping(target = "second", source = "beta", dependsOn = "first")
+    @Mapping(target = "first", source = "alpha")
+    DependsOnProbeTarget map(SourceK7p4 source);
+}
+
+@Mapper
+interface DependsOnProbeMapper extends DependsOnProbeParent {
+    DependsOnProbeMapper INSTANCE = Mappers.getMapper( DependsOnProbeMapper.class );
+
+    @Override
+    @BeanMapping(inheritSuperMappings = true, ignoreByDefault = true)
+    DependsOnProbeTarget map(SourceK7p4 renamed);
+}
