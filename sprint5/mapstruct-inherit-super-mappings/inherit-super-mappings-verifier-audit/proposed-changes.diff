+ */
+package org.mapstruct.ap.test.inheritsupermappings.k7p4;
+
+import org.mapstruct.BeanMapping;
+import org.mapstruct.Context;
+import org.mapstruct.Mapper;
+import org.mapstruct.Mapping;
+import org.mapstruct.ReportingPolicy;
+import org.mapstruct.factory.Mappers;
+
+class SignaturePositionProbeHelper {
+    private String alpha;
+    public String getAlpha() { return alpha; }
+    public void setAlpha(String alpha) { this.alpha = alpha; }
+}
+
+interface SignaturePositionProbeParent {
+    @Mapping(target = "first", source = "second.alpha")
+    TargetK7p4 map(SourceK7p4 first, @Context SignaturePositionProbeHelper helper, SourceK7p4 second);
+}
+
+@Mapper(unmappedTargetPolicy = ReportingPolicy.IGNORE)
+interface SignaturePositionProbeMapper extends SignaturePositionProbeParent {
+    SignaturePositionProbeMapper INSTANCE = Mappers.getMapper( SignaturePositionProbeMapper.class );
+
+    @Override
+    @BeanMapping(inheritSuperMappings = true, ignoreByDefault = true)
+    TargetK7p4 map(SourceK7p4 renamedFirst, SignaturePositionProbeHelper nowSource, SourceK7p4 renamedSecond);
+}
