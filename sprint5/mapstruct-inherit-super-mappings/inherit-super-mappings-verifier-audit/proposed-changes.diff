+    @ProcessorTest
+    @WithClasses({ DefaultExpressionProbeMapper.class, SourceK7p4.class, NestedSourceK7p4.class,
+        TargetK7p4.class })
+    public void inheritedDefaultExpressionIsRetained() {
+        SourceK7p4 source = source();
+        source.setAlpha( null );
+
+        assertThat( DefaultExpressionProbeMapper.INSTANCE.map( source ).getFirst() )
+            .isEqualTo( "default-expression" );
+    }
+
+    @ProcessorTest
+    @WithClasses({ DependsOnProbeMapper.class, SourceK7p4.class, NestedSourceK7p4.class })
+    public void inheritedDependsOnPreservesAssignmentOrder() {
+        DependsOnProbeTarget target = DependsOnProbeMapper.INSTANCE.map( source() );
+
+        assertThat( target.isFirstSetBeforeSecond() ).isTrue();
+    }
+
+    @ProcessorTest
+    @WithClasses({ SignaturePositionProbeMapper.class, SourceK7p4.class, NestedSourceK7p4.class,
+        TargetK7p4.class })
+    public void rebindingUsesSignaturePositionNotSourceParameterOrdinal() {
+        SourceK7p4 first = source();
+        first.setAlpha( "first" );
+        SignaturePositionProbeHelper middle = new SignaturePositionProbeHelper();
+        middle.setAlpha( "middle" );
+        SourceK7p4 second = source();
+        second.setAlpha( "signature-position" );
+
+        TargetK7p4 target = SignaturePositionProbeMapper.INSTANCE.map( first, middle, second );
+
+        assertThat( target.getFirst() ).isEqualTo( "signature-position" );
+    }
+
