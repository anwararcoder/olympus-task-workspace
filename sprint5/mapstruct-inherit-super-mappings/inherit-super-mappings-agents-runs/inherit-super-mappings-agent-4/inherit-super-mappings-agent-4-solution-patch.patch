+    private void inheritSuperMappings(SourceMethod sourceMethod, TypeElement mapperToImplement,
+                                      MapperOptions mapperOptions) {
+        List<SourceMethod> overriddenMethods = new ArrayList<>();
+        collectOverriddenMethods(
+            sourceMethod.getExecutable(),
+            (DeclaredType) mapperToImplement.asType(),
+            mapperToImplement,
+            mapperOptions,
+            overriddenMethods,
+            new HashSet<>()
+        );
+
+        if ( overriddenMethods.isEmpty() ) {
+            messager.printMessage(
+                sourceMethod.getExecutable(),
+                sourceMethod.getOptions().getBeanMapping().getMirror(),
+                Message.BEANMAPPING_INHERIT_SUPER_MAPPINGS_NO_OVERRIDE
+            );
+            return;
+        }
+
+        Set<String> currentTargets = new HashSet<>();
+        for ( MappingOptions mapping : sourceMethod.getOptions().getMappings() ) {
+            if ( !".".equals( mapping.getTargetName() ) ) {
+                currentTargets.add( mapping.getTargetName() );
+            }
+        }
+
+        Map<String, List<InheritedMapping>> inheritedByTarget = new LinkedHashMap<>();
+        for ( SourceMethod overriddenMethod : overriddenMethods ) {
+            for ( MappingOptions mapping : overriddenMethod.getOptions().getMappings() ) {
+                if ( ".".equals( mapping.getTargetName() ) ) {
+                    sourceMethod.getOptions().getMappings().add(
+                        mapping.copyForSuperInheritance(
+                            overriddenMethod,
+                            sourceMethod.getOptions().getBeanMapping()
+                        )
+                    );
+                }
+                else if ( !currentTargets.contains( mapping.getTargetName() ) ) {
+                    inheritedByTarget.computeIfAbsent( mapping.getTargetName(), key -> new ArrayList<>() )
+                        .add( new InheritedMapping( overriddenMethod, mapping ) );
+                }
+            }
+        }
+
+        for ( Map.Entry<String, List<InheritedMapping>> entry : inheritedByTarget.entrySet() ) {
+            List<InheritedMapping> mostSpecific = mostSpecificMappings( entry.getValue(), mapperToImplement );
+            if ( mostSpecific.size() == 1 ) {
+                InheritedMapping inheritedMapping = mostSpecific.get( 0 );
+                sourceMethod.getOptions().getMappings().add(
+                    inheritedMapping.mapping.copyForSuperInheritance(
+                        inheritedMapping.method,
+                        sourceMethod.getOptions().getBeanMapping()
+                    )
+                );
+            }
+            else if ( mostSpecific.size() > 1 ) {
+                messager.printMessage(
+                    sourceMethod.getExecutable(),
+                    sourceMethod.getOptions().getBeanMapping().getMirror(),
+                    Message.BEANMAPPING_INHERIT_SUPER_MAPPINGS_CONFLICT,
+                    entry.getKey(),
+                    declaringTypeName( mostSpecific.get( 0 ).method ),
+                    declaringTypeName( mostSpecific.get( 1 ).method )
+                );
+            }
+        }
+    }
+
+    private List<InheritedMapping> mostSpecificMappings(List<InheritedMapping> mappings,
+                                                        TypeElement mapperToImplement) {
+        List<InheritedMapping> result = new ArrayList<>();
+        for ( InheritedMapping candidate : mappings ) {
+            boolean overridden = false;
+            for ( InheritedMapping other : mappings ) {
+                if ( candidate != other && isMoreSpecific(
+                    other.method.getExecutable(), candidate.method.getExecutable(), mapperToImplement ) ) {
+                    overridden = true;
+                    break;
+                }
+            }
+            if ( !overridden ) {
+                result.add( candidate );
+            }
+        }
+        return result;
+    }
+
+    private boolean isMoreSpecific(ExecutableElement moreSpecificMethod, ExecutableElement lessSpecificMethod,
+                                   TypeElement mapperToImplement) {
+        TypeMirror moreSpecificType = moreSpecificMethod.getEnclosingElement().asType();
+        TypeMirror lessSpecificType = lessSpecificMethod.getEnclosingElement().asType();
+        return typeUtils.isSubtype( typeUtils.erasure( moreSpecificType ), typeUtils.erasure( lessSpecificType ) )
+            && overrides( moreSpecificMethod, lessSpecificMethod, mapperToImplement );
+    }
+
+    private String declaringTypeName(SourceMethod method) {
+        return ( (TypeElement) method.getExecutable().getEnclosingElement() ).getQualifiedName().toString();
+    }
+
+    private void collectOverriddenMethods(ExecutableElement overridingMethod, DeclaredType type,
+                                          TypeElement mapperToImplement, MapperOptions mapperOptions,
+                                          List<SourceMethod> overriddenMethods,
+                                          Set<String> visitedMethods) {
+        for ( TypeMirror supertypeMirror : typeUtils.directSupertypes( type ) ) {
+            if ( supertypeMirror.getKind() != TypeKind.DECLARED ) {
+                continue;
+            }
+            DeclaredType supertype = (DeclaredType) supertypeMirror;
+            TypeElement supertypeElement = (TypeElement) supertype.asElement();
+            for ( ExecutableElement candidate : ElementFilter.methodsIn( supertypeElement.getEnclosedElements() ) ) {
+                String methodKey = supertypeElement.getEnclosingElement() + "." + supertypeElement.getSimpleName()
+                    + "#" + candidate;
+                if ( visitedMethods.add( methodKey ) && overrides( overridingMethod, candidate, mapperToImplement ) ) {
+                    overriddenMethods.add( superMappingMethod( candidate, supertype, mapperOptions ) );
+                }
+            }
+            collectOverriddenMethods(
+                overridingMethod,
+                supertype,
+                mapperToImplement,
+                mapperOptions,
+                overriddenMethods,
+                visitedMethods
+            );
+        }
+    }
+
+    private boolean overrides(ExecutableElement overridingMethod, ExecutableElement overriddenMethod,
+                              TypeElement mapperToImplement) {
+        if ( elementUtils.overrides( overridingMethod, overriddenMethod, mapperToImplement ) ) {
+            return true;
+        }
+        if ( !overridingMethod.getSimpleName().contentEquals( overriddenMethod.getSimpleName() )
+            || overridingMethod.getModifiers().contains( Modifier.STATIC )
+            || overriddenMethod.getModifiers().contains( Modifier.STATIC )
+            || overriddenMethod.getModifiers().contains( Modifier.PRIVATE ) ) {
+            return false;
+        }
+
+        DeclaredType mapperType = (DeclaredType) mapperToImplement.asType();
+        ExecutableType overridingType = (ExecutableType) typeUtils.asMemberOf( mapperType, overridingMethod );
+        ExecutableType overriddenType = (ExecutableType) typeUtils.asMemberOf( mapperType, overriddenMethod );
+        if ( overridingType.getParameterTypes().size() != overriddenType.getParameterTypes().size() ) {
+            return false;
+        }
+        for ( int i = 0; i < overridingType.getParameterTypes().size(); i++ ) {
+            TypeMirror overridingParameter = overridingType.getParameterTypes().get( i );
+            TypeMirror overriddenParameter = overriddenType.getParameterTypes().get( i );
+            if ( !typeUtils.isSameType(
+                typeUtils.erasure( overridingParameter ), typeUtils.erasure( overriddenParameter ) ) ) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private SourceMethod superMappingMethod(ExecutableElement method, DeclaredType declaringType,
+                                            MapperOptions mapperOptions) {
+        ExecutableType methodType = typeFactory.getMethodType( declaringType, method );
+        List<Parameter> parameters = typeFactory.getParameters( methodType, method );
+        BeanMappingOptions beanMappingOptions = BeanMappingOptions.getInstanceOn(
+            BeanMappingGem.instanceOn( method ), mapperOptions, method, messager, typeUtils, typeFactory
+        );
+        return new SourceMethod.Builder()
+            .setExecutable( method )
+            .setParameters( parameters )
+            .setReturnType( typeFactory.getReturnType( methodType ) )
+            .setExceptionTypes( typeFactory.getThrownTypes( methodType ) )
+            .setMapper( mapperOptions )
+            .setBeanMappingOptions( beanMappingOptions )
+            .setMappingOptions( getMappings( method, beanMappingOptions ) )
+            .setTypeUtils( typeUtils )
+            .setTypeFactory( typeFactory )
+            .build();
+    }
+
+    private static class InheritedMapping {
+        private final SourceMethod method;
+        private final MappingOptions mapping;
+
+        private InheritedMapping(SourceMethod method, MappingOptions mapping) {
+            this.method = method;
+            this.mapping = mapping;
+        }
     }
 
