+package org.mapstruct.ap.test.inheritsupermappings;
+
+import org.mapstruct.BeanMapping;
+import org.mapstruct.Mapper;
+import org.mapstruct.Mapping;
+import org.mapstruct.ReportingPolicy;
+
+@Mapper(unmappedTargetPolicy = ReportingPolicy.IGNORE)
+public interface ConflictingInheritedSuperMappingsMapper extends ConflictingInheritedSuperMappingsLeft,
+    ConflictingInheritedSuperMappingsRight {
+
+    @Override
+    @BeanMapping(inheritSuperMappings = true)
+    Target map(Source source);
+
+    class Source {
+        private String left;
+        private String right;
+
+        public String getLeft() {
+            return left;
+        }
+
+        public void setLeft(String left) {
+            this.left = left;
+        }
+
+        public String getRight() {
+            return right;
+        }
+
+        public void setRight(String right) {
+            this.right = right;
+        }
+    }
+
+    class Target {
+        private String value;
+
+        public String getValue() {
+            return value;
+        }
+
+        public void setValue(String value) {
+            this.value = value;
+        }
+    }
+}
+
+interface ConflictingInheritedSuperMappingsRoot {
+    ConflictingInheritedSuperMappingsMapper.Target map(ConflictingInheritedSuperMappingsMapper.Source source);
+}
+
+interface ConflictingInheritedSuperMappingsLeft extends ConflictingInheritedSuperMappingsRoot {
+    @Override
+    @Mapping(target = "value", source = "left")
+    ConflictingInheritedSuperMappingsMapper.Target map(ConflictingInheritedSuperMappingsMapper.Source source);
+}
+
+interface ConflictingInheritedSuperMappingsRight extends ConflictingInheritedSuperMappingsRoot {
+    @Override
+    @Mapping(target = "value", source = "right")
+    ConflictingInheritedSuperMappingsMapper.Target map(ConflictingInheritedSuperMappingsMapper.Source source);
+}
