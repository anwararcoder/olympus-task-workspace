+    InheritedSuperMappingsTestMapper.Target flatten(InheritedSuperMappingsTestMapper.Source source);
+}
+
+interface InheritedSuperMappingsFlattenRight extends InheritedSuperMappingsFlattenRoot {
+
+    @Override
+    @Mapping( target = ".", source = "right" )
+    InheritedSuperMappingsTestMapper.Target flatten(InheritedSuperMappingsTestMapper.Source source);
+}
+
+interface InheritedSuperMappingsComposedBase {
+
+    @InheritedValueMapping
+    InheritedSuperMappingsTestMapper.Target composed(InheritedSuperMappingsTestMapper.Source source);
+}
+
+interface InheritedSuperMappingsComposedChild extends InheritedSuperMappingsComposedBase {
+}
+
+@Target({ ElementType.METHOD, ElementType.ANNOTATION_TYPE })
+@Retention(RetentionPolicy.CLASS)
+@Mapping( target = "composed", source = "value" )
+@interface InheritedValueMapping {
+}
