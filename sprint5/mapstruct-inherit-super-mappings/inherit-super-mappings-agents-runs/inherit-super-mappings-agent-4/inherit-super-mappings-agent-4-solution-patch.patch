+    InheritedSuperMappingsTestMapper.Target mapOne(InheritedSuperMappingsTestMapper.Source source);
+}
+
+interface InheritedSuperMappingsSingleChild extends InheritedSuperMappingsSingleBase {
+}
+
+interface InheritedSuperMappingsFlattenRoot {
+
