+interface InheritedSuperMappingsBase<S> {
+
+    @BeanMapping( ignoreByDefault = true )
+    @Mapping( target = "renamed", source = "first.value" )
+    @Mapping( target = "fromBase", source = "second.value" )
+    InheritedSuperMappingsTestMapper.Target map(S first, S second);
+}
+
+interface InheritedSuperMappingsMiddle extends InheritedSuperMappingsBase<InheritedSuperMappingsTestMapper.Source> {
+
+    @Override
