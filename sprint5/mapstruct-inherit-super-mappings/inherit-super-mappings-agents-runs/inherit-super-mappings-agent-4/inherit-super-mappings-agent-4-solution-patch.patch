+
+    @ProcessorTest
+    public void shouldInheritMappingsFromGenericTransitiveSupertypes() {
+        InheritedSuperMappingsTestMapper.Source left = new InheritedSuperMappingsTestMapper.Source();
+        left.setValue( "left" );
+        left.setSource( "property" );
+        InheritedSuperMappingsTestMapper.Source right = new InheritedSuperMappingsTestMapper.Source();
+        right.setValue( "right" );
+
+        InheritedSuperMappingsTestMapper.Target target =
+            InheritedSuperMappingsTestMapper.INSTANCE.map( left, right );
+
+        assertThat( target.getRenamed() ).isEqualTo( "right" );
+        assertThat( target.getFromBase() ).isEqualTo( "right" );
+        assertThat( target.getLocal() ).isEqualTo( "left" );
+        InheritedSuperMappingsTestMapper.Target singleTarget =
+            InheritedSuperMappingsTestMapper.INSTANCE.mapOne( left );
+        assertThat( singleTarget.getNamed() ).isEqualTo( "property" );
+        assertThat( singleTarget.getValue() ).isEqualTo( "left" );
+
+        InheritedSuperMappingsTestMapper.Source flattenSource = new InheritedSuperMappingsTestMapper.Source();
+        flattenSource.setRoot( new InheritedSuperMappingsTestMapper.RootNested( "root" ) );
+        flattenSource.setLeft( new InheritedSuperMappingsTestMapper.LeftNested( "left" ) );
+        flattenSource.setRight( new InheritedSuperMappingsTestMapper.RightNested( "right" ) );
+        InheritedSuperMappingsTestMapper.Target flattened =
+            InheritedSuperMappingsTestMapper.INSTANCE.flatten( flattenSource );
+        assertThat( flattened.getRootValue() ).isEqualTo( "root" );
+        assertThat( flattened.getLeftValue() ).isEqualTo( "left" );
+        assertThat( flattened.getRightValue() ).isEqualTo( "right" );
+
+        assertThat( InheritedSuperMappingsTestMapper.INSTANCE.composed( left ).getComposed() )
+            .isEqualTo( "left" );
+    }
+}
