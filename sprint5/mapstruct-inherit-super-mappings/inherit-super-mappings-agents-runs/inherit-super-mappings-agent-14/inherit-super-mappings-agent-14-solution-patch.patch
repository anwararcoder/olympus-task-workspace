+    private void addMostSpecificMapping(List<InheritedMapping> inheritedMappings, InheritedMapping candidate,
+                                        TypeUtils typeUtils) {
+        boolean candidateIsInherited = false;
+        for ( Iterator<InheritedMapping> iterator = inheritedMappings.iterator(); iterator.hasNext(); ) {
