--- /dev/null
+++ b/processor/src/test/java/org/mapstruct/ap/test/inheritsupermappings/InheritSuperMappingsTest.java
@@ -0,0 +1,146 @@
+/*
+ * Copyright MapStruct Authors.
+ *
+ * Licensed under the Apache License version 2.0, available at http://www.apache.org/licenses/LICENSE-2.0
+ */
+package org.mapstruct.ap.test.inheritsupermappings;
+
+import javax.tools.Diagnostic.Kind;
+
+import org.mapstruct.ap.test.inheritsupermappings.TestData.EmptyTarget;
+import org.mapstruct.ap.test.inheritsupermappings.TestData.FlattenTarget;
+import org.mapstruct.ap.test.inheritsupermappings.TestData.PairTarget;
+import org.mapstruct.ap.test.inheritsupermappings.TestData.PartA;
+import org.mapstruct.ap.test.inheritsupermappings.TestData.PartB;
+import org.mapstruct.ap.test.inheritsupermappings.TestData.PartC;
+import org.mapstruct.ap.test.inheritsupermappings.TestData.PartD;
+import org.mapstruct.ap.test.inheritsupermappings.TestData.PropertyTarget;
+import org.mapstruct.ap.test.inheritsupermappings.TestData.Source;
+import org.mapstruct.ap.test.inheritsupermappings.TestData.Target;
+import org.mapstruct.ap.testutil.ProcessorTest;
+import org.mapstruct.ap.testutil.WithClasses;
+import org.mapstruct.ap.testutil.compilation.annotation.CompilationResult;
+import org.mapstruct.ap.testutil.compilation.annotation.Diagnostic;
+import org.mapstruct.ap.testutil.compilation.annotation.ExpectedCompilationOutcome;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+public class InheritSuperMappingsTest {
+
+    @ProcessorTest
+    @WithClasses({
+        TestData.class,
+        AbstractBaseMapper.class,
+        ClassSuperMappingsMapper.class,
+        ComposedMapping.class,
+        GenericBaseMapper.class,
+        GenericMidMapper.class,
+        PairBaseMapper.class,
+        BranchLeftMapper.class,
+        BranchRightMapper.class,
+        NoInheritanceBaseMapper.class,
+        PropertyBaseMapper.class,
+        EmptyBaseMapper.class,
+        CommonFlattenMapper.class,
+        LeftFlattenMapper.class,
+        RightFlattenMapper.class,
+        SuperMappingsConfig.class,
+        SuperMappingsMapper.class
+    })
+    public void shouldInheritMappingsFromOverriddenMethods() {
+        Source source = source( "direct", "base", "mid", "current", "automatic" );
+        source.setRenamed( source( null, "nested-renamed", null, null, null ) );
+        source.setSource( source( null, "nested-source", null, null, null ) );
+
+        Target target = SuperMappingsMapper.INSTANCE.map( source );
+
+        assertThat( target.getName() ).isEqualTo( "mid" );
+        assertThat( target.getRootValue() ).isEqualTo( "base" );
+        assertThat( target.getCurrent() ).isEqualTo( "current" );
+        assertThat( target.getComposed() ).isEqualTo( "base" );
+        assertThat( target.getConfigured() ).isEqualTo( "current" );
+        assertThat( target.getAutomatic() ).isEqualTo( "automatic" );
+        assertThat( target.getExpression() ).isEqualTo( "fixed" );
+        assertThat( target.getSource() ).isSameAs( source );
+        assertThat( SuperMappingsMapper.INSTANCE.map( null ) ).isNull();
+
+        Target withoutSuperMappings = SuperMappingsMapper.INSTANCE.mapWithoutSuperMappings( source );
+        assertThat( withoutSuperMappings.getName() ).isEqualTo( "direct" );
+
+        PairTarget pair = SuperMappingsMapper.INSTANCE.mapPair(
+            source( null, "left", null, null, null ),
+            source( null, "right", null, null, null )
+        );
+        assertThat( pair.getLeftName() ).isEqualTo( "left" );
+        assertThat( pair.getRightName() ).isEqualTo( "right" );
+
+        PairTarget branches = SuperMappingsMapper.INSTANCE.mapBranches( source );
+        assertThat( branches.getLeftName() ).isEqualTo( "base" );
+        assertThat( branches.getRightName() ).isEqualTo( "mid" );
+
+        PairTarget classTarget = ClassSuperMappingsMapper.INSTANCE.mapClass( source );
+        assertThat( classTarget.getLeftName() ).isEqualTo( "base" );
+        assertThat( classTarget.getRightName() ).isNull();
+
+        PropertyTarget property = SuperMappingsMapper.INSTANCE.mapProperty( source );
+        assertThat( property.getValue() ).isEqualTo( "nested-source" );
+
+        EmptyTarget empty = SuperMappingsMapper.INSTANCE.mapEmpty( source );
+        assertThat( empty.getAutomatic() ).isEqualTo( "automatic" );
+
+        PartA partA = new PartA();
+        partA.setA( "a" );
+        PartB partB = new PartB();
+        partB.setB( "b" );
+        PartC partC = new PartC();
+        partC.setC( "c" );
+        PartD partD = new PartD();
+        partD.setD( "d" );
+        FlattenTarget flattened = SuperMappingsMapper.INSTANCE.mapFlatten( partA, partB, partC, partD );
+        assertThat( flattened.getA() ).isEqualTo( "a" );
+        assertThat( flattened.getB() ).isEqualTo( "b" );
+        assertThat( flattened.getC() ).isEqualTo( "c" );
+        assertThat( flattened.getD() ).isEqualTo( "d" );
+    }
+
+    @ProcessorTest
+    @WithClasses({ TestData.class, ConflictLeftMapper.class, ConflictRightMapper.class,
+        ConflictingSuperMappingsMapper.class })
+    @ExpectedCompilationOutcome(
+        value = CompilationResult.FAILED,
+        diagnostics = @Diagnostic(
+            type = ConflictingSuperMappingsMapper.class,
+            kind = Kind.ERROR,
+            line = 18,
+            message = "Conflicting inherited mappings for target \"name\" are declared in mapper types: " +
+                "org.mapstruct.ap.test.inheritsupermappings.ConflictLeftMapper, " +
+                "org.mapstruct.ap.test.inheritsupermappings.ConflictRightMapper."
+        )
+    )
+    public void shouldReportMappingsFromIncomparableBranches() {
+    }
+
+    @ProcessorTest
+    @WithClasses({ TestData.class, NoSuperMappingsMapper.class })
+    @ExpectedCompilationOutcome(
+        value = CompilationResult.FAILED,
+        diagnostics = @Diagnostic(
+            type = NoSuperMappingsMapper.class,
+            kind = Kind.ERROR,
+            line = 17,
+            message = "No overridden mapping method was found for @BeanMapping#inheritSuperMappings."
+        )
+    )
+    public void shouldRequireAnOverriddenMappingMethod() {
+    }
+
+    private Source source(String name, String baseName, String midName, String currentName, String automatic) {
+        Source source = new Source();
+        source.setName( name );
+        source.setBaseName( baseName );
+        source.setMidName( midName );
+        source.setCurrentName( currentName );
+        source.setAutomatic( automatic );
+        return source;
+    }
+}
