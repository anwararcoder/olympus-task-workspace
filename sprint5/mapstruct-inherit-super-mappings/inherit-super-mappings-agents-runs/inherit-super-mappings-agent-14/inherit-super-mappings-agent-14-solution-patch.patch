+    private List<SourceMethod> getOverriddenMappingMethods(SourceMethod sourceMethod, MapperOptions mapperOptions,
+                                                           TypeElement mapperToImplement,
+                                                           BeanMappingOptions beanMappingOptions) {
+        List<ExecutableElement> overriddenMethods = new ArrayList<>();
+        Set<String> visitedTypes = new HashSet<>();
+        TypeElement declaringType = (TypeElement) sourceMethod.getExecutable().getEnclosingElement();
+        for ( TypeMirror superType : typeUtils.directSupertypes( declaringType.asType() ) ) {
+            collectOverriddenMethods(
+                sourceMethod.getExecutable(),
+                superType,
+                mapperToImplement,
+                visitedTypes,
+                overriddenMethods
+            );
+        }
+
+        List<SourceMethod> result = new ArrayList<>( overriddenMethods.size() );
+        DeclaredType mapperType = (DeclaredType) mapperToImplement.asType();
+        for ( ExecutableElement overriddenMethod : overriddenMethods ) {
+            ExecutableType methodType = typeFactory.getMethodType( mapperType, overriddenMethod );
+            List<Parameter> parameters = typeFactory.getParameters( methodType, overriddenMethod );
+            List<Parameter> sourceParameters = Parameter.getSourceParameters( parameters );
+            Parameter targetParameter = extractTargetParameter( parameters );
+            Type returnType = typeFactory.getReturnType( methodType );
+            Type resultType = selectResultType( returnType, targetParameter );
+            if ( sourceParameters.isEmpty() || isVoid( resultType )
+                || SourceMethod.containsTargetTypeParameter( parameters )
+                || Executables.isLifecycleCallbackMethod( overriddenMethod ) ) {
+                continue;
+            }
+
+            TypeElement overriddenDeclaringType = (TypeElement) overriddenMethod.getEnclosingElement();
+            result.add(
+                new SourceMethod.Builder()
+                    .setDefiningType( typeFactory.getType( overriddenDeclaringType.asType() ) )
+                    .setExecutable( overriddenMethod )
+                    .setParameters( parameters )
+                    .setReturnType( returnType )
+                    .setExceptionTypes( typeFactory.getThrownTypes( methodType ) )
+                    .setMapper( mapperOptions )
+                    .setBeanMappingOptions( beanMappingOptions )
+                    .setMappingOptions( getMappings( overriddenMethod, beanMappingOptions ) )
+                    .setTypeUtils( typeUtils )
+                    .setTypeFactory( typeFactory )
+                    .setVerboseLogging( options.isVerbose() )
+                    .build()
+            );
+        }
+        return result;
+    }
+
+    private void collectOverriddenMethods(ExecutableElement method, TypeMirror superType,
+                                          TypeElement mapperToImplement, Set<String> visitedTypes,
+                                          List<ExecutableElement> overriddenMethods) {
+        if ( superType.getKind() != TypeKind.DECLARED ) {
+            return;
+        }
+
+        TypeElement superTypeElement = (TypeElement) ( (DeclaredType) superType ).asElement();
+        if ( !visitedTypes.add( superTypeElement.getQualifiedName().toString() ) ) {
+            return;
+        }
+
+        for ( ExecutableElement candidate : ElementFilter.methodsIn( superTypeElement.getEnclosedElements() ) ) {
+            if ( elementUtils.overrides( method, candidate, mapperToImplement ) ) {
+                overriddenMethods.add( candidate );
+            }
+        }
+
+        for ( TypeMirror inheritedSuperType : typeUtils.directSupertypes( superType ) ) {
+            collectOverriddenMethods(
+                method,
+                inheritedSuperType,
+                mapperToImplement,
+                visitedTypes,
+                overriddenMethods
+            );
+        }
