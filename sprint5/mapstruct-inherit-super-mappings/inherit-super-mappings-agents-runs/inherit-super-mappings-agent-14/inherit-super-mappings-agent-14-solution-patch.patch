+
+@Mapper(config = SuperMappingsConfig.class)
+public interface SuperMappingsMapper extends GenericMidMapper<Source>, PairBaseMapper, PropertyBaseMapper,
+    EmptyBaseMapper, LeftFlattenMapper, RightFlattenMapper, BranchLeftMapper, BranchRightMapper,
+    NoInheritanceBaseMapper {
+
+    SuperMappingsMapper INSTANCE = Mappers.getMapper( SuperMappingsMapper.class );
+
+    @Override
+    @BeanMapping(inheritSuperMappings = true)
+    @InheritConfiguration(name = "configure")
+    @Mapping(target = "current", source = "currentName")
+    Target map(Source renamed);
+
+    @Override
+    @BeanMapping(inheritSuperMappings = true)
+    PairTarget mapPair(Source first, Source second);
+
+    @Override
+    @BeanMapping(inheritSuperMappings = true)
+    PairTarget mapBranches(Source renamed);
