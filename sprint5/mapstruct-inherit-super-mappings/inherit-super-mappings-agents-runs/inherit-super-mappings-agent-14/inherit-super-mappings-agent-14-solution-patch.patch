+    @BeanMapping(inheritSuperMappings = true)
+    PropertyTarget mapProperty(Source renamed);
+
+    @Override
+    @BeanMapping(inheritSuperMappings = true)
+    EmptyTarget mapEmpty(Source renamed);
+
+    @Override
+    @BeanMapping(unmappedTargetPolicy = ReportingPolicy.IGNORE)
