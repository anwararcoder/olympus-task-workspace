+            if ( inheritedMapping.declaringType.equals( candidate.declaringType )
+                || typeUtils.isSubtypeErased(
+                    inheritedMapping.declaringType.getTypeMirror(),
+                    candidate.declaringType.getTypeMirror()
+                ) ) {
