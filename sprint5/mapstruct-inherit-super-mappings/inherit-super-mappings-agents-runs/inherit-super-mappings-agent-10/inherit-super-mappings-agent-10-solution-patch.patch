+/*
+ * Copyright MapStruct Authors.
+ *
+ * Licensed under the Apache License version 2.0, available at http://www.apache.org/licenses/LICENSE-2.0
+ */
+package org.mapstruct.ap.test.inheritsupermappings;
+
+import javax.tools.Diagnostic.Kind;
+
+import org.mapstruct.ap.testutil.ProcessorTest;
+import org.mapstruct.ap.testutil.WithClasses;
+import org.mapstruct.ap.testutil.compilation.annotation.CompilationResult;
+import org.mapstruct.ap.testutil.compilation.annotation.Diagnostic;
+import org.mapstruct.ap.testutil.compilation.annotation.ExpectedCompilationOutcome;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+public class InheritedSuperMappingsTest {
+
+    @ProcessorTest
+    @WithClasses({ InheritedSuperMappingsMapper.class, MappingSource.class, MappingTarget.class })
+    public void shouldInheritMappingsFromOverriddenMethods() {
+        MappingSource source = source( "source", "alternate", "automatic", "property" );
+
+        MappingTarget basic = InheritedSuperMappingsMapper.INSTANCE.mapBasic( source );
+        assertThat( basic.getPrimary() ).isEqualTo( "alternate" );
+        assertThat( basic.getSecondary() ).isEqualTo( "source" );
+        assertThat( basic.getAutomatic() ).isEqualTo( "automatic" );
+
+        MappingTarget generic = InheritedSuperMappingsMapper.INSTANCE.mapGeneric( source );
+        assertThat( generic.getPrimary() ).isEqualTo( "alternate" );
+        assertThat( generic.getSecondary() ).isEqualTo( "source" );
+
+        MappingSource second = source( "second", "secondAlternate", "secondAutomatic", "secondProperty" );
+        MappingTarget parameters = InheritedSuperMappingsMapper.INSTANCE.mapParameters( source, second );
+        assertThat( parameters.getWhole() ).isSameAs( source );
+        assertThat( parameters.getSecondary() ).isEqualTo( "second" );
+
+        MappingTarget property = InheritedSuperMappingsMapper.INSTANCE.mapProperty( source );
+        assertThat( property.getPrimary() ).isEqualTo( "property" );
+
+        MappingTarget empty = InheritedSuperMappingsMapper.INSTANCE.mapEmpty( source );
+        assertThat( empty.getAutomatic() ).isEqualTo( "automatic" );
+
+        MappingTarget disabled = InheritedSuperMappingsMapper.INSTANCE.mapDisabled( source );
+        assertThat( disabled.getPrimary() ).isNull();
+    }
+
+    @ProcessorTest
+    @WithClasses(FlatteningMapper.class)
+    public void shouldAccumulateFlatteningMappingsAndVisitSharedAncestorOnce() {
+        LeftSource left = new LeftSource();
+        left.setLeftValue( "left" );
+        left.setShared( "shared" );
+        RightSource right = new RightSource();
+        right.setRightValue( "right" );
+        CurrentSource current = new CurrentSource();
+        current.setCurrentValue( "current" );
+
+        FlattenedTarget target = FlatteningMapper.INSTANCE.flatten( left, right, current );
+
+        assertThat( target.getLeftValue() ).isEqualTo( "left" );
+        assertThat( target.getRightValue() ).isEqualTo( "right" );
+        assertThat( target.getCurrentValue() ).isEqualTo( "current" );
+        assertThat( target.getShared() ).isEqualTo( "shared" );
+    }
+
+    @ProcessorTest
+    @WithClasses({ ConflictingSuperMappingsMapper.class, MappingSource.class, MappingTarget.class })
+    @ExpectedCompilationOutcome(
+        value = CompilationResult.FAILED,
+        diagnostics = @Diagnostic(
+            type = ConflictingSuperMappingsMapper.class,
+            kind = Kind.ERROR,
+            line = 17,
+            message = "Inherited mappings for target \"primary\" are declared in unrelated mapper types: "
+                + "org.mapstruct.ap.test.inheritsupermappings.ConflictingLeft, "
+                + "org.mapstruct.ap.test.inheritsupermappings.ConflictingRight."
+        )
+    )
+    public void shouldReportConflictingMappingsFromIncomparableBranches() {
+    }
+
+    @ProcessorTest
+    @WithClasses({ NoSuperMappingsMapper.class, MappingSource.class, MappingTarget.class })
+    @ExpectedCompilationOutcome(
+        value = CompilationResult.FAILED,
+        diagnostics = @Diagnostic(
+            type = NoSuperMappingsMapper.class,
+            kind = Kind.ERROR,
+            line = 15,
+            message = "@BeanMapping(inheritSuperMappings = true) can only be used on a method that overrides a "
+                + "mapping method."
+        )
+    )
+    public void shouldReportMissingOverriddenMappingMethod() {
+    }
+
+    private MappingSource source(String sourceName, String alternate, String automatic, String property) {
+        MappingSource source = new MappingSource();
+        source.setSourceName( sourceName );
+        source.setAlternate( alternate );
+        source.setAutomatic( automatic );
+        source.setSource( property );
+        return source;
+    }
+}
