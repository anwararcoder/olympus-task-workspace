+    @BeanMapping(inheritSuperMappings = true)
+    MappingTarget mapProperty(MappingSource renamed);
+
+    @Override
+    @BeanMapping(inheritSuperMappings = true)
+    MappingTarget mapEmpty(MappingSource source);
+
+    @Override
+    MappingTarget mapDisabled(MappingSource source);
+}
+
+interface BasicParent {
+
+    @BeanMapping(ignoreByDefault = true)
+    @InheritedNames
+    MappingTarget mapBasic(MappingSource source);
+}
+
+@Retention(RetentionPolicy.CLASS)
+@Mapping(target = "primary", source = "sourceName")
+@Mapping(target = "secondary", source = "sourceName")
+@interface InheritedNames {
+}
+
+interface GenericGrandParent<T extends MappingSource> {
+
+    @Mapping(target = "primary", source = "original.sourceName")
+    @Mapping(target = "secondary", source = "original.sourceName")
+    MappingTarget mapGeneric(T original);
+}
+
+interface GenericMid<T extends MappingSource> extends GenericGrandParent<T> {
+
+    @Override
+    @Mapping(target = "primary", source = "middle.alternate")
+    MappingTarget mapGeneric(T middle);
+}
+
+interface ParameterParent {
+
+    @Mapping(target = "whole", source = "first")
+    @Mapping(target = "secondary", source = "second.sourceName")
+    MappingTarget mapParameters(MappingSource first, MappingSource second);
+}
+
+interface PropertyParent {
+
+    @Mapping(target = "primary", source = "source")
+    MappingTarget mapProperty(MappingSource source);
+}
+
+interface EmptyParent {
+
+    MappingTarget mapEmpty(MappingSource source);
+}
+
+interface DisabledParent {
+
+    @Mapping(target = "primary", source = "alternate")
+    MappingTarget mapDisabled(MappingSource source);
+}
