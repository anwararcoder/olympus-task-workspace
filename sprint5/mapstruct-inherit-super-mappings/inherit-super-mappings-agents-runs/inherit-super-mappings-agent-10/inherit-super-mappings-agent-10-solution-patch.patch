+    private void inheritSuperMappings(SourceMethod sourceMethod, TypeElement mapperToImplement,
+                                      MapperOptions mapperOptions) {
+        BeanMappingOptions beanMapping = sourceMethod.getOptions().getBeanMapping();
+        if ( !beanMapping.inheritSuperMappings() ) {
+            return;
+        }
+
+        List<ExecutableElement> overriddenMethods = new ArrayList<>();
+        collectOverriddenMethods(
+            mapperToImplement,
+            sourceMethod.getExecutable(),
+            mapperToImplement,
+            new HashSet<>(),
+            overriddenMethods
+        );
+
+        if ( overriddenMethods.isEmpty() ) {
+            messager.printMessage(
+                sourceMethod.getExecutable(),
+                Message.INHERIT_SUPER_MAPPINGS_NO_SUPER_METHOD
+            );
+            return;
+        }
+
+        List<SuperMappingMethod> superMappingMethods = new ArrayList<>( overriddenMethods.size() );
+        DeclaredType mapperType = (DeclaredType) mapperToImplement.asType();
+        for ( ExecutableElement overriddenMethod : overriddenMethods ) {
+            ExecutableType methodType = typeFactory.getMethodType( mapperType, overriddenMethod );
+            List<Parameter> parameters = typeFactory.getParameters( methodType, overriddenMethod );
+            BeanMappingOptions superBeanMapping = BeanMappingOptions.getInstanceOn(
+                BeanMappingGem.instanceOn( overriddenMethod ),
+                mapperOptions,
+                overriddenMethod,
+                messager,
+                typeUtils,
+                typeFactory
+            );
+            Set<MappingOptions> mappings = getMappings( overriddenMethod, superBeanMapping );
+            SourceMethod templateMethod = new SourceMethod.Builder()
+                .setExecutable( overriddenMethod )
+                .setParameters( parameters )
+                .setReturnType( typeFactory.getReturnType( methodType ) )
+                .setExceptionTypes( typeFactory.getThrownTypes( methodType ) )
+                .setMapper( mapperOptions )
+                .setBeanMappingOptions( superBeanMapping )
+                .setMappingOptions( mappings )
+                .setTypeUtils( typeUtils )
+                .setTypeFactory( typeFactory )
+                .setDefiningType( typeFactory.getType( mapperToImplement ) )
+                .build();
+            superMappingMethods.add( new SuperMappingMethod( overriddenMethod, templateMethod, mappings ) );
+        }
+
+        addInheritedSuperMappings( sourceMethod, superMappingMethods, mapperToImplement );
+    }
+
+    private void collectOverriddenMethods(TypeElement type, ExecutableElement overridingMethod,
+                                          TypeElement mapperToImplement, Set<String> visitedTypes,
+                                          List<ExecutableElement> overriddenMethods) {
+        if ( !visitedTypes.add( type.getQualifiedName().toString() ) ) {
+            return;
+        }
+
+        if ( !type.equals( mapperToImplement ) ) {
+            for ( Element enclosedElement : type.getEnclosedElements() ) {
+                if ( enclosedElement.getKind() == javax.lang.model.element.ElementKind.METHOD ) {
+                    ExecutableElement candidate = (ExecutableElement) enclosedElement;
+                    if ( elementUtils.overrides( overridingMethod, candidate, mapperToImplement ) ) {
+                        overriddenMethods.add( candidate );
+                    }
+                }
+            }
+        }
+
+        TypeMirror superclass = type.getSuperclass();
+        if ( superclass.getKind() == TypeKind.DECLARED ) {
+            TypeElement superclassElement = asTypeElement( (DeclaredType) superclass );
+            if ( !superclassElement.getQualifiedName().contentEquals( "java.lang.Object" ) ) {
+                collectOverriddenMethods(
+                    superclassElement,
+                    overridingMethod,
+                    mapperToImplement,
+                    visitedTypes,
+                    overriddenMethods
+                );
+            }
+        }
+        for ( TypeMirror interfaceType : type.getInterfaces() ) {
+            collectOverriddenMethods(
+                asTypeElement( (DeclaredType) interfaceType ),
+                overridingMethod,
+                mapperToImplement,
+                visitedTypes,
+                overriddenMethods
+            );
+        }
+    }
+
+    private void addInheritedSuperMappings(SourceMethod sourceMethod, List<SuperMappingMethod> superMappingMethods,
+                                           TypeElement mapperToImplement) {
+        Set<MappingOptions> currentMappings = sourceMethod.getOptions().getMappings();
+        Set<String> currentTargets = new HashSet<>();
+        for ( MappingOptions currentMapping : currentMappings ) {
+            if ( !".".equals( currentMapping.getTargetName() ) ) {
+                currentTargets.add( currentMapping.getTargetName() );
+            }
+        }
+
+        Map<String, List<SuperMappingMethod>> methodsByTarget = new LinkedHashMap<>();
+        List<InheritedSuperMapping> flatteningMappings = new ArrayList<>();
+        for ( SuperMappingMethod superMappingMethod : superMappingMethods ) {
+            for ( MappingOptions mapping : superMappingMethod.mappings ) {
+                if ( ".".equals( mapping.getTargetName() ) ) {
+                    flatteningMappings.add( new InheritedSuperMapping( superMappingMethod, mapping ) );
+                }
+                else if ( !currentTargets.contains( mapping.getTargetName() ) ) {
+                    methodsByTarget.computeIfAbsent( mapping.getTargetName(), key -> new ArrayList<>() )
+                        .add( superMappingMethod );
+                }
+            }
+        }
+
+        for ( InheritedSuperMapping flatteningMapping : flatteningMappings ) {
+            currentMappings.add( flatteningMapping.mapping.copyForSuperInheritance(
+                flatteningMapping.method.templateMethod,
+                sourceMethod.getOptions().getBeanMapping()
+            ) );
+        }
+
+        for ( Map.Entry<String, List<SuperMappingMethod>> entry : methodsByTarget.entrySet() ) {
+            List<SuperMappingMethod> mostSpecificMethods = mostSpecificMethods( entry.getValue() );
+            if ( mostSpecificMethods.size() > 1 ) {
+                Set<String> declaringTypes = new LinkedHashSet<>();
+                for ( SuperMappingMethod method : mostSpecificMethods ) {
+                    declaringTypes.add( method.declaringType() );
+                }
+                messager.printMessage(
+                    sourceMethod.getExecutable(),
+                    Message.INHERIT_SUPER_MAPPINGS_CONFLICT,
+                    entry.getKey(),
+                    String.join( ", ", declaringTypes )
+                );
+                continue;
+            }
+
+            SuperMappingMethod inheritedMethod = mostSpecificMethods.get( 0 );
+            for ( MappingOptions mapping : inheritedMethod.mappings ) {
+                if ( entry.getKey().equals( mapping.getTargetName() ) ) {
+                    currentMappings.add( mapping.copyForSuperInheritance(
+                        inheritedMethod.templateMethod,
+                        sourceMethod.getOptions().getBeanMapping()
+                    ) );
+                }
+            }
+        }
+    }
+
+    private List<SuperMappingMethod> mostSpecificMethods(List<SuperMappingMethod> methods) {
+        List<SuperMappingMethod> mostSpecific = new ArrayList<>();
+        for ( SuperMappingMethod candidate : methods ) {
+            boolean overriddenByAnother = false;
+            for ( SuperMappingMethod other : methods ) {
+                if ( candidate != other
+                    && isMoreSpecific( other, candidate ) ) {
+                    overriddenByAnother = true;
+                    break;
+                }
+            }
+            if ( !overriddenByAnother ) {
+                mostSpecific.add( candidate );
+            }
+        }
+        return mostSpecific;
+    }
+
+    private boolean isMoreSpecific(SuperMappingMethod candidate, SuperMappingMethod other) {
+        TypeElement candidateType = (TypeElement) candidate.executable.getEnclosingElement();
+        TypeElement otherType = (TypeElement) other.executable.getEnclosingElement();
+        return hasSuperType( candidateType, otherType, new HashSet<>() );
+    }
+
+    private boolean hasSuperType(TypeElement candidate, TypeElement expectedSuperType, Set<String> visitedTypes) {
+        if ( !visitedTypes.add( candidate.getQualifiedName().toString() ) ) {
+            return false;
+        }
+        if ( candidate.getQualifiedName().contentEquals( expectedSuperType.getQualifiedName() ) ) {
+            return true;
+        }
+
+        TypeMirror superclass = candidate.getSuperclass();
+        if ( superclass.getKind() == TypeKind.DECLARED
+            && hasSuperType( asTypeElement( (DeclaredType) superclass ), expectedSuperType, visitedTypes ) ) {
+            return true;
+        }
+        for ( TypeMirror interfaceType : candidate.getInterfaces() ) {
+            if ( hasSuperType(
+                asTypeElement( (DeclaredType) interfaceType ),
+                expectedSuperType,
+                visitedTypes
+            ) ) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private static class SuperMappingMethod {
+        private final ExecutableElement executable;
+        private final SourceMethod templateMethod;
+        private final Set<MappingOptions> mappings;
+
+        private SuperMappingMethod(ExecutableElement executable, SourceMethod templateMethod,
+                                   Set<MappingOptions> mappings) {
+            this.executable = executable;
+            this.templateMethod = templateMethod;
+            this.mappings = mappings;
+        }
+
+        private String declaringType() {
+            return ( (TypeElement) executable.getEnclosingElement() ).getQualifiedName().toString();
+        }
+    }
+
+    private static class InheritedSuperMapping {
+        private final SuperMappingMethod method;
+        private final MappingOptions mapping;
+
+        private InheritedSuperMapping(SuperMappingMethod method, MappingOptions mapping) {
+            this.method = method;
+            this.mapping = mapping;
+        }
     }
 
