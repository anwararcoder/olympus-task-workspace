+    private void inheritSuperMappings(Set<MappingOptions> mappings, BeanMappingOptions beanMappingOptions,
+                                      ExecutableElement method, MapperOptions mapperOptions,
+                                      TypeElement mapperToImplement) {
+        List<ExecutableElement> overriddenMethods = new ArrayList<>();
+        collectOverriddenMethods(
+            mapperToImplement,
+            mapperToImplement,
+            method,
+            new HashSet<>(),
+            overriddenMethods
+        );
+
+        if ( overriddenMethods.isEmpty() ) {
+            messager.printMessage(
+                method,
+                beanMappingOptions.getMirror(),
+                Message.BEANMAPPING_INHERIT_SUPER_MAPPINGS_NO_OVERRIDE
+            );
+            return;
+        }
+
+        Set<String> currentTargets = new HashSet<>();
+        for ( MappingOptions mapping : mappings ) {
+            if ( !".".equals( mapping.getTargetName() ) ) {
+                currentTargets.add( mapping.getTargetName() );
+            }
+        }
+
+        Map<String, InheritedMapping> inheritedMappings = new LinkedHashMap<>();
+        List<InheritedMapping> flattenedMappings = new ArrayList<>();
+        DeclaredType mapperType = (DeclaredType) mapperToImplement.asType();
+
+        for ( ExecutableElement overriddenMethod : overriddenMethods ) {
+            ExecutableType overriddenMethodType = typeFactory.getMethodType( mapperType, overriddenMethod );
+            List<Parameter> overriddenParameters = typeFactory.getParameters( overriddenMethodType, overriddenMethod );
+            SourceMethod overriddenSourceMethod = new SourceMethod.Builder()
+                .setExecutable( overriddenMethod )
+                .setParameters( overriddenParameters )
+                .setReturnType( typeFactory.getReturnType( overriddenMethodType ) )
+                .setTypeUtils( typeUtils )
+                .setTypeFactory( typeFactory )
+                .build();
+            BeanMappingOptions overriddenBeanMapping = BeanMappingOptions.getInstanceOn(
+                BeanMappingGem.instanceOn( overriddenMethod ),
+                mapperOptions,
+                overriddenMethod,
+                messager,
+                typeUtils,
+                typeFactory
+            );
+
+            for ( MappingOptions mapping : getMappings( overriddenMethod, overriddenBeanMapping ) ) {
+                InheritedMapping inheritedMapping = new InheritedMapping(
+                    mapping,
+                    overriddenMethod,
+                    overriddenSourceMethod
+                );
+                String target = mapping.getTargetName();
+                if ( ".".equals( target ) ) {
+                    flattenedMappings.add( inheritedMapping );
+                }
+                else if ( !currentTargets.contains( target ) ) {
+                    mergeInheritedMapping( inheritedMappings, inheritedMapping, method );
+                }
+            }
+        }
+
+        for ( InheritedMapping inheritedMapping : inheritedMappings.values() ) {
+            mappings.add( copyInheritedMapping( inheritedMapping, beanMappingOptions ) );
+        }
+        for ( InheritedMapping inheritedMapping : flattenedMappings ) {
+            mappings.add( copyInheritedMapping( inheritedMapping, beanMappingOptions ) );
+        }
+    }
+
+    private void collectOverriddenMethods(TypeElement type, TypeElement mapperToImplement, ExecutableElement method,
+                                          Set<String> visitedTypes, List<ExecutableElement> overriddenMethods) {
+        for ( TypeMirror superType : typeUtils.directSupertypes( type.asType() ) ) {
+            TypeElement superTypeElement = asTypeElement( (DeclaredType) superType );
+            String superTypeName = superTypeElement.getQualifiedName().toString();
+            if ( !visitedTypes.add( superTypeName ) ) {
+                continue;
+            }
+
+            for ( ExecutableElement candidate : ElementFilter.methodsIn( superTypeElement.getEnclosedElements() ) ) {
+                if ( candidate.getModifiers().contains( Modifier.ABSTRACT )
+                    && elementUtils.overrides( method, candidate, mapperToImplement ) ) {
+                    overriddenMethods.add( candidate );
+                }
+            }
+            collectOverriddenMethods(
+                superTypeElement,
+                mapperToImplement,
+                method,
+                visitedTypes,
+                overriddenMethods
+            );
+        }
+    }
+
+    private void mergeInheritedMapping(Map<String, InheritedMapping> inheritedMappings,
+                                       InheritedMapping candidate, ExecutableElement method) {
+        String target = candidate.mapping.getTargetName();
+        InheritedMapping existing = inheritedMappings.get( target );
+        if ( existing == null ) {
+            inheritedMappings.put( target, candidate );
+        }
+        else if ( isDeclaredInSubtype( candidate.method, existing.method ) ) {
+            inheritedMappings.put( target, candidate );
+        }
+        else if ( !isDeclaredInSubtype( existing.method, candidate.method ) ) {
+            messager.printMessage(
+                method,
+                Message.BEANMAPPING_INHERIT_SUPER_MAPPINGS_CONFLICT,
+                target,
+                existing.method.getEnclosingElement(),
+                candidate.method.getEnclosingElement()
+            );
+        }
+    }
+
+    private MappingOptions copyInheritedMapping(InheritedMapping inheritedMapping,
+                                                BeanMappingOptions beanMappingOptions) {
+        int sourceParameterPosition = resolveSourceParameterPosition(
+            inheritedMapping.mapping,
+            inheritedMapping.sourceMethod
+        );
+        return inheritedMapping.mapping.copyForSuperInheritance(
+            inheritedMapping.sourceMethod,
+            beanMappingOptions,
+            sourceParameterPosition
+        );
+    }
+
+    private boolean isDeclaredInSubtype(ExecutableElement subtypeMethod, ExecutableElement supertypeMethod) {
+        return typeUtils.isSubtype(
+            subtypeMethod.getEnclosingElement().asType(),
+            supertypeMethod.getEnclosingElement().asType()
+        );
+    }
+
+    private int resolveSourceParameterPosition(MappingOptions mapping, SourceMethod overriddenMethod) {
+        if ( mapping.getSourceName() == null ) {
+            return -1;
+        }
+
+        SourceReference sourceReference = new SourceReference.BuilderFromMapping()
+            .mapping( mapping )
+            .method( overriddenMethod )
+            .messager( messager )
+            .typeFactory( typeFactory )
+            .build();
+        if ( sourceReference == null || !sourceReference.isValid() || sourceReference.getParameter() == null ) {
+            return -1;
+        }
+
+        String[] segments = mapping.getSourceName().trim().split( "\\." );
+        if ( !segments[0].equals( sourceReference.getParameter().getName() )
+            || sourceReference.getPropertyEntries().size() != segments.length - 1 ) {
+            return -1;
+        }
+
+        List<Parameter> parameters = overriddenMethod.getParameters();
+        for ( int i = 0; i < parameters.size(); i++ ) {
+            if ( parameters.get( i ) == sourceReference.getParameter() ) {
+                return i;
+            }
+        }
+        return -1;
+    }
+
+    private static class InheritedMapping {
+        private final MappingOptions mapping;
+        private final ExecutableElement method;
+        private final SourceMethod sourceMethod;
+
+        private InheritedMapping(MappingOptions mapping, ExecutableElement method, SourceMethod sourceMethod) {
+            this.mapping = mapping;
+            this.method = method;
+            this.sourceMethod = sourceMethod;
+        }
+    }
