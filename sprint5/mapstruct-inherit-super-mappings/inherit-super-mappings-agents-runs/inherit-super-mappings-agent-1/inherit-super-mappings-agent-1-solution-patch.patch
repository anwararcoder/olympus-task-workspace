+    TargetBean map(Source left, Source right, FlattenSource details, AutomaticSource automatic);
+}
+
+interface MiddleMapping<T extends Source> extends BaseMapping<T> {
+
+    @Override
+    @Mapping(target = "baseValue", source = "second.value")
+    @Mapping(target = "middleValue", source = "first.value")
+    TargetBean map(T first, T second, FlattenSource flattened, AutomaticSource automatic);
+}
+
+interface BaseMapping<T extends Source> {
+
+    @BeanMapping(ignoreByDefault = true)
+    @ComposedMapping
+    @Mapping(target = ".", source = "flattened")
+    @Mapping(target = "baseValue", source = "first.value")
+    @Mapping(target = "expressionValue", expression = "java(\"expression\")")
+    TargetBean map(T first, T second, FlattenSource flattened, AutomaticSource automatic);
+}
+
+@Target(ElementType.METHOD)
+@Retention(RetentionPolicy.CLASS)
+@Mapping(target = "composedValue", source = "second.value")
