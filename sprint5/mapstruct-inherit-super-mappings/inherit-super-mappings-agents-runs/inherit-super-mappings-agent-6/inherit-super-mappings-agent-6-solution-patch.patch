@@ -0,0 +1,98 @@
+/*
+ * Copyright MapStruct Authors.
+ *
+ * Licensed under the Apache License version 2.0, available at http://www.apache.org/licenses/LICENSE-2.0
+ */
+package org.mapstruct.ap.test.supermappings;
+
+import java.util.Collections;
+import java.util.Map;
+
+import org.mapstruct.ap.testutil.ProcessorTest;
+import org.mapstruct.ap.testutil.WithClasses;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+@WithClasses({ Source.class, Target.class, RootMapper.class, LeftMapper.class, RightMapping.class, RightMapper.class,
+    SuperMappingsMapper.class, PropertyNamedLikeParameterParentMapper.class,
+    PropertyNamedLikeParameterMapper.class, GenericRootMapper.class, GenericMiddleMapper.class,
+    GenericSuperMappingsMapper.class, FlattenTypes.class, FlattenParentMapper.class, FlattenMapper.class,
+    MapParameterParentMapper.class, MapParameterMapper.class })
+public class InheritedSuperMappingsTest {
+
+    @ProcessorTest
+    public void shouldInheritMappingsFromOverriddenMethods() {
+        Source first = source( "first", "automatic", "first property", "first nested" );
+        Source second = source( "second", "other", "second property", "second nested" );
+
+        Target target = SuperMappingsMapper.INSTANCE.map( first, second );
+
+        assertThat( target.getRoot() ).isEqualTo( "second" );
+        assertThat( target.getLeft() ).isNull();
+        assertThat( target.getRight() ).isEqualTo( "second" );
+        assertThat( target.getCurrent() ).isEqualTo( "first" );
+        assertThat( target.getAutomatic() ).isEqualTo( "automatic" );
+        assertThat( target.getNestedName() ).isEqualTo( "second nested" );
+        assertThat( target.getWhole() ).isSameAs( first );
+    }
+
+    @ProcessorTest
+    public void shouldKeepLoneSourcePropertyMeaning() {
+        Target target = PropertyNamedLikeParameterMapper.INSTANCE.map(
+            source( "name", "automatic", "property value", "nested" )
+        );
+
+        assertThat( target.getRoot() ).isEqualTo( "property value" );
+        assertThat( target.getAutomatic() ).isEqualTo( "automatic" );
+    }
+
+    @ProcessorTest
+    public void shouldResolveGenericTransitiveSupertype() {
+        Target target = GenericSuperMappingsMapper.INSTANCE.map(
+            source( "generic", "automatic", "property", "nested" )
+        );
+
+        assertThat( target.getRoot() ).isEqualTo( "generic" );
+    }
+
+    @ProcessorTest
+    public void shouldAccumulateFlatteningMappings() {
+        FlattenTypes.Source source = new FlattenTypes.Source();
+        FlattenTypes.First first = new FlattenTypes.First();
+        first.setFirstValue( "first" );
+        source.setFirst( first );
+        FlattenTypes.Second second = new FlattenTypes.Second();
+        second.setSecondValue( "second" );
+        source.setSecond( second );
+
+        FlattenTypes.Target target = FlattenMapper.INSTANCE.map( source );
+
+        assertThat( target.getFirstValue() ).isEqualTo( "first" );
+        assertThat( target.getSecondValue() ).isEqualTo( "second" );
+    }
+
+    @ProcessorTest
+    public void shouldKeepWholeRenamedMapParameterMeaning() {
+        Map<String, Source> source = Collections.singletonMap(
+            "source",
+            source( "name", "automatic", "property", "nested" )
+        );
+
+        Target target = MapParameterMapper.INSTANCE.map( source );
+
+        assertThat( target.getSourceMap() ).containsExactlyEntriesOf( source );
+    }
+
+    private static Source source(String name, String automatic, String propertyName, String nestedName) {
+        Source source = new Source();
+        source.setName( name );
+        source.setAutomatic( automatic );
+        Source.Nested property = new Source.Nested();
+        property.setNestedName( propertyName );
+        source.setSource( property );
+        Source.Nested details = new Source.Nested();
+        details.setNestedName( nestedName );
+        source.setDetails( details );
+        return source;
+    }
+}
