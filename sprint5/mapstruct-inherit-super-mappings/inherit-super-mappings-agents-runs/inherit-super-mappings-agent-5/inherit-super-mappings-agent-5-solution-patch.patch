+/*
+ * Copyright MapStruct Authors.
+ *
+ * Licensed under the Apache License version 2.0, available at http://www.apache.org/licenses/LICENSE-2.0
+ */
+package org.mapstruct.ap.test.inheritsupermappings;
+
+import java.lang.annotation.Retention;
+import java.lang.annotation.RetentionPolicy;
+
+import org.mapstruct.BeanMapping;
+import org.mapstruct.Mapper;
+import org.mapstruct.Mapping;
+import org.mapstruct.ReportingPolicy;
+import org.mapstruct.factory.Mappers;
+
+@Mapper(unmappedTargetPolicy = ReportingPolicy.IGNORE)
+public interface InheritedSuperMapper extends MostSpecificMappings<Source, Target>, GammaMappings, SelectMappings {
+
+    InheritedSuperMapper INSTANCE = Mappers.getMapper( InheritedSuperMapper.class );
+
+    @Override
+    @BeanMapping(inheritSuperMappings = true)
+    @Mapping(target = "beta", source = "renamedSecond.value")
+    Target map(Source renamedFirst, Source renamedSecond);
+
+    @Override
+    @BeanMapping(inheritSuperMappings = true)
+    Target property(Source renamed);
+
+    @Override
+    @BeanMapping(inheritSuperMappings = true, ignoreByDefault = true)
+    Target select(Source renamedFirst, Source renamedSecond);
+}
+
+interface RootMappings<S, T> {
+
+    @Mapping(target = "alpha", source = "first.value")
+    T map(S first, S second);
+
+    @Mapping(target = "alpha", source = "value")
+    T property(S value);
+}
+
+interface MostSpecificMappings<S, T> extends RootMappings<S, T>, BetaMappings {
+
+    @Override
+    @ComposedBeta
+    @Mapping(target = "alpha", source = "second.value")
+    T map(S first, S second);
+}
+
+interface BetaMappings {
+
+    @Mapping(target = "beta", source = "first.value")
+    Target map(Source first, Source second);
+}
+
+interface GammaMappings {
+
+    @Mapping(target = "gamma", source = "first.value")
+    Target map(Source first, Source second);
+}
+
+interface SelectMappings {
+
+    @Mapping(target = "selected", source = "second")
+    Target select(Source first, Source second);
+}
+
+@Mapping(target = "beta", source = "first.value")
+@Retention(RetentionPolicy.CLASS)
+@interface ComposedBeta {
+}
