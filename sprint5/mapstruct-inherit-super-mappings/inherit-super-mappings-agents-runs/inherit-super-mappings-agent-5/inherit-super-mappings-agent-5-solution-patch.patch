+/*
+ * Copyright MapStruct Authors.
+ *
+ * Licensed under the Apache License version 2.0, available at http://www.apache.org/licenses/LICENSE-2.0
+ */
+package org.mapstruct.ap.test.inheritsupermappings;
+
+import org.mapstruct.ap.testutil.ProcessorTest;
+import org.mapstruct.ap.testutil.WithClasses;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+@WithClasses({
+    Source.class,
+    Target.class,
+    InheritedSuperMapper.class,
+    FlatteningMapper.class,
+    MethodOptionsMapper.class,
+    SuperclassMapper.class
+})
+public class InheritSuperMappingsTest {
+
+    @ProcessorTest
+    public void shouldInheritMostSpecificAndIncomparableMappings() {
+        Target target = InheritedSuperMapper.INSTANCE.map( new Source( "first" ), new Source( "second" ) );
+
+        assertThat( target.getAlpha() ).isEqualTo( "second" );
+        assertThat( target.getBeta() ).isEqualTo( "second" );
+        assertThat( target.getGamma() ).isEqualTo( "first" );
+    }
+
+    @ProcessorTest
+    public void shouldKeepUnqualifiedPropertyMeaningWhenParameterIsRenamed() {
+        Target target = InheritedSuperMapper.INSTANCE.property( new Source( "property" ) );
+
+        assertThat( target.getAlpha() ).isEqualTo( "property" );
+    }
+
+    @ProcessorTest
+    public void shouldRebindWholeParameterBySignaturePosition() {
+        Source first = new Source( "first" );
+        Source second = new Source( "second" );
+
+        Target target = InheritedSuperMapper.INSTANCE.select( first, second );
+
+        assertThat( target.getSelected() ).isSameAs( second );
+    }
+
+    @ProcessorTest
+    public void shouldAccumulateFlatteningMappings() {
+        FlatteningSource source = new FlatteningSource();
+        Alpha alpha = new Alpha();
+        alpha.setAlpha( "alpha" );
+        source.setFirst( alpha );
+        Beta beta = new Beta();
+        beta.setBeta( "beta" );
+        source.setSecond( beta );
+        Gamma gamma = new Gamma();
+        gamma.setGamma( "gamma" );
+        source.setThird( gamma );
+
+        Target target = FlatteningMapper.INSTANCE.map( source );
+
+        assertThat( target.getAlpha() ).isEqualTo( "alpha" );
+        assertThat( target.getBeta() ).isEqualTo( "beta" );
+        assertThat( target.getGamma() ).isEqualTo( "gamma" );
+    }
+
+    @ProcessorTest
+    public void shouldNotCopyOtherMethodOptions() {
+        Source source = new Source( "alpha" );
+        source.setBeta( "beta" );
+
+        Target target = MethodOptionsMapper.INSTANCE.isolated( source );
+
+        assertThat( target.getAlpha() ).isEqualTo( "alpha" );
+        assertThat( target.getBeta() ).isEqualTo( "beta" );
+    }
+
+    @ProcessorTest
+    public void shouldAcceptOverriddenMethodWithoutPropertyMappings() {
+        Source source = new Source();
+        source.setBeta( "beta" );
+
+        Target target = MethodOptionsMapper.INSTANCE.empty( source );
+
+        assertThat( target.getBeta() ).isEqualTo( "beta" );
+    }
+
+    @ProcessorTest
+    public void shouldRemainDisabledByDefault() {
+        Target target = MethodOptionsMapper.INSTANCE.disabled( new Source( "alpha" ) );
+
+        assertThat( target.getAlpha() ).isNull();
+    }
+
+    @ProcessorTest
+    public void shouldInheritMappingsFromSuperclass() {
+        Target target = SuperclassMapper.INSTANCE.map( new Source( "alpha" ) );
+
+        assertThat( target.getAlpha() ).isEqualTo( "alpha" );
+    }
+}
