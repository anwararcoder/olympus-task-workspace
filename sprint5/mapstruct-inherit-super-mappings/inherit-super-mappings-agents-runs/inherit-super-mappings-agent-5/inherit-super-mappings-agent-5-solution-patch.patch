+import org.mapstruct.ReportingPolicy;
+import org.mapstruct.factory.Mappers;
+
+@Mapper(unmappedTargetPolicy = ReportingPolicy.IGNORE)
+public interface MethodOptionsMapper extends IgnoreByDefaultParent, EmptyMappingsParent, DisabledInheritanceParent {
+
+    MethodOptionsMapper INSTANCE = Mappers.getMapper( MethodOptionsMapper.class );
+
+    @Override
+    @BeanMapping(inheritSuperMappings = true)
+    Target isolated(Source source);
+
+    @Override
+    @BeanMapping(inheritSuperMappings = true)
+    Target empty(Source source);
+
+    @Override
+    Target disabled(Source source);
+}
+
+interface IgnoreByDefaultParent {
+
+    @BeanMapping(ignoreByDefault = true)
+    @Mapping(target = "alpha", source = "value")
+    Target isolated(Source source);
+}
+
+interface EmptyMappingsParent {
+
+    Target empty(Source source);
+}
+
+interface DisabledInheritanceParent {
+
+    @Mapping(target = "alpha", source = "value")
+    Target disabled(Source source);
+}
