+    private void inheritSuperMappings(SourceMethod method, TypeElement mapperToImplement,
+                                      MapperOptions mapperOptions, List<SourceMethod> prototypeMethods) {
+        List<SourceMethod> overriddenMethods = new ArrayList<>();
+        DeclaredType mapperType = (DeclaredType) mapperToImplement.asType();
+
+        for ( ExecutableElement candidate : getAllExecutableElementsIncludingOverridden( mapperToImplement ) ) {
+            if ( candidate.equals( method.getExecutable() )
+                || !elementUtils.overrides( method.getExecutable(), candidate, mapperToImplement ) ) {
+                continue;
+            }
+
+            ExecutableType candidateType = typeFactory.getMethodType( mapperType, candidate );
+            List<Parameter> candidateParameters = typeFactory.getParameters( candidateType, candidate );
+            SourceMethod overriddenMethod = getMethodRequiringImplementation(
+                candidateType,
+                candidate,
+                candidateParameters,
+                SourceMethod.containsTargetTypeParameter( candidateParameters ),
+                mapperOptions,
+                prototypeMethods,
+                mapperToImplement,
+                false
+            );
+            if ( overriddenMethod != null ) {
+                overriddenMethods.add( overriddenMethod );
+            }
+        }
+
+        if ( overriddenMethods.isEmpty() ) {
+            messager.printMessage(
+                method.getExecutable(),
+                method.getOptions().getBeanMapping().getMirror(),
+                Message.BEANMAPPING_INHERIT_SUPER_MAPPINGS_NO_OVERRIDE
+            );
+            return;
+        }
+
+        Set<String> currentTargets = new HashSet<>();
+        for ( MappingOptions mapping : method.getOptions().getMappings() ) {
+            if ( !".".equals( mapping.getTargetName() ) ) {
+                currentTargets.add( mapping.getTargetName() );
+            }
+        }
+
+        Map<String, List<InheritedMapping>> inheritedByTarget = new LinkedHashMap<>();
+        for ( SourceMethod overriddenMethod : overriddenMethods ) {
+            for ( MappingOptions mapping : overriddenMethod.getOptions().getMappings() ) {
+                inheritedByTarget.computeIfAbsent( mapping.getTargetName(), key -> new ArrayList<>() )
+                    .add( new InheritedMapping( overriddenMethod, mapping ) );
+            }
+        }
+
+        for ( Map.Entry<String, List<InheritedMapping>> entry : inheritedByTarget.entrySet() ) {
+            String target = entry.getKey();
+            if ( ".".equals( target ) ) {
+                for ( InheritedMapping inherited : entry.getValue() ) {
+                    addInheritedMapping( method, inherited );
+                }
+                continue;
+            }
+            if ( currentTargets.contains( target ) ) {
+                continue;
+            }
+
+            List<InheritedMapping> mostSpecificMappings = mostSpecificMappings( entry.getValue() );
+            if ( mostSpecificMappings.size() == 1 ) {
+                addInheritedMapping( method, mostSpecificMappings.get( 0 ) );
+            }
+            else if ( mostSpecificMappings.size() > 1 ) {
+                InheritedMapping first = mostSpecificMappings.get( 0 );
+                InheritedMapping second = mostSpecificMappings.get( 1 );
+                messager.printMessage(
+                    method.getExecutable(),
+                    method.getOptions().getBeanMapping().getMirror(),
+                    Message.BEANMAPPING_INHERIT_SUPER_MAPPINGS_CONFLICT,
+                    target,
+                    declaringTypeName( first.method ),
+                    declaringTypeName( second.method )
+                );
+            }
+        }
+    }
+
+    private void addInheritedMapping(SourceMethod method, InheritedMapping inherited) {
+        method.getOptions().getMappings().add(
+            inherited.mapping.copyForSuperInheritance(
+                inherited.method,
+                method.getOptions().getBeanMapping()
+            )
+        );
+    }
+
+    private List<InheritedMapping> mostSpecificMappings(List<InheritedMapping> mappings) {
+        List<InheritedMapping> result = new ArrayList<>();
+        for ( InheritedMapping candidate : mappings ) {
+            boolean overridden = false;
+            for ( InheritedMapping other : mappings ) {
+                if ( candidate != other && isDeclaredInSubtype( other.method, candidate.method ) ) {
+                    overridden = true;
+                    break;
+                }
+            }
+            if ( !overridden ) {
+                result.add( candidate );
+            }
+        }
+        return result;
+    }
+
+    private boolean isDeclaredInSubtype(SourceMethod subtypeMethod, SourceMethod supertypeMethod) {
+        TypeElement subtype = (TypeElement) subtypeMethod.getExecutable().getEnclosingElement();
+        TypeElement supertype = (TypeElement) supertypeMethod.getExecutable().getEnclosingElement();
+        return !subtype.equals( supertype ) && isTypeInHierarchy( subtype, supertype, new HashSet<>() );
+    }
+
+    private boolean isTypeInHierarchy(TypeElement type, TypeElement expectedSupertype, Set<String> visited) {
+        if ( !visited.add( type.getQualifiedName().toString() ) ) {
+            return false;
+        }
+        if ( type.getSuperclass().getKind() != TypeKind.NONE ) {
+            TypeElement superclass = asTypeElement( (DeclaredType) type.getSuperclass() );
+            if ( superclass.equals( expectedSupertype )
+                || isTypeInHierarchy( superclass, expectedSupertype, visited ) ) {
+                return true;
+            }
+        }
+        for ( TypeMirror interfaceType : type.getInterfaces() ) {
+            TypeElement interfaceElement = asTypeElement( (DeclaredType) interfaceType );
+            if ( interfaceElement.equals( expectedSupertype )
+                || isTypeInHierarchy( interfaceElement, expectedSupertype, visited ) ) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private String declaringTypeName(SourceMethod method) {
+        return ( (TypeElement) method.getExecutable().getEnclosingElement() ).getQualifiedName().toString();
+    }
+
+    private List<ExecutableElement> getAllExecutableElementsIncludingOverridden(TypeElement type) {
+        List<ExecutableElement> methods = new ArrayList<>();
+        collectExecutableElements( type, new HashSet<>(), methods );
+        return methods;
+    }
+
+    private void collectExecutableElements(TypeElement type, Set<String> visited,
+                                           List<ExecutableElement> methods) {
+        if ( !visited.add( type.getQualifiedName().toString() ) ) {
+            return;
+        }
+        for ( Element element : type.getEnclosedElements() ) {
+            if ( element.getKind() == ElementKind.METHOD ) {
+                methods.add( (ExecutableElement) element );
+            }
+        }
+        if ( type.getSuperclass().getKind() != TypeKind.NONE ) {
+            collectExecutableElements( asTypeElement( (DeclaredType) type.getSuperclass() ), visited, methods );
+        }
+        for ( TypeMirror interfaceType : type.getInterfaces() ) {
+            collectExecutableElements( asTypeElement( (DeclaredType) interfaceType ), visited, methods );
+        }
+    }
