+    private void inheritSuperMappings(SourceMethod sourceMethod, TypeElement mapperToImplement) {
+        List<ExecutableElement> overriddenMethods = new ArrayList<>();
+        collectOverriddenMethods(
+            sourceMethod.getExecutable(),
+            mapperToImplement,
+            mapperToImplement.asType(),
+            new HashSet<>(),
+            overriddenMethods
+        );
+
+        if ( overriddenMethods.isEmpty() ) {
+            messager.printMessage(
+                sourceMethod.getExecutable(),
+                sourceMethod.getOptions().getBeanMapping().getMirror(),
+                sourceMethod.getOptions().getBeanMapping().getInheritSuperMappingsAnnotationValue(),
+                Message.BEANMAPPING_INHERIT_SUPER_MAPPINGS_NO_OVERRIDE
+            );
+            return;
+        }
+
+        Set<String> declaredTargets = new HashSet<>();
+        for ( MappingOptions mapping : sourceMethod.getOptions().getMappings() ) {
+            if ( !".".equals( mapping.getTargetName() ) ) {
+                declaredTargets.add( mapping.getTargetName() );
+            }
+        }
+
+        Map<String, List<SuperMapping>> mappingsByTarget = new LinkedHashMap<>();
+        List<SuperMapping> flatteningMappings = new ArrayList<>();
+        for ( ExecutableElement overriddenMethod : overriddenMethods ) {
+            SourceMethod templateMethod = superMappingMethod( overriddenMethod, sourceMethod, mapperToImplement );
+            TypeElement declaringType = (TypeElement) overriddenMethod.getEnclosingElement();
+            for ( MappingOptions mapping : templateMethod.getOptions().getMappings() ) {
+                SuperMapping superMapping = new SuperMapping( mapping, templateMethod, declaringType );
+                if ( ".".equals( mapping.getTargetName() ) ) {
+                    flatteningMappings.add( superMapping );
+                }
+                else if ( !declaredTargets.contains( mapping.getTargetName() ) ) {
+                    mappingsByTarget.computeIfAbsent( mapping.getTargetName(), key -> new ArrayList<>() )
+                        .add( superMapping );
+                }
+            }
+        }
+
+        Set<MappingOptions> inheritedMappings = new LinkedHashSet<>();
+        for ( SuperMapping flatteningMapping : flatteningMappings ) {
+            inheritedMappings.add( copySuperMapping( flatteningMapping, sourceMethod ) );
+        }
+
+        for ( Map.Entry<String, List<SuperMapping>> entry : mappingsByTarget.entrySet() ) {
+            List<SuperMapping> mostSpecificMappings = mostSpecificMappings( entry.getValue() );
+            if ( mostSpecificMappings.size() == 1 ) {
+                inheritedMappings.add( copySuperMapping( mostSpecificMappings.get( 0 ), sourceMethod ) );
+            }
+            else {
+                messager.printMessage(
+                    sourceMethod.getExecutable(),
+                    sourceMethod.getOptions().getBeanMapping().getMirror(),
+                    sourceMethod.getOptions().getBeanMapping().getInheritSuperMappingsAnnotationValue(),
+                    Message.BEANMAPPING_INHERIT_SUPER_MAPPINGS_CONFLICT,
+                    entry.getKey(),
+                    Strings.join( mostSpecificMappings, ", ", mapping ->
+                        mapping.declaringType.getQualifiedName().toString() )
+                );
+            }
+        }
+
+        sourceMethod.getOptions().getMappings().addAll( inheritedMappings );
+    }
+
+    private void collectOverriddenMethods(ExecutableElement method, TypeElement mapperToImplement,
+                                          TypeMirror type, Set<String> visitedTypes,
+                                          List<ExecutableElement> overriddenMethods) {
+        for ( TypeMirror superType : typeUtils.directSupertypes( type ) ) {
+            if ( superType.getKind() != TypeKind.DECLARED ) {
+                continue;
+            }
+            TypeElement superElement = (TypeElement) ( (DeclaredType) superType ).asElement();
+            String superTypeName = superElement.getQualifiedName().toString();
+            if ( !visitedTypes.add( superTypeName ) ) {
+                continue;
+            }
+            for ( Element enclosedElement : superElement.getEnclosedElements() ) {
+                if ( enclosedElement instanceof ExecutableElement ) {
+                    ExecutableElement candidate = (ExecutableElement) enclosedElement;
+                    if ( elementUtils.overrides( method, candidate, mapperToImplement ) ) {
+                        overriddenMethods.add( candidate );
+                    }
+                }
+            }
+            collectOverriddenMethods( method, mapperToImplement, superType, visitedTypes, overriddenMethods );
+        }
+    }
+
+    private SourceMethod superMappingMethod(ExecutableElement method, SourceMethod sourceMethod,
+                                            TypeElement mapperToImplement) {
+        ExecutableType methodType = typeFactory.getMethodType( (DeclaredType) mapperToImplement.asType(), method );
+        List<Parameter> parameters = typeFactory.getParameters( methodType, method );
+        Set<MappingOptions> mappings = getMappings( method, sourceMethod.getOptions().getBeanMapping() );
+
+        return new SourceMethod.Builder()
+            .setExecutable( method )
+            .setParameters( parameters )
+            .setReturnType( typeFactory.getReturnType( methodType ) )
+            .setExceptionTypes( typeFactory.getThrownTypes( methodType ) )
+            .setMapper( sourceMethod.getOptions().getMapper() )
+            .setBeanMappingOptions( sourceMethod.getOptions().getBeanMapping() )
+            .setMappingOptions( mappings )
+            .setIterableMappingOptions( sourceMethod.getOptions().getIterableMapping() )
+            .setMapMappingOptions( sourceMethod.getOptions().getMapMapping() )
+            .setValueMappingOptionss( sourceMethod.getOptions().getValueMappings() )
+            .setEnumMappingOptions( sourceMethod.getOptions().getEnumMappingOptions() )
+            .setSubclassMappings( Collections.emptySet() )
+            .setSubclassValidator( new SubclassValidator( messager, typeUtils ) )
+            .setTypeUtils( typeUtils )
+            .setTypeFactory( typeFactory )
+            .setContextProvidedMethods( sourceMethod.getContextProvidedMethods() )
+            .setDefiningType( sourceMethod.getDefiningType() )
+            .setVerboseLogging( options.isVerbose() )
+            .build();
+    }
+
+    private List<SuperMapping> mostSpecificMappings(List<SuperMapping> mappings) {
+        List<SuperMapping> result = new ArrayList<>();
+        for ( SuperMapping candidate : mappings ) {
+            boolean overridden = false;
+            for ( SuperMapping other : mappings ) {
+                if ( candidate != other && isStrictSubtype( other.declaringType, candidate.declaringType ) ) {
+                    overridden = true;
+                    break;
+                }
+            }
+            if ( !overridden ) {
+                result.add( candidate );
+            }
+        }
+        return result;
+    }
+
+    private boolean isStrictSubtype(TypeElement subtype, TypeElement supertype) {
+        return !subtype.equals( supertype ) && typeUtils.isSubtype( subtype.asType(), supertype.asType() );
+    }
+
+    private MappingOptions copySuperMapping(SuperMapping superMapping, SourceMethod sourceMethod) {
+        String inheritedSourceName = rebindSourceName( superMapping, sourceMethod );
+        return superMapping.mapping.copyForSuperInheritance(
+            superMapping.templateMethod,
+            sourceMethod.getOptions().getBeanMapping(),
+            inheritedSourceName
+        );
+    }
+
+    private String rebindSourceName(SuperMapping superMapping, SourceMethod sourceMethod) {
+        String sourceName = superMapping.mapping.getSourceName();
+        if ( sourceName == null || sourceName.isEmpty() ) {
+            return sourceName;
+        }
+
+        SourceReference sourceReference = new SourceReference.BuilderFromMapping()
+            .mapping( superMapping.mapping )
+            .method( superMapping.templateMethod )
+            .messager( messager )
+            .typeFactory( typeFactory )
+            .build();
+        if ( sourceReference == null || sourceReference.getParameter() == null ) {
+            return sourceName;
+        }
+
+        String trimmedSourceName = sourceName.trim();
+        String[] segments = trimmedSourceName.split( "\\." );
+        boolean leadingSegmentIsParameter = superMapping.templateMethod.getSourceParameters().size() > 1
+            || sourceReference.getPropertyEntries().size() < segments.length;
+        if ( !leadingSegmentIsParameter
+            || !segments[0].equals( sourceReference.getParameter().getName() ) ) {
+            return sourceName;
+        }
+
+        int parameterPosition = parameterPosition(
+            superMapping.templateMethod.getParameters(),
+            sourceReference.getParameter()
+        );
+        if ( parameterPosition < 0 || parameterPosition >= sourceMethod.getParameters().size() ) {
+            return sourceName;
+        }
+
+        String overridingParameterName = sourceMethod.getParameters().get( parameterPosition ).getName();
+        if ( segments.length == 1 ) {
+            return overridingParameterName;
+        }
+        return overridingParameterName + "." + trimmedSourceName.substring( segments[0].length() + 1 );
+    }
+
+    private int parameterPosition(List<Parameter> parameters, Parameter parameter) {
+        for ( int i = 0; i < parameters.size(); i++ ) {
+            if ( parameters.get( i ) == parameter ) {
+                return i;
+            }
+        }
+        return -1;
+    }
+
+    private static class SuperMapping {
+        private final MappingOptions mapping;
+        private final SourceMethod templateMethod;
+        private final TypeElement declaringType;
+
+        private SuperMapping(MappingOptions mapping, SourceMethod templateMethod, TypeElement declaringType) {
+            this.mapping = mapping;
+            this.templateMethod = templateMethod;
+            this.declaringType = declaringType;
+        }
     }
 
