diff --git a/processor/src/test/java/org/mapstruct/ap/test/inheritsupermappings/InheritedSuperMappingsTest.java b/processor/src/test/java/org/mapstruct/ap/test/inheritsupermappings/InheritedSuperMappingsTest.java
new file mode 100644
index 0000000..079aa97
--- /dev/null
+++ b/processor/src/test/java/org/mapstruct/ap/test/inheritsupermappings/InheritedSuperMappingsTest.java
@@ -0,0 +1,143 @@
+/*
+ * Copyright MapStruct Authors.
+ *
+ * Licensed under the Apache License version 2.0, available at http://www.apache.org/licenses/LICENSE-2.0
+ */
+package org.mapstruct.ap.test.inheritsupermappings;
+
+import javax.tools.Diagnostic.Kind;
+
+import org.mapstruct.ap.test.inheritsupermappings.erroneous.ConflictLeft;
+import org.mapstruct.ap.test.inheritsupermappings.erroneous.ConflictRight;
+import org.mapstruct.ap.test.inheritsupermappings.erroneous.ConflictSource;
+import org.mapstruct.ap.test.inheritsupermappings.erroneous.ConflictTarget;
+import org.mapstruct.ap.test.inheritsupermappings.erroneous.ConflictingMapper;
+import org.mapstruct.ap.test.inheritsupermappings.erroneous.NoOverrideMapper;
+import org.mapstruct.ap.testutil.ProcessorTest;
+import org.mapstruct.ap.testutil.WithClasses;
+import org.mapstruct.ap.testutil.compilation.annotation.CompilationResult;
+import org.mapstruct.ap.testutil.compilation.annotation.Diagnostic;
+import org.mapstruct.ap.testutil.compilation.annotation.ExpectedCompilationOutcome;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+public class InheritedSuperMappingsTest {
+
+    @ProcessorTest
+    @WithClasses({ InheritedMapper.class, GenericBaseMapper.class, ComposedMapping.class, Source.class, Target.class })
+    public void shouldInheritMappingsAndRebindParametersByPosition() {
+        Source left = new Source();
+        left.setValue( "left-value" );
+        left.setOther( "left-other" );
+        Source right = new Source();
+        right.setValue( "right-value" );
+        right.setOther( "right-other" );
+
+        Target target = InheritedMapper.INSTANCE.map( left, right );
+
+        assertThat( target.getFirst() ).isEqualTo( "right-other" );
+        assertThat( target.getSecond() ).isEqualTo( "right-value" );
+        assertThat( target.getComposed() ).isEqualTo( "left-other" );
+        assertThat( target.getExpression() ).isEqualTo( "super" );
+        assertThat( target.getSemantic() ).isEqualTo( "left-value" );
+        assertThat( target.getIgnored() ).isNull();
+        assertThat( InheritedMapper.INSTANCE.map( null, null ) ).isNull();
+    }
+
+    @ProcessorTest
+    @WithClasses({ SemanticMapper.class, SemanticBaseMapper.class, Source.class, Target.class })
+    public void shouldKeepLeadingPropertyMeaningFromOverriddenMethod() {
+        Source nested = new Source();
+        nested.setValue( "nested" );
+        Source source = new Source();
+        source.setSource( nested );
+
+        assertThat( SemanticMapper.INSTANCE.map( source ).getSemantic() ).isEqualTo( "nested" );
+    }
+
+    @ProcessorTest
+    @WithClasses({
+        DiamondMapper.class, LeftMapper.class, RightMapper.class, RootMapper.class, Source.class, Target.class
+    })
+    public void shouldUseMostSpecificMappingsAndCombineBranches() {
+        Source source = new Source();
+        source.setValue( "value" );
+        source.setOther( "other" );
+
+        Target target = DiamondMapper.INSTANCE.map( source );
+
+        assertThat( target.getFirst() ).isEqualTo( "other" );
+        assertThat( target.getSecond() ).isEqualTo( "value" );
+    }
+
+    @ProcessorTest
+    @WithClasses({
+        FlatteningMapper.class, FlatteningBaseMapper.class, FlattenFirst.class, FlattenSecond.class,
+        FlattenThird.class, Target.class
+    })
+    public void shouldAccumulateFlatteningMappings() {
+        FlattenFirst first = new FlattenFirst();
+        first.setFirst( "first" );
+        FlattenSecond second = new FlattenSecond();
+        second.setSecond( "second" );
+        FlattenThird third = new FlattenThird();
+        third.setComposed( "third" );
+
+        Target target = FlatteningMapper.INSTANCE.map( first, second, third );
+
+        assertThat( target.getFirst() ).isEqualTo( "first" );
+        assertThat( target.getSecond() ).isEqualTo( "second" );
+        assertThat( target.getComposed() ).isEqualTo( "third" );
+    }
+
+    @ProcessorTest
+    @WithClasses({ EmptyOverrideMapper.class, EmptyBaseMapper.class, Source.class, Target.class })
+    public void shouldAcceptOverriddenMappingMethodWithoutPropertyMappings() {
+        Source source = new Source();
+        source.setFirst( "first" );
+
+        assertThat( EmptyOverrideMapper.INSTANCE.map( source ).getFirst() ).isEqualTo( "first" );
+    }
+
+    @ProcessorTest
+    @WithClasses({ DisabledMapper.class, DisabledBaseMapper.class, Source.class, Target.class })
+    public void shouldNotInheritWhenDisabled() {
+        Source source = new Source();
+        source.setFirst( "automatic" );
+        source.setOther( "super" );
+
+        assertThat( DisabledMapper.INSTANCE.map( source ).getFirst() ).isEqualTo( "automatic" );
+    }
+
+    @ProcessorTest
+    @WithClasses({
+        ConflictingMapper.class, ConflictLeft.class, ConflictRight.class, ConflictSource.class, ConflictTarget.class
+    })
+    @ExpectedCompilationOutcome(
+        value = CompilationResult.FAILED,
+        diagnostics = @Diagnostic(
+            type = ConflictingMapper.class,
+            kind = Kind.ERROR,
+            line = 16,
+            message = "Inherited mappings for target \"value\" conflict between mapper types "
+                + "org.mapstruct.ap.test.inheritsupermappings.erroneous.ConflictLeft, "
+                + "org.mapstruct.ap.test.inheritsupermappings.erroneous.ConflictRight."
+        )
+    )
+    public void shouldReportConflictingIncomparableMappings() {
+    }
+
+    @ProcessorTest
+    @WithClasses({ NoOverrideMapper.class, ConflictSource.class, ConflictTarget.class })
+    @ExpectedCompilationOutcome(
+        value = CompilationResult.FAILED,
+        diagnostics = @Diagnostic(
+            type = NoOverrideMapper.class,
+            kind = Kind.ERROR,
+            line = 15,
+            message = "@BeanMapping(inheritSuperMappings = true) requires an overridden mapping method."
+        )
+    )
+    public void shouldRequireOverriddenMappingMethod() {
+    }
+}
