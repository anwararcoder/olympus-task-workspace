+            sourceParameters,
+            targetParameter,
+            contextParameters,
+            resultType,
+            returnType,
+            SourceMethod.containsTargetTypeParameter( parameters )
+        ) ) {
+            return null;
+        }
+
+        BeanMappingOptions beanMappingOptions = BeanMappingOptions.empty( mapperOptions );
+        return new SourceMethod.Builder()
+            .setExecutable( method )
+            .setParameters( parameters )
+            .setReturnType( returnType )
+            .setExceptionTypes( typeFactory.getThrownTypes( methodType ) )
+            .setMapper( mapperOptions )
+            .setBeanMappingOptions( beanMappingOptions )
+            .setMappingOptions( getMappings( method, beanMappingOptions ) )
