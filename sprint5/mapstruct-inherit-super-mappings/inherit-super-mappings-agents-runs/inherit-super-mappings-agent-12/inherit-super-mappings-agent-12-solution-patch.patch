+    private void collectOverriddenMethods(ExecutableElement method, DeclaredType mapperType,
+                                          TypeElement mapperTypeElement, Set<String> visitedTypes,
+                                          Map<String, OverriddenMethod> overriddenMethods) {
+        for ( TypeMirror superType : typeUtils.directSupertypes( mapperType ) ) {
+            if ( superType.getKind() != TypeKind.DECLARED ) {
+                continue;
+            }
+
+            DeclaredType declaredSuperType = (DeclaredType) superType;
+            TypeElement superTypeElement = (TypeElement) declaredSuperType.asElement();
+            String declaringTypeName = getQualifiedName( declaredSuperType, superTypeElement );
+            if ( !visitedTypes.add( declaredSuperType.toString() ) ) {
+                continue;
+            }
+
+            for ( Element enclosedElement : superTypeElement.getEnclosedElements() ) {
+                if ( enclosedElement instanceof ExecutableElement ) {
+                    ExecutableElement executable = (ExecutableElement) enclosedElement;
+                    if ( elementUtils.overrides( method, executable, mapperTypeElement ) ) {
+                        String methodKey = declaringTypeName + "#" + executable;
+                        overriddenMethods.putIfAbsent(
+                            methodKey,
+                            new OverriddenMethod( executable, declaredSuperType, declaringTypeName )
+                        );
+                    }
+                }
+            }
+
+            collectOverriddenMethods(
+                method,
+                declaredSuperType,
+                mapperTypeElement,
+                visitedTypes,
+                overriddenMethods
+            );
+        }
+    }
