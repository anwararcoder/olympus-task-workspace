+    private void applyInheritedSuperMappings(SourceMethod sourceMethod, DeclaredType mapperType,
+                                              MapperOptions mapperOptions) {
+        List<SuperMethod> overriddenMethods = getOverriddenBeanMappingMethods(
+            sourceMethod,
+            mapperType,
+            mapperOptions
+        );
+        if ( overriddenMethods.isEmpty() ) {
+            messager.printMessage(
+                sourceMethod.getExecutable(),
+                sourceMethod.getOptions().getBeanMapping().getMirror(),
+                Message.BEANMAPPING_INHERIT_SUPER_MAPPINGS_NO_SUPER_MAPPING
+            );
+            return;
+        }
+
+        Set<String> currentTargets = new HashSet<>();
+        for ( MappingOptions mapping : sourceMethod.getOptions().getMappings() ) {
+            if ( !".".equals( mapping.getTargetName() ) ) {
+                currentTargets.add( mapping.getTargetName() );
+            }
+        }
+
+        Map<String, List<SuperMapping>> mappingsByTarget = new LinkedHashMap<>();
+        List<SuperMapping> targetThisMappings = new ArrayList<>();
+        for ( SuperMethod overriddenMethod : overriddenMethods ) {
+            for ( MappingOptions mapping : overriddenMethod.method.getOptions().getMappings() ) {
+                SuperMapping superMapping = new SuperMapping( overriddenMethod, mapping );
+                if ( ".".equals( mapping.getTargetName() ) ) {
+                    targetThisMappings.add( superMapping );
+                }
+                else if ( !currentTargets.contains( mapping.getTargetName() ) ) {
+                    mappingsByTarget.computeIfAbsent( mapping.getTargetName(), key -> new ArrayList<>() )
+                        .add( superMapping );
+                }
+            }
+        }
+
+        for ( SuperMapping targetThisMapping : targetThisMappings ) {
+            addInheritedSuperMapping( sourceMethod, targetThisMapping );
+        }
+
+        for ( Map.Entry<String, List<SuperMapping>> mappingsForTarget : mappingsByTarget.entrySet() ) {
+            List<SuperMapping> mostSpecificMappings = getMostSpecificMappings( mappingsForTarget.getValue() );
+            if ( mostSpecificMappings.size() == 1 ) {
+                addInheritedSuperMapping( sourceMethod, mostSpecificMappings.get( 0 ) );
+            }
+            else {
+                reportIncomparableSuperMappings(
+                    sourceMethod,
+                    mappingsForTarget.getKey(),
+                    mostSpecificMappings
+                );
+            }
+        }
+    }
