@@ -0,0 +1,208 @@
+/*
+ * Copyright MapStruct Authors.
+ *
+ * Licensed under the Apache License version 2.0, available at http://www.apache.org/licenses/LICENSE-2.0
+ */
+package org.mapstruct.ap.test.inheritsupermappings;
+
+import javax.tools.Diagnostic.Kind;
+
+import org.mapstruct.ap.testutil.ProcessorTest;
+import org.mapstruct.ap.testutil.WithClasses;
+import org.mapstruct.ap.testutil.compilation.annotation.CompilationResult;
+import org.mapstruct.ap.testutil.compilation.annotation.Diagnostic;
+import org.mapstruct.ap.testutil.compilation.annotation.ExpectedCompilationOutcome;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+@WithClasses({
+    BasicSource.class,
+    BasicTarget.class,
+    ComposedNameMapping.class,
+    BasicConfig.class,
+    BasicBaseMapper.class,
+    BasicMapper.class,
+    HierarchyRootMapper.class,
+    HierarchyLeftMapper.class,
+    HierarchyRightMapper.class,
+    HierarchyTarget.class,
+    HierarchyMapper.class,
+    FlattenSource.class,
+    FlattenTarget.class,
+    FlattenRootMapper.class,
+    FlattenLeftMapper.class,
+    FlattenRightMapper.class,
+    FlattenMapper.class,
+    ParameterSource.class,
+    ParameterTarget.class,
+    GenericBaseMapper.class,
+    GenericMiddleMapper.class,
+    ParameterMapper.class,
+    EmptyBaseMapper.class,
+    EmptySuperMapper.class,
+    DisabledBaseMapper.class,
+    DisabledMapper.class,
+    AbstractBaseMapper.class,
+    AbstractChildMapper.class,
+    ConflictLeftMapper.class,
+    ConflictRightMapper.class,
+    ResolvedConflictMapper.class
+})
+public class InheritedSuperMappingsTest {
+
+    @ProcessorTest
+    public void shouldInheritMappingsWithoutBeanMappingOptions() {
+        BasicSource source = source();
+
+        BasicTarget target = BasicMapper.INSTANCE.map( source );
+
+        assertThat( target.getInheritedValue() ).isEqualTo( "title" );
+        assertThat( target.getSuperOnlyValue() ).isEqualTo( "name" );
+        assertThat( target.getIgnoredValue() ).isNull();
+        assertThat( target.getComposedValue() ).isEqualTo( "title" );
+        assertThat( target.getConfigValue() ).isEqualTo( "title" );
+        assertThat( target.getAutomaticValue() ).isEqualTo( "automatic" );
+        assertThat( BasicMapper.INSTANCE.map( null ) ).isNull();
+    }
+
+    @ProcessorTest
+    public void shouldResolveHierarchyBySpecificity() {
+        HierarchyTarget target = HierarchyMapper.INSTANCE.map( source() );
+
+        assertThat( target.getRootValue() ).isEqualTo( "name" );
+        assertThat( target.getOverriddenValue() ).isEqualTo( "title" );
+        assertThat( target.getLeftValue() ).isEqualTo( "name" );
+        assertThat( target.getRightValue() ).isEqualTo( "title" );
+    }
+
+    @ProcessorTest
+    public void shouldAccumulateTargetThisMappings() {
+        FlattenSource source = new FlattenSource();
+        source.setRoot( rootPart( "root" ) );
+        source.setLeft( leftPart( "left" ) );
+        source.setRight( rightPart( "right" ) );
+        source.setCurrent( currentPart( "current" ) );
+
+        FlattenTarget target = FlattenMapper.INSTANCE.map( source );
+
+        assertThat( target.getRootValue() ).isEqualTo( "root" );
+        assertThat( target.getLeftValue() ).isEqualTo( "left" );
+        assertThat( target.getRightValue() ).isEqualTo( "right" );
+        assertThat( target.getCurrentValue() ).isEqualTo( "current" );
+    }
+
+    @ProcessorTest
+    public void shouldRebindQualifiedParametersByPosition() {
+        ParameterSource firstArgument = parameterSource( "first argument", "first property", "property named second" );
+        ParameterSource secondArgument = parameterSource( "second argument", "second property", "other" );
+
+        ParameterTarget target = ParameterMapper.INSTANCE.map( firstArgument, secondArgument );
+        ParameterTarget singleTarget = ParameterMapper.INSTANCE.mapSingle( firstArgument );
+
+        assertThat( target.getFirstValue() ).isEqualTo( "first argument" );
+        assertThat( target.getSecondValue() ).isEqualTo( "second argument" );
+        assertThat( target.getWhole() ).isSameAs( firstArgument );
+        assertThat( target.getExpressionValue() ).isEqualTo( "first" );
+        assertThat( singleTarget.getPropertyValue() ).isEqualTo( "first property" );
+    }
+
+    @ProcessorTest
+    public void shouldCountSuperMethodWithoutMappings() {
+        BasicTarget target = EmptySuperMapper.INSTANCE.map( source() );
+
+        assertThat( target.getAutomaticValue() ).isEqualTo( "automatic" );
+    }
+
+    @ProcessorTest
+    public void shouldKeepBehaviorDisabledByDefault() {
+        BasicTarget target = DisabledMapper.INSTANCE.map( source() );
+
+        assertThat( target.getValue() ).isEqualTo( "automatic source value" );
+    }
+
+    @ProcessorTest
+    public void shouldInheritFromSuperclass() {
+        BasicTarget target = AbstractChildMapper.INSTANCE.map( source() );
+
+        assertThat( target.getValue() ).isEqualTo( "title" );
+    }
+
+    @ProcessorTest
+    public void shouldLetCurrentMappingResolveBranchConflict() {
+        BasicTarget target = ResolvedConflictMapper.INSTANCE.map( source() );
+
+        assertThat( target.getValue() ).isEqualTo( "title" );
+    }
+
+    @ProcessorTest
+    @WithClasses(ConflictingMapper.class)
+    @ExpectedCompilationOutcome(
+        value = CompilationResult.FAILED,
+        diagnostics = @Diagnostic(
+            type = ConflictingMapper.class,
+            kind = Kind.ERROR,
+            line = 16,
+            message = "Inherited mappings for target \"value\" are declared in multiple mapper types: "
+                + "org.mapstruct.ap.test.inheritsupermappings.ConflictLeftMapper, "
+                + "org.mapstruct.ap.test.inheritsupermappings.ConflictRightMapper."
+        )
+    )
+    public void shouldReportIncomparableMappingsForSameTarget() {
+    }
+
+    @ProcessorTest
+    @WithClasses(NoSuperMapper.class)
+    @ExpectedCompilationOutcome(
+        value = CompilationResult.FAILED,
+        diagnostics = @Diagnostic(
+            type = NoSuperMapper.class,
+            kind = Kind.ERROR,
+            line = 15,
+            message = "Cannot inherit super mappings because this method does not override another bean mapping "
+                + "method."
+        )
+    )
+    public void shouldReportMissingOverriddenMappingMethod() {
+    }
+
+    private BasicSource source() {
+        BasicSource source = new BasicSource();
+        source.setName( "name" );
+        source.setTitle( "title" );
+        source.setAutomaticValue( "automatic" );
+        source.setValue( "automatic source value" );
+        return source;
+    }
+
+    private ParameterSource parameterSource(String name, String value, String second) {
+        ParameterSource source = new ParameterSource();
+        source.setName( name );
+        source.setValue( value );
+        source.setSecond( second );
+        return source;
+    }
+
+    private FlattenSource.RootPart rootPart(String value) {
+        FlattenSource.RootPart part = new FlattenSource.RootPart();
+        part.setRootValue( value );
+        return part;
+    }
+
+    private FlattenSource.LeftPart leftPart(String value) {
+        FlattenSource.LeftPart part = new FlattenSource.LeftPart();
+        part.setLeftValue( value );
+        return part;
+    }
+
+    private FlattenSource.RightPart rightPart(String value) {
+        FlattenSource.RightPart part = new FlattenSource.RightPart();
+        part.setRightValue( value );
+        return part;
+    }
+
+    private FlattenSource.CurrentPart currentPart(String value) {
+        FlattenSource.CurrentPart part = new FlattenSource.CurrentPart();
+        part.setCurrentValue( value );
+        return part;
+    }
+}
