+    private List<SuperMethod> getOverriddenBeanMappingMethods(SourceMethod sourceMethod, DeclaredType mapperType,
+                                                              MapperOptions mapperOptions) {
+        Map<String, OverriddenMethod> overriddenMethods = new LinkedHashMap<>();
+        collectOverriddenMethods(
+            sourceMethod.getExecutable(),
+            mapperType,
+            (TypeElement) mapperType.asElement(),
+            new HashSet<>(),
+            overriddenMethods
+        );
+
+        List<SuperMethod> beanMappingMethods = new ArrayList<>();
+        for ( OverriddenMethod overriddenMethod : overriddenMethods.values() ) {
+            SourceMethod superMethod = getSuperMappingMethod(
+                mapperType,
+                overriddenMethod.executable,
+                mapperOptions
+            );
+            if ( superMethod != null && isBeanMappingMethod( superMethod ) ) {
+                beanMappingMethods.add( new SuperMethod(
+                    superMethod,
+                    overriddenMethod.declaringType,
+                    overriddenMethod.declaringTypeName
+                ) );
+            }
+        }
+        return beanMappingMethods;
+    }
