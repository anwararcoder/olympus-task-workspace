+    private List<SuperMapping> getMostSpecificMappings(List<SuperMapping> mappings) {
+        List<SuperMapping> mostSpecificMappings = new ArrayList<>();
+        for ( SuperMapping candidate : mappings ) {
+            boolean overriddenByAnotherMapping = false;
+            for ( SuperMapping other : mappings ) {
+                if ( candidate != other && typeUtils.isSubtype(
+                    other.method.declaringType,
+                    candidate.method.declaringType
+                ) ) {
+                    overriddenByAnotherMapping = true;
+                    break;
+                }
+            }
+            if ( !overriddenByAnotherMapping ) {
+                mostSpecificMappings.add( candidate );
+            }
+        }
+        return mostSpecificMappings;
+    }
