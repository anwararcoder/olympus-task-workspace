+    @Mapping(target = "automatic", ignore = true)
+    Target map(Source firstSource, Source secondSource);
+
+    @Override
+    @BeanMapping(inheritSuperMappings = true)
+    Target automatic(Source input);
+
+    @Override
+    @BeanMapping(inheritSuperMappings = true)
+    Target empty(Source input);
