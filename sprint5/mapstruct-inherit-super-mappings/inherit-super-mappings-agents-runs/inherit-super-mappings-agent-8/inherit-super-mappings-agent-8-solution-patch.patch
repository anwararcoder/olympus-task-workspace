+import static org.assertj.core.api.Assertions.assertThat;
+
+public class InheritSuperMappingsTest {
+
+    @ProcessorTest
+    @WithClasses(SuperMappingsMapper.class)
+    public void shouldInheritSuperMappings() {
+        Source first = source( "first", "second", "branch", "automatic", "base", "mid" );
+        Source second = source( "otherFirst", "otherSecond", "otherBranch", "otherAutomatic", "otherBase", "otherMid" );
+
+        Target mapped = SuperMappingsMapper.INSTANCE.map( first, second );
+
+        assertThat( mapped.getFirstOut() ).isEqualTo( "otherFirst" );
+        assertThat( mapped.getSecondOut() ).isEqualTo( "otherSecond" );
+        assertThat( mapped.getBranchOut() ).isEqualTo( "branch" );
+    }
+
+    @ProcessorTest
+    @WithClasses(SuperMappingsMapper.class)
+    public void shouldNotInheritOtherBeanMappingOptions() {
+        Source source = source( "first", "second", "branch", "automatic", "base", "mid" );
+
+        Target mapped = SuperMappingsMapper.INSTANCE.automatic( source );
+
+        assertThat( mapped.getFirstOut() ).isEqualTo( "first" );
+        assertThat( mapped.getAutomatic() ).isEqualTo( "automatic" );
+    }
+
+    @ProcessorTest
+    @WithClasses(SuperMappingsMapper.class)
+    public void shouldAcceptOverriddenMappingMethodWithoutMappings() {
+        Source source = source( "first", "second", "branch", "automatic", "base", "mid" );
+
+        Target mapped = SuperMappingsMapper.INSTANCE.empty( source );
+
+        assertThat( mapped.getAutomatic() ).isEqualTo( "automatic" );
+    }
+
+    @ProcessorTest
+    @WithClasses(SuperMappingsMapper.class)
+    public void shouldPreservePropertyAndRebindWholeParameterSources() {
+        PropertySource propertySource = new PropertySource();
+        propertySource.setSource( "property" );
+        WholeSource wholeSource = new WholeSource();
+        wholeSource.setValue( "whole" );
+
+        PropertyTarget propertyTarget = SuperMappingsMapper.INSTANCE.property( propertySource );
+        WholeTarget wholeTarget = SuperMappingsMapper.INSTANCE.whole( wholeSource );
+
+        assertThat( propertyTarget.getValue() ).isEqualTo( "property" );
+        assertThat( wholeTarget.getNested() ).isSameAs( wholeSource );
+    }
+
+    @ProcessorTest
+    @WithClasses(SuperMappingsMapper.class)
+    public void shouldAccumulateFlatteningMappings() {
+        FlattenLeft left = new FlattenLeft();
