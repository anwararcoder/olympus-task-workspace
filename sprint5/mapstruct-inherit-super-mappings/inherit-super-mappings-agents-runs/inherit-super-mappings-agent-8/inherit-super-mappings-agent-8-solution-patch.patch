+    private Set<MappingOptions> inheritSuperMappings(Type mapperType, ExecutableElement method,
+                                                     List<Parameter> parameters, BeanMappingOptions beanMappingOptions,
+                                                     Set<MappingOptions> declaredMappings) {
+        List<SuperMappingMethod> overriddenMethods = new ArrayList<>();
+        collectOverriddenMethods(
+            (DeclaredType) mapperType.getTypeMirror(),
+            mapperType.getTypeElement(),
+            method,
+            new HashSet<>(),
+            new HashSet<>(),
+            overriddenMethods
+        );
+
+        if ( overriddenMethods.isEmpty() ) {
+            messager.printMessage(
+                method,
+                beanMappingOptions.getMirror(),
+                Message.BEANMAPPING_INHERIT_SUPER_MAPPINGS_NO_OVERRIDE
+            );
+            return declaredMappings;
+        }
+
+        Set<String> declaredTargets = new HashSet<>();
+        for ( MappingOptions mapping : declaredMappings ) {
+            if ( !".".equals( mapping.getTargetName() ) ) {
+                declaredTargets.add( mapping.getTargetName() );
+            }
+        }
+
+        Map<String, InheritedMapping> inheritedByTarget = new LinkedHashMap<>();
+        List<InheritedMapping> flatteningMappings = new ArrayList<>();
+        Set<String> conflictingTargets = new HashSet<>();
+
+        for ( SuperMappingMethod overriddenMethod : overriddenMethods ) {
+            for ( MappingOptions mapping : overriddenMethod.mappings ) {
+                String targetName = mapping.getTargetName();
+                InheritedMapping inheritedMapping = new InheritedMapping( mapping, overriddenMethod );
+                if ( ".".equals( targetName ) ) {
+                    flatteningMappings.add( inheritedMapping );
+                }
+                else if ( !declaredTargets.contains( targetName ) && !conflictingTargets.contains( targetName ) ) {
+                    InheritedMapping existing = inheritedByTarget.get( targetName );
+                    if ( existing == null ) {
+                        inheritedByTarget.put( targetName, inheritedMapping );
+                    }
+                    else if ( isMoreSpecific( overriddenMethod.declaringType,
+                        existing.method.declaringType ) ) {
+                        inheritedByTarget.put( targetName, inheritedMapping );
+                    }
+                    else if ( !isMoreSpecific( existing.method.declaringType, overriddenMethod.declaringType ) ) {
+                        messager.printMessage(
+                            method,
+                            beanMappingOptions.getMirror(),
+                            Message.BEANMAPPING_INHERIT_SUPER_MAPPINGS_CONFLICT,
+                            targetName,
+                            existing.method.declaringElement.getQualifiedName(),
+                            overriddenMethod.declaringElement.getQualifiedName()
+                        );
+                        inheritedByTarget.remove( targetName );
+                        conflictingTargets.add( targetName );
+                    }
+                }
+            }
+        }
+
+        Set<MappingOptions> result = new LinkedHashSet<>( declaredMappings );
+        for ( InheritedMapping inheritedMapping : inheritedByTarget.values() ) {
+            result.add( copyInheritedMapping( inheritedMapping, parameters, beanMappingOptions ) );
+        }
+        for ( InheritedMapping inheritedMapping : flatteningMappings ) {
+            result.add( copyInheritedMapping( inheritedMapping, parameters, beanMappingOptions ) );
+        }
+        return result;
+    }
+
+    private void collectOverriddenMethods(DeclaredType type, TypeElement mapperToImplement, ExecutableElement method,
+                                          Set<TypeElement> visitedTypes, Set<ExecutableElement> visitedMethods,
+                                          List<SuperMappingMethod> overriddenMethods) {
+        for ( TypeMirror superTypeMirror : typeUtils.directSupertypes( type ) ) {
+            if ( superTypeMirror.getKind() != TypeKind.DECLARED ) {
+                continue;
+            }
+            DeclaredType superType = (DeclaredType) superTypeMirror;
+            TypeElement superElement = (TypeElement) superType.asElement();
+            if ( !visitedTypes.add( superElement ) ) {
+                continue;
+            }
+            for ( ExecutableElement superMethod : ElementFilter.methodsIn( superElement.getEnclosedElements() ) ) {
+                if ( visitedMethods.add( superMethod )
+                    && elementUtils.overrides( method, superMethod, mapperToImplement ) ) {
+                    ExecutableType methodType = typeFactory.getMethodType( superType, superMethod );
+                    List<Parameter> superParameters = typeFactory.getParameters( methodType, superMethod );
+                    Set<MappingOptions> mappings = getMappings( superMethod, null );
+                    overriddenMethods.add( new SuperMappingMethod(
+                        superType,
+                        superElement,
+                        superParameters,
+                        mappings
+                    ) );
+                }
+            }
+            collectOverriddenMethods(
+                superType,
+                mapperToImplement,
+                method,
+                visitedTypes,
+                visitedMethods,
+                overriddenMethods
+            );
+        }
+    }
+
+    private boolean isMoreSpecific(DeclaredType candidate, DeclaredType existing) {
+        return typeUtils.isSubtypeErased( candidate, existing );
+    }
+
+    private MappingOptions copyInheritedMapping(InheritedMapping inheritedMapping, List<Parameter> parameters,
+                                                BeanMappingOptions beanMappingOptions) {
+        String sourceName = inheritedMapping.mapping.getSourceName();
+        Integer sourceParameterPosition = sourceParameterPosition(
+            sourceName,
+            inheritedMapping.method.parameters
+        );
+        if ( sourceParameterPosition != null ) {
+            String[] segments = sourceName.split( "\\.", -1 );
+            segments[0] = parameters.get( sourceParameterPosition ).getName();
+            sourceName = String.join( ".", segments );
+        }
+        return inheritedMapping.mapping.copyForSuperInheritance(
+            sourceName,
+            sourceParameterPosition,
+            beanMappingOptions
+        );
+    }
+
+    private Integer sourceParameterPosition(String sourceName, List<Parameter> parameters) {
+        if ( sourceName == null ) {
+            return null;
+        }
+        String[] segments = sourceName.trim().split( "\\." );
+        List<Parameter> sourceParameters = Parameter.getSourceParameters( parameters );
+        if ( sourceParameters.isEmpty() ) {
+            return null;
+        }
+        if ( sourceParameters.size() > 1 ) {
+            return parameterPosition( parameters, Parameter.getSourceParameter( parameters, segments[0] ) );
+        }
+
+        Parameter sourceParameter = sourceParameters.get( 0 );
+        if ( matchesPropertyPath( sourceParameter, segments ) ) {
+            return null;
+        }
+        if ( sourceParameter.getName().equals( segments[0] ) ) {
+            return parameterPosition( parameters, sourceParameter );
+        }
+        return null;
+    }
+
+    private boolean matchesPropertyPath(Parameter parameter, String[] propertyNames) {
+        Type propertyType = parameter.getType();
+        boolean allowedMapToBean = !propertyType.isMapType() || !propertyNames[0].equals( parameter.getName() );
+        for ( int i = 0; i < propertyNames.length; i++ ) {
+            Type noBoundsType = propertyType.withoutBounds();
+            if ( noBoundsType.isOptionalType() ) {
+                noBoundsType = noBoundsType.getOptionalBaseType();
+            }
+            ReadAccessor readAccessor = noBoundsType.getReadAccessor( propertyNames[i], i > 0 || allowedMapToBean );
+            if ( readAccessor == null ) {
+                return false;
+            }
+            propertyType = typeFactory.getReturnType( (DeclaredType) noBoundsType.getTypeMirror(), readAccessor );
+        }
+        return true;
+    }
+
+    private Integer parameterPosition(List<Parameter> parameters, Parameter parameter) {
+        return parameter == null ? null : parameters.indexOf( parameter );
+    }
+
+    private static class SuperMappingMethod {
+        private final DeclaredType declaringType;
+        private final TypeElement declaringElement;
+        private final List<Parameter> parameters;
+        private final Set<MappingOptions> mappings;
+
+        private SuperMappingMethod(DeclaredType declaringType, TypeElement declaringElement,
+                                   List<Parameter> parameters, Set<MappingOptions> mappings) {
+            this.declaringType = declaringType;
+            this.declaringElement = declaringElement;
+            this.parameters = parameters;
+            this.mappings = mappings;
+        }
+    }
+
+    private static class InheritedMapping {
+        private final MappingOptions mapping;
+        private final SuperMappingMethod method;
+
+        private InheritedMapping(MappingOptions mapping, SuperMappingMethod method) {
+            this.mapping = mapping;
+            this.method = method;
+        }
+    }
+
