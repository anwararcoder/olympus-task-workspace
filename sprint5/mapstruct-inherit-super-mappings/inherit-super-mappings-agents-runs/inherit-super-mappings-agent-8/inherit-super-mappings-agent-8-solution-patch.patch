+    @BeanMapping(inheritSuperMappings = true)
+    WholeTarget whole(WholeSource input);
+
+    @Override
+    @BeanMapping(inheritSuperMappings = true)
+    @Mapping(target = ".", source = "right")
+    FlattenTarget flatten(FlattenLeft left, FlattenRight right);
+
+    @Override
+    @BeanMapping(inheritSuperMappings = true)
+    Target mostSpecific(Source input);
+}
+
+interface GenericBaseMapping<S, T> {
+
+    @Mapping(target = "firstOut", source = "left.first")
+    T map(S left, S right);
+}
+
+interface IntermediateMapping<S, T> extends GenericBaseMapping<S, T> {
+
+    @Override
+    @BeanMapping(ignoreByDefault = true)
+    @Mapping(target = "secondOut", source = "right.second")
+    T map(S left, S right);
+}
+
+interface BranchMapping<S, T> {
+
+    @OverrideBranchMapping
+    T map(S left, S right);
+}
+
+@java.lang.annotation.Target(METHOD)
+@Retention(RetentionPolicy.CLASS)
+@Mapping(target = "branchOut", source = "left.branch")
+@interface OverrideBranchMapping {
+}
+
+interface AutomaticMapping<S, T> {
+
+    @BeanMapping(ignoreByDefault = true)
