+#!/bin/bash
+set -o pipefail
+INVOKE_DIR="$PWD"
+cd "$(dirname "$0")"
+
+OUTPUT_PATH=""
+MODE=""
+while [[ $# -gt 0 ]]; do
+    case "$1" in
+        --output_path) OUTPUT_PATH="$2"; shift 2;;
+        base|new) MODE="$1"; shift;;
+        *) echo "Usage: $0 --output_path <path> {base|new}"; exit 1;;
+    esac
+done
+[[ -z "$MODE" ]] && { echo "Usage: $0 --output_path <path> {base|new}"; exit 1; }
+[[ -n "$OUTPUT_PATH" && "$OUTPUT_PATH" != /* ]] && OUTPUT_PATH="$INVOKE_DIR/$OUTPUT_PATH"
+
+export JAVA_HOME="${JAVA_HOME:-/usr/lib/jvm/java-17-openjdk-amd64}"
+export PATH="$JAVA_HOME/bin:$PATH"
+
+JAVAX_TEST="TransactionalJspBatch_4f13c2_Test"
+JAKARTA_TEST="TransactionalJspBatchJakarta_4f13c2_Test"
+MVN="mvn -o -B -fae -Dmaven.repo.local=/opt/.m2/repository -pl jte-jsp-converter,jte-jsp-converter-jakarta -am -DforkCount=1 -DreuseForks=false -DfailIfNoTests=false -Dsurefire.failIfNoSpecifiedTests=false"
+
+find . -path '*/target/surefire-reports' -type d -exec rm -rf {} + 2>/dev/null || true
+
+case "$MODE" in
+    base)
+        EXCLUDES="$(mktemp)"
+        {
+            echo "**/${JAVAX_TEST}.java"
+            echo "**/${JAKARTA_TEST}.java"
+        } > "$EXCLUDES"
+        $MVN test -Dsurefire.excludesFile="$EXCLUDES"
+        status=$?
+        rm -f "$EXCLUDES"
+        ;;
+    new)
+        $MVN test -Dtest="${JAVAX_TEST},${JAKARTA_TEST}"
+        status=$?
+        ;;
+esac
+
+if [[ -n "$OUTPUT_PATH" ]]; then
+    {
+        echo '<testsuites>'
+        find . -path '*/target/surefire-reports/TEST-*.xml' -exec sed '1{/^[[:space:]]*<?xml/d;}' {} \; 2>/dev/null
+        echo '</testsuites>'
+    } > "$OUTPUT_PATH"
+fi
+
+exit $status
