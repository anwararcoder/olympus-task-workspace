+    private static final class Provider extends FileSystemProvider {
+        private final FailingPathFileSystem fileSystem;
+        private final FileSystemProvider delegate = FileSystems.getDefault().provider();
+        private final Set<Path> affectedPaths;
+        private final boolean failRollback;
+        private boolean mutated;
+        private boolean primaryFailed;
+        private boolean rollbackFailed;
+
+        private Provider(FailingPathFileSystem fileSystem, Set<Path> affectedPaths, boolean failRollback) {
+            this.fileSystem = fileSystem;
+            this.affectedPaths = affectedPaths.stream()
+                    .map(path -> path.toAbsolutePath().normalize())
+                    .collect(java.util.stream.Collectors.toSet());
+            this.failRollback = failRollback;
+        }
+
+        @Override
+        public String getScheme() {
