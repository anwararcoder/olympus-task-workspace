+package gg.jte.convert.jsp;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+import java.io.IOException;
+import java.lang.reflect.InvocationTargetException;
+import java.lang.reflect.Method;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.attribute.FileTime;
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Collections;
+import java.util.EnumSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.function.Consumer;
+import java.util.function.Function;
+import java.util.stream.Stream;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+class TransactionalJspBatchJakarta_4f13c2_Test {
+    @TempDir
+    Path tempDir;
+
+    private Path jspRoot;
+    private Path jteRoot;
+    private TestConverter converter;
+
+    @BeforeEach
+    void setUp() throws Exception {
+        jspRoot = tempDir.resolve("WEB-INF");
+        jteRoot = tempDir.resolve("jte");
+        writeTagLibrary();
+        converter = new TestConverter(jspRoot, jteRoot, tempDir.toUri().toURL());
+    }
+
+    @Test
+    void jakartaArtifactPlansAndCommitsTheSameBatchBehavior() throws Throwable {
+        tag("leaf", "leaf");
+        tag("parent", "<my:leaf/>");
+        tag("root", "<my:parent/>");
+        Path usage = write(jspRoot.resolve("usage.jsp"), "<my:root/>");
+
+        Object plan = plan(List.of("my/root.tag", "my/leaf.tag", "my/parent.tag"), noPrefix());
+
+        assertThat(order(plan)).containsExactly(tagPath("leaf"), tagPath("parent"), tagPath("root"));
+        assertThat(writes(plan).get(jteRoot.resolve("my/parent.jte"))).contains("@template.my.leaf(");
+        assertThat(writes(plan).get(jteRoot.resolve("my/root.jte"))).contains("@template.my.parent(");
+        assertThat(jteRoot.resolve("my/leaf.jte")).doesNotExist();
+        assertThat(tagPath("leaf")).exists();
+
+        commit(plan);
+
+        assertThat(tagPath("leaf")).doesNotExist();
+        assertThat(tagPath("parent")).doesNotExist();
+        assertThat(tagPath("root")).doesNotExist();
+        assertThat(usage).content().contains("<my:jte jte=\"my/root.jte\"");
+        assertNoTransactionFiles();
+    }
+
+    @Test
+    void jakartaArtifactUsesVirtualIncludedContent() throws Throwable {
+        tag("leaf", "leaf");
+        tag("root", "<%@ include file=\"/WEB-INF/fragment.jsp.inc\" %>");
+        Path fragment = write(jspRoot.resolve("fragment.jsp.inc"), "<my:leaf/>");
+        Consumer<Converter> setup = value -> {
+            value.setPrefix("");
+            value.addInlinedInclude("/WEB-INF/fragment.jsp.inc");
+        };
+
+        Object plan = plan(List.of("my/root.tag", "my/leaf.tag"), setup);
+
+        assertThat(order(plan)).containsExactly(tagPath("leaf"), tagPath("root"));
+        assertThat(writes(plan).get(jteRoot.resolve("my/root.jte"))).contains("@template.my.leaf(");
+        assertThat(fragment).content().contains("<my:leaf");
+    }
+
+    @Test
+    void jakartaArtifactIgnoresTagTextInComments() throws Throwable {
+        tag("a", "<%-- <my:z/> --%>a");
+        tag("z", "z");
+
+        Object plan = plan(List.of("my/z.tag", "my/a.tag"), noPrefix());
+
+        assertThat(order(plan)).containsExactly(tagPath("a"), tagPath("z"));
+    }
+
+    @Test
+    void jakartaArtifactIgnoresCommentedInvocationsInsideApprovedIncludes() throws Throwable {
+        tag("a", "<%@ include file=\"/WEB-INF/fragment.jsp.inc\" %>a");
+        tag("z", "<my:a/>");
+        write(jspRoot.resolve("fragment.jsp.inc"), "<%-- <my:z/> --%>");
+        Consumer<Converter> setup = value -> {
+            value.setPrefix("");
+            value.addInlinedInclude("/WEB-INF/fragment.jsp.inc");
+        };
+
+        Object plan = plan(List.of("my/z.tag", "my/a.tag"), setup);
+
+        assertThat(order(plan)).containsExactly(tagPath("a"), tagPath("z"));
+    }
+
+    @Test
+    void jakartaArtifactSurfacesALateParserSetupFailureUnchanged() throws Exception {
+        tag("leaf", "leaf");
+        tag("root", "<my:leaf/>");
+        Map<Path, String> before = snapshot(tempDir);
+        IllegalStateException sentinel = new IllegalStateException("late setup failure");
+        AtomicInteger setups = new AtomicInteger();
+        Consumer<Converter> setup = value -> {
+            value.setPrefix("");
+            if (setups.incrementAndGet() == 2) {
+                throw sentinel;
+            }
+        };
+
+        assertThat(catchPlanFailure(List.of("my/root.tag", "my/leaf.tag"), setup)).isSameAs(sentinel);
+        assertThat(snapshot(tempDir)).containsExactlyInAnyOrderEntriesOf(before);
+    }
+
+    @Test
+    void jakartaPlannedTemplateMatchesOneTagConversionForAStatefulSetupConverter() throws Throwable {
+        tag("root", "<my:mark/>");
+        tag("leaf", "leaf");
+
+        Object plan = plan(List.of("my/root.tag", "my/leaf.tag"), markSetup(new AtomicInteger()));
+        String planned = writes(plan).get(jteRoot.resolve("my/root.jte"));
+
+        converter.convertTag("my/root.tag", markSetup(new AtomicInteger()));
+
+        assertThat(planned).isEqualTo(Files.readString(jteRoot.resolve("my/root.jte"), StandardCharsets.UTF_8));
+    }
+
+    @Test
+    void jakartaArtifactCommitDoesNotWriteThroughAUsageSymlinkLeavingTheJspRoot() throws Throwable {
+        tag("leaf", "leaf");
+        Path outside = write(tempDir.resolve("outside.jsp"), "<my:leaf/>");
+        byte[] before = Files.readAllBytes(outside);
+        Files.createDirectories(jspRoot);
+        Files.createSymbolicLink(jspRoot.resolve("linked.jsp"), outside);
+
+        Object plan = null;
+        try {
+            plan = plan(List.of("my/leaf.tag"), noPrefix());
+        } catch (RuntimeException rejected) {
+            // Refusing the linked usage file is an acceptable outcome too.
+        }
+        if (plan != null) {
+            assertThat(writes(plan)).doesNotContainKey(outside);
+            commit(plan);
+        }
+
+        assertThat(Files.readAllBytes(outside))
+                .as("a file outside the JSP root is never written, whether the link is skipped or refused")
+                .isEqualTo(before);
+    }
+
+    @Test
+    void jakartaArtifactUnchangedScannedFileWithMalformedBytesIsNotAWrite() throws Throwable {
+        tag("leaf", "leaf");
+        Path untouched = jspRoot.resolve("untouched.jsp");
+        byte[] malformed = {'p', 'l', 'a', 'i', 'n', (byte) 0xC3, '('};
+        Files.createDirectories(untouched.getParent());
+        Files.write(untouched, malformed);
+
+        Object plan = plan(List.of("my/leaf.tag"), noPrefix());
+
+        assertThat(writes(plan)).doesNotContainKey(untouched);
+        commit(plan);
+
+        assertThat(Files.readAllBytes(untouched)).isEqualTo(malformed);
+    }
+
+    private Consumer<Converter> markSetup(AtomicInteger conversions) {
+        return value -> {
+            value.setPrefix("");
+            value.register("my:mark", (jtp, tag, output, bodyConverter) ->
+                    output.append("mark-" + conversions.incrementAndGet()));
+        };
+    }
+
+    @Test
+    void jakartaArtifactDetectsSameTimestampContentChanges() throws Throwable {
+        Path selected = tag("a", "original");
+        Object plan = plan(List.of("my/a.tag"), noPrefix());
+        FileTime timestamp = Files.getLastModifiedTime(selected);
+        write(selected, header() + "changed");
+        Files.setLastModifiedTime(selected, timestamp);
+
+        Throwable failure = catchCommitFailure(plan);
+
+        assertThat(failure.getClass().getSimpleName()).isEqualTo("StaleJspMigrationPlanException");
+        assertThat(new ArrayList<>(collection(failure, "getChangedPaths"))).containsExactly(selected);
+        assertThat(jteRoot.resolve("my/a.jte")).doesNotExist();
+    }
+
+    @Test
+    void jakartaArtifactRejectsInvalidSelectionsWithoutMutation() throws Exception {
+        Path real = tag("a", "a");
+        write(jspRoot.resolve("page.jsp"), "plain");
+        Files.createDirectories(jspRoot.resolve("my/directory.tag"));
+        Map<Path, String> before = snapshot(tempDir);
+
+        assertThat(catchPlanFailure(null)).isInstanceOf(IllegalArgumentException.class);
+        assertThat(catchPlanFailure(List.of("my/a.tag", "my/../my/a.tag")))
+                .isInstanceOf(IllegalArgumentException.class);
+        assertThat(catchPlanFailure(List.of("../outside.tag"))).isInstanceOf(IllegalArgumentException.class);
+        assertThat(catchPlanFailure(List.of(real.toString()))).isInstanceOf(IllegalArgumentException.class);
+        assertThat(catchPlanFailure(List.of("my/directory.tag"))).isInstanceOf(IllegalArgumentException.class);
+        assertThat(catchPlanFailure(List.of("my/page.jsp"))).isInstanceOf(IllegalArgumentException.class);
+        assertThat(catchPlanFailure(List.of("my/missing.tag"))).isInstanceOf(IllegalArgumentException.class);
+        assertThat(catchPlanFailure(List.of(" "))).isInstanceOf(IllegalArgumentException.class);
+        assertThat(catchPlanFailure(Collections.singletonList(null))).isInstanceOf(IllegalArgumentException.class);
+        assertThat(catchPlanFailure(List.of())).isInstanceOf(IllegalArgumentException.class);
+
+        assertThat(snapshot(tempDir)).containsExactlyInAnyOrderEntriesOf(before);
+    }
+
+    @Test
+    void jakartaArtifactChecksUnchangedScannedFilesForStaleness() throws Throwable {
+        tag("a", "a");
+        Path scanned = write(jspRoot.resolve("unchanged.jsp"), "plain");
+        Object plan = plan(List.of("my/a.tag"), noPrefix());
+        write(scanned, "changed");
+
+        Throwable failure = catchCommitFailure(plan);
+
+        assertThat(failure.getClass().getSimpleName()).isEqualTo("StaleJspMigrationPlanException");
+        assertThat(new ArrayList<>(collection(failure, "getChangedPaths"))).containsExactly(scanned);
+        assertThat(tagPath("a")).exists();
+        assertThat(jteRoot.resolve("my/a.jte")).doesNotExist();
+    }
+
+    @Test
+    void jakartaArtifactRejectsExistingDestinationDuringPlanning() throws Exception {
+        tag("a", "a");
+        Path destination = write(jteRoot.resolve("my/a.jte"), "owned");
+
