+package gg.jte.convert.jsp;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+import java.io.IOException;
+import java.net.URL;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.attribute.FileTime;
+import java.util.Arrays;
+import java.util.Collections;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+class JspMigrationPlanTest {
+    @TempDir
+    Path tempDir;
+
+    Path jspRoot;
+    Path jteRoot;
+    JspToJteConverter converter;
+
+    @BeforeEach
+    void setUp() throws IOException {
+        jspRoot = Files.createDirectories(tempDir.resolve("jsp"));
+        jteRoot = tempDir.resolve("jte");
+        write("WEB-INF/test.tld", """
+                <?xml version="1.0" encoding="UTF-8"?>
+                <taglib xmlns="http://java.sun.com/xml/ns/j2ee" version="2.0">
+                  <tlib-version>1.0</tlib-version><short-name>x</short-name><uri>urn:test</uri>
+                  <tag><name>base</name><tag-class>example.JteTag</tag-class><body-content>scriptless</body-content><dynamic-attributes>true</dynamic-attributes></tag>
+                  <tag><name>page</name><tag-class>example.JteTag</tag-class><body-content>scriptless</body-content><dynamic-attributes>true</dynamic-attributes></tag>
+                  <tag><name>a</name><tag-class>example.JteTag</tag-class><body-content>scriptless</body-content><dynamic-attributes>true</dynamic-attributes></tag>
+                  <tag><name>b</name><tag-class>example.JteTag</tag-class><body-content>scriptless</body-content><dynamic-attributes>true</dynamic-attributes></tag>
+                </taglib>
+                """);
+        converter = new JspToJteConverter(jspRoot, jteRoot, "my:jte") {
+            @Override
+            protected URL getResourceBase() {
+                try {
+                    return jspRoot.toUri().toURL();
+                } catch (IOException e) {
+                    throw new RuntimeException(e);
+                }
+            }
+        };
+    }
+
+    @Test
+    void plansAndCommitsDependenciesInDeterministicOrder() throws IOException {
+        write("x/base.tag", "base");
+        write("x/page.tag", "<%@ taglib prefix=\"x\" uri=\"urn:test\" %><x:base/>");
+        Path usage = write("usage.jsp", "<%@ taglib prefix=\"x\" uri=\"urn:test\" %><x:page/><x:base/>");
+
+        JspMigrationPlan plan = converter.planTags(Arrays.asList("x/page.tag", "x/base.tag"), null);
+
+        assertThat(plan.getConversionOrder()).containsExactly(path("x/base.tag"), path("x/page.tag"));
+        assertThat(plan.getDeletes()).containsExactlyInAnyOrder(path("x/base.tag"), path("x/page.tag"));
+        assertThat(plan.getWrites()).containsKeys(jteRoot.resolve("x/base.jte").toAbsolutePath().normalize(), jteRoot.resolve("x/page.jte").toAbsolutePath().normalize(), usage.toAbsolutePath().normalize());
+        assertThat(path("x/base.tag")).exists();
+        assertThat(jteRoot).doesNotExist();
+        assertThatThrownBy(() -> plan.getConversionOrder().add(path("other.tag"))).isInstanceOf(UnsupportedOperationException.class);
+        assertThatThrownBy(() -> plan.getWrites().clear()).isInstanceOf(UnsupportedOperationException.class);
+
+        plan.commit();
+
+        assertThat(path("x/base.tag")).doesNotExist();
+        assertThat(path("x/page.tag")).doesNotExist();
+        assertThat(jteRoot.resolve("x/base.jte")).exists();
+        assertThat(jteRoot.resolve("x/page.jte")).exists();
+        assertThat(Files.readString(usage)).contains("<my:jte jte=\"x/page.jte\"").contains("<my:jte jte=\"x/base.jte\"");
+        assertThatThrownBy(plan::commit).isInstanceOf(IllegalStateException.class);
+    }
+
+    @Test
+    void restoresEarlierMutationsWhenCommitFails() throws IOException {
+        write("a.tag", "a");
+        write("z.tag", "z");
+        JspToJteConverter mappedConverter = new JspToJteConverter(jspRoot, jteRoot, "my:jte") {
+            @Override
+            public String suggestJteFile(String jspFile) {
+                return jspFile.startsWith("a") ? "a.jte" : "z/failing.jte";
+            }
+
+            @Override
+            protected URL getResourceBase() {
+                try {
+                    return jspRoot.toUri().toURL();
+                } catch (IOException e) {
+                    throw new RuntimeException(e);
+                }
+            }
+        };
+        JspMigrationPlan plan = mappedConverter.planTags(Arrays.asList("z.tag", "a.tag"), null);
+        Files.createDirectories(jteRoot);
+        Path blockingParent = Files.writeString(jteRoot.resolve("z"), "unrelated");
+
+        assertThatThrownBy(plan::commit).isInstanceOf(IOException.class);
+
+        assertThat(jteRoot.resolve("a.jte")).doesNotExist();
+        assertThat(path("a.tag")).exists();
+        assertThat(path("z.tag")).exists();
+        assertThat(Files.readString(blockingParent)).isEqualTo("unrelated");
+    }
+
+    @Test
+    void detectsContentStalenessEvenWhenTimestampIsRestored() throws IOException {
+        write("x/base.tag", "base");
+        Path usage = write("usage.jsp", "unchanged");
+        JspMigrationPlan plan = converter.planTags(Collections.singleton("x/base.tag"), null);
+        FileTime timestamp = Files.getLastModifiedTime(usage);
+        Files.writeString(usage, "changed");
+        Files.setLastModifiedTime(usage, timestamp);
+
+        assertThatThrownBy(plan::commit)
+                .isInstanceOfSatisfying(StaleJspMigrationPlanException.class, exception -> assertThat(exception.getChangedPaths()).containsExactly(usage.toAbsolutePath().normalize()));
+        assertThat(path("x/base.tag")).exists();
+        assertThat(jteRoot).doesNotExist();
+    }
+
+    @Test
+    void findsDependenciesInsideApprovedIncludes() throws IOException {
+        write("x/base.tag", "base");
+        write("WEB-INF/fragment.jsp.inc", "<%@ taglib prefix=\"x\" uri=\"urn:test\" %><x:base/>");
+        write("x/page.tag", "<%@ include file=\"/WEB-INF/fragment.jsp.inc\" %>");
+
+        JspMigrationPlan plan = converter.planTags(Arrays.asList("x/page.tag", "x/base.tag"), setup -> setup.addInlinedInclude("/WEB-INF/fragment.jsp.inc"));
+
+        assertThat(plan.getConversionOrder()).containsExactly(path("x/base.tag"), path("x/page.tag"));
+        assertThat(plan.getWrites().get(path("WEB-INF/fragment.jsp.inc"))).contains("<my:jte jte=\"x/base.jte\"");
+    }
+
+    @Test
+    void jspCommentsDoNotCreateDependencies() throws IOException {
+        write("x/a.tag", "<%-- <x:b/> --%>");
+        write("x/b.tag", "b");
+
+        JspMigrationPlan plan = converter.planTags(Arrays.asList("x/b.tag", "x/a.tag"), null);
+
+        assertThat(plan.getConversionOrder()).containsExactly(path("x/a.tag"), path("x/b.tag"));
+    }
+
+    @Test
+    void parserSetupFailureSurfacesUnchanged() throws IOException {
+        write("x/base.tag", "base");
+        RuntimeException failure = new RuntimeException("setup failed");
+
+        assertThatThrownBy(() -> converter.planTags(Collections.singleton("x/base.tag"), setup -> {
+            throw failure;
+        })).isSameAs(failure);
+    }
+
+    @Test
+    void reportsDeterministicClosedCycle() throws IOException {
+        write("x/a.tag", "<%@ taglib prefix=\"x\" uri=\"urn:test\" %><x:b/>");
+        write("x/b.tag", "<%@ taglib prefix=\"x\" uri=\"urn:test\" %><x:a/>");
+
+        assertThatThrownBy(() -> converter.planTags(Arrays.asList("x/b.tag", "x/a.tag"), null))
+                .isInstanceOf(IllegalArgumentException.class)
+                .hasMessageContaining("x/a.tag -> x/b.tag -> x/a.tag");
+    }
+
+    @Test
+    void rejectsInvalidSelectionsAndOutsideIncludes() throws IOException {
+        write("x/base.tag", "base");
+
+        assertThatThrownBy(() -> converter.planTags(Collections.emptyList(), null)).isInstanceOf(IllegalArgumentException.class);
+        assertThatThrownBy(() -> converter.planTags(Arrays.asList("x/base.tag", "x/../x/base.tag"), null)).isInstanceOf(IllegalArgumentException.class);
+        assertThatThrownBy(() -> converter.planTags(Collections.singleton("x/base.jsp"), null)).isInstanceOf(IllegalArgumentException.class);
+        assertThatThrownBy(() -> converter.planTags(Collections.singleton("x/base.tag"), setup -> setup.addInlinedInclude("../outside.jsp.inc")))
+                .isInstanceOf(IllegalArgumentException.class);
+    }
+
+    private Path write(String relative, String content) throws IOException {
+        Path path = path(relative);
+        Files.createDirectories(path.getParent());
+        Files.writeString(path, content);
+        return path;
+    }
+
+    private Path path(String relative) {
+        return jspRoot.resolve(relative).toAbsolutePath().normalize();
+    }
+}
