+package gg.jte.convert.jsp;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.LinkOption;
+import java.nio.file.Path;
+import java.nio.file.StandardOpenOption;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collection;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+public final class JspMigrationPlan {
+    private final List<Path> conversionOrder;
+    private final Set<Path> deletes;
+    private final Map<Path, String> writes;
+    private final Map<Path, Snapshot> snapshots;
+    private boolean committed;
+
+    JspMigrationPlan(Collection<Path> conversionOrder, Collection<Path> deletes, Map<Path, String> writes, Map<Path, Snapshot> snapshots) {
+        this.conversionOrder = List.copyOf(conversionOrder);
+        this.deletes = Collections.unmodifiableSet(new LinkedHashSet<>(deletes));
+        this.writes = Collections.unmodifiableMap(new LinkedHashMap<>(writes));
+        this.snapshots = Collections.unmodifiableMap(new LinkedHashMap<>(snapshots));
+    }
+
+    public List<Path> getConversionOrder() {
+        return conversionOrder;
+    }
+
+    public Set<Path> getDeletes() {
+        return deletes;
+    }
+
+    public Map<Path, String> getWrites() {
+        return writes;
+    }
+
+    public synchronized void commit() throws IOException {
+        if (committed) {
+            throw new IllegalStateException("This JSP migration plan has already been committed.");
+        }
+
+        List<Path> changedPaths = findChangedPaths();
+        if (!changedPaths.isEmpty()) {
+            throw new StaleJspMigrationPlanException(changedPaths);
+        }
+
+        Map<Path, Snapshot> originalStates = new LinkedHashMap<>();
+        for (Path path : affectedPaths()) {
+            originalStates.put(path, Snapshot.captureIfPresent(path));
+        }
+        List<Path> createdDirectories = findMissingDirectories(writes.keySet());
+
+        boolean mutationStarted = false;
+        try {
+            for (Map.Entry<Path, String> write : writes.entrySet()) {
+                mutationStarted = true;
+                Path parent = write.getKey().getParent();
+                if (parent != null) {
+                    Files.createDirectories(parent);
+                }
+                Files.write(write.getKey(), write.getValue().getBytes(StandardCharsets.UTF_8), StandardOpenOption.CREATE, StandardOpenOption.TRUNCATE_EXISTING, StandardOpenOption.WRITE);
+            }
+            for (Path delete : deletes) {
+                mutationStarted = true;
+                Files.delete(delete);
+            }
+            committed = true;
+        } catch (IOException failure) {
+            if (mutationStarted) {
+                restore(originalStates, createdDirectories, failure);
+            }
+            throw failure;
+        }
+    }
+
+    private List<Path> findChangedPaths() {
+        Set<Path> changedPaths = new LinkedHashSet<>();
+        for (Map.Entry<Path, Snapshot> entry : snapshots.entrySet()) {
+            if (!entry.getValue().matches(entry.getKey())) {
+                changedPaths.add(entry.getKey());
+            }
+        }
+        for (Path destination : writes.keySet()) {
+            if (!snapshots.containsKey(destination) && Files.exists(destination, LinkOption.NOFOLLOW_LINKS)) {
+                changedPaths.add(destination);
+            }
+        }
+        List<Path> result = new ArrayList<>(changedPaths);
+        result.sort(Comparator.comparing(Path::toString));
+        return result;
+    }
+
+    private Set<Path> affectedPaths() {
+        Set<Path> result = new LinkedHashSet<>(writes.keySet());
+        result.addAll(deletes);
+        return result;
+    }
+
+    private static List<Path> findMissingDirectories(Collection<Path> paths) {
+        Set<Path> missing = new LinkedHashSet<>();
+        for (Path path : paths) {
+            Path parent = path.getParent();
+            while (parent != null && !Files.exists(parent, LinkOption.NOFOLLOW_LINKS)) {
+                missing.add(parent);
+                parent = parent.getParent();
+            }
+        }
+        List<Path> result = new ArrayList<>(missing);
+        result.sort(Comparator.comparingInt(Path::getNameCount));
+        return result;
+    }
+
+    private static void restore(Map<Path, Snapshot> originalStates, List<Path> createdDirectories, IOException failure) {
+        List<Map.Entry<Path, Snapshot>> states = new ArrayList<>(originalStates.entrySet());
+        Collections.reverse(states);
+        for (Map.Entry<Path, Snapshot> state : states) {
+            try {
+                state.getValue().restore(state.getKey());
+            } catch (IOException restorationFailure) {
+                failure.addSuppressed(restorationFailure);
+            }
+        }
+
+        createdDirectories.sort(Comparator.comparingInt(Path::getNameCount).reversed());
+        for (Path directory : createdDirectories) {
+            try {
+                Files.deleteIfExists(directory);
+            } catch (IOException restorationFailure) {
+                failure.addSuppressed(restorationFailure);
+            }
+        }
+    }
+
+    static final class Snapshot {
+        private final byte[] bytes;
+        private final boolean symbolicLink;
+        private final boolean present;
+
+        private Snapshot(byte[] bytes, boolean symbolicLink, boolean present) {
+            this.bytes = bytes;
+            this.symbolicLink = symbolicLink;
+            this.present = present;
+        }
+
+        static Snapshot capture(Path path) throws IOException {
+            return new Snapshot(Files.readAllBytes(path), Files.isSymbolicLink(path), true);
+        }
+
+        static Snapshot captureIfPresent(Path path) throws IOException {
+            if (!Files.exists(path, LinkOption.NOFOLLOW_LINKS)) {
+                return new Snapshot(null, false, false);
+            }
+            return capture(path);
+        }
+
+        byte[] getBytes() {
+            return bytes.clone();
+        }
+
+        boolean matches(Path path) {
+            if (!present || !Files.exists(path, LinkOption.NOFOLLOW_LINKS) || symbolicLink != Files.isSymbolicLink(path)) {
+                return false;
+            }
+            try {
+                return Arrays.equals(bytes, Files.readAllBytes(path));
+            } catch (IOException e) {
+                return false;
+            }
+        }
+
+        void restore(Path path) throws IOException {
+            if (!present) {
+                Files.deleteIfExists(path);
+                return;
+            }
+            Path parent = path.getParent();
+            if (parent != null) {
+                Files.createDirectories(parent);
+            }
+            Files.write(path, bytes, StandardOpenOption.CREATE, StandardOpenOption.TRUNCATE_EXISTING, StandardOpenOption.WRITE);
+        }
+    }
+}
