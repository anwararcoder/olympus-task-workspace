+    private Map<Path, byte[]> snapshotUsageFiles(Path absoluteJspRoot) {
+        Map<Path, byte[]> result = new LinkedHashMap<>();
+        try (Stream<Path> stream = Files.walk(absoluteJspRoot)) {
+            stream.filter(path -> Files.isRegularFile(path, LinkOption.NOFOLLOW_LINKS))
+                    .filter(this::isUsageFile)
+                    .sorted(Comparator.comparing(Path::toString))
+                    .forEach(path -> result.put(path.toAbsolutePath().normalize(), readBytes(path)));
+        } catch (IOException failure) {
+            throw new IllegalArgumentException("Failed to scan JSP usages under " + absoluteJspRoot, failure);
+        }
+        return result;
+    }
+
+    private boolean isUsageFile(Path path) {
+        String fileName = path.getFileName().toString();
+        return fileName.endsWith(".jsp") || fileName.endsWith(".jsp.inc") || fileName.endsWith(".tag");
+    }
