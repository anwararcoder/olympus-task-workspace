+        assertThatThrownBy(plan::commit)
+                .isInstanceOfSatisfying(StaleJspMigrationPlanException.class, failure ->
+                        assertThat(failure.getChangedPaths()).containsExactly(selected, usage));
+        assertThat(jteRoot).doesNotExist();
+        assertThat(selected).exists();
+    }
