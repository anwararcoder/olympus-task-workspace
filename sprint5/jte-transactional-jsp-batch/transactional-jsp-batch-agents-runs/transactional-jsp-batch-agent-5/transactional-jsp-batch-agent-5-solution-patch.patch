+    @Test
+    void rollsBackMutationsAndCreatedDirectories() throws Exception {
+        Path jspRoot = Files.createDirectories(tempDir.resolve("jsp"));
+        Path jteRoot = tempDir.resolve("jte");
+        Path first = write(jspRoot.resolve("first.tag"), "first");
+        Path second = write(jspRoot.resolve("second.tag"), "second");
+        AtomicInteger writes = new AtomicInteger();
+        JspToJteConverter converter = new TestConverter(jspRoot, jteRoot) {
+            @Override
+            protected void writeMigrationFile(Path path, byte[] content) throws IOException {
+                if (writes.incrementAndGet() == 2) {
+                    throw new IOException("planned failure");
+                }
+                super.writeMigrationFile(path, content);
+            }
+        };
+        JspMigrationPlan plan = converter.planTags(List.of("first.tag", "second.tag"), null);
+
+        assertThatThrownBy(plan::commit).isInstanceOf(IOException.class).hasMessage("planned failure");
+        assertThat(first).content().isEqualTo("first");
+        assertThat(second).content().isEqualTo("second");
+        assertThat(jteRoot).doesNotExist();
+    }
+
+    @Test
+    void rejectsCyclesWithClosedDeterministicPath() throws Exception {
+        Path jspRoot = Files.createDirectories(tempDir.resolve("jsp"));
+        Path tags = Files.createDirectories(jspRoot.resolve("my"));
+        installTld(jspRoot);
+        write(tags.resolve("a.tag"), "<%@ taglib uri=\"/WEB-INF/tld/my.tld\" prefix=\"my\" %><my:b/>");
+        write(tags.resolve("b.tag"), "<%@ taglib uri=\"/WEB-INF/tld/my.tld\" prefix=\"my\" %><my:a/>");
+
+        assertThatThrownBy(() -> converter(jspRoot, tempDir.resolve("jte")).planTags(List.of("my/b.tag", "my/a.tag"), null))
+                .isInstanceOf(IllegalArgumentException.class)
+                .hasMessageContaining("my/a.tag -> my/b.tag -> my/a.tag");
+    }
+
+    @Test
+    void findsDependenciesInApprovedIncludesButNotJspComments() throws Exception {
+        Path jspRoot = Files.createDirectories(tempDir.resolve("jsp"));
+        Path tags = Files.createDirectories(jspRoot.resolve("my"));
+        installTld(jspRoot);
+        Path included = write(jspRoot.resolve("fragment.jsp.inc"),
+                "<%@ taglib uri=\"/WEB-INF/tld/my.tld\" prefix=\"my\" %><my:b/>");
+        Path first = write(tags.resolve("a.tag"), "<%@ include file=\"/fragment.jsp.inc\" %><%-- <my:a/> --%>");
+        Path second = write(tags.resolve("b.tag"), "second");
+
+        JspMigrationPlan plan = converter(jspRoot, tempDir.resolve("jte")).planTags(
+                List.of("my/a.tag", "my/b.tag"), converter -> converter.addInlinedInclude("/fragment.jsp.inc"));
+
+        assertThat(plan.getConversionOrder()).containsExactly(second, first);
+        write(included, "changed");
+        assertThatThrownBy(plan::commit)
+                .isInstanceOfSatisfying(StaleJspMigrationPlanException.class, failure ->
+                        assertThat(failure.getChangedPaths()).containsExactly(included));
+    }
