+    private Path resolveApprovedInclude(URL resourceBase, String include, Path absoluteJspRoot) {
+        if (include == null || include.trim().isEmpty()) {
+            throw new IllegalArgumentException("Approved include paths must not be null or blank.");
+        }
+        try {
+            Path resourceRoot = Paths.get(resourceBase.toURI()).toAbsolutePath().normalize();
+            String relativeInclude = include.startsWith("/") || include.startsWith("\\")
+                    ? include.substring(1) : include;
+            Path resolved = resourceRoot.resolve(relativeInclude).normalize().toAbsolutePath();
+            if (!resolved.startsWith(absoluteJspRoot)) {
+                throw new IllegalArgumentException("Approved include is outside the JSP root: " + include);
+            }
+            Path realJspRoot = absoluteJspRoot.toRealPath();
+            Path realInclude = resolved.toRealPath();
+            if (!realInclude.startsWith(realJspRoot)) {
+                throw new IllegalArgumentException("Approved include is outside the JSP root: " + include);
+            }
+            return resolved;
+        } catch (IllegalArgumentException failure) {
+            throw failure;
+        } catch (IOException | URISyntaxException | RuntimeException failure) {
+            throw new IllegalArgumentException("Invalid approved include path: " + include, failure);
+        }
+    }
