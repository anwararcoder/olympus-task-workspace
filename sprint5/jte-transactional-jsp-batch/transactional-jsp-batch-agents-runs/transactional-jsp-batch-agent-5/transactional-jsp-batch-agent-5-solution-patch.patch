+    private Map<String, Path> selectedInvocationNames(Collection<Path> selectedTags) {
+        Map<String, Path> result = new TreeMap<>();
+        for (Path selectedTag : selectedTags) {
+            String invocation = invocationName(selectedTag);
+            Path previous = result.putIfAbsent(invocation, selectedTag);
+            if (previous != null) {
+                throw new IllegalArgumentException("Ambiguous selected invocation name <" + invocation
+                        + "> for " + previous + " and " + selectedTag);
+            }
+        }
+        return result;
+    }
