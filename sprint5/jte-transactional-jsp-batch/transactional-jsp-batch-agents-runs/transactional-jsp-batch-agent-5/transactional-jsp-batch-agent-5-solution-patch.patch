+    private String replaceUsages(String content, String oldJspTagPrefix, String oldJspTagClosing, String newJteFile) {
+        StringBuilder jspContent = new StringBuilder(content);
+        int lastIndex = 0;
+        while ((lastIndex = jspContent.indexOf(oldJspTagPrefix, lastIndex)) >= 0) {
+            int suffixIndex = lastIndex + oldJspTagPrefix.length();
+            if (suffixIndex < jspContent.length()) {
+                char character = jspContent.charAt(suffixIndex);
+                if (Character.isWhitespace(character) || character == '/' || character == '>') {
+                    String replacement = "<" + jteTag + " jte=\"" + newJteFile + "\"";
+                    jspContent.replace(lastIndex, suffixIndex, replacement);
+                    lastIndex += replacement.length();
+                    continue;
+                }
+            }
+            lastIndex++;
+        }
+        lastIndex = 0;
+        String newClosing = "</" + jteTag + ">";
+        while ((lastIndex = jspContent.indexOf(oldJspTagClosing, lastIndex)) >= 0) {
+            jspContent.replace(lastIndex, lastIndex + oldJspTagClosing.length(), newClosing);
+            lastIndex += newClosing.length();
+        }
+        return jspContent.toString();
+    }
