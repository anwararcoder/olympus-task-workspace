+    @Test
+    void surfacesParserSetupFailureUnchanged() throws Exception {
+        Path jspRoot = Files.createDirectories(tempDir.resolve("jsp"));
+        write(jspRoot.resolve("simple.tag"), "simple");
+        IllegalStateException expected = new IllegalStateException("setup failed");
+
+        assertThatThrownBy(() -> converter(jspRoot, tempDir.resolve("jte")).planTags(
+                List.of("simple.tag"), converter -> { throw expected; }))
+                .isSameAs(expected);
+    }
+
+    private void installTld(Path jspRoot) throws IOException {
+        write(jspRoot.resolve("WEB-INF/tld/my.tld"), """
+                <?xml version="1.0" encoding="UTF-8" ?>
+                <taglib xmlns="http://java.sun.com/xml/ns/j2ee" version="2.0">
+                    <tlib-version>1.0</tlib-version>
+                    <short-name>my</short-name>
+                    <uri>urn:my</uri>
+                    <tag><name>dependency</name><tag-class>example.JteTag</tag-class><body-content>scriptless</body-content><dynamic-attributes>true</dynamic-attributes></tag>
+                    <tag><name>parent</name><tag-class>example.JteTag</tag-class><body-content>scriptless</body-content><dynamic-attributes>true</dynamic-attributes></tag>
+                    <tag><name>a</name><tag-class>example.JteTag</tag-class><body-content>scriptless</body-content><dynamic-attributes>true</dynamic-attributes></tag>
+                    <tag><name>b</name><tag-class>example.JteTag</tag-class><body-content>scriptless</body-content><dynamic-attributes>true</dynamic-attributes></tag>
+                </taglib>
+                """);
+    }
+
+    private JspToJteConverter converter(Path jspRoot, Path jteRoot) {
+        return new TestConverter(jspRoot, jteRoot);
+    }
+
+    private Path write(Path path, String content) throws IOException {
+        Files.createDirectories(path.getParent());
+        Files.write(path, content.getBytes(StandardCharsets.UTF_8));
+        return path.toAbsolutePath().normalize();
+    }
+
+    private static class TestConverter extends JspToJteConverter {
+        private final Path jspRoot;
+
+        private TestConverter(Path jspRoot, Path jteRoot) {
+            super(jspRoot, jteRoot, "my:jte");
+            this.jspRoot = jspRoot;
+        }
+
+        @Override
+        protected URL getResourceBase() {
+            try {
+                return jspRoot.toUri().toURL();
+            } catch (MalformedURLException failure) {
+                throw new IllegalStateException(failure);
+            }
+        }
+    }
+}
