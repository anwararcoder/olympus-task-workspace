+    private SortedMap<String, Path> normalizeSelectedTags(Collection<String> jspTags, Path absoluteJspRoot) {
+        SortedMap<String, Path> result = new TreeMap<>();
+        Set<Path> normalizedPaths = new HashSet<>();
+        for (String jspTag : jspTags) {
+            if (jspTag == null || jspTag.trim().isEmpty()) {
+                throw new IllegalArgumentException("JSP tag paths must not be null or blank.");
+            }
+            Path relative;
+            try {
+                relative = Paths.get(jspTag);
+            } catch (RuntimeException failure) {
+                throw new IllegalArgumentException("Invalid JSP tag path: " + jspTag, failure);
+            }
+            if (relative.isAbsolute()) {
+                throw new IllegalArgumentException("JSP tag paths must be root-relative: " + jspTag);
+            }
+            Path selectedTag = absoluteJspRoot.resolve(relative).normalize();
+            if (!selectedTag.startsWith(absoluteJspRoot)) {
+                throw new IllegalArgumentException("JSP tag path is outside the JSP root: " + jspTag);
+            }
+            if (!selectedTag.getFileName().toString().endsWith(".tag")) {
+                throw new IllegalArgumentException("Only .tag files can be planned: " + jspTag);
+            }
+            if (!normalizedPaths.add(selectedTag)) {
+                throw new IllegalArgumentException("Duplicate normalized JSP tag path: " + jspTag);
+            }
+            if (Files.isSymbolicLink(selectedTag)) {
+                throw new IllegalArgumentException("Selected JSP tag must not be a symbolic link: " + jspTag);
+            }
+            if (!Files.isRegularFile(selectedTag, LinkOption.NOFOLLOW_LINKS)) {
+                throw new IllegalArgumentException("Selected JSP tag is missing or not a regular file: " + jspTag);
+            }
+            String normalizedRelative = absoluteJspRoot.relativize(selectedTag).toString().replace('\\', '/');
+            result.put(normalizedRelative, selectedTag);
+        }
+        return result;
+    }
