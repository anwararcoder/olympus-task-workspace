+public final class JspMigrationPlan {
+    private final JspToJteConverter converter;
+    private final List<Path> conversionOrder;
+    private final Map<Path, String> writes;
+    private final Set<Path> deletes;
+    private final Map<Path, byte[]> snapshot;
+    private final Set<Path> generatedDestinations;
+    private boolean committed;
+
+    JspMigrationPlan(JspToJteConverter converter, List<Path> conversionOrder, Map<Path, String> writes, Set<Path> deletes,
+                     Map<Path, byte[]> snapshot, Set<Path> generatedDestinations) {
+        this.converter = converter;
+        this.conversionOrder = List.copyOf(conversionOrder);
+        this.writes = Collections.unmodifiableMap(new LinkedHashMap<>(writes));
+        this.deletes = Collections.unmodifiableSet(new LinkedHashSet<>(deletes));
+        this.snapshot = copySnapshot(snapshot);
+        this.generatedDestinations = Set.copyOf(generatedDestinations);
+    }
+
+    public List<Path> getConversionOrder() {
+        return conversionOrder;
+    }
+
+    public Map<Path, String> getWrites() {
+        return writes;
+    }
+
+    public Set<Path> getDeletes() {
+        return deletes;
+    }
+
+    public synchronized void commit() throws IOException {
+        if (committed) {
+            throw new IllegalStateException("This JSP migration plan has already been committed.");
+        }
+
+        List<Path> changedPaths = findChangedPaths();
+        if (!changedPaths.isEmpty()) {
+            throw new StaleJspMigrationPlanException(changedPaths);
+        }
+
+        Map<Path, byte[]> originals = new LinkedHashMap<>();
+        Set<Path> absentPaths = new LinkedHashSet<>();
+        List<Path> createdDirectories = new ArrayList<>();
+        boolean mutationStarted = false;
+
+        try {
+            Set<Path> affectedPaths = new LinkedHashSet<>();
+            affectedPaths.addAll(writes.keySet());
+            affectedPaths.addAll(deletes);
+            for (Path path : affectedPaths) {
+                if (Files.exists(path, LinkOption.NOFOLLOW_LINKS)) {
+                    originals.put(path, Files.readAllBytes(path));
+                } else {
+                    absentPaths.add(path);
+                }
+            }
+
+            for (Map.Entry<Path, String> write : writes.entrySet()) {
+                mutationStarted = true;
+                createDirectories(write.getKey().getParent(), createdDirectories);
+                converter.writeMigrationFile(write.getKey(), write.getValue().getBytes(StandardCharsets.UTF_8));
+            }
+            for (Path delete : deletes) {
+                mutationStarted = true;
+                converter.deleteMigrationFile(delete);
+            }
+            committed = true;
+        } catch (IOException failure) {
+            if (mutationStarted) {
+                restore(originals, absentPaths, createdDirectories, failure);
+            }
+            throw failure;
+        }
+    }
+
+    private List<Path> findChangedPaths() {
+        Set<Path> changed = new LinkedHashSet<>();
+        for (Map.Entry<Path, byte[]> entry : snapshot.entrySet()) {
+            try {
+                if (!Files.isRegularFile(entry.getKey())
+                        || !Arrays.equals(entry.getValue(), Files.readAllBytes(entry.getKey()))) {
+                    changed.add(entry.getKey());
+                }
+            } catch (IOException ignored) {
+                changed.add(entry.getKey());
+            }
+        }
+        for (Path destination : generatedDestinations) {
+            if (Files.exists(destination, LinkOption.NOFOLLOW_LINKS)) {
+                changed.add(destination);
+            }
+        }
+        List<Path> result = new ArrayList<>(changed);
+        result.sort(Comparator.comparing(Path::toString));
+        return result;
+    }
+
+    private void createDirectories(Path directory, List<Path> createdDirectories) throws IOException {
+        List<Path> missing = new ArrayList<>();
+        Path current = directory;
+        while (current != null && !Files.exists(current, LinkOption.NOFOLLOW_LINKS)) {
+            missing.add(current);
+            current = current.getParent();
+        }
+        Collections.reverse(missing);
+        for (Path path : missing) {
+            converter.createMigrationDirectory(path);
+            createdDirectories.add(path);
+        }
+    }
+
+    private void restore(Map<Path, byte[]> originals, Set<Path> absentPaths,
+                         List<Path> createdDirectories, IOException failure) {
+        for (Path path : absentPaths) {
+            try {
+                converter.deleteMigrationFileIfExists(path);
+            } catch (IOException restorationFailure) {
+                failure.addSuppressed(restorationFailure);
+            }
+        }
+        for (Map.Entry<Path, byte[]> original : originals.entrySet()) {
+            try {
+                Files.createDirectories(original.getKey().getParent());
+                converter.writeMigrationFile(original.getKey(), original.getValue());
+            } catch (IOException restorationFailure) {
+                failure.addSuppressed(restorationFailure);
+            }
+        }
+        for (int i = createdDirectories.size() - 1; i >= 0; i--) {
+            try {
+                converter.deleteMigrationFile(createdDirectories.get(i));
+            } catch (NoSuchFileException ignored) {
+            } catch (IOException restorationFailure) {
+                failure.addSuppressed(restorationFailure);
+            }
+        }
+    }
+
+    private static Map<Path, byte[]> copySnapshot(Map<Path, byte[]> snapshot) {
+        Map<Path, byte[]> result = new LinkedHashMap<>();
+        snapshot.forEach((path, bytes) -> result.put(path, bytes.clone()));
+        return Collections.unmodifiableMap(result);
+    }
+}
