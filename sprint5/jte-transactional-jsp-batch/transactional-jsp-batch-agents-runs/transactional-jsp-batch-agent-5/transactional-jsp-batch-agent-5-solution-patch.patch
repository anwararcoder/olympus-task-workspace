+    private List<Path> orderByDependencies(Collection<Path> selectedTags, Map<Path, Set<Path>> dependencies,
+                                            Path absoluteJspRoot) {
+        Set<Path> remaining = new TreeSet<>(Comparator.comparing(Path::toString));
+        remaining.addAll(selectedTags);
+        Set<Path> converted = new HashSet<>();
+        List<Path> result = new ArrayList<>();
+        while (!remaining.isEmpty()) {
+            Path next = null;
+            for (Path candidate : remaining) {
+                if (converted.containsAll(dependencies.get(candidate))) {
+                    next = candidate;
+                    break;
+                }
+            }
+            if (next == null) {
+                throw new IllegalArgumentException("Cyclic JSP tag dependency: "
+                        + formatCycle(findCycle(remaining, dependencies), absoluteJspRoot));
+            }
+            remaining.remove(next);
+            converted.add(next);
+            result.add(next);
+        }
+        return result;
+    }
+
+    private List<Path> findCycle(Set<Path> remaining, Map<Path, Set<Path>> dependencies) {
+        Path current = remaining.iterator().next();
+        List<Path> path = new ArrayList<>();
+        Map<Path, Integer> indexes = new HashMap<>();
+        while (true) {
+            Integer cycleStart = indexes.get(current);
+            if (cycleStart != null) {
+                List<Path> cycle = new ArrayList<>(path.subList(cycleStart, path.size()));
+                cycle.add(current);
+                return cycle;
+            }
+            indexes.put(current, path.size());
+            path.add(current);
+            current = dependencies.get(current).stream()
+                    .filter(remaining::contains)
+                    .min(Comparator.comparing(Path::toString))
+                    .orElseThrow(() -> new IllegalStateException("Failed to locate dependency cycle."));
+        }
+    }
+
+    private String formatCycle(List<Path> cycle, Path absoluteJspRoot) {
+        List<String> relative = new ArrayList<>();
+        for (Path path : cycle) {
+            relative.add(absoluteJspRoot.relativize(path).toString().replace('\\', '/'));
+        }
+        return String.join(" -> ", relative);
+    }
+
+    private Map<Path, Path> validateDestinations(List<Path> conversionOrder, Path absoluteJspRoot,
+                                                 Path absoluteJteRoot) {
+        Map<Path, Path> result = new LinkedHashMap<>();
+        Set<Path> destinations = new HashSet<>();
+        for (Path selectedTag : conversionOrder) {
+            String relativeTag = absoluteJspRoot.relativize(selectedTag).toString().replace('\\', '/');
+            String suggestion = suggestJteFile(relativeTag);
+            if (suggestion == null || suggestion.trim().isEmpty()) {
+                throw new IllegalArgumentException("Generated JTE destination must not be null or blank for " + relativeTag);
+            }
+            Path suggestedPath = Paths.get(suggestion);
+            if (suggestedPath.isAbsolute()) {
+                throw new IllegalArgumentException("Generated JTE destination is outside the JTE root: " + suggestion);
+            }
+            Path destination = absoluteJteRoot.resolve(suggestedPath).normalize();
+            if (!destination.startsWith(absoluteJteRoot)) {
+                throw new IllegalArgumentException("Generated JTE destination is outside the JTE root: " + suggestion);
+            }
+            if (!destinations.add(destination)) {
+                throw new IllegalArgumentException("Generated JTE destinations collide at " + destination);
+            }
+            if (Files.exists(destination, LinkOption.NOFOLLOW_LINKS)) {
+                throw new IllegalArgumentException("Generated JTE destination is already taken: " + destination);
+            }
+            validateDestinationParents(destination.getParent(), absoluteJteRoot);
+            result.put(selectedTag, destination);
+        }
+        return result;
+    }
+
+    private void validateDestinationParents(Path parent, Path absoluteJteRoot) {
+        Path current = parent;
+        while (current != null && current.startsWith(absoluteJteRoot)) {
+            if (Files.isSymbolicLink(current)) {
+                throw new IllegalArgumentException("Generated JTE destination has a symbolic-link parent: " + current);
+            }
+            if (Files.exists(current, LinkOption.NOFOLLOW_LINKS)
+                    && !Files.isDirectory(current, LinkOption.NOFOLLOW_LINKS)) {
+                throw new IllegalArgumentException("Generated JTE destination path is already taken: " + current);
+            }
+            if (current.equals(absoluteJteRoot)) {
+                break;
+            }
+            current = current.getParent();
+        }
+    }
