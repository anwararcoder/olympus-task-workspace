+package gg.jte.convert.jsp;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+import java.io.IOException;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.attribute.FileTime;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.concurrent.atomic.AtomicInteger;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+import static org.assertj.core.api.Assertions.catchThrowable;
+
+class JspMigrationPlanTest {
+    @TempDir
+    Path tempDir;
+
+    Path jspRoot;
+    Path jteRoot;
+
+    @BeforeEach
+    void setUp() throws IOException {
+        jspRoot = Files.createDirectories(tempDir.resolve("jsp"));
+        jteRoot = Files.createDirectories(tempDir.resolve("jte"));
+    }
+
+    @Test
+    void plansAndCommitsDependenciesBeforeDependents() throws IOException {
+        Path dependency = write("my/dependency.tag", "dependency");
+        Path parent = write("my/parent.tag", "<my:dependency/>");
+        Path usage = write("usage.jsp", "<my:parent/>");
+        TestConverter converter = new TestConverter();
+
+        JspMigrationPlan plan = converter.planTags(Arrays.asList("my/parent.tag", "my/dependency.tag"), null);
+
+        assertThat(plan.getConversionOrder()).containsExactly(dependency, parent);
+        assertThat(plan.getDeletes()).containsExactlyInAnyOrder(dependency, parent);
+        assertThat(plan.getWrites()).containsKeys(jteRoot.resolve("my/dependency.jte"), jteRoot.resolve("my/parent.jte"), usage);
+        assertThat(Files.readString(parent)).isEqualTo("<my:dependency/>");
+        assertThatThrownBy(() -> plan.getConversionOrder().add(parent)).isInstanceOf(UnsupportedOperationException.class);
+        assertThatThrownBy(() -> plan.getWrites().clear()).isInstanceOf(UnsupportedOperationException.class);
+
+        plan.commit();
+
+        assertThat(dependency).doesNotExist();
+        assertThat(parent).doesNotExist();
+        assertThat(jteRoot.resolve("my/dependency.jte")).exists();
+        assertThat(jteRoot.resolve("my/parent.jte")).exists();
+        assertThat(Files.readString(usage)).contains("<my:jte jte=\"my/parent.jte\"");
+        assertThatThrownBy(plan::commit).isInstanceOf(IllegalStateException.class);
+    }
+
+    @Test
+    void findsDependenciesInsideApprovedVirtualIncludes() throws IOException {
+        Path dependency = write("my/dependency.tag", "dependency");
+        Path parent = write("my/parent.tag", "<%@ include file=\"/WEB-INF/include.jsp.inc\" %>");
+        write("WEB-INF/include.jsp.inc", "<my:dependency/>");
+
+        JspMigrationPlan plan = new TestConverter().planTags(
+                Arrays.asList("my/parent.tag", "my/dependency.tag"),
+                converter -> converter.addInlinedInclude("/WEB-INF/include.jsp.inc")
+        );
+
+        assertThat(plan.getConversionOrder()).containsExactly(dependency, parent);
+        assertThat(plan.getWrites().get(jteRoot.resolve("my/parent.jte"))).contains("my/dependency.jte");
+    }
+
+    @Test
+    void detectsContentStalenessEvenWhenTimestampIsRestored() throws IOException {
+        Path tag = write("my/simple.tag", "before");
+        JspMigrationPlan plan = new TestConverter().planTags(Collections.singletonList("my/simple.tag"), null);
+        FileTime plannedTime = Files.getLastModifiedTime(tag);
+        Files.writeString(tag, "changed", StandardCharsets.UTF_8);
+        Files.setLastModifiedTime(tag, plannedTime);
+
+        Throwable thrown = catchThrowable(plan::commit);
+
+        assertThat(thrown).isInstanceOf(StaleJspMigrationPlanException.class);
+        assertThat(((StaleJspMigrationPlanException) thrown).getChangedPaths()).containsExactly(tag);
+        assertThat(jteRoot.resolve("my/simple.jte")).doesNotExist();
+    }
+
+    @Test
+    void rollsBackAnIoFailureAfterMutationStarts() throws IOException {
+        Path first = write("my/a.tag", "a");
+        Path second = write("my/b.tag", "b");
+        JspMigrationPlan plan = new TestConverter() {
+            @Override
+            public String suggestJteFile(String jspFile) {
+                return jspFile.endsWith("a.tag") ? "a.jte" : "blocked/b.jte";
+            }
+        }.planTags(Arrays.asList("my/a.tag", "my/b.tag"), null);
+        Files.writeString(jteRoot.resolve("blocked"), "not a directory", StandardCharsets.UTF_8);
+
+        assertThatThrownBy(plan::commit).isInstanceOf(IOException.class);
+
+        assertThat(first).hasContent("a");
+        assertThat(second).hasContent("b");
+        assertThat(jteRoot.resolve("a.jte")).doesNotExist();
+        assertThat(jteRoot.resolve("blocked")).hasContent("not a directory");
+    }
+
+    @Test
+    void parserSetupFailureSurfacesUnchanged() throws IOException {
+        write("my/simple.tag", "simple");
+        RuntimeException failure = new RuntimeException("setup failed");
+
+        Throwable thrown = catchThrowable(() -> new TestConverter().planTags(
+                Collections.singletonList("my/simple.tag"), converter -> { throw failure; }
+        ));
+
+        assertThat(thrown).isSameAs(failure);
+    }
+
+    @Test
+    void parserSetupRunsOnceForEverySelectedTag() throws IOException {
+        write("my/a.tag", "a");
+        write("my/b.tag", "b");
+        AtomicInteger setupCalls = new AtomicInteger();
+
+        new TestConverter().planTags(Arrays.asList("my/a.tag", "my/b.tag"), converter -> setupCalls.incrementAndGet());
+
+        assertThat(setupCalls).hasValue(2);
+    }
+
+    private Path write(String relative, String content) throws IOException {
+        Path path = jspRoot.resolve(relative);
+        Files.createDirectories(path.getParent());
+        Files.writeString(path, content, StandardCharsets.UTF_8);
+        return path.toAbsolutePath().normalize();
+    }
+
+    private class TestConverter extends JspToJteConverter {
+        TestConverter() {
+            super(jspRoot, jteRoot, "my:jte");
+        }
+
+        @Override
+        protected URL getResourceBase() {
+            try {
+                return jspRoot.toUri().toURL();
+            } catch (IOException e) {
+                throw new RuntimeException(e);
+            }
+        }
+
+        @Override
+        protected void checkDependencies(String jteCode) {
+        }
+    }
+}
