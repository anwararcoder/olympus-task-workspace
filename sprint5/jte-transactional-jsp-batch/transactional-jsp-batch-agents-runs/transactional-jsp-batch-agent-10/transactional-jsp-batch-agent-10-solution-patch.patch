+        this.writes = Collections.unmodifiableMap(new LinkedHashMap<>(writes));
+        this.snapshots = copySnapshots(snapshots);
+        this.generatedDestinations = Collections.unmodifiableSet(new LinkedHashSet<>(generatedDestinations));
+    }
+
+    static JspMigrationPlan create(JspToJteConverter owner, Collection<String> requestedTags, Consumer<Converter> parserSetup) {
+        Path jspRoot = owner.getJspRootPath().toAbsolutePath().normalize();
+        Path jteRoot = owner.getJteRootPath().toAbsolutePath().normalize();
+        List<Path> selected = validateSelected(jspRoot, requestedTags);
+        Map<Path, byte[]> snapshots = scanUsageFiles(owner, jspRoot);
+        for (Path path : selected) {
+            snapshots.putIfAbsent(path, readBytes(path));
+        }
+
+        Map<String, Path> invocationNames = selectedInvocationNames(owner, selected);
+        Map<Path, Path> destinations = validateDestinations(owner, jteRoot, selected);
+        Map<Path, TagContext> contexts = createContexts(owner, selected, parserSetup);
+        Map<Path, Set<Path>> dependencies = analyzeDependencies(owner, jspRoot, selected, invocationNames, snapshots, contexts);
+        List<Path> order = conversionOrder(jspRoot, selected, dependencies);
+
+        Map<Path, String> virtualFiles = new LinkedHashMap<>();
+        snapshots.forEach((path, bytes) -> virtualFiles.put(path, new String(bytes, StandardCharsets.UTF_8)));
+        contexts.forEach((path, context) -> virtualFiles.put(path, context.source));
+
+        Map<Path, String> writes = new LinkedHashMap<>();
+        Set<Path> selectedSet = new HashSet<>(selected);
+        List<Path> virtualPaths = new ArrayList<>(virtualFiles.keySet());
+        virtualPaths.sort(PATH_ORDER);
+        for (Path source : order) {
+            String relative = slash(jspRoot.relativize(source));
+            TagContext context = contexts.get(source);
+            JtpConverter converter = owner.createConverter(relative, virtualFiles.get(source), context.setup,
+                    Collections.emptySet(), context.resourceBase, context.notConvertedTags);
+            addVirtualIncludes(owner, jspRoot, converter, virtualFiles, snapshots);
+            String jte = converter.convert();
+            owner.checkDependencies(jte);
+
+            Path destination = destinations.get(source);
+            writes.put(destination, jte);
+            String invocationPrefix = owner.extractTagPrefix(source);
+            String jteName = slash(jteRoot.relativize(destination));
+            for (Path usage : virtualPaths) {
+                virtualFiles.computeIfPresent(usage, (path, content) -> owner.replaceUsageContent(content, invocationPrefix, jteName));
+            }
+        }
+
+        for (Path path : virtualPaths) {
+            if (!selectedSet.contains(path)) {
+                String finalContent = virtualFiles.get(path);
+                String originalContent = new String(snapshots.get(path), StandardCharsets.UTF_8);
+                if (!originalContent.equals(finalContent)) {
+                    writes.put(path, finalContent);
+                }
+            }
+        }
+
+        List<Path> lexicalDeletes = new ArrayList<>(selected);
+        lexicalDeletes.sort(PATH_ORDER);
+        return new JspMigrationPlan(owner, order, new LinkedHashSet<>(lexicalDeletes), writes, snapshots,
+                new LinkedHashSet<>(destinations.values()));
+    }
+
+    public List<Path> getConversionOrder() {
+        return conversionOrder;
+    }
+
+    public Set<Path> getDeletes() {
+        return deletes;
+    }
+
+    public Map<Path, String> getWrites() {
+        return writes;
+    }
+
+    public synchronized void commit() throws IOException {
+        if (committed) {
+            throw new IllegalStateException("This JSP migration plan has already been committed.");
+        }
+
+        List<Path> changed = findChangedPaths();
+        if (!changed.isEmpty()) {
+            throw new StaleJspMigrationPlanException(changed);
+        }
+
+        Map<Path, byte[]> originals = new LinkedHashMap<>();
+        for (Path path : writes.keySet()) {
+            originals.put(path, snapshots.get(path));
+        }
+        for (Path path : deletes) {
+            originals.put(path, snapshots.get(path));
+        }
+
+        List<Path> createdDirectories = new ArrayList<>();
+        boolean mutationStarted = false;
+        try {
+            for (Map.Entry<Path, String> write : writes.entrySet()) {
+                mutationStarted = true;
+                createParentDirectories(write.getKey().getParent(), createdDirectories);
+                if (snapshots.containsKey(write.getKey())) {
+                    Files.write(write.getKey(), write.getValue().getBytes(StandardCharsets.UTF_8),
+                            StandardOpenOption.TRUNCATE_EXISTING, StandardOpenOption.WRITE);
+                } else {
+                    Files.write(write.getKey(), write.getValue().getBytes(StandardCharsets.UTF_8),
+                            StandardOpenOption.CREATE_NEW, StandardOpenOption.WRITE);
+                }
+            }
+            for (Path delete : deletes) {
+                mutationStarted = true;
+                Files.delete(delete);
+            }
+            committed = true;
+        } catch (IOException failure) {
+            if (mutationStarted) {
+                restore(originals, createdDirectories, failure);
+            }
+            throw failure;
+        }
+    }
+
+    private List<Path> findChangedPaths() {
+        Set<Path> changed = new TreeSet<>(PATH_ORDER);
+        for (Map.Entry<Path, byte[]> snapshot : snapshots.entrySet()) {
+            Path path = snapshot.getKey();
+            try {
+                if (!Files.isRegularFile(path, NO_FOLLOW) || !Arrays.equals(snapshot.getValue(), Files.readAllBytes(path))) {
+                    changed.add(path);
+                }
+            } catch (IOException e) {
+                changed.add(path);
+            }
+        }
+        for (Path destination : generatedDestinations) {
+            if (Files.exists(destination, NO_FOLLOW)) {
+                changed.add(destination);
+            }
+        }
+        return List.copyOf(changed);
+    }
+
+    private static void createParentDirectories(Path directory, List<Path> createdDirectories) throws IOException {
+        if (directory == null || Files.exists(directory, NO_FOLLOW)) {
+            return;
+        }
+        createParentDirectories(directory.getParent(), createdDirectories);
+        try {
+            Files.createDirectory(directory);
+            createdDirectories.add(directory);
+        } catch (FileAlreadyExistsException ignored) {
+        }
+    }
+
+    private static void restore(Map<Path, byte[]> originals, List<Path> createdDirectories, IOException failure) {
+        List<Map.Entry<Path, byte[]>> entries = new ArrayList<>(originals.entrySet());
+        Collections.reverse(entries);
+        for (Map.Entry<Path, byte[]> entry : entries) {
+            try {
+                if (entry.getValue() == null) {
+                    Files.deleteIfExists(entry.getKey());
+                } else {
+                    Files.createDirectories(entry.getKey().getParent());
+                    Files.write(entry.getKey(), entry.getValue(), StandardOpenOption.CREATE,
+                            StandardOpenOption.TRUNCATE_EXISTING, StandardOpenOption.WRITE);
+                }
+            } catch (IOException restorationFailure) {
+                failure.addSuppressed(restorationFailure);
+            }
+        }
+        Collections.reverse(createdDirectories);
+        for (Path directory : createdDirectories) {
+            try {
+                Files.deleteIfExists(directory);
+            } catch (IOException restorationFailure) {
+                failure.addSuppressed(restorationFailure);
+            }
+        }
+    }
+
+    private static List<Path> validateSelected(Path jspRoot, Collection<String> requestedTags) {
+        if (requestedTags == null || requestedTags.isEmpty()) {
+            throw new IllegalArgumentException("At least one JSP tag is required.");
+        }
+        Set<Path> unique = new HashSet<>();
+        List<Path> selected = new ArrayList<>();
+        for (String requested : requestedTags) {
+            if (requested == null || requested.trim().isEmpty()) {
+                throw new IllegalArgumentException("JSP tag paths must not be null or blank.");
+            }
+            Path relative;
+            try {
+                relative = Paths.get(requested);
+            } catch (RuntimeException e) {
+                throw new IllegalArgumentException("Invalid JSP tag path: " + requested, e);
+            }
+            if (relative.isAbsolute()) {
+                throw new IllegalArgumentException("JSP tag paths must be root-relative: " + requested);
+            }
+            relative = relative.normalize();
+            Path absolute = jspRoot.resolve(relative).normalize();
+            if (relative.toString().isEmpty() || !absolute.startsWith(jspRoot)) {
+                throw new IllegalArgumentException("JSP tag path is outside the JSP root: " + requested);
+            }
+            if (!slash(relative).endsWith(".tag")) {
+                throw new IllegalArgumentException("JSP tag path must end in .tag: " + requested);
+            }
+            if (!unique.add(absolute)) {
+                throw new IllegalArgumentException("Duplicate JSP tag path: " + requested);
+            }
+            if (Files.isSymbolicLink(absolute) || !Files.isRegularFile(absolute, NO_FOLLOW)) {
+                throw new IllegalArgumentException("JSP tag must be an existing regular non-symbolic file: " + requested);
+            }
+            ensurePhysicalContainment(jspRoot, absolute, "JSP tag path is outside the JSP root: " + requested);
+            selected.add(absolute);
+        }
+        selected.sort(PATH_ORDER);
+        return selected;
+    }
+
+    private static Map<Path, byte[]> scanUsageFiles(JspToJteConverter owner, Path jspRoot) {
+        Map<Path, byte[]> result = new LinkedHashMap<>();
+        try (Stream<Path> stream = Files.walk(jspRoot)) {
+            stream.filter(path -> Files.isRegularFile(path, NO_FOLLOW))
+                    .filter(owner::isUsageFile)
+                    .map(path -> path.toAbsolutePath().normalize())
+                    .sorted(PATH_ORDER)
+                    .forEach(path -> result.put(path, readBytes(path)));
+        } catch (IOException e) {
+            throw new UncheckedIOException(e);
+        }
+        return result;
+    }
+
+    private static Map<String, Path> selectedInvocationNames(JspToJteConverter owner, List<Path> selected) {
+        Map<String, Path> names = new TreeMap<>();
+        for (Path path : selected) {
+            String name = owner.extractTagPrefix(path).substring(1);
+            Path previous = names.putIfAbsent(name, path);
+            if (previous != null) {
+                throw new IllegalArgumentException("Ambiguous selected invocation name <" + name + "> for " + previous + " and " + path);
+            }
+        }
+        return names;
+    }
+
+    private static Map<Path, Path> validateDestinations(JspToJteConverter owner, Path jteRoot, List<Path> selected) {
+        Map<Path, Path> result = new LinkedHashMap<>();
+        Set<Path> destinations = new HashSet<>();
+        Path jspRoot = owner.getJspRootPath().toAbsolutePath().normalize();
+        for (Path source : selected) {
+            String relative = slash(jspRoot.relativize(source));
+            String suggestion = owner.suggestJteFile(relative);
+            if (suggestion == null || suggestion.trim().isEmpty()) {
+                throw new IllegalArgumentException("Generated JTE destination must not be null or blank for " + relative);
+            }
+            Path suggested = Paths.get(suggestion);
+            Path destination = suggested.isAbsolute() ? suggested.normalize() : jteRoot.resolve(suggested).normalize();
+            if (!destination.startsWith(jteRoot) || destination.equals(jteRoot)) {
+                throw new IllegalArgumentException("Generated JTE destination is outside the JTE root: " + suggestion);
+            }
+            if (!destinations.add(destination)) {
+                throw new IllegalArgumentException("Generated JTE destinations collide at " + destination);
+            }
+            if (Files.exists(destination, NO_FOLLOW)) {
+                throw new IllegalArgumentException("Generated JTE destination is already taken: " + destination);
+            }
+            ensureDestinationContainment(jteRoot, destination);
+            result.put(source, destination);
+        }
+        return result;
+    }
+
+    private static Map<Path, Set<Path>> analyzeDependencies(JspToJteConverter owner, Path jspRoot, List<Path> selected,
+                                                             Map<String, Path> invocationNames, Map<Path, byte[]> snapshots,
+                                                             Map<Path, TagContext> contexts) {
+        Map<Path, Set<Path>> result = new LinkedHashMap<>();
+        Set<String> selectedNames = invocationNames.keySet();
+        for (Path source : selected) {
+            String relative = slash(jspRoot.relativize(source));
+            TagContext context = contexts.get(source);
+            JtpConverter converter = owner.createConverter(relative, context.source, context.setup, selectedNames,
+                    context.resourceBase, context.notConvertedTags);
+            addVirtualIncludes(owner, jspRoot, converter, toStrings(snapshots), snapshots);
+            String converted = converter.convert();
+            Set<Path> dependencies = new TreeSet<>(PATH_ORDER);
+            for (String customTag : converter.getCustomTags()) {
+                Path dependency = invocationNames.get(customTag);
+                if (dependency != null) {
+                    dependencies.add(dependency);
+                }
+            }
+            for (String unresolvedTag : owner.findUnresolvedJspTags(converted)) {
+                Path dependency = invocationNames.get(unresolvedTag.substring(1));
+                if (dependency != null) {
+                    dependencies.add(dependency);
+                }
+            }
+            result.put(source, dependencies);
+        }
+        return result;
+    }
+
+    private static void addVirtualIncludes(JspToJteConverter owner, Path jspRoot, JtpConverter converter,
+                                           Map<Path, String> virtualFiles, Map<Path, byte[]> snapshots) {
+        URL resourceBase = converter.getResourceBase();
+        for (String include : converter.getInlinedIncludes()) {
+            Path resolved = resolveInclude(resourceBase, include);
+            if (!resolved.startsWith(jspRoot)) {
+                throw new IllegalArgumentException("Approved include is outside the JSP root: " + include);
+            }
+            ensurePhysicalContainment(jspRoot, resolved, "Approved include is outside the JSP root: " + include);
+            byte[] snapshot = snapshots.computeIfAbsent(resolved, JspMigrationPlan::readBytes);
+            String content = virtualFiles.get(resolved);
+            byte[] bytes = content == null ? snapshot : content.getBytes(StandardCharsets.UTF_8);
+            converter.addVirtualResource(include, bytes);
+            converter.addVirtualResource(resourcePath(resourceBase, resolved), bytes);
+        }
+    }
+
+    private static Path resolveInclude(URL resourceBase, String include) {
+        try {
+            URL resolved = new URL(resourceBase, include.startsWith("/") ? include.substring(1) : include);
+            if (!"file".equalsIgnoreCase(resolved.getProtocol())) {
+                throw new IllegalArgumentException("Approved include must resolve to a file: " + include);
+            }
+            URI uri = resolved.toURI();
+            return Paths.get(uri).toAbsolutePath().normalize();
+        } catch (IOException | URISyntaxException | IllegalArgumentException e) {
+            if (e instanceof IllegalArgumentException) {
+                throw (IllegalArgumentException) e;
+            }
+            throw new IllegalArgumentException("Invalid approved include path: " + include, e);
+        }
+    }
+
+    private static String resourcePath(URL resourceBase, Path resolved) {
+        try {
+            Path base = Paths.get(resourceBase.toURI()).toAbsolutePath().normalize();
+            return "/" + slash(base.relativize(resolved));
+        } catch (Exception e) {
+            return resolved.toUri().getPath();
+        }
+    }
+
+    private static List<Path> conversionOrder(Path jspRoot, List<Path> selected, Map<Path, Set<Path>> dependencies) {
+        Set<Path> remaining = new TreeSet<>(PATH_ORDER);
+        remaining.addAll(selected);
+        Set<Path> converted = new HashSet<>();
+        List<Path> order = new ArrayList<>();
+        while (!remaining.isEmpty()) {
+            Path next = null;
+            for (Path candidate : remaining) {
+                if (converted.containsAll(dependencies.get(candidate))) {
+                    next = candidate;
+                    break;
+                }
+            }
+            if (next == null) {
+                List<Path> cycle = findCycle(remaining, dependencies);
+                List<String> display = new ArrayList<>();
+                for (Path path : cycle) {
+                    display.add(slash(jspRoot.relativize(path)));
+                }
+                throw new IllegalArgumentException("Cyclic JSP tag dependency: " + String.join(" -> ", display));
+            }
+            remaining.remove(next);
+            converted.add(next);
+            order.add(next);
+        }
+        return order;
+    }
+
+    private static List<Path> findCycle(Set<Path> remaining, Map<Path, Set<Path>> dependencies) {
+        Map<Path, Integer> state = new HashMap<>();
+        List<Path> stack = new ArrayList<>();
+        for (Path path : remaining) {
+            List<Path> cycle = findCycle(path, remaining, dependencies, state, stack);
+            if (cycle != null) {
+                return cycle;
+            }
+        }
+        throw new IllegalStateException("Cycle expected");
+    }
+
+    private static List<Path> findCycle(Path path, Set<Path> remaining, Map<Path, Set<Path>> dependencies,
+                                        Map<Path, Integer> state, List<Path> stack) {
+        Integer currentState = state.get(path);
+        if (currentState != null) {
+            if (currentState == 1) {
+                int start = stack.indexOf(path);
+                List<Path> cycle = new ArrayList<>(stack.subList(start, stack.size()));
+                cycle.add(path);
+                return cycle;
+            }
+            return null;
+        }
+        state.put(path, 1);
+        stack.add(path);
+        for (Path dependency : dependencies.get(path)) {
+            if (remaining.contains(dependency)) {
+                List<Path> cycle = findCycle(dependency, remaining, dependencies, state, stack);
+                if (cycle != null) {
+                    return cycle;
+                }
+            }
+        }
+        stack.remove(stack.size() - 1);
+        state.put(path, 2);
+        return null;
+    }
+
+    private static Map<Path, String> toStrings(Map<Path, byte[]> snapshots) {
+        Map<Path, String> result = new LinkedHashMap<>();
+        snapshots.forEach((path, bytes) -> result.put(path, new String(bytes, StandardCharsets.UTF_8)));
+        return result;
+    }
+
+    private static byte[] readBytes(Path path) {
+        try {
+            return Files.readAllBytes(path);
+        } catch (IOException e) {
+            throw new UncheckedIOException(e);
+        }
+    }
+
+    private static Map<Path, byte[]> copySnapshots(Map<Path, byte[]> source) {
+        Map<Path, byte[]> result = new LinkedHashMap<>();
+        source.forEach((path, bytes) -> result.put(path, bytes.clone()));
+        return Collections.unmodifiableMap(result);
+    }
+
+    private static String slash(Path path) {
+        return path.toString().replace('\\', '/');
+    }
+
+    private static Map<Path, TagContext> createContexts(JspToJteConverter owner, List<Path> selected,
+                                                         Consumer<Converter> parserSetup) {
+        Map<Path, TagContext> result = new LinkedHashMap<>();
+        for (Path source : selected) {
+            ConverterSetup setup = new ConverterSetup();
+            if (parserSetup != null) {
+                parserSetup.accept(setup);
+            }
+            String[] notConvertedTags = owner.getNotConvertedTags();
+            result.put(source, new TagContext(owner.readFile(source), setup::apply, owner.getResourceBase(),
+                    notConvertedTags == null ? null : notConvertedTags.clone()));
+        }
+        return result;
+    }
+
+    private static void ensurePhysicalContainment(Path root, Path path, String message) {
+        try {
+            Path realRoot = root.toRealPath();
+            if (!path.toRealPath().startsWith(realRoot)) {
+                throw new IllegalArgumentException(message);
+            }
+        } catch (IOException e) {
+            throw new UncheckedIOException(e);
+        }
+    }
+
+    private static void ensureDestinationContainment(Path root, Path destination) {
+        if (!Files.exists(root, NO_FOLLOW)) {
+            return;
+        }
+        Path existing = destination.getParent();
+        while (existing != null && !Files.exists(existing, NO_FOLLOW)) {
+            existing = existing.getParent();
+        }
+        if (existing == null) {
+            return;
+        }
+        try {
+            Path rootBoundary = root.toRealPath();
+            if (!existing.toRealPath().startsWith(rootBoundary)) {
+                throw new IllegalArgumentException("Generated JTE destination is outside the JTE root: " + destination);
+            }
+        } catch (IOException e) {
+            throw new UncheckedIOException(e);
+        }
+    }
+
+    private static final class TagContext {
+        private final String source;
+        private final Consumer<Converter> setup;
+        private final URL resourceBase;
+        private final String[] notConvertedTags;
+
+        private TagContext(String source, Consumer<Converter> setup, URL resourceBase, String[] notConvertedTags) {
+            this.source = source;
+            this.setup = setup;
+            this.resourceBase = resourceBase;
+            this.notConvertedTags = notConvertedTags;
+        }
+    }
+
+    private static final class ConverterSetup implements Converter {
+        private final List<Consumer<Converter>> actions = new ArrayList<>();
+
+        private void apply(Converter converter) {
+            actions.forEach(action -> action.accept(converter));
+        }
+
+        @Override
+        public void register(String tagName, gg.jte.convert.CustomTagConverter converter) {
+            actions.add(target -> target.register(tagName, converter));
+        }
+
+        @Override
+        public void addInlinedInclude(String path) {
+            actions.add(target -> target.addInlinedInclude(path));
+        }
+
+        @Override
+        public void addSuppressions(String path, EnumSet<JspElementType> suppressions) {
+            EnumSet<JspElementType> copy = suppressions.clone();
+            actions.add(target -> target.addSuppressions(path, copy.clone()));
+        }
+
+        @Override
+        public void setLineSeparator(String lineSeparator) {
+            actions.add(target -> target.setLineSeparator(lineSeparator));
+        }
+
+        @Override
+        public void setIndentationCount(int indentationCount) {
+            actions.add(target -> target.setIndentationCount(indentationCount));
+        }
+
+        @Override
+        public void setIndentationChar(char indentationChar) {
+            actions.add(target -> target.setIndentationChar(indentationChar));
+        }
+
+        @Override
+        public String convert() {
+            throw new UnsupportedOperationException("Parser setup cannot convert while a migration is being planned.");
+        }
+
+        @Override
+        public void setPrefix(String prefix) {
+            actions.add(target -> target.setPrefix(prefix));
+        }
+    }
+}
