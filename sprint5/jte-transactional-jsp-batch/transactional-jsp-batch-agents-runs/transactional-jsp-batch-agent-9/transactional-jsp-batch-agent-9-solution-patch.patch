+package gg.jte.convert.jsp;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.DirectoryNotEmptyException;
+import java.nio.file.Files;
+import java.nio.file.LinkOption;
+import java.nio.file.Path;
+import java.nio.file.StandardOpenOption;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collection;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeSet;
+
+public final class JspMigrationPlan {
+    private final List<Path> conversionOrder;
+    private final Map<Path, String> writes;
+    private final Set<Path> deletes;
+    private final Map<Path, byte[]> snapshots;
+    private final Set<Path> generatedDestinations;
+    private final Set<Path> snapshotSymbolicLinks;
+    private boolean committed;
+
+    JspMigrationPlan(List<Path> conversionOrder, Map<Path, String> writes, Set<Path> deletes,
+                     Map<Path, byte[]> snapshots, Set<Path> generatedDestinations) {
+        this.conversionOrder = List.copyOf(conversionOrder);
+        this.writes = Collections.unmodifiableMap(new LinkedHashMap<>(writes));
+        this.deletes = Collections.unmodifiableSet(new LinkedHashSet<>(deletes));
+        Map<Path, byte[]> snapshotCopy = new LinkedHashMap<>();
+        snapshots.forEach((path, content) -> snapshotCopy.put(path, content.clone()));
+        this.snapshots = Collections.unmodifiableMap(snapshotCopy);
+        this.generatedDestinations = Collections.unmodifiableSet(new LinkedHashSet<>(generatedDestinations));
+        Set<Path> symbolicLinks = new LinkedHashSet<>();
+        snapshots.keySet().stream().filter(Files::isSymbolicLink).forEach(symbolicLinks::add);
+        this.snapshotSymbolicLinks = Collections.unmodifiableSet(symbolicLinks);
+    }
+
+    public List<Path> getConversionOrder() {
+        return conversionOrder;
+    }
+
+    public Map<Path, String> getWrites() {
+        return writes;
+    }
+
+    public Set<Path> getDeletes() {
+        return deletes;
+    }
+
+    public synchronized void commit() throws IOException {
+        if (committed) {
+            throw new IllegalStateException("This JSP migration plan has already been committed.");
+        }
+
+        List<Path> changedPaths = findChangedPaths();
+        if (!changedPaths.isEmpty()) {
+            throw new StaleJspMigrationPlanException(changedPaths);
+        }
+
+        Set<Path> affectedPaths = new LinkedHashSet<>(writes.keySet());
+        affectedPaths.addAll(deletes);
+        Set<Path> originallyAbsent = new LinkedHashSet<>();
+        for (Path path : affectedPaths) {
+            if (!snapshots.containsKey(path)) {
+                originallyAbsent.add(path);
+            }
+        }
+
+        Set<Path> createdDirectories = collectMissingDirectories(writes.keySet());
+        boolean mutationStarted = false;
+        try {
+            for (Map.Entry<Path, String> write : writes.entrySet()) {
+                mutationStarted = true;
+                Files.createDirectories(write.getKey().getParent());
+                byte[] content = write.getValue().getBytes(StandardCharsets.UTF_8);
+                if (originallyAbsent.contains(write.getKey())) {
+                    Files.write(write.getKey(), content, StandardOpenOption.CREATE_NEW, StandardOpenOption.WRITE);
+                } else {
+                    Files.write(write.getKey(), content, StandardOpenOption.TRUNCATE_EXISTING, StandardOpenOption.WRITE);
+                }
+            }
+            for (Path delete : deletes) {
+                mutationStarted = true;
+                Files.delete(delete);
+            }
+            committed = true;
+        } catch (IOException failure) {
+            if (mutationStarted) {
+                restore(affectedPaths, originallyAbsent, createdDirectories, failure);
+            }
+            throw failure;
+        }
+    }
+
+    private List<Path> findChangedPaths() {
+        Set<Path> changed = new TreeSet<>(Comparator.comparing(Path::toString));
+        for (Map.Entry<Path, byte[]> snapshot : snapshots.entrySet()) {
+            Path path = snapshot.getKey();
+            try {
+                if (!Files.isRegularFile(path)
+                        || Files.isSymbolicLink(path) != snapshotSymbolicLinks.contains(path)
+                        || !Arrays.equals(snapshot.getValue(), Files.readAllBytes(path))) {
+                    changed.add(path);
+                }
+            } catch (IOException e) {
+                changed.add(path);
+            }
+        }
+        for (Path destination : generatedDestinations) {
+            if (Files.exists(destination, LinkOption.NOFOLLOW_LINKS)) {
+                changed.add(destination);
+            }
+        }
+        return List.copyOf(changed);
+    }
+
+    private static Set<Path> collectMissingDirectories(Collection<Path> paths) {
+        Set<Path> result = new LinkedHashSet<>();
+        for (Path path : paths) {
+            Path parent = path.getParent();
+            while (parent != null && !Files.exists(parent, LinkOption.NOFOLLOW_LINKS)) {
+                result.add(parent);
+                parent = parent.getParent();
+            }
+        }
+        return result;
+    }
+
+    private void restore(Set<Path> affectedPaths, Set<Path> originallyAbsent, Set<Path> createdDirectories,
+                         IOException originalFailure) {
+        List<Path> paths = new ArrayList<>(affectedPaths);
+        paths.sort(Comparator.comparingInt(Path::getNameCount).reversed());
+        for (Path path : paths) {
+            try {
+                if (originallyAbsent.contains(path)) {
+                    Files.deleteIfExists(path);
+                } else {
+                    Files.createDirectories(path.getParent());
+                    Files.write(path, snapshots.get(path), StandardOpenOption.CREATE,
+                            StandardOpenOption.TRUNCATE_EXISTING, StandardOpenOption.WRITE);
+                }
+            } catch (IOException restorationFailure) {
+                originalFailure.addSuppressed(restorationFailure);
+            }
+        }
+
+        List<Path> directories = new ArrayList<>(createdDirectories);
+        directories.sort(Comparator.comparingInt(Path::getNameCount).reversed());
+        for (Path directory : directories) {
+            try {
+                Files.deleteIfExists(directory);
+            } catch (DirectoryNotEmptyException ignored) {
+            } catch (IOException restorationFailure) {
+                originalFailure.addSuppressed(restorationFailure);
+            }
+        }
+    }
+}
