@@ -0,0 +1,170 @@
+package gg.jte.convert.jsp;
+
+import gg.jte.convert.IoUtils;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+import java.io.IOException;
+import java.net.URL;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.Paths;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatExceptionOfType;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+class JspMigrationPlanTest {
+    @TempDir
+    Path tempDir;
+
+    private Path jspRoot;
+    private Path jteRoot;
+    private JspToJteConverter converter;
+
+    @BeforeEach
+    void setUp() throws IOException {
+        jspRoot = tempDir.resolve("jsp");
+        jteRoot = tempDir.resolve("jte");
+        Files.createDirectories(jspRoot);
+        IoUtils.copyDirectory(Paths.get("WEB-INF"), jspRoot.resolve("WEB-INF"));
+        Files.createDirectories(jspRoot.resolve("WEB-INF/tags/my"));
+        converter = new JspToJteConverter(jspRoot, jteRoot, "jte:jte") {
+            @Override
+            protected URL getResourceBase() {
+                try {
+                    return jspRoot.toUri().toURL();
+                } catch (IOException e) {
+                    throw new RuntimeException(e);
+                }
+            }
+        };
+    }
+
+    @Test
+    void plansAndCommitsDependenciesInDeterministicOrder() throws Exception {
+        Path dependency = write("WEB-INF/tags/my/dependency.tag", "dependency");
+        Path parent = write("WEB-INF/tags/my/parent.tag", "<%@ taglib prefix=\"my\" tagdir=\"/WEB-INF/tags/my\" %><%@ taglib prefix=\"jte\" uri=\"/WEB-INF/tld/my.tld\" %><my:dependency/>");
+        Path usage = write("usage.jsp", "<my:parent/>");
+
+        JspMigrationPlan plan = converter.planTags(List.of("WEB-INF/tags/my/parent.tag", "WEB-INF/tags/my/dependency.tag"), null);
+
+        assertThat(plan.getConversionOrder()).containsExactly(dependency, parent);
+        assertThat(plan.getDeletes()).containsExactlyInAnyOrder(dependency, parent);
+        assertThat(plan.getWrites()).containsKeys(
+                jteRoot.resolve(converter.suggestJteFile("WEB-INF/tags/my/dependency.tag")),
+                jteRoot.resolve(converter.suggestJteFile("WEB-INF/tags/my/parent.tag")),
+                usage
+        );
+        assertThat(plan.getWrites().get(jteRoot.resolve(converter.suggestJteFile("WEB-INF/tags/my/parent.tag")))).contains("@template.");
+        assertThat(plan.getWrites().get(usage)).isEqualTo("<jte:jte jte=\"" + converter.suggestJteFile("WEB-INF/tags/my/parent.tag") + "\"/>");
+        assertThat(dependency).exists();
+        assertThat(parent).exists();
+        assertThat(jteRoot).doesNotExist();
+
+        assertThatThrownBy(() -> plan.getConversionOrder().add(parent)).isInstanceOf(UnsupportedOperationException.class);
+        assertThatThrownBy(() -> plan.getDeletes().clear()).isInstanceOf(UnsupportedOperationException.class);
+        assertThatThrownBy(() -> plan.getWrites().put(usage, "changed")).isInstanceOf(UnsupportedOperationException.class);
+
+        plan.commit();
+
+        assertThat(dependency).doesNotExist();
+        assertThat(parent).doesNotExist();
+        assertThat(usage).hasContent("<jte:jte jte=\"" + converter.suggestJteFile("WEB-INF/tags/my/parent.tag") + "\"/>");
+        assertThat(jteRoot.resolve(converter.suggestJteFile("WEB-INF/tags/my/dependency.tag"))).hasContent("dependency");
+        assertThatThrownBy(plan::commit).isInstanceOf(IllegalStateException.class);
+    }
+
+    @Test
+    void stalePlanListsAllChangedPathsWithoutMutating() throws Exception {
+        Path dependency = write("WEB-INF/tags/my/dependency.tag", "dependency");
+        Path usage = write("usage.jsp", "<my:dependency/>");
+        JspMigrationPlan plan = converter.planTags(Set.of("WEB-INF/tags/my/dependency.tag"), null);
+        Files.writeString(dependency, "changed");
+        Files.writeString(usage, "changed usage");
+        Path destination = jteRoot.resolve(converter.suggestJteFile("WEB-INF/tags/my/dependency.tag"));
+        Files.createDirectories(destination.getParent());
+        Files.writeString(destination, "taken");
+
+        assertThatExceptionOfType(StaleJspMigrationPlanException.class)
+                .isThrownBy(plan::commit)
+                .satisfies(exception -> assertThat(exception.getChangedPaths())
+                        .containsExactly(dependency, usage, destination));
+
+        assertThat(dependency).hasContent("changed");
+        assertThat(usage).hasContent("changed usage");
+        assertThat(destination).hasContent("taken");
+    }
+
+    @Test
+    void commentsDoNotCreateDependencies() throws Exception {
+        Path first = write("WEB-INF/tags/my/first.tag", "<%@ taglib prefix=\"my\" tagdir=\"/WEB-INF/tags/my\" %><%@ taglib prefix=\"jte\" uri=\"/WEB-INF/tld/my.tld\" %><%-- <my:second/> --%>first");
+        Path second = write("WEB-INF/tags/my/second.tag", "second");
+
+        JspMigrationPlan plan = converter.planTags(List.of("WEB-INF/tags/my/second.tag", "WEB-INF/tags/my/first.tag"), null);
+
+        assertThat(plan.getConversionOrder()).containsExactly(first, second);
+    }
+
+    @Test
+    void validatesInputsBeforePlanning() throws Exception {
+        write("WEB-INF/tags/my/valid.tag", "valid");
+
+        assertThatThrownBy(() -> converter.planTags(List.of(), null)).isInstanceOf(IllegalArgumentException.class);
+        assertThatThrownBy(() -> converter.planTags(List.of("WEB-INF/tags/my/valid.tag", "WEB-INF/tags/my/../my/valid.tag"), null))
+                .isInstanceOf(IllegalArgumentException.class);
+        assertThatThrownBy(() -> converter.planTags(List.of("../outside.tag"), null))
+                .isInstanceOf(IllegalArgumentException.class);
+        assertThatThrownBy(() -> converter.planTags(List.of("usage.jsp"), null))
+                .isInstanceOf(IllegalArgumentException.class);
+    }
+
+
+    @Test
+    void findsDependenciesInApprovedInlinedIncludes() throws Exception {
+        Path dependency = write("WEB-INF/tags/my/dependency.tag", "dependency");
+        Path include = write("WEB-INF/shared.jsp.inc", "<%@ taglib prefix=\"my\" tagdir=\"/WEB-INF/tags/my\" %><%@ taglib prefix=\"jte\" uri=\"/WEB-INF/tld/my.tld\" %><my:dependency/>");
+        Path parent = write("WEB-INF/tags/my/parent.tag", "<%@ include file=\"/WEB-INF/shared.jsp.inc\" %>parent");
+
+        JspMigrationPlan plan = converter.planTags(
+                List.of("WEB-INF/tags/my/parent.tag", "WEB-INF/tags/my/dependency.tag"),
+                configured -> configured.addInlinedInclude("/WEB-INF/shared.jsp.inc")
+        );
+
+        assertThat(plan.getConversionOrder()).containsExactly(dependency, parent);
+        assertThat(plan.getWrites()).containsKey(include);
+        assertThat(plan.getWrites().get(include)).contains("<jte:jte jte=\"");
+    }
+
+    @Test
+    void reportsDeterministicClosedCycle() throws Exception {
+        write("WEB-INF/tags/my/first.tag", "<%@ taglib prefix=\"my\" tagdir=\"/WEB-INF/tags/my\" %><%@ taglib prefix=\"jte\" uri=\"/WEB-INF/tld/my.tld\" %><my:second/>");
+        write("WEB-INF/tags/my/second.tag", "<%@ taglib prefix=\"my\" tagdir=\"/WEB-INF/tags/my\" %><%@ taglib prefix=\"jte\" uri=\"/WEB-INF/tld/my.tld\" %><my:first/>");
+
+        assertThatThrownBy(() -> converter.planTags(
+                List.of("WEB-INF/tags/my/second.tag", "WEB-INF/tags/my/first.tag"), null))
+                .isInstanceOf(IllegalArgumentException.class)
+                .hasMessageContaining("WEB-INF/tags/my/first.tag -> WEB-INF/tags/my/second.tag -> WEB-INF/tags/my/first.tag");
+    }
+
+    @Test
+    void parserSetupFailureSurfacesUnchanged() throws Exception {
+        write("WEB-INF/tags/my/valid.tag", "valid");
+        RuntimeException expected = new RuntimeException("setup failed");
+
+        assertThatThrownBy(() -> converter.planTags(Set.of("WEB-INF/tags/my/valid.tag"), configured -> {
+            throw expected;
+        })).isSameAs(expected);
+    }
+
+    private Path write(String relative, String content) throws IOException {
+        Path path = jspRoot.resolve(relative);
+        Files.createDirectories(path.getParent());
+        Files.writeString(path, content);
+        return path.toAbsolutePath().normalize();
+    }
+}
diff --git a/jte-jsp-converter/src/main/java/gg/jte/convert/jsp/JspBatchPlanner.java b/jte-jsp-converter/src/main/java/gg/jte/convert/jsp/JspBatchPlanner.java
