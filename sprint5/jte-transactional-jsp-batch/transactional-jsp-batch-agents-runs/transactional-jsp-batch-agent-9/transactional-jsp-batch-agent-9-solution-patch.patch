+package gg.jte.convert.jsp;
+
+import gg.jte.convert.ConverterOutput;
+import gg.jte.convert.CustomTagConverter;
+import org.apache.jasper.JasperException;
+import org.apache.jasper.compiler.JtpConverter;
+import org.apache.jasper.compiler.JtpCustomTag;
+import org.xml.sax.Attributes;
+
+import java.io.IOException;
+import java.io.UncheckedIOException;
+import java.net.URI;
+import java.net.URISyntaxException;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.LinkOption;
+import java.nio.file.Path;
+import java.nio.file.Paths;
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeMap;
+import java.util.TreeSet;
+import java.util.function.Consumer;
+import java.util.stream.Stream;
+
+import static gg.jte.convert.jsp.converter.JspExpressionConverter.convertAttributeValue;
+
+final class JspBatchPlanner {
+    private final JspToJteConverter owner;
+    private final Path jspRoot;
+    private final Path jteRoot;
+    private final String jteTag;
+
+    JspBatchPlanner(JspToJteConverter owner, Path jspRoot, Path jteRoot, String jteTag) {
+        this.owner = owner;
+        this.jspRoot = jspRoot.toAbsolutePath().normalize();
+        this.jteRoot = jteRoot.toAbsolutePath().normalize();
+        this.jteTag = jteTag;
+    }
+
+    JspMigrationPlan plan(Collection<String> jspTags, Consumer<Converter> parserSetup) {
+        TreeMap<String, Path> selected = validateSelected(jspTags);
+        Map<Path, byte[]> snapshots = scanUsageFiles();
+        for (Path selectedPath : selected.values()) {
+            snapshots.putIfAbsent(selectedPath, readBytes(selectedPath));
+        }
+
+        Map<String, String> invocationToRelative = selectedInvocationNames(selected);
+        Map<String, JtpConverter> converters = new TreeMap<>();
+        Map<String, Set<String>> dependencies = new TreeMap<>();
+        URL resourceBase = owner.getResourceBase();
+
+        for (Map.Entry<String, Path> entry : selected.entrySet()) {
+            String relative = entry.getKey();
+            String source = owner.readFile(entry.getValue()).replace("\r", "");
+            JtpConverter converter = owner.createConverter(relative, source.getBytes(StandardCharsets.UTF_8), parserSetup);
+            validateAndSnapshotIncludes(converter.getInlinedIncludes(), resourceBase, snapshots);
+            Set<String> customTags = converter.findCustomTags();
+            Set<String> tagDependencies = new TreeSet<>();
+            for (String customTag : customTags) {
+                String dependency = invocationToRelative.get(customTag);
+                if (dependency != null) {
+                    tagDependencies.add(dependency);
+                }
+            }
+            converters.put(relative, converter);
+            dependencies.put(relative, tagDependencies);
+        }
+
+        List<String> relativeOrder = conversionOrder(dependencies);
+        Map<String, Path> destinations = validateDestinations(relativeOrder);
+        Map<Path, String> virtualFiles = new TreeMap<>(Comparator.comparing(Path::toString));
+        snapshots.forEach((path, content) -> {
+            if (isUsageFile(path)
+                    && Files.isRegularFile(path, LinkOption.NOFOLLOW_LINKS)
+                    && !Files.isSymbolicLink(path)) {
+                virtualFiles.put(path, new String(content, StandardCharsets.UTF_8));
+            }
+        });
+
+        Map<Path, String> generatedWrites = new LinkedHashMap<>();
+        Set<String> converted = new LinkedHashSet<>();
+        for (String relative : relativeOrder) {
+            String virtualSource = virtualFiles.get(selected.get(relative)).replace("\r", "");
+            JtpConverter converter = converters.get(relative)
+                    .copyWithInput(virtualSource.getBytes(StandardCharsets.UTF_8));
+            for (String convertedRelative : converted) {
+                String invocation = invocationName(selected.get(convertedRelative));
+                String destination = jteRoot.relativize(destinations.get(convertedRelative)).toString().replace('\\', '/');
+                converter.register(invocation, new PlannedJspTagConverter(destination));
+            }
+
+            String jte = converter.convert();
+            owner.checkDependencies(stripJspComments(jte));
+            Path destination = destinations.get(relative);
+            generatedWrites.put(destination, jte);
+            replaceUsages(virtualFiles, selected.get(relative), destination);
+            converted.add(relative);
+        }
+
+        Set<Path> deletes = new LinkedHashSet<>();
+        for (String relative : relativeOrder) {
+            deletes.add(selected.get(relative));
+        }
+
+        Map<Path, String> writes = new LinkedHashMap<>(generatedWrites);
+        for (Map.Entry<Path, String> virtualFile : virtualFiles.entrySet()) {
+            Path path = virtualFile.getKey();
+            if (deletes.contains(path)) {
+                continue;
+            }
+            String original = new String(snapshots.get(path), StandardCharsets.UTF_8);
+            if (!original.equals(virtualFile.getValue())) {
+                writes.put(path, virtualFile.getValue());
+            }
+        }
+
+        List<Path> absoluteOrder = new ArrayList<>();
+        for (String relative : relativeOrder) {
+            absoluteOrder.add(selected.get(relative));
+        }
+        return new JspMigrationPlan(absoluteOrder, writes, deletes, snapshots,
+                new LinkedHashSet<>(destinations.values()));
+    }
+
+    private TreeMap<String, Path> validateSelected(Collection<String> jspTags) {
+        if (jspTags == null || jspTags.isEmpty()) {
+            throw new IllegalArgumentException("At least one JSP tag is required.");
+        }
+        TreeMap<String, Path> result = new TreeMap<>();
+        for (String jspTag : jspTags) {
+            if (jspTag == null || jspTag.isBlank()) {
+                throw new IllegalArgumentException("JSP tag paths must not be null or blank.");
+            }
+            Path input = jspRoot.getFileSystem().getPath(jspTag);
+            if (input.isAbsolute()) {
+                throw new IllegalArgumentException("JSP tag paths must be root-relative: " + jspTag);
+            }
+            Path normalizedRelative = input.normalize();
+            if (normalizedRelative.getNameCount() == 0 || normalizedRelative.startsWith("..")) {
+                throw new IllegalArgumentException("JSP tag path is outside the JSP root: " + jspTag);
+            }
+            String relative = normalizedRelative.toString().replace('\\', '/');
+            if (!relative.endsWith(".tag")) {
+                throw new IllegalArgumentException("Only .tag files can be planned: " + jspTag);
+            }
+            Path absolute = jspRoot.resolve(normalizedRelative).normalize();
+            if (!absolute.startsWith(jspRoot)) {
+                throw new IllegalArgumentException("JSP tag path is outside the JSP root: " + jspTag);
+            }
+            if (Files.isSymbolicLink(absolute)) {
+                throw new IllegalArgumentException("Selected JSP tag must not be a symbolic link: " + absolute);
+            }
+            if (!Files.isRegularFile(absolute, LinkOption.NOFOLLOW_LINKS)) {
+                throw new IllegalArgumentException("Selected JSP tag is missing or not a regular file: " + absolute);
+            }
+            if (!realPath(absolute).startsWith(realPath(jspRoot))) {
+                throw new IllegalArgumentException("JSP tag path is outside the JSP root: " + jspTag);
+            }
+            if (result.put(relative, absolute) != null) {
+                throw new IllegalArgumentException("Duplicate normalized JSP tag path: " + relative);
+            }
+        }
+        return result;
+    }
+
+    private Map<String, String> selectedInvocationNames(Map<String, Path> selected) {
+        Map<String, String> result = new HashMap<>();
+        for (Map.Entry<String, Path> entry : selected.entrySet()) {
+            String invocation = invocationName(entry.getValue());
+            String previous = result.put(invocation, entry.getKey());
+            if (previous != null) {
+                throw new IllegalArgumentException("Ambiguous selected invocation name <" + invocation + "> for "
+                        + previous + " and " + entry.getKey());
+            }
+        }
+        return result;
+    }
+
+    private Map<Path, byte[]> scanUsageFiles() {
+        Map<Path, byte[]> result = new TreeMap<>(Comparator.comparing(Path::toString));
+        try (Stream<Path> files = Files.walk(jspRoot)) {
+            files.filter(path -> Files.isRegularFile(path, LinkOption.NOFOLLOW_LINKS))
+                    .filter(path -> !Files.isSymbolicLink(path))
+                    .map(path -> path.toAbsolutePath().normalize())
+                    .filter(JspBatchPlanner::isUsageFile)
+                    .sorted(Comparator.comparing(Path::toString))
+                    .forEach(path -> result.put(path, readBytes(path)));
+        } catch (IOException e) {
+            throw new UncheckedIOException(e);
+        }
+        return result;
+    }
+
+    private void validateAndSnapshotIncludes(Set<String> includes, URL resourceBase, Map<Path, byte[]> snapshots) {
+        Path base = resourceBasePath(resourceBase);
+        Path realJspRoot = realPath(jspRoot);
+        for (String include : new TreeSet<>(includes)) {
+            if (include == null || include.isBlank()) {
+                throw new IllegalArgumentException("Approved include paths must not be null or blank.");
+            }
+            String relativeInclude = include.startsWith("/") ? include.substring(1) : include;
+            Path includePath = base.resolve(relativeInclude).toAbsolutePath().normalize();
+            if (!includePath.startsWith(jspRoot)) {
+                throw new IllegalArgumentException("Approved include is outside the JSP root: " + include);
+            }
+            if (!realPath(includePath).startsWith(realJspRoot)) {
+                throw new IllegalArgumentException("Approved include is outside the JSP root: " + include);
+            }
+            snapshots.putIfAbsent(includePath, readBytes(includePath));
+        }
+    }
+
+    private Map<String, Path> validateDestinations(List<String> relativeOrder) {
+        Map<String, Path> result = new LinkedHashMap<>();
+        Set<Path> destinations = new HashSet<>();
+        for (String relative : relativeOrder) {
+            String suggested = owner.suggestJteFile(relative.replace('\\', '/'));
+            if (suggested == null || suggested.isBlank()) {
+                throw new IllegalArgumentException("Generated JTE destination must not be null or blank for " + relative);
+            }
+            Path suggestedPath = jteRoot.getFileSystem().getPath(suggested);
+            Path destination = suggestedPath.isAbsolute()
+                    ? suggestedPath.toAbsolutePath().normalize()
+                    : jteRoot.resolve(suggestedPath).toAbsolutePath().normalize();
+            if (!destination.startsWith(jteRoot)) {
+                throw new IllegalArgumentException("Generated JTE destination is outside the JTE root: " + destination);
+            }
+            validateDestinationAncestors(destination);
+            if (!destinations.add(destination)) {
+                throw new IllegalArgumentException("Generated JTE destinations collide at " + destination);
+            }
+            if (Files.exists(destination, LinkOption.NOFOLLOW_LINKS)) {
+                throw new IllegalArgumentException("Generated JTE destination is already taken: " + destination);
+            }
+            result.put(relative, destination);
+        }
+        return result;
+    }
+
+    private void validateDestinationAncestors(Path destination) {
+        Path current = destination.getParent();
+        while (current != null && current.startsWith(jteRoot)) {
+            if (Files.isSymbolicLink(current)) {
+                throw new IllegalArgumentException("Generated JTE destination uses a symbolic link: " + destination);
+            }
+            if (Files.exists(current, LinkOption.NOFOLLOW_LINKS)
+                    && !Files.isDirectory(current, LinkOption.NOFOLLOW_LINKS)) {
+                throw new IllegalArgumentException("Generated JTE destination path is already taken: " + current);
+            }
+            current = current.getParent();
+        }
+    }
+
+    private static List<String> conversionOrder(Map<String, Set<String>> dependencies) {
+        List<String> result = new ArrayList<>();
+        Set<String> converted = new HashSet<>();
+        while (result.size() < dependencies.size()) {
+            String next = null;
+            for (Map.Entry<String, Set<String>> entry : dependencies.entrySet()) {
+                if (!converted.contains(entry.getKey()) && converted.containsAll(entry.getValue())) {
+                    next = entry.getKey();
+                    break;
+                }
+            }
+            if (next == null) {
+                throw new IllegalArgumentException("Cyclic JSP tag dependency: " + findCycle(dependencies, converted));
+            }
+            converted.add(next);
+            result.add(next);
+        }
+        return result;
+    }
+
+    private static String findCycle(Map<String, Set<String>> dependencies, Set<String> converted) {
+        Set<String> remaining = new TreeSet<>(dependencies.keySet());
+        remaining.removeAll(converted);
+        for (String start : remaining) {
+            List<String> path = new ArrayList<>();
+            Map<String, Integer> positions = new HashMap<>();
+            String current = start;
+            while (current != null) {
+                Integer position = positions.put(current, path.size());
+                if (position != null) {
+                    List<String> cycle = new ArrayList<>(path.subList(position, path.size()));
+                    cycle.add(current);
+                    return String.join(" -> ", cycle);
+                }
+                path.add(current);
+                current = dependencies.get(current).stream()
+                        .filter(remaining::contains)
+                        .sorted()
+                        .findFirst()
+                        .orElse(null);
+            }
+        }
+        return String.join(" -> ", remaining);
+    }
+
+    private void replaceUsages(Map<Path, String> virtualFiles, Path jspTag, Path jteDestination) {
+        String oldPrefix = "<" + invocationName(jspTag);
+        String oldClosing = "</" + invocationName(jspTag) + ">";
+        String newJteFile = jteRoot.relativize(jteDestination).toString().replace('\\', '/');
+        for (Map.Entry<Path, String> file : virtualFiles.entrySet()) {
+            file.setValue(replaceUsage(file.getValue(), oldPrefix, oldClosing, newJteFile));
+        }
+    }
+
+    private String replaceUsage(String content, String oldPrefix, String oldClosing, String newJteFile) {
+        StringBuilder result = new StringBuilder(content);
+        int index = 0;
+        while ((index = result.indexOf(oldPrefix, index)) >= 0) {
+            int boundary = index + oldPrefix.length();
+            if (boundary < result.length()) {
+                char character = result.charAt(boundary);
+                if (Character.isWhitespace(character) || character == '/' || character == '>') {
+                    String replacement = "<" + jteTag + " jte=\"" + newJteFile + "\"";
+                    result.replace(index, boundary, replacement);
+                    index += replacement.length();
+                    continue;
+                }
+            }
+            index++;
+        }
+        index = 0;
+        while ((index = result.indexOf(oldClosing, index)) >= 0) {
+            String replacement = "</" + jteTag + ">";
+            result.replace(index, index + oldClosing.length(), replacement);
+            index += replacement.length();
+        }
+        return result.toString();
+    }
+
+    private static String invocationName(Path jspTag) {
+        String fileName = jspTag.getFileName().toString();
+        String tagName = fileName.substring(0, fileName.length() - ".tag".length());
+        Path parent = jspTag.getParent();
+        String namespace = parent == null ? "" : parent.getFileName().toString();
+        if ("tags".equals(namespace)) {
+            namespace = "include";
+        }
+        return namespace + ":" + tagName;
+    }
+
+    private static String stripJspComments(String content) {
+        StringBuilder result = new StringBuilder(content);
+        int start;
+        while ((start = result.indexOf("<%--")) >= 0) {
+            int end = result.indexOf("--%>", start + 4);
+            if (end < 0) {
+                result.delete(start, result.length());
+            } else {
+                result.delete(start, end + 4);
+            }
+        }
+        return result.toString();
+    }
+
+    private static boolean isUsageFile(Path path) {
+        String name = path.toString();
+        return name.endsWith(".jsp") || name.endsWith(".jsp.inc") || name.endsWith(".tag");
+    }
+
+    private static Path resourceBasePath(URL resourceBase) {
+        try {
+            URI uri = resourceBase.toURI();
+            if (!"file".equalsIgnoreCase(uri.getScheme())) {
+                throw new IllegalArgumentException("The converter resource base must be a file URL: " + resourceBase);
+            }
+            return Paths.get(uri).toAbsolutePath().normalize();
+        } catch (URISyntaxException e) {
+            throw new IllegalArgumentException("Invalid converter resource base: " + resourceBase, e);
+        }
+    }
+
+    private static Path realPath(Path path) {
+        try {
+            return path.toRealPath();
+        } catch (IOException e) {
+            throw new IllegalArgumentException("Path does not resolve to an existing file: " + path, e);
+        }
+    }
+
+    private static byte[] readBytes(Path path) {
+        try {
+            return Files.readAllBytes(path);
+        } catch (IOException e) {
+            throw new UncheckedIOException(e);
+        }
+    }
+
+    private static final class PlannedJspTagConverter implements CustomTagConverter {
+        private final String jteTagPath;
+
+        private PlannedJspTagConverter(String jteTagPath) {
+            this.jteTagPath = jteTagPath;
+        }
+
+        @Override
+        public void convert(JtpConverter converter, JtpCustomTag tag, ConverterOutput output,
+                            BodyConverter bodyConverter) throws JasperException {
+            Attributes attributes = tag.getAttributes();
+            String pathWithoutExtension = jteTagPath.substring(0, jteTagPath.length() - 4);
+            String tagCall = pathWithoutExtension.replace('/', '.');
+            int tagStartPosition = output.getCurrentLineCharCount();
+            String tagStartIndent = String.valueOf(output.getIndentationChar()).repeat(tagStartPosition);
+            output.append("@template.").append(tagCall).append("(");
+
+            boolean first = true;
+            for (int i = 0; i < attributes.getLength(); i++) {
+                if (!first) {
+                    output.append(",");
+                }
+                output.newLine(tagStartIndent);
+                output.indent(1);
+                output.append(attributes.getLocalName(i)).append(" = ")
+                        .append(convertAttributeValue(attributes.getValue(i)));
+                first = false;
+            }
+            if (tag.hasBody()) {
+                if (!first) {
+                    output.append(",");
+                }
+                output.newLine(tagStartIndent);
+                output.indent(1);
+                output.append("bodyContent = @`");
+                bodyConverter.convert();
+                output.append("`");
+                first = false;
+            }
+            if (!first) {
+                output.newLine(tagStartIndent);
+            }
+            output.append(")");
+        }
+    }
+}
