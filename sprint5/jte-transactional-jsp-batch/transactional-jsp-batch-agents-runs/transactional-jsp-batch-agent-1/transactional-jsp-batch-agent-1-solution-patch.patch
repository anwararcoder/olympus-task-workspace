+package gg.jte.convert.jsp;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.LinkOption;
+import java.nio.file.Path;
+import java.nio.file.StandardOpenOption;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collection;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeSet;
+
+public final class JspMigrationPlan {
+    private static final Comparator<Path> PATH_COMPARATOR = Comparator.comparing(Path::toString);
+
+    private final List<Path> conversionOrder;
+    private final Set<Path> deletes;
+    private final Map<Path, String> writes;
+    private final Map<Path, byte[]> snapshots;
+    private final Set<Path> generatedDestinations;
+    private final Set<Path> symbolicSnapshots;
+    private final JspToJteConverter converter;
+    private boolean committed;
+
+    JspMigrationPlan(Collection<Path> conversionOrder, Collection<Path> deletes, Map<Path, String> writes,
+                     Map<Path, byte[]> snapshots, Collection<Path> generatedDestinations, JspToJteConverter converter) {
+        this.conversionOrder = Collections.unmodifiableList(new ArrayList<>(conversionOrder));
+        this.deletes = Collections.unmodifiableSet(new LinkedHashSet<>(deletes));
+        this.writes = Collections.unmodifiableMap(new LinkedHashMap<>(writes));
+        this.snapshots = copySnapshots(snapshots);
+        this.generatedDestinations = Collections.unmodifiableSet(new LinkedHashSet<>(generatedDestinations));
+        Set<Path> symbolicPaths = new LinkedHashSet<>();
+        for (Path path : snapshots.keySet()) {
+            if (Files.isSymbolicLink(path)) {
+                symbolicPaths.add(path);
+            }
+        }
+        this.symbolicSnapshots = Collections.unmodifiableSet(symbolicPaths);
+        this.converter = converter;
+    }
+
+    public List<Path> getConversionOrder() {
+        return conversionOrder;
+    }
+
+    public Set<Path> getDeletes() {
+        return deletes;
+    }
+
+    public Map<Path, String> getWrites() {
+        return writes;
+    }
+
+    public synchronized void commit() throws IOException {
+        if (committed) {
+            throw new IllegalStateException("JSP migration plan has already been committed.");
+        }
+
+        List<Path> changedPaths = findChangedPaths();
+        if (!changedPaths.isEmpty()) {
+            throw new StaleJspMigrationPlanException(changedPaths);
+        }
+
+        List<Path> createdDirectories = findMissingDirectories();
+        boolean mutationStarted = false;
+        try {
+            for (Path directory : createdDirectories) {
+                mutationStarted = true;
+                converter.createMigrationDirectory(directory);
+            }
+
+            for (Map.Entry<Path, String> write : writes.entrySet()) {
+                mutationStarted = true;
+                byte[] content = write.getValue().getBytes(StandardCharsets.UTF_8);
+                if (generatedDestinations.contains(write.getKey())) {
+                    converter.writeMigrationFile(write.getKey(), content, true);
+                } else {
+                    converter.writeMigrationFile(write.getKey(), content, false);
+                }
+            }
+
+            for (Path delete : deletes) {
+                mutationStarted = true;
+                converter.deleteMigrationFile(delete);
+            }
+            committed = true;
+        } catch (IOException failure) {
+            if (mutationStarted) {
+                restore(failure, createdDirectories);
+            }
+            throw failure;
+        }
+    }
+
+    private List<Path> findChangedPaths() throws IOException {
+        Set<Path> changed = new TreeSet<>(PATH_COMPARATOR);
+        for (Map.Entry<Path, byte[]> snapshot : snapshots.entrySet()) {
+            Path path = snapshot.getKey();
+            if (Files.isSymbolicLink(path) != symbolicSnapshots.contains(path) || !Files.isRegularFile(path) || !Arrays.equals(snapshot.getValue(), Files.readAllBytes(path))) {
+                changed.add(path);
+            }
+        }
+        for (Path destination : generatedDestinations) {
+            if (Files.exists(destination, LinkOption.NOFOLLOW_LINKS)) {
+                changed.add(destination);
+            }
+        }
+        return new ArrayList<>(changed);
+    }
+
+    private List<Path> findMissingDirectories() {
+        Set<Path> missing = new TreeSet<>(Comparator.comparingInt(Path::getNameCount).thenComparing(Path::toString));
+        for (Path path : writes.keySet()) {
+            Path parent = path.getParent();
+            while (parent != null && !Files.exists(parent, LinkOption.NOFOLLOW_LINKS)) {
+                missing.add(parent);
+                parent = parent.getParent();
+            }
+        }
+        return new ArrayList<>(missing);
+    }
+
+    private void restore(IOException failure, List<Path> createdDirectories) {
+        Set<Path> affected = new TreeSet<>(PATH_COMPARATOR.reversed());
+        affected.addAll(writes.keySet());
+        affected.addAll(deletes);
+        for (Path path : affected) {
+            try {
+                byte[] original = snapshots.get(path);
+                if (original == null) {
+                    Files.deleteIfExists(path);
+                } else {
+                    Files.write(path, original, StandardOpenOption.CREATE, StandardOpenOption.TRUNCATE_EXISTING, StandardOpenOption.WRITE);
+                }
+            } catch (IOException restorationFailure) {
+                failure.addSuppressed(restorationFailure);
+            }
+        }
+
+        createdDirectories.sort(Comparator.comparingInt(Path::getNameCount).reversed().thenComparing(Path::toString));
+        for (Path directory : createdDirectories) {
+            try {
+                Files.deleteIfExists(directory);
+            } catch (IOException restorationFailure) {
+                failure.addSuppressed(restorationFailure);
+            }
+        }
+    }
+
+    private static Map<Path, byte[]> copySnapshots(Map<Path, byte[]> snapshots) {
+        Map<Path, byte[]> result = new LinkedHashMap<>();
+        for (Map.Entry<Path, byte[]> entry : snapshots.entrySet()) {
+            result.put(entry.getKey(), entry.getValue().clone());
+        }
+        return Collections.unmodifiableMap(result);
+    }
+}
