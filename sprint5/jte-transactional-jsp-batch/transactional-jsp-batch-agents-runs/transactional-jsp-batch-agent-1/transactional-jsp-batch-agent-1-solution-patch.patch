+    private Map<Path, byte[]> scanUsageFiles(Path normalizedJspRoot) {
+        Map<Path, byte[]> snapshots = new TreeMap<>(Comparator.comparing(Path::toString));
+        try (Stream<Path> stream = Files.walk(normalizedJspRoot)) {
+            stream.filter(path -> Files.isRegularFile(path, LinkOption.NOFOLLOW_LINKS))
