+    private Map<String, Path> validateSelectedTags(Collection<String> jspTags, Path normalizedJspRoot) {
+        Map<String, Path> selected = new TreeMap<>();
+        for (String jspTag : jspTags) {
+            if (jspTag == null || jspTag.trim().isEmpty()) {
+                throw new IllegalArgumentException("JSP tag paths must not be null or blank.");
+            }
+
+            final Path relativePath;
+            try {
+                relativePath = Paths.get(jspTag);
+            } catch (InvalidPathException e) {
+                throw new IllegalArgumentException("Invalid JSP tag path: " + jspTag, e);
+            }
+            if (relativePath.isAbsolute()) {
+                throw new IllegalArgumentException("JSP tag paths must be root-relative: " + jspTag);
+            }
+
+            Path normalizedRelativePath = relativePath.normalize();
+            String normalizedName = normalizedRelativePath.toString().replace('\\', '/');
+            Path selectedPath = normalizedJspRoot.resolve(normalizedRelativePath).normalize();
+            if (normalizedName.isEmpty() || !selectedPath.startsWith(normalizedJspRoot)) {
+                throw new IllegalArgumentException("JSP tag path is outside the JSP root: " + jspTag);
+            }
+            if (!normalizedName.endsWith(".tag")) {
+                throw new IllegalArgumentException("JSP tag path must end in .tag: " + jspTag);
+            }
+            if (selected.put(normalizedName, selectedPath) != null) {
+                throw new IllegalArgumentException("Duplicate JSP tag path: " + jspTag);
+            }
+            if (Files.isSymbolicLink(selectedPath)) {
+                throw new IllegalArgumentException("Selected JSP tag must not be a symbolic link: " + selectedPath);
+            }
+            if (!Files.isRegularFile(selectedPath, LinkOption.NOFOLLOW_LINKS)) {
+                throw new IllegalArgumentException("Selected JSP tag is missing or not a regular file: " + selectedPath);
+            }
+            try {
+                if (!selectedPath.toRealPath().startsWith(normalizedJspRoot.toRealPath())) {
+                    throw new IllegalArgumentException("JSP tag path is outside the JSP root: " + jspTag);
+                }
+            } catch (IOException e) {
+                throw new IllegalArgumentException("Failed to resolve selected JSP tag: " + selectedPath, e);
+            }
+        }
+        return selected;
+    }
