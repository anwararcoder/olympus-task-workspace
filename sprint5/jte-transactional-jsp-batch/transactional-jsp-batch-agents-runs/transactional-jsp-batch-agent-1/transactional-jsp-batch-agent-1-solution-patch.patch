+    private void validateApprovedIncludes(Collection<String> includes, URL resourceBase, Path normalizedJspRoot) {
+        for (String include : includes) {
+            resolveInclude(resourceBase, include, normalizedJspRoot);
+        }
+    }
+
+    private Path resolveInclude(URL resourceBase, String include, Path normalizedJspRoot) {
+        try {
+            if (!"file".equalsIgnoreCase(resourceBase.getProtocol())) {
+                throw new IllegalArgumentException("The converter resource base must be a file URL when planning migrations: " + resourceBase);
+            }
+            Path base = Paths.get(resourceBase.toURI()).toAbsolutePath().normalize();
+            String relativeInclude = include.startsWith("/") ? include.substring(1) : include;
+            Path resolved = base.resolve(relativeInclude).normalize();
+            if (!resolved.startsWith(normalizedJspRoot)) {
+                throw new IllegalArgumentException("Approved include is outside the JSP root: " + include);
+            }
+            if (Files.exists(resolved) && !resolved.toRealPath().startsWith(normalizedJspRoot.toRealPath())) {
+                throw new IllegalArgumentException("Approved include is outside the JSP root: " + include);
+            }
+            return resolved;
+        } catch (URISyntaxException | InvalidPathException | IOException e) {
+            throw new IllegalArgumentException("Invalid approved include path: " + include, e);
+        }
+    }
+
+    private List<String> conversionOrder(Map<String, Set<String>> dependencies) {
+        Set<String> remaining = new TreeSet<>(dependencies.keySet());
+        List<String> result = new ArrayList<>();
+        while (!remaining.isEmpty()) {
+            String ready = null;
+            for (String candidate : remaining) {
+                if (Collections.disjoint(dependencies.get(candidate), remaining)) {
+                    ready = candidate;
+                    break;
+                }
+            }
+            if (ready == null) {
