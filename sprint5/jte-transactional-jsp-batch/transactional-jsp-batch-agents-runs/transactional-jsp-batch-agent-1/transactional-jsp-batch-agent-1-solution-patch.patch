+    private Map<String, Path> validateDestinations(Map<String, Path> selected, Path normalizedJteRoot) {
+        Map<String, Path> result = new TreeMap<>();
+        Map<Path, String> owners = new HashMap<>();
+        for (String jspTag : selected.keySet()) {
+            String suggested = suggestJteFile(jspTag);
+            if (suggested == null || suggested.trim().isEmpty()) {
+                throw new IllegalArgumentException("Generated JTE destination must not be null or blank for " + jspTag);
+            }
+            Path suggestedPath;
+            try {
+                suggestedPath = Paths.get(suggested);
+            } catch (InvalidPathException e) {
+                throw new IllegalArgumentException("Invalid generated JTE destination for " + jspTag + ": " + suggested, e);
+            }
+            if (suggestedPath.isAbsolute()) {
+                throw new IllegalArgumentException("Generated JTE destination is outside the JTE root: " + suggested);
+            }
+            Path destination = normalizedJteRoot.resolve(suggestedPath).normalize();
+            if (!destination.startsWith(normalizedJteRoot)) {
+                throw new IllegalArgumentException("Generated JTE destination is outside the JTE root: " + suggested);
+            }
+            String previous = owners.put(destination, jspTag);
