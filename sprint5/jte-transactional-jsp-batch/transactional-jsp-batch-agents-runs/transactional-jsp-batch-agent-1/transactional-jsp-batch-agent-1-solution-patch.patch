+    private void validateDestinationParents(Path destination, Path normalizedJteRoot) {
+        Path current = destination.getParent();
+        while (current != null && current.startsWith(normalizedJteRoot)) {
+            if (Files.isSymbolicLink(current)) {
+                throw new IllegalArgumentException("Generated JTE destination resolves through a symbolic link: " + destination);
+            }
+            if (Files.exists(current, LinkOption.NOFOLLOW_LINKS) && !Files.isDirectory(current, LinkOption.NOFOLLOW_LINKS)) {
+                throw new IllegalArgumentException("Generated JTE destination parent is not a directory: " + current);
+            }
+            if (current.equals(normalizedJteRoot)) {
+                break;
+            }
+            current = current.getParent();
+        }
+    }
