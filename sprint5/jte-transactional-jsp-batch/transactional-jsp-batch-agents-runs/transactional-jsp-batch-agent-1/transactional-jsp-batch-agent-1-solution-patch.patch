+
+    private static boolean isUsageFile(String fileName) {
+        return fileName.endsWith(".jsp") || fileName.endsWith(".jsp.inc") || fileName.endsWith(".tag");
+    }
+
+    private void snapshotFile(Path path, Map<Path, byte[]> snapshots) {
+        if (snapshots.containsKey(path)) {
+            return;
+        }
+        try {
+            if (!Files.isRegularFile(path)) {
+                throw new IllegalArgumentException("Included JSP path is missing or not a regular file: " + path);
+            }
