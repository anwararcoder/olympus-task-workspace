+    private Map<String, String> invocationNames(Map<String, Path> selected) {
+        Map<String, String> result = new TreeMap<>();
+        for (Map.Entry<String, Path> entry : selected.entrySet()) {
+            String invocation = extractTagPrefix(entry.getValue()).substring(1);
+            String previous = result.put(invocation, entry.getKey());
+            if (previous != null) {
+                throw new IllegalArgumentException("Ambiguous selected invocation name " + invocation + ": " + previous + " and " + entry.getKey());
+            }
+        }
+        return result;
+    }
