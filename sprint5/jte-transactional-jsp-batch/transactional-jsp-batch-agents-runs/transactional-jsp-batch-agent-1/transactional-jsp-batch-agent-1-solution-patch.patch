+    private List<String> findCycle(Set<String> remaining, Map<String, Set<String>> dependencies) {
+        Map<String, Integer> positions = new LinkedHashMap<>();
+        List<String> path = new ArrayList<>();
+        String current = remaining.iterator().next();
+        while (!positions.containsKey(current)) {
+            positions.put(current, path.size());
+            path.add(current);
+            current = dependencies.get(current).stream().filter(remaining::contains).findFirst().orElseThrow(IllegalStateException::new);
+        }
+        List<String> cycle = new ArrayList<>(path.subList(positions.get(current), path.size()));
+        cycle.add(current);
+        return cycle;
+    }
