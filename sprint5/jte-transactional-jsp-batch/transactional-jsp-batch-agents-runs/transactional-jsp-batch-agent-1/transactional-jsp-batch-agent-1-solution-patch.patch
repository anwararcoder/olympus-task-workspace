+++ b/jte-jsp-converter/src/test/java/gg/jte/convert/jsp/JspMigrationPlanTest.java
@@ -0,0 +1,219 @@
+package gg.jte.convert.jsp;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+import java.io.IOException;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Arrays;
+import java.util.List;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+class JspMigrationPlanTest {
+    @TempDir
+    Path tempDir;
+
+    Path jspRoot;
+    Path jteRoot;
+    Path dependency;
+    Path parent;
+    Path usage;
+
+    @BeforeEach
+    void setUp() throws IOException {
+        jspRoot = tempDir.resolve("jsp");
+        jteRoot = tempDir.resolve("jte");
+        dependency = jspRoot.resolve("WEB-INF/tags/my/dependency.tag");
+        parent = jspRoot.resolve("WEB-INF/tags/my/parent.tag");
+        usage = jspRoot.resolve("usage.jsp");
+        Files.createDirectories(dependency.getParent());
+        Files.createDirectories(jspRoot.resolve("WEB-INF/tld"));
+        Files.copy(Path.of("WEB-INF/tld/my.tld"), jspRoot.resolve("WEB-INF/tld/my.tld"));
+        Files.writeString(dependency, "dependency", StandardCharsets.UTF_8);
+        Files.writeString(parent, taglib() + "<my:dependency/>", StandardCharsets.UTF_8);
+        Files.writeString(usage, taglib() + "<my:parent/>", StandardCharsets.UTF_8);
+    }
+
+    @Test
+    void plansAndCommitsInDependencyOrder() throws IOException {
+        JspMigrationPlan plan = converter().planTags(Arrays.asList(
+                "WEB-INF/tags/my/parent.tag",
+                "WEB-INF/tags/my/dependency.tag"
+        ), null);
+
+        assertThat(plan.getConversionOrder()).containsExactly(dependency, parent);
+        assertThat(plan.getDeletes()).containsExactlyInAnyOrder(dependency, parent);
+        assertThat(plan.getWrites().keySet()).contains(
+                jteRoot.resolve("WEBINF/tags/my/dependency.jte"),
+                jteRoot.resolve("WEBINF/tags/my/parent.jte"),
+                usage
+        );
+        assertThat(plan.getWrites().get(jteRoot.resolve("WEBINF/tags/my/parent.jte")))
+                .contains("@template.WEBINF.tags.my.dependency()");
+        assertThat(dependency).exists();
+        assertThat(jteRoot).doesNotExist();
+
+        plan.commit();
+
+        assertThat(dependency).doesNotExist();
+        assertThat(parent).doesNotExist();
+        assertThat(usage).content(StandardCharsets.UTF_8).contains("<converted:jte jte=\"WEBINF/tags/my/parent.jte\"");
+        assertThat(jteRoot.resolve("WEBINF/tags/my/dependency.jte")).exists();
+        assertThatThrownBy(plan::commit).isInstanceOf(IllegalStateException.class);
+    }
+
+    @Test
+    void planCollectionsAreImmutable() {
+        JspMigrationPlan plan = converter().planTags(List.of("WEB-INF/tags/my/dependency.tag"), null);
+
+        assertThatThrownBy(() -> plan.getConversionOrder().add(parent)).isInstanceOf(UnsupportedOperationException.class);
+        assertThatThrownBy(() -> plan.getDeletes().clear()).isInstanceOf(UnsupportedOperationException.class);
+        assertThatThrownBy(() -> plan.getWrites().clear()).isInstanceOf(UnsupportedOperationException.class);
+    }
+
+    @Test
+    void reportsAllStalePathsBeforeMutation() throws IOException {
+        JspMigrationPlan plan = converter().planTags(Arrays.asList(
+                "WEB-INF/tags/my/parent.tag",
+                "WEB-INF/tags/my/dependency.tag"
+        ), null);
+        Path destination = jteRoot.resolve("WEBINF/tags/my/dependency.jte");
+        Files.writeString(dependency, "changed dependency", StandardCharsets.UTF_8);
+        Files.writeString(usage, "changed usage", StandardCharsets.UTF_8);
+        Files.createDirectories(destination.getParent());
+        Files.writeString(destination, "occupied", StandardCharsets.UTF_8);
+
+        assertThatThrownBy(plan::commit)
+                .isInstanceOfSatisfying(StaleJspMigrationPlanException.class, exception ->
+                        assertThat(exception.getChangedPaths()).containsExactly(dependency, usage, destination));
+        assertThat(parent).exists();
+        assertThat(jteRoot.resolve("WEBINF/tags/my/parent.jte")).doesNotExist();
+    }
+
+    @Test
+    void jspCommentsDoNotCreateDependencies() throws IOException {
+        Files.writeString(dependency, "<%-- <my:parent/> --%>", StandardCharsets.UTF_8);
+        Files.writeString(parent, taglib() + "<my:dependency/>", StandardCharsets.UTF_8);
+
+        JspMigrationPlan plan = converter().planTags(Arrays.asList(
+                "WEB-INF/tags/my/parent.tag",
+                "WEB-INF/tags/my/dependency.tag"
+        ), null);
+
+        assertThat(plan.getConversionOrder()).containsExactly(dependency, parent);
+    }
+
+
+    @Test
+    void findsDependenciesInApprovedIncludes() throws IOException {
+        Path include = jspRoot.resolve("WEB-INF/import.jsp.inc");
+        Files.writeString(include, taglib() + "<my:dependency/>", StandardCharsets.UTF_8);
+        Files.writeString(parent, "<%@ include file=\"/WEB-INF/import.jsp.inc\" %>", StandardCharsets.UTF_8);
+
+        JspMigrationPlan plan = converter().planTags(Arrays.asList(
+                "WEB-INF/tags/my/parent.tag",
+                "WEB-INF/tags/my/dependency.tag"
+        ), configured -> configured.addInlinedInclude("/WEB-INF/import.jsp.inc"));
+
+        assertThat(plan.getConversionOrder()).containsExactly(dependency, parent);
+        assertThat(plan.getWrites()).containsKey(include);
+        assertThat(plan.getWrites().get(jteRoot.resolve("WEBINF/tags/my/parent.jte")))
+                .contains("@template.WEBINF.tags.my.dependency()");
+    }
+
+    @Test
+    void reportsDeterministicClosedCycle() throws IOException {
+        Files.writeString(dependency, taglib() + "<my:parent/>", StandardCharsets.UTF_8);
+
+        assertThatThrownBy(() -> converter().planTags(Arrays.asList(
+                "WEB-INF/tags/my/parent.tag",
+                "WEB-INF/tags/my/dependency.tag"
+        ), null)).isInstanceOf(IllegalArgumentException.class)
+                .hasMessage("JSP tag dependency cycle: WEB-INF/tags/my/dependency.tag -> WEB-INF/tags/my/parent.tag -> WEB-INF/tags/my/dependency.tag");
+    }
+
+    @Test
+    void parserSetupFailureSurfacesUnchanged() {
+        RuntimeException failure = new RuntimeException("setup failed");
+
+        assertThatThrownBy(() -> converter().planTags(List.of("WEB-INF/tags/my/dependency.tag"), configured -> {
+            throw failure;
+        })).isSameAs(failure);
+    }
+
+    @Test
+    void rejectsApprovedIncludesOutsideJspRoot() {
+        assertThatThrownBy(() -> converter().planTags(List.of("WEB-INF/tags/my/dependency.tag"), configured ->
+                configured.addInlinedInclude("../outside.jsp.inc")))
+                .isInstanceOf(IllegalArgumentException.class);
+    }
+
+    @Test
+    void rollsBackAndCanRetryAfterIoFailure() throws IOException {
+        FailingConverter converter = new FailingConverter();
+        String originalUsage = Files.readString(usage);
+        JspMigrationPlan plan = converter.planTags(Arrays.asList(
+                "WEB-INF/tags/my/parent.tag",
+                "WEB-INF/tags/my/dependency.tag"
+        ), null);
+
+        assertThatThrownBy(plan::commit).isInstanceOf(IOException.class).hasMessage("boom");
+        assertThat(dependency).exists();
+        assertThat(parent).exists();
+        assertThat(usage).content(StandardCharsets.UTF_8).isEqualTo(originalUsage);
+        assertThat(jteRoot).doesNotExist();
+
+        plan.commit();
+        assertThat(dependency).doesNotExist();
+    }
+
+    private JspToJteConverter converter() {
+        return new JspToJteConverter(jspRoot, jteRoot, "converted:jte") {
+            @Override
+            protected URL getResourceBase() {
+                try {
+                    return jspRoot.toUri().toURL();
+                } catch (IOException e) {
+                    throw new RuntimeException(e);
+                }
+            }
+        };
+    }
+
+    private String taglib() {
+        return "<%@ taglib prefix=\"my\" tagdir=\"/WEB-INF/tags/my\" %>\n" +
+                "<%@ taglib prefix=\"converted\" uri=\"/WEB-INF/tld/my.tld\" %>\n";
+    }
+
+    private class FailingConverter extends JspToJteConverter {
+        private boolean fail = true;
+
+        FailingConverter() {
+            super(jspRoot, jteRoot, "converted:jte");
+        }
+
+        @Override
+        protected URL getResourceBase() {
+            try {
+                return jspRoot.toUri().toURL();
+            } catch (IOException e) {
+                throw new RuntimeException(e);
+            }
+        }
+
+        @Override
+        protected void deleteMigrationFile(Path path) throws IOException {
+            if (fail) {
+                fail = false;
+                throw new IOException("boom");
+            }
+            super.deleteMigrationFile(path);
+        }
+    }
+}
