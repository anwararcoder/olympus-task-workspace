+package gg.jte.convert.jsp;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+import java.io.IOException;
+import java.io.UncheckedIOException;
+import java.net.URL;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.Paths;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.concurrent.atomic.AtomicInteger;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+class JspMigrationPlanTest {
+    @TempDir
+    Path tempDir;
+
+    @Test
+    void plansAndCommitsDependenciesTransactionally() throws Exception {
+        Fixture fixture = fixture();
+        Path first = fixture.writeTag("a", directives() + "<x:b/>");
+        Path dependency = fixture.writeTag("b", "dependency");
+        Path usage = fixture.write("usage.jsp", directives() + "<x:a/>");
+
+        JspMigrationPlan plan = fixture.converter.planTags(Arrays.asList(
+                "WEB-INF/tags/x/a.tag", "WEB-INF/tags/x/b.tag"), converter -> converter.setPrefix("@import java.util.List\n"));
+
+        assertThat(plan.getConversionOrder()).containsExactly(dependency, first);
+        assertThat(plan.getDeletes()).containsExactlyInAnyOrder(first, dependency);
+        assertThat(plan.getWrites()).containsKeys(fixture.jteRoot.resolve("tag/a.jte"),
+                fixture.jteRoot.resolve("tag/b.jte"), usage);
+        assertThat(Files.readString(first)).contains("<x:b/>");
+        assertThat(Files.exists(fixture.jteRoot)).isFalse();
+        assertThatThrownBy(() -> plan.getConversionOrder().add(first)).isInstanceOf(UnsupportedOperationException.class);
+        assertThatThrownBy(() -> plan.getWrites().clear()).isInstanceOf(UnsupportedOperationException.class);
+
+        plan.commit();
+
+        assertThat(first).doesNotExist();
+        assertThat(dependency).doesNotExist();
+        assertThat(usage).content().contains("<my:jte jte=\"tag/a.jte\"");
+        assertThat(fixture.jteRoot.resolve("tag/a.jte")).exists();
+        assertThatThrownBy(plan::commit).isInstanceOf(IllegalStateException.class);
+    }
+
+    @Test
+    void detectsAllStaleContentBeforeMutating() throws Exception {
+        Fixture fixture = fixture();
+        Path tag = fixture.writeTag("a", "tag");
+        Path usage = fixture.write("usage.jsp", directives() + "<x:a/>");
+        JspMigrationPlan plan = fixture.converter.planTags(Collections.singleton("WEB-INF/tags/x/a.tag"), null);
+        Files.writeString(tag, "changed tag");
+        Files.writeString(usage, "changed usage");
+
+        assertThatThrownBy(plan::commit)
+                .isInstanceOfSatisfying(StaleJspMigrationPlanException.class,
+                        exception -> assertThat(exception.getChangedPaths()).containsExactly(tag, usage));
+        assertThat(fixture.jteRoot).doesNotExist();
+    }
+
+    @Test
+    void jspCommentsDoNotCreateDependencies() throws Exception {
+        Fixture fixture = fixture();
+        Path tag = fixture.writeTag("a", directives() + "<%-- <x:missing/> --%>ok");
+
+        JspMigrationPlan plan = fixture.converter.planTags(Collections.singleton("WEB-INF/tags/x/a.tag"), null);
+
+        assertThat(plan.getConversionOrder()).containsExactly(tag);
+    }
+
+    @Test
+    void reportsDeterministicClosedCycle() throws Exception {
+        Fixture fixture = fixture();
+        fixture.writeTag("a", directives() + "<x:b/>");
+        fixture.writeTag("b", directives() + "<x:a/>");
+
+        assertThatThrownBy(() -> fixture.converter.planTags(Arrays.asList(
+                "WEB-INF/tags/x/b.tag", "WEB-INF/tags/x/a.tag"), null))
+                .isInstanceOf(IllegalArgumentException.class)
+                .hasMessageContaining("WEB-INF/tags/x/a.tag -> WEB-INF/tags/x/b.tag -> WEB-INF/tags/x/a.tag");
+    }
+
+    @Test
+    void findsDependenciesInApprovedIncludesAndSnapshotsThem() throws Exception {
+        Fixture fixture = fixture();
+        Path first = fixture.writeTag("a", "<%@ include file=\"/WEB-INF/includes/common.jsp.inc\" %>");
+        Path dependency = fixture.writeTag("b", "dependency");
+        Path include = fixture.write("WEB-INF/includes/common.jsp.inc", directives() + "<x:b/>");
+        AtomicInteger setupCalls = new AtomicInteger();
+
+        JspMigrationPlan plan = fixture.converter.planTags(Arrays.asList(
+                "WEB-INF/tags/x/a.tag", "WEB-INF/tags/x/b.tag"), converter -> {
+            setupCalls.incrementAndGet();
+            converter.addInlinedInclude("/WEB-INF/includes/common.jsp.inc");
+        });
+
+        assertThat(setupCalls).hasValue(2);
+        assertThat(plan.getConversionOrder()).containsExactly(dependency, first);
+        assertThat(plan.getWrites()).containsEntry(include,
+                directives() + "<my:jte jte=\"tag/b.jte\"/>");
+
+        Files.writeString(include, "changed");
+        assertThatThrownBy(plan::commit)
+                .isInstanceOfSatisfying(StaleJspMigrationPlanException.class,
+                        exception -> assertThat(exception.getChangedPaths()).containsExactly(include));
+    }
+
+    @Test
+    void parserSetupFailuresSurfaceUnchanged() throws Exception {
+        Fixture fixture = fixture();
+        fixture.writeTag("a", "tag");
+        IllegalStateException failure = new IllegalStateException("setup failed");
+
+        assertThatThrownBy(() -> fixture.converter.planTags(
+                Collections.singleton("WEB-INF/tags/x/a.tag"), converter -> {
+                    throw failure;
+                })).isSameAs(failure);
+    }
+
+    private Fixture fixture() throws IOException {
+        return new Fixture(tempDir.resolve("jsp"), tempDir.resolve("jte"));
+    }
+
+    private static String directives() {
+        return "<%@ taglib prefix=\"x\" tagdir=\"/WEB-INF/tags/x\" %>\n"
+                + "<%@ taglib prefix=\"my\" uri=\"https://jte.gg/test\" %>\n";
+    }
+
+    private static final class Fixture {
+        private final Path jspRoot;
+        private final Path jteRoot;
+        private final JspToJteConverter converter;
+
+        private Fixture(Path jspRoot, Path jteRoot) throws IOException {
+            this.jspRoot = jspRoot.toAbsolutePath().normalize();
+            this.jteRoot = jteRoot.toAbsolutePath().normalize();
+            Path tld = this.jspRoot.resolve("WEB-INF/tld/my.tld");
+            Files.createDirectories(tld.getParent());
+            String tldContent = Files.readString(Paths.get("WEB-INF/tld/my.tld"))
+                    .replace("<short-name>my</short-name>",
+                            "<short-name>my</short-name>\n   <uri>https://jte.gg/test</uri>");
+            Files.writeString(tld, tldContent);
+            this.converter = new JspToJteConverter(this.jspRoot, this.jteRoot, "my:jte") {
+                @Override
+                protected URL getResourceBase() {
+                    try {
+                        return jspRoot.toUri().toURL();
+                    } catch (IOException e) {
+                        throw new UncheckedIOException(e);
+                    }
+                }
+
+                @Override
+                public String suggestJteFile(String jspFile) {
+                    String fileName = Paths.get(jspFile).getFileName().toString();
+                    return "tag/" + fileName.substring(0, fileName.length() - 4) + ".jte";
+                }
+            };
+        }
+
+        private Path writeTag(String name, String content) throws IOException {
+            return write("WEB-INF/tags/x/" + name + ".tag", content);
+        }
+
+        private Path write(String relativePath, String content) throws IOException {
+            Path path = jspRoot.resolve(relativePath);
+            Files.createDirectories(path.getParent());
+            Files.writeString(path, content);
+            return path;
+        }
+    }
+}
