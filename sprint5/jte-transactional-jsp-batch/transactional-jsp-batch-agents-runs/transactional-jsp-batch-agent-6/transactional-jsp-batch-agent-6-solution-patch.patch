+package gg.jte.convert.jsp;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.LinkOption;
+import java.nio.file.Path;
+import java.nio.file.StandardOpenOption;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collection;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+public class JspMigrationPlan {
+    private final List<Path> conversionOrder;
+    private final Set<Path> deletes;
+    private final Map<Path, String> writes;
+    private final Map<Path, byte[]> snapshots;
+    private final Set<Path> generatedDestinations;
+    private boolean committed;
+
+    JspMigrationPlan(Collection<Path> conversionOrder, Collection<Path> deletes, Map<Path, String> writes,
+                     Map<Path, byte[]> snapshots, Collection<Path> generatedDestinations) {
+        this.conversionOrder = Collections.unmodifiableList(new ArrayList<>(conversionOrder));
+        this.deletes = Collections.unmodifiableSet(new LinkedHashSet<>(deletes));
+        this.writes = Collections.unmodifiableMap(new LinkedHashMap<>(writes));
+        this.snapshots = copySnapshots(snapshots);
+        this.generatedDestinations = Collections.unmodifiableSet(new LinkedHashSet<>(generatedDestinations));
+    }
+
+    public List<Path> getConversionOrder() {
+        return conversionOrder;
+    }
+
+    public Set<Path> getDeletes() {
+        return deletes;
+    }
+
+    public Map<Path, String> getWrites() {
+        return writes;
+    }
+
+    public synchronized void commit() throws IOException {
+        if (committed) {
+            throw new IllegalStateException("JSP migration plan has already been committed.");
+        }
+
+        List<Path> changedPaths = findChangedPaths();
+        if (!changedPaths.isEmpty()) {
+            throw new StaleJspMigrationPlanException(changedPaths);
+        }
+
+        Map<Path, byte[]> originals = new LinkedHashMap<>();
+        Set<Path> absentBeforeCommit = new LinkedHashSet<>();
+        for (Path path : affectedPaths()) {
+            if (Files.exists(path, LinkOption.NOFOLLOW_LINKS)) {
+                originals.put(path, Files.readAllBytes(path));
+            } else {
+                absentBeforeCommit.add(path);
+            }
+        }
+
+        Set<Path> createdDirectories = new LinkedHashSet<>();
+        try {
+            for (Map.Entry<Path, String> write : writes.entrySet()) {
+                createDirectories(write.getKey().getParent(), createdDirectories);
+                Files.write(write.getKey(), write.getValue().getBytes(StandardCharsets.UTF_8),
+                        StandardOpenOption.CREATE, StandardOpenOption.TRUNCATE_EXISTING, StandardOpenOption.WRITE);
+            }
+            for (Path delete : deletes) {
+                Files.delete(delete);
+            }
+            committed = true;
+        } catch (IOException failure) {
+            restore(originals, absentBeforeCommit, createdDirectories, failure);
+            throw failure;
+        }
+    }
+
+    private List<Path> findChangedPaths() throws IOException {
+        Set<Path> changed = new LinkedHashSet<>();
+        for (Map.Entry<Path, byte[]> snapshot : snapshots.entrySet()) {
+            Path path = snapshot.getKey();
+            if (!Files.isRegularFile(path, LinkOption.NOFOLLOW_LINKS)
+                    || !Arrays.equals(snapshot.getValue(), Files.readAllBytes(path))) {
+                changed.add(path);
+            }
+        }
+        for (Path destination : generatedDestinations) {
+            if (Files.exists(destination, LinkOption.NOFOLLOW_LINKS)) {
+                changed.add(destination);
+            }
+        }
+        List<Path> result = new ArrayList<>(changed);
+        result.sort(Comparator.comparing(Path::toString));
+        return result;
+    }
+
+    private Set<Path> affectedPaths() {
+        Set<Path> result = new LinkedHashSet<>(writes.keySet());
+        result.addAll(deletes);
+        return result;
+    }
+
+    private static void createDirectories(Path directory, Set<Path> createdDirectories) throws IOException {
+        if (directory == null || Files.exists(directory, LinkOption.NOFOLLOW_LINKS)) {
+            return;
+        }
+        createDirectories(directory.getParent(), createdDirectories);
+        Files.createDirectory(directory);
+        createdDirectories.add(directory);
+    }
+
+    private static void restore(Map<Path, byte[]> originals, Set<Path> absentBeforeCommit,
+                                Set<Path> createdDirectories, IOException failure) {
+        List<Path> paths = new ArrayList<>(absentBeforeCommit);
+        paths.sort(Comparator.comparingInt(Path::getNameCount).reversed());
+        for (Path path : paths) {
+            try {
+                Files.deleteIfExists(path);
+            } catch (IOException restoreFailure) {
+                failure.addSuppressed(restoreFailure);
+            }
+        }
+
+        for (Map.Entry<Path, byte[]> original : originals.entrySet()) {
+            try {
+                Path parent = original.getKey().getParent();
+                if (parent != null) {
+                    Files.createDirectories(parent);
+                }
+                Files.write(original.getKey(), original.getValue(), StandardOpenOption.CREATE,
+                        StandardOpenOption.TRUNCATE_EXISTING, StandardOpenOption.WRITE);
+            } catch (IOException restoreFailure) {
+                failure.addSuppressed(restoreFailure);
+            }
+        }
+
+        List<Path> directories = new ArrayList<>(createdDirectories);
+        directories.sort(Comparator.comparingInt(Path::getNameCount).reversed());
+        for (Path directory : directories) {
+            try {
