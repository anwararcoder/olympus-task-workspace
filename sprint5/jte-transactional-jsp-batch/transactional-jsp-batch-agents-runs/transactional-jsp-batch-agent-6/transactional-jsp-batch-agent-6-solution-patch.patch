+    private String findCycle(Path current, Set<Path> remaining, Map<Path, Set<Path>> dependencies,
+                             Path normalizedJspRoot, List<Path> stack, Map<Path, Integer> positions) {
+        Integer cycleStart = positions.get(current);
+        if (cycleStart != null) {
+            List<String> cycle = new ArrayList<>();
+            for (int i = cycleStart; i < stack.size(); i++) {
+                cycle.add(toRelativeString(normalizedJspRoot, stack.get(i)));
