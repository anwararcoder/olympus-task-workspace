+package gg.jte.convert.jsp;
+
+import java.io.IOException;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+
+public class StaleJspMigrationPlanException extends IOException {
+    private final List<Path> changedPaths;
+
+    public StaleJspMigrationPlanException(List<Path> changedPaths) {
+        super("JSP migration plan is stale: " + changedPaths);
+        this.changedPaths = Collections.unmodifiableList(new ArrayList<>(changedPaths));
+    }
+
+    public List<Path> getChangedPaths() {
+        return changedPaths;
+    }
+}
