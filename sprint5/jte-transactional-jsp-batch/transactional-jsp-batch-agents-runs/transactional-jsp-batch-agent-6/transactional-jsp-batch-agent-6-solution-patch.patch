+        positions.put(current, stack.size());
+        stack.add(current);
+        List<Path> nextPaths = new ArrayList<>(dependencies.get(current));
+        nextPaths.removeIf(path -> !remaining.contains(path));
+        nextPaths.sort(Comparator.comparing(path -> toRelativeString(normalizedJspRoot, path)));
