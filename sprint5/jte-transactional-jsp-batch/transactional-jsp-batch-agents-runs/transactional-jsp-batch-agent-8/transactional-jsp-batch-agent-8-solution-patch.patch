+package gg.jte.convert.jsp;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.LinkOption;
+import java.nio.file.Path;
+import java.nio.file.StandardOpenOption;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+public final class JspMigrationPlan {
+    private final List<Path> conversionOrder;
+    private final Set<Path> deletes;
+    private final Map<Path, String> writes;
+    private final Map<Path, Snapshot> snapshots;
+    private final Set<Path> generatedDestinations;
+    private boolean committed;
+
+    JspMigrationPlan(List<Path> conversionOrder, Set<Path> deletes, Map<Path, String> writes,
+                     Map<Path, Snapshot> snapshots, Set<Path> generatedDestinations) {
+        this.conversionOrder = List.copyOf(conversionOrder);
+        this.deletes = Collections.unmodifiableSet(new LinkedHashSet<>(deletes));
+        this.writes = Collections.unmodifiableMap(new LinkedHashMap<>(writes));
+        this.snapshots = Collections.unmodifiableMap(new LinkedHashMap<>(snapshots));
+        this.generatedDestinations = Collections.unmodifiableSet(new LinkedHashSet<>(generatedDestinations));
+    }
+
+    public List<Path> getConversionOrder() {
+        return conversionOrder;
+    }
+
+    public Set<Path> getDeletes() {
+        return deletes;
+    }
+
+    public Map<Path, String> getWrites() {
+        return writes;
+    }
+
+    public synchronized void commit() throws IOException {
+        if (committed) {
+            throw new IllegalStateException("This JSP migration plan has already been committed.");
+        }
+
+        List<Path> changedPaths = findChangedPaths();
+        if (!changedPaths.isEmpty()) {
+            throw new StaleJspMigrationPlanException(changedPaths);
+        }
+
+        Map<Path, byte[]> originalFiles = new LinkedHashMap<>();
+        Set<Path> originallyAbsent = new LinkedHashSet<>();
+        Set<Path> affectedPaths = new LinkedHashSet<>();
+        affectedPaths.addAll(writes.keySet());
+        affectedPaths.addAll(deletes);
+        for (Path path : affectedPaths) {
+            if (Files.exists(path, LinkOption.NOFOLLOW_LINKS)) {
+                originalFiles.put(path, Files.readAllBytes(path));
+            } else {
+                originallyAbsent.add(path);
+            }
+        }
+
+        Set<Path> createdDirectories = new LinkedHashSet<>();
+        boolean mutationStarted = false;
+        try {
+            for (Map.Entry<Path, String> write : writes.entrySet()) {
+                mutationStarted = true;
+                createParentDirectories(write.getKey(), createdDirectories);
+                if (generatedDestinations.contains(write.getKey())) {
+                    Files.writeString(write.getKey(), write.getValue(), StandardCharsets.UTF_8,
+                            StandardOpenOption.CREATE_NEW, StandardOpenOption.WRITE);
+                } else {
+                    Files.writeString(write.getKey(), write.getValue(), StandardCharsets.UTF_8,
+                            StandardOpenOption.TRUNCATE_EXISTING, StandardOpenOption.WRITE);
+                }
+            }
+            for (Path delete : deletes) {
+                mutationStarted = true;
+                Files.delete(delete);
+            }
+            committed = true;
+        } catch (IOException failure) {
+            if (mutationStarted) {
+                restore(originalFiles, originallyAbsent, createdDirectories, failure);
+            }
+            throw failure;
+        }
+    }
+
+    private List<Path> findChangedPaths() throws IOException {
+        Set<Path> changed = new LinkedHashSet<>();
+        for (Map.Entry<Path, Snapshot> entry : snapshots.entrySet()) {
+            if (!entry.getValue().matches(entry.getKey())) {
+                changed.add(entry.getKey());
+            }
+        }
+        for (Path destination : generatedDestinations) {
+            if (Files.exists(destination, LinkOption.NOFOLLOW_LINKS)) {
+                changed.add(destination);
+            }
+        }
+        List<Path> result = new ArrayList<>(changed);
+        result.sort(Comparator.comparing(Path::toString));
+        return result;
+    }
+
+    private static void createParentDirectories(Path path, Set<Path> createdDirectories) throws IOException {
+        Path parent = path.getParent();
+        List<Path> absent = new ArrayList<>();
+        for (Path current = parent; current != null && !Files.exists(current, LinkOption.NOFOLLOW_LINKS); current = current.getParent()) {
+            absent.add(current);
+        }
+        try {
+            Files.createDirectories(parent);
+        } finally {
+            for (Path directory : absent) {
+                if (Files.isDirectory(directory, LinkOption.NOFOLLOW_LINKS)) {
+                    createdDirectories.add(directory);
+                }
+            }
+        }
+    }
+
+    private static void restore(Map<Path, byte[]> originalFiles, Set<Path> originallyAbsent,
+                                Set<Path> createdDirectories, IOException failure) {
+        for (Map.Entry<Path, byte[]> original : originalFiles.entrySet()) {
+            try {
+                Files.createDirectories(original.getKey().getParent());
+                Files.write(original.getKey(), original.getValue(), StandardOpenOption.CREATE,
+                        StandardOpenOption.TRUNCATE_EXISTING, StandardOpenOption.WRITE);
+            } catch (IOException restorationFailure) {
+                failure.addSuppressed(restorationFailure);
+            }
+        }
+        for (Path absent : originallyAbsent) {
+            try {
+                Files.deleteIfExists(absent);
+            } catch (IOException restorationFailure) {
+                failure.addSuppressed(restorationFailure);
+            }
+        }
+        List<Path> directories = new ArrayList<>(createdDirectories);
+        directories.sort(Comparator.comparingInt(Path::getNameCount).reversed());
+        for (Path directory : directories) {
+            try {
+                Files.deleteIfExists(directory);
+            } catch (IOException restorationFailure) {
+                failure.addSuppressed(restorationFailure);
+            }
+        }
+    }
+
+    static final class Snapshot {
+        private final byte[] content;
+        private final boolean symbolicLink;
+        private final boolean regularFile;
+
+        Snapshot(Path path, byte[] content) {
+            this.content = content.clone();
+            this.symbolicLink = Files.isSymbolicLink(path);
+            this.regularFile = Files.isRegularFile(path, LinkOption.NOFOLLOW_LINKS);
+        }
+
+        byte[] content() {
+            return content.clone();
+        }
+
+        boolean matches(Path path) throws IOException {
+            if (!Files.exists(path, LinkOption.NOFOLLOW_LINKS)) {
+                return false;
+            }
+            if (symbolicLink != Files.isSymbolicLink(path)
+                    || regularFile != Files.isRegularFile(path, LinkOption.NOFOLLOW_LINKS)) {
+                return false;
+            }
+            try {
+                return Arrays.equals(content, Files.readAllBytes(path));
+            } catch (IOException ignored) {
+                return false;
+            }
+        }
+    }
+}
