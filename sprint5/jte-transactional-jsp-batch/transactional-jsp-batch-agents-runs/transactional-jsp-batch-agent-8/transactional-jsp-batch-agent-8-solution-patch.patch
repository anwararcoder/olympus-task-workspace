+                jteRoot.resolve("WEBINF/tags/my/base.jte").toAbsolutePath().normalize(),
+                jteRoot.resolve("WEBINF/tags/my/parent.jte").toAbsolutePath().normalize(),
+                jspRoot.resolve("usage.jsp").toAbsolutePath().normalize());
+        assertThatThrownBy(() -> plan.getDeletes().clear()).isInstanceOf(UnsupportedOperationException.class);
