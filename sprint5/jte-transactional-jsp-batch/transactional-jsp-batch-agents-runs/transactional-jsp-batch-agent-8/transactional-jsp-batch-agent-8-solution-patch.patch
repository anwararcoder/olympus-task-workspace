+class JspMigrationPlanTest {
+    @TempDir
+    Path tempDir;
+
+    @Test
+    void plansAndCommitsDependenciesInDeterministicOrder() throws IOException {
+        Path jspRoot = Files.createDirectories(tempDir.resolve("jsp"));
+        Path jteRoot = tempDir.resolve("jte");
+        write(jspRoot.resolve("WEB-INF/tags/my/base.tag"), "<%@ attribute name=\"value\" required=\"true\" type=\"java.lang.String\" %>${value}");
+        write(jspRoot.resolve("WEB-INF/tags/my/parent.tag"), "<my:base value=\"hello\"/>");
+        write(jspRoot.resolve("usage.jsp"), "<my:parent/><my:base value=\"usage\"/>");
+
+        JspMigrationPlan plan = converter(jspRoot, jteRoot).planTags(List.of("WEB-INF/tags/my/parent.tag", "WEB-INF/tags/my/base.tag"), null);
+
+        assertThat(plan.getConversionOrder()).containsExactly(
+                jspRoot.resolve("WEB-INF/tags/my/base.tag").toAbsolutePath().normalize(),
+                jspRoot.resolve("WEB-INF/tags/my/parent.tag").toAbsolutePath().normalize());
+        assertThat(plan.getDeletes()).hasSize(2);
+        assertThat(plan.getWrites()).containsKeys(
+                jteRoot.resolve("WEBINF/tags/my/base.jte").toAbsolutePath().normalize(),
+                jteRoot.resolve("WEBINF/tags/my/parent.jte").toAbsolutePath().normalize(),
+                jspRoot.resolve("usage.jsp").toAbsolutePath().normalize());
+        assertThatThrownBy(() -> plan.getDeletes().clear()).isInstanceOf(UnsupportedOperationException.class);
+        assertThat(Files.exists(jteRoot)).isFalse();
+        assertThat(jspRoot.resolve("WEB-INF/tags/my/base.tag")).exists();
+
+        plan.commit();
+
+        assertThat(jspRoot.resolve("WEB-INF/tags/my/base.tag")).doesNotExist();
+        assertThat(jspRoot.resolve("WEB-INF/tags/my/parent.tag")).doesNotExist();
+        assertThat(jteRoot.resolve("WEBINF/tags/my/base.jte")).hasContent("@param String value${value}");
+        assertThat(jteRoot.resolve("WEBINF/tags/my/parent.jte")).hasContent("@template.WEBINF.tags.my.base(\n    value = \"hello\"\n)");
+        assertThat(jspRoot.resolve("usage.jsp")).hasContent("<my:jte jte=\"WEBINF/tags/my/parent.jte\"/><my:jte jte=\"WEBINF/tags/my/base.jte\" value=\"usage\"/>");
+        assertThatThrownBy(plan::commit).isInstanceOf(IllegalStateException.class);
+    }
