+from copy import deepcopy
+
+import pytest
+
+import pydicom
+from pydicom import Dataset, FileMetaDataset
+from pydicom.encaps import encapsulate, generate_frames
+from pydicom.multiframe import (
+    MultiFrameError,
+    extract_frames,
+    frame_attributes,
+    group_frames,
+    merge_frames,
+    sort_frames,
+    varying_attributes,
+)
+from pydicom.pixels.utils import concatenate_packed_frames, get_packed_frame
+from pydicom.sequence import Sequence
+from pydicom.tag import Tag
+from pydicom.uid import (
+    ExplicitVRLittleEndian,
+    JPEG2000Lossless,
+    EnhancedMRImageStorage,
+    generate_uid,
+)
+
+
+def make_multiframe(
+    values: list[int | None] | None = None,
+    *,
+    encapsulated: bool = False,
+) -> Dataset:
+    values = values or [3, 1, 2, 1]
+    frame_count = len(values)
+
+    ds = Dataset()
+    ds.file_meta = FileMetaDataset()
+    ds.file_meta.TransferSyntaxUID = (
+        JPEG2000Lossless if encapsulated else ExplicitVRLittleEndian
+    )
+    ds.SOPClassUID = EnhancedMRImageStorage
+    ds.SOPInstanceUID = generate_uid()
+    ds.file_meta.MediaStorageSOPClassUID = ds.SOPClassUID
+    ds.file_meta.MediaStorageSOPInstanceUID = ds.SOPInstanceUID
+    ds.Rows = 1
+    ds.Columns = 2
+    ds.SamplesPerPixel = 1
+    ds.PhotometricInterpretation = "MONOCHROME2"
+    ds.BitsAllocated = 8
+    ds.BitsStored = 8
+    ds.HighBit = 7
+    ds.PixelRepresentation = 0
+    ds.NumberOfFrames = frame_count
+
+    frames = [bytes([2 * index, 2 * index + 1]) for index in range(frame_count)]
+    ds.PixelData = encapsulate(frames) if encapsulated else b"".join(frames)
+    ds["PixelData"].is_undefined_length = encapsulated
+
+    measures = Dataset()
+    measures.PixelSpacing = [1, 1]
+    measures.SliceThickness = 2
+    shared = Dataset()
+    shared.PixelMeasuresSequence = Sequence([measures])
+    ds.SharedFunctionalGroupsSequence = Sequence([shared])
+
+    per_frame = []
+    for index, value in enumerate(values):
+        content = Dataset()
+        content.StackID = "A" if index < 3 else "B"
+        content.InStackPositionNumber = index + 8
+        content.DimensionIndexValues = [99, index + 8]
+
+        position = Dataset()
+        position.ImagePositionPatient = [0, 0, index]
+
+        groups = Dataset()
+        groups.FrameContentSequence = Sequence([content])
+        groups.PlanePositionSequence = Sequence([position])
+        if value is not None:
+            voi = Dataset()
+            voi.WindowCenter = value
+            groups.FrameVOILUTSequence = Sequence([voi])
+        per_frame.append(groups)
+
+    ds.PerFrameFunctionalGroupsSequence = Sequence(per_frame)
+
+    stack_dimension = Dataset()
+    stack_dimension.DimensionIndexPointer = Tag("StackID")
+    stack_dimension.FunctionalGroupPointer = Tag("FrameContentSequence")
+    position_dimension = Dataset()
+    position_dimension.DimensionIndexPointer = Tag("InStackPositionNumber")
+    position_dimension.FunctionalGroupPointer = Tag("FrameContentSequence")
+    ds.DimensionIndexSequence = Sequence([stack_dimension, position_dimension])
+    return ds
+
+
+def test_public_imports() -> None:
+    assert pydicom.MultiFrameError is MultiFrameError
+    assert pydicom.extract_frames is extract_frames
+    assert pydicom.frame_attributes is frame_attributes
+    assert pydicom.group_frames is group_frames
+    assert pydicom.merge_frames is merge_frames
+    assert pydicom.sort_frames is sort_frames
+    assert pydicom.varying_attributes is varying_attributes
+
+
+def test_frame_attributes_are_effective_and_independent() -> None:
+    ds = make_multiframe()
+    override = Dataset()
+    override.PixelSpacing = [4, 5]
+    ds.PerFrameFunctionalGroupsSequence[1].PixelMeasuresSequence = Sequence(
+        [override]
+    )
+
+    attributes = frame_attributes(ds, 1)
+    assert attributes.PixelSpacing == [4, 5]
+    assert "SliceThickness" not in attributes
+    assert attributes.WindowCenter == 1
+
+    attributes.PixelSpacing = [8, 9]
+    assert ds.PerFrameFunctionalGroupsSequence[1].PixelMeasuresSequence[
+        0
+    ].PixelSpacing == [4, 5]
+
+
+def test_varying_attributes() -> None:
+    ds = make_multiframe()
+    tags = varying_attributes(ds)
+    assert Tag("WindowCenter") in tags
+    assert Tag("ImagePositionPatient") in tags
+    assert Tag("PixelSpacing") not in tags
+
+    one = extract_frames(ds, [0])
+    assert varying_attributes(one) == set()
+
+
+@pytest.mark.parametrize(
+    ("change", "match"),
+    [
+        (lambda ds: ds.__delattr__("PerFrameFunctionalGroupsSequence"), "per-frame"),
+        (
+            lambda ds: setattr(ds, "SharedFunctionalGroupsSequence", Sequence()),
+            "exactly one",
+        ),
+        (lambda ds: ds.__delattr__("NumberOfFrames"), "Number of Frames"),
+        (lambda ds: setattr(ds, "NumberOfFrames", 3), "disagrees"),
+        (lambda ds: ds.__delattr__("file_meta"), "transfer syntax"),
+        (lambda ds: ds.__delattr__("PixelData"), "pixel data"),
+        (lambda ds: setattr(ds, "PixelData", b"\x00"), "too short"),
+    ],
+)
+def test_dataset_validation(change, match: str) -> None:
+    ds = make_multiframe()
+    change(ds)
+    with pytest.raises(MultiFrameError, match=match):
+        frame_attributes(ds, 0)
+
+
+def test_frame_and_selection_validation() -> None:
+    ds = make_multiframe()
+    with pytest.raises(MultiFrameError, match="not present"):
+        frame_attributes(ds, 4)
+    with pytest.raises(MultiFrameError, match="empty"):
+        extract_frames(ds, [])
+    with pytest.raises(MultiFrameError, match="more than once"):
+        extract_frames(ds, [0, 0])
+
+
+def test_extract_frames_and_derived_metadata() -> None:
+    ds = make_multiframe()
+    original = deepcopy(ds)
+    out = extract_frames(ds, [2, 0])
+
+    assert out.NumberOfFrames == 2
+    assert out.PixelData == b"\x04\x05\x00\x01"
+    assert out.SOPInstanceUID != ds.SOPInstanceUID
+    assert out.file_meta.MediaStorageSOPInstanceUID == out.SOPInstanceUID
+    assert out.file_meta.MediaStorageSOPClassUID == out.SOPClassUID
+    assert len(out.SharedFunctionalGroupsSequence) == 1
+    assert out.SourceImageSequence[0].ReferencedFrameNumber == [3, 1]
+
+    # The constant stack dimension is removed and the remaining dimension is
+    # numbered in first-appearance order.
+    assert len(out.DimensionIndexSequence) == 1
+    contents = [
+        item.FrameContentSequence[0]
+        for item in out.PerFrameFunctionalGroupsSequence
+    ]
+    assert [item.DimensionIndexValues for item in contents] == [1, 2]
+    assert [item.InStackPositionNumber for item in contents] == [1, 2]
+
+    assert ds == original
+    out.SharedFunctionalGroupsSequence[0].PixelMeasuresSequence[0].PixelSpacing = [9, 9]
+    spacing = ds.SharedFunctionalGroupsSequence[0].PixelMeasuresSequence[0].PixelSpacing
+    assert spacing == [1, 1]
+
+
+def test_all_constant_dimensions_are_removed() -> None:
+    ds = make_multiframe()
+    for groups in ds.PerFrameFunctionalGroupsSequence:
+        groups.FrameContentSequence[0].DimensionIndexValues = [5, 8]
+
+    out = extract_frames(ds, [0, 1])
+    assert "DimensionIndexSequence" not in out
+    for groups in out.PerFrameFunctionalGroupsSequence:
+        assert "DimensionIndexValues" not in groups.FrameContentSequence[0]
+
+
+def test_missing_stack_id_is_one_stack() -> None:
+    ds = make_multiframe()
+    del ds.DimensionIndexSequence
+    for groups in ds.PerFrameFunctionalGroupsSequence:
+        del groups.FrameContentSequence[0].StackID
+
+    out = extract_frames(ds, [2, 0])
+    contents = [
+        item.FrameContentSequence[0]
+        for item in out.PerFrameFunctionalGroupsSequence
+    ]
+    assert [item.InStackPositionNumber for item in contents] == [1, 2]
+
+
+def test_single_frame_macros_are_shared() -> None:
+    out = extract_frames(make_multiframe(), [2])
+    assert not out.PerFrameFunctionalGroupsSequence[0]
+    assert "PlanePositionSequence" in out.SharedFunctionalGroupsSequence[0]
+
+
+def test_encapsulated_pixel_data_is_rebuilt() -> None:
+    ds = make_multiframe(encapsulated=True)
+    ds.ExtendedOffsetTable = b"ignored"
+    ds.ExtendedOffsetTableLengths = b"ignored"
+
+    # Invalid tables should not be used merely because one is present.
+    del ds.ExtendedOffsetTable
+    out = extract_frames(ds, [3, 1])
+    assert list(generate_frames(out.PixelData, number_of_frames=2)) == [
+        b"\x06\x07",
+        b"\x02\x03",
+    ]
+    assert out["PixelData"].is_undefined_length
+    assert "ExtendedOffsetTable" not in out
+    assert "ExtendedOffsetTableLengths" not in out
+
+
+def test_truncated_encapsulated_pixel_data_is_rejected() -> None:
+    ds = make_multiframe(encapsulated=True)
+    ds.PixelData = ds.PixelData[:-1]
+    with pytest.raises(MultiFrameError, match="too short"):
+        frame_attributes(ds, 0)
+
+
+def test_bit_packed_pixel_data_is_reordered() -> None:
+    ds = make_multiframe([1, 2, 3])
+    ds.Rows = 1
+    ds.Columns = 3
+    ds.BitsAllocated = 1
+    ds.BitsStored = 1
+    ds.HighBit = 0
+    frames = [b"\x01", b"\x02", b"\x05"]
+    ds.PixelData = concatenate_packed_frames(frames, frame_length=3)
+
+    out = extract_frames(ds, [2, 0])
+    assert get_packed_frame(out.PixelData, 0, 3, pad=False) == b"\x05"
+    assert get_packed_frame(out.PixelData, 1, 3, pad=False) == b"\x01"
+    assert len(out.PixelData) % 2 == 0
+
+
+def test_native_pixel_data_is_even_padded_and_independent() -> None:
+    ds = make_multiframe([1])
+    ds.Columns = 1
+    ds.PixelData = b"\x05"
+    out = extract_frames(ds, [0])
+    assert out.PixelData == b"\x05\x00"
+    assert out.PixelData is not ds.PixelData
+
+
+def test_merge_frames() -> None:
+    first = make_multiframe([1, 2])
+    second = make_multiframe([3])
+    out = merge_frames([first, second])
+
+    assert out.NumberOfFrames == 3
+    assert out.PixelData == first.PixelData + second.PixelData
+    assert len(out.SourceImageSequence) == 2
+    assert out.SourceImageSequence[0].ReferencedFrameNumber == [1, 2]
+    assert out.SourceImageSequence[1].ReferencedFrameNumber == 1
+
+    out.PerFrameFunctionalGroupsSequence[0].FrameVOILUTSequence[0].WindowCenter = 8
+    assert frame_attributes(first, 0).WindowCenter == 1
+
+
+@pytest.mark.parametrize(
+    "change",
+    [
+        lambda ds: setattr(ds, "SOPClassUID", generate_uid()),
