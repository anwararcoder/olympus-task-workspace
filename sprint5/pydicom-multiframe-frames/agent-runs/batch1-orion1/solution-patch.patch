+
+def test_merge_requires_input() -> None:
+    with pytest.raises(MultiFrameError, match="no input|no input datasets"):
+        merge_frames([])
+
+
+def test_group_frames_first_appearance_and_missing() -> None:
+    ds = make_multiframe([3, None, 1, None])
+    groups = group_frames(ds, ["WindowCenter"])
+    assert [item.NumberOfFrames for item in groups] == [1, 2, 1]
