+    for index, groups in enumerate(ds.PerFrameFunctionalGroupsSequence):
+        reference = Dataset()
+        reference.ReferencedSOPInstanceUID = f"1.2.3.{index + 1}"
+        groups.FrameVOILUTSequence[0].ReferencedImageSequence = Sequence([reference])
