+"""Tests for enhanced multi-frame operations."""
+
+from copy import deepcopy
+
+import pytest
+
+import pydicom
+from pydicom import Dataset, FileMetaDataset
+from pydicom.encaps import encapsulate_extended
+from pydicom.multiframe import (
+    MultiFrameError,
+    extract_frames,
+    frame_attributes,
+    group_frames,
+    merge_frames,
+    sort_frames,
+    varying_attributes,
+)
+from pydicom.uid import ExplicitVRLittleEndian, JPEGBaseline8Bit
+
+
+def _dataset(**values: object) -> Dataset:
+    result = Dataset()
+    for keyword, value in values.items():
+        setattr(result, keyword, value)
+    return result
+
+
+def _enhanced(
+    uid: str = "1.2.3.4", values: tuple[int, ...] = (3, 1, 2)
+) -> Dataset:
+    ds = Dataset()
+    ds.file_meta = FileMetaDataset()
+    ds.file_meta.TransferSyntaxUID = ExplicitVRLittleEndian
+    ds.SOPClassUID = "1.2.840.10008.5.1.4.1.1.2"
+    ds.SOPInstanceUID = uid
+    ds.NumberOfFrames = len(values)
+    ds.Rows = 1
+    ds.Columns = 1
+    ds.SamplesPerPixel = 1
+    ds.PhotometricInterpretation = "MONOCHROME2"
+    ds.BitsAllocated = 8
+    ds.BitsStored = 8
+    ds.HighBit = 7
+    ds.PixelRepresentation = 0
+    ds.PixelData = bytes(values) + (b"\x00" if len(values) % 2 else b"")
+
+    shared = _dataset()
+    shared.PixelMeasuresSequence = [_dataset(PixelSpacing=[1, 1])]
+    ds.SharedFunctionalGroupsSequence = [shared]
+    ds.PerFrameFunctionalGroupsSequence = []
+    for index, value in enumerate(values):
+        frame_content = _dataset(
+            InStackPositionNumber=99, DimensionIndexValues=[20, value]
+        )
+        frame = _dataset(FrameContentSequence=[frame_content])
+        if index == 1:
+            frame.PixelMeasuresSequence = [_dataset(PixelSpacing=[2, 2])]
+        ds.PerFrameFunctionalGroupsSequence.append(frame)
+
+    ds.DimensionIndexSequence = [
+        _dataset(DimensionIndexPointer=0x00209057, FunctionalGroupPointer=0x00209111),
+        _dataset(DimensionIndexPointer=0x00209157, FunctionalGroupPointer=0x00209111),
+    ]
+    return ds
+
+
+def test_frame_attributes_and_varying_attributes_are_effective_copies() -> None:
+    ds = _enhanced()
+
+    attrs = frame_attributes(ds, 1)
+    assert attrs.PixelSpacing == [2.0, 2.0]
+    assert attrs.InStackPositionNumber == 99
+    attrs.PixelSpacing[0] = 99
+    assert (
+        ds.SharedFunctionalGroupsSequence[0].PixelMeasuresSequence[0].PixelSpacing
+        == [1.0, 1.0]
+    )
+    assert pydicom.frame_attributes is frame_attributes
+    assert pydicom.varying_attributes is varying_attributes
+    assert varying_attributes(ds) == {
+        pydicom.tag.Tag("DimensionIndexValues"),
+        pydicom.tag.Tag("PixelSpacing"),
+    }
+
+
+def test_extract_reorders_and_normalizes_metadata() -> None:
+    ds = _enhanced()
+    original = deepcopy(ds)
+
+    result = extract_frames(ds, [2, 0])
+
+    assert result.PixelData == b"\x02\x03"
+    assert result.NumberOfFrames == 2
+    assert result.SourceImageSequence[0].ReferencedFrameNumber == [3, 1]
+    assert [
+        item.FrameContentSequence[0].InStackPositionNumber
+        for item in result.PerFrameFunctionalGroupsSequence
+    ] == [1, 2]
+    assert len(result.DimensionIndexSequence) == 1
+    assert ds == original
+    result.PerFrameFunctionalGroupsSequence[0].FrameContentSequence[
+        0
+    ].InStackPositionNumber = 9
+    assert (
+        ds.PerFrameFunctionalGroupsSequence[2]
+        .FrameContentSequence[0]
+        .InStackPositionNumber
+        == 99
+    )
+
+
+def test_group_and_sort_keep_frame_order_and_put_missing_last() -> None:
+    ds = _enhanced(values=(3, 1, 3))
+    ds.PerFrameFunctionalGroupsSequence[1].FrameContentSequence[
+        0
+    ].DimensionIndexValues = [20, 1]
+    ds.PerFrameFunctionalGroupsSequence[2].FrameContentSequence[
+        0
+    ].DimensionIndexValues = [20, 3]
+
+    groups = group_frames(ds, ["DimensionIndexValues"])
+    assert groups[0].SourceImageSequence[0].ReferencedFrameNumber == [1, 3]
+    assert groups[1].SourceImageSequence[0].ReferencedFrameNumber == 2
+    sorted_ds = sort_frames(ds, ["DimensionIndexValues"])
+    assert sorted_ds.SourceImageSequence[0].ReferencedFrameNumber == [2, 1, 3]
+
+
+def test_merge_and_extended_encapsulation() -> None:
+    first = _enhanced(uid="1.2.3.4", values=(1, 2))
+    second = _enhanced(uid="1.2.3.5", values=(3, 4))
+    merged = merge_frames([first, second])
+    assert merged.PixelData == b"\x01\x02\x03\x04"
+    assert [item.ReferencedFrameNumber for item in merged.SourceImageSequence] == [
+        [1, 2],
+        [1, 2],
+    ]
+
+    compressed = _enhanced(values=(1, 2))
+    compressed.file_meta.TransferSyntaxUID = JPEGBaseline8Bit
+    (
+        compressed.PixelData,
+        compressed.ExtendedOffsetTable,
+        compressed.ExtendedOffsetTableLengths,
+    ) = encapsulate_extended([b"one", b"two"])
+    selected = extract_frames(compressed, [1])
+    assert "ExtendedOffsetTable" not in selected
+    assert selected.NumberOfFrames == 1
+
+
+def test_invalid_inputs_raise_multiframe_error() -> None:
+    ds = _enhanced()
+    with pytest.raises(MultiFrameError):
+        frame_attributes(ds, 3)
+    with pytest.raises(MultiFrameError):
+        extract_frames(ds, [0, 0])
+    with pytest.raises(MultiFrameError):
+        group_frames(ds, [])
+    with pytest.raises(MultiFrameError):
+        sort_frames(ds, ["not_an_attribute"])
+    with pytest.raises(MultiFrameError):
+        merge_frames([])
