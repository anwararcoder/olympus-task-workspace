+class TestFragmentedEncapsulation:
+    """Tests for encapsulated pixel data holding several fragments per frame"""
+
+    def fragmented(self, payloads, depths):
+        """Return an instance whose frames are split across two fragments each"""
+        data = encapsulate(list(payloads), fragments_per_frame=2, has_bot=True)
+        frames = [group(position(depth)) for depth in depths]
+
+        return instance(frames, syntax=JPEGBaseline8Bit, pixel_data=data)
+
+    def payloads(self, out, count):
+        return [
+            bytes(frame)
+            for frame in generate_frames(out.PixelData, number_of_frames=count)
+        ]
+
+    def instance_of_three(self):
+        return self.fragmented(
+            [b"aaaaaa\xff\xd9", b"bbbbbb\xff\xd9", b"cccccc\xff\xd9"], [2, 0, 1]
+        )
+
+    def test_extraction_reassembles_the_frames(self):
+        """A frame split over fragments comes out whole and in the given order"""
+        out = pydicom.extract_frames(self.instance_of_three(), [2, 0])
+        assert self.payloads(out, 2) == [b"cccccc\xff\xd9", b"aaaaaa\xff\xd9"]
+
+    def test_sorting_reassembles_the_frames(self):
+        """Sorting moves whole frames, not fragments"""
+        out = pydicom.sort_frames(self.instance_of_three(), ["ImagePositionPatient"])
+        assert positions(out) == [0.0, 1.0, 2.0]
+        assert self.payloads(out, 3) == [
+            b"bbbbbb\xff\xd9",
+            b"cccccc\xff\xd9",
+            b"aaaaaa\xff\xd9",
+        ]
+
+    def test_merging_reassembles_the_frames(self):
+        """Fragmented inputs merge into whole frames in input order"""
+        first = self.fragmented([b"aaaaaa\xff\xd9", b"bbbbbb\xff\xd9"], [0, 1])
+        second = self.fragmented([b"cccccc\xff\xd9"], [2])
+        out = pydicom.merge_frames([first, second])
+        assert self.payloads(out, 3) == [
+            b"aaaaaa\xff\xd9",
+            b"bbbbbb\xff\xd9",
+            b"cccccc\xff\xd9",
+        ]
+
+    def test_grouping_reassembles_the_frames(self):
+        """Each group carries its own whole frames"""
+        groups = pydicom.group_frames(self.instance_of_three(), ["ImagePositionPatient"])
+        assert len(groups) == 3
+        assert self.payloads(groups[0], 1) == [b"aaaaaa\xff\xd9"]
+        assert self.payloads(groups[2], 1) == [b"cccccc\xff\xd9"]
+
+    def test_the_result_stays_encapsulated(self):
+        """The rebuilt pixel data is encapsulation the reader still accepts"""
+        out = pydicom.extract_frames(self.instance_of_three(), [1])
+        assert out["PixelData"].is_undefined_length
+        assert self.payloads(out, 1) == [b"bbbbbb\xff\xd9"]
+
