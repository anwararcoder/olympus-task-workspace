@@ -0,0 +1,3373 @@
+# Copyright 2008-2026 pydicom authors. See LICENSE file for details.
+"""Tests for frame level operations on enhanced multi-frame instances"""
+
+from copy import deepcopy
+
+import pytest
+
+import pydicom
+from pydicom.dataelem import DataElement
+from pydicom.dataset import Dataset, FileMetaDataset
+from pydicom.encaps import encapsulate, encapsulate_extended, generate_frames
+from pydicom.sequence import Sequence
+from pydicom.tag import Tag
+from pydicom.uid import (
+    CTImageStorage,
+    DeflatedExplicitVRLittleEndian,
+    ExplicitVRBigEndian,
+    ExplicitVRLittleEndian,
+    ImplicitVRLittleEndian,
+    JPEGBaseline8Bit,
+    MRImageStorage,
+    generate_uid,
+)
+
+
+def macro(keyword, **kwargs):
+    """Return a functional group macro holding one item of `kwargs`."""
+    item = Dataset()
+    for key, value in kwargs.items():
+        setattr(item, key, value)
+
+    holder = Dataset()
+    setattr(holder, keyword, Sequence([item]))
+
+    return holder[keyword]
+
+
+def group(*elements):
+    """Return a functional group item holding `elements`."""
+    item = Dataset()
+    for elem in elements:
+        item[elem.tag] = elem
+
+    return item
+
+
+def position(z):
+    """Return a plane position macro at `z`."""
+    return macro("PlanePositionSequence", ImagePositionPatient=[0.0, 0.0, float(z)])
+
+
+def spacing(value=1.0):
+    """Return a pixel measures macro with square pixels of `value`."""
+    return macro("PixelMeasuresSequence", PixelSpacing=[value, value])
+
+
+def content(**kwargs):
+    """Return a frame content macro."""
+    return macro("FrameContentSequence", **kwargs)
+
+
+def dimensions(*labels):
+    """Return a dimension index sequence described by `labels`."""
+    items = []
+    for label in labels:
+        item = Dataset()
+        item.DimensionDescriptionLabel = label
+        items.append(item)
+
+    return Sequence(items)
+
+
+def instance(
+    frames,
+    shared=None,
+    syntax=ExplicitVRLittleEndian,
+    sop_class=CTImageStorage,
+    rows=2,
+    columns=2,
+    bits_allocated=8,
+    samples=1,
+    pixel_data=None,
+    pixel_keyword="PixelData",
+):
+    """Return an enhanced multi-frame instance holding `frames`."""
+    ds = Dataset()
+    ds.file_meta = FileMetaDataset()
+    ds.file_meta.MediaStorageSOPClassUID = sop_class
+    ds.file_meta.MediaStorageSOPInstanceUID = generate_uid()
+    ds.file_meta.TransferSyntaxUID = syntax
+    ds.SOPClassUID = sop_class
+    ds.SOPInstanceUID = ds.file_meta.MediaStorageSOPInstanceUID
+    ds.Rows = rows
+    ds.Columns = columns
+    ds.SamplesPerPixel = samples
+    ds.BitsAllocated = bits_allocated
+    ds.BitsStored = bits_allocated
+    ds.HighBit = bits_allocated - 1
+    ds.PixelRepresentation = 0
+    ds.PhotometricInterpretation = "MONOCHROME2"
+    ds.NumberOfFrames = len(frames)
+    if shared is not None:
+        ds.SharedFunctionalGroupsSequence = Sequence([shared])
+
+    ds.PerFrameFunctionalGroupsSequence = Sequence(frames)
+    if pixel_data is None:
+        size = rows * columns * samples * bits_allocated // 8
+        pixel_data = bytes(range(size * len(frames)))
+
+    setattr(ds, pixel_keyword, pixel_data)
+
+    return ds
+
+
+def simple(count=3, shared=None):
+    """Return an instance of `count` frames differing in plane position."""
+    return instance([group(position(index)) for index in range(count)], shared)
+
+
+def shared_tags(ds):
+    """Return the tags of the shared functional group macros of `ds`."""
+    return [elem.tag for elem in ds.SharedFunctionalGroupsSequence[0]]
+
+
+def frame_tags(ds, index):
+    """Return the tags of the macros of the frame at `index`."""
+    return [elem.tag for elem in ds.PerFrameFunctionalGroupsSequence[index]]
+
+
+def frame_item(ds, index):
+    """Return the per-frame functional group item at `index`."""
+    return ds.PerFrameFunctionalGroupsSequence[index]
+
+
+def index_values(ds, index):
+    """Return the dimension index values of the frame at `index`."""
+    raw = frame_item(ds, index).FrameContentSequence[0].DimensionIndexValues
+
+    return [raw] if isinstance(raw, int) else list(raw)
+
+
+def frame_numbers(item):
+    """Return the referenced frame numbers of a provenance item as a list."""
+    raw = item.ReferencedFrameNumber
+
+    return [int(raw)] if isinstance(raw, int) else [int(value) for value in raw]
+
+
+def positions(ds):
+    """Return the z coordinate of every frame of `ds`."""
+    return [
+        pydicom.frame_attributes(ds, index).ImagePositionPatient[2]
+        for index in range(int(ds.NumberOfFrames))
+    ]
+
+
+class TestFrameAttributes:
+    """Tests for pydicom.multiframe.frame_attributes"""
+
+    def test_shared_only(self):
+        """Attributes of a shared macro reach every frame"""
+        ds = simple(2, group(spacing(0.5)))
+        for index in range(2):
+            assert pydicom.frame_attributes(ds, index).PixelSpacing == [0.5, 0.5]
+
+    def test_per_frame_only(self):
+        """Attributes of a frame's own macro reach that frame"""
+        ds = simple(3)
+        assert pydicom.frame_attributes(ds, 2).ImagePositionPatient == [0.0, 0.0, 2.0]
+
+    def test_shared_and_per_frame_combined(self):
+        """Shared and per-frame macros are both flattened"""
+        ds = simple(2, group(spacing()))
+        view = pydicom.frame_attributes(ds, 1)
+        assert view.PixelSpacing == [1.0, 1.0]
+        assert view.ImagePositionPatient == [0.0, 0.0, 1.0]
+
+    def test_per_frame_macro_replaces_shared_macro(self):
+        """A per-frame macro replaces the shared macro carrying its tag"""
+        frames = [group(spacing(3.0)), group()]
+        ds = instance(frames, group(spacing(1.0)))
+        assert pydicom.frame_attributes(ds, 0).PixelSpacing == [3.0, 3.0]
+        assert pydicom.frame_attributes(ds, 1).PixelSpacing == [1.0, 1.0]
+
+    def test_attribute_of_replaced_macro_does_not_survive(self):
+        """Replacing a macro drops the attributes only it carried"""
+        replacement = macro("PixelMeasuresSequence", SliceThickness="2.0")
+        ds = instance([group(replacement)], group(spacing(1.0)))
+        view = pydicom.frame_attributes(ds, 0)
+        assert view.SliceThickness == "2.0"
+        assert "PixelSpacing" not in view
+
+    def test_nested_sequence_copied(self):
+        """A nested sequence is copied out of the source instance"""
+        nested = macro("PlaneOrientationSequence", ImageOrientationPatient=[1, 0, 0])
+        ds = instance([group(nested)])
+        view = pydicom.frame_attributes(ds, 0)
+        view.ImageOrientationPatient = [0, 1, 0]
+        source = ds.PerFrameFunctionalGroupsSequence[0]
+        assert source.PlaneOrientationSequence[0].ImageOrientationPatient == [1, 0, 0]
+
+    def test_index_out_of_range_raises(self):
+        """A frame that does not exist is an error"""
+        ds = simple(2)
+        with pytest.raises(pydicom.multiframe.MultiFrameError):
+            pydicom.frame_attributes(ds, 2)
+
+    def test_negative_index_raises(self):
+        """A negative frame index is an error"""
+        ds = simple(2)
+        with pytest.raises(pydicom.multiframe.MultiFrameError):
+            pydicom.frame_attributes(ds, -1)
+
+    def test_not_multiframe_raises(self):
+        """An instance without per-frame groups is an error"""
+        ds = simple(1)
+        del ds.PerFrameFunctionalGroupsSequence
+        with pytest.raises(pydicom.multiframe.MultiFrameError):
+            pydicom.frame_attributes(ds, 0)
+
+    def test_no_transfer_syntax_raises(self):
+        """An instance without a transfer syntax is an error"""
+        ds = simple(1)
+        del ds.file_meta.TransferSyntaxUID
+        with pytest.raises(pydicom.multiframe.MultiFrameError):
+            pydicom.frame_attributes(ds, 0)
+
+    def test_frame_count_disagreement_raises(self):
+        """An instance that miscounts its own frames is an error"""
+        ds = simple(2)
+        ds.NumberOfFrames = 3
+        with pytest.raises(pydicom.multiframe.MultiFrameError):
+            pydicom.frame_attributes(ds, 0)
+
+    def test_error_is_a_value_error(self):
+        """The error is a ValueError"""
+        assert issubclass(pydicom.multiframe.MultiFrameError, ValueError)
+
+
+class TestVaryingAttributes:
+    """Tests for pydicom.multiframe.varying_attributes"""
+
+    def test_varying_attribute_found(self):
+        """An attribute that differs between frames is reported"""
+        ds = simple(3)
+        assert Tag("ImagePositionPatient") in pydicom.varying_attributes(ds)
+
+    def test_constant_attribute_absent(self):
+        """An attribute that is the same everywhere is not reported"""
+        ds = simple(3, group(spacing()))
+        assert Tag("PixelSpacing") not in pydicom.varying_attributes(ds)
+
+    def test_repeated_per_frame_value_absent(self):
+        """A per-frame attribute with one value everywhere is not reported"""
+        frames = [group(spacing(2.0)), group(spacing(2.0))]
+        assert not pydicom.varying_attributes(instance(frames))
+
+    def test_attribute_missing_from_one_frame_varies(self):
+        """An attribute only some frames carry is reported"""
+        frames = [group(spacing(2.0)), group()]
+        assert Tag("PixelSpacing") in pydicom.varying_attributes(instance(frames))
+
+    def test_single_frame_reports_nothing(self):
+        """A single frame instance has nothing that varies"""
+        assert not pydicom.varying_attributes(simple(1))
+
+    def test_tags_are_returned(self):
+        """The result holds tags"""
+        found = pydicom.varying_attributes(simple(2))
+        assert all(isinstance(tag, int) for tag in found)
+
+
+class TestExtractSelection:
+    """Tests for the frames pydicom.multiframe.extract_frames keeps"""
+
+    def test_single_frame(self):
+        """One frame can be taken out"""
+        out = pydicom.extract_frames(simple(3), [1])
+        assert int(out.NumberOfFrames) == 1
+        assert positions(out) == [1.0]
+
+    def test_order_is_the_order_given(self):
+        """The frames come out in the order asked for"""
+        out = pydicom.extract_frames(simple(4), [3, 0, 2])
+        assert positions(out) == [3.0, 0.0, 2.0]
+
+    def test_all_frames(self):
+        """Every frame can be taken"""
+        out = pydicom.extract_frames(simple(3), [0, 1, 2])
+        assert positions(out) == [0.0, 1.0, 2.0]
+
+    def test_number_of_frames_updated(self):
+        """The frame count follows the selection"""
+        out = pydicom.extract_frames(simple(5), [4, 1])
+        assert int(out.NumberOfFrames) == 2
+        assert len(out.PerFrameFunctionalGroupsSequence) == 2
+
+    def test_duplicate_index_raises(self):
