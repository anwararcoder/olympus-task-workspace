+class TestUnrelatedSequenceIsolation:
+    def instance(self, nr_frames=3):
+        ds = simple(nr_frames)
+        inner = Dataset()
+        inner.ReferencedSOPInstanceUID = "1.2.3.4"
+        outer = Dataset()
+        outer.SeriesInstanceUID = "1.2.3.5"
+        outer.ReferencedInstanceSequence = Sequence([inner])
+        ds.ReferencedSeriesSequence = Sequence([outer])
+
+        return ds
+
+    def nested(self, ds):
+        return ds.ReferencedSeriesSequence[0].ReferencedInstanceSequence[0]
+
+    def test_extraction_carries_it_over(self):
+        """A sequence outside the functional groups survives derivation"""
+        ds = self.instance()
+        out = pydicom.extract_frames(ds, [1, 0])
+        assert self.nested(out).ReferencedSOPInstanceUID == "1.2.3.4"
+
+    def test_extraction_copies_it(self):
+        """The carried sequence is a copy at every level"""
+        ds = self.instance()
+        out = pydicom.extract_frames(ds, [1, 0])
+        assert out.ReferencedSeriesSequence[0] is not ds.ReferencedSeriesSequence[0]
+        assert self.nested(out) is not self.nested(ds)
+
+    def test_mutating_the_extraction_leaves_the_source(self):
+        """Writing through the copy does not reach the instance"""
+        ds = self.instance()
+        out = pydicom.extract_frames(ds, [0])
+        self.nested(out).ReferencedSOPInstanceUID = "1.2.3.9"
+        assert self.nested(ds).ReferencedSOPInstanceUID == "1.2.3.4"
+
+    def test_sorting_copies_it(self):
+        """Sorting deep copies it too"""
+        ds = self.instance()
+        out = pydicom.sort_frames(ds, ["ImagePositionPatient"])
+        self.nested(out).ReferencedSOPInstanceUID = "1.2.3.9"
+        assert self.nested(ds).ReferencedSOPInstanceUID == "1.2.3.4"
+
+    def test_grouping_copies_it_into_every_group(self):
+        """Each group gets its own copy, sharing nothing with the source"""
+        ds = self.instance(4)
+        groups = pydicom.group_frames(ds, ["StackID"])
+        assert len(groups) == 1
+        self.nested(groups[0]).ReferencedSOPInstanceUID = "1.2.3.9"
+        assert self.nested(ds).ReferencedSOPInstanceUID == "1.2.3.4"
+
+    def test_merging_copies_it(self):
+        """The merged result copies what it took from its first input"""
+        ds = self.instance()
+        out = pydicom.merge_frames([ds, simple(1)])
+        assert self.nested(out) is not self.nested(ds)
+        self.nested(out).ReferencedSOPInstanceUID = "1.2.3.9"
+        assert self.nested(ds).ReferencedSOPInstanceUID == "1.2.3.4"
+
