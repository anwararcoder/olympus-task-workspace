index 0000000..eb0d102
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,49 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+    case "$1" in
+        --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+        --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+        base|new)        MODE="$1"; shift ;;
+        *)               shift ;;
+    esac
+done
+MODE="${MODE:-base}"
+
+cd "$(dirname "$0")" || exit 1
+
+NEW_TESTS="tests/test_multiframe_75d114.py"
+
+# needs to reach github.com to fetch the external data files
+NETWORK_TEST="tests/test_data_manager.py::test_fetch_data_files"
+
+PYTHON="python3"
+command -v "$PYTHON" >/dev/null 2>&1 || PYTHON="python"
+
+PYTEST_ARGS="-v -p no:cacheprovider"
+if [ -n "$OUTPUT_PATH" ]; then
+    mkdir -p "$(dirname "$OUTPUT_PATH")"
+    PYTEST_ARGS="$PYTEST_ARGS --junitxml=$OUTPUT_PATH"
+fi
+
+if [ "$MODE" = "new" ]; then
+    "$PYTHON" -m pytest $PYTEST_ARGS "$NEW_TESTS"
+else
+    "$PYTHON" -m pytest $PYTEST_ARGS --ignore="$NEW_TESTS" --deselect "$NETWORK_TEST" tests
+fi
+
+EXIT_CODE=$?
+
+if [ -n "$OUTPUT_PATH" ] && [ ! -s "$OUTPUT_PATH" ]; then
+    cat > "$OUTPUT_PATH" <<'XMLEOF'
+<?xml version="1.0" encoding="utf-8"?>
+<testsuites><testsuite name="pytest" errors="1" failures="0" skipped="0" tests="1" time="0">
+<testcase classname="tests" name="collection"><error message="collection failed">The test suite could not be collected.</error></testcase>
+</testsuite></testsuites>
+XMLEOF
+fi
+
+exit $EXIT_CODE
