+def test_derived_dimensions_and_stack_positions_are_renumbered() -> None:
+    ds = _dataset(frames=[b"a", b"b", b"c"])
+    ds.DimensionOrganizationSequence = Sequence([Dataset()])
+    descriptors = []
+    for pointer in ("ImagePositionPatient", "InStackPositionNumber"):
+        descriptor = Dataset()
+        descriptor.DimensionIndexPointer = Tag(pointer)
+        descriptor.FunctionalGroupPointer = Tag(
+            "PlanePositionSequence"
+            if pointer == "ImagePositionPatient"
+            else "FrameContentSequence"
+        )
+        descriptors.append(descriptor)
+    ds.DimensionIndexSequence = Sequence(descriptors)
+
+    per_frame = []
+    for stack_position, values in zip((9, 3, 7), ([10, 4], [10, 8], [10, 4])):
+        group = Dataset()
+        frame_content = Dataset()
+        frame_content.StackID = "stack"
+        frame_content.InStackPositionNumber = stack_position
+        frame_content.DimensionIndexValues = values
+        group.FrameContentSequence = Sequence([frame_content])
+        per_frame.append(group)
+    ds.PerFrameFunctionalGroupsSequence = Sequence(per_frame)
+
+    result = extract_frames(ds, [1, 0, 2])
+    assert hasattr(result, "DimensionOrganizationSequence")
+    assert len(result.DimensionIndexSequence) == 1
+    values = [
+        frame.FrameContentSequence[0].DimensionIndexValues
+        for frame in result.PerFrameFunctionalGroupsSequence
+    ]
+    assert values == [1, 2, 2]
+    assert [
+        frame.FrameContentSequence[0].InStackPositionNumber
+        for frame in result.PerFrameFunctionalGroupsSequence
+    ] == [1, 2, 3]
+
