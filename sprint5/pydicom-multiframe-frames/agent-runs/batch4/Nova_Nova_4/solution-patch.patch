+def test_encapsulated_pixels_are_rebuilt_without_extended_offsets() -> None:
+    ds = _dataset(frames=[b"a\xff\xd9", b"b\xff\xd9"])
+    ds.file_meta.TransferSyntaxUID = JPEGBaseline8Bit
+    ds.PixelData = encapsulate([b"a\xff\xd9", b"b\xff\xd9"])
+    ds["PixelData"].is_undefined_length = True
+
+    result = extract_frames(ds, [1])
+    assert list(generate_frames(result.PixelData, number_of_frames=1)) == [
+        b"b\xff\xd9\x00"
+    ]
+    assert Tag("ExtendedOffsetTable") not in result
