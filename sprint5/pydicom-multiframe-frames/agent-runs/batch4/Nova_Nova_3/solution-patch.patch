@@ -0,0 +1,187 @@
+from copy import deepcopy
+
+import pytest
+
+import pydicom
+from pydicom import Dataset, FileMetaDataset, Sequence
+from pydicom.encaps import encapsulate, generate_frames
+from pydicom.multiframe import (
+    MultiFrameError,
+    extract_frames,
+    frame_attributes,
+    group_frames,
+    merge_frames,
+    sort_frames,
+    varying_attributes,
+)
+from pydicom.tag import Tag
+from pydicom.uid import (
+    ExplicitVRLittleEndian,
+    JPEGBaseline8Bit,
+    generate_uid,
+)
+
+
+def make_dataset(
+    number_of_frames=3,
+    *,
+    compressed=False,
+    values=(3, 1, 2),
+    positions=(2, 0, 1),
+):
+    ds = Dataset()
+    ds.file_meta = FileMetaDataset()
+    ds.file_meta.TransferSyntaxUID = (
+        JPEGBaseline8Bit if compressed else ExplicitVRLittleEndian
+    )
+    ds.SOPClassUID = "1.2.3.4"
+    ds.SOPInstanceUID = generate_uid()
+    ds.NumberOfFrames = number_of_frames
+    ds.Rows = 1
+    ds.Columns = 2
+    ds.SamplesPerPixel = 1
+    ds.PhotometricInterpretation = "MONOCHROME2"
+    ds.BitsAllocated = 8
+    ds.BitsStored = 8
+    ds.HighBit = 7
+    ds.PixelRepresentation = 0
+
+    shared_item = Dataset()
+    pixel_measures = Dataset()
+    pixel_measures.SliceThickness = "1"
+    shared_item.PixelMeasuresSequence = Sequence([pixel_measures])
+    ds.SharedFunctionalGroupsSequence = Sequence([shared_item])
+
+    frames = []
+    for value, position in zip(values, positions):
+        group = Dataset()
+        frame_content = Dataset()
+        frame_content.TemporalPositionIndex = value
+        frame_content.InStackPositionNumber = 99
+        frame_content.StackID = "stack"
+        group.FrameContentSequence = Sequence([frame_content])
+        plane_position = Dataset()
+        plane_position.ImagePositionPatient = [position, 0, 0]
+        group.PlanePositionSequence = Sequence([plane_position])
+        frames.append(group)
+    ds.PerFrameFunctionalGroupsSequence = Sequence(frames)
+
+    dimension = Dataset()
+    dimension.DimensionIndexPointer = Tag("TemporalPositionIndex")
+    ds.DimensionIndexSequence = Sequence([dimension])
+
+    raw_frames = [bytes([index, index + 1]) for index in range(number_of_frames)]
+    ds.PixelData = encapsulate(raw_frames) if compressed else b"".join(raw_frames)
+    if compressed:
+        ds["PixelData"].is_undefined_length = True
+    return ds
+
+
+def test_frame_attributes_and_varying_values_are_effective_copies():
+    ds = make_dataset()
+
+    attrs = frame_attributes(ds, 0)
