+def test_merge_requires_compatible_inputs_and_exports_from_pydicom():
+    first = make_dataset(number_of_frames=2, values=(1, 2), positions=(0, 1))
+    second = make_dataset(number_of_frames=1, values=(3,), positions=(2,))
+    result = merge_frames([first, second])
+
+    assert pydicom.merge_frames is merge_frames
+    assert result.NumberOfFrames == 3
+    assert result.PixelData == first.PixelData + second.PixelData
+    assert [item.ReferencedFrameNumber for item in result.SourceImageSequence] == [
+        [1, 2],
+        1,
+    ]
+
+    second.Columns = 3
+    with pytest.raises(MultiFrameError):
