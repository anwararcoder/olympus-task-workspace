+def test_merge_and_compressed_data():
+    first = make_dataset(values=(b"a", b"b"))
+    second = make_dataset(values=(b"c",), positions=(4,), dimension_values=(4,))
+    result = merge_frames([first, second])
+    assert result.PixelData == b"abc\x00"
+    assert result.SourceImageSequence[0].ReferencedFrameNumber == [1, 2]
+    assert result.SourceImageSequence[1].ReferencedFrameNumber == "1"
+
+    compressed = make_dataset(
