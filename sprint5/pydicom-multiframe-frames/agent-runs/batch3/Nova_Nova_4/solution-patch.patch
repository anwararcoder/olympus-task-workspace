+import pytest
+
+from pydicom import (
+    Dataset,
+    FileMetaDataset,
+    MultiFrameError,
+    extract_frames,
+    frame_attributes,
+    group_frames,
+    merge_frames,
+    sort_frames,
+    varying_attributes,
+)
+from pydicom.encaps import encapsulate, get_frame
+from pydicom.sequence import Sequence
+from pydicom.tag import Tag
+from pydicom.uid import ExplicitVRLittleEndian, RLELossless, generate_uid
+
+
+def make_dataset(
+    values=(b"a", b"b", b"c"),
+    positions=(3, 1, 2),
+    dimension_values=(1, 2, 3),
+    transfer_syntax=ExplicitVRLittleEndian,
+):
+    ds = Dataset()
+    ds.file_meta = FileMetaDataset()
+    ds.file_meta.TransferSyntaxUID = transfer_syntax
+    ds.SOPClassUID = "1.2.3"
+    ds.SOPInstanceUID = generate_uid()
+    ds.NumberOfFrames = len(values)
+    ds.Rows = 1
+    ds.Columns = 1
+    ds.SamplesPerPixel = 1
+    ds.PhotometricInterpretation = "MONOCHROME2"
+    ds.BitsAllocated = 8
+    ds.BitsStored = 8
+    ds.HighBit = 7
+    ds.PixelRepresentation = 0
+    ds.PixelData = (
+        encapsulate(list(values))
+        if transfer_syntax == RLELossless
+        else b"".join(values)
+    )
+
+    shared = Dataset()
+    measures = Dataset()
+    measures.SliceThickness = 1
+    shared.PixelMeasuresSequence = Sequence([measures])
+    ds.SharedFunctionalGroupsSequence = Sequence([shared])
+
+    per_frame = []
+    for position, dimension_value in zip(positions[: len(values)], dimension_values):
+        group = Dataset()
+        content = Dataset()
+        content.InStackPositionNumber = position
+        content.DimensionIndexValues = [dimension_value]
+        group.FrameContentSequence = Sequence([content])
+        plane = Dataset()
+        plane.ImagePositionPatient = [0, 0, float(position)]
+        group.PlanePositionSequence = Sequence([plane])
+        per_frame.append(group)
+    ds.PerFrameFunctionalGroupsSequence = Sequence(per_frame)
+
+    dimension = Dataset()
+    dimension.DimensionIndexPointer = Tag("ImagePositionPatient")
+    dimension.FunctionalGroupPointer = Tag("PlanePositionSequence")
+    ds.DimensionIndexSequence = Sequence([dimension])
+    return ds
+
+
+def test_frame_attributes_overlay_and_copy():
+    ds = make_dataset()
+    shared = ds.SharedFunctionalGroupsSequence[0]
+    shared.PixelMeasuresSequence[0].SliceThickness = 2
+    ds.PerFrameFunctionalGroupsSequence[0].PixelMeasuresSequence = Sequence(
+        [Dataset()]
+    )
+    ds.PerFrameFunctionalGroupsSequence[0].PixelMeasuresSequence[0].PixelSpacing = [
+        1,
+        1,
+    ]
+
+    attrs = frame_attributes(ds, 0)
+    assert "SliceThickness" not in attrs
+    assert attrs.PixelSpacing == [1.0, 1.0]
+    attrs.PixelSpacing = [2, 2]
+    assert (
+        ds.PerFrameFunctionalGroupsSequence[0]
+        .PixelMeasuresSequence[0]
+        .PixelSpacing
+        == [1.0, 1.0]
+    )
+
+    assert Tag("ImagePositionPatient") in varying_attributes(ds)
