+import pytest
+
+import pydicom
+from pydicom.encaps import encapsulate, generate_frames
+from pydicom.sequence import Sequence
+from pydicom.uid import ExplicitVRLittleEndian, JPEGBaseline8Bit
+
+
+def make_dataset(pixel_data=b"abc", number_of_frames=3):
+    ds = pydicom.Dataset()
+    ds.file_meta = pydicom.FileMetaDataset()
+    ds.file_meta.TransferSyntaxUID = ExplicitVRLittleEndian
+    ds.SOPClassUID = "1.2.3"
+    ds.SOPInstanceUID = "1.2.3.4"
+    ds.NumberOfFrames = number_of_frames
+    ds.Rows = 1
+    ds.Columns = 1
+    ds.SamplesPerPixel = 1
+    ds.PhotometricInterpretation = "MONOCHROME2"
+    ds.BitsAllocated = 8
+    ds.BitsStored = 8
+    ds.HighBit = 7
+    ds.PixelRepresentation = 0
+    ds.PixelData = pixel_data
+
+    shared = pydicom.Dataset()
+    measures = pydicom.Dataset()
+    measures.PixelSpacing = [1, 2]
+    shared.PixelMeasuresSequence = [measures]
+    ds.SharedFunctionalGroupsSequence = [shared]
+
+    per_frame = []
+    for index in range(number_of_frames):
+        group = pydicom.Dataset()
+        content = pydicom.Dataset()
+        content.InStackPositionNumber = index + 1
+        content.DimensionIndexValues = [10, index + 1]
+        group.FrameContentSequence = [content]
+        per_frame.append(group)
+    ds.PerFrameFunctionalGroupsSequence = per_frame
+
+    descriptions = []
+    for _ in range(2):
+        description = pydicom.Dataset()
+        description.DimensionIndexPointer = 0x00209157
+        description.FunctionalGroupPointer = 0x00209111
+        descriptions.append(description)
+    ds.DimensionIndexSequence = Sequence(descriptions)
+    return ds
+
+
+def test_exports_and_effective_attributes_are_copied():
+    ds = make_dataset()
+    attrs = pydicom.frame_attributes(ds, 0)
+
+    assert pydicom.multiframe.frame_attributes is pydicom.frame_attributes
+    assert list(attrs.keys()) == [0x00289110, 0x00209111]
+    attrs.PixelMeasuresSequence[0].PixelSpacing[0] = 9
+    assert (
+        ds.SharedFunctionalGroupsSequence[0]
+        .PixelMeasuresSequence[0]
+        .PixelSpacing[0]
+        == 1
+    )
+    assert pydicom.varying_attributes(ds) == {0x00209111}
+
+
+def test_extract_reorders_data_and_normalises_dimensions():
+    ds = make_dataset()
+    output = pydicom.extract_frames(ds, [2, 0])
+
+    assert output.PixelData == b"ca"
+    assert output.NumberOfFrames == 2
+    assert output.SourceImageSequence[0].ReferencedFrameNumber == [3, 1]
+    assert output.SOPInstanceUID != ds.SOPInstanceUID
+    assert output.file_meta.MediaStorageSOPInstanceUID == output.SOPInstanceUID
+    assert len(output.DimensionIndexSequence) == 1
+    assert [
+        item.FrameContentSequence[0].DimensionIndexValues
+        for item in output.PerFrameFunctionalGroupsSequence
+    ] == [1, 2]
+    assert [
+        item.FrameContentSequence[0].InStackPositionNumber
+        for item in output.PerFrameFunctionalGroupsSequence
+    ] == [1, 2]
+    assert ds.PixelData == b"abc"
+
+
+def test_group_and_sort_use_nested_frame_values():
+    ds = make_dataset()
+    ds.PerFrameFunctionalGroupsSequence[0].FrameContentSequence[
+        0
+    ].InStackPositionNumber = 3
+    ds.PerFrameFunctionalGroupsSequence[1].FrameContentSequence[
+        0
+    ].InStackPositionNumber = 3
+    ds.PerFrameFunctionalGroupsSequence[2].FrameContentSequence[
+        0
+    ].InStackPositionNumber = 1
+
+    groups = pydicom.group_frames(ds, ["InStackPositionNumber"])
+    assert [group.PixelData for group in groups] == [b"ab", b"c\x00"]
+    output = pydicom.sort_frames(ds, ["InStackPositionNumber"])
+    assert output.PixelData == b"cab\x00"
+    assert output.SourceImageSequence[0].ReferencedFrameNumber == [3, 1, 2]
+
+
+def test_merge_and_encapsulated_pixel_data():
+    first = make_dataset(b"ab", 2)
+    second = make_dataset(b"cd", 2)
+    second.SOPInstanceUID = "1.2.3.5"
+    output = pydicom.merge_frames([first, second])
+    assert output.PixelData == b"abcd"
+    assert [item.ReferencedFrameNumber for item in output.SourceImageSequence] == [
+        [1, 2],
+        [1, 2],
+    ]
+
+    compressed = make_dataset(number_of_frames=2)
+    compressed.file_meta.TransferSyntaxUID = JPEGBaseline8Bit
+    compressed.PixelData = encapsulate([b"aa", b"bb"])
+    compressed["PixelData"].is_undefined_length = True
+    extracted = pydicom.extract_frames(compressed, [1])
+    assert extracted["PixelData"].is_undefined_length
+    assert list(generate_frames(extracted.PixelData, number_of_frames=1)) == [b"bb"]
+
+
+@pytest.mark.parametrize(
+    "operation",
+    [
+        lambda ds: pydicom.frame_attributes(ds, 0),
+        pydicom.varying_attributes,
+        lambda ds: pydicom.extract_frames(ds, [0]),
+        lambda ds: pydicom.merge_frames([ds]),
+        lambda ds: pydicom.group_frames(ds, ["Rows"]),
+        lambda ds: pydicom.sort_frames(ds, ["Rows"]),
+    ],
+)
+def test_malformed_instances_raise_multiframe_error(operation):
+    ds = make_dataset(number_of_frames=1)
+    del ds.PerFrameFunctionalGroupsSequence
+    with pytest.raises(pydicom.MultiFrameError):
+        operation(ds)
