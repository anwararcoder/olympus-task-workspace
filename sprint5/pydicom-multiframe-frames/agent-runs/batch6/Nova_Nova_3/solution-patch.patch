+from copy import deepcopy
+
+import pytest
+
+import pydicom
+from pydicom import Dataset, FileMetaDataset, Sequence
+from pydicom.encaps import encapsulate, generate_frames
+from pydicom.multiframe import (
+    MultiFrameError,
+    extract_frames,
+    frame_attributes,
+    group_frames,
+    merge_frames,
+    sort_frames,
+    varying_attributes,
+)
+from pydicom.tag import Tag
+from pydicom.uid import (
+    ExplicitVRLittleEndian,
+    RLELossless,
+    SecondaryCaptureImageStorage,
+    generate_uid,
+)
+
+
+def make_dataset(
+    frames: int = 3,
+    *,
+    transfer_syntax=ExplicitVRLittleEndian,
+    pixel_data: bytes | None = None,
+    bits_allocated: int = 8,
+) -> Dataset:
+    ds = Dataset()
+    ds.file_meta = FileMetaDataset()
+    ds.file_meta.TransferSyntaxUID = transfer_syntax
+    ds.SOPClassUID = SecondaryCaptureImageStorage
+    ds.SOPInstanceUID = generate_uid()
+    ds.NumberOfFrames = frames
+    ds.SamplesPerPixel = 1
+    ds.PhotometricInterpretation = "MONOCHROME2"
+    ds.Rows = 1
+    ds.Columns = 2 if bits_allocated != 1 else 9
+    ds.BitsAllocated = bits_allocated
+    ds.BitsStored = bits_allocated
+    ds.HighBit = bits_allocated - 1
+    ds.PixelRepresentation = 0
+    if pixel_data is None:
+        if bits_allocated == 1:
+            pixel_data = bytes((0b10101010, 0b00000001, 0b01010101, 0b00000000))
+        else:
+            pixel_data = bytes(range(frames * 2))
+    ds.PixelData = pixel_data
+    ds.PerFrameFunctionalGroupsSequence = Sequence([Dataset() for _ in range(frames)])
+    return ds
+
+
+def add_frame_content(ds: Dataset, values: list[list[int] | None]) -> None:
+    items = []
+    for index, value in enumerate(values):
+        item = Dataset()
+        content = Dataset()
+        content.InStackPositionNumber = index + 10
+        content.StackID = "A" if index < 2 else "B"
+        if value is not None:
+            content.DimensionIndexValues = value
+        item.FrameContentSequence = Sequence([content])
+        items.append(item)
+    ds.PerFrameFunctionalGroupsSequence = Sequence(items)
+
+
+def test_exports_and_frame_attributes_are_copies():
+    ds = make_dataset()
+    shared = Dataset()
+    shared.PixelMeasuresSequence = Sequence([Dataset()])
+    shared.PixelMeasuresSequence[0].SliceThickness = 1
+    per = [Dataset() for _ in range(3)]
+    per[0].PixelMeasuresSequence = Sequence([Dataset()])
+    per[0].PixelMeasuresSequence[0].SliceThickness = 2
+    per[1].PlanePositionSequence = Sequence([Dataset()])
+    per[1].PlanePositionSequence[0].ImagePositionPatient = [1, 2, 3]
+    ds.SharedFunctionalGroupsSequence = Sequence([shared])
+    ds.PerFrameFunctionalGroupsSequence = Sequence(per)
+
+    attrs = frame_attributes(ds, 0)
+    assert list(attrs.keys()) == [Tag("PixelMeasuresSequence")]
+    assert attrs.PixelMeasuresSequence[0].SliceThickness == 2
+    attrs.PixelMeasuresSequence[0].SliceThickness = 99
+    assert ds.SharedFunctionalGroupsSequence[0].PixelMeasuresSequence[0].SliceThickness == 1
+    assert pydicom.frame_attributes is frame_attributes
+    assert varying_attributes(ds) == {Tag("PixelMeasuresSequence"), Tag("PlanePositionSequence")}
+
+
+def test_extract_reorders_native_pixels_and_source_reference():
+    ds = make_dataset()
+    original = deepcopy(ds)
+    result = extract_frames(ds, [2, 0])
+
+    assert result.NumberOfFrames == 2
+    assert result.PixelData == bytes([4, 5, 0, 1])
+    assert result.SourceImageSequence[0].ReferencedFrameNumber == [3, 1]
+    assert result.SOPInstanceUID != ds.SOPInstanceUID
+    assert result.file_meta.MediaStorageSOPInstanceUID == result.SOPInstanceUID
+    assert result.file_meta.MediaStorageSOPClassUID == result.SOPClassUID
+    assert ds == original
+
+
+def test_extract_reorders_bit_packed_pixels_by_bits():
+    ds = make_dataset(frames=2, bits_allocated=1)
+    # Frame 0: 9 bits, frame 1: 9 bits. The second frame is selected first.
+    ds.PixelData = bytes([0b00000001, 0b00000000, 0b00000001, 0])
+    result = extract_frames(ds, [1])
+
+    # The selected frame starts at bit 9, not byte 2.
+    assert result.PixelData == bytes([0b10000000, 0])
+
+
+def test_extract_reencapsulates_and_drops_extended_offsets():
+    ds = make_dataset(
+        transfer_syntax=RLELossless,
+        pixel_data=encapsulate([b"a", b"bb", b"ccc"]),
+    )
+    result = extract_frames(ds, [2, 0])
+
+    assert list(generate_frames(result.PixelData, number_of_frames=2)) == [b"ccc\x00", b"a\x00"]
+    assert "ExtendedOffsetTable" not in result
+    assert result[Tag("PixelData")].is_undefined_length
+
+
+def test_group_and_sort_use_nested_and_multivalued_attributes():
+    ds = make_dataset()
+    add_frame_content(ds, [[2, 1], [1, 2], None])
+
+    groups = group_frames(ds, "DimensionIndexValues")
+    assert [group.PixelData for group in groups] == [bytes([0, 1]), bytes([2, 3]), bytes([4, 5])]
+
+    result = sort_frames(ds, "DimensionIndexValues")
+    assert result.PixelData == bytes([2, 3, 0, 1, 4, 5])
+
+
+def test_merge_requires_compatible_inputs_and_copies_everything():
+    first = make_dataset(frames=2)
+    second = make_dataset(frames=1, pixel_data=b"xy")
+    result = merge_frames([first, second])
+
+    assert result.NumberOfFrames == 3
+    assert result.PixelData == bytes([0, 1, 2, 3]) + b"xy"
+    assert [item.ReferencedFrameNumber for item in result.SourceImageSequence] == [
+        [1, 2],
+        1,
+    ]
+    result.PerFrameFunctionalGroupsSequence[0].add_new(Tag("PatientID"), "LO", "x")
+    assert "PatientID" not in first.PerFrameFunctionalGroupsSequence[0]
+
+    second.Rows = 2
+    with pytest.raises(MultiFrameError):
