+class TestMergeFrames:
+    @pytest.mark.parametrize("transfer_syntax", [ExplicitVRLittleEndian, RLELossless])
+    def test_merge_and_sources(self, transfer_syntax):
+        first = make_dataset((1, 2), transfer_syntax)
+        second = make_dataset((3, 4), transfer_syntax)
+
+        result = merge_frames([first, second])
+
