+def make_dataset(values=(30, 10, 20), transfer_syntax=ExplicitVRLittleEndian):
+    """Return a small, valid enhanced multi-frame test dataset."""
+    ds = Dataset()
+    ds.file_meta = FileMetaDataset()
+    ds.file_meta.TransferSyntaxUID = transfer_syntax
+    ds.SOPClassUID = EnhancedMRImageStorage
+    ds.SOPInstanceUID = generate_uid()
+    ds.Rows = 1
+    ds.Columns = 1
+    ds.SamplesPerPixel = 1
+    ds.PhotometricInterpretation = "MONOCHROME2"
+    ds.BitsAllocated = 8
+    ds.BitsStored = 8
+    ds.HighBit = 7
+    ds.PixelRepresentation = 0
+    ds.NumberOfFrames = len(values)
+
+    if transfer_syntax.is_compressed:
+        ds.PixelData = encapsulate([bytes([value]) for value in values])
+        ds["PixelData"].is_undefined_length = True
+    else:
+        ds.PixelData = bytes(values)
+        if len(ds.PixelData) % 2:
+            ds.PixelData += b"\x00"
+
+    shared = Dataset()
+    measures = Dataset()
+    measures.SliceThickness = 1
+    shared.PixelMeasuresSequence = [measures]
+    ds.SharedFunctionalGroupsSequence = [shared]
+
+    per_frame = []
+    for index, value in enumerate(values):
+        group = Dataset()
+        position = Dataset()
+        position.ImagePositionPatient = [0, 0, value]
+        group.PlanePositionSequence = [position]
+
+        content = Dataset()
+        content.StackID = "A" if index < 2 else "B"
+        content.InStackPositionNumber = 9 - index
+        content.DimensionIndexValues = [7, value]
+        group.FrameContentSequence = [content]
+        per_frame.append(group)
+    ds.PerFrameFunctionalGroupsSequence = per_frame
+
+    first = Dataset()
+    first.DimensionIndexPointer = Tag("StackID")
+    second = Dataset()
+    second.DimensionIndexPointer = Tag("ImagePositionPatient")
+    ds.DimensionIndexSequence = [first, second]
+    return ds
+
+
+def decoded_frames(ds):
+    """Return the individual encoded frames from `ds`."""
+    if ds.file_meta.TransferSyntaxUID.is_compressed:
+        return list(
+            generate_frames(ds.PixelData, number_of_frames=ds.NumberOfFrames)
+        )
+    return [bytes([value]) for value in ds.PixelData[: ds.NumberOfFrames]]
+
+
+class TestFrameAttributes:
+    def test_shared_then_per_frame_and_copy(self):
+        ds = make_dataset()
+        measures = Dataset()
+        measures.SliceThickness = 2
+        ds.PerFrameFunctionalGroupsSequence[0].PixelMeasuresSequence = [measures]
+
+        attributes = frame_attributes(ds, 0)
+
+        assert attributes.SliceThickness == 2
+        assert attributes.ImagePositionPatient == [0, 0, 30]
+        attributes.SliceThickness = 5
+        assert (
+            ds.PerFrameFunctionalGroupsSequence[0]
+            .PixelMeasuresSequence[0]
+            .SliceThickness
+            == 2
+        )
+
+    def test_varying_includes_missing_and_nothing_for_one_frame(self):
+        ds = make_dataset()
+        del ds.PerFrameFunctionalGroupsSequence[2].FrameContentSequence[0].StackID
+
+        assert Tag("StackID") in varying_attributes(ds)
+        assert Tag("ImagePositionPatient") in varying_attributes(ds)
+
+        one = make_dataset((1,))
+        assert varying_attributes(one) == set()
+
+    @pytest.mark.parametrize("index", [-1, 3, "1"])
+    def test_missing_frame(self, index):
+        with pytest.raises(MultiFrameError):
+            frame_attributes(make_dataset(), index)
+
