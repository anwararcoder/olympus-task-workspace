+class TestExtractFrames:
+    def test_metadata_pixels_indices_and_source(self):
+        source = make_dataset()
+        original = copy.deepcopy(source)
+
+        result = extract_frames(source, [2, 1, 0])
+
+        assert decoded_frames(result) == [b"\x14", b"\x0a", b"\x1e"]
+        assert result.NumberOfFrames == 3
+        assert len(result.SharedFunctionalGroupsSequence) == 1
+        assert len(result.DimensionIndexSequence) == 1
+        assert [
+            item.FrameContentSequence[0].DimensionIndexValues
+            for item in result.PerFrameFunctionalGroupsSequence
+        ] == [1, 2, 3]
+        assert [
+            item.FrameContentSequence[0].InStackPositionNumber
+            for item in result.PerFrameFunctionalGroupsSequence
+        ] == [1, 1, 2]
+        assert result.SourceImageSequence[0].ReferencedSOPClassUID == source.SOPClassUID
+        assert (
+            result.SourceImageSequence[0].ReferencedSOPInstanceUID
+            == source.SOPInstanceUID
+        )
+        assert result.SourceImageSequence[0].ReferencedFrameNumber == [3, 2, 1]
+        assert result.SOPInstanceUID == result.file_meta.MediaStorageSOPInstanceUID
+        assert result.SOPInstanceUID != source.SOPInstanceUID
+        assert source == original
+
+    def test_drops_empty_dimension_values(self):
+        result = extract_frames(make_dataset(), [0])
+
+        assert "DimensionIndexSequence" not in result
+        content = result.SharedFunctionalGroupsSequence[0].FrameContentSequence[0]
+        assert "DimensionIndexValues" not in content
+
+    @pytest.mark.parametrize("indices", [[], [0, 0], [-1], [3]])
+    def test_invalid_selection(self, indices):
+        with pytest.raises(MultiFrameError):
+            extract_frames(make_dataset(), indices)
+
+    def test_bit_packed_native_frames(self):
+        ds = make_dataset((1, 2, 3))
+        ds.Columns = 3
+        ds.BitsAllocated = ds.BitsStored = 1
+        ds.HighBit = 0
+        # Frames are 101, 010 and 110, packed continuously least-significant
+        # bit first, followed by unused zero bits.
+        ds.PixelData = b"\xd5\x00"
+
+        result = extract_frames(ds, [2, 0])
+
+        assert result.PixelData == b"\x2b\x00"
+
