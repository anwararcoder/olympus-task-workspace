+def test_frame_attributes_and_varying_are_effective_copies():
+    ds = make_multiframe()
+    attrs = frame_attributes(ds, 0)
+
+    assert attrs.PixelSpacing == [1, 1]
+    assert attrs.TemporalPositionIndex == 2
+    attrs.PixelSpacing = [3, 3]
+    assert (
+        ds.SharedFunctionalGroupsSequence[0].PixelMeasuresSequence[0].PixelSpacing
+        == [1, 1]
+    )
+    assert set(varying_attributes(ds)) == {
+        0x00209057,
+        0x00209128,
+        0x00209157,
+    }
+    assert varying_attributes(make_multiframe((1,))) == []
