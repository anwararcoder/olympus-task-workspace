+"""Tests for frame-level enhanced multi-frame operations."""
+
+from copy import deepcopy
+
+import pytest
+
+from pydicom import (
+    Dataset,
+    FileMetaDataset,
+    MultiFrameError,
+    Sequence,
+    extract_frames,
+    frame_attributes,
+    group_frames,
+    merge_frames,
+    sort_frames,
+    varying_attributes,
+)
+from pydicom.encaps import encapsulate, encapsulate_extended, generate_frames
+from pydicom.uid import CTImageStorage, ExplicitVRLittleEndian, JPEGBaseline8Bit
+
+
+def make_multiframe(values=(2, 1, 2), *, transfer_syntax=ExplicitVRLittleEndian):
+    """Return a small but representative enhanced multi-frame dataset."""
+    ds = Dataset()
+    ds.file_meta = FileMetaDataset()
+    ds.file_meta.TransferSyntaxUID = transfer_syntax
+    ds.SOPClassUID = CTImageStorage
+    ds.SOPInstanceUID = "1.2.3.4"
+    ds.Rows = 1
+    ds.Columns = 1
+    ds.SamplesPerPixel = 1
+    ds.PhotometricInterpretation = "MONOCHROME2"
+    ds.BitsAllocated = 8
+    ds.BitsStored = 8
+    ds.HighBit = 7
+    ds.PixelRepresentation = 0
+
+    shared = Dataset()
+    pixel_measures = Dataset()
+    pixel_measures.PixelSpacing = [1, 1]
+    shared.PixelMeasuresSequence = Sequence([pixel_measures])
+    ds.SharedFunctionalGroupsSequence = Sequence([shared])
+
+    groups = []
+    for index, value in enumerate(values):
+        group = Dataset()
+        content = Dataset()
+        content.StackID = "A"
+        content.InStackPositionNumber = index + 5
+        content.TemporalPositionIndex = value
+        content.DimensionIndexValues = [value, 9]
+        group.FrameContentSequence = Sequence([content])
+        groups.append(group)
+    ds.PerFrameFunctionalGroupsSequence = Sequence(groups)
+    ds.NumberOfFrames = len(groups)
+
+    temporal = Dataset()
+    temporal.DimensionIndexPointer = 0x00209128
+    constant = Dataset()
+    constant.DimensionIndexPointer = 0x00209057
+    ds.DimensionIndexSequence = Sequence([temporal, constant])
+
+    frames = [bytes([index + 1]) for index in range(len(groups))]
+    if transfer_syntax.is_encapsulated:
+        ds.PixelData = encapsulate(frames)
+    else:
+        value = b"".join(frames)
+        ds.PixelData = value + (b"\0" if len(value) % 2 else b"")
+    return ds
+
