+def test_bit_packed_native_frames_are_reordered_at_bit_boundaries():
+    ds = make_multiframe()
+    ds.Columns = 3
+    ds.BitsAllocated = 1
+    ds.BitsStored = 1
+    ds.HighBit = 0
+    # Logical frames, least-significant bit first: 101, 011, 110
+    bits = [1, 0, 1, 0, 1, 1, 1, 1, 0]
+    value = bytearray(2)
+    for index, bit in enumerate(bits):
+        value[index // 8] |= bit << (index % 8)
+    ds.PixelData = bytes(value)
+
+    out = extract_frames(ds, [2, 0])
+
+    assert out.PixelData == bytes([0b00101011, 0])
+
