+def test_encapsulated_pixel_data_is_rebuilt():
+    ds = make_multiframe(transfer_syntax=JPEGBaseline8Bit)
+    pixel_data, offsets, lengths = encapsulate_extended(
+        [b"\x01", b"\x02", b"\x03"]
+    )
+    ds.PixelData = pixel_data
+    ds.ExtendedOffsetTable = offsets
+    ds.ExtendedOffsetTableLengths = lengths
+
+    out = extract_frames(ds, [2, 0])
+
+    assert list(generate_frames(out.PixelData, number_of_frames=2)) == [
+        b"\x03\0",
+        b"\x01\0",
+    ]
+    assert "ExtendedOffsetTable" not in out
+    assert "ExtendedOffsetTableLengths" not in out
+
