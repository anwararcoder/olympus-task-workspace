+def test_group_sort_and_merge():
+    ds = make_multiframe()
+    grouped = group_frames(ds, ["TemporalPositionIndex"])
+    assert [item.NumberOfFrames for item in grouped] == [2, 1]
+    assert grouped[0].PixelData == b"\x01\x03"
+
+    sorted_ds = sort_frames(ds, ["TemporalPositionIndex"])
+    assert sorted_ds.PixelData == b"\x02\x01\x03\0"
+
+    second = make_multiframe((3,))
+    second.SOPInstanceUID = "1.2.3.5"
+    merged = merge_frames([make_multiframe((1,)), second])
+    assert merged.NumberOfFrames == 2
+    assert len(merged.SourceImageSequence) == 2
+    assert merged.SourceImageSequence[1].ReferencedSOPInstanceUID == "1.2.3.5"
