+def test_extract_rebuilds_instance_without_changing_input():
+    ds = make_multiframe()
+    original = deepcopy(ds)
+    out = extract_frames(ds, [1, 0])
+
+    assert out.PixelData == b"\x02\x01"
+    assert out.NumberOfFrames == 2
+    assert out.SOPInstanceUID != ds.SOPInstanceUID
+    assert out.file_meta.MediaStorageSOPInstanceUID == out.SOPInstanceUID
+    assert out.file_meta.MediaStorageSOPClassUID == out.SOPClassUID
+    assert out.SourceImageSequence[0].ReferencedFrameNumber == [2, 1]
+    assert len(out.SharedFunctionalGroupsSequence) == 1
+    assert len(out.DimensionIndexSequence) == 2
+    contents = [
+        item.FrameContentSequence[0]
+        for item in out.PerFrameFunctionalGroupsSequence
+    ]
+    assert [item.InStackPositionNumber for item in contents] == [1, 2]
+    assert [item.DimensionIndexValues for item in contents] == [[1, 1], [2, 2]]
+    assert ds == original
