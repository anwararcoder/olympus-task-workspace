+        extract_frames(make_dataset(), indices)
+
+
+@pytest.mark.parametrize("keys", [[], ["not_a_keyword"], [object()]])
+def test_invalid_keys(keys):
+    with pytest.raises(MultiFrameError):
+        group_frames(make_dataset(), keys)
+
+
+def test_incomparable_sort_values():
+    ds = make_dataset((1, 2))
+    first = ds.PerFrameFunctionalGroupsSequence[0].PlanePositionSequence[0]
+    second = ds.PerFrameFunctionalGroupsSequence[1].PlanePositionSequence[0]
+    first_value = Dataset()
