+
+def test_uncombinable_inputs():
+    first = make_dataset()
+    second = make_dataset()
+    second.Rows = 2
+    second.PixelData = b"\x01\x02\x03\x04\x05\x06"
+
+    with pytest.raises(MultiFrameError):
