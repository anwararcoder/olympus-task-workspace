+# Copyright 2008-2026 pydicom authors. See LICENSE file for details.
+"""Tests for the enhanced multi-frame helpers."""
+
+import copy
+from struct import pack
+
+import pytest
+
+import pydicom
+from pydicom.dataset import Dataset, FileMetaDataset
+from pydicom.encaps import encapsulate, generate_frames
+from pydicom.multiframe import (
+    MultiFrameError,
+    extract_frames,
+    frame_attributes,
+    group_frames,
+    merge_frames,
+    sort_frames,
+    varying_attributes,
+)
+from pydicom.sequence import Sequence
+from pydicom.tag import Tag
+from pydicom.uid import (
+    EnhancedCTImageStorage,
+    ExplicitVRLittleEndian,
+    RLELossless,
+    generate_uid,
+)
+
+
+def make_dataset(
+    positions: tuple[int | None, ...] = (30, 10, 20),
+    *,
+    transfer_syntax=ExplicitVRLittleEndian,
+) -> Dataset:
+    """Return a small valid enhanced multi-frame test dataset."""
+    ds = Dataset()
+    ds.file_meta = FileMetaDataset()
+    ds.file_meta.TransferSyntaxUID = transfer_syntax
+    ds.SOPClassUID = EnhancedCTImageStorage
+    ds.SOPInstanceUID = generate_uid()
+    ds.file_meta.MediaStorageSOPClassUID = ds.SOPClassUID
+    ds.file_meta.MediaStorageSOPInstanceUID = ds.SOPInstanceUID
+
+    ds.Rows = 1
+    ds.Columns = 1
+    ds.SamplesPerPixel = 1
+    ds.PhotometricInterpretation = "MONOCHROME2"
+    ds.BitsAllocated = 8
+    ds.BitsStored = 8
+    ds.HighBit = 7
+    ds.PixelRepresentation = 0
+    ds.NumberOfFrames = len(positions)
+    frames = [bytes([index + 1]) for index in range(len(positions))]
+    if transfer_syntax.is_encapsulated:
+        ds.PixelData = encapsulate(frames)
+    else:
+        value = b"".join(frames)
+        ds.PixelData = value + (b"\x00" if len(value) % 2 else b"")
+
+    shared = Dataset()
+    pixel_measures = Dataset()
+    pixel_measures.PixelSpacing = [0.5, 0.5]
+    shared.PixelMeasuresSequence = Sequence([pixel_measures])
+    ds.SharedFunctionalGroupsSequence = Sequence([shared])
+
+    per_frame = []
+    for position in positions:
+        item = Dataset()
+        if position is not None:
+            plane_position = Dataset()
+            plane_position.ImagePositionPatient = [0, 0, position]
+            item.PlanePositionSequence = Sequence([plane_position])
+        per_frame.append(item)
+    ds.PerFrameFunctionalGroupsSequence = Sequence(per_frame)
+    return ds
+
+
+def test_public_exports():
+    assert pydicom.MultiFrameError is MultiFrameError
+    assert pydicom.extract_frames is extract_frames
+    assert pydicom.frame_attributes is frame_attributes
+    assert pydicom.group_frames is group_frames
+    assert pydicom.merge_frames is merge_frames
+    assert pydicom.sort_frames is sort_frames
+    assert pydicom.varying_attributes is varying_attributes
+
+
+def test_frame_attributes_replacement_and_copy():
+    ds = make_dataset()
+    shared_position = Dataset()
+    shared_position.ImagePositionPatient = [9, 9, 9]
+    shared_position.PatientPosition = "HFS"
+    ds.SharedFunctionalGroupsSequence[0].PlanePositionSequence = Sequence(
+        [shared_position]
+    )
+
+    attributes = frame_attributes(ds, 0)
+    assert attributes.ImagePositionPatient == [0, 0, 30]
+    # The whole per-frame macro replaces the corresponding shared macro.
+    assert "PatientPosition" not in attributes
+    assert attributes.PixelSpacing == [0.5, 0.5]
+
+    attributes.PixelSpacing = [2, 2]
+    source_spacing = (
+        ds.SharedFunctionalGroupsSequence[0].PixelMeasuresSequence[0].PixelSpacing
+    )
+    assert source_spacing == [0.5, 0.5]
+
+
+def test_varying_attributes():
+    ds = make_dataset()
+    assert varying_attributes(ds) == {Tag("ImagePositionPatient")}
+
+    one = extract_frames(ds, [0])
+    assert varying_attributes(one) == set()
+
+
+def test_extract_order_source_and_independence():
+    ds = make_dataset()
+    original = copy.deepcopy(ds)
+    output = extract_frames(ds, [2, 0])
+
+    assert output.NumberOfFrames == 2
+    assert output.PixelData == b"\x03\x01"
+    assert [
+        frame_attributes(output, index).ImagePositionPatient[-1] for index in range(2)
+    ] == [20, 30]
+    assert output.SOPInstanceUID != ds.SOPInstanceUID
+    assert output.file_meta.MediaStorageSOPInstanceUID == output.SOPInstanceUID
+    source = output.SourceImageSequence[0]
+    assert source.ReferencedSOPClassUID == ds.SOPClassUID
+    assert source.ReferencedSOPInstanceUID == ds.SOPInstanceUID
+    assert source.ReferencedFrameNumber == [3, 1]
+    assert ds == original
+
+    output.PatientName = "Changed"
+    output.SharedFunctionalGroupsSequence[0].PixelMeasuresSequence[0].PixelSpacing = [
+        3,
+        3,
+    ]
+    assert "PatientName" not in ds
+    source_spacing = (
+        ds.SharedFunctionalGroupsSequence[0].PixelMeasuresSequence[0].PixelSpacing
+    )
+    assert source_spacing == [0.5, 0.5]
+
+
+def test_group_first_appearance_and_missing():
+    ds = make_dataset((20, None, 10, None, 20))
+    groups = group_frames(ds, ["ImagePositionPatient"])
+
+    assert len(groups) == 3
+    assert [group.PixelData.rstrip(b"\x00") for group in groups] == [
+        b"\x01\x05",
+        b"\x02\x04",
+        b"\x03",
+    ]
+
+
+def test_sort_ascending_missing_last_and_stable():
+    ds = make_dataset((20, None, 10, 10))
+    output = sort_frames(ds, [Tag("ImagePositionPatient")])
+    assert output.PixelData == b"\x03\x04\x01\x02"
+
+
+def test_merge_inputs_and_source_references():
+    first = make_dataset((1, 2))
+    second = make_dataset((3, 4))
+    output = merge_frames([first, second])
+
+    assert output.NumberOfFrames == 4
+    assert output.PixelData == b"\x01\x02\x01\x02"
+    assert len(output.SourceImageSequence) == 2
+    assert output.SourceImageSequence[0].ReferencedFrameNumber == [1, 2]
+    assert output.SourceImageSequence[1].ReferencedFrameNumber == [1, 2]
+
+
+def test_dimension_and_stack_normalization():
+    ds = make_dataset((30, 10, 20))
+    for index, item in enumerate(ds.PerFrameFunctionalGroupsSequence):
+        content = Dataset()
+        content.StackID = "A"
+        content.InStackPositionNumber = 10 - index
+        content.DimensionIndexValues = [8, (3, 1, 2)[index]]
+        item.FrameContentSequence = Sequence([content])
+
+    constant = Dataset()
+    constant.DimensionIndexPointer = Tag("StackID")
+    varying = Dataset()
+    varying.DimensionIndexPointer = Tag("InStackPositionNumber")
+    ds.DimensionIndexSequence = Sequence([constant, varying])
+
+    output = extract_frames(ds, [1, 2, 0])
+    attributes = [frame_attributes(output, index) for index in range(3)]
+    assert [item.InStackPositionNumber for item in attributes] == [1, 2, 3]
+    assert [item.DimensionIndexValues for item in attributes] == [1, 2, 3]
+    assert len(output.DimensionIndexSequence) == 1
+
+
+def test_all_dimensions_removed_without_empty_values():
+    ds = make_dataset((1, 2))
+    for item in ds.PerFrameFunctionalGroupsSequence:
+        content = Dataset()
+        content.DimensionIndexValues = 7
+        item.FrameContentSequence = Sequence([content])
+    description = Dataset()
+    description.DimensionIndexPointer = Tag("StackID")
+    ds.DimensionIndexSequence = Sequence([description])
+
+    output = extract_frames(ds, [0, 1])
+    assert "DimensionIndexSequence" not in output
+    for index in range(2):
+        assert "DimensionIndexValues" not in frame_attributes(output, index)
+
+
+def test_shared_macro_promotion():
+    ds = make_dataset((10, 10))
+    output = extract_frames(ds, [0, 1])
+    shared = output.SharedFunctionalGroupsSequence[0]
+
+    assert "PixelMeasuresSequence" in shared
+    assert "PlanePositionSequence" in shared
+    assert all(not item for item in output.PerFrameFunctionalGroupsSequence)
+
+
+def test_encapsulated_rebuild_and_extended_offsets_removed():
+    ds = make_dataset((1, 2, 3), transfer_syntax=RLELossless)
+    ds.ExtendedOffsetTable = pack("<3Q", 0, 10, 20)
+    ds.ExtendedOffsetTableLengths = pack("<3Q", 1, 1, 1)
+
+    output = extract_frames(ds, [2, 0])
+    assert list(generate_frames(output.PixelData, number_of_frames=2)) == [
+        b"\x03\x00",
+        b"\x01\x00",
+    ]
+    assert "ExtendedOffsetTable" not in output
+    assert "ExtendedOffsetTableLengths" not in output
+
+
+def test_bit_packed_frames_are_reordered_at_bit_boundaries():
+    ds = make_dataset((1, 2, 3))
+    ds.Columns = 3
+    ds.BitsAllocated = 1
+    ds.BitsStored = 1
+    ds.HighBit = 0
+    # Three three-bit frames with values 1, 2 and 4, packed continuously.
+    ds.PixelData = b"\x11\x01"
+
+    output = extract_frames(ds, [2, 0])
+    assert output.PixelData == b"\x0c\x00"
+
+
+@pytest.mark.parametrize(
+    "change",
+    [
+        lambda ds: ds.__delattr__("PerFrameFunctionalGroupsSequence"),
+        lambda ds: ds.file_meta.__delattr__("TransferSyntaxUID"),
+        lambda ds: ds.__delattr__("SOPClassUID"),
+        lambda ds: ds.__delattr__("SOPInstanceUID"),
+        lambda ds: ds.__delattr__("PixelData"),
+        lambda ds: setattr(ds, "FloatPixelData", b"\x00" * 12),
+        lambda ds: setattr(ds, "SharedFunctionalGroupsSequence", Sequence()),
+        lambda ds: ds.__delattr__("NumberOfFrames"),
+        lambda ds: setattr(ds, "NumberOfFrames", 2),
+        lambda ds: setattr(ds, "PixelData", b"\x01"),
+    ],
+)
+def test_invalid_dataset(change):
+    ds = make_dataset()
+    change(ds)
+    with pytest.raises(MultiFrameError):
+        frame_attributes(ds, 0)
+
+
+@pytest.mark.parametrize("indices", [[], [0, 0], [-1], [3]])
+def test_invalid_selection(indices):
