@@ -0,0 +1,450 @@
+package org.immutables.fixture;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNotSame;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.ObjectInputStream;
+import java.io.ObjectOutputStream;
+import java.io.Serializable;
+import java.util.Collections;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import org.immutables.fixture.marshal.Marshaling;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+class SeedableLazyTest {
+  @BeforeEach
+  void reset() {
+    SeedableLazy.reset();
+  }
+
+  @Test
+  void unseededFallbacksStayColdAndMemoize() throws Exception {
+    ImmutableSeedableLazy value = ImmutableSeedableLazy.builder().name("cold").build();
+
+    assertNoInitializersCalled();
+    assertEquals(7, value.number());
+    SeedableLazy.numberFallback.set(9);
+    assertEquals(7, value.number());
+    assertEquals(1, SeedableLazy.numberCalls.get());
+
+    assertTrue(value.flag());
+    assertTrue(value.flag());
+    assertEquals(1, SeedableLazy.flagCalls.get());
+
+    assertEquals("fallback", value.nullable());
+    assertEquals("fallback", value.nullable());
+    assertEquals(1, SeedableLazy.nullableCalls.get());
+
+    Optional<String> optional = value.optional();
+    assertSame(optional, value.optional());
+    assertEquals(Optional.of("fallback"), optional);
+    assertEquals(1, SeedableLazy.optionalCalls.get());
+
+    int[] array = value.array();
+    assertSame(array, value.array());
+    assertArrayEquals(new int[] {1}, array);
+    assertEquals(1, SeedableLazy.arrayCalls.get());
+
+    List<String> items = value.items();
+    assertSame(items, value.items());
+    assertEquals(Collections.singletonList("fallback"), items);
+    assertEquals(1, SeedableLazy.itemsCalls.get());
+
+    Map<String, Integer> entries = value.entries();
+    assertSame(entries, value.entries());
+    assertEquals(Collections.singletonMap("fallback", 1), entries);
+    assertEquals(1, SeedableLazy.entriesCalls.get());
+
+    assertEquals("checked", value.checked());
+    assertEquals("checked", value.checked());
+    assertEquals(1, SeedableLazy.checkedCalls.get());
+  }
+
+  @Test
+  void builderAcceptsFalsyNullAndEmptySeeds() throws Exception {
+    ImmutableSeedableLazy value = ImmutableSeedableLazy.builder()
+        .name("seeded")
+        .number(0)
+        .flag(false)
+        .nullable(null)
+        .optional(Optional.empty())
+        .array()
+        .addAllItems(Collections.emptyList())
+        .putAllEntries(Collections.emptyMap())
+        .checked("seed")
+        .build();
+
+    assertNoInitializersCalled();
+    assertEquals(0, value.number());
+    assertFalse(value.flag());
+    assertNull(value.nullable());
+    assertEquals(Optional.empty(), value.optional());
+    assertArrayEquals(new int[0], value.array());
+    assertEquals(Collections.emptyList(), value.items());
+    assertEquals(Collections.emptyMap(), value.entries());
+    assertEquals("seed", value.checked());
+    assertNoInitializersCalled();
+  }
+
+  @Test
+  void withMethodsSeedEvenWhenEqualToFallback() {
+    ImmutableSeedableLazy source = ImmutableSeedableLazy.builder().name("source").build();
+    assertEquals(7, source.number());
+
+    ImmutableSeedableLazy seeded = source.withNumber(7);
+    SeedableLazy.numberFallback.set(11);
+    assertEquals(7, seeded.number());
+    assertEquals(1, SeedableLazy.numberCalls.get());
+
+    ImmutableSeedableLazy renamedSeed = seeded.withName("renamed-seed");
+    assertEquals(7, renamedSeed.number());
+    assertEquals(1, SeedableLazy.numberCalls.get());
+
+    ImmutableSeedableLazy renamedFallback = source.withName("renamed-fallback");
+    assertEquals(11, renamedFallback.number());
+    assertEquals(2, SeedableLazy.numberCalls.get());
+  }
+
+  @Test
+  void generatedCopyPathsPreserveOnlyExplicitSeeds() {
+    ImmutableSeedableLazy seeded = ImmutableSeedableLazy.builder()
+        .name("seeded")
+        .number(0)
+        .nullable(null)
+        .optional(Optional.empty())
+        .array()
+        .addItems("item")
+        .putEntries("entry", 1)
+        .build();
+
+    ImmutableSeedableLazy toBuilderCopy = seeded.toBuilder().name("to-builder").build();
+    ImmutableSeedableLazy fromCopy = ImmutableSeedableLazy.builder().from(seeded).build();
+
+    assertSeededCopy(toBuilderCopy);
+    assertSeededCopy(fromCopy);
+    assertNoInitializersCalled();
+
+    ImmutableSeedableLazy unseeded = ImmutableSeedableLazy.builder().name("unseeded").build();
+    ImmutableSeedableLazy preservedDestinationSeed = ImmutableSeedableLazy.builder()
+        .name("destination")
+        .number(3)
+        .from(unseeded)
+        .build();
+    assertEquals(3, preservedDestinationSeed.number());
+    assertNoInitializersCalled();
+
+    ImmutableSeedableLazy unseededToBuilder = unseeded.toBuilder().name("copy").build();
+    SeedableLazy.numberFallback.set(13);
+    assertEquals(13, unseededToBuilder.number());
+    assertEquals(1, SeedableLazy.numberCalls.get());
+  }
+
+  @Test
+  void copyOfAndFromGeneratedModifiablePreserveSeedsOnce() {
+    ModifiableSeedableLazy source = ModifiableSeedableLazy.create()
+        .setName("modifiable")
+        .setNumber(0)
+        .addItems("item")
+        .putEntries("entry", 1);
+
+    ImmutableSeedableLazy copied = ImmutableSeedableLazy.copyOf(source);
+    ImmutableSeedableLazy builtFromAbstract = ImmutableSeedableLazy.builder()
+        .from((SeedableLazy) source)
+        .build();
+    ModifiableSeedableLazy modifiableCopy = ModifiableSeedableLazy.create()
+        .from((SeedableLazy) source);
+    ModifiableSeedableLazy unseededSource = ModifiableSeedableLazy.create()
+        .setName("unseeded");
+    ImmutableSeedableLazy preservedBuilderSeed = ImmutableSeedableLazy.builder()
+        .name("destination")
+        .number(2)
+        .from((SeedableLazy) unseededSource)
+        .build();
+    ModifiableSeedableLazy preservedModifiableSeed = ModifiableSeedableLazy.create()
+        .setName("destination")
+        .setNumber(3)
+        .from((SeedableLazy) unseededSource);
+
+    assertEquals(0, copied.number());
+    assertEquals(Collections.singletonList("item"), copied.items());
+    assertEquals(Collections.singletonMap("entry", 1), copied.entries());
+    assertEquals(Collections.singletonList("item"), builtFromAbstract.items());
+    assertEquals(Collections.singletonMap("entry", 1), builtFromAbstract.entries());
+    assertEquals(Collections.singletonList("item"), modifiableCopy.items());
+    assertEquals(Collections.singletonMap("entry", 1), modifiableCopy.entries());
+    assertEquals(2, preservedBuilderSeed.number());
+    assertEquals(3, preservedModifiableSeed.number());
+    assertNoInitializersCalled();
+  }
+
+  @Test
+  void externalImplementationsLeaveHybridsAbsent() {
+    SeedableLazy external = external("external");
+
+    ImmutableSeedableLazy copied = ImmutableSeedableLazy.copyOf(external);
+    ImmutableSeedableLazy destinationSeed = ImmutableSeedableLazy.builder()
+        .name("destination")
+        .number(5)
+        .from(external)
+        .build();
+    ModifiableSeedableLazy modifiable = ModifiableSeedableLazy.create()
+        .setName("destination")
+        .setNumber(6)
+        .from(external);
+
+    assertEquals(5, destinationSeed.number());
+    assertEquals(6, modifiable.number());
+    assertNoInitializersCalled();
+
+    SeedableLazy.numberFallback.set(17);
+    assertEquals(17, copied.number());
+    assertEquals(1, SeedableLazy.numberCalls.get());
+
+    SeedableLazy.reset();
+    ImmutableSeedableLazyNoFrom noFromCopy = ImmutableSeedableLazyNoFrom.copyOf(externalNoFrom("external"));
+    assertEquals(0, SeedableLazy.numberCalls.get());
+    SeedableLazy.numberFallback.set(19);
+    assertEquals(19, noFromCopy.number());
+    assertEquals(1, SeedableLazy.numberCalls.get());
+  }
+
+  @Test
+  void modifiableFallbacksStayFreshAndUnset() throws Exception {
+    ModifiableSeedableLazy value = ModifiableSeedableLazy.create().setName("modifiable");
+
+    assertEquals(7, value.number());
+    assertEquals(7, value.number());
+    assertFalse(value.numberIsSet());
+    assertEquals(2, SeedableLazy.numberCalls.get());
+
+    int[] firstArray = value.array();
+    int[] secondArray = value.array();
+    assertNotSame(firstArray, secondArray);
+    assertFalse(value.arrayIsSet());
+    assertEquals(2, SeedableLazy.arrayCalls.get());
+
+    List<String> firstItems = value.items();
+    List<String> secondItems = value.items();
+    assertNotSame(firstItems, secondItems);
+    assertFalse(value.itemsIsSet());
+    assertEquals(2, SeedableLazy.itemsCalls.get());
+
+    SeedableLazy.reset();
+    value.setNumber(0)
+        .setFlag(false)
+        .setNullable(null)
+        .setOptional(Optional.empty())
+        .setArray()
+        .addAllItems(Collections.emptyList())
+        .putAllEntries(Collections.emptyMap())
+        .setChecked("seed");
+
+    assertTrue(value.numberIsSet());
+    assertTrue(value.flagIsSet());
+    assertTrue(value.nullableIsSet());
+    assertTrue(value.optionalIsSet());
+    assertTrue(value.arrayIsSet());
+    assertTrue(value.itemsIsSet());
+    assertTrue(value.entriesIsSet());
+    assertTrue(value.checkedIsSet());
+    assertEquals(0, value.number());
+    assertFalse(value.flag());
+    assertNull(value.nullable());
+    assertEquals(Optional.empty(), value.optional());
+    assertArrayEquals(new int[0], value.array());
+    assertEquals(Collections.emptyList(), value.items());
+    assertEquals(Collections.emptyMap(), value.entries());
+    assertEquals("seed", value.checked());
+    assertNoInitializersCalled();
+
+    value.unsetNumber().unsetItems().unsetEntries();
+    assertFalse(value.numberIsSet());
+    assertFalse(value.itemsIsSet());
+    assertFalse(value.entriesIsSet());
+    assertEquals(7, value.number());
+    assertEquals(Collections.singletonList("fallback"), value.items());
+    assertEquals(Collections.singletonMap("fallback", 1), value.entries());
+
+    value.clear();
+    assertFalse(value.numberIsSet());
+    assertFalse(value.flagIsSet());
+    assertFalse(value.nullableIsSet());
+    assertFalse(value.optionalIsSet());
+    assertFalse(value.arrayIsSet());
+    assertFalse(value.itemsIsSet());
+    assertFalse(value.entriesIsSet());
+    assertFalse(value.checkedIsSet());
+  }
+
+  @Test
+  void modifiableFromAndToImmutableRespectSeedState() {
+    ImmutableSeedableLazy seeded = ImmutableSeedableLazy.builder()
+        .name("seeded")
+        .number(0)
+        .addItems("item")
+        .build();
+    ImmutableSeedableLazy unseeded = ImmutableSeedableLazy.builder().name("unseeded").build();
+
+    ModifiableSeedableLazy destination = ModifiableSeedableLazy.create()
+        .setName("destination")
+        .setNumber(4)
+        .from(unseeded);
+    assertEquals(4, destination.number());
+    assertNoInitializersCalled();
+
+    destination.clear().from(seeded);
+    assertTrue(destination.numberIsSet());
+    assertTrue(destination.itemsIsSet());
+    assertEquals(0, destination.number());
+    assertEquals(Collections.singletonList("item"), destination.items());
+
+    ImmutableSeedableLazy seededImmutable = destination.toImmutable();
+    assertEquals(0, seededImmutable.number());
+    assertEquals(Collections.singletonList("item"), seededImmutable.items());
+    assertNoInitializersCalled();
+
+    ModifiableSeedableLazy cold = ModifiableSeedableLazy.create().setName("cold");
+    ImmutableSeedableLazy coldImmutable = cold.toImmutable();
+    assertNoInitializersCalled();
+    SeedableLazy.numberFallback.set(23);
+    assertEquals(23, coldImmutable.number());
+    assertEquals(1, SeedableLazy.numberCalls.get());
+  }
+
+  @Test
+  void equalityHashAndStringDoNotForceHybrids() {
+    ImmutableSeedableLazy unseeded = ImmutableSeedableLazy.builder().name("same").build();
+    ImmutableSeedableLazy seeded = ImmutableSeedableLazy.builder().name("same").number(1).build();
+
+    assertEquals(unseeded, seeded);
+    assertEquals(unseeded.hashCode(), seeded.hashCode());
+    assertEquals("SeedableLazy{name=same}", unseeded.toString());
+    assertNoInitializersCalled();
+  }
+
+  @Test
+  void javaSerializationResetsImmutableLazyState() throws Exception {
+    ImmutableSeedableLazy computed = ImmutableSeedableLazy.builder().name("computed").build();
+    assertEquals(7, computed.number());
+    ImmutableSeedableLazy restoredComputed = roundTrip(computed);
+    assertEquals(1, SeedableLazy.numberCalls.get());
+    SeedableLazy.numberFallback.set(29);
+    assertEquals(29, restoredComputed.number());
+    assertEquals(2, SeedableLazy.numberCalls.get());
+
+    SeedableLazy.reset();
+    ImmutableSeedableLazy seeded = ImmutableSeedableLazy.builder().name("seeded").number(4).build();
+    ImmutableSeedableLazy restoredSeeded = roundTrip(seeded);
+    assertNoInitializersCalled();
+    SeedableLazy.numberFallback.set(31);
+    assertEquals(31, restoredSeeded.number());
+    assertEquals(1, SeedableLazy.numberCalls.get());
+  }
+
+  @Test
+  void javaSerializationResetsModifiableSeeds() throws Exception {
+    ModifiableSeedableLazy seeded = ModifiableSeedableLazy.create()
+        .setName("seeded")
+        .setNumber(4)
+        .addItems("item")
+        .putEntries("entry", 1);
+
+    ModifiableSeedableLazy restored = roundTrip(seeded);
+    assertFalse(restored.numberIsSet());
+    assertFalse(restored.itemsIsSet());
+    assertFalse(restored.entriesIsSet());
+    assertNoInitializersCalled();
+
+    SeedableLazy.numberFallback.set(37);
+    assertEquals(37, restored.number());
+    assertEquals(Collections.singletonList("fallback"), restored.items());
+    assertEquals(Collections.singletonMap("fallback", 1), restored.entries());
+  }
+
+  @Test
+  void structuralSerializationAndMarshalingOmitHybrids() throws Exception {
+    ImmutableSeedableLazyStructural structural = ImmutableSeedableLazyStructural.builder()
+        .name("structural")
+        .number(4)
+        .build();
+    ImmutableSeedableLazyStructural restored = roundTrip(structural);
+    assertNoInitializersCalled();
+    SeedableLazy.numberFallback.set(41);
+    assertEquals(41, restored.number());
+    assertEquals(1, SeedableLazy.numberCalls.get());
+
+    SeedableLazy.reset();
+    ImmutableSeedableLazy marshaled = ImmutableSeedableLazy.builder()
+        .name("json")
+        .number(4)
+        .build();
+    assertEquals("{name:\"json\"}", Marshaling.toJson(marshaled));
+    assertNoInitializersCalled();
+
+    SeedableLazy parsed = Marshaling.fromJson("{name:'json',number:4}", SeedableLazy.class);
+    assertNoInitializersCalled();
+    SeedableLazy.numberFallback.set(43);
+    assertEquals(43, parsed.number());
+    assertEquals(1, SeedableLazy.numberCalls.get());
+  }
+
+  private static void assertSeededCopy(ImmutableSeedableLazy value) {
+    assertEquals(0, value.number());
+    assertNull(value.nullable());
+    assertEquals(Optional.empty(), value.optional());
+    assertArrayEquals(new int[0], value.array());
+    assertEquals(Collections.singletonList("item"), value.items());
+    assertEquals(Collections.singletonMap("entry", 1), value.entries());
+  }
+
+  private static void assertNoInitializersCalled() {
+    assertEquals(0, SeedableLazy.numberCalls.get());
+    assertEquals(0, SeedableLazy.flagCalls.get());
+    assertEquals(0, SeedableLazy.nullableCalls.get());
+    assertEquals(0, SeedableLazy.optionalCalls.get());
+    assertEquals(0, SeedableLazy.arrayCalls.get());
+    assertEquals(0, SeedableLazy.itemsCalls.get());
+    assertEquals(0, SeedableLazy.entriesCalls.get());
+    assertEquals(0, SeedableLazy.checkedCalls.get());
+  }
+
+  private static SeedableLazy external(String name) {
+    return new SeedableLazy() {
+      @Override
+      public String name() {
+        return name;
+      }
+    };
+  }
+
+  private static SeedableLazyNoFrom externalNoFrom(String name) {
+    return new SeedableLazyNoFrom() {
+      @Override
+      String name() {
+        return name;
+      }
+    };
+  }
+
+  @SuppressWarnings("unchecked")
+  private static <T extends Serializable> T roundTrip(T instance) throws Exception {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    try (ObjectOutputStream output = new ObjectOutputStream(bytes)) {
+      output.writeObject(instance);
+    }
+    try (ObjectInputStream input = new ObjectInputStream(
+        new ByteArrayInputStream(bytes.toByteArray()))) {
+      return (T) input.readObject();
+    }
+  }
+}
