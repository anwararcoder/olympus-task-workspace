+#!/bin/bash
+set -uo pipefail
+
+INVOKE_DIR="$PWD"
+cd "$(dirname "$0")"
+
+OUTPUT_PATH=""
+MODE=""
+
+while [[ $# -gt 0 ]]; do
+    case "$1" in
+        --output_path)
+            OUTPUT_PATH="$2"
+            shift 2
+            ;;
+        base|new)
+            MODE="$1"
+            shift
+            ;;
+        *)
+            echo "Usage: $0 --output_path <path> {base|new}"
+            exit 1
+            ;;
+    esac
+done
+
+if [[ -n "$OUTPUT_PATH" && "$OUTPUT_PATH" != /* ]]; then
+    OUTPUT_PATH="$INVOKE_DIR/$OUTPUT_PATH"
+fi
+
+if [[ -z "$MODE" ]]; then
+    echo "Usage: $0 --output_path <path> {base|new}"
+    exit 1
+fi
+
+FOCUS_TEST="SeedableLazy_6c7a1b_Test"
+FOCUS_CLASS="org.immutables.fixture.seedlazy_4f2c9d.SeedableLazy_6c7a1b_Test"
+SOURCE_DIR="value-fixture/seedlazy-tests/org/immutables/fixture/seedlazy_4f2c9d"
+STAGED_DIR="value-fixture/test/org/immutables/fixture/seedlazy_4f2c9d"
+NEGATIVE_DIR="value-fixture/seedlazy-negative/seedlazy_negative"
+REPORTS="value-fixture/target/surefire-reports"
+TMP="${TMPDIR:-/tmp}/immutables-seedable-lazy-mvn-tmp"
+NEGATIVE_LOG="$TMP/negative-compilation.log"
+NEGATIVE_CLASSES="$TMP/negative-classes"
+mkdir -p "$TMP"
+export MAVEN_OPTS="-Xmx950m -XX:MaxMetaspaceSize=384m -Djava.io.tmpdir=$TMP"
+MVN="mvn -B -ntp -o -DforkCount=1 -DreuseForks=true -DfailIfNoTests=false"
+LOG="$TMP/maven-$MODE.log"
+NEGATIVE_FAILURE=0
+
+cleanup() {
+    rm -rf "$STAGED_DIR"
+}
+trap cleanup EXIT
+
+xml_escape() {
+    sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
+}
+
+run_mvn() {
+    $MVN "$@" 2>&1 | tee "$LOG"
+    return "${PIPESTATUS[0]}"
+}
+
+write_xml() {
+    local fallback="${1:-0}"
+    [[ -z "$OUTPUT_PATH" ]] && return 0
+    : > "$OUTPUT_PATH"
+    echo '<testsuites>' >> "$OUTPUT_PATH"
+    FOUND=0
+    for xml in "$REPORTS"/TEST-*.xml; do
+        if [[ -e "$xml" ]]; then
+            FOUND=1
+            grep -v '<?xml' "$xml" >> "$OUTPUT_PATH"
+        fi
+    done
+    if [[ "$FOUND" -eq 0 && "$fallback" -ne 0 ]]; then
+        case "$MODE" in
+            base)
+                FALLBACK_CLASS="org.immutables.fixture.ValuesTest"
+                FALLBACK_TEST="plainAttributes"
+                ;;
+            new)
+                FALLBACK_CLASS="$FOCUS_CLASS"
+                FALLBACK_TEST="omittedSeedIsColdAndSuccessfulFallbackIsConcurrentAndMemoized"
+                ;;
+        esac
+        cat >> "$OUTPUT_PATH" <<XML
+<testsuite name="$MODE" tests="1" failures="1" errors="0" skipped="0">
+  <testcase name="$FALLBACK_TEST" classname="$FALLBACK_CLASS">
+    <failure message="Maven failed before Surefire reports were produced">
+XML
+        if [[ -f "$LOG" ]]; then
+            tail -n 200 "$LOG" | xml_escape >> "$OUTPUT_PATH"
+        else
+            echo "Maven failed before Surefire reports were produced." >> "$OUTPUT_PATH"
+        fi
+        cat >> "$OUTPUT_PATH" <<XML
+    </failure>
+  </testcase>
+</testsuite>
+XML
+    fi
+    if [[ "$NEGATIVE_FAILURE" -ne 0 ]]; then
+        cat >> "$OUTPUT_PATH" <<XML
+<testsuite name="seedable-lazy-invalid-configurations" tests="1" failures="1" errors="0" skipped="0">
+  <testcase name="invalidConfigurationsAreRejected" classname="$FOCUS_CLASS">
+    <failure message="An invalid seedable-lazy configuration was not diagnosed">
+XML
+        tail -n 200 "$NEGATIVE_LOG" | xml_escape >> "$OUTPUT_PATH"
+        cat >> "$OUTPUT_PATH" <<XML
+    </failure>
+  </testcase>
+</testsuite>
+XML
+    fi
+    echo '</testsuites>' >> "$OUTPUT_PATH"
+}
+
+run_negative_checks() {
+    local processor_jars=()
+    local processor_jar
+    mapfile -t processor_jars < <(
+        find value/target -maxdepth 1 -type f -name 'value-*.jar' \
+            ! -name '*-annotations.jar' ! -name '*-sources.jar' \
+            ! -name '*-javadoc.jar' ! -name '*-tests.jar' | sort
+    )
+    if [[ "${#processor_jars[@]}" -ne 1 ]]; then
+        echo "Expected exactly one built value processor JAR, found ${#processor_jars[@]}" >> "$NEGATIVE_LOG"
+        return 1
+    fi
+    processor_jar="${processor_jars[0]}"
+    local source
+    local source_log="$TMP/negative-source.log"
+    : > "$NEGATIVE_LOG"
+    rm -rf "$NEGATIVE_CLASSES"
+    mkdir -p "$NEGATIVE_CLASSES"
+    for source in "$NEGATIVE_DIR"/*.java; do
+        echo "Checking $source" >> "$NEGATIVE_LOG"
