+package org.immutables.fixture;
+
+import java.io.IOException;
+import java.io.Serializable;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.concurrent.atomic.AtomicInteger;
+import javax.annotation.Nullable;
+import org.immutables.gson.Gson;
+import org.immutables.serial.Serial;
+import org.immutables.value.Value;
+
+@Value.Immutable
+@Value.Modifiable
+@Value.Style(toBuilder = "toBuilder")
+@Gson.TypeAdapters
+public abstract class SeedableLazy implements Serializable {
+  private static final long serialVersionUID = 1L;
+
+  static final AtomicInteger numberCalls = new AtomicInteger();
+  static final AtomicInteger flagCalls = new AtomicInteger();
+  static final AtomicInteger nullableCalls = new AtomicInteger();
+  static final AtomicInteger optionalCalls = new AtomicInteger();
+  static final AtomicInteger arrayCalls = new AtomicInteger();
+  static final AtomicInteger itemsCalls = new AtomicInteger();
+  static final AtomicInteger entriesCalls = new AtomicInteger();
+  static final AtomicInteger checkedCalls = new AtomicInteger();
+  static final AtomicInteger numberFallback = new AtomicInteger(7);
+
+  public abstract String name();
+
+  @Value.Lazy
+  @Value.Default
+  public int number() {
+    numberCalls.incrementAndGet();
+    return numberFallback.get();
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public boolean flag() {
+    flagCalls.incrementAndGet();
+    return true;
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public @Nullable String nullable() {
+    nullableCalls.incrementAndGet();
+    return "fallback";
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public Optional<String> optional() {
+    optionalCalls.incrementAndGet();
+    return Optional.of("fallback");
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public int[] array() {
+    arrayCalls.incrementAndGet();
+    return new int[] {1};
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public List<String> items() {
+    itemsCalls.incrementAndGet();
+    return new ArrayList<>(Collections.singletonList("fallback"));
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public Map<String, Integer> entries() {
+    entriesCalls.incrementAndGet();
+    Map<String, Integer> entries = new LinkedHashMap<>();
+    entries.put("fallback", 1);
+    return entries;
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public String checked() throws IOException {
+    checkedCalls.incrementAndGet();
+    return "checked";
+  }
+
+  static void reset() {
+    numberCalls.set(0);
+    flagCalls.set(0);
+    nullableCalls.set(0);
+    optionalCalls.set(0);
+    arrayCalls.set(0);
+    itemsCalls.set(0);
+    entriesCalls.set(0);
+    checkedCalls.set(0);
+    numberFallback.set(7);
+  }
+}
+
+@Value.Immutable
+@Value.Style(from = "")
+abstract class SeedableLazyNoFrom {
+  abstract String name();
+
+  @Value.Lazy
+  @Value.Default
+  int number() {
+    SeedableLazy.numberCalls.incrementAndGet();
+    return SeedableLazy.numberFallback.get();
+  }
+}
+
+@Value.Immutable
+@Serial.Structural
+abstract class SeedableLazyStructural implements Serializable {
+  private static final long serialVersionUID = 1L;
+
+  abstract String name();
+
+  @Value.Lazy
+  @Value.Default
+  int number() {
+    SeedableLazy.numberCalls.incrementAndGet();
+    return SeedableLazy.numberFallback.get();
+  }
+}
