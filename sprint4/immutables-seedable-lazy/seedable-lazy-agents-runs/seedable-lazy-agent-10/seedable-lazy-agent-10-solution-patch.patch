+package org.immutables.fixture;
+
+import java.io.IOException;
+import java.io.Serializable;
+import java.util.Collections;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.concurrent.atomic.AtomicInteger;
+import javax.annotation.Nullable;
+import org.immutables.serial.Serial;
+import org.immutables.value.Value;
+
+@Value.Immutable
+@Value.Modifiable
+@Value.Style(toBuilder = "toBuilder")
+abstract class SeedableLazy implements Serializable {
+  private static final long serialVersionUID = 1L;
+  static final AtomicInteger FALLBACK_CALLS = new AtomicInteger();
+
+  @Value.Lazy
+  @Value.Default
+  int number() throws IOException {
+    return FALLBACK_CALLS.incrementAndGet();
+  }
+
+  @Value.Default
+  String label() {
+    return "default";
+  }
+}
+
+@Value.Immutable
+abstract class SeedableLazyContainers {
+  static final AtomicInteger FALLBACK_CALLS = new AtomicInteger();
+
+  @Value.Lazy
+  @Value.Default
+  @Nullable
+  String nullable() {
+    FALLBACK_CALLS.incrementAndGet();
+    return "fallback";
+  }
+
+  @Value.Lazy
+  @Value.Default
+  boolean flag() {
+    FALLBACK_CALLS.incrementAndGet();
+    return true;
+  }
+
+  @Value.Lazy
+  @Value.Default
+  int number() {
+    FALLBACK_CALLS.incrementAndGet();
+    return 1;
+  }
+
+  @Value.Lazy
+  @Value.Default
+  Optional<String> optional() {
+    FALLBACK_CALLS.incrementAndGet();
+    return Optional.of("fallback");
+  }
+
+  @Value.Lazy
+  @Value.Default
+  int[] array() {
+    FALLBACK_CALLS.incrementAndGet();
+    return new int[] {1};
+  }
+
+  @Value.Lazy
+  @Value.Default
+  List<String> list() {
+    FALLBACK_CALLS.incrementAndGet();
+    return Collections.singletonList("fallback");
+  }
+
+  @Value.Lazy
+  @Value.Default
+  Map<String, Integer> map() {
+    FALLBACK_CALLS.incrementAndGet();
+    return Collections.singletonMap("fallback", 1);
+  }
+}
+
+@Value.Immutable
+@Value.Modifiable
+@Value.Style(from = "")
+abstract class SeedableLazyNoFrom {
+  static final AtomicInteger FALLBACK_CALLS = new AtomicInteger();
+
+  @Value.Lazy
+  @Value.Default
+  int value() {
+    return FALLBACK_CALLS.incrementAndGet();
+  }
+}
+
+@Value.Immutable
+@Serial.Structural
+abstract class SeedableLazyStructural implements Serializable {
+  private static final long serialVersionUID = 1L;
+  static final AtomicInteger FALLBACK_CALLS = new AtomicInteger();
+
+  @Value.Lazy
+  @Value.Default
+  int value() {
+    return FALLBACK_CALLS.incrementAndGet();
+  }
+}
+
+@Value.Immutable(singleton = true)
+abstract class SeedableLazySingleton {
+  static final AtomicInteger FALLBACK_CALLS = new AtomicInteger();
+
+  @Value.Lazy
+  @Value.Default
+  int value() {
+    return FALLBACK_CALLS.incrementAndGet();
+  }
+}
+
+@Value.Immutable(builder = false)
+abstract class SeedableLazyWithOnly {
+  static final AtomicInteger FALLBACK_CALLS = new AtomicInteger();
+
+  @Value.Lazy
+  @Value.Default
+  int value() {
+    return FALLBACK_CALLS.incrementAndGet();
+  }
+}
diff --git a/value-fixture/test/org/immutables/fixture/SeedableLazyTest.java b/value-fixture/test/org/immutables/fixture/SeedableLazyTest.java
new file mode 100644
index 0000000..98f3b62
--- /dev/null
+++ b/value-fixture/test/org/immutables/fixture/SeedableLazyTest.java
@@ -0,0 +1,235 @@
+package org.immutables.fixture;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.ObjectInputStream;
+import java.io.ObjectOutputStream;
+import java.io.Serializable;
+import java.util.Collections;
+import java.util.Optional;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+public class SeedableLazyTest {
+  @Test
+  public void unseededFallbackStaysColdAndMemoizes() throws Exception {
+    SeedableLazy.FALLBACK_CALLS.set(0);
+    ImmutableSeedableLazy value = ImmutableSeedableLazy.builder().build();
+
+    assertEquals(0, SeedableLazy.FALLBACK_CALLS.get());
+    assertEquals(1, value.number());
+    assertEquals(1, value.number());
+    assertEquals(1, SeedableLazy.FALLBACK_CALLS.get());
+  }
+
+  @Test
+  public void buildersAcceptAllFalsySeeds() {
+    SeedableLazyContainers.FALLBACK_CALLS.set(0);
+    ImmutableSeedableLazyContainers value = ImmutableSeedableLazyContainers.builder()
+        .nullable(null)
+        .flag(false)
+        .number(0)
+        .optional(Optional.<String>empty())
+        .array()
+        .addAllList(Collections.<String>emptyList())
+        .putAllMap(Collections.<String, Integer>emptyMap())
+        .build();
+
+    assertNull(value.nullable());
+    assertFalse(value.flag());
+    assertEquals(0, value.number());
+    assertFalse(value.optional().isPresent());
+    assertArrayEquals(new int[0], value.array());
+    assertTrue(value.list().isEmpty());
+    assertTrue(value.map().isEmpty());
+    assertEquals(0, SeedableLazyContainers.FALLBACK_CALLS.get());
+  }
+
+  @Test
+  public void withMethodsAlwaysEstablishSeeds() throws Exception {
+    SeedableLazy.FALLBACK_CALLS.set(0);
+    ImmutableSeedableLazy computed = ImmutableSeedableLazy.builder().build();
+    int fallback = computed.number();
+
+    ImmutableSeedableLazy seeded = computed.withNumber(fallback);
+    ImmutableSeedableLazy copied = seeded.withLabel("changed");
+
+    assertEquals(fallback, copied.number());
+    assertEquals(1, SeedableLazy.FALLBACK_CALLS.get());
+  }
+
+  @Test
+  public void ordinaryWithCopiesOnlyExplicitSeeds() throws Exception {
+    SeedableLazy.FALLBACK_CALLS.set(0);
+    ImmutableSeedableLazy computed = ImmutableSeedableLazy.builder().build();
+    assertEquals(1, computed.number());
+
+    ImmutableSeedableLazy computedCopy = computed.withLabel("changed");
+    assertEquals(1, SeedableLazy.FALLBACK_CALLS.get());
+    assertEquals(2, computedCopy.number());
+
+    ImmutableSeedableLazy seeded = ImmutableSeedableLazy.builder().number(7).build();
+    ImmutableSeedableLazy seededCopy = seeded.withLabel("changed");
+    assertEquals(7, seededCopy.number());
+    assertEquals(2, SeedableLazy.FALLBACK_CALLS.get());
+  }
+
+  @Test
+  public void toBuilderAndFromPreserveOnlyExplicitSeeds() throws Exception {
+    SeedableLazy.FALLBACK_CALLS.set(0);
+    ImmutableSeedableLazy computed = ImmutableSeedableLazy.builder().build();
+    assertEquals(1, computed.number());
+
+    ImmutableSeedableLazy coldCopy = computed.toBuilder().label("copy").build();
+    assertEquals(1, SeedableLazy.FALLBACK_CALLS.get());
+    assertEquals(2, coldCopy.number());
+
+    ImmutableSeedableLazy seeded = ImmutableSeedableLazy.builder().number(8).build();
+    assertEquals(8, seeded.toBuilder().label("copy").build().number());
+
+    ImmutableSeedableLazy unseeded = ImmutableSeedableLazy.builder().build();
+    ImmutableSeedableLazy retained = ImmutableSeedableLazy.builder()
+        .number(9)
+        .from(unseeded)
+        .build();
+    assertEquals(9, retained.number());
+  }
+
+  @Test
+  public void externalImplementationsAreNotRead() throws Exception {
+    SeedableLazy.FALLBACK_CALLS.set(0);
+    SeedableLazy external = new SeedableLazy() {};
+
+    ImmutableSeedableLazy retained = ImmutableSeedableLazy.builder()
+        .number(9)
+        .from(external)
+        .build();
+    assertEquals(0, SeedableLazy.FALLBACK_CALLS.get());
+    assertEquals(9, retained.number());
+
+    SeedableLazyNoFrom.FALLBACK_CALLS.set(0);
+    SeedableLazyNoFrom externalNoFrom = new SeedableLazyNoFrom() {};
+    SeedableLazyNoFrom copy = ImmutableSeedableLazyNoFrom.copyOf(externalNoFrom);
+    assertEquals(0, SeedableLazyNoFrom.FALLBACK_CALLS.get());
+    assertEquals(1, copy.value());
+
+    SeedableLazyNoFrom converted = ModifiableSeedableLazyNoFrom.create()
+        .setValue(7)
+        .toImmutable();
+    assertEquals(7, converted.value());
+  }
+
+  @Test
+  public void modifiableUsesFreshFallbackUntilSeeded() throws Exception {
+    SeedableLazy.FALLBACK_CALLS.set(0);
+    ModifiableSeedableLazy value = ModifiableSeedableLazy.create();
+
+    assertEquals(1, value.number());
+    assertEquals(2, value.number());
+    assertFalse(value.numberIsSet());
+
+    value.setNumber(0);
+    assertTrue(value.numberIsSet());
+    assertEquals(0, value.number());
+
+    value.unsetNumber();
+    assertFalse(value.numberIsSet());
+    assertEquals(3, value.number());
+
+    value.setNumber(4).clear();
+    assertFalse(value.numberIsSet());
+    assertEquals(4, value.number());
+  }
+
+  @Test
+  public void modifiableTransfersSeedsWithoutReadingFallback() throws Exception {
+    SeedableLazy.FALLBACK_CALLS.set(0);
+    ImmutableSeedableLazy unseeded = ImmutableSeedableLazy.builder().build();
+    ImmutableSeedableLazy seeded = ImmutableSeedableLazy.builder().number(5).build();
+
+    ModifiableSeedableLazy destination = ModifiableSeedableLazy.create().setNumber(9);
+    destination.from(unseeded);
+    assertEquals(9, destination.number());
+    destination.from(seeded);
+    assertEquals(5, destination.number());
+    assertEquals(0, SeedableLazy.FALLBACK_CALLS.get());
+
+    ModifiableSeedableLazy modifiableSource = ModifiableSeedableLazy.create().setNumber(6);
+    destination.from(modifiableSource);
+    assertEquals(6, destination.number());
+
+    assertEquals(6, destination.toImmutable().number());
+    ModifiableSeedableLazy fresh = ModifiableSeedableLazy.create();
+    SeedableLazy cold = fresh.toImmutable();
+    assertEquals(0, SeedableLazy.FALLBACK_CALLS.get());
+    assertEquals(1, cold.number());
+  }
+
+  @Test
+  public void withOnlyTypesSupportSeedsAndExternalCopyOf() {
+    SeedableLazyWithOnly.FALLBACK_CALLS.set(0);
+    SeedableLazyWithOnly seeded = ImmutableSeedableLazyWithOnly.of().withValue(0);
+    assertEquals(0, seeded.value());
+    assertEquals(0, SeedableLazyWithOnly.FALLBACK_CALLS.get());
+  }
+
+  @Test
+  public void singletonCanonicalizationKeepsExplicitSeeds() {
+    SeedableLazySingleton.FALLBACK_CALLS.set(0);
+    SeedableLazySingleton seeded = ImmutableSeedableLazySingleton.builder()
+        .value(0)
+        .build();
+
+    assertEquals(0, seeded.value());
+    assertEquals(0, SeedableLazySingleton.FALLBACK_CALLS.get());
+  }
+
+  @Test
+  public void structuralSerializationOmitsSeedableLazyAttributes() throws Exception {
+    SeedableLazyStructural.FALLBACK_CALLS.set(0);
+    ImmutableSeedableLazyStructural seeded = ImmutableSeedableLazyStructural.builder()
+        .value(0)
+        .build();
+
+    SeedableLazyStructural copy = deserialize(serialize(seeded));
+    assertEquals(0, SeedableLazyStructural.FALLBACK_CALLS.get());
+    assertEquals(1, copy.value());
+  }
+
+  @Test
+  public void javaSerializationResetsLazyAndSeedState() throws Exception {
+    SeedableLazy.FALLBACK_CALLS.set(0);
+    ImmutableSeedableLazy seeded = ImmutableSeedableLazy.builder().number(0).build();
+    ImmutableSeedableLazy deserializedSeed = deserialize(serialize(seeded));
+    assertEquals(0, SeedableLazy.FALLBACK_CALLS.get());
+    assertEquals(1, deserializedSeed.number());
+
+    ImmutableSeedableLazy computed = ImmutableSeedableLazy.builder().build();
+    assertEquals(2, computed.number());
+    ImmutableSeedableLazy deserializedComputed = deserialize(serialize(computed));
+    assertEquals(3, deserializedComputed.number());
+
+    ModifiableSeedableLazy modifiable = ModifiableSeedableLazy.create().setNumber(0);
+    ModifiableSeedableLazy deserializedModifiable = deserialize(serialize(modifiable));
+    assertFalse(deserializedModifiable.numberIsSet());
+    assertEquals(4, deserializedModifiable.number());
+  }
+
+  private static byte[] serialize(Serializable value) throws Exception {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    ObjectOutputStream output = new ObjectOutputStream(bytes);
+    output.writeObject(value);
+    output.close();
+    return bytes.toByteArray();
+  }
+
+  @SuppressWarnings("unchecked")
+  private static <T> T deserialize(byte[] bytes) throws Exception {
+    ObjectInputStream input = new ObjectInputStream(new ByteArrayInputStream(bytes));
+    return (T) input.readObject();
+  }
+}
