@@ -0,0 +1,119 @@
+package org.immutables.fixture;
+
+import com.fasterxml.jackson.databind.annotation.JsonDeserialize;
+import java.io.IOException;
+import java.io.Serializable;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.concurrent.atomic.AtomicInteger;
+import javax.annotation.Nullable;
+import org.immutables.gson.Gson;
+import org.immutables.serial.Serial;
+import org.immutables.value.Value;
+
+@Value.Immutable
+@Value.Modifiable
+@Value.Style(toBuilder = "toBuilder")
+@Gson.TypeAdapters
+public abstract class SeedableLazyAttributes implements Serializable {
+  private static final long serialVersionUID = 1L;
+
+  public abstract AtomicInteger counter();
+
+  @Value.Lazy
+  @Value.Default
+  public int number() {
+    return counter().incrementAndGet();
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public boolean flag() {
+    counter().incrementAndGet();
+    return true;
+  }
+
+  @Nullable
+  @Value.Lazy
+  @Value.Default
+  public String nullable() {
+    counter().incrementAndGet();
+    return "fallback";
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public Optional<String> optional() {
+    counter().incrementAndGet();
+    return Optional.of("fallback");
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public int[] array() {
+    counter().incrementAndGet();
+    return new int[] {1};
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public List<String> list() {
+    counter().incrementAndGet();
+    return new ArrayList<>();
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public Map<String, Integer> map() {
+    counter().incrementAndGet();
+    return new LinkedHashMap<>();
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public String checked() throws IOException {
+    counter().incrementAndGet();
+    return "fallback";
+  }
+}
+
+@Serial.Structural
+@Value.Immutable
+abstract class StructuralSeedableLazy implements Serializable {
+  private static final long serialVersionUID = 1L;
+
+  abstract AtomicInteger counter();
+
+  @Value.Lazy
+  @Value.Default
+  int number() {
+    return counter().incrementAndGet();
+  }
+}
+
+@Value.Immutable
+@JsonDeserialize(as = ImmutableJacksonSeedableLazy.class)
+abstract class JacksonSeedableLazy {
+  abstract int base();
+
+  @Value.Lazy
+  @Value.Default
+  int number() {
+    return base() + 1;
+  }
+}
+
+@Value.Immutable
+@Value.Style(from = "")
+abstract class NoFromSeedableLazy {
+  abstract AtomicInteger counter();
+
+  @Value.Lazy
+  @Value.Default
+  int number() {
+    return counter().incrementAndGet();
+  }
+}
diff --git a/value-fixture/test/org/immutables/fixture/SeedableLazyAttributesTest.java b/value-fixture/test/org/immutables/fixture/SeedableLazyAttributesTest.java
new file mode 100644
index 0000000..a80fbd6
--- /dev/null
+++ b/value-fixture/test/org/immutables/fixture/SeedableLazyAttributesTest.java
@@ -0,0 +1,300 @@
+package org.immutables.fixture;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.ObjectInputStream;
+import java.io.ObjectOutputStream;
+import java.io.Serializable;
+import java.util.Collections;
+import java.util.Optional;
+import java.util.concurrent.atomic.AtomicInteger;
+import org.immutables.fixture.marshal.Marshaling;
+import org.junit.jupiter.api.Test;
+import static org.immutables.check.Checkers.check;
+
+public class SeedableLazyAttributesTest {
+  @Test
+  public void builderSeedsAllLegalValuesWithoutInitializingFallbacks() throws Exception {
+    AtomicInteger counter = new AtomicInteger();
+    ImmutableSeedableLazyAttributes value = ImmutableSeedableLazyAttributes.builder()
+        .counter(counter)
+        .number(0)
+        .flag(false)
+        .nullable(null)
+        .optional(Optional.empty())
+        .array()
+        .addAllList(Collections.emptyList())
+        .putAllMap(Collections.emptyMap())
+        .checked("seed")
+        .build();
+
+    check(value.number()).is(0);
+    check(Boolean.valueOf(value.flag())).is(false);
+    check(value.nullable()).isNull();
+    check(value.optional()).is(Optional.empty());
+    check(value.array()).isEmpty();
+    check(value.list()).isEmpty();
+    check(value.map().size()).is(0);
+    check(value.checked()).is("seed");
+    check(counter.get()).is(0);
+  }
+
+  @Test
+  public void withMethodsSeedEvenComputedEqualValuesAndPreserveColdCopies() {
+    AtomicInteger counter = new AtomicInteger();
+    ImmutableSeedableLazyAttributes value = ImmutableSeedableLazyAttributes.builder()
+        .counter(counter)
+        .build();
+
+    check(value.number()).is(1);
+    AtomicInteger seededCopyCounter = new AtomicInteger();
+    ImmutableSeedableLazyAttributes seeded = value.withNumber(1).withCounter(seededCopyCounter);
+    check(seeded.number()).is(1);
+    check(seededCopyCounter.get()).is(0);
+
+    AtomicInteger coldCopyCounter = new AtomicInteger();
+    ImmutableSeedableLazyAttributes cold = value.withCounter(coldCopyCounter);
+    check(coldCopyCounter.get()).is(0);
+    check(cold.number()).is(1);
+    check(coldCopyCounter.get()).is(1);
+  }
+
+  @Test
+  public void buildersPreserveOnlyExplicitSeeds() {
+    AtomicInteger seededCounter = new AtomicInteger();
+    ImmutableSeedableLazyAttributes seeded = ImmutableSeedableLazyAttributes.builder()
+        .counter(seededCounter)
+        .number(7)
+        .build();
+
+    check(seeded.toBuilder().build().number()).is(7);
+    check(ImmutableSeedableLazyAttributes.builder().counter(new AtomicInteger()).from(seeded).build().number()).is(7);
+
+    AtomicInteger coldCounter = new AtomicInteger();
+    ImmutableSeedableLazyAttributes cold = ImmutableSeedableLazyAttributes.builder()
+        .counter(coldCounter)
+        .build();
+    check(cold.number()).is(1);
+
+    ImmutableSeedableLazyAttributes destinationSeed = ImmutableSeedableLazyAttributes.builder()
+        .counter(new AtomicInteger())
+        .number(9)
+        .from(cold)
+        .build();
+    check(destinationSeed.number()).is(9);
+
+    AtomicInteger rebuiltCounter = new AtomicInteger();
+    ImmutableSeedableLazyAttributes rebuilt = cold.toBuilder().counter(rebuiltCounter).build();
+    check(rebuiltCounter.get()).is(0);
+    check(rebuilt.number()).is(1);
+  }
+
+  @Test
+  public void arbitraryImplementationsAreNotRead() {
+    ExternalSeedableLazy external = new ExternalSeedableLazy();
+
+    ImmutableSeedableLazyAttributes from = ImmutableSeedableLazyAttributes.builder()
+        .from(external)
+        .build();
+    check(external.hybridReads).is(0);
+    check(from.number()).is(1);
+
+    ImmutableSeedableLazyAttributes copy = ImmutableSeedableLazyAttributes.copyOf(external);
+    check(external.hybridReads).is(0);
+    check(copy.number()).is(2);
+
+    ModifiableSeedableLazyAttributes modifiable = ModifiableSeedableLazyAttributes.create()
+        .from(external);
+    check(external.hybridReads).is(0);
+    check(modifiable.number()).is(3);
+
+    ExternalNoFrom externalNoFrom = new ExternalNoFrom();
+    ImmutableNoFromSeedableLazy noFromCopy = ImmutableNoFromSeedableLazy.copyOf(externalNoFrom);
+    check(externalNoFrom.hybridReads).is(0);
+    check(noFromCopy.number()).is(1);
+  }
+
+  @Test
+  public void modifiableUsesFreshFallbacksAndTransfersOnlySeeds() {
+    AtomicInteger counter = new AtomicInteger();
+    ModifiableSeedableLazyAttributes modifiable = ModifiableSeedableLazyAttributes.create()
+        .setCounter(counter);
+
+    check(modifiable.number()).is(1);
+    check(modifiable.number()).is(2);
+    modifiable.setNumber(0);
+    check(modifiable.number()).is(0);
+    check(counter.get()).is(2);
+
+    modifiable.unsetNumber();
+    check(modifiable.number()).is(3);
+    modifiable.addAllList(Collections.emptyList());
+    modifiable.putAllMap(Collections.emptyMap());
+    check(modifiable.list()).isEmpty();
+    check(modifiable.map().size()).is(0);
+    check(counter.get()).is(3);
+
+    modifiable.unsetList();
+    check(modifiable.list()).isEmpty();
+    check(counter.get()).is(4);
+    modifiable.unsetMap();
+    check(modifiable.map().size()).is(0);
+    check(counter.get()).is(5);
+
+    modifiable.setNumber(8);
+    check(modifiable.toImmutable().number()).is(8);
+    check(ImmutableSeedableLazyAttributes.copyOf(modifiable).number()).is(8);
+
+    modifiable.clear().setCounter(counter);
+    ImmutableSeedableLazyAttributes cold = modifiable.toImmutable();
+    check(cold.number()).is(6);
+  }
+
+  @Test
+  public void checkedFallbackRemainsLazy() throws Exception {
+    AtomicInteger counter = new AtomicInteger();
+    ImmutableSeedableLazyAttributes value = ImmutableSeedableLazyAttributes.builder()
+        .counter(counter)
+        .build();
+
+    check(value.checked()).is("fallback");
+    check(value.checked()).is("fallback");
+    check(counter.get()).is(1);
+  }
+
+  @Test
+  public void modifiableFromDoesNotClearDestinationSeeds() {
+    ImmutableSeedableLazyAttributes cold = ImmutableSeedableLazyAttributes.builder()
+        .counter(new AtomicInteger())
+        .build();
+    cold.number();
+
+    ModifiableSeedableLazyAttributes destination = ModifiableSeedableLazyAttributes.create()
+        .setCounter(new AtomicInteger())
+        .setNumber(11)
+        .from(cold);
+    check(destination.number()).is(11);
+
+    ImmutableSeedableLazyAttributes seeded = cold.withNumber(12);
+    destination.from(seeded);
+    check(destination.number()).is(12);
+  }
+
+  @Test
+  public void javaSerializationResetsSeededAndComputedState() throws Exception {
+    ImmutableSeedableLazyAttributes seeded = ImmutableSeedableLazyAttributes.builder()
+        .counter(new AtomicInteger())
+        .number(5)
+        .build();
+    ImmutableSeedableLazyAttributes seededRoundTrip = roundTrip(seeded);
+    check(seededRoundTrip.number()).is(1);
+
+    ImmutableSeedableLazyAttributes optionalSeeded = ImmutableSeedableLazyAttributes.builder()
+        .counter(new AtomicInteger())
+        .optional(Optional.of("seed"))
+        .build();
+    ImmutableSeedableLazyAttributes optionalRoundTrip = roundTrip(optionalSeeded);
+    check(optionalRoundTrip.optional()).is(Optional.of("fallback"));
+    check(optionalRoundTrip.counter().get()).is(1);
+
+    ImmutableSeedableLazyAttributes computed = ImmutableSeedableLazyAttributes.builder()
+        .counter(new AtomicInteger())
+        .build();
+    check(computed.number()).is(1);
+    ImmutableSeedableLazyAttributes computedRoundTrip = roundTrip(computed);
+    check(computedRoundTrip.number()).is(2);
+
+    ModifiableSeedableLazyAttributes modifiable = ModifiableSeedableLazyAttributes.create()
+        .setCounter(new AtomicInteger())
+        .setNumber(6)
+        .setOptional(Optional.empty())
+        .addAllList(Collections.emptyList())
+        .putAllMap(Collections.emptyMap());
+    ModifiableSeedableLazyAttributes modifiableRoundTrip = roundTrip(modifiable);
+    check(modifiableRoundTrip.number()).is(1);
+    check(modifiableRoundTrip.optional()).is(Optional.of("fallback"));
+    check(modifiableRoundTrip.list()).isEmpty();
+    check(modifiableRoundTrip.map().size()).is(0);
+    check(modifiableRoundTrip.counter().get()).is(4);
+  }
+
+  @Test
+  public void generatedMarshalingOmitsHybrid() {
+    AtomicInteger counter = new AtomicInteger();
+    ImmutableSeedableLazyAttributes value = ImmutableSeedableLazyAttributes.builder()
+        .counter(counter)
+        .number(5)
+        .build();
+
+    String json = Marshaling.toJson(value);
+    check(json).not().contains("number");
+    check(counter.get()).is(0);
+
+    SeedableLazyAttributes unmarshaled = Marshaling.fromJson(
+        "{counter:0,number:5}", SeedableLazyAttributes.class);
+    check(unmarshaled.number()).is(1);
+  }
+
+  @Test
+  public void generatedJacksonMappingLeavesHybridCold() throws Exception {
+    JacksonSeedableLazy value = new ObjectMapper().readValue(
+        "{\"base\":1}", JacksonSeedableLazy.class);
+
+    check(value.number()).is(2);
+  }
+
+  @Test
+  public void structuralSerializationOmitsSeed() throws Exception {
+    ImmutableStructuralSeedableLazy value = ImmutableStructuralSeedableLazy.builder()
+        .counter(new AtomicInteger())
+        .number(5)
+        .build();
+
+    ImmutableStructuralSeedableLazy roundTrip = roundTrip(value);
+    check(roundTrip.number()).is(1);
+  }
+
+  private static final class ExternalSeedableLazy extends SeedableLazyAttributes {
+    private final AtomicInteger counter = new AtomicInteger();
+    int hybridReads;
+
+    @Override
+    public AtomicInteger counter() {
+      return counter;
+    }
+
+    @Override
+    public int number() {
+      hybridReads++;
+      throw new AssertionError("hybrid getter must not be read");
+    }
+  }
+
+  private static final class ExternalNoFrom extends NoFromSeedableLazy {
+    private final AtomicInteger counter = new AtomicInteger();
+    int hybridReads;
+
+    @Override
+    AtomicInteger counter() {
+      return counter;
+    }
+
+    @Override
+    int number() {
+      hybridReads++;
+      throw new AssertionError("hybrid getter must not be read");
+    }
+  }
+
+  @SuppressWarnings("unchecked")
+  private static <T extends Serializable> T roundTrip(T value) throws Exception {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    try (ObjectOutputStream out = new ObjectOutputStream(bytes)) {
+      out.writeObject(value);
+    }
+    try (ObjectInputStream in = new ObjectInputStream(new ByteArrayInputStream(bytes.toByteArray()))) {
+      return (T) in.readObject();
+    }
+  }
+}
