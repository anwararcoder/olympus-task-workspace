+#!/bin/bash
+set -uo pipefail
+
+INVOKE_DIR="$PWD"
+cd "$(dirname "$0")"
+
+OUTPUT_PATH=""
+MODE=""
+
+while [[ $# -gt 0 ]]; do
+    case "$1" in
+        --output_path)
+            OUTPUT_PATH="$2"
+            shift 2
+            ;;
+        base|new)
+            MODE="$1"
+            shift
+            ;;
+        *)
+            echo "Usage: $0 --output_path <path> {base|new}"
+            exit 1
+            ;;
+    esac
+done
+
+if [[ -n "$OUTPUT_PATH" && "$OUTPUT_PATH" != /* ]]; then
+    OUTPUT_PATH="$INVOKE_DIR/$OUTPUT_PATH"
+fi
+
+if [[ -z "$MODE" ]]; then
+    echo "Usage: $0 --output_path <path> {base|new}"
+    exit 1
+fi
+
+FOCUS_TEST="SeedableLazy_6c7a1b_Test"
+FOCUS_CLASS="org.immutables.fixture.seedlazy_4f2c9d.SeedableLazy_6c7a1b_Test"
+SOURCE_DIR="value-fixture/seedlazy-tests/org/immutables/fixture/seedlazy_4f2c9d"
+STAGED_DIR="value-fixture/test/org/immutables/fixture/seedlazy_4f2c9d"
+NEGATIVE_DIR="value-fixture/seedlazy-negative/seedlazy_negative"
+REPORTS="value-fixture/target/surefire-reports"
+TMP="${TMPDIR:-/tmp}/immutables-seedable-lazy-mvn-tmp"
+NEGATIVE_LOG="$TMP/negative-compilation.log"
+NEGATIVE_CLASSES="$TMP/negative-classes"
+mkdir -p "$TMP"
+export MAVEN_OPTS="-Xmx950m -XX:MaxMetaspaceSize=384m -Djava.io.tmpdir=$TMP"
+MVN="mvn -B -ntp -o -DforkCount=1 -DreuseForks=true -DfailIfNoTests=false"
+LOG="$TMP/maven-$MODE.log"
+NEGATIVE_FAILURE=0
+
+cleanup() {
+    rm -rf "$STAGED_DIR"
+}
+trap cleanup EXIT
+
+xml_escape() {
+    sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
+}
+
+run_mvn() {
+    $MVN "$@" 2>&1 | tee "$LOG"
+    return "${PIPESTATUS[0]}"
+}
+
+write_xml() {
+    local fallback="${1:-0}"
+    [[ -z "$OUTPUT_PATH" ]] && return 0
+    : > "$OUTPUT_PATH"
+    echo '<testsuites>' >> "$OUTPUT_PATH"
+    FOUND=0
+    for xml in "$REPORTS"/TEST-*.xml; do
+        if [[ -e "$xml" ]]; then
+            FOUND=1
+            grep -v '<?xml' "$xml" >> "$OUTPUT_PATH"
+        fi
+    done
+    if [[ "$FOUND" -eq 0 && "$fallback" -ne 0 ]]; then
+        case "$MODE" in
+            base)
