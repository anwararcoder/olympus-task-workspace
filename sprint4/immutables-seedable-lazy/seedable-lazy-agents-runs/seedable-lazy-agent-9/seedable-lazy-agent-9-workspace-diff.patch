+  private static final class ExternalSeedableLazy extends SeedableLazyAttributes {
+    private final AtomicInteger counter = new AtomicInteger();
+    int hybridReads;
+
+    @Override
+    public AtomicInteger counter() {
+      return counter;
+    }
+
+    @Override
+    public int number() {
+      hybridReads++;
+      throw new AssertionError("hybrid getter must not be read");
+    }
+  }
+
+  private static final class ExternalNoFrom extends NoFromSeedableLazy {
+    private final AtomicInteger counter = new AtomicInteger();
+    int hybridReads;
+
+    @Override
+    AtomicInteger counter() {
+      return counter;
+    }
+
+    @Override
+    int number() {
+      hybridReads++;
+      throw new AssertionError("hybrid getter must not be read");
+    }
+  }
+
+  @SuppressWarnings("unchecked")
+  private static <T extends Serializable> T roundTrip(T value) throws Exception {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    try (ObjectOutputStream out = new ObjectOutputStream(bytes)) {
+      out.writeObject(value);
+    }
+    try (ObjectInputStream in = new ObjectInputStream(new ByteArrayInputStream(bytes.toByteArray()))) {
+      return (T) in.readObject();
+    }
+  }
