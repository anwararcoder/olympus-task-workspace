+  @Test
+  public void structuralSerializationOmitsSeed() throws Exception {
+    ImmutableStructuralSeedableLazy value = ImmutableStructuralSeedableLazy.builder()
+        .counter(new AtomicInteger())
+        .number(5)
+        .build();
+
+    ImmutableStructuralSeedableLazy roundTrip = roundTrip(value);
+    check(roundTrip.number()).is(1);
+  }
