+            ! -name '*-javadoc.jar' ! -name '*-tests.jar' | sort
+    )
+    if [[ "${#processor_jars[@]}" -ne 1 ]]; then
+        echo "Expected exactly one built value processor JAR, found ${#processor_jars[@]}" >> "$NEGATIVE_LOG"
+        return 1
+    fi
+    processor_jar="${processor_jars[0]}"
+    local source
