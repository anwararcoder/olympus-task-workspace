+          start.await();
+          return value.scalar();
+        });
+      }
+      assertTrue(ready.await(30, TimeUnit.SECONDS));
+      start.countDown();
+      fallback = (Integer) futures[0].get(30, TimeUnit.SECONDS);
+      for (Future<?> future : futures) {
+        check((Integer) future.get(30, TimeUnit.SECONDS)).is(fallback);
+      }
+    } finally {
