+  @Test
+  public void javaSerializationResetsSeededAndComputedState() throws Exception {
+    ImmutableSeedableLazyAttributes seeded = ImmutableSeedableLazyAttributes.builder()
+        .counter(new AtomicInteger())
+        .number(5)
+        .build();
+    ImmutableSeedableLazyAttributes seededRoundTrip = roundTrip(seeded);
+    check(seededRoundTrip.number()).is(1);
+
+    ImmutableSeedableLazyAttributes optionalSeeded = ImmutableSeedableLazyAttributes.builder()
+        .counter(new AtomicInteger())
+        .optional(Optional.of("seed"))
+        .build();
+    ImmutableSeedableLazyAttributes optionalRoundTrip = roundTrip(optionalSeeded);
+    check(optionalRoundTrip.optional()).is(Optional.of("fallback"));
+    check(optionalRoundTrip.counter().get()).is(1);
+
+    ImmutableSeedableLazyAttributes computed = ImmutableSeedableLazyAttributes.builder()
+        .counter(new AtomicInteger())
+        .build();
+    check(computed.number()).is(1);
+    ImmutableSeedableLazyAttributes computedRoundTrip = roundTrip(computed);
+    check(computedRoundTrip.number()).is(2);
+
+    ModifiableSeedableLazyAttributes modifiable = ModifiableSeedableLazyAttributes.create()
+        .setCounter(new AtomicInteger())
+        .setNumber(6)
+        .setOptional(Optional.empty())
+        .addAllList(Collections.emptyList())
+        .putAllMap(Collections.emptyMap());
+    ModifiableSeedableLazyAttributes modifiableRoundTrip = roundTrip(modifiable);
+    check(modifiableRoundTrip.number()).is(1);
+    check(modifiableRoundTrip.optional()).is(Optional.of("fallback"));
+    check(modifiableRoundTrip.list()).isEmpty();
+    check(modifiableRoundTrip.map().size()).is(0);
+    check(modifiableRoundTrip.counter().get()).is(4);
+  }
