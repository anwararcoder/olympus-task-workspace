+    String json = Marshaling.toJson(value);
+    check(json).not().contains("number");
+    check(counter.get()).is(0);
+
+    SeedableLazyAttributes unmarshaled = Marshaling.fromJson(
+        "{counter:0,number:5}", SeedableLazyAttributes.class);
+    check(unmarshaled.number()).is(1);
+  }
