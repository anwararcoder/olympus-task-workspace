+package org.immutables.value.processor.meta;
+
+import com.Capella.testing.compile.Compilation;
+import com.Capella.testing.compile.Compiler;
+import com.Capella.testing.compile.JavaFileObjects;
+import javax.tools.JavaFileObject;
+import org.immutables.value.processor.Processor;
+import org.junit.Test;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertTrue;
+
+public class SeedableLazyDiagnosticsTest {
+  @Test
+  public void rejectsInternedTypes() {
+    assertRejected("intern = true");
+  }
+
+  @Test
+  public void rejectsTypesWithoutBuilders() {
+    assertRejected("builder = false");
+  }
+
+  @Test
+  public void rejectsTypesWithoutWithMethods() {
+    assertRejected("copy = false");
+  }
+
+  private static void assertRejected(String immutableOptions) {
+    JavaFileObject source = JavaFileObjects.forSourceLines(
+        "test.RejectedSeedableLazy",
+        "package test;",
+        "import org.immutables.value.Value;",
+        "@Value.Immutable(" + immutableOptions + ")",
+        "abstract class RejectedSeedableLazy {",
+        "  @Value.Lazy",
+        "  @Value.Default",
+        "  int value() {",
+        "    return 1;",
+        "  }",
+        "}");
+
+    Compilation compilation = Compiler.javac()
+        .withProcessors(new Processor())
+        .compile(source);
+
+    assertEquals(Compilation.Status.FAILURE, compilation.status());
+    String diagnostics = compilation.diagnostics().toString();
+    assertTrue(diagnostics, diagnostics.contains("@Value.Lazy"));
+    assertTrue(diagnostics, diagnostics.contains("@Value.Default"));
+  }
+}
