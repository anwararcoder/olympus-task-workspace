diff --git a/value-fixture/test/org/immutables/fixture/SeedableLazyTest.java b/value-fixture/test/org/immutables/fixture/SeedableLazyTest.java
new file mode 100644
index 0000000..3f0a345
--- /dev/null
+++ b/value-fixture/test/org/immutables/fixture/SeedableLazyTest.java
@@ -0,0 +1,177 @@
+package org.immutables.fixture;
+
+import static org.immutables.check.Checkers.check;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.ObjectInputStream;
+import java.io.ObjectOutputStream;
+import java.util.Collections;
+import java.util.Optional;
+import java.util.concurrent.atomic.AtomicInteger;
+import org.junit.jupiter.api.Test;
+
+public class SeedableLazyTest {
+  @Test
+  public void builderSeedsFalsyAndEmptyValuesWithoutComputingFallbacks() throws Exception {
+    AtomicInteger counter = new AtomicInteger();
+    ImmutableSeedableLazy value = ImmutableSeedableLazy.builder()
+        .counter(counter)
+        .name("seeded")
+        .number(0)
+        .flag(false)
+        .nullable(null)
+        .optional(Optional.empty())
+        .array(new String[0])
+        .addAllItems(Collections.<String>emptyList())
+        .putAllLabels(Collections.<String, String>emptyMap())
+        .checked("seeded checked")
+        .build();
+
+    check(counter.get()).is(0);
+    check(value.number()).is(0);
+    check(Boolean.valueOf(value.flag())).is(false);
+    check(value.nullable()).isNull();
+    check(value.optional()).is(Optional.empty());
+    check(value.array().length).is(0);
+    check(value.items()).isEmpty();
+    check(value.labels().size()).is(0);
+    check(value.checked()).is("seeded checked");
+    check(counter.get()).is(0);
+  }
+
+  @Test
+  public void copiesPreserveOnlyExplicitSeeds() {
+    AtomicInteger counter = new AtomicInteger();
+    ImmutableSeedableLazy unseeded = ImmutableSeedableLazy.builder()
+        .counter(counter)
+        .name("a")
+        .build();
+
+    ImmutableSeedableLazy coldCopy = unseeded.withName("b");
+    check(counter.get()).is(0);
+    check(coldCopy.number()).is(1);
+
+    check(unseeded.number()).is(2);
+    ImmutableSeedableLazy computedCopy = unseeded.withName("c");
+    check(computedCopy.number()).is(3);
+
+    ImmutableSeedableLazy explicitlyEqual = unseeded.withNumber(2);
+    ImmutableSeedableLazy seededCopy = explicitlyEqual.withName("d");
+    check(seededCopy.number()).is(2);
+    check(counter.get()).is(3);
+  }
+
+  @Test
+  public void builderCopyPathsDoNotReadExternalOrUnseededGetters() {
+    AtomicInteger counter = new AtomicInteger();
+    ImmutableSeedableLazy source = ImmutableSeedableLazy.builder()
+        .counter(counter)
+        .name("source")
+        .build();
+
+    ImmutableSeedableLazy copied = ImmutableSeedableLazy.builder().from(source).name("copy").build();
+    check(counter.get()).is(0);
+    check(copied.number()).is(1);
+
+    ImmutableSeedableLazy retainedSeed = ImmutableSeedableLazy.builder()
+        .number(9)
+        .from(source)
+        .name("retained")
+        .build();
+    check(retainedSeed.number()).is(9);
+
+    SeedableLazy external = new SeedableLazy() {
+      @Override public AtomicInteger counter() { return counter; }
+      @Override public String name() { return "external"; }
+      @Override public int number() { throw new AssertionError("must not read hybrid getter"); }
+    };
+    ImmutableSeedableLazy externalCopy = ImmutableSeedableLazy.copyOf(external);
+    check(externalCopy.number()).is(2);
+  }
+
+  @Test
+  public void toBuilderPreservesOnlyExplicitSeeds() {
+    AtomicInteger counter = new AtomicInteger();
+    ImmutableSeedableLazy unseeded = ImmutableSeedableLazy.builder()
+        .counter(counter)
+        .name("unseeded")
+        .build();
+    ImmutableSeedableLazy coldCopy = unseeded.toBuilder().name("cold copy").build();
+    check(counter.get()).is(0);
+    check(coldCopy.number()).is(1);
+
+    ImmutableSeedableLazy seeded = unseeded.withNumber(0);
+    check(seeded.toBuilder().name("seeded copy").build().number()).is(0);
+    check(counter.get()).is(1);
+  }
+
+  @Test
+  public void modifiableFallbacksStayUnsetAndFresh() {
+    AtomicInteger counter = new AtomicInteger();
+    ModifiableSeedableLazy modifiable = ModifiableSeedableLazy.create()
+        .setCounter(counter)
+        .setName("modifiable");
+
+    check(modifiable.number()).is(1);
+    check(modifiable.number()).is(2);
+    check(Boolean.valueOf(modifiable.numberIsSet())).is(false);
+
+    modifiable.setNumber(0);
+    check(Boolean.valueOf(modifiable.numberIsSet())).is(true);
+    check(modifiable.number()).is(0);
+    modifiable.unsetNumber();
+    check(Boolean.valueOf(modifiable.numberIsSet())).is(false);
+    check(modifiable.number()).is(3);
+
+    ImmutableSeedableLazy unseeded = modifiable.toImmutable();
+    check(unseeded.number()).is(4);
+    modifiable.setNumber(7);
+    check(modifiable.toImmutable().number()).is(7);
+  }
+
+  @Test
+  public void copyOfPreservesGeneratedSeedsWhenBuilderFromIsDisabled() {
+    AtomicInteger counter = new AtomicInteger();
+    ModifiableSeedableLazyNoFrom modifiable = ModifiableSeedableLazyNoFrom.create()
+        .setCounter(counter)
+        .setNumber(0);
+
+    check(modifiable.toImmutable().number()).is(0);
+    check(counter.get()).is(0);
+
+    SeedableLazyNoFrom external = new SeedableLazyNoFrom() {
+      @Override public AtomicInteger counter() { return counter; }
+      @Override public int number() { throw new AssertionError("must not read hybrid getter"); }
+    };
+    check(ImmutableSeedableLazyNoFrom.copyOf(external).number()).is(1);
+  }
+
+  @Test
+  public void javaSerializationResetsSeedAndComputedState() throws Exception {
+    AtomicInteger counter = new AtomicInteger();
+    ImmutableSeedableLazy value = ImmutableSeedableLazy.builder()
+        .counter(counter)
+        .name("serialized")
+        .number(0)
+        .build();
+
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    new ObjectOutputStream(bytes).writeObject(value);
+    ImmutableSeedableLazy restored = (ImmutableSeedableLazy) new ObjectInputStream(
+        new ByteArrayInputStream(bytes.toByteArray())).readObject();
+
+    check(restored.number()).is(1);
+
+    ModifiableSeedableLazy modifiable = ModifiableSeedableLazy.create()
+        .setCounter(new AtomicInteger())
+        .setName("serialized modifiable")
+        .setNumber(0);
+    bytes.reset();
+    new ObjectOutputStream(bytes).writeObject(modifiable);
+    ModifiableSeedableLazy restoredModifiable = (ModifiableSeedableLazy) new ObjectInputStream(
+        new ByteArrayInputStream(bytes.toByteArray())).readObject();
+    check(Boolean.valueOf(restoredModifiable.numberIsSet())).is(false);
+    check(restoredModifiable.number()).is(1);
+  }
+}
