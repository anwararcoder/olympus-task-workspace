@@ -0,0 +1,77 @@
+package org.immutables.fixture;
+
+import java.io.IOException;
+import java.io.Serializable;
+import java.util.Collections;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.concurrent.atomic.AtomicInteger;
+import javax.annotation.Nullable;
+import org.immutables.value.Value;
+
+@Value.Immutable
+@Value.Modifiable
+@Value.Style(toBuilder = "toBuilder")
+public abstract class SeedableLazy implements Serializable {
+  private static final long serialVersionUID = 1L;
+
+  public abstract AtomicInteger counter();
+
+  public abstract String name();
+
+  @Value.Lazy
+  @Value.Default
+  public int number() {
+    return counter().incrementAndGet();
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public boolean flag() {
+    counter().incrementAndGet();
+    return true;
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public @Nullable String nullable() {
+    counter().incrementAndGet();
+    return "fallback";
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public Optional<String> optional() {
+    counter().incrementAndGet();
+    return Optional.of("fallback");
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public String[] array() {
+    counter().incrementAndGet();
+    return new String[] {"fallback"};
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public List<String> items() {
+    counter().incrementAndGet();
+    return Collections.singletonList("fallback");
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public Map<String, String> labels() {
+    counter().incrementAndGet();
+    return Collections.singletonMap("fallback", "value");
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public String checked() throws IOException {
+    counter().incrementAndGet();
+    return "checked";
+  }
+}
