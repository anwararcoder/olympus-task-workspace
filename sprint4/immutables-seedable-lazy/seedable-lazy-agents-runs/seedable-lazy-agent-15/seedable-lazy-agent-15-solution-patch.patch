diff --git a/value-fixture/src/org/immutables/fixture/SeedableLazy.java b/value-fixture/src/org/immutables/fixture/SeedableLazy.java
new file mode 100644
index 0000000..f77ae8a
--- /dev/null
+++ b/value-fixture/src/org/immutables/fixture/SeedableLazy.java
@@ -0,0 +1,110 @@
+package org.immutables.fixture;
+
+import java.io.IOException;
+import java.io.Serializable;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.concurrent.atomic.AtomicInteger;
+import javax.annotation.Nullable;
+import org.immutables.serial.Serial;
+import org.immutables.value.Value;
+
+@Value.Immutable
+@Value.Modifiable
+@Value.Style(toBuilder = "toBuilder")
+public abstract class SeedableLazy implements Serializable {
+  private static final long serialVersionUID = 1L;
+
+  public abstract int id();
+
+  public abstract AtomicInteger counter();
+
+  @Value.Lazy
+  @Value.Default
+  public int number() {
+    counter().incrementAndGet();
+    return 7;
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public boolean flag() {
+    counter().incrementAndGet();
+    return true;
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public Optional<String> optional() {
+    counter().incrementAndGet();
+    return Optional.of("fallback");
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public int[] array() {
+    counter().incrementAndGet();
+    return new int[] {7};
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public List<String> items() {
+    counter().incrementAndGet();
+    return new ArrayList<>(Collections.singletonList("fallback"));
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public Map<String, Integer> entries() {
+    counter().incrementAndGet();
+    return Collections.singletonMap("fallback", 7);
+  }
+
+  @Nullable
+  @Value.Lazy
+  @Value.Default
+  public String nullable() {
+    counter().incrementAndGet();
+    return "fallback";
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public String checked() throws IOException {
+    counter().incrementAndGet();
+    return "fallback";
+  }
+
+  @Value.Immutable
+  @Value.Modifiable
+  @Value.Style(from = "")
+  public abstract static class NoFrom {
+    public abstract AtomicInteger counter();
+
+    @Value.Lazy
+    @Value.Default
+    public int number() {
+      counter().incrementAndGet();
+      return 7;
+    }
+  }
+
+  @Value.Immutable
+  @Serial.Structural
+  public abstract static class Structural implements Serializable {
+    private static final long serialVersionUID = 1L;
+
+    public abstract AtomicInteger counter();
+
+    @Value.Lazy
+    @Value.Default
+    public int number() {
+      counter().incrementAndGet();
+      return 7;
+    }
+  }
+}
diff --git a/value-fixture/test/org/immutables/fixture/SeedableLazyTest.java b/value-fixture/test/org/immutables/fixture/SeedableLazyTest.java
new file mode 100644
index 0000000..340e45a
--- /dev/null
+++ b/value-fixture/test/org/immutables/fixture/SeedableLazyTest.java
@@ -0,0 +1,216 @@
+package org.immutables.fixture;
+
+import static org.immutables.check.Checkers.check;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.ObjectInputStream;
+import java.io.ObjectOutputStream;
+import java.util.Collections;
+import java.util.Optional;
+import java.util.concurrent.atomic.AtomicInteger;
+import org.junit.jupiter.api.Test;
+
+public class SeedableLazyTest {
+  @Test
+  public void builderSeedsAllLegalEmptyValuesWithoutInitializingFallbacks() throws Exception {
+    AtomicInteger counter = new AtomicInteger();
+    ImmutableSeedableLazy value = ImmutableSeedableLazy.builder()
+        .id(1)
+        .counter(counter)
+        .number(0)
+        .flag(false)
+        .optional(Optional.empty())
+        .array()
+        .addAllItems(Collections.emptyList())
+        .putAllEntries(Collections.emptyMap())
+        .nullable(null)
+        .checked("seed")
+        .build();
+
+    check(counter.get()).is(0);
+    check(value.number()).is(0);
+    check(Boolean.valueOf(value.flag())).is(false);
+    check(value.optional()).is(Optional.empty());
+    check(value.array().length).is(0);
+    check(value.items()).isEmpty();
+    check(value.entries().size()).is(0);
+    check(value.nullable()).isNull();
+    check(value.checked()).is("seed");
+    check(counter.get()).is(0);
+  }
+
+  @Test
+  public void computedFallbackStaysColdInCopiesWhileSeedsArePreserved() {
+    AtomicInteger counter = new AtomicInteger();
+    ImmutableSeedableLazy unseeded = ImmutableSeedableLazy.builder()
+        .id(1)
+        .counter(counter)
+        .build();
+
+    check(unseeded.number()).is(7);
+    check(counter.get()).is(1);
+
+    ImmutableSeedableLazy copiedFallback = unseeded.withId(2);
+    check(counter.get()).is(1);
+    check(copiedFallback.number()).is(7);
+    check(counter.get()).is(2);
+
+    ImmutableSeedableLazy seeded = unseeded.withNumber(7);
+    check(counter.get()).is(2);
+    check(seeded.number()).is(7);
+    check(counter.get()).is(2);
+
+    ImmutableSeedableLazy copiedSeed = seeded.withId(3);
+    check(copiedSeed.number()).is(7);
+    check(counter.get()).is(2);
+
+    ImmutableSeedableLazy replacedCollection = unseeded
+        .withItems(Collections.singletonList("old"))
+        .withItems(Collections.singletonList("new"));
+    check(replacedCollection.items()).isOf("new");
+  }
+
+  @Test
+  public void generatedBuilderCopyPathsPreserveOnlyExplicitSeeds() {
+    AtomicInteger counter = new AtomicInteger();
+    ImmutableSeedableLazy unseeded = ImmutableSeedableLazy.builder()
+        .id(1)
+        .counter(counter)
+        .build();
+    ImmutableSeedableLazy seeded = unseeded.withNumber(9);
+
+    check(seeded.toBuilder().id(2).build().number()).is(9);
+    check(ImmutableSeedableLazy.builder().from(seeded).build().number()).is(9);
+
+    ImmutableSeedableLazy retainedDestinationSeed = ImmutableSeedableLazy.builder()
+        .number(11)
+        .from(unseeded)
+        .build();
+    check(retainedDestinationSeed.number()).is(11);
+    check(counter.get()).is(0);
+  }
+
+  @Test
+  public void externalImplementationsAreNotReadForHybridAttributes() {
+    AtomicInteger counter = new AtomicInteger();
+    SeedableLazy external = new SeedableLazy() {
+      @Override public int id() { return 1; }
+      @Override public AtomicInteger counter() { return counter; }
+      @Override public int number() { throw new AssertionError(); }
+    };
+
+    ImmutableSeedableLazy copied = ImmutableSeedableLazy.copyOf(external);
+    check(counter.get()).is(0);
+    check(copied.number()).is(7);
+    check(counter.get()).is(1);
+
+    ImmutableSeedableLazy built = ImmutableSeedableLazy.builder().from(external).build();
+    check(counter.get()).is(1);
+    check(built.number()).is(7);
+    check(counter.get()).is(2);
+  }
+
+  @Test
+  public void disabledBuilderFromStillSupportsGeneratedAndExternalCopies() {
+    AtomicInteger counter = new AtomicInteger();
+    ModifiableNoFrom modifiable = ModifiableNoFrom.create()
+        .setCounter(counter)
+        .setNumber(0);
+
+    check(ImmutableNoFrom.copyOf(modifiable).number()).is(0);
+    check(counter.get()).is(0);
+
+    SeedableLazy.NoFrom external = new SeedableLazy.NoFrom() {
+      @Override public AtomicInteger counter() { return counter; }
+      @Override public int number() { throw new AssertionError(); }
+    };
+    ImmutableNoFrom copied = ImmutableNoFrom.copyOf(external);
+    check(copied.number()).is(7);
+    check(counter.get()).is(1);
+  }
+
+  @Test
+  public void modifiableFallbacksStayFreshAndUnsetRemovesSeeds() {
+    AtomicInteger counter = new AtomicInteger();
+    ModifiableSeedableLazy modifiable = ModifiableSeedableLazy.create()
+        .setId(1)
+        .setCounter(counter);
+
+    check(modifiable.items()).not().same(modifiable.items());
+    check(counter.get()).is(2);
+    check(Boolean.valueOf(modifiable.itemsIsSet())).is(false);
+
+    modifiable.addAllItems(Collections.emptyList());
+    check(Boolean.valueOf(modifiable.itemsIsSet())).is(true);
+    check(modifiable.items()).isEmpty();
+    check(counter.get()).is(2);
+
+    modifiable.unsetItems();
+    check(Boolean.valueOf(modifiable.itemsIsSet())).is(false);
+    check(modifiable.items()).isOf("fallback");
+    check(counter.get()).is(3);
+
+    modifiable.setNumber(0);
+    check(modifiable.toImmutable().number()).is(0);
+
+    ModifiableSeedableLazy copiedSeed = ModifiableSeedableLazy.create().from(
+        ImmutableSeedableLazy.builder().id(2).counter(counter).number(9).build());
+    check(copiedSeed.number()).is(9);
+
+    ModifiableSeedableLazy retainedSeed = ModifiableSeedableLazy.create()
+        .setNumber(11)
+        .from(ModifiableSeedableLazy.create().setId(3).setCounter(counter));
+    check(retainedSeed.number()).is(11);
+
+    modifiable.clear();
+    check(Boolean.valueOf(modifiable.numberIsSet())).is(false);
+  }
+
+  @Test
+  public void javaAndStructuralSerializationResetLazyState() throws Exception {
+    AtomicInteger counter = new AtomicInteger();
+    ImmutableSeedableLazy seeded = ImmutableSeedableLazy.builder()
+        .id(1)
+        .counter(counter)
+        .number(0)
+        .build();
+
+    ImmutableSeedableLazy restoredSeed = roundTrip(seeded);
+    check(restoredSeed.counter().get()).is(0);
+    check(restoredSeed.number()).is(7);
+    check(restoredSeed.counter().get()).is(1);
+
+    ImmutableSeedableLazy computed = ImmutableSeedableLazy.builder()
+        .id(2)
+        .counter(new AtomicInteger())
+        .build();
+    check(computed.number()).is(7);
+    ImmutableSeedableLazy restoredComputed = roundTrip(computed);
+    check(restoredComputed.counter().get()).is(1);
+    check(restoredComputed.number()).is(7);
+    check(restoredComputed.counter().get()).is(2);
+
+    ImmutableStructural structural = ImmutableStructural.builder()
+        .counter(new AtomicInteger())
+        .number(0)
+        .build();
+    ImmutableStructural restoredStructural = roundTrip(structural);
+    check(restoredStructural.counter().get()).is(0);
+    check(restoredStructural.number()).is(7);
+    check(restoredStructural.counter().get()).is(1);
+  }
+
+  @SuppressWarnings("unchecked")
+  private static <T> T roundTrip(T value) throws IOException, ClassNotFoundException {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    try (ObjectOutputStream output = new ObjectOutputStream(bytes)) {
+      output.writeObject(value);
+    }
+    try (ObjectInputStream input = new ObjectInputStream(
+        new ByteArrayInputStream(bytes.toByteArray()))) {
+      return (T) input.readObject();
+    }
+  }
+}
