+  @Value.Default
+  public Map<String, Integer> entries() {
+    counter().incrementAndGet();
+    return Collections.singletonMap("fallback", 7);
+  }
+
+  @Nullable
+  @Value.Lazy
+  @Value.Default
+  public String nullable() {
+    counter().incrementAndGet();
+    return "fallback";
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public String checked() throws IOException {
+    counter().incrementAndGet();
+    return "fallback";
+  }
+
+  @Value.Immutable
+  @Value.Modifiable
+  @Value.Style(from = "")
+  public abstract static class NoFrom {
+    public abstract AtomicInteger counter();
+
+    @Value.Lazy
+    @Value.Default
+    public int number() {
+      counter().incrementAndGet();
+      return 7;
+    }
+  }
