+  @Test
+  public void modifiableMapMutatorsEstablishSeedsEvenForEmptyInput() {
+    AtomicInteger calls = new AtomicInteger();
+    ModifiableSeedableLazyModifiableModel empty =
+        ModifiableSeedableLazyModifiableModel.create()
+            .setInput(1)
+            .setScalarCalls(calls)
+            .setCheckedCalls(new AtomicInteger())
+            .putAllIndex(Collections.emptyMap());
+    assertTrue(empty.indexIsSet());
+    check(empty.index()).is(Collections.emptyMap());
+    check(calls.get()).is(0);
+
+    ModifiableSeedableLazyModifiableModel singleton =
+        ModifiableSeedableLazyModifiableModel.create()
+            .setInput(2)
+            .setScalarCalls(calls)
+            .setCheckedCalls(new AtomicInteger())
+            .putIndex("seed", 7);
+    assertTrue(singleton.indexIsSet());
+    check(singleton.index()).is(Collections.singletonMap("seed", 7));
+    check(calls.get()).is(0);
+  }
+
+  @Test
+  public void seedProvenanceCrossesBitmapWordBoundary() {
+    AtomicInteger calls = new AtomicInteger();
+    ImmutableSeedableLazyBitmapBoundaryModel source =
+        ImmutableSeedableLazyBitmapBoundaryModel.builder()
+            .input(1)
+            .calls(calls)
+            .value64(6400)
+            .build();
+    check(source.value64()).is(6400);
+    check(calls.get()).is(0);
+
+    ImmutableSeedableLazyBitmapBoundaryModel copied =
+        source.toBuilder().input(2).build();
+    check(copied.value64()).is(6400);
+    check(calls.get()).is(0);
+  }
