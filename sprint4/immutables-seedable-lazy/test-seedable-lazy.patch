+
+public class SeedableLazy_6c7a1b_Test {
+  private static ImmutableSeedableLazyModel.Builder builder(
+      int input,
+      AtomicInteger scalarCalls,
+      AtomicInteger checkedCalls,
+      AtomicInteger errorCalls,
+      AtomicInteger otherCalls) {
+    return ImmutableSeedableLazyModel.builder()
+        .input(input)
+        .scalarCalls(scalarCalls)
+        .checkedCalls(checkedCalls)
+        .errorCalls(errorCalls)
+        .otherCalls(otherCalls);
+  }
+
+  private static ImmutableSeedableLazyModel.Builder builder(
+      int input,
+      AtomicInteger scalarCalls) {
+    return builder(
+        input,
+        scalarCalls,
+        new AtomicInteger(),
+        new AtomicInteger(),
+        new AtomicInteger());
+  }
+
+  @Test
+  public void omittedSeedIsColdAndSuccessfulFallbackIsConcurrentAndMemoized()
+      throws Exception {
+    AtomicInteger calls = new AtomicInteger();
+    final ImmutableSeedableLazyModel value = builder(7, calls).build();
+    check(calls.get()).is(0);
+
+    int workers = 16;
+    ExecutorService executor = Executors.newFixedThreadPool(workers);
+    CountDownLatch ready = new CountDownLatch(workers);
+    CountDownLatch start = new CountDownLatch(1);
+    Future<?>[] futures = new Future<?>[workers];
+    int fallback;
+    try {
+      for (int i = 0; i < workers; i++) {
+        futures[i] = executor.submit(() -> {
+          ready.countDown();
+          start.await();
+          return value.scalar();
+        });
+      }
+      assertTrue(ready.await(30, TimeUnit.SECONDS));
+      start.countDown();
+      fallback = (Integer) futures[0].get(30, TimeUnit.SECONDS);
+      for (Future<?> future : futures) {
+        check((Integer) future.get(30, TimeUnit.SECONDS)).is(fallback);
+      }
+    } finally {
+      executor.shutdownNow();
+    }
+
+    check(value.scalar()).is(fallback);
+    check(calls.get()).is(1);
+  }
+
+  @Test
+  public void specializedOptionalInitializerRunsOnceAndMemoizes() {
+    AtomicInteger calls = new AtomicInteger();
+    ImmutableSeedableLazySpecializedOptionalModel value =
+        ImmutableSeedableLazySpecializedOptionalModel.builder().calls(calls).build();
+    check(calls.get()).is(0);
+
+    OptionalInt fallback = value.number();
+    assertTrue(fallback.isPresent());
+    check(calls.get()).is(1);
+    check(value.number()).is(fallback);
+    check(calls.get()).is(1);
+  }
+
+  @Test
+  public void falseyNullableAndEmptySeedsBypassEveryFallbackAndClearRestoresCold()
+      throws Exception {
+    AtomicInteger scalarCalls = new AtomicInteger();
+    AtomicInteger checkedCalls = new AtomicInteger();
+    AtomicInteger errorCalls = new AtomicInteger();
+    AtomicInteger otherCalls = new AtomicInteger();
+    ImmutableSeedableLazyModel.Builder source = builder(
+        1, scalarCalls, checkedCalls, errorCalls, otherCalls)
+        .scalar(0)
+        .enabled(false)
+        .nullable(null)
+        .optional(Optional.empty())
+        .addAllTags(Collections.emptyList())
+        .putAllIndex(Collections.emptyMap())
+        .nullableTags((Iterable<String>) null)
+        .nullableIndex((Map<String, Integer>) null)
+        .numbers()
+        .checked("seeded-checked")
+        .errorProne("seeded-error");
+
+    SeedableLazyModel seeded = source.build();
+    check(seeded.scalar()).is(0);
+    assertFalse(seeded.enabled());
+    check(seeded.nullable()).isNull();
+    check(seeded.optional()).is(Optional.empty());
+    check(seeded.tags()).isEmpty();
+    check(seeded.index()).is(Collections.emptyMap());
+    check(seeded.nullableTags()).isNull();
