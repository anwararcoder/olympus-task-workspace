+  private static int canonicalIndex(String step) {
+    if (step.isEmpty()) {
+      return -1;
+    }
+    if (step.charAt(0) == '0') {
+      return step.length() == 1 ? 0 : -1;
+    }
+    for (int i = 0; i < step.length(); i++) {
+      char c = step.charAt(i);
+      if (c < '0' || c > '9') {
+        return -1;
+      }
+    }
+    if (step.length() > 10) {
+      return -2;
+    }
+    if (step.length() == 10 && step.compareTo("2147483647") > 0) {
+      return -2;
+    }
+    return Integer.parseInt(step);
+  }
