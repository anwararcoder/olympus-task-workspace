+
+  public static final class Step {
+    public final String name;
+    public final String getter;
+    public final String wither;
+    public final String checkType;
+    public final String elementType;
+    public final String elementCheckType;
+    public final boolean optional;
+    public final boolean list;
+    public final boolean array;
+    public final boolean map;
+    public final boolean opaque;
+    public final boolean nullable;
+    public final boolean settable;
+    public final boolean updatable;
+    public final String presenceMethod;
+    public final String contentMethod;
+
+    private Step(ValueAttribute attribute, Shape shape, String elementType, String elementCheckType) {
