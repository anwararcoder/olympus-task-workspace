+        [else if s.array]
+          [if s.nullable]
+        if (newValue == null) {
+          return v.[s.wither](([s.elementCheckType][arr]) null);
+        }
+          [/if]
+        if (!(newValue instanceof [s.elementCheckType][arr])) {
