+      this.elementCheckType = elementCheckType;
+      this.optional = shape == Shape.OPTIONAL;
+      this.list = shape == Shape.LIST;
+      this.array = shape == Shape.ARRAY;
+      this.map = shape == Shape.MAP;
+      this.opaque = shape == Shape.OPAQUE;
+      this.nullable = attribute.isNullable();
+      this.settable = attribute.isGenerateAbstract || attribute.isGenerateDefault;
+      this.updatable = this.settable && shape != Shape.OPAQUE;
+      this.presenceMethod = attribute.isFugueOptional() || attribute.isJavaslangOptional()
