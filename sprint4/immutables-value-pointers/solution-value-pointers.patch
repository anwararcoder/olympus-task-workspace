+          return new Step(attribute, Shape.OPAQUE, "", "");
+        }
+        return new Step(attribute, Shape.ARRAY, element, rawOf(element));
+      }
+      if (attribute.isMapType()
+          && !attribute.isMultimapType()
+          && !attribute.isSortedMapType()
+          && "java.lang.String".equals(attribute.getWrappedElementType())) {
+        String element = attribute.getWrappedSecondaryElementType();
+        return new Step(attribute, Shape.MAP, unbounded(element), rawOf(element));
+      }
+      if (attribute.typeKind().isRegular()) {
+        return new Step(attribute, Shape.REGULAR, "", "");
+      }
+      return new Step(attribute, Shape.OPAQUE, "", "");
+    }
+  }
+
+  static PointerModel of(ValueType enclosing) {
+    Map<String, TypeElement> abstractMembers = new LinkedHashMap<>();
+    for (Element enclosed : enclosing.element.getEnclosedElements()) {
+      if (enclosed.getKind() == ElementKind.INTERFACE || enclosed.getKind() == ElementKind.CLASS) {
+        TypeElement member = (TypeElement) enclosed;
+        boolean abstractMember = member.getKind() == ElementKind.INTERFACE
+            || member.getModifiers().contains(Modifier.ABSTRACT);
+        if (abstractMember
+            && member.getTypeParameters().isEmpty()
+            && !isImmutableValue(enclosing, member)) {
+          abstractMembers.put(member.getQualifiedName().toString(), member);
+        }
+      }
+    }
+
+    boolean eligible = false;
+    if (!abstractMembers.isEmpty()) {
+      Map<String, Integer> implCounts = new LinkedHashMap<>();
+      for (ValueType nested : enclosing.nested) {
+        if (!nested.generics().isEmpty()) {
+          continue;
+        }
+        for (String supertypeName : supertypeNamesOf(nested)) {
+          if (abstractMembers.containsKey(supertypeName)) {
+            Integer count = implCounts.get(supertypeName);
+            implCounts.put(supertypeName, count == null ? 1 : count + 1);
+          }
+        }
+      }
+      for (Integer count : implCounts.values()) {
+        if (count >= 2) {
+          eligible = true;
+          break;
+        }
+      }
+    }
+    if (!eligible) {
+      return new PointerModel(ImmutableList.<Impl>of(), false);
+    }
+
+    ImmutableList.Builder<Impl> impls = ImmutableList.builder();
+    for (ValueType nested : enclosing.nested) {
+      if (!nested.generics().isEmpty()) {
+        continue;
+      }
+      if (!nested.isUseCopyMethods()) {
+        return new PointerModel(ImmutableList.<Impl>of(), false);
+      }
+      ImmutableList.Builder<Step> steps = ImmutableList.builder();
+      for (ValueAttribute attribute : nested.attributes) {
+        steps.add(Step.of(attribute));
+      }
+      impls.add(new Impl(nested.typeImmutable().relative(), steps.build()));
+    }
+    return new PointerModel(impls.build(), true);
+  }
+
+  private static boolean isImmutableValue(ValueType enclosing, TypeElement member) {
+    for (ValueType nested : enclosing.nested) {
+      if (nested.element.equals(member)) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  private static Set<String> supertypeNamesOf(ValueType impl) {
+    Set<String> names = new LinkedHashSet<>();
+    names.addAll(impl.getExtendedClassesNames());
+    names.addAll(impl.getImplementedInterfacesNames());
+    return names;
+  }
+
+  private static String rawOf(String type) {
+    String bounded = unbounded(type);
+    int generic = bounded.indexOf('<');
+    return generic < 0 ? bounded : bounded.substring(0, generic);
+  }
+
+  private static String unbounded(String type) {
+    if (type.startsWith("? extends ")) {
+      return type.substring("? extends ".length());
+    }
+    if (type.startsWith("? super ")) {
+      return type.substring("? super ".length());
+    }
+    if (type.equals("?")) {
+      return "java.lang.Object";
+    }
+    return type;
+  }
+
+  private static String upperFirst(String name) {
+    return Character.toUpperCase(name.charAt(0)) + name.substring(1);
+  }
+
+  private static boolean isPrimitive(String type) {
+    return !boxed(type).equals(type);
+  }
+
+  private static String boxed(String type) {
+    switch (type) {
+    case "boolean": return "java.lang.Boolean";
+    case "byte": return "java.lang.Byte";
+    case "short": return "java.lang.Short";
+    case "int": return "java.lang.Integer";
+    case "long": return "java.lang.Long";
+    case "char": return "java.lang.Character";
+    case "float": return "java.lang.Float";
+    case "double": return "java.lang.Double";
+    default: return type;
+    }
+  }
+}
