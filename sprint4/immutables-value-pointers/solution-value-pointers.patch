+public final class PointerModel {
+  public final ImmutableList<Impl> impls;
+  private final boolean eligible;
+
+  private PointerModel(ImmutableList<Impl> impls, boolean eligible) {
+    this.impls = impls;
+    this.eligible = eligible;
+  }
+
+  public boolean isEligible() {
+    return eligible && !impls.isEmpty();
+  }
+
+  public static final class Impl {
+    public final String implType;
+    public final ImmutableList<Step> steps;
+
+    Impl(String implType, ImmutableList<Step> steps) {
+      this.implType = implType;
+      this.steps = steps;
+    }
+  }
+
+  private enum Shape {
+    REGULAR,
+    OPTIONAL,
+    LIST,
+    ARRAY,
+    MAP,
+    OPAQUE
