+package org.immutables.fixture.vptr_4b9e21;
+
+import java.lang.reflect.InvocationTargetException;
+import java.lang.reflect.Method;
+import java.lang.reflect.Modifier;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.function.UnaryOperator;
+import org.junit.Test;
+
+import static org.immutables.check.Checkers.check;
+
+public class ValuePointers_7d31c9_Test {
+  private static final String PACKAGE = "org.immutables.fixture.vptr_4b9e21.";
+
+  private static Class<?> generated(String qualifiedSuffix) {
+    try {
+      return Class.forName(PACKAGE + qualifiedSuffix);
+    } catch (ClassNotFoundException e) {
+      throw new AssertionError(qualifiedSuffix + " was not generated", e);
+    }
+  }
+
+  private static boolean absent(String qualifiedSuffix) {
+    try {
+      Class.forName(PACKAGE + qualifiedSuffix);
+      return false;
+    } catch (ClassNotFoundException e) {
+      return true;
+    }
+  }
+
+  private static Class<?> pointers() {
+    return generated("CircuitPointers");
+  }
+
+  private static Class<?> pointerType() {
+    return generated("CircuitPointers$Pointer");
+  }
+
+  private static Class<?> malformedType() {
+    return generated("CircuitPointers$MalformedPointerException");
+  }
+
+  private static Class<?> missType() {
+    return generated("CircuitPointers$PointerMissException");
+  }
+
+  private static Class<?> mismatchType() {
+    return generated("CircuitPointers$PointerTypeException");
+  }
+
+  private static Object invoke(Method method, Object... args) {
+    try {
+      return method.invoke(null, args);
+    } catch (InvocationTargetException e) {
+      Throwable cause = e.getCause();
+      if (cause instanceof RuntimeException) {
+        throw (RuntimeException) cause;
+      }
+      if (cause instanceof Error) {
+        throw (Error) cause;
+      }
+      throw new AssertionError(cause);
+    } catch (IllegalAccessException e) {
+      throw new AssertionError(e);
+    }
+  }
+
+  private static Method method(String name, Class<?>... parameters) {
+    try {
+      return pointers().getMethod(name, parameters);
+    } catch (NoSuchMethodException e) {
+      throw new AssertionError("missing " + name, e);
+    }
+  }
+
+  private static Object parse(String input) {
+    return invoke(method("parse", String.class), input);
+  }
+
+  private static String render(Object pointer) {
+    return (String) invoke(method("render", pointerType()), pointer);
+  }
+
+  private static Object resolve(Object root, String pointer) {
+    return invoke(method("resolve", Object.class, pointerType()), root, parse(pointer));
+  }
+
+  private static Object update(Object root, String pointer, UnaryOperator<Object> operator) {
+    return invoke(method("update", Object.class, pointerType(), UnaryOperator.class),
+        root, parse(pointer), operator);
+  }
+
+  private static RuntimeException failure(Class<?> expected, Runnable invocation) {
+    try {
+      invocation.run();
+    } catch (RuntimeException e) {
+      check((Object) e.getClass()).same((Object) expected);
+      return e;
+    }
+    throw new AssertionError("expected " + expected.getSimpleName());
+  }
+
+  private static ImmutableCircuit.Wire wire(String label) {
+    return ImmutableCircuit.Wire.builder().label(label).gauge(label.length()).build();
+  }
+
+  private static ImmutableCircuit.Analog analog(String tag, double reading) {
+    return ImmutableCircuit.Analog.builder().tag(tag).reading(reading).build();
+  }
+
+  private static ImmutableCircuit.Junction tree() {
+    ImmutableCircuit.Junction inner = ImmutableCircuit.Junction.builder()
+        .addFeeds(wire("f0"), wire("f1"))
+        .shield(wire("sh"))
+        .putTaps("plain", wire("tp"))
+        .putTaps("", wire("te"))
+        .putTaps("~0", wire("tt"))
+        .putTaps("a/b", wire("ts"))
+        .putTaps("caf\u00e9", wire("tu"))
+        .putTaps("0", wire("tz"))
+        .meter(analog("cal", 1.5))
+        .build();
+    return ImmutableCircuit.Junction.builder()
+        .addFeeds(wire("w0"), inner)
+        .putTaps("top", wire("wt"))
+        .build();
+  }
+
+  private static ImmutableCircuit.Junction inner(Object root) {
+    return (ImmutableCircuit.Junction) ((ImmutableCircuit.Junction) root).feeds().get(1);
+  }
+
+  private static ImmutableCircuit.Relay relay() {
+    return ImmutableCircuit.Relay.builder()
+        .rails(wire("r0"), wire("r1"), wire("r2"))
+        .codes(7, 8)
+        .addBundle(wire("b0"))
+        .putFan("f", wire("m0"))
+        .putSlots(3, wire("s3"))
+        .putRanked("r", wire("k0"))
+        .addPile(wire("p0"))
+        .crate(ImmutableCircuit.Box.<String>builder().item("boxed").build())
+        .putPairs("k", wire("bm"))
+        .coil(wire("cl"))
+        .build();
+  }
+
+  @Test
+  public void companionShapeAndForeignSibling() {
+    Class<?> companion = pointers();
+    check(Modifier.isPublic(companion.getModifiers()));
+    check(Modifier.isFinal(companion.getModifiers()));
+    for (Method m : new Method[] {
+        method("parse", String.class),
+        method("render", pointerType()),
+        method("resolve", Object.class, pointerType()),
+        method("update", Object.class, pointerType(), UnaryOperator.class)}) {
+      check(Modifier.isStatic(m.getModifiers()));
+    }
+    generated("other.CircuitPointers");
+    check(absent("StandalonePointers"));
+    check(absent("NoCopyPointers"));
+    check(absent("MixedCopyPointers"));
+    check(absent("LoosePointers"));
+    check(absent("StampPointers"));
+    Class<?> sealed = generated("SealedPointers");
+    check(Modifier.isPublic(sealed.getModifiers()));
+    check(Modifier.isFinal(sealed.getModifiers()));
+  }
+
+  @Test
+  public void rootPointerParsesFromEmptyStringAndResolvesRootItself() {
+    ImmutableCircuit.Junction root = tree();
+    check(render(parse(""))).is("");
+    check(resolve(root, "")).same((Object) root);
+    ImmutableCircuit.Tag tag = ImmutableCircuit.Tag.builder().value("x").build();
+    check(resolve(tag, "")).same((Object) tag);
+    check(resolve(tag, "/value")).is((Object) "x");
+  }
+
+  @Test
+  public void renderIsTheExactInverseOfParse() {
+    for (String form : new String[] {
+        "", "/taps/~00", "/taps/a~1b", "/taps/", "/feeds/1", "/taps/caf\u00e9", "/~01~10", "//"}) {
+      check(render(parse(form))).is(form);
+    }
+  }
+
+  @Test
+  public void pointersParsedFromEqualStringsAreEqualWithEqualHashCodes() {
+    Object first = parse("/taps/a~1b");
+    Object second = parse("/taps/a~1b");
+    check(first).is(second);
+    check(first.hashCode()).is(second.hashCode());
+  }
+
+  @Test
+  public void pointerToStringIsItsRenderedForm() {
+    check(parse("/feeds/0/label").toString()).is("/feeds/0/label");
+    check(parse("").toString()).is("");
+  }
+
+  @Test
+  public void parseRejectsAStringWithoutALeadingSlash() {
+    failure(malformedType(), () -> parse("feeds"));
+  }
+
+  @Test
+  public void parseRejectsADanglingEscape() {
+    failure(malformedType(), () -> parse("/abcde~"));
+  }
+
+  @Test
+  public void parseRejectsAnUnknownEscape() {
+    failure(malformedType(), () -> parse("/abcd~2x"));
+  }
+
+  @Test
+  public void regularAttributeResolvesToItsValue() {
+    ImmutableCircuit.Junction root = tree();
+    check(resolve(root, "/feeds/1/feeds/0/label")).is((Object) "f0");
+    check(resolve(root, "/feeds/1/feeds/1/gauge")).is((Object) 2);
+  }
+
+  @Test
+  public void descentFollowsTheRuntimeImplementationNotTheStaticType() {
+    ImmutableCircuit.Junction root = tree();
+    check(resolve(root, "/feeds/1/taps/plain/label")).is((Object) "tp");
+  }
+
+  @Test
+  public void listAttributeAsFinalStepResolvesTheContainerItself() {
+    ImmutableCircuit.Junction root = tree();
+    check(resolve(root, "/feeds")).same((Object) root.feeds());
+    check(resolve(root, "/taps")).same((Object) root.taps());
+    ImmutableCircuit.Relay relay = relay();
+    check(resolve(relay, "/pairs")).same((Object) relay.pairs());
+  }
+
+  @Test
+  public void arrayElementResolvesByIndex() {
+    ImmutableCircuit.Relay relay = relay();
+    check(resolve(relay, "/rails/2")).is((Object) relay.rails()[2]);
+  }
+
+  @Test
+  public void optionalContentResolvesAcrossFlavors() {
+    ImmutableCircuit.Junction root = tree();
+    ImmutableCircuit.Junction inner = inner(root);
+    check(resolve(root, "/feeds/1/shield")).same((Object) inner.shield().get());
+    ImmutableCircuit.Relay relay = relay().withAux(wire("gx"));
+    check(resolve(relay, "/aux")).same((Object) relay.aux().get());
+    ImmutableCircuit.Digital leveled = ImmutableCircuit.Digital.builder().ticks(9L).level(7).build();
+    check(resolve(leveled, "/level")).is((Object) 7);
+    ImmutableCircuit.Digital spanned = ImmutableCircuit.Digital.builder().ticks(2L).span(11L).build();
+    check(resolve(spanned, "/span")).is((Object) 11L);
+    ImmutableCircuit.Digital measured = ImmutableCircuit.Digital.builder().ticks(4L).measure(3.5).build();
+    check(resolve(measured, "/measure")).is((Object) 3.5);
+  }
+
+  @Test
+  public void emptyOptionalIsAMiss() {
+    ImmutableCircuit.Junction root = tree();
+    failure(missType(), () -> resolve(root, "/shield"));
+    failure(missType(), () -> resolve(relay(), "/aux"));
+    ImmutableCircuit.Digital bare = ImmutableCircuit.Digital.builder().ticks(1L).build();
+    failure(missType(), () -> resolve(bare, "/level"));
+  }
+
+  @Test
+  public void crossFamilyOptionalDescentReachesInheritedAttribute() {
+    ImmutableCircuit.Junction root = tree();
+    check(resolve(root, "/feeds/1/meter/tag")).is((Object) "cal");
+  }
+
+  @Test
+  public void escapedStepsSelectTheLiteralMapKeys() {
+    ImmutableCircuit.Junction root = tree();
+    ImmutableCircuit.Junction inner = inner(root);
+    check(resolve(root, "/feeds/1/taps/a~1b")).same((Object) inner.taps().get("a/b"));
