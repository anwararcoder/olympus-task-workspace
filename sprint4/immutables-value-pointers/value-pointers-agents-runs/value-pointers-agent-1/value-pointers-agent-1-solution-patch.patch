+package org.immutables.value.processor;
+
+import com.Capella.common.collect.Multimap;
+import java.io.IOException;
+import java.io.PrintWriter;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import javax.annotation.processing.ProcessingEnvironment;
+import javax.lang.model.element.Element;
+import javax.lang.model.element.ElementKind;
+import javax.lang.model.element.Modifier;
+import javax.lang.model.element.PackageElement;
+import javax.lang.model.element.TypeElement;
+import javax.lang.model.type.ArrayType;
+import javax.lang.model.type.DeclaredType;
+import javax.lang.model.type.PrimitiveType;
+import javax.lang.model.type.TypeKind;
+import javax.lang.model.type.TypeMirror;
+import javax.lang.model.util.Elements;
+import javax.lang.model.util.Types;
+import javax.tools.JavaFileObject;
+import org.immutables.value.processor.meta.Proto.DeclaringPackage;
+import org.immutables.value.processor.meta.ValueAttribute;
+import org.immutables.value.processor.meta.ValueType;
+
+final class PointersGenerator {
+  private final ProcessingEnvironment processing;
+  private final Elements elements;
+  private final Types types;
+
+  PointersGenerator(ProcessingEnvironment processing) {
+    this.processing = processing;
+    this.elements = processing.getElementUtils();
+    this.types = processing.getTypeUtils();
+  }
+
+  void generate(Multimap<DeclaringPackage, ValueType> values) {
+    for (ValueType enclosing : values.values()) {
+      if (enclosing.constitution.hasEnclosingNonvalue()) {
+        generate(enclosing);
+      }
+    }
+  }
+
+  private void generate(ValueType enclosing) {
+    TypeElement enclosingElement = (TypeElement) enclosing.element;
+    List<ValueType> implementations = new ArrayList<>();
+    Map<TypeElement, Integer> familySizes = new LinkedHashMap<>();
+
+    for (ValueType value : enclosing.nested) {
+      if (!(value.element instanceof TypeElement) || !value.generics().isEmpty()) {
+        continue;
+      }
+      implementations.add(value);
+      Element parent = value.element.getEnclosingElement();
+      if (parent instanceof TypeElement
+          && parent.getEnclosingElement().toString().equals(enclosingElement.toString())
+          && isAbstractType((TypeElement) parent)) {
+        TypeElement family = (TypeElement) parent;
+        Integer size = familySizes.get(family);
+        familySizes.put(family, size == null ? 1 : size + 1);
+      }
+    }
+
+    boolean hasFamily = false;
+    for (Integer size : familySizes.values()) {
+      hasFamily |= size >= 2;
+    }
+    if (!hasFamily || implementations.isEmpty()) {
+      return;
+    }
+    for (ValueType value : implementations) {
+      if (!value.isUseCopyMethods()) {
+        return;
+      }
+    }
+
+    Element packageContainer = enclosingElement;
+    while (!(packageContainer instanceof PackageElement)) {
+      packageContainer = packageContainer.getEnclosingElement();
+    }
+    PackageElement packageElement = (PackageElement) packageContainer;
+    String packageName = packageElement.getQualifiedName().toString();
+    String simpleName = enclosingElement.getSimpleName() + "Pointers";
+    String qualifiedName = packageName.isEmpty() ? simpleName : packageName + '.' + simpleName;
+    try {
+      JavaFileObject source = processing.getFiler().createSourceFile(qualifiedName, enclosingElement);
+      try (PrintWriter out = new PrintWriter(source.openWriter())) {
+        writeCompanion(out, packageName, simpleName, implementations);
+      }
+    } catch (IOException ex) {
+      throw new RuntimeException("Cannot generate " + qualifiedName, ex);
+    }
+  }
+
+  private static boolean isAbstractType(TypeElement element) {
+    return element.getKind() == ElementKind.INTERFACE
+        || element.getModifiers().contains(Modifier.ABSTRACT);
+  }
+
+  private void writeCompanion(
+      PrintWriter out,
+      String packageName,
+      String simpleName,
+      List<ValueType> implementations) {
+    if (!packageName.isEmpty()) {
+      out.println("package " + packageName + ";");
+      out.println();
+    }
+    out.println("public final class " + simpleName + " {");
+    out.println("  private " + simpleName + "() {}");
+    out.println();
+    writePointer(out);
+    writeExceptions(out);
+    writeApi(out);
+    writeRuntime(out);
+    writeMetadata(out, implementations);
+    out.println("}");
+  }
+
+  private static void writePointer(PrintWriter out) {
+    out.println("  public static final class Pointer {");
+    out.println("    private final String[] steps;");
+    out.println("    private final String rendered;");
+    out.println("    private Pointer(String[] steps, String rendered) {");
+    out.println("      this.steps = steps;");
+    out.println("      this.rendered = rendered;");
+    out.println("    }");
+    out.println("    @Override public boolean equals(Object other) {");
+    out.println("      return other instanceof Pointer && java.util.Arrays.equals(steps, ((Pointer) other).steps);");
+    out.println("    }");
+    out.println("    @Override public int hashCode() { return java.util.Arrays.hashCode(steps); }");
+    out.println("    @Override public String toString() { return rendered; }");
+    out.println("  }");
+    out.println();
+  }
+
+  private static void writeExceptions(PrintWriter out) {
+    out.println("  public static final class MalformedPointerException extends IllegalArgumentException {");
+    out.println("    private MalformedPointerException(String message) { super(message); }");
+    out.println("  }");
+    out.println("  public static final class PointerMissException extends IllegalArgumentException {");
+    out.println("    private PointerMissException(String message) { super(message); }");
+    out.println("  }");
+    out.println("  public static final class PointerTypeException extends IllegalArgumentException {");
+    out.println("    private PointerTypeException(String message) { super(message); }");
+    out.println("    private PointerTypeException(String message, Throwable cause) { super(message, cause); }");
+    out.println("  }");
+    out.println();
+  }
+
+  private static void writeApi(PrintWriter out) {
+    out.println("  public static Pointer parse(String input) {");
+    out.println("    java.util.Objects.requireNonNull(input, \"input\");");
+    out.println("    if (input.isEmpty()) return new Pointer(new String[0], input);");
+    out.println("    if (input.charAt(0) != '/') throw malformed(input);");
+    out.println("    String[] encoded = input.substring(1).split(\"/\", -1);");
+    out.println("    String[] steps = new String[encoded.length];");
+    out.println("    for (int i = 0; i < encoded.length; i++) steps[i] = decode(encoded[i], input);");
+    out.println("    return new Pointer(steps, input);");
+    out.println("  }");
+    out.println();
+    out.println("  public static String render(Pointer pointer) {");
+    out.println("    return java.util.Objects.requireNonNull(pointer, \"pointer\").rendered;");
+    out.println("  }");
+    out.println();
+    out.println("  public static Object resolve(Object root, Pointer pointer) {");
+    out.println("    requireRoot(root);");
+    out.println("    java.util.Objects.requireNonNull(pointer, \"pointer\");");
+    out.println("    return resolveValue(root, pointer.steps, 0);");
+    out.println("  }");
+    out.println();
+    out.println("  public static Object update(Object root, Pointer pointer, java.util.function.UnaryOperator operator) {");
+    out.println("    requireRoot(root);");
+    out.println("    java.util.Objects.requireNonNull(pointer, \"pointer\");");
+    out.println("    java.util.Objects.requireNonNull(operator, \"operator\");");
+    out.println("    if (pointer.steps.length == 0) {");
+    out.println("      Object replacement = operator.apply(root);");
+    out.println("      if (!isImplementation(replacement)) throw type(\"replacement root is not an enclosed immutable implementation\");");
+    out.println("      return java.util.Objects.equals(root, replacement) ? root : replacement;");
+    out.println("    }");
+    out.println("    return updateValue(root, pointer.steps, 0, operator);");
+    out.println("  }");
+    out.println();
+    out.println("  private static String decode(String encoded, String pointer) {");
+    out.println("    StringBuilder decoded = new StringBuilder(encoded.length());");
+    out.println("    for (int i = 0; i < encoded.length(); i++) {");
+    out.println("      char c = encoded.charAt(i);");
+    out.println("      if (c != '~') { decoded.append(c); continue; }");
+    out.println("      if (++i == encoded.length()) throw malformed(pointer);");
+    out.println("      char escape = encoded.charAt(i);");
+    out.println("      if (escape == '0') decoded.append('~');");
+    out.println("      else if (escape == '1') decoded.append('/');");
+    out.println("      else throw malformed(pointer);");
+    out.println("    }");
+    out.println("    return decoded.toString();");
+    out.println("  }");
+    out.println("  private static MalformedPointerException malformed(String pointer) {");
+    out.println("    return new MalformedPointerException(\"Malformed pointer: \" + pointer);");
+    out.println("  }");
+  }
+
+  private static void writeRuntime(PrintWriter out) {
+    out.println();
+    out.println("  private static Object resolveValue(Object value, String[] steps, int offset) {");
+    out.println("    if (offset == steps.length) return value;");
+    out.println("    if (value == null) throw miss(\"step through null\");");
+    out.println("    Implementation implementation = implementation(value);");
+    out.println("    if (implementation == null) throw type(\"no step applies below this value\");");
+    out.println("    Attribute attribute = implementation.attribute(steps[offset]);");
+    out.println("    if (attribute == null) throw miss(\"absent attribute: \" + steps[offset]);");
+    out.println("    Object selected = attribute.get(value);");
+    out.println("    int next = offset + 1;");
+    out.println("    if (attribute.kind == OPTIONAL) {");
+    out.println("      selected = attribute.optionalValue(selected);");
+    out.println("      if (selected == ABSENT) throw miss(\"empty optional\");");
+    out.println("    }");
+    out.println("    if (next == steps.length) return selected;");
+    out.println("    if (selected == null) throw miss(\"step through null\");");
+    out.println("    if (attribute.kind == LIST) return resolveList((java.util.List) selected, attribute, steps, next);");
+    out.println("    if (attribute.kind == ARRAY) return resolveArray(selected, attribute, steps, next);");
+    out.println("    if (attribute.kind == MAP) return resolveMap((java.util.Map) selected, attribute, steps, next);");
+    out.println("    return resolveValue(selected, steps, next);");
+    out.println("  }");
+    out.println();
+    out.println("  private static Object resolveList(java.util.List list, Attribute attribute, String[] steps, int offset) {");
+    out.println("    int index = index(steps[offset]);");
+    out.println("    if (index >= list.size()) throw miss(\"index past end: \" + steps[offset]);");
+    out.println("    Object selected = list.get(index);");
+    out.println("    return offset + 1 == steps.length ? selected : resolveValue(selected, steps, offset + 1);");
+    out.println("  }");
+    out.println("  private static Object resolveArray(Object array, Attribute attribute, String[] steps, int offset) {");
+    out.println("    int index = index(steps[offset]);");
+    out.println("    if (index >= java.lang.reflect.Array.getLength(array)) throw miss(\"index past end: \" + steps[offset]);");
+    out.println("    Object selected = java.lang.reflect.Array.get(array, index);");
+    out.println("    return offset + 1 == steps.length ? selected : resolveValue(selected, steps, offset + 1);");
+    out.println("  }");
+    out.println("  private static Object resolveMap(java.util.Map map, Attribute attribute, String[] steps, int offset) {");
+    out.println("    String key = steps[offset];");
+    out.println("    if (!map.containsKey(key)) throw miss(\"absent map key: \" + key);");
+    out.println("    Object selected = map.get(key);");
+    out.println("    return offset + 1 == steps.length ? selected : resolveValue(selected, steps, offset + 1);");
+    out.println("  }");
+    out.println();
+    out.println("  private static Object updateValue(Object value, String[] steps, int offset, java.util.function.UnaryOperator operator) {");
+    out.println("    if (value == null) throw miss(\"step through null\");");
+    out.println("    Implementation implementation = implementation(value);");
+    out.println("    if (implementation == null) throw type(\"no step applies below this value\");");
+    out.println("    Attribute attribute = implementation.attribute(steps[offset]);");
+    out.println("    if (attribute == null) throw miss(\"absent attribute: \" + steps[offset]);");
+    out.println("    if (!attribute.modifiable) throw type(\"derived or lazy attribute cannot be updated\");");
+    out.println("    if (attribute.kind == BLOCKED) throw type(\"this container attribute cannot be updated\");");
+    out.println("    Object selected = attribute.get(value);");
+    out.println("    int next = offset + 1;");
+    out.println("    if (attribute.kind == OPTIONAL) {");
+    out.println("      Object content = attribute.optionalValue(selected);");
+    out.println("      if (content == ABSENT) throw miss(\"empty optional\");");
+    out.println("      Object replacement = next == steps.length");
+    out.println("          ? apply(operator, content, attribute, true)");
+    out.println("          : updateValue(content, steps, next, operator);");
+    out.println("      if (java.util.Objects.equals(content, replacement)) return value;");
+    out.println("      return attribute.set(value, attribute.optionalOf(replacement));");
+    out.println("    }");
+    out.println("    if (next == steps.length) {");
+    out.println("      Object replacement = apply(operator, selected, attribute, false);");
+    out.println("      return java.util.Objects.equals(selected, replacement) ? value : attribute.set(value, replacement);");
+    out.println("    }");
+    out.println("    if (selected == null) throw miss(\"step through null\");");
+    out.println("    Object replacement;");
+    out.println("    if (attribute.kind == LIST) replacement = updateList((java.util.List) selected, attribute, steps, next, operator);");
+    out.println("    else if (attribute.kind == ARRAY) replacement = updateArray(selected, attribute, steps, next, operator);");
+    out.println("    else if (attribute.kind == MAP) replacement = updateMap((java.util.Map) selected, attribute, steps, next, operator);");
+    out.println("    else replacement = updateValue(selected, steps, next, operator);");
+    out.println("    return replacement == selected ? value : attribute.set(value, replacement);");
+    out.println("  }");
+    out.println();
+    out.println("  private static Object updateList(java.util.List list, Attribute attribute, String[] steps, int offset, java.util.function.UnaryOperator operator) {");
+    out.println("    int index = index(steps[offset]);");
+    out.println("    if (index >= list.size()) throw miss(\"index past end: \" + steps[offset]);");
+    out.println("    Object old = list.get(index);");
+    out.println("    Object replacement = offset + 1 == steps.length");
+    out.println("        ? apply(operator, old, attribute, true)");
+    out.println("        : updateValue(old, steps, offset + 1, operator);");
+    out.println("    if (java.util.Objects.equals(old, replacement)) return list;");
+    out.println("    java.util.ArrayList copy = new java.util.ArrayList(list);");
+    out.println("    copy.set(index, replacement);");
+    out.println("    return copy;");
+    out.println("  }");
+    out.println("  private static Object updateArray(Object array, Attribute attribute, String[] steps, int offset, java.util.function.UnaryOperator operator) {");
+    out.println("    int index = index(steps[offset]);");
+    out.println("    int length = java.lang.reflect.Array.getLength(array);");
+    out.println("    if (index >= length) throw miss(\"index past end: \" + steps[offset]);");
+    out.println("    Object old = java.lang.reflect.Array.get(array, index);");
+    out.println("    Object replacement = offset + 1 == steps.length");
+    out.println("        ? apply(operator, old, attribute, true)");
+    out.println("        : updateValue(old, steps, offset + 1, operator);");
+    out.println("    if (java.util.Objects.equals(old, replacement)) return array;");
+    out.println("    Object copy = java.lang.reflect.Array.newInstance(array.getClass().getComponentType(), length);");
+    out.println("    System.arraycopy(array, 0, copy, 0, length);");
+    out.println("    try { java.lang.reflect.Array.set(copy, index, replacement); }");
+    out.println("    catch (IllegalArgumentException | NullPointerException ex) { throw type(\"array element replacement has wrong type\", ex); }");
+    out.println("    return copy;");
+    out.println("  }");
+    out.println("  private static Object updateMap(java.util.Map map, Attribute attribute, String[] steps, int offset, java.util.function.UnaryOperator operator) {");
+    out.println("    String key = steps[offset];");
+    out.println("    if (!map.containsKey(key)) throw miss(\"absent map key: \" + key);");
+    out.println("    Object old = map.get(key);");
+    out.println("    Object replacement = offset + 1 == steps.length");
+    out.println("        ? apply(operator, old, attribute, true)");
+    out.println("        : updateValue(old, steps, offset + 1, operator);");
+    out.println("    if (java.util.Objects.equals(old, replacement)) return map;");
+    out.println("    java.util.LinkedHashMap copy = new java.util.LinkedHashMap(map);");
+    out.println("    copy.put(key, replacement);");
+    out.println("    return copy;");
+    out.println("  }");
+    out.println();
+    out.println("  private static Object apply(java.util.function.UnaryOperator operator, Object old, Attribute attribute, boolean element) {");
+    out.println("    Object replacement = operator.apply(old);");
+    out.println("    if (!(element ? attribute.acceptsElement(replacement) : attribute.accepts(replacement)))");
+    out.println("      throw type(\"replacement has wrong type\");");
+    out.println("    return replacement;");
+    out.println("  }");
+    out.println("  private static int index(String step) {");
+    out.println("    if (step.isEmpty() || (step.length() > 1 && step.charAt(0) == '0')) throw type(\"invalid array or list index: \" + step);");
+    out.println("    long value = 0;");
+    out.println("    for (int i = 0; i < step.length(); i++) {");
+    out.println("      char c = step.charAt(i);");
+    out.println("      if (c < '0' || c > '9') throw type(\"invalid array or list index: \" + step);");
