+  private void writeMetadata(PrintWriter out, List<ValueType> implementations) {
+    out.println();
+    out.println("  private static final Implementation[] IMPLEMENTATIONS = {");
+    for (int i = 0; i < implementations.size(); i++) {
+      ValueType implementation = implementations.get(i);
+      out.println("    new Implementation(" + implementation.typeImmutable().absoluteRaw() + ".class, new Attribute[] {");
+      List<ValueAttribute> attributes = implementation.getAllAccessibleAttributes();
+      for (int j = 0; j < attributes.size(); j++) {
+        writeAttribute(out, attributes.get(j));
+        out.println(j + 1 == attributes.size() ? "" : ",");
+      }
+      out.print("    })");
+      out.println(i + 1 == implementations.size() ? "" : ",");
+    }
+    out.println("  };");
+  }
+
+  private void writeAttribute(PrintWriter out, ValueAttribute attribute) {
+    int kind = kind(attribute);
+    TypeMirror valueType = attribute.returnTypeMirror();
+    TypeMirror elementType = elementType(attribute, kind);
+    String valueClass = kind == LIST ? List.class.getName()
+        : kind == MAP ? Map.class.getName()
+        : boxedErasure(valueType);
+    String elementClass = attribute.isJdkSpecializedOptional()
+        ? boxedType(attribute.getUnwrappedElementType())
+        : boxedErasure(elementType);
+    String optionalFactory = optionalFactory(attribute);
+    out.print("      new Attribute(\"" + escape(attribute.names.raw) + "\", \""
+        + escape(attribute.names.get) + "\", \"" + escape(attribute.names.with) + "\", "
+        + kindName(kind) + ", " + attribute.isNullable() + ", "
+        + (attribute.whenTypeuseNullableElement() || kind == SCALAR && attribute.isNullable()) + ", "
+        + (!attribute.isGenerateDerived && !attribute.isGenerateLazy) + ", \"" + optionalFactory + "\") {");
+    out.print(" @Override boolean valueInstance(Object value) { return value instanceof " + valueClass + "; }");
+    out.print(" @Override boolean elementInstance(Object value) { return value instanceof " + elementClass + "; }");
+    out.print(" @Override Class getOptionalClass() { return " + boxedErasure(valueType) + ".class; }");
+    out.print(" }");
+  }
+
+  private int kind(ValueAttribute attribute) {
+    if (attribute.isOptionalType()) return OPTIONAL;
+    if (attribute.isListType()) return LIST;
+    if (attribute.isReferenceArrayType()) return ARRAY;
+    if (attribute.isMapType()
+        && !attribute.isSortedMapType()
+        && !attribute.isMultimapType()
+        && isString(firstTypeArgument(attribute.returnTypeMirror()))) {
+      return MAP;
+    }
+    if (attribute.isSetType()
+        || attribute.isMultisetType()
+        || attribute.isMultimapType()
+        || attribute.isSortedMapType()
+        || attribute.isMapType()
+        || attribute.isPrimitiveArrayType()) {
+      return BLOCKED;
+    }
+    return SCALAR;
+  }
+
+  private TypeMirror elementType(ValueAttribute attribute, int kind) {
+    TypeMirror type = attribute.returnTypeMirror();
+    if (kind == ARRAY) return ((ArrayType) type).getComponentType();
+    if (kind == LIST || kind == OPTIONAL) return firstTypeArgument(type);
+    if (kind == MAP) return typeArgument(type, 1);
+    return type;
+  }
+
+  private TypeMirror firstTypeArgument(TypeMirror type) {
+    return typeArgument(type, 0);
+  }
+
+  private TypeMirror typeArgument(TypeMirror type, int index) {
+    if (type.getKind() == TypeKind.DECLARED) {
+      List<? extends TypeMirror> arguments = ((DeclaredType) type).getTypeArguments();
+      if (arguments.size() > index) return arguments.get(index);
+    }
+    return elements.getTypeElement(Object.class.getName()).asType();
+  }
+
+  private boolean isString(TypeMirror type) {
+    return types.isSameType(types.erasure(type), elements.getTypeElement(String.class.getName()).asType());
+  }
+
+  private String boxedErasure(TypeMirror type) {
+    if (type.getKind().isPrimitive()) {
+      return types.boxedClass((PrimitiveType) type).getQualifiedName().toString();
+    }
+    if (type.getKind() == TypeKind.WILDCARD) {
+      return Object.class.getName();
+    }
+    return types.erasure(type).toString();
+  }
+
+  private static String optionalFactory(ValueAttribute attribute) {
+    if (attribute.isFugueOptional() || attribute.isJavaslangOptional()) return "some";
+    return "of";
+  }
+
+  private static String boxedType(String type) {
+    if ("boolean".equals(type)) return Boolean.class.getName();
+    if ("byte".equals(type)) return Byte.class.getName();
+    if ("short".equals(type)) return Short.class.getName();
+    if ("int".equals(type)) return Integer.class.getName();
+    if ("long".equals(type)) return Long.class.getName();
+    if ("char".equals(type)) return Character.class.getName();
+    if ("float".equals(type)) return Float.class.getName();
+    if ("double".equals(type)) return Double.class.getName();
+    return type;
+  }
+
+  private static String kindName(int kind) {
+    switch (kind) {
+      case LIST: return "LIST";
+      case ARRAY: return "ARRAY";
+      case MAP: return "MAP";
+      case OPTIONAL: return "OPTIONAL";
+      case BLOCKED: return "BLOCKED";
+      default: return "SCALAR";
+    }
+  }
+
+  private static String escape(String value) {
+    return value.replace("\\", "\\\\").replace("\"", "\\\"");
+  }
+
+  private static final int SCALAR = 0;
+  private static final int LIST = 1;
+  private static final int ARRAY = 2;
+  private static final int MAP = 3;
+  private static final int OPTIONAL = 4;
+  private static final int BLOCKED = 5;
+}
