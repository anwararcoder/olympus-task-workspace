+    out.println("  private static PointerMissException miss(String message) { return new PointerMissException(message); }");
+    out.println("  private static PointerTypeException type(String message) { return new PointerTypeException(message); }");
+    out.println("  private static PointerTypeException type(String message, Throwable cause) { return new PointerTypeException(message, cause); }");
+    out.println("  private static final Object ABSENT = new Object();");
+    out.println("  private static final int SCALAR = 0, LIST = 1, ARRAY = 2, MAP = 3, OPTIONAL = 4, BLOCKED = 5;");
+    out.println();
+    out.println("  private abstract static class Attribute {");
+    out.println("    final String name, getter, with, optionalFactory;");
+    out.println("    final int kind;");
+    out.println("    final boolean nullable, elementNullable, modifiable;");
+    out.println("    Attribute(String name, String getter, String with, int kind, boolean nullable, boolean elementNullable, boolean modifiable, String optionalFactory) {");
+    out.println("      this.name = name; this.getter = getter; this.with = with; this.kind = kind;");
+    out.println("      this.nullable = nullable; this.elementNullable = elementNullable; this.modifiable = modifiable; this.optionalFactory = optionalFactory;");
+    out.println("    }");
+    out.println("    abstract boolean valueInstance(Object value);");
+    out.println("    abstract boolean elementInstance(Object value);");
+    out.println("    final boolean accepts(Object value) { return value == null ? nullable : valueInstance(value); }");
+    out.println("    final boolean acceptsElement(Object value) { return value == null ? elementNullable : elementInstance(value); }");
+    out.println("    final Object get(Object instance) {");
+    out.println("      try { java.lang.reflect.Method method = instance.getClass().getMethod(getter); method.setAccessible(true); return method.invoke(instance); }");
+    out.println("      catch (ReflectiveOperationException ex) { throw type(\"cannot read attribute \" + name, ex); }");
