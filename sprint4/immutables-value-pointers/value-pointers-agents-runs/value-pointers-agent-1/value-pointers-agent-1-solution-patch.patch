+package org.immutables.fixture.pointers;
+
+import static org.immutables.check.Checkers.check;
+import static org.junit.jupiter.api.Assertions.assertNotSame;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+import java.util.Optional;
+import java.util.concurrent.atomic.AtomicInteger;
+import org.immutables.fixture.pointers.ImmutablePointerValues.Group;
+import org.immutables.fixture.pointers.ImmutablePointerValues.Text;
+import org.junit.jupiter.api.Test;
+
+public class PointerValuesTest {
+  private final Text one = Text.builder().text("one").build();
+  private final Text two = Text.builder().text("two").build();
+  private final Group root = Group.builder()
+      .name("root")
+      .child(one)
+      .addChildren(one, two)
+      .array(one, two)
+      .putNamed("first", one)
+      .optional(Optional.of(two))
+      .number(3)
+      .addNodes(one)
+      .numbers(1, 2)
+      .putNumbered(1, one)
+      .nullable(null)
+      .build();
+
+  @Test
+  public void parsesAndRenders() {
+    PointerValuesPointers.Pointer pointer = PointerValuesPointers.parse("/a~1b/~0/");
+    check(PointerValuesPointers.render(pointer)).is("/a~1b/~0/");
+    check(pointer.toString()).is("/a~1b/~0/");
+    check(pointer).is(PointerValuesPointers.parse("/a~1b/~0/"));
+    check(PointerValuesPointers.render(PointerValuesPointers.parse(""))).is("");
+    assertThrows(PointerValuesPointers.MalformedPointerException.class,
+        () -> PointerValuesPointers.parse("no-slash"));
+    assertThrows(PointerValuesPointers.MalformedPointerException.class,
+        () -> PointerValuesPointers.parse("/~2"));
+  }
+
+  @Test
+  public void resolvesValuesAndContainers() {
+    check(PointerValuesPointers.resolve(root, PointerValuesPointers.parse(""))).same(root);
+    check(PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/name"))).is("root");
+    check(PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/child/text"))).is("one");
+    check(PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/children"))).same(root.children());
+    check(PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/children/1/text"))).is("two");
+    check(PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/array/0"))).same(one);
+    check(PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/named/first/text"))).is("one");
+    check(PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/optional/text"))).is("two");
+    check(PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/number"))).is(3);
+    check(PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/nullable"))).isNull();
+  }
+
+  @Test
+  public void updatesOnlyTheAddressedPath() {
+    Group updated = (Group) PointerValuesPointers.update(
+        root, PointerValuesPointers.parse("/children/1/text"), value -> "changed");
+    assertNotSame(root, updated);
+    check(updated.child()).same(root.child());
+    check(updated.children().get(0)).same(root.children().get(0));
+    check(((Text) updated.children().get(1)).text()).is("changed");
+    check(PointerValuesPointers.update(root, PointerValuesPointers.parse("/name"), value -> value)).same(root);
+    Group numbered = (Group) PointerValuesPointers.update(
+        root, PointerValuesPointers.parse("/number"), value -> ((Integer) value) + 1);
+    check(numbered.number().getAsInt()).is(4);
+  }
+
+  @Test
+  public void reportsDistinctFailuresBeforeCallingOperator() {
+    assertThrows(PointerValuesPointers.PointerMissException.class,
+        () -> PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/missing")));
+    assertThrows(PointerValuesPointers.PointerMissException.class,
+        () -> PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/children/9")));
+    assertThrows(PointerValuesPointers.PointerTypeException.class,
+        () -> PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/children/01")));
+    assertThrows(PointerValuesPointers.PointerTypeException.class,
+        () -> PointerValuesPointers.update(root, PointerValuesPointers.parse("/size"), value -> 0));
+    assertThrows(PointerValuesPointers.PointerTypeException.class,
+        () -> PointerValuesPointers.update(root, PointerValuesPointers.parse("/name"), value -> 1));
+    AtomicInteger calls = new AtomicInteger();
+    assertThrows(PointerValuesPointers.PointerTypeException.class,
+        () -> PointerValuesPointers.update(root, PointerValuesPointers.parse("/nodes"), value -> {
+          calls.incrementAndGet();
+          return value;
+        }));
+    assertThrows(PointerValuesPointers.PointerTypeException.class,
+        () -> PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/numbers/0")));
+    assertThrows(PointerValuesPointers.PointerTypeException.class,
+        () -> PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/numbered/1")));
+    check(calls.get()).is(0);
+  }
+}
