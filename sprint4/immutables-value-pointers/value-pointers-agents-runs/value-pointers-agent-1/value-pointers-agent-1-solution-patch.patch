+package org.immutables.fixture.pointers;
+
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.OptionalInt;
+import java.util.Set;
+import javax.annotation.Nullable;
+import org.immutables.value.Value;
+
+@Value.Enclosing
+public interface PointerValues {
+  abstract class Node {
+    @Value.Immutable
+    public abstract static class Text extends Node {
+      public abstract String text();
+    }
+
+    @Value.Immutable
+    public abstract static class Group extends Node {
+      public abstract String name();
+      public abstract Node child();
+      public abstract List<Node> children();
+      public abstract Node[] array();
+      public abstract Map<String, Node> named();
+      public abstract Optional<Node> optional();
+      public abstract OptionalInt number();
+      public abstract Set<Node> nodes();
+      public abstract int[] numbers();
+      public abstract Map<Integer, Node> numbered();
+      public abstract @Nullable Node nullable();
+
+      @Value.Derived
+      public int size() {
+        return children().size();
+      }
+    }
+  }
+}
