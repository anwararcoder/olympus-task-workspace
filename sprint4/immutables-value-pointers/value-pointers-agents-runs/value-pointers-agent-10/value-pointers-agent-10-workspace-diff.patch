+package org.immutables.fixture.nested;
+
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import javax.annotation.Nullable;
+import org.immutables.value.Value;
+
+@Value.Enclosing
+public interface PointerFamily {
+  interface Node {}
+
+  @Value.Immutable
+  interface Leaf extends Node {
+    String name();
+
+    @Nullable String nullable();
+  }
+
+  @Value.Immutable
+  interface Branch extends Node {
+    Node child();
+
+    List<Node> children();
+
+    Map<String, Node> named();
+
+    Optional<Node> optional();
+
+    Node[] array();
+
+    int[] primitive();
+
+    @Value.Derived
+    default int size() {
+      return children().size();
+    }
+  }
+
+  @Value.Immutable
+  interface Other {
+    String value();
+  }
+}
diff --git a/value-fixture/test/org/immutables/fixture/nested/PointerFamilyTest.java b/value-fixture/test/org/immutables/fixture/nested/PointerFamilyTest.java
new file mode 100644
index 0000000..fe30fb3
--- /dev/null
+++ b/value-fixture/test/org/immutables/fixture/nested/PointerFamilyTest.java
@@ -0,0 +1,150 @@
+package org.immutables.fixture.nested;
+
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.Optional;
+import java.util.concurrent.atomic.AtomicBoolean;
+import org.immutables.fixture.nested.ImmutablePointerFamily.Branch;
+import org.immutables.fixture.nested.ImmutablePointerFamily.Leaf;
+import org.immutables.fixture.nested.PointerFamilyPointers.Pointer;
+import org.junit.jupiter.api.Test;
+import static org.immutables.check.Checkers.check;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+public class PointerFamilyTest {
+  private static Leaf leaf(String name) {
+    return Leaf.builder().name(name).nullable(null).build();
+  }
+
+  private static Branch branch() {
+    Leaf first = leaf("first");
+    Leaf second = leaf("second");
+    Map<String, PointerFamily.Node> named = new LinkedHashMap<>();
+    named.put("a/b", first);
+    named.put("~", second);
+    return Branch.builder()
+        .child(first)
+        .addAllChildren(Arrays.asList(first, second))
+        .putAllNamed(named)
+        .optional(Optional.<PointerFamily.Node>of(second))
+        .array(first, second)
+        .primitive(1, 2)
+        .build();
+  }
+
+  @Test
+  public void parsesAndRendersPointers() {
+    Pointer root = PointerFamilyPointers.parse("");
+    Pointer escaped = PointerFamilyPointers.parse("/named/a~1b/name");
+    check(root.toString()).is("");
+    check(PointerFamilyPointers.render(escaped)).is("/named/a~1b/name");
+    check(PointerFamilyPointers.parse("/named/a~1b/name")).is(escaped);
+    check(PointerFamilyPointers.parse("/").toString()).is("/");
+    assertThrows(PointerFamilyPointers.MalformedPointerException.class,
+        () -> PointerFamilyPointers.parse("name"));
+    assertThrows(PointerFamilyPointers.MalformedPointerException.class,
+        () -> PointerFamilyPointers.parse("/~2"));
+  }
+
+  @Test
+  public void resolvesAttributesAndContainers() {
+    Branch branch = branch();
+    check(PointerFamilyPointers.resolve(branch, PointerFamilyPointers.parse("/child/name"))).is("first");
+    check(PointerFamilyPointers.resolve(branch, PointerFamilyPointers.parse("/children/1/name"))).is("second");
+    check(PointerFamilyPointers.resolve(branch, PointerFamilyPointers.parse("/named/a~1b/name"))).is("first");
+    check(PointerFamilyPointers.resolve(branch, PointerFamilyPointers.parse("/named/~0/name"))).is("second");
+    check(PointerFamilyPointers.resolve(branch, PointerFamilyPointers.parse("/optional/name"))).is("second");
+    check(PointerFamilyPointers.resolve(branch, PointerFamilyPointers.parse("/array/0/name"))).is("first");
+    check(PointerFamilyPointers.resolve(branch, PointerFamilyPointers.parse("/primitive"))).is(branch.primitive());
+    check(PointerFamilyPointers.resolve(ImmutablePointerFamily.Other.builder().value("other").build(),
+        PointerFamilyPointers.parse("/value"))).is("other");
+  }
+
+  @Test
+  public void updatesOnlyTheAddressedPath() {
+    Branch original = branch();
+    Branch updated = (Branch) PointerFamilyPointers.update(
+        original, PointerFamilyPointers.parse("/children/1/name"), value -> value + "!");
+
+    check(updated.children().get(1)).is(leaf("second!"));
+    assertSame(original.child(), updated.child());
+    assertSame(original.named(), updated.named());
+    assertSame(original.children().get(0), updated.children().get(0));
+    assertSame(original.optional().get(), updated.optional().get());
+    assertSame(original, PointerFamilyPointers.update(
+        original, PointerFamilyPointers.parse("/child/name"), value -> new String("first")));
+  }
+
+  @Test
+  public void updatesMapsArraysOptionalsNullableAndRoot() {
+    Branch original = branch();
+    Branch mapped = (Branch) PointerFamilyPointers.update(
+        original, PointerFamilyPointers.parse("/named/~0/name"), value -> "mapped");
+    check(mapped.named().keySet()).isOf("a/b", "~");
+    assertSame(original.named().get("a/b"), mapped.named().get("a/b"));
+    check(PointerFamilyPointers.resolve(mapped, PointerFamilyPointers.parse("/named/~0/name"))).is("mapped");
+
+    Branch arrayed = (Branch) PointerFamilyPointers.update(
+        original, PointerFamilyPointers.parse("/array/1/name"), value -> "arrayed");
+    check(PointerFamilyPointers.resolve(arrayed, PointerFamilyPointers.parse("/array/1/name"))).is("arrayed");
+
+    Branch optional = (Branch) PointerFamilyPointers.update(
+        original, PointerFamilyPointers.parse("/optional/name"), value -> "optional");
+    check(PointerFamilyPointers.resolve(optional, PointerFamilyPointers.parse("/optional/name"))).is("optional");
+
+    Leaf nullable = (Leaf) PointerFamilyPointers.update(
+        leaf("nullable"), PointerFamilyPointers.parse("/nullable"), value -> "present");
+    check(nullable.nullable()).is("present");
+    check(PointerFamilyPointers.resolve(leaf("nullable"),
+        PointerFamilyPointers.parse("/nullable"))).isNull();
+
+    Object replacement = ImmutablePointerFamily.Other.builder().value("root").build();
+    check(PointerFamilyPointers.update(original, PointerFamilyPointers.parse(""), value -> replacement))
+        .same(replacement);
+  }
+
+  @Test
+  public void distinguishesMissesAndTypeErrors() {
+    Branch branch = branch();
+    assertThrows(PointerFamilyPointers.PointerMissException.class,
+        () -> PointerFamilyPointers.resolve(branch, PointerFamilyPointers.parse("/missing")));
+    assertThrows(PointerFamilyPointers.PointerMissException.class,
+        () -> PointerFamilyPointers.resolve(branch, PointerFamilyPointers.parse("/children/99")));
+    assertThrows(PointerFamilyPointers.PointerMissException.class,
+        () -> PointerFamilyPointers.resolve(branch, PointerFamilyPointers.parse("/children/999999999999999999999")));
+    assertThrows(PointerFamilyPointers.PointerMissException.class,
+        () -> PointerFamilyPointers.resolve(branch, PointerFamilyPointers.parse("/named/missing")));
+    assertThrows(PointerFamilyPointers.PointerMissException.class,
+        () -> PointerFamilyPointers.resolve(branch.withOptional(Optional.empty()),
+            PointerFamilyPointers.parse("/optional")));
+    assertThrows(PointerFamilyPointers.PointerTypeException.class,
+        () -> PointerFamilyPointers.resolve(branch, PointerFamilyPointers.parse("/children/01")));
+    assertThrows(PointerFamilyPointers.PointerTypeException.class,
+        () -> PointerFamilyPointers.resolve(branch, PointerFamilyPointers.parse("/primitive/0")));
+    AtomicBoolean invoked = new AtomicBoolean();
+    assertThrows(PointerFamilyPointers.PointerTypeException.class,
+        () -> PointerFamilyPointers.update(branch, PointerFamilyPointers.parse("/primitive"), value -> {
+          invoked.set(true);
+          return value;
+        }));
+    check(Boolean.valueOf(invoked.get())).is(false);
+    assertThrows(PointerFamilyPointers.PointerTypeException.class,
+        () -> PointerFamilyPointers.update(branch, PointerFamilyPointers.parse("/children/0"), value -> "wrong"));
+    assertThrows(PointerFamilyPointers.PointerTypeException.class,
+        () -> PointerFamilyPointers.update(branch, PointerFamilyPointers.parse("/size"), value -> 0));
+    assertThrows(PointerFamilyPointers.PointerTypeException.class,
+        () -> PointerFamilyPointers.update(branch, PointerFamilyPointers.parse("/child"), value -> "wrong"));
+    assertThrows(PointerFamilyPointers.PointerTypeException.class,
+        () -> PointerFamilyPointers.update(branch, PointerFamilyPointers.parse("/children"),
+            value -> Arrays.asList("wrong")));
+    assertThrows(PointerFamilyPointers.PointerTypeException.class,
+        () -> PointerFamilyPointers.update(branch, PointerFamilyPointers.parse("/array"),
+            value -> "wrong"));
+    assertThrows(PointerFamilyPointers.PointerTypeException.class,
+        () -> PointerFamilyPointers.update(branch, PointerFamilyPointers.parse(""), value -> "wrong"));
+    assertThrows(IllegalArgumentException.class,
+        () -> PointerFamilyPointers.resolve("wrong", PointerFamilyPointers.parse("")));
+  }
+}
