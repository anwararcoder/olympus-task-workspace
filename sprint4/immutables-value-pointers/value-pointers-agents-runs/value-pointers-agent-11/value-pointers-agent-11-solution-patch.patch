+public final class [type.pointerCompanionName] {
+  private static final int VALUE = 0;
+  private static final int OPTIONAL = 1;
+  private static final int LIST = 2;
+  private static final int ARRAY = 3;
+  private static final int MAP = 4;
+
+  private [type.pointerCompanionName]() {}
+
+  public static final class Pointer {
+    private final java.util.List<String> steps;
+
+    private Pointer(java.util.List<String> steps) {
+      this.steps = java.util.Collections.unmodifiableList(steps);
+    }
+
+    @Override
+    public boolean equals(Object other) {
+      return this == other || other instanceof Pointer
+          && steps.equals(((Pointer) other).steps);
+    }
+
+    @Override
+    public int hashCode() {
+      return steps.hashCode();
+    }
+
+    @Override
+    public String toString() {
+      return render(this);
+    }
+  }
+
+  public static final class MalformedPointerException extends IllegalArgumentException {
+    private static final long serialVersionUID = 1L;
+
+    public MalformedPointerException(String message) {
+      super(message);
+    }
+  }
+
+  public static final class PointerMissException extends IllegalArgumentException {
+    private static final long serialVersionUID = 1L;
+
+    public PointerMissException(String message) {
+      super(message);
+    }
+  }
+
+  public static final class PointerTypeException extends IllegalArgumentException {
+    private static final long serialVersionUID = 1L;
+
+    public PointerTypeException(String message) {
+      super(message);
+    }
+
+    private PointerTypeException(String message, RuntimeException cause) {
+      super(message, cause);
+    }
+  }
+
+  public static Pointer parse(String pointer) {
+    if (pointer == null) {
+      throw new MalformedPointerException("Pointer is null");
+    }
+    if (pointer.isEmpty()) {
+      return new Pointer(new java.util.ArrayList<String>());
+    }
+    if (pointer.charAt(0) != '/') {
+      throw new MalformedPointerException("Pointer must be empty or start with '/'");
+    }
+    java.util.ArrayList<String> steps = new java.util.ArrayList<String>();
+    int start = 1;
+    for (int end = 1; end <= pointer.length(); end++) {
+      if (end == pointer.length() || pointer.charAt(end) == '/') {
+        steps.add(unescape(pointer.substring(start, end)));
+        start = end + 1;
+      }
+    }
+    return new Pointer(steps);
+  }
+
+  public static String render(Pointer pointer) {
+    if (pointer == null) {
+      throw new NullPointerException("pointer");
+    }
+    StringBuilder rendered = new StringBuilder();
+    for (String step : pointer.steps) {
+      rendered.append('/');
+      for (int i = 0; i < step.length(); i++) {
+        char character = step.charAt(i);
+        if (character == '~') {
+          rendered.append("~0");
+        } else if (character == '/') {
+          rendered.append("~1");
+        } else {
+          rendered.append(character);
+        }
+      }
+    }
+    return rendered.toString();
+  }
+
+  public static Object resolve(Object root, Pointer pointer) {
+    requireRoot(root);
+    if (pointer == null) {
+      throw new NullPointerException("pointer");
+    }
+    return resolveValue(root, pointer.steps, 0);
+  }
+
+  @SuppressWarnings({"rawtypes", "unchecked"})
+  public static Object update(
+      Object root,
+      Pointer pointer,
+      java.util.function.UnaryOperator operator) {
+    requireRoot(root);
+    if (pointer == null) {
+      throw new NullPointerException("pointer");
+    }
+    if (operator == null) {
+      throw new NullPointerException("operator");
+    }
+    if (pointer.steps.isEmpty()) {
+      Object replacement = operator.apply(root);
+      if (replacement == null || descriptor(replacement) == null) {
+        throw new PointerTypeException(
+            "Replacement root must be a generated implementation enclosed by [type.typeAbstract.relativeRaw]");
+      }
+      return equalValues(root, replacement) ? root : replacement;
+    }
+    return updateValue(root, pointer.steps, 0, operator);
+  }
+
+  private static String unescape(String step) {
+    StringBuilder unescaped = new StringBuilder(step.length());
+    for (int i = 0; i < step.length(); i++) {
+      char character = step.charAt(i);
+      if (character != '~') {
+        unescaped.append(character);
+        continue;
+      }
+      if (++i == step.length()) {
+        throw new MalformedPointerException("Unfinished '~' escape");
+      }
+      character = step.charAt(i);
+      if (character == '0') {
+        unescaped.append('~');
+      } else if (character == '1') {
+        unescaped.append('/');
+      } else {
+        throw new MalformedPointerException("Invalid '~' escape");
+      }
+    }
+    return unescaped.toString();
+  }
+
+  private static Object resolveValue(Object value, java.util.List<String> steps, int offset) {
+    if (offset == steps.size()) {
+      return value;
+    }
+    if (value == null) {
+      throw miss("Cannot step through null", steps, offset);
+    }
+    ValueDescriptor descriptor = descriptor(value);
+    if (descriptor == null) {
+      throw type("No step applies to this value", steps, offset);
+    }
+    Attribute attribute = descriptor.attribute(steps.get(offset));
+    if (attribute == null) {
+      throw miss("No such attribute", steps, offset);
+    }
+    Object selected = attribute.read(value);
+    int next = offset + 1;
+    if (next == steps.size()) {
+      return selected;
+    }
+    if (selected == null) {
+      throw miss("Cannot step through null", steps, next);
+    }
+    switch (attribute.kind) {
+      case LIST: {
+        java.util.List<?> list = (java.util.List<?>) selected;
+        int index = index(steps.get(next), list.size(), steps, next);
+        return resolveValue(list.get(index), steps, next + 1);
+      }
+      case ARRAY: {
+        int length = java.lang.reflect.Array.getLength(selected);
+        int index = index(steps.get(next), length, steps, next);
+        return resolveValue(java.lang.reflect.Array.get(selected, index), steps, next + 1);
+      }
+      case MAP: {
+        java.util.Map<?, ?> map = (java.util.Map<?, ?>) selected;
+        String key = steps.get(next);
+        if (!map.containsKey(key)) {
+          throw miss("No such map key", steps, next);
+        }
+        return resolveValue(map.get(key), steps, next + 1);
+      }
+      default:
+        return resolveValue(selected, steps, next);
+    }
+  }
+
+  @SuppressWarnings({"rawtypes", "unchecked"})
+  private static Object updateValue(
+      Object value,
+      java.util.List<String> steps,
+      int offset,
+      java.util.function.UnaryOperator operator) {
+    if (value == null) {
+      throw miss("Cannot step through null", steps, offset);
+    }
+    ValueDescriptor descriptor = descriptor(value);
+    if (descriptor == null) {
+      throw type("No step applies to this value", steps, offset);
+    }
+    Attribute attribute = descriptor.attribute(steps.get(offset));
+    if (attribute == null) {
+      throw miss("No such attribute", steps, offset);
+    }
+    if (attribute.readOnly) {
+      throw type("Attribute cannot be updated", steps, offset);
+    }
+
+    Object selected = attribute.read(value);
+    int next = offset + 1;
+    if (next == steps.size()) {
+      Object replacement = operator.apply(selected);
+      return replace(value, attribute, selected, replacement, steps, offset);
+    }
+    if (selected == null) {
+      throw miss("Cannot step through null", steps, next);
+    }
+
+    Object replacement;
+    switch (attribute.kind) {
+      case LIST: {
+        java.util.List<?> list = (java.util.List<?>) selected;
+        int index = index(steps.get(next), list.size(), steps, next);
+        Object oldElement = list.get(index);
+        Object newElement = next + 1 == steps.size()
+            ? operator.apply(oldElement)
+            : updateValue(oldElement, steps, next + 1, operator);
+        requireExpected(newElement, attribute.elementType, attribute.elementNullable, steps, next);
+        if (equalValues(oldElement, newElement)) {
+          return value;
+        }
+        java.util.ArrayList<Object> copy = new java.util.ArrayList<Object>(list);
+        copy.set(index, newElement);
+        replacement = copy;
+        break;
+      }
+      case ARRAY: {
+        int length = java.lang.reflect.Array.getLength(selected);
+        int index = index(steps.get(next), length, steps, next);
+        Object oldElement = java.lang.reflect.Array.get(selected, index);
+        Object newElement = next + 1 == steps.size()
+            ? operator.apply(oldElement)
+            : updateValue(oldElement, steps, next + 1, operator);
+        requireExpected(newElement, attribute.elementType, attribute.elementNullable, steps, next);
+        if (equalValues(oldElement, newElement)) {
+          return value;
+        }
+        Object copy = java.lang.reflect.Array.newInstance(
+            selected.getClass().getComponentType(), length);
+        System.arraycopy(selected, 0, copy, 0, length);
+        try {
+          java.lang.reflect.Array.set(copy, index, newElement);
+        } catch (RuntimeException ex) {
+          throw new PointerTypeException("Replacement has the wrong array element type", ex);
+        }
+        replacement = copy;
+        break;
+      }
+      case MAP: {
+        java.util.Map<?, ?> map = (java.util.Map<?, ?>) selected;
+        String key = steps.get(next);
+        if (!map.containsKey(key)) {
+          throw miss("No such map key", steps, next);
+        }
+        Object oldElement = map.get(key);
+        Object newElement = next + 1 == steps.size()
+            ? operator.apply(oldElement)
+            : updateValue(oldElement, steps, next + 1, operator);
+        requireExpected(newElement, attribute.elementType, attribute.elementNullable, steps, next);
+        if (equalValues(oldElement, newElement)) {
+          return value;
+        }
+        java.util.LinkedHashMap<Object, Object> copy =
+            new java.util.LinkedHashMap<Object, Object>();
+        for (java.util.Map.Entry<?, ?> entry : map.entrySet()) {
+          copy.put(entry.getKey(), java.util.Objects.equals(entry.getKey(), key)
+              ? newElement
+              : entry.getValue());
+        }
+        replacement = copy;
+        break;
+      }
+      default:
+        replacement = updateValue(selected, steps, next, operator);
+        break;
+    }
+    return replace(value, attribute, selected, replacement, steps, offset);
+  }
+
+  private static Object replace(
+      Object owner,
+      Attribute attribute,
+      Object oldValue,
+      Object replacement,
+      java.util.List<String> steps,
+      int offset) {
+    if (equalValues(oldValue, replacement)) {
+      return owner;
+    }
+    switch (attribute.kind) {
+      case LIST:
+        if (replacement != null && !(replacement instanceof java.util.List<?>)) {
+          throw type("Replacement is not a list", steps, offset);
+        }
+        if (replacement != null) {
+          for (Object element : (java.util.List<?>) replacement) {
+            requireExpected(
+                element, attribute.elementType, attribute.elementNullable, steps, offset);
+          }
+        }
+        break;
+      case ARRAY:
+        requireExpected(replacement, attribute.valueType, attribute.nullable, steps, offset);
+        break;
+      case MAP:
+        if (replacement != null && !(replacement instanceof java.util.Map<?, ?>)) {
+          throw type("Replacement is not a map", steps, offset);
+        }
+        if (replacement != null) {
+          for (java.util.Map.Entry<?, ?> entry
+              : ((java.util.Map<?, ?>) replacement).entrySet()) {
+            requireExpected(
+                entry.getKey(), "java.lang.String", attribute.elementNullable, steps, offset);
+            requireExpected(
+                entry.getValue(), attribute.elementType, attribute.elementNullable, steps, offset);
+          }
+        }
+        break;
+      case OPTIONAL:
+        requireExpected(replacement, attribute.elementType, false, steps, offset);
+        break;
+      default:
+        requireExpected(replacement, attribute.valueType, attribute.nullable, steps, offset);
+        break;
+    }
+    if (replacement == null && !attribute.nullable) {
+      throw type("Replacement is null", steps, offset);
+    }
+    try {
+      return attribute.replace(owner, replacement);
+    } catch (PointerTypeException ex) {
+      throw ex;
+    } catch (RuntimeException ex) {
+      throw new PointerTypeException("Replacement has the wrong type", ex);
+    }
+  }
+
+  private static void requireExpected(
+      Object value,
+      String expected,
+      boolean nullable,
+      java.util.List<String> steps,
+      int offset) {
+    if (value == null) {
+      if (!nullable) {
+        throw type("Replacement is null", steps, offset);
+      }
+    } else if (!typeMatches(value.getClass(), expected)) {
+      throw type("Replacement has the wrong type", steps, offset);
+    }
+  }
+
+  private static boolean typeMatches(Class<?> actual, String expected) {
+    if (expected.equals("java.lang.Object")) {
+      return true;
+    }
+    String canonical = actual.getCanonicalName();
+    if (expected.equals(canonical) || expected.equals(actual.getName())) {
+      return true;
+    }
+    Class<?> superclass = actual.getSuperclass();
+    if (superclass != null && typeMatches(superclass, expected)) {
+      return true;
+    }
+    for (Class<?> implemented : actual.getInterfaces()) {
+      if (typeMatches(implemented, expected)) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  private static int index(
+      String step,
+      int size,
+      java.util.List<String> steps,
+      int offset) {
