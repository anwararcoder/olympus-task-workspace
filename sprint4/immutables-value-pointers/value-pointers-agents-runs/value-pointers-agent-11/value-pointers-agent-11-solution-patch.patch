@@ -0,0 +1,50 @@
+package org.immutables.fixture.pointer;
+
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.Set;
+import javax.annotation.Nullable;
+import org.immutables.value.Value;
+
+@Value.Enclosing
+public interface PointerFamilies {
+  interface Node {}
+
+  @Value.Immutable
+  interface Text extends Node {
+    String text();
+  }
+
+  @Value.Immutable
+  interface Number extends Node {
+    int number();
+  }
+
+  @Value.Immutable
+  interface Branch extends Node {
+    Node child();
+    List<Node> children();
+    Node[] array();
+    Map<String, Node> named();
+    Optional<Node> optional();
+    @Nullable Node nullable();
+    Set<Node> set();
+    int[] primitiveArray();
+
+    @Value.Derived
+    default int derivedSize() {
+      return children().size();
+    }
+
+    @Value.Lazy
+    default String lazyText() {
+      return child().toString();
+    }
+  }
+
+  @Value.Immutable
+  interface Outside {
+    String label();
+  }
+}
diff --git a/value-fixture/test/org/immutables/fixture/pointer/PointerFamiliesTest.java b/value-fixture/test/org/immutables/fixture/pointer/PointerFamiliesTest.java
