diff --git a/value-fixture/test/org/immutables/fixture/pointer/PointerFamiliesTest.java b/value-fixture/test/org/immutables/fixture/pointer/PointerFamiliesTest.java
new file mode 100644
index 0000000..dcd5caf
--- /dev/null
+++ b/value-fixture/test/org/immutables/fixture/pointer/PointerFamiliesTest.java
@@ -0,0 +1,178 @@
+package org.immutables.fixture.pointer;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.concurrent.atomic.AtomicBoolean;
+import org.junit.jupiter.api.Test;
+
+public class PointerFamiliesTest {
+  @Test
+  public void parsesAndRendersPointers() {
+    PointerFamiliesPointers.Pointer pointer = PointerFamiliesPointers.parse("/a~1b/~0/");
+
+    assertEquals("/a~1b/~0/", PointerFamiliesPointers.render(pointer));
+    assertEquals(pointer, PointerFamiliesPointers.parse("/a~1b/~0/"));
+    assertEquals("/a~1b/~0/", pointer.toString());
+    assertEquals("", PointerFamiliesPointers.render(PointerFamiliesPointers.parse("")));
+    assertThrows(PointerFamiliesPointers.MalformedPointerException.class,
+        () -> PointerFamiliesPointers.parse("missing-slash"));
+    assertThrows(PointerFamiliesPointers.MalformedPointerException.class,
+        () -> PointerFamiliesPointers.parse("/bad~2escape"));
+  }
+
+  @Test
+  public void resolvesAttributesAndContainers() {
+    ImmutablePointerFamilies.Branch root = root();
+
+    assertSame(root, PointerFamiliesPointers.resolve(root, pointer("")));
+    assertEquals("left", PointerFamiliesPointers.resolve(root, pointer("/child/text")));
+    assertEquals(2, PointerFamiliesPointers.resolve(root, pointer("/children/1/number")));
+    assertEquals("left", PointerFamiliesPointers.resolve(root, pointer("/array/0/text")));
+    assertEquals(2, PointerFamiliesPointers.resolve(root, pointer("/named/right/number")));
+    assertEquals(2, PointerFamiliesPointers.resolve(root, pointer("/optional/number")));
+    assertNull(PointerFamiliesPointers.resolve(root, pointer("/nullable")));
+    assertSame(root.children(), PointerFamiliesPointers.resolve(root, pointer("/children")));
+
+    assertThrows(PointerFamiliesPointers.PointerMissException.class,
+        () -> PointerFamiliesPointers.resolve(root, pointer("/missing")));
+    assertThrows(PointerFamiliesPointers.PointerMissException.class,
+        () -> PointerFamiliesPointers.resolve(root, pointer("/children/9")));
+    assertThrows(PointerFamiliesPointers.PointerTypeException.class,
+        () -> PointerFamiliesPointers.resolve(root, pointer("/children/01")));
+    assertThrows(PointerFamiliesPointers.PointerMissException.class,
+        () -> PointerFamiliesPointers.resolve(root, pointer("/nullable/text")));
+    assertThrows(PointerFamiliesPointers.PointerTypeException.class,
+        () -> PointerFamiliesPointers.resolve(root, pointer("/set/0")));
+  }
+
+  @Test
+  public void updatesOnlyTheAddressedPath() {
+    ImmutablePointerFamilies.Branch root = root();
+
+    ImmutablePointerFamilies.Branch changed = (ImmutablePointerFamilies.Branch)
+        PointerFamiliesPointers.update(root, pointer("/child/text"),
+            value -> ((String) value).toUpperCase());
+
+    assertEquals("LEFT", ((PointerFamilies.Text) changed.child()).text());
+    assertSame(root.children(), changed.children());
+    assertArrayEquals(root.array(), changed.array());
+    assertSame(root.named(), changed.named());
+    assertSame(root.optional().get(), changed.optional().get());
+
+    ImmutablePointerFamilies.Branch listChanged = (ImmutablePointerFamilies.Branch)
+        PointerFamiliesPointers.update(root, pointer("/children/0/text"), value -> "changed");
+    assertEquals("changed", ((PointerFamilies.Text) listChanged.children().get(0)).text());
+    assertSame(root.children().get(1), listChanged.children().get(1));
+
+    ImmutablePointerFamilies.Branch arrayChanged = (ImmutablePointerFamilies.Branch)
+        PointerFamiliesPointers.update(root, pointer("/array/1/number"), value -> 3);
+    assertEquals(3, ((PointerFamilies.Number) arrayChanged.array()[1]).number());
+    assertSame(root.array()[0], arrayChanged.array()[0]);
+
+    ImmutablePointerFamilies.Branch mapChanged = (ImmutablePointerFamilies.Branch)
+        PointerFamiliesPointers.update(root, pointer("/named/left/text"), value -> "map");
+    assertEquals(Arrays.asList("left", "right"), new ArrayList<>(mapChanged.named().keySet()));
+    assertSame(root.named().get("right"), mapChanged.named().get("right"));
+  }
+
+  @Test
+  public void preservesIdentityForEqualResultsAndRejectsBadUpdates() {
+    ImmutablePointerFamilies.Branch root = root();
+
+    assertSame(root, PointerFamiliesPointers.update(root, pointer("/child/text"), value -> value));
+    assertSame(root, PointerFamiliesPointers.update(root, pointer(""), value -> root()));
+    assertThrows(PointerFamiliesPointers.PointerTypeException.class,
+        () -> PointerFamiliesPointers.update(root, pointer("/child/text"), value -> 1));
+    assertThrows(PointerFamiliesPointers.PointerTypeException.class,
+        () -> PointerFamiliesPointers.update(root, pointer("/children"), value -> "not a list"));
+    assertThrows(PointerFamiliesPointers.PointerTypeException.class,
+        () -> PointerFamiliesPointers.update(root, pointer(""), value -> "not a root"));
+    assertThrows(PointerFamiliesPointers.PointerTypeException.class,
+        () -> PointerFamiliesPointers.update(root, pointer("/children"),
+            value -> Arrays.asList("not a node")));
+
+    AtomicBoolean called = new AtomicBoolean();
+    assertThrows(PointerFamiliesPointers.PointerTypeException.class,
+        () -> PointerFamiliesPointers.update(root, pointer("/derivedSize"), value -> {
+          called.set(true);
+          return value;
+        }));
+    assertFalse(called.get());
+
+    assertThrows(PointerFamiliesPointers.PointerTypeException.class,
+        () -> PointerFamiliesPointers.update(root, pointer("/set"), value -> {
+          called.set(true);
+          return value;
+        }));
+    assertFalse(called.get());
+  }
+
+  @Test
+  public void acceptsEveryNongenericEnclosedImplementationAsRoot() {
+    ImmutablePointerFamilies.Outside outside =
+        ImmutablePointerFamilies.Outside.builder().label("outside").build();
+    ImmutablePointerFamilies.Number replacement =
+        ImmutablePointerFamilies.Number.builder().number(4).build();
+
+    assertEquals("outside", PointerFamiliesPointers.resolve(outside, pointer("/label")));
+    assertSame(replacement,
+        PointerFamiliesPointers.update(outside, pointer(""), value -> replacement));
+    assertThrows(IllegalArgumentException.class,
+        () -> PointerFamiliesPointers.resolve("not generated", pointer("")));
+  }
+
+  @Test
+  public void handlesWholeContainerReplacement() {
+    ImmutablePointerFamilies.Branch root = root();
+    List<PointerFamilies.Node> children = Arrays.asList(root.children().get(1));
+    Map<String, PointerFamilies.Node> named = new LinkedHashMap<>();
+    named.put("only", root.child());
+
+    ImmutablePointerFamilies.Branch changed = (ImmutablePointerFamilies.Branch)
+        PointerFamiliesPointers.update(root, pointer("/children"), value -> children);
+    changed = (ImmutablePointerFamilies.Branch)
+        PointerFamiliesPointers.update(changed, pointer("/named"), value -> named);
+    changed = (ImmutablePointerFamilies.Branch)
+        PointerFamiliesPointers.update(changed, pointer("/array"),
+            value -> new PointerFamilies.Node[] {root.child()});
+
+    assertEquals(children, changed.children());
+    assertEquals(named, changed.named());
+    assertArrayEquals(new PointerFamilies.Node[] {root.child()}, changed.array());
+  }
+
+  private static PointerFamiliesPointers.Pointer pointer(String value) {
+    return PointerFamiliesPointers.parse(value);
+  }
+
+  private static ImmutablePointerFamilies.Branch root() {
+    ImmutablePointerFamilies.Text left =
+        ImmutablePointerFamilies.Text.builder().text("left").build();
+    ImmutablePointerFamilies.Number right =
+        ImmutablePointerFamilies.Number.builder().number(2).build();
+    Map<String, PointerFamilies.Node> named = new LinkedHashMap<>();
+    named.put("left", left);
+    named.put("right", right);
+    return ImmutablePointerFamilies.Branch.builder()
+        .child(left)
+        .addChildren(left, right)
+        .array(left, right)
+        .named(named)
+        .optional(Optional.of(right))
+        .nullable(null)
+        .addSet(left)
+        .primitiveArray(1, 2)
+        .build();
+  }
+}
