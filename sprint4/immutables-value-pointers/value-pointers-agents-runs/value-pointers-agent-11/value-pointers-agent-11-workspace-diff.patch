+package org.immutables.fixture.vptr_4b9e21;
+
+import org.immutables.value.Value;
+
+@Value.Enclosing
+interface Stamp {
+  interface Mark {}
+
+  @Value.Immutable
+  interface Seal extends Mark {
+    @Value.Derived
+    default int code() {
+      return 7;
+    }
+  }
+
+  @Value.Immutable
