+package org.immutables.fixture.pointer;
+
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.Set;
+import javax.annotation.Nullable;
+import org.immutables.value.Value;
+
+@Value.Enclosing
+public interface PointerValues {
+  abstract class Expression {
+    public abstract String id();
+
+    @Value.Immutable
+    public abstract static class Literal extends Expression {
+      public abstract String text();
+    }
+
+    @Value.Immutable
+    public abstract static class Group extends Expression {
+      public abstract Expression primary();
+      public abstract List<Expression> children();
+      public abstract Expression[] array();
+      public abstract Map<String, Expression> named();
+      public abstract Map<Integer, Expression> numbered();
+      public abstract Optional<Expression> optional();
+      public abstract Set<Expression> set();
+      public abstract int[] numbers();
+      public abstract @Nullable Expression nullable();
+
+      @Value.Derived
+      public int size() {
+        return children().size();
+      }
+
+      @Value.Lazy
+      public Expression lazy() {
+        return primary();
+      }
+    }
+  }
+
+  @Value.Immutable
+  abstract class Outside {
+    public abstract String label();
+  }
+}
