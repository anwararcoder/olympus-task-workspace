+package org.immutables.fixture.pointer;
+
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.Set;
+import javax.annotation.Nullable;
+import org.immutables.value.Value;
+
+@Value.Enclosing
+public interface PointerValues {
+  abstract class Expression {
+    public abstract String id();
+
+    @Value.Immutable
+    public abstract static class Literal extends Expression {
+      public abstract String text();
+    }
+
+    @Value.Immutable
+    public abstract static class Group extends Expression {
+      public abstract Expression primary();
+      public abstract List<Expression> children();
+      public abstract Expression[] array();
+      public abstract Map<String, Expression> named();
+      public abstract Map<Integer, Expression> numbered();
+      public abstract Optional<Expression> optional();
+      public abstract Set<Expression> set();
+      public abstract int[] numbers();
+      public abstract @Nullable Expression nullable();
+
+      @Value.Derived
+      public int size() {
+        return children().size();
+      }
+
+      @Value.Lazy
+      public Expression lazy() {
+        return primary();
+      }
+    }
+  }
+
+  @Value.Immutable
+  abstract class Outside {
+    public abstract String label();
+  }
+}
diff --git a/value-fixture/test/org/immutables/fixture/pointer/PointerValuesTest.java b/value-fixture/test/org/immutables/fixture/pointer/PointerValuesTest.java
new file mode 100644
index 0000000..48be2e4
--- /dev/null
+++ b/value-fixture/test/org/immutables/fixture/pointer/PointerValuesTest.java
@@ -0,0 +1,177 @@
+package org.immutables.fixture.pointer;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotSame;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.Optional;
+import java.util.concurrent.atomic.AtomicBoolean;
+import org.immutables.fixture.pointer.PointerValuesPointers.MalformedPointerException;
+import org.immutables.fixture.pointer.PointerValuesPointers.Pointer;
+import org.immutables.fixture.pointer.PointerValuesPointers.PointerMissException;
+import org.immutables.fixture.pointer.PointerValuesPointers.PointerTypeException;
+import org.junit.jupiter.api.Test;
+
+public class PointerValuesTest {
+  @Test
+  public void parsesAndRendersPointers() {
+    Pointer root = PointerValuesPointers.parse("");
+    Pointer escaped = PointerValuesPointers.parse("//a~1b/~0/end");
+
+    assertEquals("", root.toString());
+    assertEquals("//a~1b/~0/end", PointerValuesPointers.render(escaped));
+    assertEquals(escaped, PointerValuesPointers.parse("//a~1b/~0/end"));
+    assertEquals(escaped.hashCode(), PointerValuesPointers.parse("//a~1b/~0/end").hashCode());
+
+    assertThrows(MalformedPointerException.class, () -> PointerValuesPointers.parse("x"));
+    assertThrows(MalformedPointerException.class, () -> PointerValuesPointers.parse("/~"));
+    assertThrows(MalformedPointerException.class, () -> PointerValuesPointers.parse("/~2"));
+  }
+
+  @Test
+  public void resolvesAttributesContainersAndOptionals() {
+    ImmutablePointerValues.Group root = root();
+
+    assertSame(root, resolve(root, ""));
+    assertEquals("group", resolve(root, "/id"));
+    assertEquals("first", resolve(root, "/primary/text"));
+    assertEquals("second", resolve(root, "/children/1/text"));
+    assertEquals("first", resolve(root, "/array/0/text"));
+    assertEquals("first", resolve(root, "/named/a~1b/text"));
+    assertEquals("first", resolve(root, "/optional/text"));
+    assertEquals(null, resolve(root, "/nullable"));
+    assertEquals(root.children(), resolve(root, "/children"));
+
+    assertThrows(PointerMissException.class, () -> resolve(root, "/missing"));
+    assertThrows(PointerMissException.class, () -> resolve(root, "/children/2"));
+    assertThrows(PointerMissException.class, () -> resolve(root, "/nullable/text"));
+    assertThrows(PointerTypeException.class, () -> resolve(root, "/children/01"));
+    assertThrows(PointerTypeException.class, () -> resolve(root, "/children/x"));
+    assertThrows(PointerTypeException.class, () -> resolve(root, "/set/0"));
+    assertThrows(PointerTypeException.class, () -> resolve(root, "/numbered/1"));
+    assertThrows(PointerMissException.class,
+        () -> resolve(root.withOptional(Optional.empty()), "/optional"));
+    assertThrows(IllegalArgumentException.class, () -> resolve("not a value", ""));
+
+    ImmutablePointerValues.Outside outside =
+        ImmutablePointerValues.Outside.builder().label("outside").build();
+    assertEquals("outside", resolve(outside, "/label"));
+    assertEquals("changed", resolve(update(outside, "/label", value -> "changed"), "/label"));
+  }
+
+  @Test
+  public void updatesOnlyTheAddressedPath() {
+    ImmutablePointerValues.Group root = root();
+    Pointer pointer = PointerValuesPointers.parse("/children/0/text");
+
+    ImmutablePointerValues.Group changed = (ImmutablePointerValues.Group)
+        PointerValuesPointers.update(root, pointer, value -> value + "!");
+
+    assertNotSame(root, changed);
+    assertNotSame(root.children(), changed.children());
+    assertNotSame(root.children().get(0), changed.children().get(0));
+    assertSame(root.children().get(1), changed.children().get(1));
+    assertSame(root.primary(), changed.primary());
+    assertArrayEquals(root.array(), changed.array());
+    assertSame(root.named(), changed.named());
+    assertEquals("first!", resolve(changed, "/children/0/text"));
+
+    Object unchanged = PointerValuesPointers.update(root, pointer, value -> value);
+    assertSame(root, unchanged);
+  }
+
+  @Test
+  public void rebuildsListsArraysAndOrderedMaps() {
+    ImmutablePointerValues.Group root = root();
+    ImmutablePointerValues.Literal replacement = literal("replacement", "replacement");
+
+    ImmutablePointerValues.Group listChanged = (ImmutablePointerValues.Group)
+        update(root, "/children/1", value -> replacement);
+    assertSame(replacement, listChanged.children().get(1));
+    assertSame(root.children().get(0), listChanged.children().get(0));
+
+    ImmutablePointerValues.Group arrayChanged = (ImmutablePointerValues.Group)
+        update(root, "/array/1", value -> replacement);
+    assertSame(replacement, arrayChanged.array()[1]);
+    assertSame(root.array()[0], arrayChanged.array()[0]);
+
+    ImmutablePointerValues.Group mapChanged = (ImmutablePointerValues.Group)
+        update(root, "/named/second", value -> replacement);
+    assertEquals(Arrays.asList("a/b", "second"), new ArrayList<>(mapChanged.named().keySet()));
+    assertSame(root.named().get("a/b"), mapChanged.named().get("a/b"));
+    assertSame(replacement, mapChanged.named().get("second"));
+  }
+
+  @Test
+  public void enforcesUpdateTypesAndReadOnlyPositions() {
+    ImmutablePointerValues.Group root = root();
+    AtomicBoolean called = new AtomicBoolean();
+
+    assertThrows(PointerTypeException.class, () -> update(root, "/children", value -> "wrong"));
+    assertThrows(PointerTypeException.class,
+        () -> update(root, "/children", value -> Arrays.asList("wrong")));
+    assertThrows(PointerTypeException.class, () -> update(root, "/named", value -> {
+      Map<Object, Object> wrong = new LinkedHashMap<>();
+      wrong.put(1, root.primary());
+      return wrong;
+    }));
+    assertThrows(PointerTypeException.class, () -> update(root, "/primary", value -> null));
+    assertThrows(PointerTypeException.class, () -> update(root, "/set", value -> value));
+    assertThrows(PointerTypeException.class, () -> update(root, "/numbers", value -> value));
+    assertThrows(PointerTypeException.class, () -> update(root, "/size", value -> {
+      called.set(true);
+      return value;
+    }));
+    assertThrows(PointerTypeException.class, () -> update(root, "/lazy", value -> {
+      called.set(true);
+      return value;
+    }));
+    assertEquals(false, called.get());
+
+    ImmutablePointerValues.Group nullable = (ImmutablePointerValues.Group)
+        update(root, "/nullable", value -> literal("nullable", "nullable"));
+    assertEquals("nullable", resolve(nullable, "/nullable/text"));
+
+    assertThrows(PointerTypeException.class,
+        () -> update(root, "", value -> "not a generated implementation"));
+  }
+
+  private static Object resolve(Object root, String pointer) {
+    return PointerValuesPointers.resolve(root, PointerValuesPointers.parse(pointer));
+  }
+
+  private static Object update(Object root, String pointer, java.util.function.UnaryOperator<Object> operator) {
+    return PointerValuesPointers.update(root, PointerValuesPointers.parse(pointer), operator);
+  }
+
+  private static ImmutablePointerValues.Literal literal(String id, String text) {
+    return ImmutablePointerValues.Literal.builder().id(id).text(text).build();
+  }
+
+  private static ImmutablePointerValues.Group root() {
+    ImmutablePointerValues.Literal first = literal("first-id", "first");
+    ImmutablePointerValues.Literal second = literal("second-id", "second");
+    Map<String, PointerValues.Expression> named = new LinkedHashMap<>();
+    named.put("a/b", first);
+    named.put("second", second);
+
+    return ImmutablePointerValues.Group.builder()
+        .id("group")
+        .primary(first)
+        .addChildren(first, second)
+        .array(first, second)
+        .putAllNamed(named)
+        .putNumbered(1, first)
+        .optional(first)
+        .addSet(first)
+        .numbers(1, 2)
+        .nullable(null)
+        .build();
+  }
+}
