+package org.immutables.fixture.pointers;
+
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.Set;
+import javax.annotation.Nullable;
+import org.immutables.fixture.nullable.AllowNulls;
+import org.immutables.value.Value;
+
+@Value.Enclosing
+@Value.Style(jdkOnly = true)
+public interface PointerValues {
+  interface Node {}
+
+  @Value.Immutable
+  interface Leaf extends Node {
+    String value();
+  }
+
+  @Value.Immutable
+  interface Branch extends Node {
+    Node child();
+    List<Node> children();
+    @AllowNulls List<Node> nullableChildren();
+    Map<String, Node> byName();
+    Map<Integer, Node> byNumber();
+    Optional<Node> optional();
+    @Nullable Node nullable();
+    Node[] array();
+    int[] primitiveArray();
+    Set<Node> set();
+
+    @Value.Derived
+    default String derived() {
+      return "derived";
+    }
+  }
+
+  @Value.Immutable
+  interface Box {
+    Node node();
+  }
+}
