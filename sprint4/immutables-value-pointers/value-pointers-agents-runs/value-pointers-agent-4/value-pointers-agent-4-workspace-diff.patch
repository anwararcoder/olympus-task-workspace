@@ -0,0 +1,114 @@
+package org.immutables.fixture;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertInstanceOf;
+import static org.junit.jupiter.api.Assertions.assertNotSame;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.Optional;
+import java.util.function.UnaryOperator;
+import org.junit.jupiter.api.Test;
+
+class PointerValuesTest {
+  @Test
+  void parsesAndRendersPointers() {
+    PointerValuesPointers.Pointer root = PointerValuesPointers.parse("");
+    PointerValuesPointers.Pointer pointer = PointerValuesPointers.parse("/a~1b/~0/");
+
+    assertEquals("", root.toString());
+    assertEquals("/a~1b/~0/", PointerValuesPointers.render(pointer));
+    assertEquals(PointerValuesPointers.parse("/same"), PointerValuesPointers.parse("/same"));
+    assertThrows(PointerValuesPointers.MalformedPointerException.class,
+        () -> PointerValuesPointers.parse("bad"));
+    assertThrows(PointerValuesPointers.MalformedPointerException.class,
+        () -> PointerValuesPointers.parse("/~2"));
+  }
+
+  @Test
+  void resolvesImplementationsAndContainers() {
+    ImmutablePointerValues.Leaf first = leaf("first");
+    ImmutablePointerValues.Leaf second = leaf("second");
+    ImmutablePointerValues.Branch root = branch(first, second);
+
+    assertEquals("first", PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/child/value")));
+    assertEquals("second", PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/children/1/value")));
+    assertEquals("second", PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/named/key/value")));
+    assertEquals("first", PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/optional/value")));
+    assertNull(PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/nullable")));
+    assertEquals("second", PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/array/0/value")));
+    assertInstanceOf(int[].class, PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/primitiveArray")));
+  }
+
+  @Test
+  void updatesOnlyTheAddressedPath() {
+    ImmutablePointerValues.Leaf first = leaf("first");
+    ImmutablePointerValues.Leaf second = leaf("second");
+    ImmutablePointerValues.Branch root = branch(first, second);
+
+    ImmutablePointerValues.Branch updated = (ImmutablePointerValues.Branch) PointerValuesPointers.update(
+        root,
+        PointerValuesPointers.parse("/children/0/value"),
+        value -> "changed");
+
+    assertNotSame(root, updated);
+    assertSame(root.child(), updated.child());
+    assertNotSame(root.children().get(0), updated.children().get(0));
+    assertSame(root.children().get(1), updated.children().get(1));
+    assertSame(root.named(), updated.named());
+    assertEquals(leaf("changed"), updated.children().get(0));
+
+    UnaryOperator<String> equalReplacement = value -> new String("first");
+    Object unchanged = PointerValuesPointers.update(
+        root,
+        PointerValuesPointers.parse("/child/value"),
+        equalReplacement);
+    assertSame(root, unchanged);
+  }
+
+  @Test
+  void distinguishesMissesAndTypeErrors() {
+    ImmutablePointerValues.Branch root = branch(leaf("first"), leaf("second"));
+
+    assertThrows(PointerValuesPointers.PointerMissException.class, () -> PointerValuesPointers.resolve(
+        root, PointerValuesPointers.parse("/missing")));
+    assertThrows(PointerValuesPointers.PointerTypeException.class, () -> PointerValuesPointers.resolve(
+        root, PointerValuesPointers.parse("/children/01")));
+    assertThrows(PointerValuesPointers.PointerMissException.class, () -> PointerValuesPointers.resolve(
+        root, PointerValuesPointers.parse("/children/99")));
+    assertThrows(PointerValuesPointers.PointerMissException.class, () -> PointerValuesPointers.resolve(
+        root, PointerValuesPointers.parse("/nullable/value")));
+    assertThrows(PointerValuesPointers.PointerTypeException.class, () -> PointerValuesPointers.update(
+        root, PointerValuesPointers.parse("/set"), value -> value));
+    assertThrows(PointerValuesPointers.PointerTypeException.class, () -> PointerValuesPointers.update(
+        root, PointerValuesPointers.parse("/derived"), value -> value));
+    assertThrows(PointerValuesPointers.PointerTypeException.class, () -> PointerValuesPointers.update(
+        root, PointerValuesPointers.parse("/child"), value -> "wrong"));
+    assertThrows(IllegalArgumentException.class, () -> PointerValuesPointers.resolve(
+        "wrong", PointerValuesPointers.parse("")));
+  }
+
+  private static ImmutablePointerValues.Leaf leaf(String value) {
+    return ImmutablePointerValues.Leaf.builder().value(value).build();
+  }
+
+  private static ImmutablePointerValues.Branch branch(
+      ImmutablePointerValues.Leaf first, ImmutablePointerValues.Leaf second) {
+    Map<String, PointerValues.Node> named = new LinkedHashMap<>();
+    named.put("key", second);
+    return ImmutablePointerValues.Branch.builder()
+        .child(first)
+        .addAllChildren(Arrays.asList(first, second))
+        .putAllNamed(named)
+        .optional(Optional.of(first))
+        .nullable(null)
+        .array(second)
+        .primitiveArray(1, 2)
+        .addSet(second)
+        .build();
+  }
+}
