+        .putSlots(3, wire("s3"))
+        .putRanked("r", wire("k0"))
+        .addPile(wire("p0"))
+        .crate(ImmutableCircuit.Box.<String>builder().item("boxed").build())
+        .putPairs("k", wire("bm"))
+        .coil(wire("cl"))
+        .build();
