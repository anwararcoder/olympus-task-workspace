+package org.immutables.serial.fixture;
+
+import com.Capella.common.base.Optional;
+import com.Capella.common.collect.ImmutableBiMap;
+import com.Capella.common.collect.ImmutableList;
+import com.Capella.common.collect.ImmutableListMultimap;
+import com.Capella.common.collect.ImmutableMap;
+import com.Capella.common.collect.ImmutableMultiset;
+import com.Capella.common.collect.ImmutableSet;
+import com.Capella.common.collect.ImmutableSetMultimap;
+import com.Capella.common.collect.ImmutableSortedMap;
+import com.Capella.common.collect.ImmutableSortedMultiset;
+import com.Capella.common.collect.ImmutableSortedSet;
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.DataInput;
+import java.io.DataInputStream;
+import java.io.DataOutput;
+import java.io.DataOutputStream;
+import java.lang.reflect.Method;
+import java.util.Arrays;
+import org.immutables.serial.fixture.sub.ImmutableOtherNested;
+import org.junit.Test;
+import static org.immutables.check.Checkers.check;
+
+public class BinaryTest {
+  @Test
+  public void roundTripsSupportedBuilderShapes() throws Exception {
+    String longString = repeat('x', 100_000);
+    ImmutableBinaryValue value = ImmutableBinaryValue.builder()
+        .booleanValue(true)
+        .byteValue((byte) 2)
+        .shortValue((short) 3)
+        .intValue(4)
+        .longValue(5L)
+        .charValue('q')
+        .floatValue(6.5f)
+        .doubleValue(7.5d)
+        .boxedValue(8)
+        .stringValue(longString)
+        .enumValue(BinaryEnum.SECOND)
+        .jdkOptional(java.util.Optional.of("jdk"))
+        .guavaOptional(Optional.of(9))
+        .optionalInt(java.util.OptionalInt.of(10))
+        .optionalLong(java.util.OptionalLong.of(11L))
+        .optionalDouble(java.util.OptionalDouble.of(12.5d))
+        .primitiveArray(1, 2, 3)
+        .referenceArray("a", "b")
+        .list(ImmutableList.of("a", "b"))
+        .set(ImmutableSet.of(BinaryEnum.FIRST, BinaryEnum.SECOND))
+        .sortedSet(ImmutableSortedSet.of("b", "a"))
+        .multiset(ImmutableMultiset.of("x", "x", "y"))
+        .sortedMultiset(ImmutableSortedMultiset.of(3, 1, 3))
+        .map(ImmutableMap.of("one", 1))
+        .sortedMap(ImmutableSortedMap.of("two", BinaryEnum.SECOND))
+        .bimap(ImmutableBiMap.of(1, "one"))
+        .multimap(ImmutableListMultimap.of(1, "x", 1, "x"))
+        .listMultimap(ImmutableListMultimap.of(2, "a", 2, "a"))
+        .setMultimap(ImmutableSetMultimap.of(3, "b"))
+        .nested(ImmutableBinaryNested.<String>builder().code(13).build())
+        .auxiliary("not serialized")
+        .build();
+
+    ImmutableBinaryValue decoded = ImmutableBinaryValue.readFrom(input(write(value)));
+
+    check(decoded).is(value.withAuxiliary(Optional.absent()));
+    check(decoded.primitiveArray()).isOf(1, 2, 3);
+    check(decoded.referenceArray()).isOf("a", "b");
+    check(decoded.multiset().count("x")).is(2);
+    check(decoded.multimap().get(1)).hasSize(2);
+    check(decoded.listMultimap().get(2)).hasSize(2);
+    check(decoded.derived()).is(5);
+  }
+
+  @Test
+  public void matchesAttributesByFingerprintAndShape() throws Exception {
+    ImmutableBinaryNewer newer = ImmutableBinaryNewer.builder()
+        .added("new")
+        .following("tail")
+        .stable(7)
+        .build();
+
+    ImmutableBinaryOlder older = ImmutableBinaryOlder.readFrom(input(write(newer)));
+    check(older).is(ImmutableBinaryOlder.builder().stable(7).following("tail").build());
+
+    ImmutableBinaryNewer upgraded = ImmutableBinaryNewer.readFrom(input(write(older)));
+    check(upgraded.added()).is(java.util.Optional.empty());
+    check(upgraded.stable()).is(7);
+    check(upgraded.following()).is("tail");
+
+    ImmutableBinaryMismatch mismatch = ImmutableBinaryMismatch.readFrom(input(write(newer)));
+    check(mismatch.stable()).is("default");
+    check(mismatch.following()).is("tail");
+
+    ImmutableBinaryRenamed renamed = ImmutableBinaryRenamed.readFrom(input(write(older)));
+    check(renamed.renamed()).is(java.util.OptionalInt.empty());
+    check(renamed.following()).is("tail");
+  }
+
+  @Test
+  public void roundTripsAndMigratesConstructorValues() throws Exception {
+    ImmutableBinaryConstructor value = ImmutableBinaryConstructor.of(
+        4,
+        java.util.Optional.of("value"),
+        Arrays.asList(1, 2),
+        ImmutableMap.of("enum", BinaryEnum.FIRST),
+        Optional.of(99L));
+    ImmutableBinaryConstructor decoded = ImmutableBinaryConstructor.readFrom(input(write(value)));
+    check(decoded).is(value.withAuxiliary(Optional.absent()));
+
+    ImmutableBinaryConstructorNew newer = ImmutableBinaryConstructorNew.of(
+        java.util.Optional.of("added"), Arrays.asList(3, 4), 5);
+    ImmutableBinaryConstructorOld older = ImmutableBinaryConstructorOld.readFrom(input(write(newer)));
+    check(older).is(ImmutableBinaryConstructorOld.of(5, Arrays.asList(3, 4)));
+
+    ImmutableBinaryConstructorNew upgraded =
+        ImmutableBinaryConstructorNew.readFrom(input(write(older)));
+    check(upgraded.added()).is(java.util.Optional.empty());
+    check(upgraded.values()).isOf(3, 4);
+    check(upgraded.stable()).is(5);
+  }
+
+  @Test
+  public void nestedCompatibilityIgnoresPackageAndDeclaredTypeName() throws Exception {
+    ImmutableBinaryOuterA first = ImmutableBinaryOuterA.builder()
+        .nested(ImmutableBinaryNested.<String>builder().code(21).build())
+        .following("tail")
+        .build();
+
+    ImmutableBinaryOuterB second = ImmutableBinaryOuterB.readFrom(input(write(first)));
+    check(second.nested()).is(ImmutableOtherNested.builder().code(21).build());
+    check(second.following()).is("tail");
+  }
+
+  @Test
+  public void omitsConflictingAndUnsupportedForms() throws Exception {
+    check(!hasMethod(ImmutableBinaryWriteConflict.class, "readFrom", DataInput.class));
+    check(!hasMethod(ImmutableBinaryReadConflict.class, "writeTo", DataOutput.class));
+    check(!hasMethod(ImmutableBinaryUnsupported.class, "writeTo", DataOutput.class));
+    check(!hasMethod(ImmutableBinaryRecursive.class, "writeTo", DataOutput.class));
+  }
+
+  @Test(expected = java.io.EOFException.class)
+  public void rejectsIncompleteInput() throws Exception {
+    byte[] bytes = write(ImmutableBinaryOlder.builder().stable(1).following("tail").build());
+    ImmutableBinaryOlder.readFrom(input(Arrays.copyOf(bytes, bytes.length - 1)));
+  }
+
+  private static byte[] write(Object value) throws Exception {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    DataOutputStream output = new DataOutputStream(bytes);
+    Method method = value.getClass().getMethod("writeTo", DataOutput.class);
+    method.invoke(value, output);
+    output.flush();
+    return bytes.toByteArray();
+  }
+
+  private static DataInputStream input(byte[] bytes) {
+    return new DataInputStream(new ByteArrayInputStream(bytes));
+  }
+
+  private static boolean hasMethod(Class<?> type, String name, Class<?> parameter) {
+    try {
+      type.getMethod(name, parameter);
+      return true;
+    } catch (NoSuchMethodException ex) {
+      return false;
+    }
+  }
+
+  private static String repeat(char character, int count) {
+    char[] characters = new char[count];
+    Arrays.fill(characters, character);
+    return new String(characters);
+  }
+}
