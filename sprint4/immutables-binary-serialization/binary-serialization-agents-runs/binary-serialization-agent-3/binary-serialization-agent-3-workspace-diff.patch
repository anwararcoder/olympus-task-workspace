+                ? "com.Capella.common.collect.ImmutableSortedMultiset"
+                : "com.Capella.common.collect.ImmutableMultiset",
+            kind == SORTED_MULTISET ? "naturalOrder" : "builder");
+        for (int i = 0; i < size; i++) {
+          Object item = element.readNullable(input);
+          int count = checkedLength(input.readInt(), MAX_BLOCK_SIZE, "multiset count");
+          invokeCompatible(builder, "addCopies", item, count);
+        }
+        return invokeCompatible(builder, "build");
+      }
+
+      @Override public Object defaultValue() throws IOException {
+        Object builder = staticInvoke(
+            kind == SORTED_MULTISET
+                ? "com.Capella.common.collect.ImmutableSortedMultiset"
+                : "com.Capella.common.collect.ImmutableMultiset",
+            kind == SORTED_MULTISET ? "naturalOrder" : "builder");
+        return invokeCompatible(builder, "build");
+      }
+    };
+  }
+
+  private static Codec mapCodec(final int kind, final Codec key, final Codec value) {
+    return new Codec(shape(kind, key, value)) {
+      @Override void writeValue(DataOutput output, Object object) throws IOException {
+        Map<?, ?> map = (Map<?, ?>) object;
+        output.writeInt(map.size());
+        for (Map.Entry<?, ?> entry : map.entrySet()) {
+          key.writeNullable(output, entry.getKey());
+          value.writeNullable(output, entry.getValue());
+        }
+      }
+
+      @Override Object readValue(DataInput input) throws IOException {
+        int size = checkedLength(input.readInt(), MAX_BLOCK_SIZE, "map");
+        Map<Object, Object> map = kind == SORTED_MAP
+            ? new TreeMap<Object, Object>()
+            : new LinkedHashMap<Object, Object>(capacity(size));
+        for (int i = 0; i < size; i++) {
+          map.put(key.readNullable(input), value.readNullable(input));
+        }
+        if (kind == BIMAP) {
+          return staticInvoke("com.Capella.common.collect.ImmutableBiMap", "copyOf", map);
+        }
+        return map;
+      }
+
+      @Override public Object defaultValue() throws IOException {
+        if (kind == BIMAP) {
+          return staticInvoke("com.Capella.common.collect.ImmutableBiMap", "of");
+        }
+        return kind == SORTED_MAP
+            ? new TreeMap<Object, Object>()
+            : new LinkedHashMap<Object, Object>();
+      }
+    };
+  }
+
+  private static Codec multimapCodec(final int kind, final Codec key, final Codec value) {
+    return new Codec(shape(kind, key, value)) {
+      @Override void writeValue(DataOutput output, Object object) throws IOException {
+        Iterable<?> entries = (Iterable<?>) invokeUnchecked(object, "entries");
+        int size = sizeOf(entries);
+        output.writeInt(size);
+        for (Object objectEntry : entries) {
+          Map.Entry<?, ?> entry = (Map.Entry<?, ?>) objectEntry;
+          key.writeNullable(output, entry.getKey());
+          value.writeNullable(output, entry.getValue());
+        }
+      }
+
+      @Override Object readValue(DataInput input) throws IOException {
+        int size = checkedLength(input.readInt(), MAX_BLOCK_SIZE, "multimap");
+        String implementation = kind == LIST_MULTIMAP
+            ? "com.Capella.common.collect.ImmutableListMultimap"
+            : kind == SET_MULTIMAP
+                ? "com.Capella.common.collect.ImmutableSetMultimap"
+                : "com.Capella.common.collect.ImmutableMultimap";
+        Object builder = staticInvoke(implementation, "builder");
+        for (int i = 0; i < size; i++) {
+          invokeCompatible(builder, "put", key.readNullable(input), value.readNullable(input));
+        }
+        return invokeCompatible(builder, "build");
+      }
+
+      @Override public Object defaultValue() throws IOException {
+        String implementation = kind == LIST_MULTIMAP
+            ? "com.Capella.common.collect.ImmutableListMultimap"
+            : kind == SET_MULTIMAP
+                ? "com.Capella.common.collect.ImmutableSetMultimap"
+                : "com.Capella.common.collect.ImmutableMultimap";
+        return staticInvoke(implementation, "of");
+      }
+    };
+  }
+
+  private static byte[] shape(int kind, Codec... children) {
+    try {
+      ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+      DataOutputStream output = new DataOutputStream(bytes);
+      output.writeByte(kind);
+      for (Codec child : children) {
+        output.writeInt(child.shape.length);
+        output.write(child.shape);
+      }
+      output.flush();
+      return bytes.toByteArray();
+    } catch (IOException ex) {
+      throw new AssertionError(ex);
+    }
+  }
+
+  private static byte[] fingerprint(String attribute) throws IOException {
+    try {
+      return MessageDigest.getInstance("SHA-256").digest(attribute.getBytes(StandardCharsets.UTF_8));
+    } catch (NoSuchAlgorithmException ex) {
+      throw new IOException("SHA-256 is unavailable", ex);
+    }
+  }
+
+  private static void writeString(DataOutput output, String value) throws IOException {
+    byte[] bytes = value.getBytes(StandardCharsets.UTF_8);
+    output.writeInt(bytes.length);
+    output.write(bytes);
+  }
+
+  private static String readString(DataInput input) throws IOException {
+    byte[] bytes = new byte[checkedLength(input.readInt(), MAX_BLOCK_SIZE, "string")];
+    input.readFully(bytes);
+    return new String(bytes, StandardCharsets.UTF_8);
+  }
+
+  private static int checkedLength(int value, int maximum, String description) throws IOException {
+    if (value < 0 || value > maximum) {
+      throw new IOException("Invalid immutable binary " + description + ": " + value);
+    }
+    return value;
+  }
+
+  private static int capacity(int size) {
+    return size < 3 ? size + 1 : (int) Math.min(Integer.MAX_VALUE, size / 0.75f + 1.0f);
+  }
+
+  private static int sizeOf(Iterable<?> iterable) {
+    if (iterable instanceof Collection<?>) {
+      return ((Collection<?>) iterable).size();
+    }
+    int size = 0;
+    for (Object ignored : iterable) {
+      size++;
+    }
+    return size;
+  }
+
+  private static Object invokeUnchecked(Object target, String name) throws IOException {
+    return invokeCompatible(target, name);
+  }
+
+  private static Object staticInvoke(String className, String name, Object... arguments)
+      throws IOException {
+    try {
+      return invokeCompatible(Class.forName(className), name, arguments);
+    } catch (ClassNotFoundException ex) {
+      throw new IOException("Missing collection implementation " + className, ex);
+    }
+  }
+
+  private static Object invokeCompatible(Object target, String name, Object... arguments)
+      throws IOException {
+    Class<?> type = target instanceof Class<?> ? (Class<?>) target : target.getClass();
+    boolean requireStatic = target instanceof Class<?>;
+    for (Method method : type.getMethods()) {
+      if (method.getName().equals(name)
+          && method.getParameterTypes().length == arguments.length
+          && Modifier.isStatic(method.getModifiers()) == requireStatic
+          && compatible(method.getParameterTypes(), arguments)) {
+        return invokeMethod(method, requireStatic ? null : target, arguments);
+      }
+    }
+    throw new IOException("Cannot invoke " + type.getName() + "." + name);
+  }
+
+  private static Object invoke(Class<?> type, Object target, String name, Class<?>[] parameters,
+      Object... arguments) throws IOException {
+    try {
+      Method method = type.getMethod(name, parameters);
+      return invokeMethod(method, target, arguments);
+    } catch (NoSuchMethodException ex) {
+      try {
+        Method method = type.getDeclaredMethod(name, parameters);
+        return invokeMethod(method, target, arguments);
+      } catch (NoSuchMethodException nested) {
+        throw new IOException("Cannot invoke " + type.getName() + "." + name, nested);
+      }
+    }
+  }
+
+  private static Object invokeMethod(Method method, Object target, Object... arguments)
+      throws IOException {
+    try {
+      if (!method.isAccessible()) {
+        method.setAccessible(true);
+      }
+      return method.invoke(target, arguments);
+    } catch (IllegalAccessException ex) {
+      throw new IOException("Cannot access " + method, ex);
+    } catch (InvocationTargetException ex) {
+      Throwable cause = ex.getCause();
+      if (cause instanceof IOException) {
+        throw (IOException) cause;
+      }
+      throw new IOException("Invocation failed for " + method, cause);
+    } catch (RuntimeException ex) {
+      throw new IOException("Invocation failed for " + method, ex);
+    }
+  }
+
+  private static boolean compatible(Class<?>[] parameters, Object[] arguments) {
+    for (int i = 0; i < parameters.length; i++) {
+      if (arguments[i] == null) {
+        if (parameters[i].isPrimitive()) return false;
+      } else if (!box(parameters[i]).isInstance(arguments[i])) {
+        return false;
+      }
+    }
+    return true;
+  }
+
+  private static Class<?> box(Class<?> type) {
+    if (!type.isPrimitive()) return type;
+    if (type == boolean.class) return Boolean.class;
+    if (type == byte.class) return Byte.class;
+    if (type == short.class) return Short.class;
+    if (type == int.class) return Integer.class;
+    if (type == long.class) return Long.class;
+    if (type == char.class) return Character.class;
+    if (type == float.class) return Float.class;
+    if (type == double.class) return Double.class;
+    return type;
+  }
+
+  private static final class Entry {
+    final byte[] shape;
+    final byte[] payload;
+
+    Entry(byte[] shape, byte[] payload) {
+      this.shape = shape;
+      this.payload = payload;
+    }
+  }
+
+  private static final class Fingerprint {
+    final byte[] bytes;
+
+    Fingerprint(byte[] bytes) {
+      this.bytes = bytes;
+    }
+
+    @Override public boolean equals(Object object) {
+      return object instanceof Fingerprint && Arrays.equals(bytes, ((Fingerprint) object).bytes);
+    }
+
+    @Override public int hashCode() {
+      return Arrays.hashCode(bytes);
+    }
+  }
+}
