new file mode 100644
index 0000000..32ae7a0
--- /dev/null
+++ b/serial/src/org/immutables/serial/Binary.java
@@ -0,0 +1,358 @@
+package org.immutables.serial;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.DataInput;
+import java.io.DataInputStream;
+import java.io.DataOutput;
+import java.io.DataOutputStream;
+import java.io.EOFException;
+import java.io.IOException;
+import java.lang.reflect.Array;
+import java.lang.reflect.InvocationTargetException;
+import java.lang.reflect.Method;
+import java.nio.charset.StandardCharsets;
+import java.util.AbstractMap;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Runtime support for compact binary forms generated by the value processor. */
+public final class Binary {
+  private static final int MAGIC = 0x494D4249;
+  private static final int VERSION = 1;
+  private static final int MAX_FIELD_SIZE = 256 * 1024 * 1024;
+
+  public static final int BOOLEAN = 1;
+  public static final int BYTE = 2;
+  public static final int SHORT = 3;
+  public static final int INT = 4;
+  public static final int LONG = 5;
+  public static final int CHAR = 6;
+  public static final int FLOAT = 7;
+  public static final int DOUBLE = 8;
+  public static final int STRING = 9;
+  public static final int ENUM = 10;
+  public static final int NESTED = 11;
+
+  public static final int LIST = 20;
+  public static final int SET = 21;
+  public static final int SORTED_SET = 22;
+  public static final int MULTISET = 23;
+  public static final int SORTED_MULTISET = 24;
+  public static final int MAP = 25;
+  public static final int SORTED_MAP = 26;
+  public static final int BIMAP = 27;
+  public static final int MULTIMAP = 28;
+  public static final int LIST_MULTIMAP = 29;
+  public static final int SET_MULTIMAP = 30;
+  public static final int OPTIONAL = 40;
+  public static final int OPTIONAL_INT = 41;
+  public static final int OPTIONAL_LONG = 42;
+  public static final int OPTIONAL_DOUBLE = 43;
+  public static final int ARRAY = 50;
+
+  private Binary() {}
+
+  public static int shape(int kind, int element, int secondary) {
+    return kind | (element << 8) | (secondary << 16);
+  }
+
+  public static final class Writer {
+    private final DataOutput output;
+    private int remaining;
+
+    public Writer(DataOutput output, int fields) throws IOException {
+      this.output = output;
+      this.remaining = fields;
+      output.writeInt(MAGIC);
+      output.writeByte(VERSION);
+      output.writeInt(fields);
+    }
+
+    public void write(long id, int shape, Object value) throws IOException {
+      if (remaining <= 0) {
+        throw new IOException("Too many binary fields");
+      }
+      ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+      DataOutputStream data = new DataOutputStream(bytes);
+      writeValue(data, shape, value);
+      data.flush();
+      byte[] payload = bytes.toByteArray();
+      output.writeLong(id);
+      output.writeInt(shape);
+      output.writeInt(payload.length);
+      output.write(payload);
+      remaining--;
+    }
+
+    public void finish() throws IOException {
+      if (remaining != 0) {
+        throw new IOException("Missing binary fields: " + remaining);
+      }
+    }
+  }
+
+  public static final class Reader {
+    private final Map<Field, byte[]> fields = new HashMap<>();
+
+    public Reader(DataInput input) throws IOException {
+      if (input.readInt() != MAGIC) {
+        throw new IOException("Not an Immutables binary value");
+      }
+      int version = input.readUnsignedByte();
+      if (version != VERSION) {
+        throw new IOException("Unsupported Immutables binary version: " + version);
+      }
+      int count = input.readInt();
+      if (count < 0) {
+        throw new IOException("Negative binary field count");
+      }
+      for (int i = 0; i < count; i++) {
+        long id = input.readLong();
+        int shape = input.readInt();
+        int length = input.readInt();
+        if (length < 0 || length > MAX_FIELD_SIZE) {
+          throw new IOException("Invalid binary field length: " + length);
+        }
+        byte[] payload = new byte[length];
+        input.readFully(payload);
+        fields.put(new Field(id, shape), payload);
+      }
+    }
+
+    public boolean has(long id, int shape) {
+      return fields.containsKey(new Field(id, shape));
+    }
+
+    public Object read(long id, int shape, Class<?> elementType, Class<?> secondaryType)
+        throws IOException {
+      byte[] payload = fields.get(new Field(id, shape));
+      if (payload == null) {
+        throw new EOFException("Missing binary field");
+      }
+      DataInputStream input = new DataInputStream(new ByteArrayInputStream(payload));
+      Object value = readValue(input, shape, elementType, secondaryType);
+      if (input.available() != 0) {
+        throw new IOException("Trailing binary field data");
+      }
+      return value;
+    }
+
+    public DataInput nested(long id, int shape) throws IOException {
+      byte[] payload = fields.get(new Field(id, shape));
+      if (payload == null) {
+        throw new EOFException("Missing nested binary field");
+      }
+      DataInputStream input = new DataInputStream(new ByteArrayInputStream(payload));
+      if (!input.readBoolean()) {
+        return null;
+      }
+      return input;
+    }
+  }
+
+  private static final class Field {
+    final long id;
+    final int shape;
+
+    Field(long id, int shape) {
+      this.id = id;
+      this.shape = shape;
+    }
+
+    @Override public boolean equals(Object other) {
+      if (!(other instanceof Field)) return false;
+      Field field = (Field) other;
+      return id == field.id && shape == field.shape;
+    }
+
+    @Override public int hashCode() {
+      return (int) (id ^ (id >>> 32)) * 31 + shape;
+    }
+  }
+
+  private static void writeValue(DataOutput output, int shape, Object value) throws IOException {
+    int kind = shape & 0xff;
+    int element = (shape >>> 8) & 0xff;
+    int secondary = (shape >>> 16) & 0xff;
+    output.writeBoolean(value != null);
+    if (value == null) return;
+
+    if (kind <= ENUM) {
+      writeScalar(output, kind, value);
+    } else if (kind == NESTED) {
+      writeNested(output, value);
+    } else if (kind == OPTIONAL || kind == OPTIONAL_INT
+        || kind == OPTIONAL_LONG || kind == OPTIONAL_DOUBLE) {
+      writeScalar(output, element, value);
+    } else if (kind == ARRAY) {
+      int length = Array.getLength(value);
+      output.writeInt(length);
+      for (int i = 0; i < length; i++) {
+        writeNullableScalar(output, element, Array.get(value, i));
+      }
+    } else if (kind >= LIST && kind <= SORTED_MULTISET) {
+      Iterable<?> values = (Iterable<?>) value;
+      List<Object> copy = new ArrayList<>();
+      for (Object item : values) copy.add(item);
+      output.writeInt(copy.size());
+      for (Object item : copy) writeNullableScalar(output, element, item);
+    } else if (kind >= MAP && kind <= SET_MULTIMAP) {
+      Iterable<?> entries = (Iterable<?>) value;
+      List<Object> copy = new ArrayList<>();
+      for (Object entry : entries) copy.add(entry);
+      output.writeInt(copy.size());
+      for (Object item : copy) {
+        Map.Entry<?, ?> entry = (Map.Entry<?, ?>) item;
+        writeNullableScalar(output, element, entry.getKey());
+        writeNullableScalar(output, secondary, entry.getValue());
+      }
+    } else {
+      throw new IOException("Unsupported binary shape: " + shape);
+    }
+  }
+
+  private static Object readValue(
+      DataInput input, int shape, Class<?> elementType, Class<?> secondaryType) throws IOException {
+    int kind = shape & 0xff;
+    int element = (shape >>> 8) & 0xff;
+    int secondary = (shape >>> 16) & 0xff;
+    if (!input.readBoolean()) return null;
+
+    if (kind <= ENUM) {
+      return readScalar(input, kind, elementType);
+    } else if (kind == OPTIONAL || kind == OPTIONAL_INT
+        || kind == OPTIONAL_LONG || kind == OPTIONAL_DOUBLE) {
+      return readScalar(input, element, elementType);
+    } else if (kind == ARRAY) {
+      int length = readLength(input);
+      Object array = Array.newInstance(elementType, length);
+      for (int i = 0; i < length; i++) {
+        Array.set(array, i, readNullableScalar(input, element, elementType));
+      }
+      return array;
+    } else if (kind >= LIST && kind <= SORTED_MULTISET) {
+      int length = readLength(input);
+      List<Object> values = new ArrayList<>(length);
+      for (int i = 0; i < length; i++) {
+        values.add(readNullableScalar(input, element, elementType));
+      }
+      if (kind == SORTED_SET) return new java.util.TreeSet<>(values);
+      if (kind == SORTED_MULTISET) return immutableSortedMultiset(values);
+      return values;
+    } else if (kind >= MAP && kind <= SET_MULTIMAP) {
+      int length = readLength(input);
+      List<Map.Entry<Object, Object>> entries = new ArrayList<>(length);
+      for (int i = 0; i < length; i++) {
+        Object key = readNullableScalar(input, element, elementType);
+        Object value = readNullableScalar(input, secondary, secondaryType);
+        entries.add(new AbstractMap.SimpleImmutableEntry<>(key, value));
+      }
+      if (kind == SORTED_MAP) {
+        java.util.SortedMap<Object, Object> map = new java.util.TreeMap<>();
+        for (Map.Entry<Object, Object> entry : entries) map.put(entry.getKey(), entry.getValue());
+        return map;
+      }
+      return entries;
+    }
+    throw new IOException("Unsupported binary shape: " + shape);
+  }
+
+  private static Object immutableSortedMultiset(List<Object> values) throws IOException {
+    try {
+      Class<?> type = Class.forName("com.Capella.common.collect.ImmutableSortedMultiset");
+      return type.getMethod("copyOf", Iterable.class).invoke(null, values);
+    } catch (ClassNotFoundException | NoSuchMethodException | IllegalAccessException ex) {
+      throw new IOException("Cannot construct sorted multiset", ex);
+    } catch (InvocationTargetException ex) {
+      throw new IOException("Cannot construct sorted multiset", ex.getCause());
+    }
+  }
+
+  private static int readLength(DataInput input) throws IOException {
+    int length = input.readInt();
+    if (length < 0 || length > MAX_FIELD_SIZE) {
+      throw new IOException("Invalid binary item count: " + length);
+    }
+    return length;
+  }
+
+  private static void writeNullableScalar(DataOutput output, int kind, Object value)
+      throws IOException {
+    output.writeBoolean(value != null);
+    if (value != null) writeScalar(output, kind, value);
+  }
+
+  private static Object readNullableScalar(DataInput input, int kind, Class<?> type)
+      throws IOException {
+    return input.readBoolean() ? readScalar(input, kind, type) : null;
+  }
+
+  private static void writeScalar(DataOutput output, int kind, Object value) throws IOException {
+    switch (kind) {
+    case BOOLEAN: output.writeBoolean((Boolean) value); return;
+    case BYTE: output.writeByte((Byte) value); return;
+    case SHORT: output.writeShort((Short) value); return;
+    case INT: output.writeInt((Integer) value); return;
+    case LONG: output.writeLong((Long) value); return;
+    case CHAR: output.writeChar((Character) value); return;
+    case FLOAT: output.writeFloat((Float) value); return;
+    case DOUBLE: output.writeDouble((Double) value); return;
+    case STRING: writeString(output, (String) value); return;
+    case ENUM: writeString(output, ((Enum<?>) value).name()); return;
+    default: throw new IOException("Unsupported binary scalar: " + kind);
+    }
+  }
+
+  @SuppressWarnings({"unchecked", "rawtypes"})
+  private static Object readScalar(DataInput input, int kind, Class<?> type) throws IOException {
+    switch (kind) {
+    case BOOLEAN: return input.readBoolean();
+    case BYTE: return input.readByte();
+    case SHORT: return input.readShort();
+    case INT: return input.readInt();
+    case LONG: return input.readLong();
+    case CHAR: return input.readChar();
+    case FLOAT: return input.readFloat();
+    case DOUBLE: return input.readDouble();
+    case STRING: return readString(input);
+    case ENUM:
+      String name = readString(input);
+      try {
+        return Enum.valueOf((Class<? extends Enum>) type, name);
+      } catch (IllegalArgumentException ex) {
+        throw new IOException("Unknown enum constant " + name + " for " + type.getName(), ex);
+      }
+    default: throw new IOException("Unsupported binary scalar: " + kind);
+    }
+  }
+
+  private static void writeString(DataOutput output, String value) throws IOException {
+    byte[] bytes = value.getBytes(StandardCharsets.UTF_8);
+    output.writeInt(bytes.length);
+    output.write(bytes);
+  }
+
+  private static String readString(DataInput input) throws IOException {
+    int length = readLength(input);
+    byte[] bytes = new byte[length];
+    input.readFully(bytes);
+    return new String(bytes, StandardCharsets.UTF_8);
+  }
+
+  private static void writeNested(DataOutput output, Object value) throws IOException {
+    try {
+      Method method = value.getClass().getMethod("writeTo", DataOutput.class);
+      method.setAccessible(true);
+      method.invoke(value, output);
+    } catch (NoSuchMethodException | IllegalAccessException ex) {
+      throw new IOException("Nested immutable has no accessible binary form", ex);
+    } catch (InvocationTargetException ex) {
+      Throwable cause = ex.getCause();
+      if (cause instanceof IOException) throw (IOException) cause;
+      throw new IOException("Cannot write nested immutable", cause);
+    }
+  }
+}
diff --git a/serial/test/org/immutables/serial/fixture/BinaryFixtures.java b/serial/test/org/immutables/serial/fixture/BinaryFixtures.java
