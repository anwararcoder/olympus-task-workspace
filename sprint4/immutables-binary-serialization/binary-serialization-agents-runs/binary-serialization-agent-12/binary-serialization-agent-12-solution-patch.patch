@@ -0,0 +1,156 @@
+package org.immutables.serial.fixture;
+
+import com.Capella.common.collect.BiMap;
+import com.Capella.common.collect.ListMultimap;
+import com.Capella.common.collect.Multimap;
+import com.Capella.common.collect.Multiset;
+import com.Capella.common.collect.SetMultimap;
+import java.io.DataOutput;
+import java.io.IOException;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.OptionalDouble;
+import java.util.OptionalInt;
+import java.util.OptionalLong;
+import java.util.Set;
+import java.util.SortedMap;
+import java.util.SortedSet;
+import org.immutables.value.Value;
+
+@Value.Immutable
+interface BinaryCollections {
+  enum Mode { FIRST, SECOND }
+
+  int number();
+  Integer boxed();
+  String text();
+  Mode mode();
+  Optional<String> optional();
+  com.Capella.common.base.Optional<Mode> guavaOptional();
+  OptionalInt optionalInt();
+  OptionalLong optionalLong();
+  OptionalDouble optionalDouble();
+  int[] primitiveArray();
+  String[] stringArray();
+  Mode[] enumArray();
+  List<String> list();
+  Set<Integer> set();
+  @Value.NaturalOrder SortedSet<Mode> sortedSet();
+  Multiset<String> multiset();
+  Map<String, Integer> map();
+  @Value.NaturalOrder SortedMap<Mode, String> sortedMap();
+  BiMap<String, Integer> bimap();
+  Multimap<String, Integer> multimap();
+  ListMultimap<String, Integer> listMultimap();
+  SetMultimap<String, Integer> setMultimap();
+}
+
+@Value.Immutable(builder = false)
+interface BinaryConstructorA {
+  @Value.Parameter int count();
+  @Value.Parameter List<String> names();
+  @Value.Parameter Set<Integer> numbers();
+  @Value.Parameter Map<String, BinaryCollections.Mode> modes();
+  @Value.Parameter Optional<String> note();
+}
+
+@Value.Immutable(builder = false)
+interface BinaryConstructorB {
+  @Value.Parameter Optional<String> note();
+  @Value.Parameter Map<String, BinaryCollections.Mode> modes();
+  @Value.Parameter Set<Integer> numbers();
+  @Value.Parameter List<String> names();
+  @Value.Parameter int count();
+  @Value.Parameter OptionalLong added();
+}
+
+@Value.Immutable
+interface BinaryOrderA {
+  int count();
+  String shared();
+}
+
+@Value.Immutable
+interface BinaryOrderB {
+  String shared();
+  int count();
+}
+
+@Value.Immutable
+interface BinaryMismatchA {
+  int count();
+  Optional<String> oldName();
+  String shared();
+}
+
+@Value.Immutable
+interface BinaryMismatchB {
+  long count();
+  Optional<String> newName();
+  String shared();
+}
+
+@Value.Immutable
+interface BinaryNestedA {
+  int value();
+}
+
+@Value.Immutable
+interface BinaryNestedB {
+  Optional<String> added();
+  int value();
+}
+
+@Value.Immutable
+interface BinaryOuterA {
+  BinaryNestedA nested();
+  String tail();
+}
+
+@Value.Immutable
+interface BinaryOuterB {
+  String tail();
+  BinaryNestedB nested();
+}
+
+@Value.Immutable
+interface BinaryConflict {
+  int value();
+
+  default void writeTo(DataOutput output) throws IOException {
+    output.writeInt(value());
+  }
+}
+
+@Value.Immutable
+interface BinaryUnsupported {
+  Object value();
+}
+
+@Value.Immutable
+interface BinaryRecursive {
+  BinaryRecursive next();
+}
+
+@Value.Immutable
+interface BinaryRequiredAuxiliary {
+  int value();
+  @Value.Auxiliary String requiredAuxiliary();
+}
+
+@Value.Immutable
+interface BinaryOptionalAuxiliary {
+  int value();
+  @Value.Auxiliary Optional<String> optionalAuxiliary();
+}
+
+@Value.Immutable
+interface BinaryGeneric<T> {
+  int value();
+}
+
+@Value.Immutable
+interface BinaryGenericOuter {
+  BinaryGeneric<String> nested();
+}
diff --git a/serial/test/org/immutables/serial/fixture/BinaryTest.java b/serial/test/org/immutables/serial/fixture/BinaryTest.java
