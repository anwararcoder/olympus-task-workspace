diff --git a/value-processor/src/org/immutables/value/processor/meta/BinaryEncoding.java b/value-processor/src/org/immutables/value/processor/meta/BinaryEncoding.java
new file mode 100644
index 0000000..2e195d9
--- /dev/null
+++ b/value-processor/src/org/immutables/value/processor/meta/BinaryEncoding.java
@@ -0,0 +1,352 @@
+package org.immutables.value.processor.meta;
+
+import com.Capella.common.collect.ImmutableList;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+import javax.lang.model.element.ElementKind;
+import javax.lang.model.element.ExecutableElement;
+import javax.lang.model.element.TypeElement;
+import javax.lang.model.type.ArrayType;
+import javax.lang.model.type.DeclaredType;
+import javax.lang.model.type.TypeKind;
+import javax.lang.model.type.TypeMirror;
+import javax.lang.model.util.ElementFilter;
+
+/** Eligibility and schema model for generated compact binary forms. */
+public final class BinaryEncoding {
+  private enum State { NEW, COMPUTING, ENABLED, DISABLED }
+
+  private final ValueType type;
+  private State state = State.NEW;
+  private ImmutableList<Attribute> attributes = ImmutableList.of();
+  private long schema;
+
+  BinaryEncoding(ValueType type) {
+    this.type = type;
+  }
+
+  public boolean isEnabled() {
+    compute();
+    return state == State.ENABLED;
+  }
+
+  public List<Attribute> attributes() {
+    compute();
+    return attributes;
+  }
+
+  long schema() {
+    compute();
+    return schema;
+  }
+
+  private void compute() {
+    if (state != State.NEW) return;
+    state = State.COMPUTING;
+
+    if ((!type.isUseBuilder() && !type.isUseConstructor()) || hasConflictingMethod()) {
+      disable();
+      return;
+    }
+
+    List<ValueAttribute> stored = new ArrayList<ValueAttribute>();
+    for (ValueAttribute value : type.getImplementedAttributes()) {
+      if (value.isGenerateDerived) continue;
+      if (value.isAuxiliary()) {
+        if (value.isMandatory()) {
+          disable();
+          return;
+        }
+        continue;
+      }
+      stored.add(value);
+    }
+
+    if (!type.isUseBuilder()) {
+      Set<ValueAttribute> parameters = type.getConstructorArguments();
+      if (!parameters.containsAll(stored) || stored.size() != parameters.size()) {
+        disable();
+        return;
+      }
+      for (ValueAttribute value : stored) {
+        if (value.isGenerateDefault || value.isArrayType() || value.attributeValueType != null) {
+          disable();
+          return;
+        }
+      }
+    }
+
+    List<Attribute> encodings = new ArrayList<Attribute>();
+    Set<Long> ids = new HashSet<Long>();
+    for (ValueAttribute value : stored) {
+      String descriptor = descriptor(value);
+      if (descriptor == null) {
+        disable();
+        return;
+      }
+      long id = hash(value.name());
+      if (!ids.add(id)) {
+        disable();
+        return;
+      }
+      String shape = shapePart(descriptor);
+      encodings.add(new Attribute(value, id, hash(shape), descriptor));
+    }
+
+    Collections.sort(encodings, Comparator.comparingLong(Attribute::id));
+    StringBuilder structural = new StringBuilder();
+    for (Attribute attribute : encodings) {
+      structural.append(Long.toHexString(attribute.id))
+          .append(':')
+          .append(Long.toHexString(attribute.shape))
+          .append(';');
+    }
+    schema = hash(structural.toString());
+    attributes = ImmutableList.copyOf(encodings);
+    state = State.ENABLED;
+  }
+
+  private void disable() {
+    attributes = ImmutableList.of();
+    state = State.DISABLED;
+  }
+
+  private boolean hasConflictingMethod() {
+    TypeElement dataInput = elements().getTypeElement("java.io.DataInput");
+    TypeElement dataOutput = elements().getTypeElement("java.io.DataOutput");
+    if (dataInput == null || dataOutput == null) return true;
+    for (ExecutableElement method : ElementFilter.methodsIn(
+        elements().getAllMembers(CachingElements.getDelegate((TypeElement) type.element)))) {
+      if (method.getParameters().size() != 1) continue;
+      TypeMirror parameter = method.getParameters().get(0).asType();
+      if (method.getSimpleName().contentEquals("writeTo")
+          && types().isSameType(parameter, dataOutput.asType())) {
+        return true;
+      }
+      if (method.getSimpleName().contentEquals("readFrom")
+          && types().isSameType(parameter, dataInput.asType())) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  private String descriptor(ValueAttribute value) {
+    AttributeTypeKind kind = value.typeKind();
+    if (kind.isRegular()) {
+      String raw = value.getRawType();
+      if (("java.util.SortedSet".equals(raw) || "java.util.NavigableSet".equals(raw))) {
+        String element = scalar(value.firstTypeParameter());
+        return element != null ? "Q(" + element + ")" : null;
+      }
+      if (("java.util.SortedMap".equals(raw) || "java.util.NavigableMap".equals(raw))) {
+        String key = scalar(value.firstTypeParameter());
+        String element = scalar(value.secondTypeParameter());
+        return key != null && element != null ? "R(" + key + "," + element + ")" : null;
+      }
+      if ("com.Capella.common.collect.SortedMultiset".equals(raw)
+          || "com.Capella.common.collect.ImmutableSortedMultiset".equals(raw)) {
+        String element = scalar(value.firstTypeParameter());
+        return element != null ? "V(" + element + ")" : null;
+      }
+      String scalar = scalar(value.returnType);
+      if (scalar != null) return scalar;
+      ValueType nestedType = nestedType(value);
+      if (nestedType != null) {
+        BinaryEncoding nested = nestedType.binary();
+        if (nested.state == State.COMPUTING || !nested.isEnabled()) return null;
+        return "N@" + nestedType.typeImmutable().absoluteRaw();
+      }
+      return null;
+    }
+    if (kind.isArray()) {
+      TypeMirror component = ((ArrayType) value.returnType).getComponentType();
+      if (component.getKind() == TypeKind.ARRAY) return null;
+      String scalar = scalar(component);
+      return scalar != null ? "A(" + scalar + ")" : null;
+    }
+    if (kind.isOptionalSpecializedJdk()) {
+      switch (kind) {
+      case OPTIONAL_INT_JDK: return "OI(i)";
+      case OPTIONAL_LONG_JDK: return "OJ(j)";
+      case OPTIONAL_DOUBLE_JDK: return "OD(d)";
+      default: return null;
+      }
+    }
+    if (kind.isOptionalJdk() || kind.isOptionalGuava()) {
+      String element = scalar(value.firstTypeParameter());
+      if (element == null) return null;
+      return (kind.isOptionalJdk() ? "OU(" : "OG(") + element + ")";
+    }
+    if (kind.isCollectionKind() && !kind.isCustomCollection()) {
+      String element = scalar(value.firstTypeParameter());
+      if (element == null) return null;
+      return collectionCode(kind) + "(" + element + ")";
+    }
+    if (kind.isMappingKind()) {
+      String key = scalar(value.firstTypeParameter());
+      String element = scalar(value.secondTypeParameter());
+      if (key == null || element == null) return null;
+      return mappingCode(kind) + "(" + key + "," + element + ")";
+    }
+    return null;
+  }
+
+  private ValueType nestedType(ValueAttribute value) {
+    if (value.attributeValueType != null) return value.attributeValueType;
+    if (value.containedTypeElement == null) return null;
+    if (CachingElements.equals(value.containedTypeElement, type.element)) return type;
+    Proto.Environment environment = type.constitution.protoclass().environment();
+    for (Proto.Protoclass protoclass : environment.protoclassesFrom(
+        Collections.singleton(value.containedTypeElement))) {
+      if (protoclass.kind().isRecord()
+          || protoclass.kind().isDefinedValue()
+          || protoclass.kind().isModifiable()
+          || protoclass.kind().isJavaBean()) {
+        return environment.composeValue(protoclass);
+      }
+      break;
+    }
+    return null;
+  }
+
+  private String scalar(TypeMirror mirror) {
+    if (mirror.getKind().isPrimitive()) return primitive(mirror.getKind());
+    if (mirror.getKind() != TypeKind.DECLARED) return null;
+    TypeElement element = (TypeElement) ((DeclaredType) mirror).asElement();
+    return scalarElement(element);
+  }
+
+  private String scalar(String name) {
+    if (name.indexOf('<') >= 0 || name.indexOf('?') >= 0 || name.endsWith("[]")) return null;
+    switch (name) {
+    case "boolean": return "z";
+    case "byte": return "b";
+    case "char": return "c";
+    case "short": return "s";
+    case "int": return "i";
+    case "long": return "j";
+    case "float": return "f";
+    case "double": return "d";
+    default:
+    }
+    TypeElement element = elements().getTypeElement(name);
+    return element != null ? scalarElement(element) : null;
+  }
+
+  private String scalarElement(TypeElement element) {
+    String name = element.getQualifiedName().toString();
+    if (name.equals(String.class.getName())) return "T";
+    if (name.equals(Boolean.class.getName())) return "Z";
+    if (name.equals(Byte.class.getName())) return "B";
+    if (name.equals(Character.class.getName())) return "C";
+    if (name.equals(Short.class.getName())) return "H";
+    if (name.equals(Integer.class.getName())) return "I";
+    if (name.equals(Long.class.getName())) return "J";
+    if (name.equals(Float.class.getName())) return "F";
+    if (name.equals(Double.class.getName())) return "D";
+    if (element.getKind() == ElementKind.ENUM) return "E:" + name;
+    return null;
+  }
+
+  private static String primitive(TypeKind kind) {
+    switch (kind) {
+    case BOOLEAN: return "z";
+    case BYTE: return "b";
+    case CHAR: return "c";
+    case SHORT: return "s";
+    case INT: return "i";
+    case LONG: return "j";
+    case FLOAT: return "f";
+    case DOUBLE: return "d";
+    default: return null;
+    }
+  }
+
+  private static String collectionCode(AttributeTypeKind kind) {
+    switch (kind) {
+    case LIST: return "L";
+    case SET: case ENUM_SET: return "S";
+    case SORTED_SET: return "Q";
+    case MULTISET: return "U";
+    case SORTED_MULTISET: return "V";
+    default: throw new AssertionError(kind);
+    }
+  }
+
+  private static String mappingCode(AttributeTypeKind kind) {
+    switch (kind) {
+    case MAP: case ENUM_MAP: return "M";
+    case SORTED_MAP: return "R";
+    case BI_MAP: return "K";
+    case MULTIMAP: return "X";
+    case LIST_MULTIMAP: return "Y";
+    case SET_MULTIMAP: return "W";
+    default: throw new AssertionError(kind);
+    }
+  }
+
+  private static String shapePart(String descriptor) {
+    if (descriptor.startsWith("N@")) return "N";
+    int implementation = descriptor.indexOf('@');
+    return implementation >= 0 ? descriptor.substring(0, implementation) : descriptor;
+  }
