+    }
+
+    private Scalar scalar(TypeMirror mirror, boolean nullable) {
+      if (mirror.getKind().isPrimitive()) return scalarForName(mirror.toString(), false);
+      if (mirror.getKind() != TypeKind.DECLARED) return null;
