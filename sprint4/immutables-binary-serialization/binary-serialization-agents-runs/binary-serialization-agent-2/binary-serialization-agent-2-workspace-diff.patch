+      Set<ValueAttribute> constructorArguments = type.getConstructorArguments();
+      ArrayList<Attribute> attributes = new ArrayList<>();
+      Set<String> identities = new HashSet<>();
+      for (ValueAttribute attribute : type.getSettableAttributes()) {
+        if (attribute.isAuxiliary()) continue;
+        if (constructor && !constructorArguments.contains(attribute)) return disable(type);
