+        if (scalar == null) return null;
+        return new Shape("optional(" + scalar.kind + ")", "optional", scalar.kind, 0,
+            scalar.enumClass, "null", "null", null, true);
+      }
+      if (kind.isCollectionKind()) {
+        if (attribute.isNullable() || arguments.size() != 1) return null;
+        Scalar scalar = scalar(arguments.get(0), false);
+        if (scalar == null) return null;
+        boolean constructorSupported = kind.isList() || kind.isSet();
+        return new Shape(kind.name() + "(" + scalar.kind + ")", "collection", scalar.kind, 0,
+            scalar.enumClass, "null", "null", null, constructorSupported);
+      }
+      if (kind.isMappingKind()) {
+        if (attribute.isNullable() || arguments.size() != 2) return null;
+        Scalar key = scalar(arguments.get(0), false);
+        Scalar value = scalar(arguments.get(1), false);
+        if (key == null || value == null) return null;
+        boolean constructorSupported = kind.isPlainMapKind() || kind.isSortedMap();
