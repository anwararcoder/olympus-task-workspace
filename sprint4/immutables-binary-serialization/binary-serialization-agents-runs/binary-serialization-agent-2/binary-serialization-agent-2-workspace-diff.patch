+package org.immutables.value.processor.meta;
+
+import com.Capella.common.collect.ImmutableList;
+import com.Capella.common.collect.Multimap;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import javax.lang.model.element.ElementKind;
+import javax.lang.model.element.ExecutableElement;
+import javax.lang.model.element.TypeElement;
+import javax.lang.model.type.ArrayType;
+import javax.lang.model.type.DeclaredType;
+import javax.lang.model.type.TypeKind;
+import javax.lang.model.type.TypeMirror;
+import javax.lang.model.util.ElementFilter;
+import javax.lang.model.util.Elements;
+import javax.lang.model.util.Types;
+import org.immutables.value.processor.meta.Proto.DeclaringPackage;
+
+/** Compile-time model for the compact binary form. */
+public final class BinarySerialization {
+  private static final BinarySerialization DISABLED = new BinarySerialization(false, ImmutableList.of());
+
+  private final boolean enabled;
+  private final ImmutableList<Attribute> attributes;
+
+  private BinarySerialization(boolean enabled, ImmutableList<Attribute> attributes) {
+    this.enabled = enabled;
+    this.attributes = attributes;
+  }
+
+  public boolean isEnabled() {
+    return enabled;
+  }
+
+  public ImmutableList<Attribute> getAttributes() {
+    return attributes;
+  }
+
+  public static BinarySerialization disabled() {
+    return DISABLED;
+  }
+
+  public static void configure(Multimap<DeclaringPackage, ValueType> values) {
+    ArrayList<ValueType> all = new ArrayList<>();
+    for (ValueType type : values.values()) collect(type, all);
+    if (all.isEmpty()) return;
+
+    ValueType sample = all.get(0);
+    if (sample.constitution.protoclass().environment().processing()
+        .getElementUtils().getTypeElement("org.immutables.serial.Binary") == null) return;
+
+    Map<String, ValueType> byName = new HashMap<>();
+    for (ValueType type : all) {
+      byName.put(((TypeElement) type.element).getQualifiedName().toString(), type);
+    }
+    Resolver resolver = new Resolver(byName);
+    for (ValueType type : all) resolver.resolve(type);
+  }
+
+  private static void collect(ValueType type, List<ValueType> all) {
+    all.add(type);
+    for (ValueType nested : type.nested) collect(nested, all);
+  }
+
+  public static final class Attribute {
+    private final ValueAttribute attribute;
+    private final long nameHigh;
+    private final long nameLow;
+    private final long shape;
+    private final int elementKind;
+    private final int secondaryKind;
+    private final String elementEnumClass;
+    private final String secondaryEnumClass;
+    private final String arrayComponentClass;
+    private final String nestedImmutableType;
+    private final String category;
+
+    Attribute(ValueAttribute attribute, long nameHigh, long nameLow, long shape,
+        int elementKind, int secondaryKind, String elementEnumClass,
+        String secondaryEnumClass, String arrayComponentClass, String nestedImmutableType,
+        String category) {
+      this.attribute = attribute;
+      this.nameHigh = nameHigh;
+      this.nameLow = nameLow;
+      this.shape = shape;
+      this.elementKind = elementKind;
+      this.secondaryKind = secondaryKind;
+      this.elementEnumClass = elementEnumClass;
+      this.secondaryEnumClass = secondaryEnumClass;
+      this.arrayComponentClass = arrayComponentClass;
+      this.nestedImmutableType = nestedImmutableType;
