+        long high = hash(attribute.name(), 0xcbf29ce484222325L);
+        long low = hash(attribute.name(), 0x84222325cbf29ce4L);
+        String identity = high + ":" + low;
+        if ((high == 0L && low == 0L) || !identities.add(identity)) return disable(type);
