+package org.immutables.serial.fixture;
+
+import com.Capella.common.collect.Multiset;
+import java.io.DataOutput;
+import java.io.IOException;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.OptionalDouble;
+import java.util.OptionalInt;
+import java.util.OptionalLong;
+import java.util.Set;
+import java.util.SortedMap;
+import java.util.SortedSet;
+import org.immutables.value.Value;
+
+interface BinaryCompact {
+  enum First { ALPHA, BETA }
+  enum Second { BETA, ALPHA }
+
+  @Value.Immutable
+  interface BuilderValue {
+    boolean flag();
+    Integer boxed();
+    String longText();
+    First choice();
+    Optional<String> optional();
+    OptionalInt optionalInt();
+    OptionalLong optionalLong();
+    OptionalDouble optionalDouble();
+    String[] names();
+    List<Integer> list();
+    SortedSet<String> sortedSet();
+    Map<String, First> map();
+    SortedMap<Integer, String> sortedMap();
+  }
+
+  @Value.Immutable(builder = false)
+  interface ConstructorValue {
+    @Value.Parameter int number();
+    @Value.Parameter First choice();
+    @Value.Parameter Optional<String> optional();
+    @Value.Parameter List<Integer> list();
+    @Value.Parameter Set<String> set();
+    @Value.Parameter Map<String, Long> map();
+  }
+
+  @Value.Immutable
+  interface Nested {
+    int number();
+    @Value.Default default String label() { return "nested-default"; }
+  }
+
+  @Value.Immutable
+  interface Outer {
+    Nested nested();
+    String following();
+  }
+
+  @Value.Immutable
+  interface VersionOne {
+    int number();
+    String text();
+    First choice();
+    List<Integer> items();
+  }
+
+  @Value.Immutable
+  interface VersionTwo {
+    List<Integer> items();
+    Second choice();
+    String text();
+    int number();
+    @Value.Default default String added() { return "added-default"; }
+  }
+
+  @Value.Immutable
+  interface Mismatched {
+    @Value.Default default long number() { return 44L; }
+    @Value.Default default List<String> items() { return java.util.Collections.emptyList(); }
+    String text();
+    Second choice();
+  }
+
+  @Value.Immutable
+  interface Renamed {
+    @Value.Default default int renamed() { return 77; }
+    String text();
+  }
+
+  @Value.Immutable
+  interface DerivedAuxiliary {
+    int number();
+    @Value.Derived default int doubled() { return number() * 2; }
+    @Value.Auxiliary @Value.Default default Optional<String> note() { return Optional.empty(); }
+  }
+
+  @Value.Immutable
+  interface RequiredAuxiliary {
+    int number();
+    @Value.Auxiliary String requiredAuxiliary();
+  }
+
+  interface WriteConflict {
+    default void writeTo(DataOutput output) throws IOException {}
+  }
+
+  @Value.Immutable
+  interface Conflicting extends WriteConflict {
+    int number();
+  }
+
+  @Value.Immutable
+  interface ReadConflicting {
+    int number();
+    static ReadConflicting readFrom(java.io.DataInput input) { return null; }
+  }
+
+  @Value.Immutable
+  interface Generic<T> {
+    int number();
+  }
+
+  @Value.Immutable
+  interface UnresolvedGeneric<T> {
+    T value();
+  }
+
+  @Value.Immutable
+  interface Unsupported {
+    Object value();
+  }
+
+  @Value.Immutable
+  interface Recursive {
+    Recursive recursive();
+  }
+
+  @Value.Immutable
+  interface UnsupportedContainer {
+    List<List<String>> values();
+  }
+
+  @Value.Immutable(builder = false)
+  interface ConstructorUnsupported {
+    @Value.Parameter Multiset<String> values();
+  }
+}
