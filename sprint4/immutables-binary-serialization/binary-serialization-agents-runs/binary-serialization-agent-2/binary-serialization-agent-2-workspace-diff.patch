+      type.binary = new BinarySerialization(true, ImmutableList.copyOf(attributes));
+      states.put(type, State.ENABLED);
+      return true;
+    }
+
+    private boolean disable(ValueType type) {
+      type.binary = DISABLED;
+      states.put(type, State.DISABLED);
+      return false;
+    }
+
+    private boolean hasRequiredAuxiliary(ValueType type) {
