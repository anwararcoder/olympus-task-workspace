+      }
+      return false;
+    }
+
+    private boolean hasConflict(ValueType type) {
+      Elements elements = type.constitution.protoclass().environment().processing().getElementUtils();
+      Types types = type.constitution.protoclass().environment().processing().getTypeUtils();
+      TypeElement dataInput = elements.getTypeElement("java.io.DataInput");
+      TypeElement dataOutput = elements.getTypeElement("java.io.DataOutput");
+      if (dataInput == null || dataOutput == null) return true;
+      TypeElement sourceType = elements.getTypeElement(((TypeElement) type.element).getQualifiedName());
+      if (sourceType == null) return true;
+      for (ExecutableElement method : ElementFilter.methodsIn(elements.getAllMembers(sourceType))) {
+        if (method.getParameters().size() != 1) continue;
+        String name = method.getSimpleName().toString();
+        TypeMirror parameter = types.erasure(method.getParameters().get(0).asType());
+        if (name.equals("writeTo") && types.isSameType(parameter, types.erasure(dataOutput.asType()))) return true;
+        if (name.equals("readFrom") && types.isSameType(parameter, types.erasure(dataInput.asType()))) return true;
+      }
+      return false;
+    }
+
+    private Shape shape(TypeMirror mirror, ValueAttribute attribute, boolean topLevel) {
+      if (mirror.getKind() == TypeKind.ARRAY) {
