@@ -0,0 +1,159 @@
+package org.immutables.serial.fixture;
+
+import static org.immutables.check.Checkers.check;
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.DataInputStream;
+import java.io.DataOutputStream;
+import java.io.IOException;
+import java.lang.reflect.Method;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.Optional;
+import java.util.OptionalDouble;
+import java.util.OptionalInt;
+import java.util.OptionalLong;
+import java.util.TreeMap;
+import java.util.TreeSet;
+import org.junit.Test;
+
+public class BinaryCompactTest {
+  @Test
+  public void builderRoundTrip() throws Exception {
+    StringBuilder longText = new StringBuilder();
+    for (int i = 0; i < 100_000; i++) longText.append((char) ('a' + i % 26));
+    ImmutableBuilderValue value = ImmutableBuilderValue.builder()
+        .flag(true)
+        .boxed(8)
+        .longText(longText.toString())
+        .choice(BinaryCompact.First.BETA)
+        .optional("present")
+        .optionalInt(OptionalInt.of(2))
+        .optionalLong(OptionalLong.of(3L))
+        .optionalDouble(OptionalDouble.of(4.5))
+        .names("a", null, "b")
+        .addList(1, 2)
+        .sortedSet(new TreeSet<>(Arrays.asList("z", "a")))
+        .putMap("first", BinaryCompact.First.ALPHA)
+        .sortedMap(new TreeMap<>(Collections.singletonMap(2, "two")))
+        .build();
+
+    check(readBuilder(write(value))).is(value);
+  }
+
+  @Test
+  public void existingGuavaShapesRoundTrip() throws Exception {
+    ImmutableStructFromBuilder value = ImmutableStructFromBuilder.builder()
+        .a(1).s("s").array(true, false).addC("c").os(true)
+        .addBag("x", "x", "x")
+        .putIndex(1, "a").putIndexList(1, "a").putIndexList(1, "a")
+        .putIndexSet(2, "b").putBiMap(3, "c").build();
+    check(ImmutableStructFromBuilder.readFrom(input(write(value)))).is(value);
+  }
+
+  @Test
+  public void constructorRoundTrip() throws Exception {
+    ImmutableConstructorValue value = ImmutableConstructorValue.of(
+        3, BinaryCompact.First.ALPHA, Optional.of("x"), Arrays.asList(1, 2),
+        new TreeSet<>(Arrays.asList("a", "b")), Collections.singletonMap("x", 4L));
+    check(ImmutableConstructorValue.readFrom(input(write(value)))).is(value);
+  }
+
+  @Test
+  public void versionsMatchByNameAndShape() throws Exception {
+    ImmutableVersionOne oldValue = ImmutableVersionOne.builder()
+        .number(5).text("later-field").choice(BinaryCompact.First.BETA).addItems(1, 2).build();
+    byte[] oldBytes = write(oldValue);
+    ImmutableVersionTwo newer = ImmutableVersionTwo.readFrom(input(oldBytes));
+    check(newer.number()).is(5);
+    check(newer.text()).is("later-field");
+    check(newer.choice()).is(BinaryCompact.Second.BETA);
+    assertEquals(Arrays.asList(1, 2), newer.items());
+    check(newer.added()).is("added-default");
+
+    ImmutableVersionOne older = ImmutableVersionOne.readFrom(input(write(newer)));
+    check(older).is(oldValue);
+  }
+
+  @Test
+  public void mismatchesAndRenamesAreAbsent() throws Exception {
+    ImmutableVersionOne oldValue = ImmutableVersionOne.builder()
+        .number(5).text("survives").choice(BinaryCompact.First.ALPHA).addItems(1, 2).build();
+    byte[] bytes = write(oldValue);
+
+    ImmutableMismatched mismatched = ImmutableMismatched.readFrom(input(bytes));
+    check(mismatched.number()).is(44L);
+    check(mismatched.items()).isEmpty();
+    check(mismatched.text()).is("survives");
+    check(mismatched.choice()).is(BinaryCompact.Second.ALPHA);
+
+    ImmutableRenamed renamed = ImmutableRenamed.readFrom(input(bytes));
+    check(renamed.renamed()).is(77);
+    check(renamed.text()).is("survives");
+  }
+
+  @Test
+  public void nestedFieldsAreDelimitedAndDerivedRecomputed() throws Exception {
+    ImmutableOuter outer = ImmutableOuter.builder()
+        .nested(ImmutableNested.builder().number(9).label("custom").build())
+        .following("after-nested")
+        .build();
+    check(ImmutableOuter.readFrom(input(write(outer)))).is(outer);
+
+    ImmutableDerivedAuxiliary value = ImmutableDerivedAuxiliary.builder().number(6).build();
+    ImmutableDerivedAuxiliary copy = ImmutableDerivedAuxiliary.readFrom(input(write(value)));
+    check(copy.doubled()).is(12);
+    check(copy.note()).is(Optional.empty());
+  }
+
+  @Test(expected = IOException.class)
+  public void truncatedInputFails() throws Exception {
+    byte[] bytes = write(ImmutableNested.builder().number(1).build());
+    ImmutableNested.readFrom(input(Arrays.copyOf(bytes, bytes.length - 1)));
+  }
+
+  @Test
+  public void conflictsAndUnsupportedShapesHaveNoPair() {
+    assertFalse(hasDeclaredMethod(ImmutableConflicting.class, "readFrom"));
+    assertFalse(hasDeclaredMethod(ImmutableReadConflicting.class, "writeTo"));
+    assertFalse(hasDeclaredMethod(ImmutableUnsupported.class, "writeTo"));
+    assertFalse(hasDeclaredMethod(ImmutableUnresolvedGeneric.class, "writeTo"));
+    assertFalse(hasDeclaredMethod(ImmutableRecursive.class, "writeTo"));
+    assertFalse(hasDeclaredMethod(ImmutableUnsupportedContainer.class, "writeTo"));
+    assertFalse(hasDeclaredMethod(ImmutableRequiredAuxiliary.class, "writeTo"));
+    assertFalse(hasDeclaredMethod(ImmutableConstructorUnsupported.class, "writeTo"));
+    assertTrue(hasDeclaredMethod(ImmutableNested.class, "writeTo"));
+    assertTrue(hasDeclaredMethod(ImmutableGeneric.class, "writeTo"));
+  }
+
+  @Test
+  public void genericTypeWithConcreteStorageRoundTrips() throws Exception {
+    ImmutableGeneric<String> value = ImmutableGeneric.<String>builder().number(4).build();
+    check(ImmutableGeneric.<String>readFrom(input(write(value)))).is(value);
+  }
+
+  private static boolean hasDeclaredMethod(Class<?> type, String name) {
+    for (Method method : type.getDeclaredMethods()) {
+      if (method.getName().equals(name)) return true;
+    }
+    return false;
+  }
+
+  private static byte[] write(org.immutables.serial.Binary.Value value) throws IOException {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    value.writeTo(new DataOutputStream(bytes));
+    return bytes.toByteArray();
+  }
+
+  private static DataInputStream input(byte[] bytes) {
+    return new DataInputStream(new ByteArrayInputStream(bytes));
+  }
+
+  private static ImmutableBuilderValue readBuilder(byte[] bytes) throws IOException {
+    return ImmutableBuilderValue.readFrom(input(bytes));
+  }
+}
diff --git a/test.sh b/test.sh
new file mode 100755
index 0000000..89bb341
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,115 @@
+#!/bin/bash
+set -uo pipefail
+
+INVOKE_DIR="$PWD"
+cd "$(dirname "$0")"
+
+OUTPUT_PATH=""
+MODE=""
+
+while [[ $# -gt 0 ]]; do
+    case "$1" in
+        --output_path)
+            OUTPUT_PATH="$2"
+            shift 2
+            ;;
+        base|new)
+            MODE="$1"
+            shift
+            ;;
+        *)
+            echo "Usage: $0 --output_path <path> {base|new}"
+            exit 1
+            ;;
+    esac
+done
+
+if [[ -n "$OUTPUT_PATH" && "$OUTPUT_PATH" != /* ]]; then
+    OUTPUT_PATH="$INVOKE_DIR/$OUTPUT_PATH"
+fi
+
+if [[ -z "$MODE" ]]; then
+    echo "Usage: $0 --output_path <path> {base|new}"
+    exit 1
+fi
+
+FOCUS_TEST="BinarySerialization_7e2d4f_Test"
+REPORTS="value-fixture/target/surefire-reports"
+TMP="${TMPDIR:-/tmp}/immutables-binary-serialization-mvn-tmp"
+mkdir -p "$TMP"
+export MAVEN_OPTS="-Xmx950m -Djava.io.tmpdir=$TMP"
+MVN="mvn -B -ntp -o -DforkCount=1 -DreuseForks=true -DfailIfNoTests=false"
+LOG="$TMP/maven-$MODE.log"
+
+xml_escape() {
+    sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
+}
+
+run_mvn() {
+    $MVN "$@" 2>&1 | tee "$LOG"
+    return "${PIPESTATUS[0]}"
+}
+
+write_xml() {
+    local fallback="${1:-0}"
+    [[ -z "$OUTPUT_PATH" ]] && return 0
+    : > "$OUTPUT_PATH"
+    echo '<testsuites>' >> "$OUTPUT_PATH"
+    FOUND=0
+    for xml in "$REPORTS"/TEST-*.xml; do
+        if [[ -e "$xml" ]]; then
+            FOUND=1
+            grep -v '<?xml' "$xml" >> "$OUTPUT_PATH"
+        fi
+    done
+    if [[ "$FOUND" -eq 0 && "$fallback" -ne 0 ]]; then
+        case "$MODE" in
+            base)
+                FALLBACK_CLASS="org.immutables.fixture.ValuesTest"
+                FALLBACK_TEST="plainAttributes"
+                ;;
+            new)
+                FALLBACK_CLASS="org.immutables.fixture.binser_9c3f2a.BinarySerialization_7e2d4f_Test"
+                FALLBACK_TEST="scalarRoundTrip"
+                ;;
+        esac
+        cat >> "$OUTPUT_PATH" <<XML
+<testsuite name="$MODE" tests="1" failures="1" errors="0" skipped="0">
+  <testcase name="$FALLBACK_TEST" classname="$FALLBACK_CLASS">
+    <failure message="Maven failed before Surefire reports were produced">
+XML
+        if [[ -f "$LOG" ]]; then
+            tail -n 200 "$LOG" | xml_escape >> "$OUTPUT_PATH"
+        else
+            echo "Maven failed before Surefire reports were produced." >> "$OUTPUT_PATH"
+        fi
+        cat >> "$OUTPUT_PATH" <<XML
+    </failure>
+  </testcase>
+</testsuite>
+XML
+    fi
+    echo '</testsuites>' >> "$OUTPUT_PATH"
+}
+
+rm -rf "$REPORTS"
+
+if ! run_mvn -pl value-fixture -am clean install -DskipTests -Dmaven.test.skip=true; then
+    write_xml 1
+    exit 1
+fi
+
+rm -rf "$REPORTS"
+
+RC=0
+case "$MODE" in
+    base)
+        run_mvn -pl value-fixture test -Dtest="!$FOCUS_TEST" || RC=$?
+        ;;
+    new)
+        run_mvn -pl value-fixture test -Dtest="$FOCUS_TEST" || RC=$?
+        ;;
+esac
+
+write_xml "$RC"
+exit $RC
