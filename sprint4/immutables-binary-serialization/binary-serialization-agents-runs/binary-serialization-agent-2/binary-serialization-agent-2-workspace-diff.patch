+    }
+  }
+
+  private static String classLiteralType(TypeMirror mirror) {
+    return mirror.toString() + ".class";
+  }
+
+  private static long hash(String value, long seed) {
+    long hash = seed;
+    for (int i = 0; i < value.length(); i++) {
+      hash ^= value.charAt(i);
+      hash *= 0x100000001b3L;
+      hash ^= hash >>> 32;
+    }
+    return hash;
+  }
