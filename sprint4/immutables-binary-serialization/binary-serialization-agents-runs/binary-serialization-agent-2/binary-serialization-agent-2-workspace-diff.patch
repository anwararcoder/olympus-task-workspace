+      }
+      Scalar scalar = scalarForName(element.getQualifiedName().toString(), nullable);
+      return scalar;
+    }
+
+    private Scalar scalarForName(String name, boolean nullable) {
+      switch (name) {
+        case "boolean": return new Scalar(1, "null");
+        case "byte": return new Scalar(2, "null");
+        case "short": return new Scalar(3, "null");
+        case "int": return new Scalar(4, "null");
+        case "long": return new Scalar(5, "null");
+        case "char": return new Scalar(6, "null");
+        case "float": return new Scalar(7, "null");
+        case "double": return new Scalar(8, "null");
+        case "java.lang.Boolean": return new Scalar(9, "null");
+        case "java.lang.Byte": return new Scalar(10, "null");
+        case "java.lang.Short": return new Scalar(11, "null");
+        case "java.lang.Integer": return new Scalar(12, "null");
+        case "java.lang.Long": return new Scalar(13, "null");
+        case "java.lang.Character": return new Scalar(14, "null");
+        case "java.lang.Float": return new Scalar(15, "null");
+        case "java.lang.Double": return new Scalar(16, "null");
+        case "java.lang.String": return new Scalar(nullable ? 19 : 17, "null");
+        default: return null;
+      }
+    }
+
+    private String appliedImmutableType(ValueType nested, TypeMirror declared) {
+      StringBuilder builder = new StringBuilder(nested.constitution.typeImmutable().absoluteRaw());
+      if (declared.getKind() == TypeKind.DECLARED) {
+        List<? extends TypeMirror> arguments = ((DeclaredType) declared).getTypeArguments();
+        if (!arguments.isEmpty()) {
+          builder.append('<');
+          for (int i = 0; i < arguments.size(); i++) {
+            if (i > 0) builder.append(", ");
+            builder.append(arguments.get(i));
+          }
+          builder.append('>');
+        }
+      }
+      return builder.toString();
+    }
+  }
+
+  private static final class Scalar {
+    final int kind;
+    final String enumClass;
+    Scalar(int kind, String enumClass) {
+      this.kind = kind;
+      this.enumClass = enumClass;
+    }
+  }
+
+  private static final class Shape {
+    final String canonical;
+    final String category;
+    final int elementKind;
+    final int secondaryKind;
+    final String elementEnumClass;
+    final String secondaryEnumClass;
+    final String arrayComponentClass;
+    final ValueType nested;
+    final boolean constructorSupported;
+
+    Shape(String canonical, String category, int elementKind, int secondaryKind,
+        String elementEnumClass, String secondaryEnumClass, String arrayComponentClass,
+        ValueType nested, boolean constructorSupported) {
+      this.canonical = canonical;
+      this.category = category;
+      this.elementKind = elementKind;
+      this.secondaryKind = secondaryKind;
+      this.elementEnumClass = elementEnumClass;
+      this.secondaryEnumClass = secondaryEnumClass;
+      this.arrayComponentClass = arrayComponentClass;
+      this.nested = nested;
+      this.constructorSupported = constructorSupported;
+    }
+
+    static Shape scalar(Scalar scalar, boolean constructorSupported) {
+      return new Shape("scalar(" + scalar.kind + ")", "scalar", scalar.kind, 0,
