+        if (scalar == null) return null;
+        return new Shape("SORTED_SET(" + scalar.kind + ")", "collection", scalar.kind, 0,
+            scalar.enumClass, "null", "null", null, false);
+      }
+      if ((raw.equals("java.util.SortedMap") || raw.equals("java.util.NavigableMap"))
+          && declared.getTypeArguments().size() == 2 && !attribute.isNullable()) {
+        Scalar key = scalar(declared.getTypeArguments().get(0), false);
+        Scalar value = scalar(declared.getTypeArguments().get(1), false);
+        if (key == null || value == null) return null;
+        return new Shape("SORTED_MAP(" + key.kind + "," + value.kind + ")", "map",
+            key.kind, value.kind, key.enumClass, value.enumClass, "null", null, false);
+      }
