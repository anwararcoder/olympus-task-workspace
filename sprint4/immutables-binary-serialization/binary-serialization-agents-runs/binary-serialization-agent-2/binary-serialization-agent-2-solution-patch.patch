diff --git a/serial/src/org/immutables/serial/Binary.java b/serial/src/org/immutables/serial/Binary.java
new file mode 100644
index 0000000..ff3c687
--- /dev/null
+++ b/serial/src/org/immutables/serial/Binary.java
@@ -0,0 +1,350 @@
+package org.immutables.serial;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.DataInput;
+import java.io.DataInputStream;
+import java.io.DataOutput;
+import java.io.DataOutputStream;
+import java.io.EOFException;
+import java.io.IOException;
+import java.lang.reflect.Array;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.List;
+
+/** Runtime support for compact binary forms generated by the value processor. */
+public final class Binary {
+  private static final int MAGIC = 0x494D4231;
+
+  public static final int BOOLEAN = 1;
+  public static final int BYTE = 2;
+  public static final int SHORT = 3;
+  public static final int INT = 4;
+  public static final int LONG = 5;
+  public static final int CHAR = 6;
+  public static final int FLOAT = 7;
+  public static final int DOUBLE = 8;
+  public static final int BOXED_BOOLEAN = 9;
+  public static final int BOXED_BYTE = 10;
+  public static final int BOXED_SHORT = 11;
+  public static final int BOXED_INT = 12;
+  public static final int BOXED_LONG = 13;
+  public static final int BOXED_CHAR = 14;
+  public static final int BOXED_FLOAT = 15;
+  public static final int BOXED_DOUBLE = 16;
+  public static final int STRING = 17;
+  public static final int ENUM = 18;
+  public static final int NULLABLE_STRING = 19;
+  public static final int NULLABLE_ENUM = 20;
+
+  private Binary() {}
+
+  /** Implemented by generated immutable values that have a compact binary form. */
+  public interface Value {
+    void writeTo(DataOutput output) throws IOException;
+  }
+
+  public static Writer writer(DataOutput output) throws IOException {
+    return new Writer(output);
+  }
+
+  public static Reader reader(DataInput input) throws IOException {
+    return new Reader(input);
+  }
+
+  public static final class Writer {
+    private final DataOutput output;
+    private FieldOutput active;
+
+    private Writer(DataOutput output) throws IOException {
+      this.output = output;
+      output.writeInt(MAGIC);
+    }
+
+    public FieldOutput field(long nameHigh, long nameLow, long shape) {
+      if (active != null) {
+        throw new IllegalStateException("Previous binary field has not been finished");
+      }
+      active = new FieldOutput(this, nameHigh, nameLow, shape);
+      return active;
+    }
+
+    public void finish() throws IOException {
+      if (active != null) {
+        throw new IllegalStateException("Binary field has not been finished");
+      }
+      output.writeLong(0L);
+      output.writeLong(0L);
+    }
+
+    private void finish(FieldOutput field) throws IOException {
+      if (active != field) {
+        throw new IllegalStateException("Binary field is not active");
+      }
+      byte[] payload = field.bytes.toByteArray();
+      output.writeLong(field.nameHigh);
+      output.writeLong(field.nameLow);
+      output.writeLong(field.shape);
+      output.writeInt(payload.length);
+      output.write(payload);
+      active = null;
+    }
+  }
+
+  public static final class FieldOutput {
+    private final Writer writer;
+    private final long nameHigh;
+    private final long nameLow;
+    private final long shape;
+    private final ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    private final DataOutputStream output = new DataOutputStream(bytes);
+    private boolean finished;
+
+    private FieldOutput(Writer writer, long nameHigh, long nameLow, long shape) {
+      this.writer = writer;
+      this.nameHigh = nameHigh;
+      this.nameLow = nameLow;
+      this.shape = shape;
+    }
+
+    public DataOutput output() {
+      return output;
+    }
+
+    public void finish() throws IOException {
+      if (finished) {
+        throw new IllegalStateException("Binary field already finished");
+      }
+      finished = true;
+      output.flush();
+      writer.finish(this);
+    }
+  }
+
+  public static final class Reader {
+    private final DataInput input;
+    private long nameHigh;
+    private long nameLow;
+    private long shape;
+    private DataInputStream field;
+    private boolean ended;
+
+    private Reader(DataInput input) throws IOException {
+      this.input = input;
+      if (input.readInt() != MAGIC) {
+        throw new IOException("Invalid compact binary header");
+      }
+    }
+
+    public boolean next() throws IOException {
+      if (ended) {
+        return false;
+      }
+      nameHigh = input.readLong();
+      nameLow = input.readLong();
+      if (nameHigh == 0L && nameLow == 0L) {
+        ended = true;
+        field = null;
+        return false;
+      }
+      shape = input.readLong();
+      int length = input.readInt();
+      if (length < 0) {
+        throw new IOException("Negative compact binary field length");
+      }
+      byte[] payload = new byte[length];
+      input.readFully(payload);
+      field = new DataInputStream(new ByteArrayInputStream(payload));
+      return true;
+    }
+
+    public boolean matches(long expectedHigh, long expectedLow, long expectedShape) {
+      return nameHigh == expectedHigh && nameLow == expectedLow && shape == expectedShape;
+    }
+
+    public DataInput input() {
+      if (field == null) {
+        throw new IllegalStateException("No current binary field");
+      }
+      return field;
+    }
+
+    public void complete() throws TypeMismatchException {
+      try {
+        if (field == null || field.available() != 0) {
+          throw new TypeMismatchException();
+        }
+      } catch (IOException ex) {
+        throw new TypeMismatchException();
+      }
+    }
+  }
+
+  public static final class TypeMismatchException extends Exception {
+    private static final long serialVersionUID = 1L;
+  }
+
+  public static void writeScalar(DataOutput output, int kind, Object value) throws IOException {
+    switch (kind) {
+      case BOOLEAN: output.writeBoolean((Boolean) value); return;
+      case BYTE: output.writeByte((Byte) value); return;
+      case SHORT: output.writeShort((Short) value); return;
+      case INT: output.writeInt((Integer) value); return;
+      case LONG: output.writeLong((Long) value); return;
+      case CHAR: output.writeChar((Character) value); return;
+      case FLOAT: output.writeFloat((Float) value); return;
+      case DOUBLE: output.writeDouble((Double) value); return;
+      case BOXED_BOOLEAN:
+      case BOXED_BYTE:
+      case BOXED_SHORT:
+      case BOXED_INT:
+      case BOXED_LONG:
+      case BOXED_CHAR:
+      case BOXED_FLOAT:
+      case BOXED_DOUBLE:
+        output.writeBoolean(value != null);
+        if (value != null) writeScalar(output, kind - 8, value);
+        return;
+      case STRING:
+        writeString(output, (String) value);
+        return;
+      case NULLABLE_STRING:
+        output.writeBoolean(value != null);
+        if (value != null) writeString(output, (String) value);
+        return;
+      case ENUM:
+        writeString(output, ((Enum<?>) value).name());
+        return;
+      case NULLABLE_ENUM:
+        output.writeBoolean(value != null);
+        if (value != null) writeString(output, ((Enum<?>) value).name());
+        return;
+      default:
+        throw new IOException("Unsupported compact binary scalar kind " + kind);
+    }
+  }
+
+  public static Object readScalar(DataInput input, int kind, Class<?> enumType)
+      throws IOException, TypeMismatchException {
+    try {
+      switch (kind) {
+        case BOOLEAN: return input.readBoolean();
+        case BYTE: return input.readByte();
+        case SHORT: return input.readShort();
+        case INT: return input.readInt();
+        case LONG: return input.readLong();
+        case CHAR: return input.readChar();
+        case FLOAT: return input.readFloat();
+        case DOUBLE: return input.readDouble();
+        case BOXED_BOOLEAN:
+        case BOXED_BYTE:
+        case BOXED_SHORT:
+        case BOXED_INT:
+        case BOXED_LONG:
+        case BOXED_CHAR:
+        case BOXED_FLOAT:
+        case BOXED_DOUBLE:
+          return input.readBoolean() ? readScalar(input, kind - 8, null) : null;
+        case STRING: return readString(input);
+        case NULLABLE_STRING: return input.readBoolean() ? readString(input) : null;
+        case ENUM: return readEnum(input, enumType);
+        case NULLABLE_ENUM: return input.readBoolean() ? readEnum(input, enumType) : null;
+        default: throw new TypeMismatchException();
+      }
+    } catch (EOFException ex) {
+      throw ex;
+    } catch (ClassCastException | IllegalArgumentException ex) {
+      throw new TypeMismatchException();
+    }
+  }
+
+  public static void writeArray(DataOutput output, int kind, Object array) throws IOException {
+    int length = Array.getLength(array);
+    output.writeInt(length);
+    for (int i = 0; i < length; i++) {
+      writeScalar(output, kind, Array.get(array, i));
+    }
+  }
+
+  public static Object readArray(DataInput input, int kind, Class<?> componentType, Class<?> enumType)
+      throws IOException, TypeMismatchException {
+    int length = readLength(input);
+    Object array = Array.newInstance(componentType, length);
+    for (int i = 0; i < length; i++) {
+      try {
+        Array.set(array, i, readScalar(input, kind, enumType));
+      } catch (IllegalArgumentException ex) {
+        throw new TypeMismatchException();
+      }
+    }
+    return array;
+  }
+
+  public static void writeCollection(DataOutput output, int kind, Iterable<?> values) throws IOException {
+    ArrayList<Object> copy = new ArrayList<>();
+    for (Object value : values) copy.add(value);
+    output.writeInt(copy.size());
+    for (Object value : copy) writeScalar(output, kind, value);
+  }
+
+  public static List<Object> readCollection(DataInput input, int kind, Class<?> enumType)
+      throws IOException, TypeMismatchException {
+    int size = readLength(input);
+    ArrayList<Object> values = new ArrayList<>(size);
+    for (int i = 0; i < size; i++) values.add(readScalar(input, kind, enumType));
+    return values;
+  }
+
+  public static void writeMap(DataOutput output, int keyKind, int valueKind,
+      Iterable<? extends java.util.Map.Entry<?, ?>> entries) throws IOException {
+    ArrayList<java.util.Map.Entry<?, ?>> copy = new ArrayList<>();
+    for (java.util.Map.Entry<?, ?> entry : entries) copy.add(entry);
+    output.writeInt(copy.size());
+    for (java.util.Map.Entry<?, ?> entry : copy) {
+      writeScalar(output, keyKind, entry.getKey());
+      writeScalar(output, valueKind, entry.getValue());
+    }
+  }
+
+  public static List<Object> readMap(DataInput input, int keyKind, Class<?> keyEnum,
+      int valueKind, Class<?> valueEnum) throws IOException, TypeMismatchException {
+    int size = readLength(input);
+    ArrayList<Object> entries = new ArrayList<>(size * 2);
+    for (int i = 0; i < size; i++) {
+      entries.add(readScalar(input, keyKind, keyEnum));
+      entries.add(readScalar(input, valueKind, valueEnum));
+    }
+    return entries;
+  }
+
+  private static int readLength(DataInput input) throws IOException {
+    int length = input.readInt();
+    if (length < 0) throw new IOException("Negative compact binary length");
+    return length;
+  }
+
+  private static void writeString(DataOutput output, String value) throws IOException {
+    byte[] bytes = value.getBytes(StandardCharsets.UTF_8);
+    output.writeInt(bytes.length);
+    output.write(bytes);
+  }
+
+  private static String readString(DataInput input) throws IOException {
+    int length = readLength(input);
+    byte[] bytes = new byte[length];
+    input.readFully(bytes);
+    return new String(bytes, StandardCharsets.UTF_8);
+  }
+
+  @SuppressWarnings({"unchecked", "rawtypes"})
+  private static Enum<?> readEnum(DataInput input, Class<?> enumType)
+      throws IOException, TypeMismatchException {
+    if (enumType == null || !enumType.isEnum()) throw new TypeMismatchException();
+    try {
+      return Enum.valueOf((Class) enumType, readString(input));
+    } catch (IllegalArgumentException ex) {
+      throw new TypeMismatchException();
+    }
+  }
+}
diff --git a/serial/test/org/immutables/serial/fixture/BinaryCompact.java b/serial/test/org/immutables/serial/fixture/BinaryCompact.java
new file mode 100644
index 0000000..ea3125a
--- /dev/null
+++ b/serial/test/org/immutables/serial/fixture/BinaryCompact.java
@@ -0,0 +1,148 @@
+package org.immutables.serial.fixture;
+
+import com.Capella.common.collect.Multiset;
+import java.io.DataOutput;
+import java.io.IOException;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.OptionalDouble;
+import java.util.OptionalInt;
+import java.util.OptionalLong;
+import java.util.Set;
+import java.util.SortedMap;
+import java.util.SortedSet;
+import org.immutables.value.Value;
+
+interface BinaryCompact {
+  enum First { ALPHA, BETA }
+  enum Second { BETA, ALPHA }
+
+  @Value.Immutable
+  interface BuilderValue {
+    boolean flag();
+    Integer boxed();
+    String longText();
+    First choice();
+    Optional<String> optional();
+    OptionalInt optionalInt();
+    OptionalLong optionalLong();
+    OptionalDouble optionalDouble();
+    String[] names();
+    List<Integer> list();
+    SortedSet<String> sortedSet();
+    Map<String, First> map();
+    SortedMap<Integer, String> sortedMap();
+  }
+
+  @Value.Immutable(builder = false)
+  interface ConstructorValue {
+    @Value.Parameter int number();
+    @Value.Parameter First choice();
+    @Value.Parameter Optional<String> optional();
+    @Value.Parameter List<Integer> list();
+    @Value.Parameter Set<String> set();
+    @Value.Parameter Map<String, Long> map();
+  }
+
+  @Value.Immutable
+  interface Nested {
+    int number();
+    @Value.Default default String label() { return "nested-default"; }
+  }
+
+  @Value.Immutable
+  interface Outer {
+    Nested nested();
+    String following();
+  }
+
+  @Value.Immutable
+  interface VersionOne {
+    int number();
+    String text();
+    First choice();
+    List<Integer> items();
+  }
+
+  @Value.Immutable
+  interface VersionTwo {
+    List<Integer> items();
+    Second choice();
+    String text();
+    int number();
+    @Value.Default default String added() { return "added-default"; }
+  }
+
+  @Value.Immutable
+  interface Mismatched {
+    @Value.Default default long number() { return 44L; }
+    @Value.Default default List<String> items() { return java.util.Collections.emptyList(); }
+    String text();
+    Second choice();
+  }
+
+  @Value.Immutable
+  interface Renamed {
+    @Value.Default default int renamed() { return 77; }
+    String text();
+  }
+
+  @Value.Immutable
+  interface DerivedAuxiliary {
+    int number();
+    @Value.Derived default int doubled() { return number() * 2; }
+    @Value.Auxiliary @Value.Default default Optional<String> note() { return Optional.empty(); }
+  }
+
+  @Value.Immutable
+  interface RequiredAuxiliary {
+    int number();
+    @Value.Auxiliary String requiredAuxiliary();
+  }
+
+  interface WriteConflict {
+    default void writeTo(DataOutput output) throws IOException {}
+  }
+
+  @Value.Immutable
+  interface Conflicting extends WriteConflict {
+    int number();
+  }
+
+  @Value.Immutable
+  interface ReadConflicting {
+    int number();
+    static ReadConflicting readFrom(java.io.DataInput input) { return null; }
+  }
+
+  @Value.Immutable
+  interface Generic<T> {
+    int number();
+  }
+
+  @Value.Immutable
+  interface UnresolvedGeneric<T> {
+    T value();
+  }
+
+  @Value.Immutable
+  interface Unsupported {
+    Object value();
+  }
+
+  @Value.Immutable
+  interface Recursive {
+    Recursive recursive();
+  }
+
+  @Value.Immutable
+  interface UnsupportedContainer {
+    List<List<String>> values();
+  }
+
+  @Value.Immutable(builder = false)
+  interface ConstructorUnsupported {
+    @Value.Parameter Multiset<String> values();
+  }
+}
diff --git a/serial/test/org/immutables/serial/fixture/BinaryCompactTest.java b/serial/test/org/immutables/serial/fixture/BinaryCompactTest.java
new file mode 100644
index 0000000..a8b6c9c
--- /dev/null
+++ b/serial/test/org/immutables/serial/fixture/BinaryCompactTest.java
@@ -0,0 +1,159 @@
+package org.immutables.serial.fixture;
+
+import static org.immutables.check.Checkers.check;
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.DataInputStream;
+import java.io.DataOutputStream;
+import java.io.IOException;
+import java.lang.reflect.Method;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.Optional;
+import java.util.OptionalDouble;
+import java.util.OptionalInt;
+import java.util.OptionalLong;
+import java.util.TreeMap;
+import java.util.TreeSet;
+import org.junit.Test;
+
+public class BinaryCompactTest {
+  @Test
+  public void builderRoundTrip() throws Exception {
+    StringBuilder longText = new StringBuilder();
+    for (int i = 0; i < 100_000; i++) longText.append((char) ('a' + i % 26));
+    ImmutableBuilderValue value = ImmutableBuilderValue.builder()
+        .flag(true)
+        .boxed(8)
+        .longText(longText.toString())
+        .choice(BinaryCompact.First.BETA)
+        .optional("present")
+        .optionalInt(OptionalInt.of(2))
+        .optionalLong(OptionalLong.of(3L))
+        .optionalDouble(OptionalDouble.of(4.5))
+        .names("a", null, "b")
+        .addList(1, 2)
+        .sortedSet(new TreeSet<>(Arrays.asList("z", "a")))
+        .putMap("first", BinaryCompact.First.ALPHA)
+        .sortedMap(new TreeMap<>(Collections.singletonMap(2, "two")))
+        .build();
+
+    check(readBuilder(write(value))).is(value);
+  }
+
+  @Test
+  public void existingGuavaShapesRoundTrip() throws Exception {
+    ImmutableStructFromBuilder value = ImmutableStructFromBuilder.builder()
+        .a(1).s("s").array(true, false).addC("c").os(true)
+        .addBag("x", "x", "x")
+        .putIndex(1, "a").putIndexList(1, "a").putIndexList(1, "a")
+        .putIndexSet(2, "b").putBiMap(3, "c").build();
+    check(ImmutableStructFromBuilder.readFrom(input(write(value)))).is(value);
+  }
+
+  @Test
+  public void constructorRoundTrip() throws Exception {
+    ImmutableConstructorValue value = ImmutableConstructorValue.of(
+        3, BinaryCompact.First.ALPHA, Optional.of("x"), Arrays.asList(1, 2),
+        new TreeSet<>(Arrays.asList("a", "b")), Collections.singletonMap("x", 4L));
+    check(ImmutableConstructorValue.readFrom(input(write(value)))).is(value);
+  }
+
+  @Test
+  public void versionsMatchByNameAndShape() throws Exception {
+    ImmutableVersionOne oldValue = ImmutableVersionOne.builder()
+        .number(5).text("later-field").choice(BinaryCompact.First.BETA).addItems(1, 2).build();
+    byte[] oldBytes = write(oldValue);
+    ImmutableVersionTwo newer = ImmutableVersionTwo.readFrom(input(oldBytes));
+    check(newer.number()).is(5);
+    check(newer.text()).is("later-field");
+    check(newer.choice()).is(BinaryCompact.Second.BETA);
+    assertEquals(Arrays.asList(1, 2), newer.items());
+    check(newer.added()).is("added-default");
+
+    ImmutableVersionOne older = ImmutableVersionOne.readFrom(input(write(newer)));
+    check(older).is(oldValue);
+  }
+
+  @Test
+  public void mismatchesAndRenamesAreAbsent() throws Exception {
+    ImmutableVersionOne oldValue = ImmutableVersionOne.builder()
+        .number(5).text("survives").choice(BinaryCompact.First.ALPHA).addItems(1, 2).build();
+    byte[] bytes = write(oldValue);
+
+    ImmutableMismatched mismatched = ImmutableMismatched.readFrom(input(bytes));
+    check(mismatched.number()).is(44L);
+    check(mismatched.items()).isEmpty();
+    check(mismatched.text()).is("survives");
+    check(mismatched.choice()).is(BinaryCompact.Second.ALPHA);
+
+    ImmutableRenamed renamed = ImmutableRenamed.readFrom(input(bytes));
+    check(renamed.renamed()).is(77);
+    check(renamed.text()).is("survives");
+  }
+
+  @Test
+  public void nestedFieldsAreDelimitedAndDerivedRecomputed() throws Exception {
+    ImmutableOuter outer = ImmutableOuter.builder()
+        .nested(ImmutableNested.builder().number(9).label("custom").build())
+        .following("after-nested")
+        .build();
+    check(ImmutableOuter.readFrom(input(write(outer)))).is(outer);
+
+    ImmutableDerivedAuxiliary value = ImmutableDerivedAuxiliary.builder().number(6).build();
+    ImmutableDerivedAuxiliary copy = ImmutableDerivedAuxiliary.readFrom(input(write(value)));
+    check(copy.doubled()).is(12);
+    check(copy.note()).is(Optional.empty());
+  }
+
+  @Test(expected = IOException.class)
+  public void truncatedInputFails() throws Exception {
+    byte[] bytes = write(ImmutableNested.builder().number(1).build());
+    ImmutableNested.readFrom(input(Arrays.copyOf(bytes, bytes.length - 1)));
+  }
+
+  @Test
+  public void conflictsAndUnsupportedShapesHaveNoPair() {
+    assertFalse(hasDeclaredMethod(ImmutableConflicting.class, "readFrom"));
+    assertFalse(hasDeclaredMethod(ImmutableReadConflicting.class, "writeTo"));
+    assertFalse(hasDeclaredMethod(ImmutableUnsupported.class, "writeTo"));
+    assertFalse(hasDeclaredMethod(ImmutableUnresolvedGeneric.class, "writeTo"));
+    assertFalse(hasDeclaredMethod(ImmutableRecursive.class, "writeTo"));
+    assertFalse(hasDeclaredMethod(ImmutableUnsupportedContainer.class, "writeTo"));
+    assertFalse(hasDeclaredMethod(ImmutableRequiredAuxiliary.class, "writeTo"));
+    assertFalse(hasDeclaredMethod(ImmutableConstructorUnsupported.class, "writeTo"));
+    assertTrue(hasDeclaredMethod(ImmutableNested.class, "writeTo"));
+    assertTrue(hasDeclaredMethod(ImmutableGeneric.class, "writeTo"));
+  }
+
+  @Test
+  public void genericTypeWithConcreteStorageRoundTrips() throws Exception {
+    ImmutableGeneric<String> value = ImmutableGeneric.<String>builder().number(4).build();
+    check(ImmutableGeneric.<String>readFrom(input(write(value)))).is(value);
+  }
+
+  private static boolean hasDeclaredMethod(Class<?> type, String name) {
+    for (Method method : type.getDeclaredMethods()) {
+      if (method.getName().equals(name)) return true;
+    }
+    return false;
+  }
+
+  private static byte[] write(org.immutables.serial.Binary.Value value) throws IOException {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    value.writeTo(new DataOutputStream(bytes));
+    return bytes.toByteArray();
+  }
+
+  private static DataInputStream input(byte[] bytes) {
+    return new DataInputStream(new ByteArrayInputStream(bytes));
+  }
+
+  private static ImmutableBuilderValue readBuilder(byte[] bytes) throws IOException {
+    return ImmutableBuilderValue.readFrom(input(bytes));
+  }
+}
