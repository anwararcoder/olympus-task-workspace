+package org.immutables.serial.fixture;
+
+import com.Capella.common.base.Optional;
+import com.Capella.common.collect.BiMap;
+import com.Capella.common.collect.ListMultimap;
+import com.Capella.common.collect.Multiset;
+import com.Capella.common.collect.SetMultimap;
+import java.io.DataOutput;
+import java.io.IOException;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.SortedMap;
+import java.util.SortedSet;
+import org.immutables.value.Value;
+
+enum CompactKind {
+  FIRST,
+  SECOND
+}
+
+@Value.Immutable
+interface CompactNested<T> {
+  String name();
+  int number();
+}
+
+@Value.Immutable
+interface CompactBuilderValue {
+  boolean flag();
+  Byte boxed();
+  String text();
+  CompactKind kind();
+  java.util.Optional<String> optional();
+  Optional<Integer> guavaOptional();
+  java.util.OptionalInt optionalInt();
+  java.util.OptionalLong optionalLong();
+  java.util.OptionalDouble optionalDouble();
+  int[] ints();
+  String[] strings();
+  List<String> list();
+  Set<Integer> set();
+  SortedSet<String> sortedSet();
+  Multiset<String> multiset();
+  Map<String, Integer> map();
+  SortedMap<String, Integer> sortedMap();
+  BiMap<String, Integer> bimap();
+  ListMultimap<String, Integer> listMultimap();
+  SetMultimap<String, Integer> setMultimap();
+  CompactNested<String> nested();
+
+  @Value.Derived
+  default int textLength() {
+    return text().length();
+  }
+
+  @Value.Auxiliary
+  Optional<String> auxiliary();
+}
+
+@Value.Immutable(builder = false)
+interface CompactConstructorValue {
+  @Value.Parameter int number();
+  @Value.Parameter String text();
+  @Value.Parameter CompactKind kind();
+  @Value.Parameter java.util.Optional<String> optional();
+  @Value.Parameter List<String> list();
+  @Value.Parameter Set<Integer> set();
+  @Value.Parameter Map<String, Integer> map();
+}
+
+@Value.Immutable
+interface CompactUnsupported {
+  Object value();
+}
+
+@Value.Immutable
+interface CompactRecursive {
+  CompactRecursive next();
+}
+
+@Value.Immutable
+interface CompactConflict {
+  int value();
+
+  default void writeTo(DataOutput output) throws IOException {
+    output.writeInt(value());
+  }
+}
+
+@Value.Immutable
+interface CompactVersionOne {
+  String shared();
+  int changed();
+  java.util.Optional<String> removed();
+}
+
+@Value.Immutable
+interface CompactVersionTwo {
+  java.util.Optional<Integer> changed();
+  java.util.Optional<String> added();
+  String shared();
+}
diff --git a/serial/test/org/immutables/serial/fixture/CompactBinaryTest.java b/serial/test/org/immutables/serial/fixture/CompactBinaryTest.java
new file mode 100644
index 0000000..b316c94
--- /dev/null
+++ b/serial/test/org/immutables/serial/fixture/CompactBinaryTest.java
@@ -0,0 +1,146 @@
+package org.immutables.serial.fixture;
+
+import static org.immutables.check.Checkers.check;
+import static org.junit.Assert.assertFalse;
+
+import com.Capella.common.collect.HashBiMap;
+import com.Capella.common.collect.ImmutableList;
+import com.Capella.common.collect.ImmutableListMultimap;
+import com.Capella.common.collect.ImmutableMap;
+import com.Capella.common.collect.ImmutableMultiset;
+import com.Capella.common.collect.ImmutableSet;
+import com.Capella.common.collect.ImmutableSetMultimap;
+import com.Capella.common.collect.ImmutableSortedMap;
+import com.Capella.common.collect.ImmutableSortedSet;
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.DataInputStream;
+import java.io.DataOutputStream;
+import java.io.EOFException;
+import java.lang.reflect.Method;
+import java.util.Arrays;
+import org.junit.Test;
+
+public class CompactBinaryTest {
+  @Test
+  public void builderRoundTrip() throws Exception {
+    String longString = repeat("abcdefghijklmnopqrstuvwxyz", 5000);
+    ImmutableCompactBuilderValue value = ImmutableCompactBuilderValue.builder()
+        .flag(true)
+        .boxed((byte) 8)
+        .text(longString)
+        .kind(CompactKind.SECOND)
+        .optional("jdk")
+        .guavaOptional(7)
+        .optionalInt(11)
+        .optionalLong(13L)
+        .optionalDouble(17.5)
+        .ints(1, 2, 3)
+        .strings("a", "b")
+        .addAllList(ImmutableList.of("x", "y"))
+        .addAllSet(ImmutableSet.of(1, 2))
+        .sortedSet(ImmutableSortedSet.of("a", "z"))
+        .addAllMultiset(ImmutableMultiset.of("same", "same", "other"))
+        .putAllMap(ImmutableMap.of("a", 1))
+        .sortedMap(ImmutableSortedMap.of("b", 2))
+        .putAllBimap(HashBiMap.create(ImmutableMap.of("c", 3)))
+        .putAllListMultimap(ImmutableListMultimap.of("k", 1, "k", 1))
+        .putAllSetMultimap(ImmutableSetMultimap.of("s", 2))
+        .nested(ImmutableCompactNested.<String>builder().name("nested").number(19).build())
+        .build();
+
+    ImmutableCompactBuilderValue copy = ImmutableCompactBuilderValue.readFrom(
+        new DataInputStream(new ByteArrayInputStream(write(value))));
+
+    check(copy).is(value);
+    check(copy.ints()).isOf(1, 2, 3);
+    check(copy.strings()).isOf("a", "b");
+    check(copy.textLength()).is(longString.length());
+    check(copy.auxiliary()).isAbsent();
+  }
+
+  @Test
+  public void constructorRoundTrip() throws Exception {
+    ImmutableCompactConstructorValue value = ImmutableCompactConstructorValue.of(
+        2,
+        "constructor",
+        CompactKind.FIRST,
+        java.util.Optional.of("optional"),
+        ImmutableList.of("a", "b"),
+        ImmutableSet.of(3, 4),
+        ImmutableMap.of("five", 5));
+
+    check(ImmutableCompactConstructorValue.readFrom(
+        new DataInputStream(new ByteArrayInputStream(write(value))))).is(value);
+  }
+
+  @Test(expected = EOFException.class)
+  public void incompleteInputFails() throws Exception {
+    byte[] bytes = write(ImmutableCompactConstructorValue.of(
+        1,
+        "cut",
+        CompactKind.SECOND,
+        java.util.Optional.empty(),
+        ImmutableList.of(),
+        ImmutableSet.of(),
+        ImmutableMap.of()));
+    ImmutableCompactConstructorValue.readFrom(new DataInputStream(
+        new ByteArrayInputStream(Arrays.copyOf(bytes, bytes.length - 1))));
+  }
+
+  @Test
+  public void unsupportedAndConflictingTypesHaveNoPair() {
+    assertFalse(hasMethod(ImmutableCompactUnsupported.class, "writeTo"));
+    assertFalse(hasMethod(ImmutableCompactUnsupported.class, "readFrom"));
+    assertFalse(hasMethod(ImmutableCompactRecursive.class, "writeTo"));
+    assertFalse(hasMethod(ImmutableCompactRecursive.class, "readFrom"));
+    assertFalse(hasMethod(ImmutableCompactConflict.class, "readFrom"));
+  }
+
+  @Test
+  public void reorderedUnknownAndMismatchedAttributesAreCompatible() throws Exception {
+    ImmutableCompactVersionOne oldValue = ImmutableCompactVersionOne.builder()
+        .shared("same")
+        .changed(12)
+        .removed("old")
+        .build();
+
+    ImmutableCompactVersionTwo newValue = ImmutableCompactVersionTwo.readFrom(
+        new DataInputStream(new ByteArrayInputStream(write(oldValue))));
+
+    check(newValue.shared()).is("same");
+    assertFalse(newValue.changed().isPresent());
+    assertFalse(newValue.added().isPresent());
+  }
+
+  private static byte[] write(ImmutableCompactBuilderValue value) throws Exception {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    value.writeTo(new DataOutputStream(bytes));
+    return bytes.toByteArray();
+  }
+
+  private static byte[] write(ImmutableCompactConstructorValue value) throws Exception {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    value.writeTo(new DataOutputStream(bytes));
+    return bytes.toByteArray();
+  }
+
+  private static byte[] write(ImmutableCompactVersionOne value) throws Exception {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    value.writeTo(new DataOutputStream(bytes));
+    return bytes.toByteArray();
+  }
+
+  private static boolean hasMethod(Class<?> type, String name) {
+    for (Method method : type.getMethods()) {
+      if (method.getName().equals(name)) return true;
+    }
+    return false;
+  }
+
+  private static String repeat(String value, int count) {
+    StringBuilder builder = new StringBuilder(value.length() * count);
+    for (int i = 0; i < count; i++) builder.append(value);
+    return builder.toString();
+  }
+}
diff --git a/test.sh b/test.sh
new file mode 100755
index 0000000..89bb341
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,115 @@
+#!/bin/bash
+set -uo pipefail
+
+INVOKE_DIR="$PWD"
+cd "$(dirname "$0")"
+
+OUTPUT_PATH=""
+MODE=""
+
+while [[ $# -gt 0 ]]; do
+    case "$1" in
+        --output_path)
+            OUTPUT_PATH="$2"
+            shift 2
+            ;;
+        base|new)
+            MODE="$1"
+            shift
+            ;;
+        *)
+            echo "Usage: $0 --output_path <path> {base|new}"
+            exit 1
+            ;;
+    esac
+done
+
+if [[ -n "$OUTPUT_PATH" && "$OUTPUT_PATH" != /* ]]; then
+    OUTPUT_PATH="$INVOKE_DIR/$OUTPUT_PATH"
+fi
+
+if [[ -z "$MODE" ]]; then
+    echo "Usage: $0 --output_path <path> {base|new}"
+    exit 1
+fi
+
+FOCUS_TEST="BinarySerialization_7e2d4f_Test"
+REPORTS="value-fixture/target/surefire-reports"
+TMP="${TMPDIR:-/tmp}/immutables-binary-serialization-mvn-tmp"
+mkdir -p "$TMP"
+export MAVEN_OPTS="-Xmx950m -Djava.io.tmpdir=$TMP"
+MVN="mvn -B -ntp -o -DforkCount=1 -DreuseForks=true -DfailIfNoTests=false"
+LOG="$TMP/maven-$MODE.log"
+
+xml_escape() {
+    sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
+}
+
+run_mvn() {
+    $MVN "$@" 2>&1 | tee "$LOG"
+    return "${PIPESTATUS[0]}"
+}
+
+write_xml() {
+    local fallback="${1:-0}"
+    [[ -z "$OUTPUT_PATH" ]] && return 0
+    : > "$OUTPUT_PATH"
+    echo '<testsuites>' >> "$OUTPUT_PATH"
+    FOUND=0
+    for xml in "$REPORTS"/TEST-*.xml; do
+        if [[ -e "$xml" ]]; then
+            FOUND=1
+            grep -v '<?xml' "$xml" >> "$OUTPUT_PATH"
+        fi
+    done
+    if [[ "$FOUND" -eq 0 && "$fallback" -ne 0 ]]; then
+        case "$MODE" in
+            base)
+                FALLBACK_CLASS="org.immutables.fixture.ValuesTest"
+                FALLBACK_TEST="plainAttributes"
+                ;;
+            new)
+                FALLBACK_CLASS="org.immutables.fixture.binser_9c3f2a.BinarySerialization_7e2d4f_Test"
+                FALLBACK_TEST="scalarRoundTrip"
+                ;;
+        esac
+        cat >> "$OUTPUT_PATH" <<XML
+<testsuite name="$MODE" tests="1" failures="1" errors="0" skipped="0">
+  <testcase name="$FALLBACK_TEST" classname="$FALLBACK_CLASS">
+    <failure message="Maven failed before Surefire reports were produced">
+XML
+        if [[ -f "$LOG" ]]; then
+            tail -n 200 "$LOG" | xml_escape >> "$OUTPUT_PATH"
+        else
+            echo "Maven failed before Surefire reports were produced." >> "$OUTPUT_PATH"
+        fi
+        cat >> "$OUTPUT_PATH" <<XML
+    </failure>
+  </testcase>
+</testsuite>
+XML
+    fi
+    echo '</testsuites>' >> "$OUTPUT_PATH"
+}
+
+rm -rf "$REPORTS"
+
+if ! run_mvn -pl value-fixture -am clean install -DskipTests -Dmaven.test.skip=true; then
+    write_xml 1
+    exit 1
+fi
+
+rm -rf "$REPORTS"
+
+RC=0
+case "$MODE" in
+    base)
+        run_mvn -pl value-fixture test -Dtest="!$FOCUS_TEST" || RC=$?
+        ;;
+    new)
+        run_mvn -pl value-fixture test -Dtest="$FOCUS_TEST" || RC=$?
+        ;;
+esac
+
+write_xml "$RC"
+exit $RC
