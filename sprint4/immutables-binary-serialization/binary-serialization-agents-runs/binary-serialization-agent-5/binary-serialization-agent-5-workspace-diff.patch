+package org.immutables.value.processor.meta;
+
+import com.Capella.common.collect.ImmutableList;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.IdentityHashMap;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import javax.lang.model.element.Element;
+import javax.lang.model.element.ExecutableElement;
+import javax.lang.model.element.TypeElement;
+import javax.lang.model.type.ArrayType;
+import javax.lang.model.type.DeclaredType;
+import javax.lang.model.type.TypeKind;
+import javax.lang.model.type.TypeMirror;
+import javax.lang.model.util.ElementFilter;
+import javax.lang.model.util.Types;
+import org.immutables.value.processor.meta.Proto.Protoclass;
+
+public final class BinarySerialization {
+  private static final String BINARY = "org.immutables.serial.Binary";
+  private static final String DATA_INPUT = "java.io.DataInput";
+  private static final String DATA_OUTPUT = "java.io.DataOutput";
+
+  private final ValueType type;
+  private final List<Field> fields;
+  private final boolean builder;
+  private final boolean enabled;
+
+  private BinarySerialization(ValueType type) {
+    this.type = type;
+    Analysis analysis = new Analyzer().analyze(type);
+    this.fields = analysis.fields;
+    this.builder = analysis.builder;
+    this.enabled = analysis.enabled;
+  }
+
+  public static BinarySerialization of(ValueType type) {
+    return new BinarySerialization(type);
+  }
+
+  public boolean isEnabled() {
+    return enabled;
+  }
+
+  public CharSequence methods() {
+    if (!enabled) return "";
+    StringBuilder source = new StringBuilder();
+    generateWrite(source);
+    source.append('\n');
+    generateRead(source);
+    return source;
+  }
+
+  private void generateWrite(StringBuilder source) {
+    source.append("public void writeTo(java.io.DataOutput output) throws java.io.IOException {\n");
+    source.append("  ").append(BINARY).append(".writeHeader(output, ").append(fields.size()).append(");\n");
+    for (Field field : fields) {
+      source.append("  ").append(BINARY).append(".write(output, ")
+          .append(field.id).append("L, ").append(field.codec.source).append(", this.")
+          .append(field.attribute.names.get).append("());\n");
+    }
+    source.append("}\n");
+  }
+
+  private void generateRead(StringBuilder source) {
+    source.append("@SuppressWarnings({\"unchecked\", \"rawtypes\"})\n");
+    source.append("public static").append(type.generics().declaration).append(' ')
+        .append(type.typeImmutable().relative()).append(" readFrom(java.io.DataInput input) throws java.io.IOException {\n");
+    source.append("  ").append(BINARY).append(".Input binary = ").append(BINARY).append(".read(input);\n");
+    if (builder) {
+      generateBuilderRead(source);
+    } else {
+      generateConstructorRead(source);
+    }
+    source.append("}\n");
+  }
+
+  private void generateBuilderRead(StringBuilder source) {
+    source.append("  ").append(type.typeBuilder().relative()).append(" builder = ")
+        .append(type.factoryBuilder().relative()).append("();\n");
+    source.append("  Object value;\n");
+    for (Field field : fields) {
+      ValueAttribute attribute = field.attribute;
+      source.append("  value = binary.get(").append(field.id).append("L, ")
+          .append(field.codec.source).append(");\n");
+      source.append("  if (value != ").append(BINARY).append(".missing()) {\n");
+      if (field.kind.isMultimapKind()) {
+        if (attribute.isNullable()) {
+          source.append("    if (value == null) {\n")
+              .append("      builder.").append(attribute.names.init).append("(null);\n")
+              .append("    } else {\n");
+        }
+        source.append(attribute.isNullable() ? "      " : "    ")
+            .append("for (Object[] entry : (java.util.List<Object[]>) value) {\n")
+            .append(attribute.isNullable() ? "        " : "      ")
+            .append("builder.").append(attribute.names.put()).append("((")
+            .append(attribute.getWrappedElementType()).append(") entry[0], (")
+            .append(attribute.getSecondaryElementType()).append(") entry[1]);\n")
+            .append(attribute.isNullable() ? "      }\n    }\n" : "    }\n");
+      } else if (field.kind.isCollectionKind()) {
+        if (attribute.isNullable()) {
+          source.append("    if (value == null) builder.").append(attribute.names.init).append("(null);\n");
+          if (attribute.isCollectionType()) {
+            source.append("    else builder.").append(attribute.names.addAll()).append("((java.lang.Iterable) value);\n");
+          } else {
+            source.append("    else builder.").append(attribute.names.init).append('(')
+                .append(castExpression(attribute, "value")).append(");\n");
+          }
+        } else if (attribute.isCollectionType()) {
+          source.append("    builder.").append(attribute.names.addAll()).append("((java.lang.Iterable) value);\n");
+        } else {
+          source.append("    builder.").append(attribute.names.init).append('(')
+              .append(castExpression(attribute, "value")).append(");\n");
+        }
+      } else if (field.kind.isMapKind()) {
+        if (attribute.isNullable()) {
+          source.append("    if (value == null) builder.").append(attribute.names.init).append("(null);\n");
+          if (attribute.isMapType()) {
+            source.append("    else builder.").append(attribute.names.putAll()).append("((java.util.Map) value);\n");
+          } else {
+            source.append("    else builder.").append(attribute.names.init).append('(')
+                .append(castExpression(attribute, "value")).append(");\n");
+          }
+        } else if (attribute.isMapType()) {
+          source.append("    builder.").append(attribute.names.putAll()).append("((java.util.Map) value);\n");
+        } else {
+          source.append("    builder.").append(attribute.names.init).append('(')
+              .append(castExpression(attribute, "value")).append(");\n");
+        }
+      } else {
+        source.append("    builder.").append(attribute.names.init).append('(')
+            .append(castExpression(attribute, "value")).append(");\n");
+      }
+      source.append("  }\n");
+    }
+    source.append("  return builder.").append(type.names().build).append("();\n");
+  }
+
+  private void generateConstructorRead(StringBuilder source) {
+    Map<ValueAttribute, Field> byAttribute = new LinkedHashMap<>();
+    for (Field field : fields) byAttribute.put(field.attribute, field);
+    for (ValueAttribute attribute : type.getConstructorArguments()) {
+      Field field = byAttribute.get(attribute);
+      source.append("  Object binary_").append(attribute.name()).append(" = ");
+      if (field != null) {
+        source.append("binary.get(").append(field.id).append("L, ").append(field.codec.source).append(");\n");
+      } else {
+        source.append(BINARY).append(".missing();\n");
+      }
+    }
+    for (ValueAttribute attribute : type.getConstructorArguments()) {
+      if (fallbackExpression(attribute) == null) {
+        source.append("  if (binary_").append(attribute.name()).append(" == ")
+            .append(BINARY).append(".missing()) throw new java.io.EOFException(\"Missing immutable attribute: ")
+            .append(attribute.name()).append("\");\n");
+      }
+    }
+    source.append("  return new ").append(type.typeImmutable().relativeRaw()).append(type.generics().arguments).append('(');
+    boolean first = true;
+    for (ValueAttribute attribute : type.getConstructorArguments()) {
+      if (!first) source.append(", ");
+      first = false;
+      String variable = "binary_" + attribute.name();
+      String fallback = fallbackExpression(attribute);
+      if (fallback != null) {
+        source.append(variable).append(" == ").append(BINARY).append(".missing() ? ")
+            .append(fallback).append(" : ");
+      }
+      source.append(constructorCastExpression(attribute, variable));
+    }
+    source.append(");\n");
+  }
+
+  private static String fallbackExpression(ValueAttribute attribute) {
+    if (attribute.isPrimitive()) {
+      switch (attribute.returnType.getKind()) {
+      case BOOLEAN: return "false";
+      case CHAR: return "'\\0'";
+      case LONG: return "0L";
+      case FLOAT: return "0.0f";
+      case DOUBLE: return "0.0d";
+      default: return "0";
+      }
+    }
+    switch (effectiveKind(attribute.returnType)) {
+    case OPTIONAL_JDK: return "java.util.Optional.empty()";
+    case OPTIONAL_GUAVA: return "com.Capella.common.base.Optional.absent()";
+    case OPTIONAL_INT_JDK: return "java.util.OptionalInt.empty()";
+    case OPTIONAL_LONG_JDK: return "java.util.OptionalLong.empty()";
+    case OPTIONAL_DOUBLE_JDK: return "java.util.OptionalDouble.empty()";
+    case LIST:
+    case SET:
+    case ENUM_SET:
+      return "java.util.Collections.emptyList()";
+    case SORTED_SET:
+      if (!attribute.isCollectionType()) return "java.util.Collections.emptySortedSet()";
+      return "java.util.Collections.emptyList()";
+    case MULTISET:
+    case SORTED_MULTISET:
+      return "java.util.Collections.emptyList()";
+    case MAP:
+    case ENUM_MAP:
+      return "java.util.Collections.emptyMap()";
+    case SORTED_MAP:
+      if (!attribute.isMapType()) return "java.util.Collections.emptySortedMap()";
+      return "java.util.Collections.emptyMap()";
+    case BI_MAP:
+      return "java.util.Collections.emptyMap()";
+    default:
+      if (attribute.isNullable()) return "null";
+      return null;
+    }
+  }
+
+  private static String castExpression(ValueAttribute attribute, String value) {
+    if (attribute.isPrimitive()) {
+      return "(" + boxedType(attribute.returnType.getKind()) + ") " + value;
+    }
+    return "(" + attribute.getType() + ") " + value;
+  }
+
+  private static String constructorCastExpression(ValueAttribute attribute, String value) {
+    if (attribute.isCollectionType()) return "(java.lang.Iterable) " + value;
+    if (attribute.isMapType()) return "(java.util.Map) " + value;
+    if (attribute.typeKind().isMultimapKind()) return "(com.Capella.common.collect.Multimap) " + value;
+    return castExpression(attribute, value);
+  }
+
+  private static String boxedType(TypeKind kind) {
+    switch (kind) {
+    case BOOLEAN: return Boolean.class.getName();
+    case BYTE: return Byte.class.getName();
+    case SHORT: return Short.class.getName();
+    case INT: return Integer.class.getName();
+    case LONG: return Long.class.getName();
+    case CHAR: return Character.class.getName();
+    case FLOAT: return Float.class.getName();
+    case DOUBLE: return Double.class.getName();
+    default: throw new AssertionError(kind);
+    }
+  }
+
+  private static long attributeId(String name) {
+    long hash = 0xcbf29ce484222325L;
+    for (int i = 0; i < name.length(); i++) {
+      char character = name.charAt(i);
+      hash ^= character & 0xff;
+      hash *= 0x100000001b3L;
+      hash ^= character >>> 8;
+      hash *= 0x100000001b3L;
+    }
+    return hash;
+  }
+
+  private static AttributeTypeKind effectiveKind(TypeMirror mirror) {
+    if (mirror.getKind() == TypeKind.ARRAY) return AttributeTypeKind.ARRAY;
+    if (mirror.getKind() != TypeKind.DECLARED) return AttributeTypeKind.REGULAR;
+    TypeElement element = (TypeElement) ((DeclaredType) mirror).asElement();
+    return AttributeTypeKind.forRawType(element.getQualifiedName().toString());
+  }
+
+  private static final class Analysis {
+    final boolean enabled;
+    final boolean builder;
+    final List<Field> fields;
+
+    Analysis(boolean enabled, boolean builder, List<Field> fields) {
+      this.enabled = enabled;
+      this.builder = builder;
+      this.fields = fields;
+    }
+
+    static Analysis disabled() {
+      return new Analysis(false, false, Collections.<Field>emptyList());
+    }
+  }
+
+  private static final class Field {
+    final ValueAttribute attribute;
+    final long id;
+    final Codec codec;
+    final AttributeTypeKind kind;
+
+    Field(ValueAttribute attribute, long id, Codec codec, AttributeTypeKind kind) {
+      this.attribute = attribute;
+      this.id = id;
+      this.codec = codec;
+      this.kind = kind;
+    }
+  }
+
+  private static final class Codec {
+    final String source;
+
+    Codec(String source) {
+      this.source = source;
+    }
+  }
+
+  private static final class Analyzer {
+    private final Set<ValueType> visiting = Collections.newSetFromMap(new IdentityHashMap<ValueType, Boolean>());
+    private final Map<ValueType, Analysis> completed = new IdentityHashMap<>();
+
+    Analysis analyze(ValueType type) {
+      Analysis cached = completed.get(type);
+      if (cached != null) return cached;
+      if (!type.kind().isValue()
+          || !type.constitution.protoclass().environment().hasSerialModule()
+          || hasMethodConflict(type)
+          || !visiting.add(type)) {
+        return Analysis.disabled();
+      }
+
+      boolean builder = type.isUseBuilder();
+      Set<ValueAttribute> constructor = type.getConstructorArguments();
+      List<Field> fields = new ArrayList<>();
+      Set<Long> ids = new LinkedHashSet<>();
+      for (ValueAttribute attribute : type.getImplementedAttributes()) {
+        attribute.hasSimpleScalarElementType();
+        if (attribute.isGenerateDerived || attribute.isGenerateLazy) continue;
+        if (attribute.isAuxiliary()) {
+          if (attribute.isMandatory()) {
+            visiting.remove(type);
+            return Analysis.disabled();
+          }
+          continue;
+        }
+        if (!builder && (!constructor.contains(attribute) || attribute.isGenerateDefault)) {
+          visiting.remove(type);
+          return Analysis.disabled();
+        }
+        AttributeTypeKind kind = effectiveKind(attribute.returnType);
+        Codec codec = codec(type, attribute.returnType, kind);
+        long id = attributeId(attribute.name());
+        if (codec == null || !ids.add(id)) {
+          visiting.remove(type);
+          return Analysis.disabled();
+        }
+        fields.add(new Field(attribute, id, codec, kind));
+      }
+      if (!builder) {
+        for (ValueAttribute attribute : constructor) {
+          if (attribute.isAuxiliary() && fallbackExpression(attribute) == null) {
+            visiting.remove(type);
+            return Analysis.disabled();
+          }
+        }
+      }
+      visiting.remove(type);
+      Analysis analysis = new Analysis(true, builder, ImmutableList.copyOf(fields));
+      completed.put(type, analysis);
+      return analysis;
+    }
+
+    private Codec codec(ValueType owner, TypeMirror mirror, AttributeTypeKind kind) {
+      if (mirror.getKind().isPrimitive()) return primitiveCodec(mirror.getKind(), false);
+      if (mirror.getKind() == TypeKind.ARRAY) {
+        TypeMirror component = ((ArrayType) mirror).getComponentType();
+        if (component.getKind() == TypeKind.ARRAY) return null;
+        Codec element = scalarCodec(component);
+        return element == null ? null : new Codec(
+            BINARY + ".arrayCodec(" + element.source + ", " + component + ".class)");
+      }
+      if (mirror.getKind() != TypeKind.DECLARED) return null;
+      DeclaredType declared = (DeclaredType) mirror;
+      TypeElement element = (TypeElement) declared.asElement();
+      Codec scalar = scalarCodec(mirror);
+      if (scalar != null) return scalar;
+
+      List<? extends TypeMirror> arguments = declared.getTypeArguments();
+      switch (kind) {
+      case OPTIONAL_JDK: return unary("optionalJdkCodec", arguments);
+      case OPTIONAL_GUAVA: return unary("optionalGuavaCodec", arguments);
+      case OPTIONAL_INT_JDK: return new Codec(BINARY + ".optionalIntCodec()");
+      case OPTIONAL_LONG_JDK: return new Codec(BINARY + ".optionalLongCodec()");
+      case OPTIONAL_DOUBLE_JDK: return new Codec(BINARY + ".optionalDoubleCodec()");
+      case LIST: return unary("listCodec", arguments);
+      case SET:
+      case ENUM_SET: return unary("setCodec", arguments);
+      case SORTED_SET: return unary("sortedSetCodec", arguments);
+      case MULTISET: return unary("multisetCodec", arguments);
+      case SORTED_MULTISET: return unary("sortedMultisetCodec", arguments);
+      case MAP:
+      case ENUM_MAP: return binary("mapCodec", arguments);
+      case SORTED_MAP: return binary("sortedMapCodec", arguments);
+      case BI_MAP: return binary("bimapCodec", arguments);
+      case MULTIMAP: return binary("multimapCodec", arguments);
+      case LIST_MULTIMAP: return binary("listMultimapCodec", arguments);
+      case SET_MULTIMAP: return binary("setMultimapCodec", arguments);
+      default:
+        ValueType nested = nestedValue(owner, element);
+        if (nested == null || !analyze(nested).enabled) return null;
+        return new Codec(BINARY + ".nestedCodec(" + nested.typeImmutable().absoluteRaw() + ".class)");
+      }
+    }
+
+    private Codec unary(String factory, List<? extends TypeMirror> arguments) {
+      if (arguments.size() != 1) return null;
+      Codec element = scalarCodec(arguments.get(0));
+      return element == null ? null : new Codec(BINARY + "." + factory + "(" + element.source + ")");
+    }
+
+    private Codec binary(String factory, List<? extends TypeMirror> arguments) {
+      if (arguments.size() != 2) return null;
+      Codec key = scalarCodec(arguments.get(0));
+      Codec value = scalarCodec(arguments.get(1));
+      return key == null || value == null
+          ? null
+          : new Codec(BINARY + "." + factory + "(" + key.source + ", " + value.source + ")");
+    }
+
+    private Codec scalarCodec(TypeMirror mirror) {
+      if (mirror.getKind().isPrimitive()) return primitiveCodec(mirror.getKind(), false);
+      if (mirror.getKind() != TypeKind.DECLARED) return null;
+      TypeElement element = (TypeElement) ((DeclaredType) mirror).asElement();
+      String name = element.getQualifiedName().toString();
+      if (name.equals(String.class.getName())) return new Codec(BINARY + ".stringCodec()");
+      if (element.getKind().name().equals("ENUM")) {
+        return new Codec(BINARY + ".enumCodec(" + name + ".class)");
+      }
+      TypeKind primitive = unboxedKind(name);
+      return primitive == null ? null : primitiveCodec(primitive, true);
+    }
+
+    private static Codec primitiveCodec(TypeKind kind, boolean boxed) {
+      String name;
+      switch (kind) {
+      case BOOLEAN: name = "Boolean"; break;
+      case BYTE: name = "Byte"; break;
+      case SHORT: name = "Short"; break;
+      case INT: name = "Int"; break;
+      case LONG: name = "Long"; break;
+      case CHAR: name = "Char"; break;
+      case FLOAT: name = "Float"; break;
+      case DOUBLE: name = "Double"; break;
+      default: return null;
+      }
+      if (!boxed) name = Character.toLowerCase(name.charAt(0)) + name.substring(1);
+      return new Codec(BINARY + "." + (boxed ? "boxed" : "") + name + "Codec()");
+    }
+
+    private static TypeKind unboxedKind(String name) {
+      if (name.equals(Boolean.class.getName())) return TypeKind.BOOLEAN;
+      if (name.equals(Byte.class.getName())) return TypeKind.BYTE;
+      if (name.equals(Short.class.getName())) return TypeKind.SHORT;
+      if (name.equals(Integer.class.getName())) return TypeKind.INT;
+      if (name.equals(Long.class.getName())) return TypeKind.LONG;
+      if (name.equals(Character.class.getName())) return TypeKind.CHAR;
+      if (name.equals(Float.class.getName())) return TypeKind.FLOAT;
+      if (name.equals(Double.class.getName())) return TypeKind.DOUBLE;
+      return null;
+    }
+
+    private static ValueType nestedValue(ValueType owner, TypeElement element) {
+      for (Protoclass protoclass : owner.constitution.protoclass().environment()
+          .protoclassesFrom(Collections.<Element>singleton(element))) {
+        if (protoclass.kind().isDefinedValue()) {
+          ValueType nested = owner.constitution.protoclass().environment().composeValue(protoclass);
+          if (protoclass.constitution().implementationVisibility().isPublic()
+              || owner.typeImmutable().packageOf().equals(nested.typeImmutable().packageOf())) {
+            return nested;
+          }
+        }
+      }
+      return null;
+    }
+
+    private static boolean hasMethodConflict(ValueType type) {
+      Types types = type.constitution.protoclass().processing().getTypeUtils();
+      for (ExecutableElement method : ElementFilter.methodsIn(
+          type.constitution.protoclass().processing().getElementUtils()
+              .getAllMembers(CachingElements.getDelegate((TypeElement) type.element)))) {
+        if (method.getParameters().size() != 1) continue;
+        String name = method.getSimpleName().toString();
+        if (!name.equals("writeTo") && !name.equals("readFrom")) continue;
+        TypeMirror parameter = types.erasure(method.getParameters().get(0).asType());
+        String expected = name.equals("writeTo") ? DATA_OUTPUT : DATA_INPUT;
+        if (parameter.toString().equals(expected)) return true;
+      }
+      return false;
+    }
+  }
+}
