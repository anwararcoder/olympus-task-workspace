@@ -0,0 +1,566 @@
+package org.immutables.serial;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.DataInput;
+import java.io.DataInputStream;
+import java.io.DataOutput;
+import java.io.DataOutputStream;
+import java.io.IOException;
+import java.lang.reflect.InvocationTargetException;
+import java.lang.reflect.Method;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Runtime support for compact binary forms generated by the value processor. */
+public final class Binary {
+  private static final int MAGIC = 0x494D4D42;
+  private static final int VERSION = 1;
+  private static final int MAX_LENGTH = Integer.MAX_VALUE - 8;
+
+  private Binary() {}
+
+  public static Writer writer(DataOutput output, int fieldCount) throws IOException {
+    return new Writer(output, fieldCount);
+  }
+
+  public static Reader reader(DataInput input) throws IOException {
+    return new Reader(input);
+  }
+
+  public static DataInput input(byte[] bytes) {
+    return new DataInputStream(new ByteArrayInputStream(bytes));
+  }
+
+  public static final class Writer {
+    private final DataOutput output;
+    private int remaining;
+
+    Writer(DataOutput output, int fieldCount) throws IOException {
+      if (fieldCount < 0) {
+        throw new IllegalArgumentException("Negative field count");
+      }
+      this.output = output;
+      this.remaining = fieldCount;
+      output.writeInt(MAGIC);
+      output.writeByte(VERSION);
+      output.writeInt(fieldCount);
+    }
+
+    public void write(long idHigh, long idLow, String shape, Object value) throws IOException {
+      ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+      DataOutputStream field = new DataOutputStream(bytes);
+      writeValue(field, new Shape(shape), value);
+      field.flush();
+      writePayload(idHigh, idLow, shape, bytes.toByteArray());
+    }
+
+    public void writeNested(long idHigh, long idLow, String shape, Object value)
+        throws IOException {
+      ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+      DataOutputStream field = new DataOutputStream(bytes);
+      if (value == null) {
+        field.writeByte(0);
+      } else {
+        field.writeByte(1);
+        invokeNestedWriter(value, field);
+      }
+      field.flush();
+      writePayload(idHigh, idLow, shape, bytes.toByteArray());
+    }
+
+    private void writePayload(long idHigh, long idLow, String shape, byte[] payload)
+        throws IOException {
+      if (remaining <= 0) {
+        throw new IOException("More binary fields written than declared");
+      }
+      output.writeLong(idHigh);
+      output.writeLong(idLow);
+      writeString(output, shape);
+      output.writeInt(payload.length);
+      output.write(payload);
+      remaining--;
+    }
+  }
+
+  public static final class Reader {
+    private final Map<Id, EncodedField> fields;
+
+    Reader(DataInput input) throws IOException {
+      if (input.readInt() != MAGIC) {
+        throw new IOException("Not an Immutables binary value");
+      }
+      int version = input.readUnsignedByte();
+      if (version != VERSION) {
+        throw new IOException("Unsupported Immutables binary version: " + version);
+      }
+      int fieldCount = input.readInt();
+      if (fieldCount < 0) {
+        throw new IOException("Negative binary field count");
+      }
+      fields = new HashMap<Id, EncodedField>(fieldCount * 2);
+      for (int i = 0; i < fieldCount; i++) {
+        Id id = new Id(input.readLong(), input.readLong());
+        String shape = readString(input);
+        int length = readLength(input);
+        byte[] payload = new byte[length];
+        input.readFully(payload);
+        if (fields.put(id, new EncodedField(shape, payload)) != null) {
+          throw new IOException("Duplicate binary field identity");
+        }
+      }
+    }
+
+    public Field field(long idHigh, long idLow, String shape) throws IOException {
+      EncodedField encoded = fields.get(new Id(idHigh, idLow));
+      if (encoded == null || !encoded.shape.equals(shape)) {
+        return Field.absent();
+      }
+      if ("n".equals(shape)) {
+        DataInputStream input = new DataInputStream(new ByteArrayInputStream(encoded.payload));
+        int marker = input.readUnsignedByte();
+        if (marker == 0) {
+          requireFinished(input);
+          return new Field(true, null, null, shape);
+        }
+        if (marker != 1) {
+          throw new IOException("Invalid nested value marker");
+        }
+        byte[] nested = new byte[input.available()];
+        input.readFully(nested);
+        return new Field(true, null, nested, shape);
+      }
+      DataInputStream input = new DataInputStream(new ByteArrayInputStream(encoded.payload));
+      Object value = readValue(input, new Shape(shape));
+      requireFinished(input);
+      return new Field(true, value, null, shape);
+    }
+  }
+
+  public static final class Field {
+    private static final Field ABSENT = new Field(false, null, null, "");
+    private final boolean present;
+    private final Object value;
+    private final byte[] nested;
+    private final String shape;
+
+    private Field(boolean present, Object value, byte[] nested, String shape) {
+      this.present = present;
+      this.value = value;
+      this.nested = nested;
+      this.shape = shape;
+    }
+
+    static Field absent() {
+      return ABSENT;
+    }
+
+    public boolean isPresent() {
+      return present;
+    }
+
+    public Object value() {
+      if (!present) {
+        throw new IllegalStateException("Binary field is absent");
+      }
+      return value;
+    }
+
+    public byte[] nested() {
+      if (!present) {
+        throw new IllegalStateException("Binary field is absent");
+      }
+      return nested;
+    }
+
+    public boolean matchesEnums(Class<? extends Enum<?>> first, Class<? extends Enum<?>> second) {
+      if (!present) return false;
+      try {
+        if ("e".equals(shape)) return enumExists(first, value);
+        if (shape.length() > 3 && shape.charAt(1) == '(') {
+          String body = shape.substring(2, shape.length() - 1);
+          int comma = topLevelComma(body);
+          if (comma < 0) {
+            if (!"e".equals(body)) return true;
+            for (Object element : (List<?>) value) {
+              if (!enumExists(first, element)) return false;
+            }
+            return true;
+          }
+          String keyShape = body.substring(0, comma);
+          String valueShape = body.substring(comma + 1);
+          List<?> entries = (List<?>) value;
+          for (int i = 0; i < entries.size(); i += 2) {
+            if ("e".equals(keyShape) && !enumExists(first, entries.get(i))) return false;
+            if ("e".equals(valueShape) && !enumExists(second, entries.get(i + 1))) return false;
+          }
+        }
+        return true;
+      } catch (IllegalArgumentException e) {
+        return false;
+      }
+    }
+  }
+
+  private static boolean enumExists(Class<? extends Enum<?>> type, Object name) {
+    if (name == null) return true;
+    if (type == null) return false;
+    for (Enum<?> constant : type.getEnumConstants()) {
+      if (constant.name().equals(name)) return true;
+    }
+    return false;
+  }
+
+  private static int topLevelComma(String value) {
+    int depth = 0;
+    for (int i = 0; i < value.length(); i++) {
+      char c = value.charAt(i);
+      if (c == '(') depth++;
+      if (c == ')') depth--;
+      if (c == ',' && depth == 0) return i;
+    }
+    return -1;
+  }
+
+  private static void invokeNestedWriter(Object value, DataOutput output) throws IOException {
+    try {
+      Method method = value.getClass().getMethod("writeTo", DataOutput.class);
+      method.setAccessible(true);
+      method.invoke(value, output);
+    } catch (NoSuchMethodException e) {
+      throw new IOException("Nested value has no binary writer", e);
+    } catch (IllegalAccessException e) {
+      throw new IOException("Nested binary writer is inaccessible", e);
+    } catch (InvocationTargetException e) {
+      Throwable cause = e.getCause();
+      if (cause instanceof IOException) {
+        throw (IOException) cause;
+      }
+      throw new IOException("Nested binary writer failed", cause);
+    }
+  }
+
+  private static void writeValue(DataOutput output, Shape shape, Object value) throws IOException {
+    char kind = shape.kind();
+    if (isNullableKind(kind)) {
+      if (value == null) {
+        output.writeByte(0);
+        return;
+      }
+      output.writeByte(1);
+    }
+    switch (kind) {
+    case 'z': case 'Z': output.writeBoolean((Boolean) value); return;
+    case 'b': case 'B': output.writeByte(((Number) value).byteValue()); return;
+    case 'h': case 'H': output.writeShort(((Number) value).shortValue()); return;
+    case 'c': case 'C': output.writeChar((Character) value); return;
+    case 'i': case 'I': output.writeInt(((Number) value).intValue()); return;
+    case 'j': case 'J': output.writeLong(((Number) value).longValue()); return;
+    case 'f': case 'F': output.writeFloat(((Number) value).floatValue()); return;
+    case 'd': case 'D': output.writeDouble(((Number) value).doubleValue()); return;
+    case 's': writeString(output, (String) value); return;
+    case 'e': writeString(output, ((Enum<?>) value).name()); return;
+    case 'o': writeOptional(output, shape.element(), value); return;
+    case 'p': writeSpecializedOptional(output, shape.specialized(), value); return;
+    case 'a': writeArray(output, shape.element(), value); return;
+    case 'l': case 't': case 'r': writeCollection(output, shape.element(), value); return;
+    case 'u': writeMultiset(output, shape.element(), value); return;
+    case 'm': case 'q': case 'k': writeMap(output, shape.first(), shape.second(), value); return;
+    case 'x': writeMultimap(output, shape.first(), shape.second(), value); return;
+    default: throw new IOException("Unsupported binary shape: " + shape.text);
+    }
+  }
+
+  private static Object readValue(DataInputStream input, Shape shape) throws IOException {
+    char kind = shape.kind();
+    if (isNullableKind(kind)) {
+      int marker = input.readUnsignedByte();
+      if (marker == 0) return null;
+      if (marker != 1) throw new IOException("Invalid null marker");
+    }
+    switch (kind) {
+    case 'z': case 'Z': return input.readBoolean();
+    case 'b': case 'B': return input.readByte();
+    case 'h': case 'H': return input.readShort();
+    case 'c': case 'C': return input.readChar();
+    case 'i': case 'I': return input.readInt();
+    case 'j': case 'J': return input.readLong();
+    case 'f': case 'F': return input.readFloat();
+    case 'd': case 'D': return input.readDouble();
+    case 's': return readString(input);
+    case 'e': return readString(input);
+    case 'o': return readOptional(input, shape.element());
+    case 'p': return readSpecializedOptional(input, shape.specialized());
+    case 'a': case 'l': case 't': case 'r': return readCollection(input, shape.element());
+    case 'u': return readMultiset(input, shape.element());
+    case 'm': case 'q': case 'k': return readMap(input, shape.first(), shape.second());
+    case 'x': return readMultimap(input, shape.first(), shape.second());
+    default: throw new IOException("Unsupported binary shape: " + shape.text);
+    }
+  }
+
+  private static boolean isNullableKind(char kind) {
+    return Character.isUpperCase(kind) || kind == 's' || kind == 'e';
+  }
+
+  private static void writeOptional(DataOutput output, Shape element, Object optional)
+      throws IOException {
+    Boolean present = (Boolean) invoke(optional, "isPresent");
+    output.writeBoolean(present);
+    if (present) {
+      writeValue(output, element, invoke(optional, "get"));
+    }
+  }
+
+  private static List<Object> readOptional(DataInputStream input, Shape element) throws IOException {
+    List<Object> values = new ArrayList<Object>(1);
+    if (input.readBoolean()) {
+      values.add(readValue(input, element));
+    }
+    return values;
+  }
+
+  private static void writeSpecializedOptional(DataOutput output, char specialized, Object optional)
+      throws IOException {
+    boolean present = (Boolean) invoke(optional, "isPresent");
+    output.writeBoolean(present);
+    if (!present) return;
+    switch (specialized) {
+    case 'i': output.writeInt((Integer) invoke(optional, "getAsInt")); return;
+    case 'j': output.writeLong((Long) invoke(optional, "getAsLong")); return;
+    case 'd': output.writeDouble((Double) invoke(optional, "getAsDouble")); return;
+    default: throw new IOException("Unsupported specialized optional");
+    }
+  }
+
+  private static List<Object> readSpecializedOptional(DataInputStream input, char specialized)
+      throws IOException {
+    List<Object> values = new ArrayList<Object>(1);
+    if (!input.readBoolean()) return values;
+    switch (specialized) {
+    case 'i': values.add(input.readInt()); break;
+    case 'j': values.add(input.readLong()); break;
+    case 'd': values.add(input.readDouble()); break;
+    default: throw new IOException("Unsupported specialized optional");
+    }
+    return values;
+  }
+
+  private static void writeArray(DataOutput output, Shape element, Object array) throws IOException {
+    int length = java.lang.reflect.Array.getLength(array);
+    output.writeInt(length);
+    for (int i = 0; i < length; i++) {
+      writeValue(output, element, java.lang.reflect.Array.get(array, i));
+    }
+  }
+
+  private static void writeCollection(DataOutput output, Shape element, Object value)
+      throws IOException {
+    Collection<?> collection = (Collection<?>) value;
+    output.writeInt(collection.size());
+    for (Object item : collection) {
+      writeValue(output, element, item);
+    }
+  }
+
+  private static List<Object> readCollection(DataInputStream input, Shape element)
+      throws IOException {
+    int size = readLength(input);
+    List<Object> values = new ArrayList<Object>(size);
+    for (int i = 0; i < size; i++) {
+      values.add(readValue(input, element));
+    }
+    return values;
+  }
+
+  private static void writeMap(DataOutput output, Shape key, Shape value, Object object)
+      throws IOException {
+    Map<?, ?> map = (Map<?, ?>) object;
+    output.writeInt(map.size());
+    for (Map.Entry<?, ?> entry : map.entrySet()) {
+      writeValue(output, key, entry.getKey());
+      writeValue(output, value, entry.getValue());
+    }
+  }
+
+  private static List<Object> readMap(DataInputStream input, Shape key, Shape value)
+      throws IOException {
+    int size = readLength(input);
+    List<Object> entries = new ArrayList<Object>(size * 2);
+    for (int i = 0; i < size; i++) {
+      entries.add(readValue(input, key));
+      entries.add(readValue(input, value));
+    }
+    return entries;
+  }
+
+  private static void writeMultiset(DataOutput output, Shape element, Object multiset)
+      throws IOException {
+    Collection<?> entries = (Collection<?>) invoke(multiset, "entrySet");
+    output.writeInt(entries.size());
+    for (Object entry : entries) {
+      writeValue(output, element, invoke(entry, "getElement"));
+      output.writeInt((Integer) invoke(entry, "getCount"));
+    }
+  }
+
+  private static List<Object> readMultiset(DataInputStream input, Shape element)
+      throws IOException {
+    int size = readLength(input);
+    List<Object> values = new ArrayList<Object>();
+    for (int i = 0; i < size; i++) {
+      Object value = readValue(input, element);
+      int count = readLength(input);
+      for (int occurrence = 0; occurrence < count; occurrence++) {
+        values.add(value);
+      }
+    }
+    return values;
+  }
+
+  private static void writeMultimap(DataOutput output, Shape key, Shape value, Object multimap)
+      throws IOException {
+    Collection<?> entries = (Collection<?>) invoke(multimap, "entries");
+    output.writeInt(entries.size());
+    for (Object object : entries) {
+      Map.Entry<?, ?> entry = (Map.Entry<?, ?>) object;
+      writeValue(output, key, entry.getKey());
+      writeValue(output, value, entry.getValue());
+    }
+  }
+
+  private static List<Object> readMultimap(DataInputStream input, Shape key, Shape value)
+      throws IOException {
+    return readMap(input, key, value);
+  }
+
+  private static Object invoke(Object target, String method) throws IOException {
+    try {
+      Method operation = target.getClass().getMethod(method);
+      operation.setAccessible(true);
+      return operation.invoke(target);
+    } catch (ReflectiveOperationException e) {
+      throw new IOException("Cannot access binary container operation " + method, e);
+    }
+  }
+
+  private static int readLength(DataInput input) throws IOException {
+    int length = input.readInt();
+    if (length < 0 || length > MAX_LENGTH) {
+      throw new IOException("Invalid binary length: " + length);
+    }
+    return length;
+  }
+
+  private static void writeString(DataOutput output, String value) throws IOException {
+    byte[] bytes = value.getBytes(StandardCharsets.UTF_8);
+    output.writeInt(bytes.length);
+    output.write(bytes);
+  }
+
+  private static String readString(DataInput input) throws IOException {
+    int length = readLength(input);
+    byte[] bytes = new byte[length];
+    input.readFully(bytes);
+    return new String(bytes, StandardCharsets.UTF_8);
+  }
+
+  private static void requireFinished(DataInputStream input) throws IOException {
+    if (input.read() != -1) {
+      throw new IOException("Trailing data in binary field");
+    }
+  }
+
+  private static final class Id {
+    private final long high;
+    private final long low;
+
+    Id(long high, long low) {
+      this.high = high;
+      this.low = low;
+    }
+
+    @Override public boolean equals(Object object) {
+      if (!(object instanceof Id)) return false;
+      Id other = (Id) object;
+      return high == other.high && low == other.low;
+    }
+
+    @Override public int hashCode() {
+      return (int) (high ^ (high >>> 32) ^ low ^ (low >>> 32));
+    }
+  }
+
+  private static final class EncodedField {
+    private final String shape;
+    private final byte[] payload;
+
+    EncodedField(String shape, byte[] payload) {
+      this.shape = shape;
+      this.payload = payload;
+    }
+  }
+
+  private static final class Shape {
+    private final String text;
+
+    Shape(String text) throws IOException {
+      if (text == null || text.isEmpty()) throw new IOException("Empty binary shape");
+      this.text = text;
+    }
+
+    char kind() {
+      return text.charAt(0);
+    }
+
+    char specialized() throws IOException {
+      if (text.length() != 2) throw new IOException("Invalid specialized optional shape: " + text);
+      return text.charAt(1);
+    }
+
+    Shape element() throws IOException {
+      List<Shape> arguments = arguments();
+      if (arguments.size() != 1) throw new IOException("Invalid unary binary shape: " + text);
+      return arguments.get(0);
+    }
+
+    Shape first() throws IOException {
+      List<Shape> arguments = arguments();
+      if (arguments.size() != 2) throw new IOException("Invalid binary mapping shape: " + text);
+      return arguments.get(0);
+    }
+
+    Shape second() throws IOException {
+      List<Shape> arguments = arguments();
+      if (arguments.size() != 2) throw new IOException("Invalid binary mapping shape: " + text);
+      return arguments.get(1);
+    }
+
+    private List<Shape> arguments() throws IOException {
+      if (text.length() < 4 || text.charAt(1) != '(' || text.charAt(text.length() - 1) != ')') {
+        throw new IOException("Invalid parameterized binary shape: " + text);
+      }
+      String body = text.substring(2, text.length() - 1);
+      List<Shape> arguments = new ArrayList<Shape>(2);
+      int depth = 0;
+      int start = 0;
+      for (int i = 0; i < body.length(); i++) {
+        char c = body.charAt(i);
+        if (c == '(') depth++;
+        if (c == ')') depth--;
+        if (c == ',' && depth == 0) {
+          arguments.add(new Shape(body.substring(start, i)));
+          start = i + 1;
+        }
+        if (depth < 0) throw new IOException("Invalid binary shape: " + text);
+      }
+      if (depth != 0 || start >= body.length()) throw new IOException("Invalid binary shape: " + text);
+      arguments.add(new Shape(body.substring(start)));
+      return arguments;
+    }
+  }
+}
