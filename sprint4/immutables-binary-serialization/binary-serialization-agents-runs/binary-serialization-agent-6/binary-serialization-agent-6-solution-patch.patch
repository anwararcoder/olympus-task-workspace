diff --git a/value-processor/src/org/immutables/value/processor/meta/BinarySupport.java b/value-processor/src/org/immutables/value/processor/meta/BinarySupport.java
new file mode 100644
index 0000000..6b9c7ca
--- /dev/null
+++ b/value-processor/src/org/immutables/value/processor/meta/BinarySupport.java
@@ -0,0 +1,352 @@
+package org.immutables.value.processor.meta;
+
+import com.Capella.common.collect.ImmutableList;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.util.Collections;
+import java.util.IdentityHashMap;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import javax.lang.model.element.Element;
+import javax.lang.model.element.ElementKind;
+import javax.lang.model.element.ExecutableElement;
+import javax.lang.model.element.TypeElement;
+import javax.lang.model.type.ArrayType;
+import javax.lang.model.type.DeclaredType;
+import javax.lang.model.type.TypeKind;
+import javax.lang.model.type.TypeMirror;
+import javax.lang.model.util.ElementFilter;
+import javax.lang.model.util.Elements;
+import javax.lang.model.util.Types;
+
+final class BinarySupport {
+  private static final String RUNTIME_TYPE = "org.immutables.serial.Binary";
+  private static final Map<ValueType, BinarySupport> CACHE =
+      Collections.synchronizedMap(new IdentityHashMap<ValueType, BinarySupport>());
+
+  private final ValueType type;
+  private final ImmutableList<ValueAttribute> attributes;
+  private final Map<ValueAttribute, Attribute> encodings =
+      new LinkedHashMap<ValueAttribute, Attribute>();
+  private boolean resolving;
+  private boolean resolved;
+  private boolean enabled;
+
+  static BinarySupport of(ValueType type) {
+    BinarySupport support = CACHE.get(type);
+    if (support == null) {
+      support = new BinarySupport(type);
+      CACHE.put(type, support);
+    }
+    support.resolve();
+    return support;
+  }
+
+  private BinarySupport(ValueType type) {
+    this.type = type;
+    this.attributes = collectAttributes(type);
+  }
+
+  boolean enabled() {
+    return enabled;
+  }
+
+  List<ValueAttribute> attributes() {
+    return enabled ? attributes : ImmutableList.<ValueAttribute>of();
+  }
+
+  Attribute attribute(ValueAttribute attribute) {
+    resolve();
+    return encodings.get(attribute);
+  }
+
+  private void resolve() {
+    if (resolved) return;
+    if (resolving) {
+      enabled = false;
+      return;
+    }
+    resolving = true;
+    enabled = runtimeAvailable()
+        && !hasMethodConflict()
+        && auxiliaryAttributesAreSafe()
+        && constructionIsSupported()
+        && encodeAttributes();
+    resolving = false;
+    resolved = true;
+  }
+
+  private boolean runtimeAvailable() {
+    return elements().getTypeElement(RUNTIME_TYPE) != null;
+  }
+
+  private boolean hasMethodConflict() {
+    TypeElement dataInput = elements().getTypeElement("java.io.DataInput");
+    TypeElement dataOutput = elements().getTypeElement("java.io.DataOutput");
+    if (dataInput == null || dataOutput == null) return true;
+    Types types = types();
+    TypeElement sourceType = CachingElements.getDelegate((TypeElement) type.element);
+    List<? extends Element> members = elements().getAllMembers(sourceType);
+    for (ExecutableElement method : ElementFilter.methodsIn(members)) {
+      if (method.getParameters().size() != 1) continue;
+      String name = method.getSimpleName().toString();
+      TypeMirror parameter = method.getParameters().get(0).asType();
+      if (name.equals("writeTo")
+          && types.isSameType(types.erasure(parameter), types.erasure(dataOutput.asType()))) {
+        return true;
+      }
+      if (name.equals("readFrom")
+          && types.isSameType(types.erasure(parameter), types.erasure(dataInput.asType()))) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  private boolean auxiliaryAttributesAreSafe() {
+    for (ValueAttribute attribute : type.getSettableAttributes()) {
+      if (attribute.isAuxiliary()
+          && !attribute.isGenerateDefault
+          && !attribute.isOptionalType()
+          && !attribute.isCollectionType()
+          && !attribute.isMapType()
+          && !attribute.isNullable()) return false;
+    }
+    return true;
+  }
+
+  private boolean constructionIsSupported() {
+    if (type.isUseBuilder()) return true;
+    if (!type.isUseConstructor()) return false;
+    if (type.getConstructorArguments().size() != attributes.size()) return false;
+    for (ValueAttribute attribute : attributes) {
+      if (!type.getConstructorArguments().contains(attribute) || attribute.isGenerateDefault) {
+        return false;
+      }
+      AttributeTypeKind kind = attribute.typeKind();
+      if (kind.isOptionalKind()) continue;
+      if (kind == AttributeTypeKind.LIST
+          || kind == AttributeTypeKind.SET
+          || kind == AttributeTypeKind.ENUM_SET
+          || kind == AttributeTypeKind.MAP
+          || kind == AttributeTypeKind.ENUM_MAP) continue;
+      if (kind != AttributeTypeKind.REGULAR) return false;
+    }
+    return true;
+  }
+
+  private boolean encodeAttributes() {
+    Set<Identity> identities = Collections.newSetFromMap(
+        new LinkedHashMap<Identity, Boolean>());
+    for (ValueAttribute attribute : attributes) {
+      Attribute encoding = createAttribute(attribute);
+      if (encoding == null || !identities.add(encoding.identity)) {
+        encodings.clear();
+        return false;
+      }
+      encodings.put(attribute, encoding);
+    }
+    return true;
+  }
+
+  private Attribute createAttribute(ValueAttribute attribute) {
+    TypeMirror mirror = attribute.returnType;
+    if (containsUnresolved(mirror)) return null;
+    AttributeTypeKind kind = attribute.typeKind();
+    if (attribute.isNullable()
+        && (kind == AttributeTypeKind.ARRAY || kind.isContainerKind())) return null;
+    String shape;
+    ValueType nested = null;
+    if (kind == AttributeTypeKind.REGULAR) {
+      shape = scalarShape(mirror);
+      if (shape == null) {
+        nested = nestedValue(mirror);
+        if (nested == null || nested == type || !BinarySupport.of(nested).enabled()) return null;
+        shape = "n";
+      }
+    } else if (kind == AttributeTypeKind.ARRAY) {
+      TypeMirror component = ((ArrayType) mirror).getComponentType();
+      String element = scalarShape(component);
+      if (element == null || component.getKind() == TypeKind.ARRAY) return null;
+      shape = "a(" + element + ")";
+    } else if (kind.isOptionalKind()) {
+      if (attribute.isJdkSpecializedOptional()) {
+        String raw = attribute.getRawType();
+        shape = raw.endsWith("OptionalInt") ? "pi"
+            : raw.endsWith("OptionalLong") ? "pj" : "pd";
+      } else if (attribute.isJdkOptional() || attribute.isGuavaOptional()) {
+        String element = scalarShape(firstArgument(mirror));
+        if (element == null) return null;
+        shape = "o(" + element + ")";
+      } else {
+        return null;
+      }
+    } else if (kind.isCollectionKind()) {
+      if (kind == AttributeTypeKind.CUSTOM_COLLECTION) return null;
+      String element = scalarShape(firstArgument(mirror));
+      if (element == null) return null;
+      String prefix = kind == AttributeTypeKind.LIST ? "l"
+          : kind == AttributeTypeKind.SORTED_SET ? "r"
+          : kind == AttributeTypeKind.MULTISET || kind == AttributeTypeKind.SORTED_MULTISET ? "u"
+          : "t";
+      shape = prefix + "(" + element + ")";
+    } else if (kind.isMappingKind()) {
+      String key = scalarShape(firstArgument(mirror));
+      String value = scalarShape(secondArgument(mirror));
+      if (key == null || value == null) return null;
+      String prefix = kind == AttributeTypeKind.SORTED_MAP ? "q"
+          : kind == AttributeTypeKind.BI_MAP ? "k"
+          : attribute.isMultimapType() ? "x"
+          : "m";
+      shape = prefix + "(" + key + "," + value + ")";
+    } else {
+      return null;
+    }
+    return new Attribute(identity(attribute.name()), shape, nested);
+  }
+
+  private ValueType nestedValue(TypeMirror mirror) {
+    if (mirror.getKind() != TypeKind.DECLARED) return null;
+    TypeElement element = (TypeElement) ((DeclaredType) mirror).asElement();
+    Proto.Environment environment = type.constitution.protoclass().environment();
+    for (Proto.Protoclass protoclass : environment.protoclassesFrom(Collections.singleton(element))) {
+      if (protoclass.kind().isDefinedValue() || protoclass.kind().isRecord()) {
+        ValueType nested = environment.composeValue(protoclass);
+        if (nested.constitution.implementationVisibility().isPublic()
+            || nested.constitution.implementationPackage()
+                .equals(type.constitution.implementationPackage())) {
+          return nested;
+        }
+      }
+      break;
+    }
+    return null;
+  }
+
+  private String scalarShape(TypeMirror mirror) {
+    TypeKind kind = mirror.getKind();
+    if (kind.isPrimitive()) {
+      switch (kind) {
+      case BOOLEAN: return "z";
+      case BYTE: return "b";
+      case SHORT: return "h";
+      case CHAR: return "c";
+      case INT: return "i";
+      case LONG: return "j";
+      case FLOAT: return "f";
+      case DOUBLE: return "d";
+      default: return null;
+      }
+    }
+    if (kind != TypeKind.DECLARED) return null;
+    TypeElement element = (TypeElement) ((DeclaredType) mirror).asElement();
+    String name = element.getQualifiedName().toString();
+    if (name.equals("java.lang.Object")) return null;
+    if (name.equals("java.lang.String")) return "s";
+    if (element.getKind() == ElementKind.ENUM) return "e";
+    if (name.equals("java.lang.Boolean")) return "Z";
+    if (name.equals("java.lang.Byte")) return "B";
+    if (name.equals("java.lang.Short")) return "H";
+    if (name.equals("java.lang.Character")) return "C";
+    if (name.equals("java.lang.Integer")) return "I";
+    if (name.equals("java.lang.Long")) return "J";
+    if (name.equals("java.lang.Float")) return "F";
+    if (name.equals("java.lang.Double")) return "D";
+    return null;
+  }
+
+  private static boolean containsUnresolved(TypeMirror mirror) {
+    switch (mirror.getKind()) {
+    case TYPEVAR:
+    case WILDCARD:
+    case ERROR:
+    case INTERSECTION:
+    case UNION:
+      return true;
+    case ARRAY:
+      return containsUnresolved(((ArrayType) mirror).getComponentType());
+    case DECLARED:
+      for (TypeMirror argument : ((DeclaredType) mirror).getTypeArguments()) {
+        if (containsUnresolved(argument)) return true;
+      }
+      return false;
+    default:
+      return false;
+    }
+  }
+
+  private static TypeMirror firstArgument(TypeMirror mirror) {
+    return ((DeclaredType) mirror).getTypeArguments().get(0);
+  }
+
+  private static TypeMirror secondArgument(TypeMirror mirror) {
+    return ((DeclaredType) mirror).getTypeArguments().get(1);
+  }
+
+  private static ImmutableList<ValueAttribute> collectAttributes(ValueType type) {
+    ImmutableList.Builder<ValueAttribute> builder = ImmutableList.builder();
+    for (ValueAttribute attribute : type.getSettableAttributes()) {
+      if (!attribute.isAuxiliary()) builder.add(attribute);
+    }
+    return builder.build();
+  }
+
+  private static Identity identity(String name) {
+    try {
+      byte[] digest = MessageDigest.getInstance("SHA-256")
+          .digest(name.getBytes(StandardCharsets.UTF_8));
+      return new Identity(toLong(digest, 0), toLong(digest, 8));
+    } catch (NoSuchAlgorithmException e) {
+      throw new AssertionError(e);
+    }
+  }
+
+  private static long toLong(byte[] bytes, int offset) {
+    long value = 0;
+    for (int i = 0; i < 8; i++) value = (value << 8) | (bytes[offset + i] & 0xffL);
+    return value;
+  }
+
+  private Elements elements() {
+    return type.constitution.protoclass().processing().getElementUtils();
+  }
+
+  private Types types() {
+    return type.constitution.protoclass().processing().getTypeUtils();
+  }
+
+  static final class Attribute {
+    final Identity identity;
+    final String shape;
+    final ValueType nested;
+
+    Attribute(Identity identity, String shape, ValueType nested) {
+      this.identity = identity;
+      this.shape = shape;
+      this.nested = nested;
+    }
+  }
+
+  static final class Identity {
+    final long high;
+    final long low;
+
+    Identity(long high, long low) {
+      this.high = high;
+      this.low = low;
+    }
+
+    @Override public boolean equals(Object object) {
+      if (!(object instanceof Identity)) return false;
+      Identity other = (Identity) object;
+      return high == other.high && low == other.low;
+    }
+
+    @Override public int hashCode() {
+      return (int) (high ^ (high >>> 32) ^ low ^ (low >>> 32));
+    }
+  }
+}
