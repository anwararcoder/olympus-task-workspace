+  default void writeTo(DataOutput output) throws IOException {
+    output.writeInt(number());
+  }
+}
diff --git a/serial/test/org/immutables/serial/fixture/BinaryFormTest.java b/serial/test/org/immutables/serial/fixture/BinaryFormTest.java
new file mode 100644
index 0000000..f3658ee
--- /dev/null
+++ b/serial/test/org/immutables/serial/fixture/BinaryFormTest.java
@@ -0,0 +1,182 @@
+package org.immutables.serial.fixture;
+
+import com.Capella.common.base.Optional;
+import com.Capella.common.collect.ImmutableBiMap;
+import com.Capella.common.collect.ImmutableList;
+import com.Capella.common.collect.ImmutableListMultimap;
+import com.Capella.common.collect.ImmutableMap;
+import com.Capella.common.collect.ImmutableMultiset;
+import com.Capella.common.collect.ImmutableSet;
+import com.Capella.common.collect.ImmutableSetMultimap;
+import com.Capella.common.collect.ImmutableSortedMap;
+import com.Capella.common.collect.ImmutableSortedMultiset;
+import com.Capella.common.collect.ImmutableSortedSet;
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.DataInput;
+import java.io.DataInputStream;
+import java.io.DataOutput;
+import java.io.DataOutputStream;
+import java.lang.reflect.Method;
+import java.util.Arrays;
+import org.junit.Test;
+import static org.immutables.check.Checkers.check;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.fail;
+
+public class BinaryFormTest {
+  @Test
+  public void roundTripsBuilderCollectionsAndLongStrings() throws Exception {
+    char[] chars = new char[100_000];
+    Arrays.fill(chars, 'x');
+    ImmutableBinaryCollections value = ImmutableBinaryCollections.builder()
+        .flag(true)
+        .boxed(2)
+        .text(new String(chars))
+        .enumeration(BinaryEnum.SECOND)
+        .jdkOptional(java.util.Optional.of("jdk"))
+        .guavaOptional(BinaryEnum.FIRST)
+        .optionalInt(3)
+        .optionalLong(4L)
+        .optionalDouble(5.5)
+        .ints(1, 2, 3)
+        .strings("a", "b")
+        .addAllList(ImmutableList.of("a", "b"))
+        .addAllSet(ImmutableSet.of(BinaryEnum.FIRST, BinaryEnum.SECOND))
+        .addAllSortedSet(ImmutableSortedSet.of(3, 1, 2))
+        .addAllMultiset(ImmutableMultiset.of("x", "x", "y"))
+        .addAllSortedMultiset(ImmutableSortedMultiset.of(2, 1, 2))
+        .putAllMap(ImmutableMap.of("a", BinaryEnum.SECOND))
+        .putAllSortedMap(ImmutableSortedMap.of(2, "b", 1, "a"))
+        .putAllBimap(ImmutableBiMap.of("a", 1))
+        .putAllListMultimap(ImmutableListMultimap.of("a", 1, "a", 1, "a", 2))
+        .putAllSetMultimap(ImmutableSetMultimap.of("a", BinaryEnum.FIRST))
+        .build();
+
+    check(roundTrip(value, ImmutableBinaryCollections::readFrom)).is(value);
+  }
+
+  @Test
+  public void roundTripsConstructorBuiltValues() throws Exception {
+    ImmutableBinaryConstructor value = ImmutableBinaryConstructor.of(
+        7,
+        BinaryEnum.SECOND,
+        java.util.Optional.of("optional"),
+        ImmutableList.of(1, 2),
+        ImmutableSet.of("a", "b"),
+        ImmutableMap.of("a", 1L));
+
+    check(roundTrip(value, ImmutableBinaryConstructor::readFrom)).is(value);
+  }
+
+  @Test
+  public void matchesByIdentityAndShapeAcrossTypes() throws Exception {
+    ImmutableBinaryOld old = ImmutableBinaryOld.builder()
+        .stable(11)
+        .changed("not a long")
+        .removed("unknown")
+        .enumeration(BinaryEnum.SECOND)
+        .build();
+
+    ImmutableBinaryNew migrated = read(write(old), ImmutableBinaryNew::readFrom);
+    check(migrated.stable()).is(11);
+    check(migrated.changed()).is(0L);
+    check(migrated.enumeration()).is(BinaryEnum.SECOND);
+    check(migrated.added()).is(java.util.Optional.empty());
+    check(migrated.replacement()).is(java.util.Optional.empty());
+  }
+
+  @Test
+  public void nestedVersionsStayFramedBeforeFollowingFields() throws Exception {
+    ImmutableBinaryOuterOld old = ImmutableBinaryOuterOld.builder()
+        .nested(ImmutableBinaryNestedOld.builder().stable(19).build())
+        .following("after nested")
+        .build();
+
+    ImmutableBinaryOuterNew migrated = read(write(old), ImmutableBinaryOuterNew::readFrom);
+    check(migrated.nested().stable()).is(19);
+    check(migrated.nested().added()).is(java.util.Optional.empty());
+    check(migrated.following()).is("after nested");
+  }
+
+  @Test
+  public void mismatchedEnumElementsMakeTheWholeAttributeAbsent() throws Exception {
+    ImmutableBinaryEnumContainerOld old = ImmutableBinaryEnumContainerOld.builder()
+        .addValues(BinaryEnum.FIRST, BinaryEnum.SECOND)
+        .following(23)
+        .build();
+
+    ImmutableBinaryEnumContainerNew migrated =
+        read(write(old), ImmutableBinaryEnumContainerNew::readFrom);
+    check(migrated.values()).isEmpty();
+    check(migrated.following()).is(23);
+  }
+
+  @Test
+  public void incompleteInputFails() throws Exception {
+    byte[] complete = write(ImmutableBinaryOld.builder()
+        .stable(1)
+        .changed("value")
+        .removed("value")
+        .enumeration(BinaryEnum.FIRST)
+        .build());
+    try {
+      read(Arrays.copyOf(complete, complete.length - 1), ImmutableBinaryOld::readFrom);
+      fail("Expected incomplete input to fail");
+    } catch (java.io.EOFException expected) {
+    }
+  }
+
+  @Test
+  public void omitsDerivedAndOptionalAuxiliaryAttributes() throws Exception {
+    ImmutableBinaryDerivedAuxiliary value = ImmutableBinaryDerivedAuxiliary.builder()
+        .number(6)
+        .metadata(Optional.of("not encoded"))
+        .build();
+
+    ImmutableBinaryDerivedAuxiliary decoded =
+        roundTrip(value, ImmutableBinaryDerivedAuxiliary::readFrom);
+    check(decoded.number()).is(6);
+    check(decoded.doubled()).is(12);
+    assertFalse(decoded.metadata().isPresent());
+  }
+
+  @Test
+  public void unsupportedRecursiveAndConflictingTypesGetNoPair() {
+    assertFalse(hasBinaryPair(ImmutableBinaryUnsupportedObject.class));
+    assertFalse(hasBinaryPair(ImmutableBinaryRecursive.class));
+    assertFalse(hasBinaryPair(ImmutableBinaryRequiredAuxiliary.class));
+    assertFalse(hasBinaryPair(ImmutableBinaryConflict.class));
+  }
+
+  private static boolean hasBinaryPair(Class<?> type) {
+    boolean writer = false;
+    boolean reader = false;
+    for (Method method : type.getDeclaredMethods()) {
+      writer |= method.getName().equals("writeTo")
+          && Arrays.equals(method.getParameterTypes(), new Class<?>[] {DataOutput.class});
+      reader |= method.getName().equals("readFrom")
+          && Arrays.equals(method.getParameterTypes(), new Class<?>[] {DataInput.class});
+    }
+    return writer && reader;
+  }
+
+  private static <T> T roundTrip(T value, BinaryReader<T> reader) throws Exception {
+    return read(write(value), reader);
+  }
+
+  private static byte[] write(Object value) throws Exception {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    Method method = value.getClass().getMethod("writeTo", DataOutput.class);
+    method.invoke(value, new DataOutputStream(bytes));
+    return bytes.toByteArray();
+  }
+
+  private static <T> T read(byte[] bytes, BinaryReader<T> reader) throws Exception {
+    return reader.read(new DataInputStream(new ByteArrayInputStream(bytes)));
+  }
+
+  private interface BinaryReader<T> {
+    T read(DataInput input) throws Exception;
+  }
+}
