index 0000000..16bb44d
--- /dev/null
+++ b/serial/src/org/immutables/serial/CompactBinary.java
@@ -0,0 +1,485 @@
+package org.immutables.serial;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.DataInput;
+import java.io.DataInputStream;
+import java.io.DataOutput;
+import java.io.DataOutputStream;
+import java.io.EOFException;
+import java.io.IOException;
+import java.lang.reflect.Array;
+import java.lang.reflect.InvocationTargetException;
+import java.lang.reflect.Method;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collection;
+import java.util.List;
+import java.util.Map;
+
+/** Runtime support used by compact binary methods generated for immutable values. */
+public final class CompactBinary {
+  private static final int MAGIC = 0x494D4231;
+
+  private CompactBinary() {}
+
+  public static Writer writer(DataOutput output, int fieldCount) throws IOException {
+    return new Writer(output, fieldCount);
+  }
+
+  public static Reader reader(DataInput input) throws IOException {
+    return new Reader(input);
+  }
+
+  public static final class Writer {
+    private final DataOutput output;
+    private int remaining;
+
+    private Writer(DataOutput output, int fieldCount) throws IOException {
+      if (fieldCount < 0) {
+        throw new IllegalArgumentException("Negative field count");
+      }
+      this.output = output;
+      this.remaining = fieldCount;
+      output.writeInt(MAGIC);
+      output.writeInt(fieldCount);
+    }
+
+    public void write(long id, String shape, Object value) throws IOException {
+      if (remaining == 0) {
+        throw new IOException("Too many compact binary fields");
+      }
+      byte[] shapeBytes = shape.getBytes(StandardCharsets.US_ASCII);
+      ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+      DataOutputStream data = new DataOutputStream(bytes);
+      new Parser(shape).parse().write(data, value);
+      data.flush();
+
+      output.writeLong(id);
+      output.writeInt(shapeBytes.length);
+      output.write(shapeBytes);
+      output.writeInt(bytes.size());
+      output.write(bytes.toByteArray());
+      remaining--;
+    }
+  }
+
+  public static final class Reader {
+    private final List<Field> fields;
+
+    private Reader(DataInput input) throws IOException {
+      if (input.readInt() != MAGIC) {
+        throw new IOException("Invalid compact binary header");
+      }
+      int count = input.readInt();
+      if (count < 0) {
+        throw new IOException("Negative compact binary field count");
+      }
+      fields = new ArrayList<>(count);
+      for (int i = 0; i < count; i++) {
+        long id = input.readLong();
+        int shapeLength = input.readInt();
+        if (shapeLength < 0 || shapeLength > 1024) {
+          throw new IOException("Invalid compact binary shape length");
+        }
+        byte[] shape = new byte[shapeLength];
+        input.readFully(shape);
+        int valueLength = input.readInt();
+        if (valueLength < 0) {
+          throw new IOException("Negative compact binary value length");
+        }
+        byte[] value = new byte[valueLength];
+        input.readFully(value);
+        fields.add(new Field(id, shape, value));
+      }
+    }
+
+    public boolean has(long id, String shape) {
+      return find(id, shape) != null;
+    }
+
+    public Object read(long id, String shape, Class<?>... leafTypes) throws IOException {
+      Field field = find(id, shape);
+      if (field == null) {
+        return null;
+      }
+      Node node = new Parser(shape).parse();
+      if (node.leafCount() != leafTypes.length) {
+        throw new IOException("Incorrect compact binary leaf type count");
+      }
+      DataInputStream data = new DataInputStream(new ByteArrayInputStream(field.value));
+      Object value = node.read(data, leafTypes);
+      if (data.read() != -1) {
+        throw new IOException("Trailing compact binary value data");
+      }
+      return value;
+    }
+
+    private Field find(long id, String shape) {
+      byte[] expected = shape.getBytes(StandardCharsets.US_ASCII);
+      for (Field field : fields) {
+        if (field.id == id && Arrays.equals(field.shape, expected)) {
+          return field;
+        }
+      }
+      return null;
+    }
+  }
+
+  private static final class Field {
+    final long id;
+    final byte[] shape;
+    final byte[] value;
+
+    Field(long id, byte[] shape, byte[] value) {
+      this.id = id;
+      this.shape = shape;
+      this.value = value;
+    }
+  }
+
+  private abstract static class Node {
+    abstract void write(DataOutput output, Object value) throws IOException;
+    abstract Object read(DataInput input, Class<?>[] leafTypes) throws IOException;
+    int leafCount() { return 0; }
+  }
+
+  private static final class ScalarNode extends Node {
+    private final char kind;
+    private final int leaf;
+
+    ScalarNode(char kind, int leaf) {
+      this.kind = kind;
+      this.leaf = leaf;
+    }
+
+    @Override void write(DataOutput output, Object value) throws IOException {
+      boolean nullable = Character.isUpperCase(kind) || kind == 's' || kind == 'e' || kind == 'n';
+      if (nullable) {
+        output.writeBoolean(value != null);
+        if (value == null) return;
+      }
+      switch (Character.toLowerCase(kind)) {
+      case 'z': output.writeBoolean((Boolean) value); return;
+      case 'b': output.writeByte((Byte) value); return;
+      case 'h': output.writeShort((Short) value); return;
+      case 'i': output.writeInt((Integer) value); return;
+      case 'j': output.writeLong((Long) value); return;
+      case 'f': output.writeFloat((Float) value); return;
+      case 'd': output.writeDouble((Double) value); return;
+      case 'c': output.writeChar((Character) value); return;
+      case 's': writeString(output, (String) value); return;
+      case 'e': writeString(output, ((Enum<?>) value).name()); return;
+      case 'n': invokeWrite(value, output); return;
+      default: throw new IOException("Unknown compact binary scalar " + kind);
+      }
+    }
+
+    @Override Object read(DataInput input, Class<?>[] leafTypes) throws IOException {
+      boolean nullable = Character.isUpperCase(kind) || kind == 's' || kind == 'e' || kind == 'n';
+      if (nullable && !input.readBoolean()) return null;
+      switch (Character.toLowerCase(kind)) {
+      case 'z': return input.readBoolean();
+      case 'b': return input.readByte();
+      case 'h': return input.readShort();
+      case 'i': return input.readInt();
+      case 'j': return input.readLong();
+      case 'f': return input.readFloat();
+      case 'd': return input.readDouble();
+      case 'c': return input.readChar();
+      case 's': return readString(input);
+      case 'e': return readEnum(readString(input), leafTypes[leaf]);
+      case 'n': return invokeRead(leafTypes[leaf], input);
+      default: throw new IOException("Unknown compact binary scalar " + kind);
+      }
+    }
+
+    @Override int leafCount() {
+      return leaf < 0 ? 0 : leaf + 1;
+    }
+  }
+
+  private static final class OptionalNode extends Node {
+    private final char kind;
+    private final Node element;
+
+    OptionalNode(char kind, Node element) {
+      this.kind = kind;
+      this.element = element;
+    }
+
+    @Override void write(DataOutput output, Object value) throws IOException {
+      boolean present;
+      Object item;
+      try {
+        if (kind == 'o') {
+          present = ((java.util.Optional<?>) value).isPresent();
+          item = present ? ((java.util.Optional<?>) value).get() : null;
+        } else if (kind == 'g') {
+          Class<?> optionalType = Class.forName("com.Capella.common.base.Optional");
+          Method isPresent = optionalType.getMethod("isPresent");
+          present = (Boolean) isPresent.invoke(value);
+          item = present ? optionalType.getMethod("get").invoke(value) : null;
+        } else if (kind == 'i') {
+          present = ((java.util.OptionalInt) value).isPresent();
+          item = present ? ((java.util.OptionalInt) value).getAsInt() : null;
+        } else if (kind == 'j') {
+          present = ((java.util.OptionalLong) value).isPresent();
+          item = present ? ((java.util.OptionalLong) value).getAsLong() : null;
+        } else {
+          present = ((java.util.OptionalDouble) value).isPresent();
+          item = present ? ((java.util.OptionalDouble) value).getAsDouble() : null;
+        }
+      } catch (ReflectiveOperationException | LinkageError ex) {
+        throw reflectionFailure(ex);
+      }
+      output.writeBoolean(present);
+      if (present) element.write(output, item);
+    }
+
+    @Override Object read(DataInput input, Class<?>[] leafTypes) throws IOException {
+      return input.readBoolean() ? element.read(input, leafTypes) : null;
+    }
+
+    @Override int leafCount() { return element.leafCount(); }
+  }
+
+  private static final class ArrayNode extends Node {
+    private final Node element;
+
+    ArrayNode(Node element) {
+      this.element = element;
+    }
+
+    @Override void write(DataOutput output, Object value) throws IOException {
+      if (value == null) {
+        output.writeInt(-1);
+        return;
+      }
+      int length = Array.getLength(value);
+      output.writeInt(length);
+      for (int i = 0; i < length; i++) element.write(output, Array.get(value, i));
+    }
+
+    @Override Object read(DataInput input, Class<?>[] leafTypes) throws IOException {
+      int length = input.readInt();
+      if (length < -1) throw new IOException("Invalid compact binary array length");
+      if (length == -1) return null;
+      Class<?> component = componentType(element, leafTypes);
+      Object array = Array.newInstance(component, length);
+      for (int i = 0; i < length; i++) Array.set(array, i, element.read(input, leafTypes));
+      return array;
+    }
+
+    @Override int leafCount() { return element.leafCount(); }
+  }
+
+  private static final class CollectionNode extends Node {
+    private final Node element;
+
+    CollectionNode(Node element) {
+      this.element = element;
+    }
+
+    @Override void write(DataOutput output, Object value) throws IOException {
+      if (value == null) {
+        output.writeInt(-1);
+        return;
+      }
+      Collection<?> collection = (Collection<?>) value;
+      output.writeInt(collection.size());
+      for (Object item : collection) element.write(output, item);
+    }
+
+    @Override Object read(DataInput input, Class<?>[] leafTypes) throws IOException {
+      int size = input.readInt();
+      if (size < -1) throw new IOException("Invalid compact binary collection size");
+      if (size == -1) return null;
+      Object[] items = new Object[size];
+      for (int i = 0; i < size; i++) items[i] = element.read(input, leafTypes);
+      return items;
+    }
+
+    @Override int leafCount() { return element.leafCount(); }
+  }
+
+  private static final class MappingNode extends Node {
+    private final boolean multimap;
+    private final Node key;
+    private final Node value;
+
+    MappingNode(boolean multimap, Node key, Node value) {
+      this.multimap = multimap;
+      this.key = key;
+      this.value = value;
+    }
+
+    @Override void write(DataOutput output, Object mapping) throws IOException {
+      if (mapping == null) {
+        output.writeInt(-1);
+        return;
+      }
+      Iterable<?> entries;
+      int size;
+      if (multimap) {
+        try {
+          Object result = mapping.getClass().getMethod("entries").invoke(mapping);
+          entries = (Iterable<?>) result;
+          size = ((Collection<?>) result).size();
+        } catch (ReflectiveOperationException ex) {
+          throw reflectionFailure(ex);
+        }
+      } else {
+        Collection<?> result = ((Map<?, ?>) mapping).entrySet();
+        entries = result;
+        size = result.size();
+      }
+      output.writeInt(size);
+      for (Object item : entries) {
+        Map.Entry<?, ?> entry = (Map.Entry<?, ?>) item;
+        key.write(output, entry.getKey());
+        value.write(output, entry.getValue());
+      }
+    }
+
+    @Override Object read(DataInput input, Class<?>[] leafTypes) throws IOException {
+      int size = input.readInt();
+      if (size < -1) throw new IOException("Invalid compact binary mapping size");
+      if (size == -1) return null;
+      Object[] entries = new Object[size * 2];
+      for (int i = 0; i < entries.length; i += 2) {
+        entries[i] = key.read(input, leafTypes);
+        entries[i + 1] = value.read(input, leafTypes);
+      }
+      return entries;
+    }
+
+    @Override int leafCount() { return Math.max(key.leafCount(), value.leafCount()); }
+  }
+
+  private static final class Parser {
+    private final String shape;
+    private int position;
+    private int leaf;
+
+    Parser(String shape) {
+      this.shape = shape;
+    }
+
+    Node parse() throws IOException {
+      Node node = node();
+      if (position != shape.length()) throw new IOException("Invalid compact binary shape " + shape);
+      return node;
+    }
+
+    private Node node() throws IOException {
+      if (position >= shape.length()) throw new EOFException("Incomplete compact binary shape");
+      char kind = shape.charAt(position++);
+      if ("zZbBhHiIjJfFdDcCs".indexOf(kind) >= 0) return new ScalarNode(kind, -1);
+      if (kind == 'e' || kind == 'n') return new ScalarNode(kind, leaf++);
+      if (kind == 'o' || kind == 'g') return new OptionalNode(kind, enclosed());
+      if (kind == 'p') {
+        if (position >= shape.length()) throw new EOFException("Incomplete compact binary optional shape");
+        char specialized = shape.charAt(position++);
+        if (specialized == 'i') return new OptionalNode('i', new ScalarNode('i', -1));
+        if (specialized == 'j') return new OptionalNode('j', new ScalarNode('j', -1));
+        if (specialized == 'd') return new OptionalNode('d', new ScalarNode('d', -1));
+        throw new IOException("Invalid compact binary optional shape " + shape);
+      }
+      if (kind == 'a') return new ArrayNode(enclosed());
+      if ("ltruv".indexOf(kind) >= 0) return new CollectionNode(enclosed());
+      if ("mqxwyk".indexOf(kind) >= 0) {
+        expect('(');
+        Node key = node();
+        expect(',');
+        Node value = node();
+        expect(')');
+        return new MappingNode("wyk".indexOf(kind) >= 0, key, value);
+      }
+      throw new IOException("Unknown compact binary shape " + shape);
+    }
+
+    private Node enclosed() throws IOException {
+      expect('(');
+      Node result = node();
+      expect(')');
+      return result;
+    }
+
+    private void expect(char expected) throws IOException {
+      if (position >= shape.length() || shape.charAt(position++) != expected) {
+        throw new IOException("Invalid compact binary shape " + shape);
+      }
+    }
+  }
+
+  private static void writeString(DataOutput output, String value) throws IOException {
+    byte[] bytes = value.getBytes(StandardCharsets.UTF_8);
+    output.writeInt(bytes.length);
+    output.write(bytes);
+  }
+
+  private static String readString(DataInput input) throws IOException {
+    int length = input.readInt();
+    if (length < 0) throw new IOException("Negative compact binary string length");
+    byte[] bytes = new byte[length];
+    input.readFully(bytes);
+    return new String(bytes, StandardCharsets.UTF_8);
+  }
+
+  @SuppressWarnings({"rawtypes", "unchecked"})
+  private static Object readEnum(String name, Class<?> enumType) throws IOException {
+    try {
+      return Enum.valueOf((Class) enumType, name);
+    } catch (IllegalArgumentException ex) {
+      throw new IOException("Unknown enum constant " + name, ex);
+    }
+  }
+
+  private static void invokeWrite(Object value, DataOutput output) throws IOException {
+    try {
+      Method method = value.getClass().getDeclaredMethod("writeTo", DataOutput.class);
+      method.setAccessible(true);
+      method.invoke(value, output);
+    } catch (ReflectiveOperationException ex) {
+      throw reflectionFailure(ex);
+    }
+  }
+
+  private static Object invokeRead(Class<?> type, DataInput input) throws IOException {
+    try {
+      Method method = type.getDeclaredMethod("readFrom", DataInput.class);
+      method.setAccessible(true);
+      return method.invoke(null, input);
+    } catch (ReflectiveOperationException | SecurityException ex) {
+      throw reflectionFailure(ex);
+    }
+  }
+
+  private static IOException reflectionFailure(Throwable ex) {
+    Throwable cause = ex instanceof InvocationTargetException
+        ? ((InvocationTargetException) ex).getCause()
+        : ex;
+    if (cause instanceof IOException) return (IOException) cause;
+    return new IOException("Cannot access compact binary value", cause);
+  }
+
+  private static Class<?> componentType(Node node, Class<?>[] leafTypes) throws IOException {
+    if (!(node instanceof ScalarNode)) throw new IOException("Unsupported compact binary array component");
+    ScalarNode scalar = (ScalarNode) node;
+    switch (Character.toLowerCase(scalar.kind)) {
+    case 'z': return scalar.kind == 'z' ? boolean.class : Boolean.class;
+    case 'b': return scalar.kind == 'b' ? byte.class : Byte.class;
+    case 'h': return scalar.kind == 'h' ? short.class : Short.class;
+    case 'i': return scalar.kind == 'i' ? int.class : Integer.class;
+    case 'j': return scalar.kind == 'j' ? long.class : Long.class;
+    case 'f': return scalar.kind == 'f' ? float.class : Float.class;
+    case 'd': return scalar.kind == 'd' ? double.class : Double.class;
+    case 'c': return scalar.kind == 'c' ? char.class : Character.class;
+    case 's': return String.class;
+    case 'e': return leafTypes[scalar.leaf];
+    default: throw new IOException("Unsupported compact binary array component");
+    }
+  }
+}
