+        .name("name")
+        .count(2)
+        .enumeration(BinaryEnumOne.FIRST)
+        .build();
+
+    ImmutableCompactBinaryNew upgraded = ImmutableCompactBinaryNew.readFrom(input(write(old)));
+    assertEquals("name", upgraded.name());
+    assertEquals(2, upgraded.count());
+    assertEquals(BinaryEnumTwo.FIRST, upgraded.enumeration());
+    assertFalse(upgraded.added().isPresent());
+
+    ImmutableCompactBinaryNew newer = ImmutableCompactBinaryNew.builder()
+        .enumeration(BinaryEnumTwo.SECOND)
+        .added("ignored")
+        .count(3)
+        .name("newer")
+        .build();
+    ImmutableCompactBinaryOld downgraded = ImmutableCompactBinaryOld.readFrom(input(write(newer)));
+    assertEquals("newer", downgraded.name());
+    assertEquals(3, downgraded.count());
+    assertEquals(BinaryEnumOne.SECOND, downgraded.enumeration());
+
+    ImmutableCompactBinaryRenamed renamed = ImmutableCompactBinaryRenamed.readFrom(input(write(old)));
+    assertFalse(renamed.renamed().isPresent());
+    assertEquals(2, renamed.count());
+
+    ImmutableCompactBinaryMismatched mismatched =
+        ImmutableCompactBinaryMismatched.readFrom(input(write(old)));
+    assertFalse(mismatched.name().isPresent());
+    assertEquals(2, mismatched.count());
+  }
+
+  @Test
+  public void nestedVersionChangesDoNotDesynchronizeOuterAttributes() throws Exception {
+    ImmutableCompactBinaryOuterNew newer = ImmutableCompactBinaryOuterNew.builder()
+        .nested(ImmutableCompactBinaryNestedNew.builder().name("nested").added("new").build())
+        .after(7)
