+    assertNoBinaryMethods(ImmutableCompactBinaryUnsupported.class);
+    assertNoBinaryMethods(ImmutableCompactBinaryTypeVariable.class);
+    assertNoBinaryMethods(ImmutableCompactBinaryArrayOfArrays.class);
+    assertNoBinaryMethods(ImmutableCompactBinaryCollectionOfCollections.class);
+    assertNoBinaryMethods(ImmutableCompactBinaryContainedNested.class);
