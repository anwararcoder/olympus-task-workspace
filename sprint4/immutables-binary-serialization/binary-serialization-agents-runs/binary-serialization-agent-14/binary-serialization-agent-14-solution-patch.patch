+package org.immutables.serial;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.DataInput;
+import java.io.DataInputStream;
+import java.io.DataOutput;
+import java.io.DataOutputStream;
+import java.io.IOException;
+import java.lang.reflect.Array;
+import java.nio.charset.StandardCharsets;
+import java.util.AbstractMap;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Runtime support for compact binary forms generated by the value processor. */
+public final class Binary {
+  private static final int MAGIC = 0x494D4D42;
+  private static final int VERSION = 1;
+
+  private static final int K_BOOLEAN = 1;
+  private static final int K_BYTE = 2;
+  private static final int K_SHORT = 3;
+  private static final int K_INT = 4;
+  private static final int K_LONG = 5;
+  private static final int K_CHAR = 6;
+  private static final int K_FLOAT = 7;
+  private static final int K_DOUBLE = 8;
+  private static final int K_STRING = 9;
+  private static final int K_ENUM = 10;
+  private static final int K_STRUCT = 11;
+  private static final int K_BOXED = 12;
+  private static final int K_OPTIONAL = 20;
+  private static final int K_OPTIONAL_INT = 21;
+  private static final int K_OPTIONAL_LONG = 22;
+  private static final int K_OPTIONAL_DOUBLE = 23;
+  private static final int K_ARRAY = 30;
+  private static final int K_LIST = 31;
+  private static final int K_SET = 32;
+  private static final int K_SORTED_SET = 33;
+  private static final int K_MULTISET = 34;
+  private static final int K_SORTED_MULTISET = 35;
+  private static final int K_MAP = 40;
+  private static final int K_SORTED_MAP = 41;
+  private static final int K_BIMAP = 42;
+  private static final int K_MULTIMAP = 43;
+  private static final int K_LIST_MULTIMAP = 44;
+  private static final int K_SET_MULTIMAP = 45;
+
+  public static final Type BOOLEAN = new Type(K_BOOLEAN);
+  public static final Type BYTE = new Type(K_BYTE);
+  public static final Type SHORT = new Type(K_SHORT);
+  public static final Type INT = new Type(K_INT);
+  public static final Type LONG = new Type(K_LONG);
+  public static final Type CHAR = new Type(K_CHAR);
+  public static final Type FLOAT = new Type(K_FLOAT);
+  public static final Type DOUBLE = new Type(K_DOUBLE);
+  public static final Type STRING = new Type(K_STRING);
+  public static final Type ENUM = new Type(K_ENUM);
+  public static final Type STRUCT = new Type(K_STRUCT);
+  public static final Type OPTIONAL_INT = new Type(K_OPTIONAL_INT, INT, null);
+  public static final Type OPTIONAL_LONG = new Type(K_OPTIONAL_LONG, LONG, null);
+  public static final Type OPTIONAL_DOUBLE = new Type(K_OPTIONAL_DOUBLE, DOUBLE, null);
+
+  private Binary() {}
+
+  public static Type optional(Type element) {
+    return new Type(K_OPTIONAL, element, null);
+  }
+
+  public static Type boxed(Type element) {
+    return new Type(K_BOXED, element, null);
+  }
+
+  public static Type array(Type element) {
+    return new Type(K_ARRAY, element, null);
+  }
+
+  public static Type list(Type element) {
+    return new Type(K_LIST, element, null);
+  }
+
+  public static Type set(Type element) {
+    return new Type(K_SET, element, null);
+  }
+
+  public static Type sortedSet(Type element) {
+    return new Type(K_SORTED_SET, element, null);
+  }
+
+  public static Type multiset(Type element) {
+    return new Type(K_MULTISET, element, null);
+  }
+
+  public static Type sortedMultiset(Type element) {
+    return new Type(K_SORTED_MULTISET, element, null);
+  }
+
+  public static Type map(Type key, Type value) {
+    return new Type(K_MAP, key, value);
+  }
+
+  public static Type sortedMap(Type key, Type value) {
+    return new Type(K_SORTED_MAP, key, value);
+  }
+
+  public static Type bimap(Type key, Type value) {
+    return new Type(K_BIMAP, key, value);
+  }
+
+  public static Type multimap(Type key, Type value) {
+    return new Type(K_MULTIMAP, key, value);
+  }
+
+  public static Type listMultimap(Type key, Type value) {
+    return new Type(K_LIST_MULTIMAP, key, value);
+  }
+
+  public static Type setMultimap(Type key, Type value) {
+    return new Type(K_SET_MULTIMAP, key, value);
+  }
+
+  public static Writer writer(DataOutput output, int fieldCount) throws IOException {
+    return new Writer(output, fieldCount);
+  }
+
+  public static Reader reader(DataInput input) throws IOException {
+    return new Reader(input);
+  }
+
+  public static final class Type {
+    private final int kind;
+    private final Type first;
+    private final Type second;
+    private final long fingerprint;
+
+    private Type(int kind) {
+      this(kind, null, null);
+    }
+
+    private Type(int kind, Type first, Type second) {
+      this.kind = kind;
+      this.first = first;
+      this.second = second;
+      long hash = 0xcbf29ce484222325L;
+      hash = mix(hash, kind);
+      hash = mix(hash, first != null ? first.fingerprint : 0);
+      hash = mix(hash, second != null ? second.fingerprint : 0);
+      this.fingerprint = hash;
+    }
+  }
+
+  public static final class Writer {
+    private final DataOutput output;
+    private final int fieldCount;
+    private int fieldsWritten;
+
+    private Writer(DataOutput output, int fieldCount) throws IOException {
+      if (fieldCount < 0) {
+        throw new IllegalArgumentException("fieldCount cannot be negative");
+      }
+      this.output = output;
+      this.fieldCount = fieldCount;
+      output.writeInt(MAGIC);
+      output.writeInt(VERSION);
+      output.writeInt(fieldCount);
+    }
+
+    public void write(long attribute, Type type, Object value) throws IOException {
+      writePayload(attribute, type, encode(type, value));
+    }
+
+    public void writeOptional(long attribute, Type type, boolean present, Object value)
+        throws IOException {
+      ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+      DataOutputStream data = new DataOutputStream(bytes);
+      data.writeBoolean(present);
+      if (present) {
+        writeScalar(data, type.first, value);
+      }
+      data.flush();
+      writePayload(attribute, type, bytes.toByteArray());
+    }
+
+    public void writeEntries(long attribute, Type type,
+        Iterable<? extends Map.Entry<?, ?>> entries) throws IOException {
+      ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+      DataOutputStream data = new DataOutputStream(bytes);
+      List<Map.Entry<?, ?>> copied = new ArrayList<>();
+      for (Map.Entry<?, ?> entry : entries) {
+        copied.add(entry);
+      }
+      data.writeInt(copied.size());
+      for (Map.Entry<?, ?> entry : copied) {
+        writeScalar(data, type.first, entry.getKey());
+        writeScalar(data, type.second, entry.getValue());
+      }
+      data.flush();
+      writePayload(attribute, type, bytes.toByteArray());
+    }
+
+    public void writeEncoded(long attribute, Type type, byte[] value) throws IOException {
+      writePayload(attribute, type, value);
+    }
+
+    public void finish() throws IOException {
+      if (fieldsWritten != fieldCount) {
+        throw new IOException("Expected " + fieldCount + " fields but wrote " + fieldsWritten);
+      }
+    }
+
+    private void writePayload(long attribute, Type type, byte[] payload) throws IOException {
+      output.writeLong(attribute);
+      output.writeLong(type.fingerprint);
+      output.writeInt(payload.length);
+      output.write(payload);
+      fieldsWritten++;
+    }
+  }
+
+  public static final class Reader {
+    private final Map<Long, Field> fields = new HashMap<>();
+
+    private Reader(DataInput input) throws IOException {
+      if (input.readInt() != MAGIC) {
+        throw new IOException("Not an Immutables binary value");
+      }
+      if (input.readInt() != VERSION) {
+        throw new IOException("Unsupported Immutables binary version");
+      }
+      int count = input.readInt();
+      if (count < 0) {
+        throw new IOException("Negative field count");
+      }
+      for (int index = 0; index < count; index++) {
+        long attribute = input.readLong();
+        long type = input.readLong();
+        int length = input.readInt();
+        if (length < 0) {
+          throw new IOException("Invalid field length: " + length);
+        }
+        byte[] payload = new byte[length];
+        input.readFully(payload);
+        if (fields.put(attribute, new Field(type, payload)) != null) {
+          throw new IOException("Duplicate binary attribute identifier");
+        }
+      }
+    }
+
+    public Value read(long attribute, Type type, Class<?> firstEnum, Class<?> secondEnum)
+        throws IOException {
+      Field field = matching(attribute, type);
+      if (field == null) {
+        return Value.absent();
+      }
+      DataInputStream input = field.input();
+      Object decoded = decode(input, type, firstEnum, secondEnum);
+      requireFullyConsumed(input);
+      if (decoded == EnumMismatch.INSTANCE) {
+        return Value.absent();
+      }
+      return Value.present(decoded);
+    }
+
+    public OptionalValue readOptional(long attribute, Type type, Class<?> enumType)
+        throws IOException {
+      Field field = matching(attribute, type);
+      if (field == null) {
+        return OptionalValue.missing();
+      }
+      DataInputStream input = field.input();
+      boolean present = input.readBoolean();
+      Object value = present ? readScalar(input, type.first, enumType) : null;
+      requireFullyConsumed(input);
+      if (value == EnumMismatch.INSTANCE) {
+        return OptionalValue.missing();
+      }
+      return OptionalValue.found(present, value);
+    }
+
+    public Entries readEntries(long attribute, Type type, Class<?> keyEnum, Class<?> valueEnum)
+        throws IOException {
+      Field field = matching(attribute, type);
+      if (field == null) {
+        return Entries.missing();
+      }
+      DataInputStream input = field.input();
+      int count = readCount(input);
+      List<Map.Entry<Object, Object>> entries = new ArrayList<>(count);
+      for (int index = 0; index < count; index++) {
+        Object key = readScalar(input, type.first, keyEnum);
+        Object value = readScalar(input, type.second, valueEnum);
+        if (key == EnumMismatch.INSTANCE || value == EnumMismatch.INSTANCE) {
+          return Entries.missing();
+        }
+        entries.add(new AbstractMap.SimpleImmutableEntry<>(key, value));
+      }
+      requireFullyConsumed(input);
+      return Entries.found(entries);
+    }
+
+    public Encoded readEncoded(long attribute, Type type) {
+      Field field = matching(attribute, type);
+      return field != null ? Encoded.found(field.payload) : Encoded.missing();
+    }
+
+    private Field matching(long attribute, Type type) {
+      Field field = fields.get(attribute);
+      return field != null && field.type == type.fingerprint ? field : null;
+    }
+  }
+
+  public static final class Value {
+    private static final Value ABSENT = new Value(false, null);
+    private final boolean present;
+    private final Object value;
+
+    private Value(boolean present, Object value) {
+      this.present = present;
+      this.value = value;
+    }
+
+    public boolean isPresent() {
+      return present;
+    }
+
+    public Object get() {
+      return value;
+    }
+
+    private static Value absent() {
+      return ABSENT;
+    }
+
+    private static Value present(Object value) {
+      return new Value(true, value);
+    }
+  }
+
+  public static final class OptionalValue {
+    private static final OptionalValue MISSING = new OptionalValue(false, false, null);
+    private final boolean found;
+    private final boolean present;
+    private final Object value;
+
+    private OptionalValue(boolean found, boolean present, Object value) {
+      this.found = found;
+      this.present = present;
+      this.value = value;
+    }
+
+    public boolean isFound() {
+      return found;
+    }
+
+    public boolean isPresent() {
+      return present;
+    }
+
+    public Object get() {
+      return value;
+    }
+
+    private static OptionalValue missing() {
+      return MISSING;
+    }
+
+    private static OptionalValue found(boolean present, Object value) {
+      return new OptionalValue(true, present, value);
+    }
+  }
+
+  public static final class Entries {
+    private static final Entries MISSING = new Entries(false, null);
+    private final boolean found;
+    private final List<Map.Entry<Object, Object>> entries;
+
+    private Entries(boolean found, List<Map.Entry<Object, Object>> entries) {
+      this.found = found;
+      this.entries = entries;
+    }
+
+    public boolean isFound() {
+      return found;
+    }
+
+    public List<Map.Entry<Object, Object>> get() {
+      return entries;
+    }
+
+    private static Entries missing() {
+      return MISSING;
+    }
+
+    private static Entries found(List<Map.Entry<Object, Object>> entries) {
+      return new Entries(true, entries);
+    }
+  }
+
+  public static final class Encoded {
+    private static final Encoded MISSING = new Encoded(false, null);
+    private final boolean found;
+    private final byte[] bytes;
+
+    private Encoded(boolean found, byte[] bytes) {
+      this.found = found;
+      this.bytes = bytes;
+    }
+
+    public boolean isFound() {
+      return found;
+    }
+
+    public byte[] get() {
+      return bytes;
+    }
+
+    private static Encoded missing() {
+      return MISSING;
+    }
+
+    private static Encoded found(byte[] bytes) {
+      return new Encoded(true, bytes);
+    }
+  }
+
+  private static final class Field {
+    private final long type;
+    private final byte[] payload;
+
+    private Field(long type, byte[] payload) {
+      this.type = type;
+      this.payload = payload;
+    }
+
+    private DataInputStream input() {
+      return new DataInputStream(new ByteArrayInputStream(payload));
+    }
+  }
+
+  private enum EnumMismatch {
+    INSTANCE
+  }
+
+  private static byte[] encode(Type type, Object value) throws IOException {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    DataOutputStream output = new DataOutputStream(bytes);
+    if (type.kind == K_ARRAY) {
+      writeArray(output, type.first, value);
+    } else if (isCollection(type.kind)) {
+      writeIterable(output, type.first, (Iterable<?>) value);
+    } else {
+      writeScalar(output, type, value);
+    }
+    output.flush();
+    return bytes.toByteArray();
+  }
+
+  private static Object decode(DataInputStream input, Type type,
+      Class<?> firstEnum, Class<?> secondEnum) throws IOException {
+    if (type.kind == K_ARRAY) {
+      return readArray(input, type.first, firstEnum);
+    }
+    if (isCollection(type.kind)) {
+      return readList(input, type.first, firstEnum);
+    }
+    return readScalar(input, type, firstEnum);
+  }
+
+  private static void writeScalar(DataOutput output, Type type, Object value) throws IOException {
+    output.writeBoolean(value != null);
+    if (value == null) {
+      return;
+    }
+    switch (type.kind) {
+    case K_BOOLEAN:
+      output.writeBoolean((Boolean) value);
+      break;
+    case K_BYTE:
+      output.writeByte((Byte) value);
+      break;
+    case K_SHORT:
+      output.writeShort((Short) value);
+      break;
+    case K_INT:
+      output.writeInt((Integer) value);
+      break;
+    case K_LONG:
+      output.writeLong((Long) value);
+      break;
+    case K_CHAR:
+      output.writeChar((Character) value);
+      break;
+    case K_FLOAT:
+      output.writeInt(Float.floatToIntBits((Float) value));
+      break;
+    case K_DOUBLE:
+      output.writeLong(Double.doubleToLongBits((Double) value));
+      break;
+    case K_STRING:
+      writeString(output, (String) value);
+      break;
+    case K_ENUM:
+      writeString(output, ((Enum<?>) value).name());
+      break;
+    case K_BOXED:
+      writeScalar(output, type.first, value);
+      break;
+    default:
+      throw new IOException("Unsupported scalar binary kind: " + type.kind);
+    }
+  }
+
+  private static Object readScalar(DataInput input, Type type, Class<?> enumType) throws IOException {
+    if (!input.readBoolean()) {
+      return null;
+    }
+    switch (type.kind) {
+    case K_BOOLEAN:
+      return input.readBoolean();
+    case K_BYTE:
+      return input.readByte();
+    case K_SHORT:
+      return input.readShort();
+    case K_INT:
+      return input.readInt();
+    case K_LONG:
+      return input.readLong();
+    case K_CHAR:
+      return input.readChar();
+    case K_FLOAT:
+      return Float.intBitsToFloat(input.readInt());
+    case K_DOUBLE:
+      return Double.longBitsToDouble(input.readLong());
+    case K_STRING:
+      return readString(input);
+    case K_ENUM:
+      return readEnum(input, enumType);
+    case K_BOXED:
+      return readScalar(input, type.first, enumType);
+    default:
+      throw new IOException("Unsupported scalar binary kind: " + type.kind);
+    }
+  }
+
+  private static void writeArray(DataOutput output, Type element, Object value) throws IOException {
+    output.writeBoolean(value != null);
+    if (value == null) {
+      return;
+    }
+    int length = Array.getLength(value);
+    output.writeInt(length);
+    for (int index = 0; index < length; index++) {
+      writeScalar(output, element, Array.get(value, index));
+    }
+  }
+
+  private static Object readArray(DataInput input, Type element, Class<?> enumType) throws IOException {
+    if (!input.readBoolean()) {
+      return null;
+    }
+    int length = readCount(input);
+    Class<?> component = componentClass(element, enumType);
+    Object array = Array.newInstance(component, length);
+    for (int index = 0; index < length; index++) {
+      Object value = readScalar(input, element, enumType);
+      if (value == EnumMismatch.INSTANCE) {
+        return EnumMismatch.INSTANCE;
+      }
+      Array.set(array, index, value);
+    }
+    return array;
+  }
+
+  private static void writeIterable(DataOutput output, Type element, Iterable<?> values)
+      throws IOException {
+    List<Object> copied = new ArrayList<>();
+    for (Object value : values) {
+      copied.add(value);
+    }
+    output.writeInt(copied.size());
+    for (Object value : copied) {
+      writeScalar(output, element, value);
+    }
+  }
+
+  private static Object readList(DataInput input, Type element, Class<?> enumType) throws IOException {
+    int count = readCount(input);
+    List<Object> values = new ArrayList<>(count);
+    for (int index = 0; index < count; index++) {
+      Object value = readScalar(input, element, enumType);
+      if (value == EnumMismatch.INSTANCE) {
+        return EnumMismatch.INSTANCE;
+      }
+      values.add(value);
+    }
+    return values;
+  }
+
+  @SuppressWarnings({"unchecked", "rawtypes"})
+  private static Object readEnum(DataInput input, Class<?> enumType) throws IOException {
+    if (enumType == null || !enumType.isEnum()) {
+      return EnumMismatch.INSTANCE;
+    }
+    String name = readString(input);
+    try {
+      return Enum.valueOf((Class) enumType, name);
+    } catch (IllegalArgumentException ex) {
+      return EnumMismatch.INSTANCE;
+    }
+  }
+
+  private static Class<?> componentClass(Type type, Class<?> enumType) throws IOException {
+    switch (type.kind) {
+    case K_BOOLEAN:
+      return boolean.class;
+    case K_BYTE:
+      return byte.class;
+    case K_SHORT:
+      return short.class;
+    case K_INT:
+      return int.class;
+    case K_LONG:
+      return long.class;
+    case K_CHAR:
+      return char.class;
+    case K_FLOAT:
+      return float.class;
+    case K_DOUBLE:
+      return double.class;
+    case K_STRING:
+      return String.class;
+    case K_ENUM:
+      if (enumType != null && enumType.isEnum()) {
+        return enumType;
+      }
+      break;
+    case K_BOXED:
+      return boxedClass(type.first);
+    default:
+    }
+    throw new IOException("Unsupported array component binary kind: " + type.kind);
+  }
+
+  private static Class<?> boxedClass(Type type) throws IOException {
+    switch (type.kind) {
+    case K_BOOLEAN:
+      return Boolean.class;
+    case K_BYTE:
+      return Byte.class;
+    case K_SHORT:
+      return Short.class;
+    case K_INT:
+      return Integer.class;
+    case K_LONG:
+      return Long.class;
+    case K_CHAR:
+      return Character.class;
+    case K_FLOAT:
+      return Float.class;
+    case K_DOUBLE:
+      return Double.class;
+    default:
+      throw new IOException("Unsupported boxed binary kind: " + type.kind);
+    }
+  }
+
+  private static boolean isCollection(int kind) {
+    return kind == K_LIST
+        || kind == K_SET
+        || kind == K_SORTED_SET
+        || kind == K_MULTISET
+        || kind == K_SORTED_MULTISET;
+  }
+
+  private static int readCount(DataInput input) throws IOException {
+    int count = input.readInt();
+    if (count < 0) {
+      throw new IOException("Invalid element count: " + count);
+    }
+    return count;
+  }
+
+  private static void writeString(DataOutput output, String value) throws IOException {
+    byte[] bytes = value.getBytes(StandardCharsets.UTF_8);
+    output.writeInt(bytes.length);
+    output.write(bytes);
+  }
+
+  private static String readString(DataInput input) throws IOException {
+    int length = input.readInt();
+    if (length < 0) {
+      throw new IOException("Invalid string length: " + length);
+    }
+    byte[] bytes = new byte[length];
+    input.readFully(bytes);
+    return new String(bytes, StandardCharsets.UTF_8);
+  }
+
+  private static void requireFullyConsumed(DataInputStream input) throws IOException {
+    if (input.read() != -1) {
+      throw new IOException("Trailing data in binary field");
+    }
+  }
+
+  private static long mix(long hash, long value) {
+    for (int shift = 0; shift < Long.SIZE; shift += Byte.SIZE) {
+      hash ^= (value >>> shift) & 0xff;
+      hash *= 0x100000001b3L;
+    }
+    return hash;
+  }
+}
