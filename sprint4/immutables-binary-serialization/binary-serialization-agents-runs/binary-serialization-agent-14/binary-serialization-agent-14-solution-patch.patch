+    ImmutableCompactBinaryOuterOld oldWriter = ImmutableCompactBinaryOuterOld.builder()
+        .nested(ImmutableCompactBinaryNestedOld.builder().name("old").build())
+        .after(8)
+        .build();
+    ImmutableCompactBinaryOuterNew newReader =
+        ImmutableCompactBinaryOuterNew.readFrom(input(write(oldWriter)));
+    assertEquals("old", newReader.nested().name());
+    assertFalse(newReader.nested().added().isPresent());
+    assertEquals(8, newReader.after());
+  }
