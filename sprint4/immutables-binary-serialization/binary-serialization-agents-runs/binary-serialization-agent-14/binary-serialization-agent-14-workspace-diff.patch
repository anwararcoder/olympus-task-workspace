+import org.junit.Test;
+
+import static org.junit.Assert.assertArrayEquals;
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+public class CompactBinaryTest {
+  @Test
+  public void roundTripsSupportedBuilderShapes() throws Exception {
+    String text = repeat('x', 100_000);
+    ImmutableCompactBinaryCollections value = ImmutableCompactBinaryCollections.builder()
+        .flag(true)
+        .byteValue((byte) 2)
+        .shortValue((short) 3)
+        .intValue(4)
+        .longValue(5L)
+        .charValue('z')
+        .floatValue(1.25f)
+        .doubleValue(2.5d)
+        .boxed(6)
+        .text(text)
+        .enumeration(BinaryEnumOne.SECOND)
+        .jdkOptional(java.util.Optional.of("jdk"))
+        .guavaOptional(Optional.of(7))
+        .optionalInt(java.util.OptionalInt.of(8))
+        .optionalLong(java.util.OptionalLong.of(9L))
+        .optionalDouble(java.util.OptionalDouble.of(10.5d))
+        .primitiveArray(1, 2, 3)
+        .boxedArray(4, 5, 6)
+        .stringArray("a", "b")
+        .enumArray(BinaryEnumOne.FIRST, BinaryEnumOne.SECOND)
+        .addAllList(ImmutableList.of(1, 2))
+        .addAllSet(ImmutableSet.of("a", "b"))
+        .addAllSortedSet(ImmutableSortedSet.of("b", "a"))
+        .addAllMultiset(ImmutableMultiset.of("x", "x", "y"))
+        .putAllMap(ImmutableBiMap.of("a", 1))
+        .putAllSortedMap(ImmutableSortedMap.of("b", 2))
+        .putAllBimap(ImmutableBiMap.of("c", 3))
+        .putAllMultimap(ImmutableMultimap.of("d", 4, "d", 4))
+        .putAllListMultimap(ImmutableListMultimap.of("e", 5, "e", 5))
+        .putAllSetMultimap(ImmutableSetMultimap.of("f", 6))
+        .build();
+
+    ImmutableCompactBinaryCollections copy = ImmutableCompactBinaryCollections.readFrom(input(write(value)));
+
+    assertEquals(value, copy);
+    assertEquals(text, copy.text());
+    assertArrayEquals(value.primitiveArray(), copy.primitiveArray());
+    assertArrayEquals(value.boxedArray(), copy.boxedArray());
+    assertArrayEquals(value.stringArray(), copy.stringArray());
+    assertArrayEquals(value.enumArray(), copy.enumArray());
+    assertEquals(2, copy.multiset().count("x"));
+    assertEquals(2, copy.listMultimap().get("e").size());
+  }
+
+  @Test
+  public void roundTripsConstructorAndNestedValues() throws Exception {
+    ImmutableCompactBinaryConstructor constructor = ImmutableCompactBinaryConstructor.of(
+        7,
+        BinaryEnumOne.FIRST,
+        java.util.Optional.of("optional"),
+        Arrays.asList(1, 2),
+        new HashSet<>(Arrays.asList("a", "b")),
+        ImmutableBiMap.of("one", 1),
+        java.util.Optional.of("not serialized"));
+    ImmutableCompactBinaryConstructor constructorCopy =
+        ImmutableCompactBinaryConstructor.readFrom(input(write(constructor)));
+    assertEquals(constructor.number(), constructorCopy.number());
+    assertEquals(constructor.enumeration(), constructorCopy.enumeration());
+    assertEquals(constructor.optional(), constructorCopy.optional());
+    assertEquals(constructor.list(), constructorCopy.list());
+    assertEquals(constructor.set(), constructorCopy.set());
+    assertEquals(constructor.map(), constructorCopy.map());
+    assertFalse(constructorCopy.auxiliary().isPresent());
+
+    ImmutableCompactBinaryOuter outer = ImmutableCompactBinaryOuter.builder()
+        .nested(ImmutableCompactBinaryNested.builder().value(1).label("nested").build())
+        .genericNested(ImmutableCompactBinaryGenericNested.<String>builder().value(2).build())
+        .remote(ImmutableRemoteBinary.builder().value("remote").build())
+        .after(3)
+        .build();
+    assertEquals(outer, ImmutableCompactBinaryOuter.readFrom(input(write(outer))));
+  }
+
+  @Test
+  public void matchesAttributesByIdentityAndShape() throws Exception {
+    ImmutableCompactBinaryOld old = ImmutableCompactBinaryOld.builder()
+        .name("name")
+        .count(2)
+        .enumeration(BinaryEnumOne.FIRST)
+        .build();
+
+    ImmutableCompactBinaryNew upgraded = ImmutableCompactBinaryNew.readFrom(input(write(old)));
+    assertEquals("name", upgraded.name());
+    assertEquals(2, upgraded.count());
+    assertEquals(BinaryEnumTwo.FIRST, upgraded.enumeration());
+    assertFalse(upgraded.added().isPresent());
+
+    ImmutableCompactBinaryNew newer = ImmutableCompactBinaryNew.builder()
+        .enumeration(BinaryEnumTwo.SECOND)
+        .added("ignored")
+        .count(3)
+        .name("newer")
+        .build();
+    ImmutableCompactBinaryOld downgraded = ImmutableCompactBinaryOld.readFrom(input(write(newer)));
+    assertEquals("newer", downgraded.name());
+    assertEquals(3, downgraded.count());
+    assertEquals(BinaryEnumOne.SECOND, downgraded.enumeration());
+
+    ImmutableCompactBinaryRenamed renamed = ImmutableCompactBinaryRenamed.readFrom(input(write(old)));
+    assertFalse(renamed.renamed().isPresent());
+    assertEquals(2, renamed.count());
+
+    ImmutableCompactBinaryMismatched mismatched =
+        ImmutableCompactBinaryMismatched.readFrom(input(write(old)));
+    assertFalse(mismatched.name().isPresent());
+    assertEquals(2, mismatched.count());
+  }
+
+  @Test
+  public void nestedVersionChangesDoNotDesynchronizeOuterAttributes() throws Exception {
+    ImmutableCompactBinaryOuterNew newer = ImmutableCompactBinaryOuterNew.builder()
+        .nested(ImmutableCompactBinaryNestedNew.builder().name("nested").added("new").build())
+        .after(7)
+        .build();
+    ImmutableCompactBinaryOuterOld older =
+        ImmutableCompactBinaryOuterOld.readFrom(input(write(newer)));
+    assertEquals("nested", older.nested().name());
+    assertEquals(7, older.after());
+
+    ImmutableCompactBinaryOuterOld oldWriter = ImmutableCompactBinaryOuterOld.builder()
+        .nested(ImmutableCompactBinaryNestedOld.builder().name("old").build())
+        .after(8)
+        .build();
+    ImmutableCompactBinaryOuterNew newReader =
+        ImmutableCompactBinaryOuterNew.readFrom(input(write(oldWriter)));
+    assertEquals("old", newReader.nested().name());
+    assertFalse(newReader.nested().added().isPresent());
+    assertEquals(8, newReader.after());
+  }
+
+  @Test
+  public void omitsDerivedAndOptionalAuxiliaryAttributes() throws Exception {
+    ImmutableCompactBinaryDerivedAuxiliary value = ImmutableCompactBinaryDerivedAuxiliary.builder()
+        .value(4)
+        .auxiliary("not serialized")
+        .build();
+
+    ImmutableCompactBinaryDerivedAuxiliary copy =
+        ImmutableCompactBinaryDerivedAuxiliary.readFrom(input(write(value)));
+    assertEquals(4, copy.value());
+    assertEquals(8, copy.doubled());
+    assertFalse(copy.auxiliary().isPresent());
+  }
+
+  @Test
+  public void skipsUnsupportedRecursiveAndConflictingForms() {
+    assertNoBinaryMethods(ImmutableCompactBinaryUnsupported.class);
+    assertNoBinaryMethods(ImmutableCompactBinaryTypeVariable.class);
+    assertNoBinaryMethods(ImmutableCompactBinaryArrayOfArrays.class);
+    assertNoBinaryMethods(ImmutableCompactBinaryCollectionOfCollections.class);
+    assertNoBinaryMethods(ImmutableCompactBinaryContainedNested.class);
+    assertNoBinaryMethods(ImmutableCompactBinaryRequiredAuxiliary.class);
+    assertNoBinaryMethods(ImmutableCompactBinaryRecursive.class);
+    assertNoBinaryMethods(ImmutableCompactBinaryWriteConflict.class);
+    assertNoBinaryMethods(ImmutableCompactBinaryInheritedWriteConflict.class);
+    assertNoBinaryMethods(ImmutableCompactBinaryReadConflict.class);
+  }
+
+  @Test(expected = java.io.EOFException.class)
+  public void rejectsIncompleteInput() throws Exception {
+    ImmutableCompactBinaryOld value = ImmutableCompactBinaryOld.builder()
+        .name("name")
+        .count(2)
+        .enumeration(BinaryEnumOne.FIRST)
+        .build();
+    byte[] bytes = write(value);
+    ImmutableCompactBinaryOld.readFrom(input(Arrays.copyOf(bytes, bytes.length - 1)));
+  }
+
+  @Test
+  public void generatedMethodsHaveExpectedApi() throws Exception {
+    Method writeTo = ImmutableCompactBinaryOld.class.getMethod("writeTo", java.io.DataOutput.class);
+    Method readFrom = ImmutableCompactBinaryOld.class.getMethod("readFrom", java.io.DataInput.class);
+    assertTrue(Modifier.isPublic(writeTo.getModifiers()));
+    assertTrue(Modifier.isPublic(readFrom.getModifiers()));
+    assertTrue(Modifier.isStatic(readFrom.getModifiers()));
+    assertEquals(ImmutableCompactBinaryOld.class, readFrom.getReturnType());
+  }
+
+  private static byte[] write(ImmutableCompactBinaryCollections value) throws Exception {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    value.writeTo(new DataOutputStream(bytes));
+    return bytes.toByteArray();
+  }
+
+  private static byte[] write(ImmutableCompactBinaryConstructor value) throws Exception {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    value.writeTo(new DataOutputStream(bytes));
+    return bytes.toByteArray();
+  }
+
+  private static byte[] write(ImmutableCompactBinaryOuter value) throws Exception {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    value.writeTo(new DataOutputStream(bytes));
+    return bytes.toByteArray();
+  }
+
+  private static byte[] write(ImmutableCompactBinaryOld value) throws Exception {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    value.writeTo(new DataOutputStream(bytes));
+    return bytes.toByteArray();
+  }
+
+  private static byte[] write(ImmutableCompactBinaryNew value) throws Exception {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    value.writeTo(new DataOutputStream(bytes));
+    return bytes.toByteArray();
+  }
+
+  private static byte[] write(ImmutableCompactBinaryOuterOld value) throws Exception {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    value.writeTo(new DataOutputStream(bytes));
+    return bytes.toByteArray();
+  }
+
+  private static byte[] write(ImmutableCompactBinaryOuterNew value) throws Exception {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    value.writeTo(new DataOutputStream(bytes));
+    return bytes.toByteArray();
+  }
+
+  private static byte[] write(ImmutableCompactBinaryDerivedAuxiliary value) throws Exception {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    value.writeTo(new DataOutputStream(bytes));
+    return bytes.toByteArray();
+  }
+
+  private static DataInputStream input(byte[] bytes) {
+    return new DataInputStream(new ByteArrayInputStream(bytes));
+  }
+
+  private static void assertNoBinaryMethods(Class<?> type) {
+    Set<String> signatures = new HashSet<>();
+    for (Method method : type.getDeclaredMethods()) {
+      if (method.getName().equals("writeTo") || method.getName().equals("readFrom")) {
+        signatures.add(method.toString());
+      }
+    }
+    assertTrue(signatures.toString(), signatures.isEmpty());
+  }
+
+  private static String repeat(char character, int count) {
+    char[] characters = new char[count];
+    Arrays.fill(characters, character);
+    return new String(characters);
+  }
+}
