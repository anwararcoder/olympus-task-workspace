+package org.immutables.serial;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.DataInput;
+import java.io.DataInputStream;
+import java.io.DataOutput;
+import java.io.DataOutputStream;
+import java.io.IOException;
+import java.lang.reflect.Array;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Runtime support for compact generated immutable binary forms. */
+public final class Binary {
+  public static final int BOOLEAN = 1;
+  public static final int BYTE = 2;
+  public static final int SHORT = 3;
+  public static final int INT = 4;
+  public static final int LONG = 5;
+  public static final int CHAR = 6;
+  public static final int FLOAT = 7;
+  public static final int DOUBLE = 8;
+  public static final int STRING = 9;
+  public static final int ENUM = 10;
+
+  public static final int OPTIONAL = 20;
+  public static final int LIST = 30;
+  public static final int SET = 31;
+  public static final int SORTED_SET = 32;
+  public static final int MULTISET = 33;
+  public static final int MAP = 40;
+  public static final int SORTED_MAP = 41;
+  public static final int BIMAP = 42;
+  public static final int MULTIMAP = 43;
+  public static final int LIST_MULTIMAP = 44;
+  public static final int SET_MULTIMAP = 45;
+  public static final int ARRAY = 50;
+  public static final int NESTED = 60;
+
+  private static final int MAGIC = 0x494D4231;
+  private static final Object MISMATCH = new Object();
+
+  private Binary() {}
+
+  public interface NestedWriter {
+    void write(DataOutput output) throws IOException;
+  }
+
+  public static void begin(DataOutput output, int attributes) throws IOException {
+    output.writeInt(MAGIC);
+    output.writeInt(attributes);
+  }
+
+  public static void field(DataOutput output, long idHigh, long idLow, byte[] value)
+      throws IOException {
+    output.writeLong(idHigh);
+    output.writeLong(idLow);
+    output.writeInt(value.length);
+    output.write(value);
+  }
+
+  public static Map<Key, Field> read(DataInput input) throws IOException {
+    if (input.readInt() != MAGIC) {
+      throw new IOException("Not an Immutables binary value");
+    }
+    int count = input.readInt();
+    if (count < 0) {
+      throw new IOException("Negative attribute count");
+    }
+    Map<Key, Field> fields = new LinkedHashMap<Key, Field>();
+    for (int i = 0; i < count; i++) {
+      Key key = new Key(input.readLong(), input.readLong());
+      int length = input.readInt();
+      if (length < 0) {
+        throw new IOException("Negative attribute length");
+      }
+      byte[] bytes = new byte[length];
+      input.readFully(bytes);
+      fields.put(key, new Field(bytes));
+    }
+    return fields;
+  }
+
+  public static byte[] scalar(int kind, Object value) throws IOException {
+    Buffer buffer = new Buffer();
+    buffer.output.writeByte(kind);
+    if (value == null) {
+      buffer.output.writeBoolean(false);
+    } else {
+      buffer.output.writeBoolean(true);
+      writeScalarValue(buffer.output, kind, value);
+    }
+    return buffer.bytes();
+  }
+
+  public static byte[] optional(int optionalKind, int elementKind, Object value)
+      throws IOException {
+    Buffer buffer = new Buffer();
+    buffer.output.writeByte(OPTIONAL);
+    buffer.output.writeByte(optionalKind);
+    buffer.output.writeByte(elementKind);
+    buffer.output.writeBoolean(value != null);
+    if (value != null) {
+      writeScalarValue(buffer.output, elementKind, value);
+    }
+    return buffer.bytes();
+  }
+
+  public static byte[] collection(int shape, int elementKind, Iterable<?> values)
+      throws IOException {
+    Buffer buffer = new Buffer();
+    buffer.output.writeByte(shape);
+    buffer.output.writeByte(elementKind);
+    List<Object> elements = copy(values);
+    buffer.output.writeInt(elements.size());
+    for (Object element : elements) {
+      writeElement(buffer.output, elementKind, element);
+    }
+    return buffer.bytes();
+  }
+
+  public static byte[] mapping(int shape, int keyKind, int valueKind, Iterable<?> entries)
+      throws IOException {
+    Buffer buffer = new Buffer();
+    buffer.output.writeByte(shape);
+    buffer.output.writeByte(keyKind);
+    buffer.output.writeByte(valueKind);
+    List<Object> copied = copy(entries);
+    buffer.output.writeInt(copied.size());
+    for (Object object : copied) {
+      Map.Entry<?, ?> entry = (Map.Entry<?, ?>) object;
+      writeElement(buffer.output, keyKind, entry.getKey());
+      writeElement(buffer.output, valueKind, entry.getValue());
+    }
+    return buffer.bytes();
+  }
+
+  public static byte[] array(int elementKind, Object array) throws IOException {
+    Buffer buffer = new Buffer();
+    buffer.output.writeByte(ARRAY);
+    buffer.output.writeByte(elementKind);
+    int length = Array.getLength(array);
+    buffer.output.writeInt(length);
+    for (int i = 0; i < length; i++) {
+      writeElement(buffer.output, elementKind, Array.get(array, i));
+    }
+    return buffer.bytes();
+  }
+
+  public static byte[] nested(NestedWriter writer) throws IOException {
+    Buffer buffer = new Buffer();
+    buffer.output.writeByte(NESTED);
+    writer.write(buffer.output);
+    return buffer.bytes();
+  }
+
+  private static void writeElement(DataOutput output, int kind, Object value)
+      throws IOException {
+    output.writeBoolean(value != null);
+    if (value != null) writeScalarValue(output, kind, value);
+  }
+
+  private static Object readElement(DataInput input, int kind, Class<?> enumType)
+      throws IOException {
+    return input.readBoolean() ? readScalarValue(input, kind, enumType) : null;
+  }
+
+  private static void writeScalarValue(DataOutput output, int kind, Object value)
+      throws IOException {
+    switch (kind) {
+    case BOOLEAN: output.writeBoolean((Boolean) value); return;
+    case BYTE: output.writeByte(((Number) value).byteValue()); return;
+    case SHORT: output.writeShort(((Number) value).shortValue()); return;
+    case INT: output.writeInt(((Number) value).intValue()); return;
+    case LONG: output.writeLong(((Number) value).longValue()); return;
+    case CHAR: output.writeChar((Character) value); return;
+    case FLOAT: output.writeFloat(((Number) value).floatValue()); return;
+    case DOUBLE: output.writeDouble(((Number) value).doubleValue()); return;
+    case STRING: writeString(output, (String) value); return;
+    case ENUM: writeString(output, ((Enum<?>) value).name()); return;
+    default: throw new IOException("Unsupported scalar kind " + kind);
+    }
+  }
+
+  private static Object readScalarValue(DataInput input, int kind, Class<?> enumType)
+      throws IOException {
+    switch (kind) {
+    case BOOLEAN: return input.readBoolean();
+    case BYTE: return input.readByte();
+    case SHORT: return input.readShort();
+    case INT: return input.readInt();
+    case LONG: return input.readLong();
+    case CHAR: return input.readChar();
+    case FLOAT: return input.readFloat();
+    case DOUBLE: return input.readDouble();
+    case STRING: return readString(input);
+    case ENUM:
+      String name = readString(input);
+      if (enumType == null || !enumType.isEnum()) return MISMATCH;
+      try {
+        @SuppressWarnings({"rawtypes", "unchecked"})
+        Object value = Enum.valueOf((Class) enumType, name);
+        return value;
+      } catch (IllegalArgumentException ex) {
+        return MISMATCH;
+      }
+    default: return MISMATCH;
+    }
+  }
+
+  private static void writeString(DataOutput output, String value) throws IOException {
+    byte[] bytes = value.getBytes(StandardCharsets.UTF_8);
+    output.writeInt(bytes.length);
+    output.write(bytes);
+  }
+
+  private static String readString(DataInput input) throws IOException {
+    int length = input.readInt();
+    if (length < 0) throw new IOException("Negative string length");
+    byte[] bytes = new byte[length];
+    input.readFully(bytes);
+    return new String(bytes, StandardCharsets.UTF_8);
+  }
+
+  private static List<Object> copy(Iterable<?> values) {
+    List<Object> result = new ArrayList<Object>();
+    for (Object value : values) result.add(value);
+    return result;
+  }
+
+  public static final class Key {
+    private final long high;
+    private final long low;
+
+    public Key(long high, long low) {
+      this.high = high;
+      this.low = low;
+    }
+
+    @Override public boolean equals(Object object) {
+      if (object == this) return true;
+      if (!(object instanceof Key)) return false;
+      Key other = (Key) object;
+      return high == other.high && low == other.low;
+    }
+
+    @Override public int hashCode() {
+      return (int) (high ^ (high >>> 32) ^ low ^ (low >>> 32));
+    }
+  }
+
+  public static final class Decoded {
+    public final boolean matched;
+    public final boolean present;
+    public final Object value;
+
+    private Decoded(boolean matched, boolean present, Object value) {
+      this.matched = matched;
+      this.present = present;
+      this.value = value;
+    }
+  }
+
+  public static final class Field {
+    private final byte[] bytes;
+
+    Field(byte[] bytes) {
+      this.bytes = bytes;
+    }
+
+    public Decoded scalar(int expectedKind, Class<?> enumType) throws IOException {
+      DataInputStream input = input();
+      if (input.readUnsignedByte() != expectedKind) return mismatch();
+      boolean present = input.readBoolean();
+      if (!present) return complete(input, new Decoded(true, false, null));
+      Object value = readScalarValue(input, expectedKind, enumType);
+      if (value == MISMATCH) return mismatch();
+      return complete(input, new Decoded(true, true, value));
+    }
+
+    public Decoded optional(int optionalKind, int elementKind, Class<?> enumType)
+        throws IOException {
+      DataInputStream input = input();
+      if (input.readUnsignedByte() != OPTIONAL
+          || input.readUnsignedByte() != optionalKind
+          || input.readUnsignedByte() != elementKind) return mismatch();
+      boolean present = input.readBoolean();
+      if (!present) return complete(input, new Decoded(true, false, null));
+      Object value = readScalarValue(input, elementKind, enumType);
+      if (value == MISMATCH) return mismatch();
+      return complete(input, new Decoded(true, true, value));
+    }
+
+    public Decoded collection(int shape, int elementKind, Class<?> enumType) throws IOException {
+      DataInputStream input = input();
+      if (input.readUnsignedByte() != shape || input.readUnsignedByte() != elementKind) {
+        return mismatch();
+      }
+      int size = input.readInt();
+      if (size < 0) throw new IOException("Negative collection size");
+      List<Object> values = new ArrayList<Object>();
+      for (int i = 0; i < size; i++) {
+        Object value = readElement(input, elementKind, enumType);
+        if (value == MISMATCH) return mismatch();
+        values.add(value);
+      }
+      return complete(input, new Decoded(true, true, values));
+    }
+
+    public Decoded mapping(int shape, int keyKind, Class<?> keyEnum,
+        int valueKind, Class<?> valueEnum) throws IOException {
+      DataInputStream input = input();
+      if (input.readUnsignedByte() != shape
+          || input.readUnsignedByte() != keyKind
+          || input.readUnsignedByte() != valueKind) return mismatch();
+      int size = input.readInt();
+      if (size < 0) throw new IOException("Negative mapping size");
+      List<Object> entries = new ArrayList<Object>();
+      for (int i = 0; i < size; i++) {
+        Object key = readElement(input, keyKind, keyEnum);
+        Object value = readElement(input, valueKind, valueEnum);
+        if (key == MISMATCH || value == MISMATCH) return mismatch();
+        entries.add(new java.util.AbstractMap.SimpleImmutableEntry<Object, Object>(key, value));
+      }
+      return complete(input, new Decoded(true, true, entries));
+    }
+
+    public Decoded array(int elementKind, Class<?> enumType, Class<?> componentType) throws IOException {
+      DataInputStream input = input();
+      if (input.readUnsignedByte() != ARRAY || input.readUnsignedByte() != elementKind) {
+        return mismatch();
+      }
+      int size = input.readInt();
+      if (size < 0) throw new IOException("Negative array size");
+      Object values = Array.newInstance(componentType, size);
+      for (int i = 0; i < size; i++) {
+        Object value = readElement(input, elementKind, enumType);
+        if (value == MISMATCH) return mismatch();
+        Array.set(values, i, value);
+      }
+      return complete(input, new Decoded(true, true, values));
+    }
+
+    public DataInput nested() throws IOException {
+      DataInputStream input = input();
+      return input.readUnsignedByte() == NESTED ? input : null;
+    }
+
+    private DataInputStream input() {
+      return new DataInputStream(new ByteArrayInputStream(bytes));
+    }
+
+    private Decoded complete(DataInputStream input, Decoded decoded) throws IOException {
+      return input.read() == -1 ? decoded : mismatch();
+    }
+
+    private Decoded mismatch() {
+      return new Decoded(false, false, null);
+    }
+  }
+
+  private static final class Buffer {
+    final ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    final DataOutputStream output = new DataOutputStream(bytes);
+
+    byte[] bytes() throws IOException {
+      output.flush();
+      return bytes.toByteArray();
+    }
+  }
+}
