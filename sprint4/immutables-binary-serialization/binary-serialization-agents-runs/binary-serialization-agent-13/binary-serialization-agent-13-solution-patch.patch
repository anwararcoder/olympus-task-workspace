diff --git a/serial/src/org/immutables/serial/Binary.java b/serial/src/org/immutables/serial/Binary.java
new file mode 100644
index 0000000..64212c1
--- /dev/null
+++ b/serial/src/org/immutables/serial/Binary.java
@@ -0,0 +1,450 @@
+package org.immutables.serial;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.DataInput;
+import java.io.DataInputStream;
+import java.io.DataOutput;
+import java.io.DataOutputStream;
+import java.io.EOFException;
+import java.io.IOException;
+import java.lang.reflect.Array;
+import java.lang.reflect.InvocationTargetException;
+import java.lang.reflect.Method;
+import java.lang.reflect.Modifier;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Runtime support for compact binary forms generated by the value processor. */
+public final class Binary {
+  public static final int BOOLEAN = 1;
+  public static final int BYTE = 2;
+  public static final int SHORT = 3;
+  public static final int CHAR = 4;
+  public static final int INT = 5;
+  public static final int LONG = 6;
+  public static final int FLOAT = 7;
+  public static final int DOUBLE = 8;
+  public static final int BOXED_BOOLEAN = 9;
+  public static final int BOXED_BYTE = 10;
+  public static final int BOXED_SHORT = 11;
+  public static final int BOXED_CHAR = 12;
+  public static final int BOXED_INT = 13;
+  public static final int BOXED_LONG = 14;
+  public static final int BOXED_FLOAT = 15;
+  public static final int BOXED_DOUBLE = 16;
+  public static final int STRING = 17;
+  public static final int ENUM = 18;
+  public static final int NESTED = 19;
+
+  private static final int MAGIC = 0x494d4246;
+  private static final int VERSION = 1;
+
+  private Binary() {}
+
+  public static Writer writer() {
+    return new Writer();
+  }
+
+  public static Reader reader(DataInput input) throws IOException {
+    return new Reader(input);
+  }
+
+  public static final class TypeMismatchException extends IOException {
+    private static final long serialVersionUID = 1L;
+
+    TypeMismatchException(String message, Throwable cause) {
+      super(message, cause);
+    }
+  }
+
+  public static final class Writer {
+    private final List<Field> fields = new ArrayList<>();
+
+    public DataOutput field(long idHigh, long idLow, long shape) {
+      Field field = new Field(idHigh, idLow, shape);
+      fields.add(field);
+      return field.output;
+    }
+
+    public void writeTo(DataOutput output) throws IOException {
+      output.writeInt(MAGIC);
+      output.writeByte(VERSION);
+      output.writeInt(fields.size());
+      for (Field field : fields) {
+        byte[] bytes = field.bytes.toByteArray();
+        output.writeLong(field.idHigh);
+        output.writeLong(field.idLow);
+        output.writeLong(field.shape);
+        output.writeInt(bytes.length);
+        output.write(bytes);
+      }
+    }
+  }
+
+  public static final class Reader {
+    private final Map<Id, FieldValue> fields = new HashMap<>();
+
+    Reader(DataInput input) throws IOException {
+      if (input.readInt() != MAGIC) {
+        throw new IOException("Invalid immutable binary header");
+      }
+      int version = input.readUnsignedByte();
+      if (version != VERSION) {
+        throw new IOException("Unsupported immutable binary version " + version);
+      }
+      int count = readLength(input, "field count");
+      for (int i = 0; i < count; i++) {
+        long idHigh = input.readLong();
+        long idLow = input.readLong();
+        long shape = input.readLong();
+        int length = readLength(input, "field length");
+        byte[] bytes = new byte[length];
+        input.readFully(bytes);
+        Id id = new Id(idHigh, idLow);
+        if (fields.put(id, new FieldValue(shape, bytes)) != null) {
+          throw new IOException("Duplicate immutable binary field");
+        }
+      }
+    }
+
+    public DataInput field(long idHigh, long idLow, long shape) {
+      FieldValue value = fields.get(new Id(idHigh, idLow));
+      if (value == null || value.shape != shape) {
+        return null;
+      }
+      return new DataInputStream(new ByteArrayInputStream(value.bytes));
+    }
+  }
+
+  public static void writeValue(DataOutput output, int kind, Object value) throws IOException {
+    boolean nullable = kind >= BOXED_BOOLEAN;
+    if (nullable) {
+      output.writeBoolean(value != null);
+      if (value == null) {
+        return;
+      }
+    }
+    switch (kind) {
+    case BOOLEAN:
+    case BOXED_BOOLEAN:
+      output.writeBoolean((Boolean) value);
+      return;
+    case BYTE:
+    case BOXED_BYTE:
+      output.writeByte((Byte) value);
+      return;
+    case SHORT:
+    case BOXED_SHORT:
+      output.writeShort((Short) value);
+      return;
+    case CHAR:
+    case BOXED_CHAR:
+      output.writeChar((Character) value);
+      return;
+    case INT:
+    case BOXED_INT:
+      output.writeInt((Integer) value);
+      return;
+    case LONG:
+    case BOXED_LONG:
+      output.writeLong((Long) value);
+      return;
+    case FLOAT:
+    case BOXED_FLOAT:
+      output.writeFloat((Float) value);
+      return;
+    case DOUBLE:
+    case BOXED_DOUBLE:
+      output.writeDouble((Double) value);
+      return;
+    case STRING:
+      writeString(output, (String) value);
+      return;
+    case ENUM:
+      writeString(output, ((Enum<?>) value).name());
+      return;
+    case NESTED:
+      writeNested(output, value);
+      return;
+    default:
+      throw new IOException("Unsupported immutable binary kind " + kind);
+    }
+  }
+
+  public static Object readValue(DataInput input, int kind, Class<?> valueType) throws IOException {
+    boolean nullable = kind >= BOXED_BOOLEAN;
+    if (nullable && !input.readBoolean()) {
+      return null;
+    }
+    switch (kind) {
+    case BOOLEAN:
+    case BOXED_BOOLEAN:
+      return input.readBoolean();
+    case BYTE:
+    case BOXED_BYTE:
+      return input.readByte();
+    case SHORT:
+    case BOXED_SHORT:
+      return input.readShort();
+    case CHAR:
+    case BOXED_CHAR:
+      return input.readChar();
+    case INT:
+    case BOXED_INT:
+      return input.readInt();
+    case LONG:
+    case BOXED_LONG:
+      return input.readLong();
+    case FLOAT:
+    case BOXED_FLOAT:
+      return input.readFloat();
+    case DOUBLE:
+    case BOXED_DOUBLE:
+      return input.readDouble();
+    case STRING:
+      return readString(input);
+    case ENUM:
+      return readEnum(input, valueType);
+    case NESTED:
+      return readNested(input, valueType);
+    default:
+      throw new IOException("Unsupported immutable binary kind " + kind);
+    }
+  }
+
+  public static void writeArray(DataOutput output, int kind, Object array) throws IOException {
+    if (array == null) {
+      output.writeInt(-1);
+      return;
+    }
+    int length = Array.getLength(array);
+    output.writeInt(length);
+    for (int i = 0; i < length; i++) {
+      writeValue(output, kind, Array.get(array, i));
+    }
+  }
+
+  public static Object readArray(DataInput input, int kind, Class<?> valueType) throws IOException {
+    int length = input.readInt();
+    if (length == -1) {
+      return null;
+    }
+    if (length < 0) {
+      throw new IOException("Invalid immutable binary array length " + length);
+    }
+    Class<?> componentType = componentType(kind, valueType);
+    Object array = Array.newInstance(componentType, length);
+    for (int i = 0; i < length; i++) {
+      Array.set(array, i, readValue(input, kind, valueType));
+    }
+    return array;
+  }
+
+  public static void writeCollection(
+      DataOutput output,
+      int size,
+      Iterable<?> values,
+      int kind) throws IOException {
+    output.writeInt(size);
+    int written = 0;
+    for (Object value : values) {
+      writeValue(output, kind, value);
+      written++;
+    }
+    if (written != size) {
+      throw new IOException("Immutable binary collection size changed while writing");
+    }
+  }
+
+  public static List<Object> readCollection(
+      DataInput input,
+      int kind,
+      Class<?> valueType) throws IOException {
+    int size = readLength(input, "collection size");
+    List<Object> values = new ArrayList<>(size);
+    for (int i = 0; i < size; i++) {
+      values.add(readValue(input, kind, valueType));
+    }
+    return values;
+  }
+
+  public static void writeMap(
+      DataOutput output,
+      int size,
+      Iterable<? extends Map.Entry<?, ?>> entries,
+      int keyKind,
+      int valueKind) throws IOException {
+    output.writeInt(size);
+    int written = 0;
+    for (Map.Entry<?, ?> entry : entries) {
+      writeValue(output, keyKind, entry.getKey());
+      writeValue(output, valueKind, entry.getValue());
+      written++;
+    }
+    if (written != size) {
+      throw new IOException("Immutable binary map size changed while writing");
+    }
+  }
+
+  public static List<Object> readMap(
+      DataInput input,
+      int keyKind,
+      Class<?> keyType,
+      int valueKind,
+      Class<?> valueType) throws IOException {
+    int size = readLength(input, "map size");
+    List<Object> entries = new ArrayList<>(size * 2);
+    for (int i = 0; i < size; i++) {
+      entries.add(readValue(input, keyKind, keyType));
+      entries.add(readValue(input, valueKind, valueType));
+    }
+    return entries;
+  }
+
+  private static void writeNested(DataOutput output, Object value) throws IOException {
+    Method method;
+    try {
+      method = value.getClass().getMethod("writeTo", DataOutput.class);
+      method.setAccessible(true);
+      method.invoke(value, output);
+    } catch (NoSuchMethodException | IllegalAccessException ex) {
+      throw new IOException("Nested immutable does not expose writeTo(DataOutput)", ex);
+    } catch (InvocationTargetException ex) {
+      throw rethrowInvocation("Cannot write nested immutable", ex);
+    }
+  }
+
+  private static Object readNested(DataInput input, Class<?> valueType) throws IOException {
+    try {
+      Method method = valueType.getMethod("readFrom", DataInput.class);
+      method.setAccessible(true);
+      if (!Modifier.isStatic(method.getModifiers())) {
+        throw new IOException("Nested immutable readFrom(DataInput) is not static");
+      }
+      return method.invoke(null, input);
+    } catch (NoSuchMethodException | IllegalAccessException ex) {
+      throw new IOException("Nested immutable does not expose readFrom(DataInput)", ex);
+    } catch (InvocationTargetException ex) {
+      throw rethrowInvocation("Cannot read nested immutable", ex);
+    }
+  }
+
+  @SuppressWarnings({"rawtypes", "unchecked"})
+  private static Object readEnum(DataInput input, Class<?> valueType) throws IOException {
+    String name = readString(input);
+    try {
+      return Enum.valueOf((Class<? extends Enum>) valueType.asSubclass(Enum.class), name);
+    } catch (IllegalArgumentException ex) {
+      throw new TypeMismatchException("Unknown enum constant " + name, ex);
+    }
+  }
+
+  private static void writeString(DataOutput output, String value) throws IOException {
+    byte[] bytes = value.getBytes(StandardCharsets.UTF_8);
+    output.writeInt(bytes.length);
+    output.write(bytes);
+  }
+
+  private static String readString(DataInput input) throws IOException {
+    int length = readLength(input, "string length");
+    byte[] bytes = new byte[length];
+    input.readFully(bytes);
+    return new String(bytes, StandardCharsets.UTF_8);
+  }
+
+  private static Class<?> componentType(int kind, Class<?> valueType) throws IOException {
+    switch (kind) {
+    case BOOLEAN: return boolean.class;
+    case BYTE: return byte.class;
+    case SHORT: return short.class;
+    case CHAR: return char.class;
+    case INT: return int.class;
+    case LONG: return long.class;
+    case FLOAT: return float.class;
+    case DOUBLE: return double.class;
+    case BOXED_BOOLEAN: return Boolean.class;
+    case BOXED_BYTE: return Byte.class;
+    case BOXED_SHORT: return Short.class;
+    case BOXED_CHAR: return Character.class;
+    case BOXED_INT: return Integer.class;
+    case BOXED_LONG: return Long.class;
+    case BOXED_FLOAT: return Float.class;
+    case BOXED_DOUBLE: return Double.class;
+    case STRING: return String.class;
+    case ENUM: return valueType;
+    default: throw new IOException("Unsupported immutable binary array kind " + kind);
+    }
+  }
+
+  private static int readLength(DataInput input, String description) throws IOException {
+    int length;
+    try {
+      length = input.readInt();
+    } catch (EOFException ex) {
+      throw new IOException("Incomplete immutable binary " + description, ex);
+    }
+    if (length < 0) {
+      throw new IOException("Invalid immutable binary " + description + " " + length);
+    }
+    return length;
+  }
+
+  private static IOException rethrowInvocation(String message, InvocationTargetException ex) {
+    Throwable cause = ex.getCause();
+    if (cause instanceof IOException) {
+      return (IOException) cause;
+    }
+    return new IOException(message, cause);
+  }
+
+  private static final class Field {
+    final long idHigh;
+    final long idLow;
+    final long shape;
+    final ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    final DataOutput output = new DataOutputStream(bytes);
+
+    Field(long idHigh, long idLow, long shape) {
+      this.idHigh = idHigh;
+      this.idLow = idLow;
+      this.shape = shape;
+    }
+  }
+
+  private static final class FieldValue {
+    final long shape;
+    final byte[] bytes;
+
+    FieldValue(long shape, byte[] bytes) {
+      this.shape = shape;
+      this.bytes = bytes;
+    }
+  }
+
+  private static final class Id {
+    final long high;
+    final long low;
+
+    Id(long high, long low) {
+      this.high = high;
+      this.low = low;
+    }
+
+    @Override
+    public boolean equals(Object other) {
+      if (this == other) return true;
+      if (!(other instanceof Id)) return false;
+      Id id = (Id) other;
+      return high == id.high && low == id.low;
+    }
+
+    @Override
+    public int hashCode() {
+      return 31 * Long.hashCode(high) + Long.hashCode(low);
+    }
+  }
+}
