+package org.immutables.serial.fixture;
+
+import com.Capella.common.base.Optional;
+import com.Capella.common.collect.BiMap;
+import com.Capella.common.collect.ListMultimap;
+import com.Capella.common.collect.Multimap;
+import com.Capella.common.collect.Multiset;
+import com.Capella.common.collect.SetMultimap;
+import com.Capella.common.collect.SortedMultiset;
+import java.io.DataOutput;
+import java.io.DataInput;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.SortedMap;
+import java.util.SortedSet;
+import org.immutables.value.Value;
+
+@Value.Immutable
+interface CompactScalars {
+  boolean booleanValue();
+  byte byteValue();
+  short shortValue();
+  char charValue();
+  int intValue();
+  long longValue();
+  float floatValue();
+  double doubleValue();
+  Boolean boxedBoolean();
+  Integer boxedInt();
+  String text();
+  CompactEnum enumeration();
+  java.util.Optional<String> jdkOptional();
+  Optional<Integer> guavaOptional();
+  java.util.OptionalInt optionalInt();
+  java.util.OptionalLong optionalLong();
+  java.util.OptionalDouble optionalDouble();
+  boolean[] booleans();
+  int[] ints();
+  String[] strings();
+  CompactEnum[] enums();
+}
+
+enum CompactEnum {
+  FIRST,
+  SECOND
+}
+
+@Value.Immutable
+interface CompactCollections {
+  List<String> list();
+  Set<String> set();
+  @Value.NaturalOrder SortedSet<String> sortedSet();
+  Multiset<String> multiset();
+  @Value.NaturalOrder SortedMultiset<String> sortedMultiset();
+  Map<String, Integer> map();
+  @Value.NaturalOrder SortedMap<String, Integer> sortedMap();
+  BiMap<String, Integer> biMap();
+  Multimap<String, Integer> multimap();
+  ListMultimap<String, Integer> listMultimap();
+  SetMultimap<String, Integer> setMultimap();
+}
+
+@Value.Immutable(builder = false)
+interface CompactConstructor {
+  @Value.Parameter int number();
+  @Value.Parameter List<String> names();
+  @Value.Parameter java.util.OptionalInt optional();
+  @Value.Parameter Map<String, Integer> mapping();
+}
+
+@Value.Immutable
+interface CompactNestedOld {
+  int number();
+  String text();
+}
+
+@Value.Immutable
+interface CompactNestedNew {
+  String text();
+  int number();
+  java.util.Optional<String> added();
+}
+
+@Value.Immutable
+interface CompactOuterOld {
+  CompactNestedOld nested();
+  String following();
+}
+
+@Value.Immutable
+interface CompactOuterNew {
+  CompactNestedNew nested();
+  String following();
+}
+
+@Value.Immutable
+interface CompactVersionOld {
+  int count();
+  String text();
+  List<String> items();
+}
+
+@Value.Immutable
+interface CompactVersionNew {
+  String text();
+  int count();
+  java.util.Optional<String> added();
+  List<Integer> items();
+}
+
+@Value.Immutable
+interface CompactRenamed {
+  @Value.Default default int total() {
+    return 7;
+  }
+}
+
+@Value.Immutable
+interface CompactEnumOld {
+  OldOrder value();
+}
+
+enum OldOrder {
+  FIRST,
+  SECOND,
+  REMOVED
+}
+
+@Value.Immutable
+interface CompactEnumNew {
+  @Value.Default default NewOrder value() {
+    return NewOrder.SECOND;
+  }
+}
+
+enum NewOrder {
+  SECOND,
+  FIRST
+}
+
+@Value.Immutable
+interface CompactConflict {
+  int number();
+
+  default void writeTo(DataOutput output) {}
+}
+
+@Value.Immutable
+interface CompactReadConflict {
+  int number();
+
+  static CompactReadConflict readFrom(DataInput input) {
+    return null;
+  }
+}
+
+interface CompactInheritedBinary {
+  default void writeTo(DataOutput output) {}
+}
+
+@Value.Immutable
+interface CompactInheritedConflict extends CompactInheritedBinary {
+  int number();
+}
+
+@Value.Immutable
+interface CompactUnsupported {
+  Object value();
+}
+
+@Value.Immutable
+interface CompactRecursive {
+  @javax.annotation.Nullable CompactRecursive next();
+}
+
+@Value.Immutable
+interface CompactStillEligible {
+  String value();
+}
+
+@Value.Immutable
+interface CompactGeneric<T> {
+  int number();
+}
+
+@Value.Immutable
+interface CompactGenericOuter {
+  CompactGeneric<String> nested();
+}
diff --git a/serial/test/org/immutables/serial/fixture/CompactBinaryTest.java b/serial/test/org/immutables/serial/fixture/CompactBinaryTest.java
new file mode 100644
index 0000000..83268cb
--- /dev/null
+++ b/serial/test/org/immutables/serial/fixture/CompactBinaryTest.java
@@ -0,0 +1,199 @@
+package org.immutables.serial.fixture;
+
+import com.Capella.common.base.Optional;
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.DataInputStream;
+import java.io.DataOutputStream;
+import java.lang.reflect.Method;
+import java.util.Arrays;
+import org.junit.Test;
+import static org.immutables.check.Checkers.check;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+public class CompactBinaryTest {
+  @Test
+  public void scalarsOptionalsArraysAndLongStringsRoundTrip() throws Exception {
+    char[] chars = new char[100_000];
+    Arrays.fill(chars, 'x');
+    ImmutableCompactScalars value = ImmutableCompactScalars.builder()
+        .booleanValue(true)
+        .byteValue((byte) 2)
+        .shortValue((short) 3)
+        .charValue('z')
+        .intValue(4)
+        .longValue(5L)
+        .floatValue(6.5f)
+        .doubleValue(7.5d)
+        .boxedBoolean(false)
+        .boxedInt(8)
+        .text(new String(chars))
+        .enumeration(CompactEnum.SECOND)
+        .jdkOptional(java.util.Optional.of("jdk"))
+        .guavaOptional(Optional.of(9))
+        .optionalInt(java.util.OptionalInt.of(10))
+        .optionalLong(java.util.OptionalLong.of(11L))
+        .optionalDouble(java.util.OptionalDouble.of(12.5d))
+        .booleans(true, false)
+        .ints(13, 14)
+        .strings("a", "b")
+        .enums(CompactEnum.FIRST, CompactEnum.SECOND)
+        .build();
+
+    check(roundTrip(value, ImmutableCompactScalars::readFrom)).is(value);
+  }
+
+  @Test
+  public void collectionShapesAndMultiplicitiesRoundTrip() throws Exception {
+    ImmutableCompactCollections value = ImmutableCompactCollections.builder()
+        .addList("a", "a")
+        .addSet("a", "b")
+        .addSortedSet("b", "a")
+        .addMultiset("a", "a", "b")
+        .addSortedMultiset("b", "a", "a")
+        .putMap("a", 1)
+        .putSortedMap("b", 2)
+        .putBiMap("c", 3)
+        .putMultimap("d", 4)
+        .putMultimap("d", 4)
+        .putListMultimap("e", 5)
+        .putListMultimap("e", 5)
+        .putSetMultimap("f", 6)
+        .build();
+
+    check(roundTrip(value, ImmutableCompactCollections::readFrom)).is(value);
+  }
+
+  @Test
+  public void constructorBuiltValuesRoundTrip() throws Exception {
+    ImmutableCompactConstructor value = ImmutableCompactConstructor.of(
+        1,
+        Arrays.asList("a", "b"),
+        java.util.OptionalInt.of(2),
+        java.util.Collections.singletonMap("c", 3));
+
+    check(roundTrip(value, ImmutableCompactConstructor::readFrom)).is(value);
+  }
+
+  @Test
+  public void versionsMatchByAttributeIdentityAndShape() throws Exception {
+    ImmutableCompactVersionOld old = ImmutableCompactVersionOld.builder()
+        .count(1)
+        .text("text")
+        .addItems("wrong element shape")
+        .build();
+    byte[] oldBytes = write(old::writeTo);
+
+    ImmutableCompactVersionNew newer = ImmutableCompactVersionNew.readFrom(input(oldBytes));
+    check(newer.count()).is(1);
+    check(newer.text()).is("text");
+    check(newer.added()).is(java.util.Optional.empty());
+    check(newer.items()).isEmpty();
+
+    ImmutableCompactVersionNew withAdded = ImmutableCompactVersionNew.builder()
+        .count(2)
+        .text("new")
+        .added("ignored")
+        .addItems(3)
+        .build();
+    ImmutableCompactVersionOld older = ImmutableCompactVersionOld.readFrom(
+        input(write(withAdded::writeTo)));
+    check(older.count()).is(2);
+    check(older.text()).is("new");
+    check(older.items()).isEmpty();
+
+    ImmutableCompactRenamed renamed = ImmutableCompactRenamed.readFrom(input(oldBytes));
+    check(renamed.total()).is(7);
+  }
+
+  @Test
+  public void nestedValuesAreFramedAndTypeNamesDoNotMatter() throws Exception {
+    ImmutableCompactOuterOld old = ImmutableCompactOuterOld.builder()
+        .nested(ImmutableCompactNestedOld.builder().number(1).text("nested").build())
+        .following("after")
+        .build();
+
+    ImmutableCompactOuterNew newer = ImmutableCompactOuterNew.readFrom(
+        input(write(old::writeTo)));
+    check(newer.nested().number()).is(1);
+    check(newer.nested().text()).is("nested");
+    check(newer.nested().added()).is(java.util.Optional.empty());
+    check(newer.following()).is("after");
+
+    ImmutableCompactGenericOuter generic = ImmutableCompactGenericOuter.builder()
+        .nested(ImmutableCompactGeneric.<String>builder().number(3).build())
+        .build();
+    check(roundTrip(generic, ImmutableCompactGenericOuter::readFrom)).is(generic);
+  }
+
+  @Test
+  public void enumsMatchByConstantName() throws Exception {
+    ImmutableCompactEnumOld old = ImmutableCompactEnumOld.builder()
+        .value(OldOrder.FIRST)
+        .build();
+    ImmutableCompactEnumNew newer = ImmutableCompactEnumNew.readFrom(
+        input(write(old::writeTo)));
+    check(newer.value()).is(NewOrder.FIRST);
+
+    ImmutableCompactEnumOld removed = ImmutableCompactEnumOld.builder()
+        .value(OldOrder.REMOVED)
+        .build();
+    ImmutableCompactEnumNew defaulted = ImmutableCompactEnumNew.readFrom(
+        input(write(removed::writeTo)));
+    check(defaulted.value()).is(NewOrder.SECOND);
+  }
+
+  @Test
+  public void conflictsAndUnsupportedShapesReceiveNoPartialForm() throws Exception {
+    assertFalse(hasDeclaredMethod(ImmutableCompactConflict.class, "readFrom"));
+    assertFalse(hasDeclaredMethod(ImmutableCompactConflict.class, "writeTo"));
+    assertFalse(hasDeclaredMethod(ImmutableCompactReadConflict.class, "readFrom"));
+    assertFalse(hasDeclaredMethod(ImmutableCompactReadConflict.class, "writeTo"));
+    assertFalse(hasDeclaredMethod(ImmutableCompactInheritedConflict.class, "readFrom"));
+    assertFalse(hasDeclaredMethod(ImmutableCompactInheritedConflict.class, "writeTo"));
+    assertFalse(hasDeclaredMethod(ImmutableCompactUnsupported.class, "readFrom"));
+    assertFalse(hasDeclaredMethod(ImmutableCompactUnsupported.class, "writeTo"));
+    assertFalse(hasDeclaredMethod(ImmutableCompactRecursive.class, "readFrom"));
+    assertFalse(hasDeclaredMethod(ImmutableCompactRecursive.class, "writeTo"));
+    assertTrue(hasDeclaredMethod(ImmutableCompactStillEligible.class, "readFrom"));
+    assertTrue(hasDeclaredMethod(ImmutableCompactStillEligible.class, "writeTo"));
+  }
+
+  @Test(expected = java.io.IOException.class)
+  public void incompleteInputFails() throws Exception {
+    byte[] bytes = write(ImmutableCompactStillEligible.builder().value("value").build()::writeTo);
+    ImmutableCompactStillEligible.readFrom(input(Arrays.copyOf(bytes, bytes.length - 1)));
+  }
+
+  private static boolean hasDeclaredMethod(Class<?> type, String name) {
+    for (Method method : type.getDeclaredMethods()) {
+      if (method.getName().equals(name)) return true;
+    }
+    return false;
+  }
+
+  private static <T> T roundTrip(T value, Reader<T> reader) throws Exception {
+    Method writeTo = value.getClass().getMethod("writeTo", java.io.DataOutput.class);
+    byte[] bytes = write(output -> writeTo.invoke(value, output));
+    return reader.read(input(bytes));
+  }
+
+  private static byte[] write(Writer writer) throws Exception {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    writer.write(new DataOutputStream(bytes));
+    return bytes.toByteArray();
+  }
+
+  private static DataInputStream input(byte[] bytes) {
+    return new DataInputStream(new ByteArrayInputStream(bytes));
+  }
+
+  private interface Writer {
+    void write(DataOutputStream output) throws Exception;
+  }
+
+  private interface Reader<T> {
+    T read(DataInputStream input) throws Exception;
+  }
+}
