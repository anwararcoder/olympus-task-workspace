+package org.immutables.value.processor.meta;
+
+import com.Capella.common.collect.ImmutableList;
+import java.nio.ByteBuffer;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.IdentityHashMap;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import javax.lang.model.element.Element;
+import javax.lang.model.element.ElementKind;
+import javax.lang.model.element.ExecutableElement;
+import javax.lang.model.element.Modifier;
+import javax.lang.model.element.TypeElement;
+import javax.lang.model.element.VariableElement;
+import javax.lang.model.type.ArrayType;
+import javax.lang.model.type.DeclaredType;
+import javax.lang.model.type.TypeKind;
+import javax.lang.model.type.TypeMirror;
+import javax.lang.model.util.ElementFilter;
+import javax.lang.model.util.Elements;
+import javax.lang.model.util.Types;
+
+public final class BinaryEncoding {
+  private static final String DATA_INPUT = "java.io.DataInput";
+  private static final String DATA_OUTPUT = "java.io.DataOutput";
+
+  private final ImmutableList<Attribute> attributes;
+
+  private BinaryEncoding(List<Attribute> attributes) {
+    this.attributes = ImmutableList.copyOf(attributes);
+  }
+
+  public ImmutableList<Attribute> attributes() {
+    return attributes;
+  }
+
+  public static void analyze(Collection<ValueType> types) {
+    Map<String, ValueType> valuesByType = new HashMap<>();
+    for (ValueType type : types) {
+      type.binaryEncoding = null;
+      if (type.element instanceof TypeElement) {
+        valuesByType.put(((TypeElement) type.element).getQualifiedName().toString(), type);
+      }
+    }
+
+    Map<ValueType, Candidate> candidates = new IdentityHashMap<>();
+    for (ValueType type : types) {
+      Candidate candidate = candidate(type, valuesByType);
+      if (candidate != null) {
+        candidates.put(type, candidate);
+      }
+    }
+
+    Set<ValueType> eligible = new HashSet<>();
+    Set<ValueType> rejected = new HashSet<>();
+    for (ValueType type : candidates.keySet()) {
+      if (isEligible(type, candidates, eligible, rejected, new HashSet<ValueType>())) {
+        eligible.add(type);
+      }
+    }
+    for (ValueType type : eligible) {
+      Candidate candidate = candidates.get(type);
+      type.binaryEncoding = new BinaryEncoding(candidate.attributes);
+    }
+  }
+
+  private static Candidate candidate(ValueType type, Map<String, ValueType> valuesByType) {
+    if (!(type.element instanceof TypeElement)
+        || !type.constitution.protoclass().environment().hasSerialBinaryModule()
+        || hasConflictingMethod(type, "writeTo", DATA_OUTPUT)
+        || hasConflictingMethod(type, "readFrom", DATA_INPUT)) {
+      return null;
+    }
+
+    boolean builder = type.isUseBuilder();
+    if (!builder && !type.isUseConstructor()) {
+      return null;
+    }
+
+    Set<ValueAttribute> constructorArguments = type.getConstructorArguments();
+    List<Attribute> attributes = new ArrayList<>();
+    Map<Id, ValueAttribute> ids = new HashMap<>();
+    for (ValueAttribute value : type.getSettableAttributes()) {
+      if (value.isAuxiliary()) {
+        if (requiresPresence(value)) {
+          return null;
+        }
+        continue;
+      }
+      if (!builder && !constructorArguments.contains(value)) {
+        return null;
+      }
+      Attribute attribute = attribute(value, valuesByType);
+      if (attribute == null || ids.put(attribute.id, value) != null) {
+        return null;
+      }
+      attributes.add(attribute);
+    }
+
+    if (!builder) {
+      for (ValueAttribute value : constructorArguments) {
+        if (value.isAuxiliary()) {
+          if (requiresPresence(value) || !hasConstructorDefault(value)) {
+            return null;
+          }
+        }
+      }
+    }
+    return new Candidate(attributes);
+  }
+
+  private static boolean isEligible(
+      ValueType type,
+      Map<ValueType, Candidate> candidates,
+      Set<ValueType> eligible,
+      Set<ValueType> rejected,
+      Set<ValueType> visiting) {
+    if (eligible.contains(type)) return true;
+    if (rejected.contains(type)) return false;
+    Candidate candidate = candidates.get(type);
+    if (candidate == null || !visiting.add(type)) {
+      rejected.addAll(visiting);
+      return false;
+    }
+    for (Attribute attribute : candidate.attributes) {
+      if (attribute.nestedType != null
+          && !isEligible(attribute.nestedType, candidates, eligible, rejected, visiting)) {
+        visiting.remove(type);
+        rejected.add(type);
+        return false;
+      }
+    }
+    visiting.remove(type);
+    eligible.add(type);
+    return true;
+  }
+
+  private static Attribute attribute(ValueAttribute value, Map<String, ValueType> valuesByType) {
+    Scalar scalar = scalar(value.returnType, valuesByType, value);
+    Container container = Container.SCALAR;
+    Scalar element = null;
+    Scalar secondary = null;
+
+    if (value.isArrayType()) {
+      TypeMirror component = ((ArrayType) value.returnType).getComponentType();
+      if (component.getKind() == TypeKind.ARRAY) return null;
+      element = scalar(component, valuesByType, value);
+      if (element == null || element.nested()) return null;
+      scalar = null;
+      container = Container.ARRAY;
+    } else if (value.isOptionalType()) {
+      element = value.isJdkSpecializedOptional()
+          ? specializedOptional(value)
+          : scalar(typeArgument(value.returnType, 0), valuesByType, value);
+      if (element == null || element.nested()) return null;
+      scalar = null;
+      container = optionalContainer(value);
+      if (container == null) return null;
+    } else if (value.isCollectionType()) {
+      if (value.isNullable()) return null;
+      element = scalar(typeArgument(value.returnType, 0), valuesByType, value);
+      if (element == null || element.nested()) return null;
+      scalar = null;
+      container = collectionContainer(value.typeKind());
+      if (container == null) return null;
+    } else if (value.isMapType()) {
+      if (value.isNullable()) return null;
+      element = scalar(typeArgument(value.returnType, 0), valuesByType, value);
+      secondary = scalar(typeArgument(value.returnType, 1), valuesByType, value);
+      if (element == null || secondary == null
+          || element.nested() || secondary.nested()) return null;
+      scalar = null;
+      container = mapContainer(value.typeKind());
+      if (container == null) return null;
+    } else if (scalar == null) {
+      return null;
+    }
+
+    Id id = id(value.name());
+    long shape = shape(container, scalar, element, secondary);
+    return new Attribute(value, id, shape, container, scalar, element, secondary);
+  }
+
+  private static Scalar specializedOptional(ValueAttribute value) {
+    switch (value.typeKind()) {
+    case OPTIONAL_INT_JDK: return Scalar.INT;
+    case OPTIONAL_LONG_JDK: return Scalar.LONG;
+    case OPTIONAL_DOUBLE_JDK: return Scalar.DOUBLE;
+    default: return null;
+    }
+  }
+
+  private static Container optionalContainer(ValueAttribute value) {
+    switch (value.typeKind()) {
+    case OPTIONAL_JDK: return Container.OPTIONAL_JDK;
+    case OPTIONAL_GUAVA: return Container.OPTIONAL_GUAVA;
+    case OPTIONAL_INT_JDK: return Container.OPTIONAL_INT;
+    case OPTIONAL_LONG_JDK: return Container.OPTIONAL_LONG;
+    case OPTIONAL_DOUBLE_JDK: return Container.OPTIONAL_DOUBLE;
+    default: return null;
+    }
+  }
+
+  private static Container collectionContainer(AttributeTypeKind kind) {
+    switch (kind) {
+    case LIST: return Container.LIST;
+    case SET:
+    case ENUM_SET: return Container.SET;
+    case SORTED_SET: return Container.SORTED_SET;
+    case MULTISET: return Container.MULTISET;
+    case SORTED_MULTISET: return Container.SORTED_MULTISET;
+    default: return null;
+    }
+  }
+
+  private static Container mapContainer(AttributeTypeKind kind) {
+    switch (kind) {
+    case MAP:
+    case ENUM_MAP: return Container.MAP;
+    case SORTED_MAP: return Container.SORTED_MAP;
+    case BI_MAP: return Container.BIMAP;
+    case MULTIMAP: return Container.MULTIMAP;
+    case LIST_MULTIMAP: return Container.LIST_MULTIMAP;
+    case SET_MULTIMAP: return Container.SET_MULTIMAP;
+    default: return null;
+    }
+  }
+
+  private static Scalar scalar(
+      TypeMirror mirror,
+      Map<String, ValueType> valuesByType,
+      ValueAttribute context) {
+    if (mirror == null) return null;
+    switch (mirror.getKind()) {
+    case BOOLEAN: return Scalar.BOOLEAN;
+    case BYTE: return Scalar.BYTE;
+    case SHORT: return Scalar.SHORT;
+    case CHAR: return Scalar.CHAR;
+    case INT: return Scalar.INT;
+    case LONG: return Scalar.LONG;
+    case FLOAT: return Scalar.FLOAT;
+    case DOUBLE: return Scalar.DOUBLE;
+    case DECLARED:
+      TypeElement element = (TypeElement) ((DeclaredType) mirror).asElement();
+      String name = element.getQualifiedName().toString();
+      if (element.getKind() == ElementKind.ENUM) {
+        return new Scalar(18, name, null);
+      }
+      Scalar boxed = Scalar.BOXED.get(name);
+      if (boxed != null) return boxed;
+      if (name.equals(String.class.getName())) return Scalar.STRING;
+      if (name.equals(Object.class.getName())) return null;
+      ValueType nested = valuesByType.get(name);
+      if (nested != null) {
+        return new Scalar(19, nested.typeImmutable().absoluteRaw(), nested);
+      }
+      ValueType external = externalValue(element, context);
+      if (external == null) return null;
+      TypeElement implementation = context.containingType.constitution.protoclass()
+          .environment().processing().getElementUtils()
+          .getTypeElement(external.typeImmutable().absoluteRaw());
+      if (implementation == null || !hasBinaryMethods(implementation, context)) return null;
+      return new Scalar(19, external.typeImmutable().absoluteRaw(), null);
+    default:
+      return null;
+    }
+  }
+
+  private static ValueType externalValue(TypeElement element, ValueAttribute context) {
+    Proto.Environment environment = context.containingType.constitution.protoclass().environment();
+    for (Proto.Protoclass protoclass : environment.protoclassesFrom(Collections.singleton(element))) {
+      if (protoclass.kind().isDefinedValue()) {
+        ValueType value = environment.composeValue(protoclass);
+        String currentPackage = context.containingType.typeImmutable().packageOf();
+        if (value.typeImmutable().visibility().isPublic()
+            || value.typeImmutable().packageOf().equals(currentPackage)) {
+          return value;
+        }
+      }
+      break;
+    }
+    return null;
+  }
+
+  private static boolean hasBinaryMethods(TypeElement implementation, ValueAttribute context) {
+    Elements elements = context.containingType.constitution.protoclass()
+        .environment().processing().getElementUtils();
+    Types types = context.containingType.constitution.protoclass()
+        .environment().processing().getTypeUtils();
+    TypeElement input = elements.getTypeElement(DATA_INPUT);
+    TypeElement output = elements.getTypeElement(DATA_OUTPUT);
+    if (input == null || output == null) return false;
+    boolean read = false;
+    boolean write = false;
+    for (ExecutableElement method : ElementFilter.methodsIn(implementation.getEnclosedElements())) {
+      if (!method.getModifiers().contains(Modifier.PUBLIC) || method.getParameters().size() != 1) {
+        continue;
+      }
+      TypeMirror parameter = method.getParameters().get(0).asType();
+      if (method.getSimpleName().contentEquals("readFrom")
+          && method.getModifiers().contains(Modifier.STATIC)
+          && types.isSameType(types.erasure(parameter), types.erasure(input.asType()))) {
+        read = true;
+      }
+      if (method.getSimpleName().contentEquals("writeTo")
+          && !method.getModifiers().contains(Modifier.STATIC)
+          && types.isSameType(types.erasure(parameter), types.erasure(output.asType()))) {
+        write = true;
+      }
+    }
+    return read && write;
+  }
+
+  private static TypeMirror typeArgument(TypeMirror mirror, int index) {
+    if (!(mirror instanceof DeclaredType)) return null;
+    List<? extends TypeMirror> arguments = ((DeclaredType) mirror).getTypeArguments();
+    return index < arguments.size() ? arguments.get(index) : null;
+  }
+
+  private static boolean requiresPresence(ValueAttribute value) {
+    return !value.isGenerateDefault
+        && !value.isOptionalType()
+        && !value.isCollectionType()
+        && !value.isMapType()
+        && !value.isNullable();
+  }
+
+  private static boolean hasConstructorDefault(ValueAttribute value) {
+    return value.isOptionalType()
+        || value.isCollectionType()
+        || value.isMapType()
+        || value.isNullable();
+  }
+
+  private static boolean hasConflictingMethod(ValueType type, String name, String parameterType) {
+    Elements elements = type.constitution.protoclass().environment().processing().getElementUtils();
+    Types types = type.constitution.protoclass().environment().processing().getTypeUtils();
+    TypeElement parameter = elements.getTypeElement(parameterType);
+    if (parameter == null) return true;
+    TypeElement element = CachingElements.getDelegate((TypeElement) type.element);
+    List<? extends Element> members = elements.getAllMembers(element);
+    for (ExecutableElement method : ElementFilter.methodsIn(members)) {
+      if (method.getSimpleName().contentEquals(name) && method.getParameters().size() == 1) {
+        VariableElement argument = method.getParameters().get(0);
+        if (types.isSameType(types.erasure(argument.asType()), types.erasure(parameter.asType()))) {
+          return true;
+        }
+      }
+    }
+    return false;
+  }
+
+  private static long shape(
+      Container container,
+      Scalar scalar,
+      Scalar element,
+      Scalar secondary) {
+    if (container == Container.SCALAR) return scalar.code;
+    long shape = ((long) container.code) << 32;
+    if (element != null) shape |= ((long) element.code) << 16;
+    if (secondary != null) shape |= secondary.code;
+    return shape;
+  }
+
+  private static Id id(String name) {
+    try {
+      byte[] digest = MessageDigest.getInstance("SHA-256")
+          .digest(name.getBytes(StandardCharsets.UTF_8));
+      ByteBuffer buffer = ByteBuffer.wrap(digest);
+      return new Id(buffer.getLong(), buffer.getLong());
+    } catch (NoSuchAlgorithmException ex) {
+      throw new AssertionError(ex);
+    }
+  }
+
+  private static final class Candidate {
+    final List<Attribute> attributes;
+
+    Candidate(List<Attribute> attributes) {
+      this.attributes = attributes;
+    }
+  }
+
+  private static final class Id {
+    final long high;
+    final long low;
+
+    Id(long high, long low) {
+      this.high = high;
+      this.low = low;
+    }
+
+    @Override
+    public boolean equals(Object other) {
+      if (this == other) return true;
+      if (!(other instanceof Id)) return false;
+      Id id = (Id) other;
+      return high == id.high && low == id.low;
+    }
+
+    @Override
+    public int hashCode() {
+      return 31 * Long.hashCode(high) + Long.hashCode(low);
+    }
+  }
+
+  public static final class Attribute {
+    private final ValueAttribute value;
+    private final Id id;
+    private final long shape;
+    private final Container container;
+    private final Scalar scalar;
+    private final Scalar element;
+    private final Scalar secondary;
+    private final ValueType nestedType;
+
+    Attribute(
+        ValueAttribute value,
+        Id id,
+        long shape,
+        Container container,
+        Scalar scalar,
+        Scalar element,
+        Scalar secondary) {
+      this.value = value;
+      this.id = id;
+      this.shape = shape;
+      this.container = container;
+      this.scalar = scalar;
+      this.element = element;
+      this.secondary = secondary;
+      this.nestedType = scalar != null ? scalar.nestedType : null;
+    }
+
+    public ValueAttribute value() { return value; }
+    public long idHigh() { return id.high; }
+    public long idLow() { return id.low; }
+    public long shape() { return shape; }
+    public boolean scalar() { return container == Container.SCALAR; }
+    public boolean array() { return container == Container.ARRAY; }
+    public boolean optional() { return container.optional; }
+    public boolean collection() { return container.collection; }
+    public boolean map() { return container.map; }
+    public boolean requiresPresence() { return BinaryEncoding.requiresPresence(value); }
+    public int scalarKind() { return scalar != null ? scalar.code : 0; }
+    public int elementKind() { return element != null ? element.code : 0; }
+    public int secondaryKind() { return secondary != null ? secondary.code : 0; }
+    public String scalarClass() { return classLiteral(scalar); }
+    public String elementClass() { return classLiteral(element); }
+    public String secondaryClass() { return classLiteral(secondary); }
+
+    private static String classLiteral(Scalar scalar) {
+      return scalar != null && scalar.className != null
+          ? scalar.className + ".class"
+          : "java.lang.Object.class";
+    }
+  }
+
+  private enum Container {
+    SCALAR(0, false, false, false),
+    OPTIONAL_JDK(32, true, false, false),
+    OPTIONAL_GUAVA(33, true, false, false),
+    OPTIONAL_INT(34, true, false, false),
+    OPTIONAL_LONG(35, true, false, false),
+    OPTIONAL_DOUBLE(36, true, false, false),
+    ARRAY(40, false, false, false),
+    LIST(41, false, true, false),
+    SET(42, false, true, false),
+    SORTED_SET(43, false, true, false),
+    MULTISET(44, false, true, false),
+    SORTED_MULTISET(45, false, true, false),
+    MAP(48, false, false, true),
+    SORTED_MAP(49, false, false, true),
+    BIMAP(50, false, false, true),
+    MULTIMAP(51, false, false, true),
+    LIST_MULTIMAP(52, false, false, true),
+    SET_MULTIMAP(53, false, false, true);
+
+    final int code;
+    final boolean optional;
+    final boolean collection;
+    final boolean map;
+
+    Container(int code, boolean optional, boolean collection, boolean map) {
+      this.code = code;
+      this.optional = optional;
+      this.collection = collection;
+      this.map = map;
+    }
+  }
+
+  private static final class Scalar {
+    static final Scalar BOOLEAN = new Scalar(1, null, null);
+    static final Scalar BYTE = new Scalar(2, null, null);
+    static final Scalar SHORT = new Scalar(3, null, null);
+    static final Scalar CHAR = new Scalar(4, null, null);
+    static final Scalar INT = new Scalar(5, null, null);
+    static final Scalar LONG = new Scalar(6, null, null);
+    static final Scalar FLOAT = new Scalar(7, null, null);
+    static final Scalar DOUBLE = new Scalar(8, null, null);
+    static final Scalar STRING = new Scalar(17, String.class.getName(), null);
+    static final Map<String, Scalar> BOXED = boxed();
+
+    final int code;
+    final String className;
+    final ValueType nestedType;
+
+    Scalar(int code, String className, ValueType nestedType) {
+      this.code = code;
+      this.className = className;
+      this.nestedType = nestedType;
+    }
+
+    boolean nested() {
+      return code == 19;
+    }
+
+    private static Map<String, Scalar> boxed() {
+      Map<String, Scalar> boxed = new LinkedHashMap<>();
+      boxed.put(Boolean.class.getName(), new Scalar(9, Boolean.class.getName(), null));
+      boxed.put(Byte.class.getName(), new Scalar(10, Byte.class.getName(), null));
+      boxed.put(Short.class.getName(), new Scalar(11, Short.class.getName(), null));
+      boxed.put(Character.class.getName(), new Scalar(12, Character.class.getName(), null));
+      boxed.put(Integer.class.getName(), new Scalar(13, Integer.class.getName(), null));
+      boxed.put(Long.class.getName(), new Scalar(14, Long.class.getName(), null));
+      boxed.put(Float.class.getName(), new Scalar(15, Float.class.getName(), null));
+      boxed.put(Double.class.getName(), new Scalar(16, Double.class.getName(), null));
+      return boxed;
+    }
+  }
+}
