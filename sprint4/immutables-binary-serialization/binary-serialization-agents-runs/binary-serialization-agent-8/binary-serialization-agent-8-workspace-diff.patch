+        Arrays.asList("a", "b"),
+        new java.util.LinkedHashSet<>(Arrays.asList(2, 3)),
+        Collections.singletonMap("a", 4),
+        java.util.Optional.of("note"));
+    check(roundTrip(constructor, ImmutableBinaryConstructor::writeTo, ImmutableBinaryConstructor::readFrom)).is(constructor);
+  }
+
+  @Test
+  public void versionsMatchByAttributeAndShape() throws Exception {
+    ImmutableBinaryVersionOne oldValue = ImmutableBinaryVersionOne.builder()
+        .number(7)
+        .name("name")
+        .tail(8)
+        .build();
+    ImmutableBinaryVersionTwo readNew = transcode(
+        oldValue, ImmutableBinaryVersionOne::writeTo, ImmutableBinaryVersionTwo::readFrom);
+    check(readNew.name()).is("name");
+    check(readNew.number()).is(7);
+    check(readNew.tail()).is(8);
+    check(readNew.added()).is(java.util.Optional.empty());
+
+    ImmutableBinaryVersionTwo newValue = ImmutableBinaryVersionTwo.builder()
+        .name("new")
+        .added("ignored")
+        .tail(10)
+        .number(9)
+        .build();
+    ImmutableBinaryVersionOne readOld = transcode(
+        newValue, ImmutableBinaryVersionTwo::writeTo, ImmutableBinaryVersionOne::readFrom);
+    check(readOld).is(ImmutableBinaryVersionOne.builder()
+        .number(9).name("new").tail(10).build());
+
+    ImmutableBinaryRenamed renamed = transcode(
+        oldValue, ImmutableBinaryVersionOne::writeTo, ImmutableBinaryRenamed::readFrom);
+    check(renamed.name()).is("name");
+    check(renamed.tail()).is(8);
+    check(renamed.renamed()).is(99);
+
+    ImmutableBinaryMismatched mismatched = transcode(
+        oldValue, ImmutableBinaryVersionOne::writeTo, ImmutableBinaryMismatched::readFrom);
+    check(mismatched.number()).is("default");
+    check(mismatched.tail()).is(8);
+  }
+
+  @Test
+  public void containerElementMismatchesAreAbsent() throws Exception {
+    ImmutableBinaryContainerOne one = ImmutableBinaryContainerOne.builder()
+        .addValues(1, 2)
+        .putIndex("a", 3)
+        .tail(4)
+        .build();
+    ImmutableBinaryContainerTwo two = transcode(
+        one, ImmutableBinaryContainerOne::writeTo, ImmutableBinaryContainerTwo::readFrom);
+    check(two.values()).isEmpty();
+    check(two.index().entrySet()).isEmpty();
+    check(two.tail()).is(4);
+  }
+
+  @Test(expected = java.io.IOException.class)
+  public void incompleteInputFails() throws Exception {
+    ImmutableBinaryVersionOne value = ImmutableBinaryVersionOne.builder()
+        .number(1)
+        .name("value")
+        .tail(2)
+        .build();
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    DataOutputStream output = new DataOutputStream(bytes);
+    value.writeTo(output);
+    byte[] complete = bytes.toByteArray();
+    ImmutableBinaryVersionOne.readFrom(new DataInputStream(
+        new ByteArrayInputStream(Arrays.copyOf(complete, complete.length - 1))));
+  }
+
+  @Test
+  public void enumAndNestedCompatibilityUseEncodedShape() throws Exception {
+    ImmutableBinaryEnumOne enumOne = ImmutableBinaryEnumOne.builder()
+        .state(BinaryEnumOne.State.BETA)
+        .tail(3)
+        .build();
+    ImmutableBinaryEnumTwo enumTwo = transcode(
+        enumOne, ImmutableBinaryEnumOne::writeTo, ImmutableBinaryEnumTwo::readFrom);
+    check(enumTwo.state()).is(BinaryEnumTwo.State.BETA);
+    check(enumTwo.tail()).is(3);
+
+    ImmutableBinaryNestedOne nestedOne = ImmutableBinaryNestedOne.builder()
+        .child(ImmutableBinaryNestedOneChild.builder().value("nested").build())
+        .tail(4)
+        .build();
+    ImmutableBinaryNestedTwo nestedTwo = transcode(
+        nestedOne, ImmutableBinaryNestedOne::writeTo, ImmutableBinaryNestedTwo::readFrom);
+    check(nestedTwo.child().value()).is("nested");
+    check(nestedTwo.child().added()).is(java.util.Optional.empty());
+    check(nestedTwo.tail()).is(4);
+
+    ImmutableBinaryOutsideParent outside = ImmutableBinaryOutsideParent.builder()
+        .child(org.immutables.serial.fixture.outside.ImmutablePublicChild.<String>builder()
+            .value("outside")
+            .build())
+        .tail(5)
+        .build();
+    check(roundTrip(outside, ImmutableBinaryOutsideParent::writeTo,
+        ImmutableBinaryOutsideParent::readFrom)).is(outside);
+  }
+
+  @Test
+  public void auxiliaryAndDerivedValuesUseNormalConstruction() throws Exception {
+    ImmutableBinaryAuxiliary value = ImmutableBinaryAuxiliary.builder().value(5).build();
+    ImmutableBinaryAuxiliary copy = roundTrip(value, ImmutableBinaryAuxiliary::writeTo, ImmutableBinaryAuxiliary::readFrom);
+    check(copy).is(value);
+    check(copy.cached()).is(java.util.Optional.empty());
+    check(copy.doubled()).is(10);
+  }
+
+  @Test
+  public void conflictsAndUnsupportedShapesGenerateNoPair() {
+    check(!hasMethod(ImmutableBinaryConflict.class, "writeTo"));
+    check(!hasMethod(ImmutableBinaryConflict.class, "readFrom"));
+    check(!hasMethod(ImmutableBinaryStaticConflict.class, "writeTo"));
+    check(!hasMethod(ImmutableBinaryStaticConflict.class, "readFrom"));
+    check(!hasMethod(ImmutableBinaryUnsupported.class, "writeTo"));
+    check(!hasMethod(ImmutableBinaryRecursive.class, "writeTo"));
+    check(!hasMethod(ImmutableBinaryRequiredAuxiliary.class, "writeTo"));
+    check(!hasMethod(ImmutableBinaryInheritedConflict.class, "readFrom"));
+  }
+
+  private static boolean hasMethod(Class<?> type, String name) {
+    for (Method method : type.getDeclaredMethods()) {
+      if (method.getName().equals(name)) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  private static <F, T> T transcode(F value, BinaryWriter<F> writer, BinaryReader<T> reader)
+      throws Exception {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    DataOutputStream output = new DataOutputStream(bytes);
+    writer.write(value, output);
+    output.flush();
+    return reader.read(new DataInputStream(new ByteArrayInputStream(bytes.toByteArray())));
+  }
+
+  private static <T> T roundTrip(T value, BinaryWriter<T> writer, BinaryReader<T> reader)
+      throws Exception {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    DataOutputStream output = new DataOutputStream(bytes);
+    writer.write(value, output);
+    output.flush();
+    return reader.read(new DataInputStream(new ByteArrayInputStream(bytes.toByteArray())));
+  }
+
+  private interface BinaryWriter<T> {
+    void write(T value, DataOutputStream output) throws Exception;
+  }
+
+  private interface BinaryReader<T> {
+    T read(DataInputStream input) throws Exception;
+  }
+}
