+}
diff --git a/serial/test/org/immutables/serial/fixture/BinaryTest.java b/serial/test/org/immutables/serial/fixture/BinaryTest.java
new file mode 100644
index 0000000..b9903e3
--- /dev/null
+++ b/serial/test/org/immutables/serial/fixture/BinaryTest.java
@@ -0,0 +1,245 @@
+package org.immutables.serial.fixture;
+
+import com.Capella.common.collect.ImmutableBiMap;
+import com.Capella.common.collect.ImmutableListMultimap;
+import com.Capella.common.collect.ImmutableMultimap;
+import com.Capella.common.collect.ImmutableMultiset;
+import com.Capella.common.collect.ImmutableSetMultimap;
+import com.Capella.common.collect.ImmutableSortedMultiset;
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.DataInputStream;
+import java.io.DataOutputStream;
+import java.lang.reflect.Method;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.OptionalDouble;
+import java.util.OptionalInt;
+import java.util.OptionalLong;
+import java.util.TreeMap;
+import java.util.TreeSet;
+import org.junit.Test;
+import static org.immutables.check.Checkers.check;
+
+public class BinaryTest {
+  @Test
+  public void scalarsOptionalsAndArraysRoundTrip() throws Exception {
+    String longString = String.join("", Collections.nCopies(70000, "x"));
+    ImmutableBinaryScalars value = ImmutableBinaryScalars.builder()
+        .booleanValue(true)
+        .byteValue((byte) 2)
+        .shortValue((short) 3)
+        .intValue(4)
+        .longValue(5L)
+        .charValue('z')
+        .floatValue(6.5f)
+        .doubleValue(7.5d)
+        .boxedBoolean(false)
+        .boxedInt(8)
+        .string(longString)
+        .choice(BinaryScalars.Choice.SECOND)
+        .jdkOptional("jdk")
+        .guavaOptional(BinaryScalars.Choice.FIRST)
+        .optionalInt(OptionalInt.of(9))
+        .optionalLong(OptionalLong.of(10L))
+        .optionalDouble(OptionalDouble.of(11.5d))
+        .ints(1, 2, 3)
+        .strings("a", "b")
+        .choices(BinaryScalars.Choice.SECOND, BinaryScalars.Choice.FIRST)
+        .build();
+
+    check(roundTrip(value, ImmutableBinaryScalars::writeTo, ImmutableBinaryScalars::readFrom)).is(value);
+  }
+
+  @Test
+  public void collectionShapesRoundTrip() throws Exception {
+    TreeMap<String, Integer> sortedMap = new TreeMap<>();
+    sortedMap.put("a", 1);
+    sortedMap.put("b", 2);
+    ImmutableBinaryCollections value = ImmutableBinaryCollections.builder()
+        .addList("a", "b")
+        .addSet(1, 2)
+        .sortedSet(new TreeSet<>(Arrays.asList("a", "b")))
+        .addAllMultiset(ImmutableMultiset.of("a", "a", "b"))
+        .sortedMultiset(ImmutableSortedMultiset.of(1, 1, 2))
+        .putMap("a", 1)
+        .sortedMap(sortedMap)
+        .putAllBiMap(ImmutableBiMap.of("a", 1))
+        .putAllMultimap(ImmutableMultimap.of("a", 1, "a", 1))
+        .putAllListMultimap(ImmutableListMultimap.of("a", 1, "a", 1))
+        .putAllSetMultimap(ImmutableSetMultimap.of("a", 1, "a", 2))
+        .build();
+
+    check(roundTrip(value, ImmutableBinaryCollections::writeTo, ImmutableBinaryCollections::readFrom)).is(value);
+  }
+
+  @Test
+  public void nestedAndConstructorValuesRoundTrip() throws Exception {
+    ImmutableBinaryParent parent = ImmutableBinaryParent.builder()
+        .child(ImmutableBinaryChild.<String>builder().name("child").build())
+        .tail(12)
+        .build();
+    check(roundTrip(parent, ImmutableBinaryParent::writeTo, ImmutableBinaryParent::readFrom)).is(parent);
+
+    ImmutableBinaryConstructor constructor = ImmutableBinaryConstructor.of(
+        1,
+        Arrays.asList("a", "b"),
+        new java.util.LinkedHashSet<>(Arrays.asList(2, 3)),
+        Collections.singletonMap("a", 4),
+        java.util.Optional.of("note"));
+    check(roundTrip(constructor, ImmutableBinaryConstructor::writeTo, ImmutableBinaryConstructor::readFrom)).is(constructor);
+  }
+
+  @Test
+  public void versionsMatchByAttributeAndShape() throws Exception {
+    ImmutableBinaryVersionOne oldValue = ImmutableBinaryVersionOne.builder()
+        .number(7)
+        .name("name")
+        .tail(8)
+        .build();
+    ImmutableBinaryVersionTwo readNew = transcode(
+        oldValue, ImmutableBinaryVersionOne::writeTo, ImmutableBinaryVersionTwo::readFrom);
+    check(readNew.name()).is("name");
+    check(readNew.number()).is(7);
+    check(readNew.tail()).is(8);
+    check(readNew.added()).is(java.util.Optional.empty());
+
+    ImmutableBinaryVersionTwo newValue = ImmutableBinaryVersionTwo.builder()
+        .name("new")
+        .added("ignored")
+        .tail(10)
+        .number(9)
+        .build();
+    ImmutableBinaryVersionOne readOld = transcode(
+        newValue, ImmutableBinaryVersionTwo::writeTo, ImmutableBinaryVersionOne::readFrom);
+    check(readOld).is(ImmutableBinaryVersionOne.builder()
+        .number(9).name("new").tail(10).build());
+
+    ImmutableBinaryRenamed renamed = transcode(
+        oldValue, ImmutableBinaryVersionOne::writeTo, ImmutableBinaryRenamed::readFrom);
+    check(renamed.name()).is("name");
+    check(renamed.tail()).is(8);
+    check(renamed.renamed()).is(99);
+
+    ImmutableBinaryMismatched mismatched = transcode(
+        oldValue, ImmutableBinaryVersionOne::writeTo, ImmutableBinaryMismatched::readFrom);
+    check(mismatched.number()).is("default");
+    check(mismatched.tail()).is(8);
+  }
+
+  @Test
+  public void containerElementMismatchesAreAbsent() throws Exception {
+    ImmutableBinaryContainerOne one = ImmutableBinaryContainerOne.builder()
+        .addValues(1, 2)
+        .putIndex("a", 3)
+        .tail(4)
+        .build();
+    ImmutableBinaryContainerTwo two = transcode(
+        one, ImmutableBinaryContainerOne::writeTo, ImmutableBinaryContainerTwo::readFrom);
+    check(two.values()).isEmpty();
+    check(two.index().entrySet()).isEmpty();
