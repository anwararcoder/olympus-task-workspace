+}
+
+@Value.Immutable
+interface BinaryNestedTwoChild {
+  String value();
+  java.util.Optional<Integer> added();
+}
+
+@Value.Immutable
+interface BinaryOutsideParent {
+  org.immutables.serial.fixture.outside.PublicChild<String> child();
+  int tail();
+}
+
+interface BinaryInheritedWrite {
+  default void writeTo(DataOutput output) throws IOException {
+    output.writeInt(1);
+  }
+}
+
+@Value.Immutable
+interface BinaryInheritedConflict extends BinaryInheritedWrite {
+  int value();
+}
+
+@Value.Immutable
+interface BinaryContainerOne {
+  List<Integer> values();
+  Map<String, Integer> index();
+  int tail();
+}
+
+@Value.Immutable
+interface BinaryContainerTwo {
