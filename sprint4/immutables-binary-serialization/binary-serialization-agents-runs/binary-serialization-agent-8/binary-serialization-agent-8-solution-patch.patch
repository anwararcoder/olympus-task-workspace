diff --git a/serial/src/org/immutables/serial/Binary.java b/serial/src/org/immutables/serial/Binary.java
new file mode 100644
index 0000000..2bbf757
--- /dev/null
+++ b/serial/src/org/immutables/serial/Binary.java
@@ -0,0 +1,367 @@
+package org.immutables.serial;
+
+import java.io.ByteArrayInputStream;
+import java.io.DataInput;
+import java.io.DataInputStream;
+import java.io.DataOutput;
+import java.io.EOFException;
+import java.io.IOException;
+import java.lang.reflect.Array;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Runtime support for compact binary forms generated by the value processor. */
+public final class Binary {
+  private static final int MAGIC = 0x494D4D42;
+  private static final int VERSION = 1;
+
+  public static final int BOOLEAN = 1;
+  public static final int BYTE = 2;
+  public static final int SHORT = 3;
+  public static final int INT = 4;
+  public static final int LONG = 5;
+  public static final int CHAR = 6;
+  public static final int FLOAT = 7;
+  public static final int DOUBLE = 8;
+  public static final int BOXED_BOOLEAN = 11;
+  public static final int BOXED_BYTE = 12;
+  public static final int BOXED_SHORT = 13;
+  public static final int BOXED_INT = 14;
+  public static final int BOXED_LONG = 15;
+  public static final int BOXED_CHAR = 16;
+  public static final int BOXED_FLOAT = 17;
+  public static final int BOXED_DOUBLE = 18;
+  public static final int STRING = 20;
+  public static final int ENUM = 21;
+  public static final int NESTED = 22;
+
+  public static final int ARRAY = 1 << 24;
+  public static final int OPTIONAL_JDK = 2 << 24;
+  public static final int OPTIONAL_GUAVA = 3 << 24;
+  public static final int OPTIONAL_INT = 4 << 24;
+  public static final int OPTIONAL_LONG = 5 << 24;
+  public static final int OPTIONAL_DOUBLE = 6 << 24;
+  public static final int LIST = 7 << 24;
+  public static final int SET = 8 << 24;
+  public static final int SORTED_SET = 9 << 24;
+  public static final int MULTISET = 10 << 24;
+  public static final int SORTED_MULTISET = 11 << 24;
+  public static final int MAP = 12 << 24;
+  public static final int SORTED_MAP = 13 << 24;
+  public static final int BIMAP = 14 << 24;
+  public static final int MULTIMAP = 15 << 24;
+  public static final int LIST_MULTIMAP = 16 << 24;
+  public static final int SET_MULTIMAP = 17 << 24;
+
+  private Binary() {}
+
+  public static int sequenceShape(int container, int element) {
+    return container | element;
+  }
+
+  public static int mappingShape(int container, int key, int value) {
+    return container | (key << 8) | value;
+  }
+
+  public static void writeHeader(DataOutput output, int fields) throws IOException {
+    output.writeInt(MAGIC);
+    output.writeInt(VERSION);
+    output.writeInt(fields);
+  }
+
+  public static void writeField(
+      DataOutput output, long identifier, int shape, byte[] payload) throws IOException {
+    output.writeLong(identifier);
+    output.writeInt(shape);
+    output.writeInt(payload.length);
+    output.write(payload);
+  }
+
+  public static Fields readFields(DataInput input) throws IOException {
+    if (input.readInt() != MAGIC) {
+      throw new IOException("Not an Immutables binary value");
+    }
+    if (input.readInt() != VERSION) {
+      throw new IOException("Unsupported Immutables binary version");
+    }
+    int count = input.readInt();
+    if (count < 0) {
+      throw new IOException("Negative field count");
+    }
+    Map<Long, Field> fields = new HashMap<Long, Field>();
+    for (int i = 0; i < count; i++) {
+      long identifier = input.readLong();
+      int shape = input.readInt();
+      int length = input.readInt();
+      if (length < 0) {
+        throw new IOException("Negative field length");
+      }
+      byte[] payload = new byte[length];
+      input.readFully(payload);
+      if (fields.put(identifier, new Field(shape, payload)) != null) {
+        throw new IOException("Duplicate binary field identifier");
+      }
+    }
+    return new Fields(fields);
+  }
+
+  public static void writeScalar(DataOutput output, int kind, Object value) throws IOException {
+    if (kind >= BOXED_BOOLEAN) {
+      output.writeBoolean(value != null);
+      if (value == null) {
+        return;
+      }
+    }
+    switch (kind) {
+    case BOOLEAN:
+    case BOXED_BOOLEAN:
+      output.writeBoolean((Boolean) value);
+      return;
+    case BYTE:
+    case BOXED_BYTE:
+      output.writeByte((Byte) value);
+      return;
+    case SHORT:
+    case BOXED_SHORT:
+      output.writeShort((Short) value);
+      return;
+    case INT:
+    case BOXED_INT:
+      output.writeInt((Integer) value);
+      return;
+    case LONG:
+    case BOXED_LONG:
+      output.writeLong((Long) value);
+      return;
+    case CHAR:
+    case BOXED_CHAR:
+      output.writeChar((Character) value);
+      return;
+    case FLOAT:
+    case BOXED_FLOAT:
+      output.writeFloat((Float) value);
+      return;
+    case DOUBLE:
+    case BOXED_DOUBLE:
+      output.writeDouble((Double) value);
+      return;
+    case STRING:
+      writeString(output, (String) value);
+      return;
+    case ENUM:
+      writeString(output, ((Enum<?>) value).name());
+      return;
+    default:
+      throw new IOException("Unsupported scalar kind " + kind);
+    }
+  }
+
+  public static Object readScalar(DataInput input, int kind, Class<?> enumType) throws IOException {
+    if (kind >= BOXED_BOOLEAN && !input.readBoolean()) {
+      return null;
+    }
+    switch (kind) {
+    case BOOLEAN:
+    case BOXED_BOOLEAN:
+      return input.readBoolean();
+    case BYTE:
+    case BOXED_BYTE:
+      return input.readByte();
+    case SHORT:
+    case BOXED_SHORT:
+      return input.readShort();
+    case INT:
+    case BOXED_INT:
+      return input.readInt();
+    case LONG:
+    case BOXED_LONG:
+      return input.readLong();
+    case CHAR:
+    case BOXED_CHAR:
+      return input.readChar();
+    case FLOAT:
+    case BOXED_FLOAT:
+      return input.readFloat();
+    case DOUBLE:
+    case BOXED_DOUBLE:
+      return input.readDouble();
+    case STRING:
+      return readString(input);
+    case ENUM:
+      String name = readString(input);
+      if (name == null || enumType == null || !Enum.class.isAssignableFrom(enumType)) {
+        throw new TypeMismatchException();
+      }
+      try {
+        @SuppressWarnings({"rawtypes", "unchecked"})
+        Object value = Enum.valueOf((Class) enumType, name);
+        return value;
+      } catch (IllegalArgumentException ex) {
+        throw new TypeMismatchException();
+      }
+    default:
+      throw new IOException("Unsupported scalar kind " + kind);
+    }
+  }
+
+  public static void writeArray(DataOutput output, int kind, Object array, Class<?> enumType)
+      throws IOException {
+    if (array == null) {
+      output.writeInt(-1);
+      return;
+    }
+    int length = Array.getLength(array);
+    output.writeInt(length);
+    for (int i = 0; i < length; i++) {
+      writeScalar(output, kind, Array.get(array, i));
+    }
+  }
+
+  public static Object readArray(DataInput input, int kind, Class<?> componentType)
+      throws IOException {
+    int length = input.readInt();
+    if (length < -1) {
+      throw new IOException("Negative array length");
+    }
+    if (length == -1) {
+      return null;
+    }
+    Object array = Array.newInstance(componentType, length);
+    for (int i = 0; i < length; i++) {
+      Array.set(array, i, readScalar(input, kind, componentType));
+    }
+    return array;
+  }
+
+  public static void writeSequence(DataOutput output, int kind, Iterable<?> values)
+      throws IOException {
+    if (values == null) {
+      output.writeInt(-1);
+      return;
+    }
+    List<Object> copy = new ArrayList<Object>();
+    for (Object value : values) {
+      copy.add(value);
+    }
+    output.writeInt(copy.size());
+    for (Object value : copy) {
+      writeScalar(output, kind, value);
+    }
+  }
+
+  public static List<Object> readSequence(DataInput input, int kind, Class<?> enumType)
+      throws IOException {
+    int length = input.readInt();
+    if (length < -1) {
+      throw new IOException("Negative sequence length");
+    }
+    if (length == -1) {
+      return null;
+    }
+    List<Object> values = new ArrayList<Object>(length);
+    for (int i = 0; i < length; i++) {
+      values.add(readScalar(input, kind, enumType));
+    }
+    return values;
+  }
+
+  public static void writeEntries(
+      DataOutput output, int keyKind, int valueKind, Iterable<? extends Map.Entry<?, ?>> entries)
+      throws IOException {
+    if (entries == null) {
+      output.writeInt(-1);
+      return;
+    }
+    List<Map.Entry<?, ?>> copy = new ArrayList<Map.Entry<?, ?>>();
+    for (Map.Entry<?, ?> entry : entries) {
+      copy.add(entry);
+    }
+    output.writeInt(copy.size());
+    for (Map.Entry<?, ?> entry : copy) {
+      writeScalar(output, keyKind, entry.getKey());
+      writeScalar(output, valueKind, entry.getValue());
+    }
+  }
+
+  public static List<Object[]> readEntries(
+      DataInput input, int keyKind, Class<?> keyEnum, int valueKind, Class<?> valueEnum)
+      throws IOException {
+    int length = input.readInt();
+    if (length < -1) {
+      throw new IOException("Negative mapping length");
+    }
+    if (length == -1) {
+      return null;
+    }
+    List<Object[]> entries = new ArrayList<Object[]>(length);
+    for (int i = 0; i < length; i++) {
+      entries.add(new Object[] {
+          readScalar(input, keyKind, keyEnum),
+          readScalar(input, valueKind, valueEnum)});
+    }
+    return entries;
+  }
+
+  private static void writeString(DataOutput output, String value) throws IOException {
+    if (value == null) {
+      output.writeInt(-1);
+      return;
+    }
+    byte[] bytes = value.getBytes(StandardCharsets.UTF_8);
+    output.writeInt(bytes.length);
+    output.write(bytes);
+  }
+
+  private static String readString(DataInput input) throws IOException {
+    int length = input.readInt();
+    if (length < -1) {
+      throw new IOException("Negative string length");
+    }
+    if (length == -1) {
+      return null;
+    }
+    byte[] bytes = new byte[length];
+    input.readFully(bytes);
+    return new String(bytes, StandardCharsets.UTF_8);
+  }
+
+  public static final class Fields {
+    private final Map<Long, Field> fields;
+
+    Fields(Map<Long, Field> fields) {
+      this.fields = fields;
+    }
+
+    public Field get(long identifier, int shape) {
+      Field field = fields.get(identifier);
+      return field != null && field.shape == shape ? field : null;
+    }
+  }
+
+  public static final class Field {
+    private final int shape;
+    private final byte[] payload;
+
+    Field(int shape, byte[] payload) {
+      this.shape = shape;
+      this.payload = payload;
+    }
+
+    public DataInputStream input() {
+      return new DataInputStream(new ByteArrayInputStream(payload));
+    }
+
+    public void requireFullyRead(DataInputStream input) throws IOException {
+      if (input.read() != -1) {
+        throw new TypeMismatchException();
+      }
+    }
+  }
+
+  public static final class TypeMismatchException extends EOFException {
+    private static final long serialVersionUID = 1L;
+  }
+}
