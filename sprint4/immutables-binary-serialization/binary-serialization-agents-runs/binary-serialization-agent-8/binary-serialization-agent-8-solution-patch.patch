+import org.immutables.value.Value;
+
+@Value.Immutable
+interface BinaryScalars {
+  enum Choice { FIRST, SECOND }
+
+  boolean booleanValue();
+  byte byteValue();
+  short shortValue();
+  int intValue();
+  long longValue();
+  char charValue();
+  float floatValue();
+  double doubleValue();
+  Boolean boxedBoolean();
+  Integer boxedInt();
+  String string();
+  Choice choice();
+  java.util.Optional<String> jdkOptional();
+  Optional<Choice> guavaOptional();
+  OptionalInt optionalInt();
+  OptionalLong optionalLong();
+  OptionalDouble optionalDouble();
+  int[] ints();
+  String[] strings();
+  Choice[] choices();
+}
+
+@Value.Immutable
+interface BinaryCollections {
+  List<String> list();
+  Set<Integer> set();
+  SortedSet<String> sortedSet();
+  Multiset<String> multiset();
+  SortedMultiset<Integer> sortedMultiset();
+  Map<String, Integer> map();
+  SortedMap<String, Integer> sortedMap();
+  BiMap<String, Integer> biMap();
+  Multimap<String, Integer> multimap();
+  ListMultimap<String, Integer> listMultimap();
+  SetMultimap<String, Integer> setMultimap();
+}
+
+@Value.Immutable
+interface BinaryChild<T> {
+  String name();
+}
+
+@Value.Immutable
+interface BinaryParent {
+  BinaryChild<String> child();
+  int tail();
+}
+
+@Value.Immutable(builder = false)
+interface BinaryConstructor {
+  @Value.Parameter int number();
+  @Value.Parameter List<String> names();
+  @Value.Parameter Set<Integer> ids();
+  @Value.Parameter Map<String, Integer> index();
+  @Value.Parameter java.util.Optional<String> note();
+}
+
+@Value.Immutable
+interface BinaryConflict {
+  int value();
+
+  default void writeTo(DataOutput output) throws IOException {
+    output.writeInt(value());
+  }
+}
+
+@Value.Immutable
+interface BinaryStaticConflict {
+  int value();
+
+  static BinaryStaticConflict readFrom(DataInput input) throws IOException {
+    return ImmutableBinaryStaticConflict.builder().value(input.readInt()).build();
+  }
+}
+
+@Value.Immutable
+interface BinaryUnsupported {
+  Object value();
+}
+
+@Value.Immutable
+interface BinaryRecursive {
+  BinaryRecursive next();
+}
+
+@Value.Immutable
+interface BinaryAuxiliary {
+  int value();
+
+  @Value.Auxiliary
+  default java.util.Optional<String> cached() {
+    return java.util.Optional.empty();
+  }
+
+  @Value.Derived
+  default int doubled() {
+    return value() * 2;
+  }
+}
+
+@Value.Immutable
+interface BinaryRequiredAuxiliary {
+  int value();
+
+  @Value.Auxiliary
+  String requiredCache();
+}
+
+@Value.Immutable
+interface BinaryVersionOne {
+  int number();
+  String name();
+  int tail();
+}
+
+@Value.Immutable
+interface BinaryVersionTwo {
+  String name();
+  java.util.Optional<String> added();
+  int tail();
+  int number();
+}
+
+@Value.Immutable
+interface BinaryRenamed {
+  String name();
+  int tail();
+
+  @Value.Default
+  default int renamed() {
+    return 99;
+  }
+}
+
+@Value.Immutable
+interface BinaryMismatched {
+  String name();
+  int tail();
+
+  @Value.Default
+  default String number() {
+    return "default";
+  }
+}
+
+@Value.Immutable
+interface BinaryEnumOne {
+  enum State { ALPHA, BETA }
+  State state();
+  int tail();
+}
+
+@Value.Immutable
+interface BinaryEnumTwo {
+  enum State { BETA, ALPHA }
+  State state();
