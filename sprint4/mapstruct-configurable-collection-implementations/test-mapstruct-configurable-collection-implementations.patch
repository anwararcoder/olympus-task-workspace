+
+@WithClasses({
+    NestedSource.class,
+    NestedTarget.class,
+    ChosenList.class,
+    ChosenSortedSet.class,
+    ChosenSortedMap.class,
+    ChosenConcurrentNavigableMap.class,
+    ChosenSequencedSet.class,
+    ChosenSequencedMap.class,
+    FactoryList.class,
+    FactoryMapD4e6b2.class,
+    NotACollection.class,
+    AbstractChosenList.class,
+    PrivateConstructorList.class,
+    WrongArityList.class,
+    ChosenListContract.class,
+    CapacityList.class,
+    CapacityMapD4e6b2.class,
