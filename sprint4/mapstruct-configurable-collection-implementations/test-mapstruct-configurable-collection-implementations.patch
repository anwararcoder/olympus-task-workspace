+    BoundedList.class,
+    FixedElementList.class,
+    ReorderedMapE8c4a7.class,
+    CheckedConstructorList.class,
+    HiddenListContainer.class,
+    PropertyListC6a2d9.class,
+    PropertyMapC6a2d9.class,
+    PropertySetC6a2d9.class,
+    PropertySourceC6a2d9.class,
+    PropertyTargetC6a2d9.class
+})
+@Execution(ExecutionMode.SAME_THREAD)
+@TestMethodOrder(MethodOrderer.OrderAnnotation.class)
+public class ConfigurableCollectionImplementationsC4i7Test {
+
+    private static final String RESOURCE_ROOT = "collection/configurable/c4i7/";
+
+    @ProcessorTest
+    @Order(1)
+    @WithClasses(ConfiguredCollectionMapper.class)
+    @WithClasspathResource(RESOURCE_ROOT + "all-supported.properties")
+    public void shouldConfigureEverySupportedInterfaceFamily() {
+        ConfiguredCollectionMapper mapper = ConfiguredCollectionMapper.INSTANCE;
+
+        assertThat( mapper.toIterable( longs() ) ).isExactlyInstanceOf( ChosenSortedSet.class );
+        assertThat( mapper.toCollection( longs() ) ).isExactlyInstanceOf( ChosenList.class );
+        assertThat( mapper.toList( longs() ) ).isExactlyInstanceOf( FactoryList.class );
+        assertThat( mapper.toSet( new HashSet<>( longs() ) ) ).isExactlyInstanceOf( HashSet.class );
+        assertThat( mapper.toSortedSet( longs() ) ).isExactlyInstanceOf( ChosenSortedSet.class );
+        assertThat( mapper.toNavigableSet( longs() ) ).isExactlyInstanceOf( ConcurrentSkipListSet.class );
+        assertThat( mapper.toMap( numbers() ) ).isExactlyInstanceOf( HashMap.class );
+        assertThat( mapper.toSortedMap( numbers() ) ).isExactlyInstanceOf( ChosenSortedMap.class );
+        assertThat( mapper.toNavigableMap( numbers() ) ).isExactlyInstanceOf( ConcurrentSkipListMap.class );
+        assertThat( mapper.toConcurrentMap( numbers() ) )
+            .isExactlyInstanceOf( ConcurrentHashMap.class );
+        assertThat( mapper.toConcurrentNavigableMap( numbers() ) )
+            .isExactlyInstanceOf( ChosenConcurrentNavigableMap.class );
+        assertThat( mapper.toSequencedSet( new HashSet<>( longs() ) ) )
+            .isExactlyInstanceOf( ChosenSequencedSet.class );
+        assertThat( mapper.toSequencedMap( numbers() ) )
+            .isExactlyInstanceOf( ChosenSequencedMap.class );
+    }
+
+    @ProcessorTest
+    @WithClasses(DefaultingCollectionMapper.class)
+    @WithClasspathResource(RESOURCE_ROOT + "all-supported.properties")
+    public void shouldConfigureReturnDefaultMappings() {
+        assertThat( DefaultingCollectionMapper.INSTANCE.toList( null ) )
+            .isExactlyInstanceOf( FactoryList.class )
+            .isEmpty();
+        assertThat( DefaultingCollectionMapper.INSTANCE.toMap( null ) )
+            .isExactlyInstanceOf( HashMap.class )
+            .isEmpty();
+    }
+
+    @ProcessorTest
+    @WithClasses(CapacityCollectionMapper.class)
+    @WithClasspathResource(RESOURCE_ROOT + "capacity-list.properties")
+    public void shouldRetainInitialCapacityConstructionWhenAvailable() {
+        CapacityList.reset();
+
+        assertThat( CapacityCollectionMapper.INSTANCE.toList( longs() ) )
+            .isExactlyInstanceOf( CapacityList.class );
+        assertThat( CapacityList.getLastCapacity() ).isEqualTo( 2 );
+
+        CapacityList.reset();
+
+        assertThat( CapacityCollectionMapper.INSTANCE.toList( new Long[] { 1L, 2L, 3L } ) )
+            .isExactlyInstanceOf( CapacityList.class )
+            .containsExactly( "1", "2", "3" );
+        assertThat( CapacityList.getLastCapacity() ).isEqualTo( 3 );
+    }
+
+    @ProcessorTest
+    @WithClasses(CapacityMapCollectionMapperD4e6b2.class)
+    @WithClasspathResource(RESOURCE_ROOT + "capacity-map_d4e6b2.properties")
+    public void shouldRetainInitialCapacityConstructionForMaps() {
+        CapacityMapD4e6b2.reset();
+
+        Map<String, String> result = CapacityMapCollectionMapperD4e6b2.INSTANCE.toMap( numbers() );
+
+        assertThat( result ).isExactlyInstanceOf( CapacityMapD4e6b2.class );
+        assertThat( result ).containsExactly(
+            Map.entry( "1", "10" ),
+            Map.entry( "2", "20" )
+        );
+        assertThat( CapacityMapD4e6b2.getLastCapacity() ).isEqualTo( 2 );
+    }
+
+    @ProcessorTest
+    @WithClasses(FallbackCapacityCollectionMapperF7b3a1.class)
+    @WithClasspathResource(RESOURCE_ROOT + "fallback-capacity-list.properties")
+    public void shouldUseTheNoArgConstructorWhenTheIntConstructorIsNotUsable() {
+        FallbackCapacityList.reset();
+
+        assertThat( FallbackCapacityCollectionMapperF7b3a1.INSTANCE.toList( longs() ) )
+            .isExactlyInstanceOf( FallbackCapacityList.class );
+        assertThat( FallbackCapacityList.wasNoArgConstructorUsed() ).isTrue();
+    }
+
+    @ProcessorTest
+    @WithClasses(ConfiguredCollectionMapper.class)
+    @WithClasspathResource(RESOURCE_ROOT + "all-supported.properties")
+    public void shouldUseConfigurationInForgedNestedMappings() {
+        NestedSource source = new NestedSource();
+        source.setValues( longs() );
+
+        NestedTarget target = ConfiguredCollectionMapper.INSTANCE.toNestedTarget( source );
+
+        assertThat( target.getValues() ).isExactlyInstanceOf( FactoryList.class );
+        assertThat( target.getValues() ).containsExactly( "1", "2" );
+    }
+
+    @ProcessorTest
+    @WithClasses(ConfiguredCollectionMapper.class)
+    @WithClasspathResource(RESOURCE_ROOT + "all-supported.properties")
+    public void shouldKeepConcreteResultTypesUnchanged() {
+        assertThat( ConfiguredCollectionMapper.INSTANCE.toConcreteList( longs() ) )
+            .isExactlyInstanceOf( ArrayList.class );
