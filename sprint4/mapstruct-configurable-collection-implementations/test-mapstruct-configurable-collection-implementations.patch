+    @WithClasspathResource(RESOURCE_ROOT + "factory-precedence.properties")
+    public void shouldGiveObjectFactoriesPrecedence() {
+        assertThat( FactoryCollectionMapper.INSTANCE.toList( longs() ) )
+            .isExactlyInstanceOf( FactoryList.class );
+        assertThat( FactoryCollectionMapper.INSTANCE.toMap( numbers() ) )
+            .isExactlyInstanceOf( FactoryMapD4e6b2.class );
