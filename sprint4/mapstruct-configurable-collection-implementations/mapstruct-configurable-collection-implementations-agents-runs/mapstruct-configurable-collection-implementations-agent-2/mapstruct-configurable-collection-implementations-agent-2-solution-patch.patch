+/*
+ * Copyright MapStruct Authors.
+ *
+ * Licensed under the Apache License version 2.0, available at http://www.apache.org/licenses/LICENSE-2.0
+ */
+package org.mapstruct.ap.internal.util;
+
+import org.mapstruct.ap.spi.TypeHierarchyErroneousException;
+
+/**
+ * Signals that a configured collection implementation may be generated in a later processing round.
+ */
+public class ConfiguredImplementationTypeNotAvailableException extends TypeHierarchyErroneousException {
+
+    private static final long serialVersionUID = 1L;
+
+    private final String key;
+    private final String implementationName;
+
+    public ConfiguredImplementationTypeNotAvailableException(String key, String implementationName) {
+        super( (javax.lang.model.type.TypeMirror) null );
+        this.key = key;
+        this.implementationName = implementationName;
+    }
+
+    public String getKey() {
+        return key;
+    }
+
+    public String getImplementationName() {
+        return implementationName;
+    }
+}
diff --git a/processor/src/test/java/org/mapstruct/ap/test/collection/configurable/ConfigurableCollectionImplementationTest.java b/processor/src/test/java/org/mapstruct/ap/test/collection/configurable/ConfigurableCollectionImplementationTest.java
