index 0000000..c4e89f0
--- /dev/null
+++ b/processor/src/main/java/org/mapstruct/ap/internal/option/CollectionImplementationConfiguration.java
@@ -0,0 +1,407 @@
+/*
+ * Copyright MapStruct Authors.
+ *
+ * Licensed under the Apache License version 2.0, available at http://www.apache.org/licenses/LICENSE-2.0
+ */
+package org.mapstruct.ap.internal.option;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Properties;
+import javax.annotation.processing.Filer;
+import javax.annotation.processing.Messager;
+import javax.lang.model.element.Element;
+import javax.lang.model.element.ElementKind;
+import javax.lang.model.element.ExecutableElement;
+import javax.lang.model.element.Modifier;
+import javax.lang.model.element.TypeElement;
+import javax.lang.model.element.TypeParameterElement;
+import javax.lang.model.type.DeclaredType;
+import javax.lang.model.type.TypeKind;
+import javax.lang.model.type.TypeMirror;
+import javax.lang.model.util.Elements;
+import javax.lang.model.util.Types;
+import javax.tools.Diagnostic.Kind;
+import javax.tools.FileObject;
+import javax.tools.StandardLocation;
+
+import org.mapstruct.ap.internal.util.ConfiguredImplementationTypeNotAvailableException;
+
+/**
+ * Configured implementations for collection and map interfaces.
+ */
+public class CollectionImplementationConfiguration {
+
+    public static final String DEFAULT_CONFIGURATION_FILE = "mapstruct.properties";
+    public static final String PROPERTY_PREFIX = "mapstruct.collectionImplementation.";
+
+    private static final List<String> SUPPORTED_INTERFACES = Collections.unmodifiableList( Arrays.asList(
+        "java.lang.Iterable",
+        "java.util.Collection",
+        "java.util.List",
+        "java.util.Set",
+        "java.util.SortedSet",
+        "java.util.NavigableSet",
+        "java.util.Map",
+        "java.util.SortedMap",
+        "java.util.NavigableMap",
+        "java.util.concurrent.ConcurrentMap",
+        "java.util.concurrent.ConcurrentNavigableMap",
+        "java.util.SequencedSet",
+        "java.util.SequencedMap"
+    ) );
+
+    private final Map<String, ConfiguredImplementation> implementations;
+    private final Messager messager;
+    private final boolean valid;
+    private final List<String> loadingErrors;
+    private boolean loadingErrorsReported;
+
+    private CollectionImplementationConfiguration(Map<String, ConfiguredImplementation> implementations,
+                                                  Messager messager, boolean valid, List<String> loadingErrors) {
+        this.implementations = implementations;
+        this.messager = messager;
+        this.valid = valid;
+        this.loadingErrors = loadingErrors;
+    }
+
+    public static CollectionImplementationConfiguration load(Filer filer, Elements elements, Messager messager,
+                                                             String configuredResource) {
+        boolean explicitlyConfigured = configuredResource != null;
+        String resource = explicitlyConfigured ? configuredResource : DEFAULT_CONFIGURATION_FILE;
+        DuplicateTrackingProperties properties = new DuplicateTrackingProperties();
+        List<String> loadingErrors = new ArrayList<>();
+
+        try {
+            FileObject resourceFile = filer.getResource( StandardLocation.CLASS_PATH, "", resource );
+            try ( InputStream inputStream = resourceFile.openInputStream() ) {
+                properties.load( inputStream );
+            }
+        }
+        catch ( IllegalArgumentException e ) {
+            loadingErrors.add(
+                "The MapStruct configuration resource '" + resource
+                    + "' could not be read from the mapping compilation classpath: " + e.getMessage()
+            );
+            return new CollectionImplementationConfiguration(
+                Collections.<String, ConfiguredImplementation>emptyMap(), messager, false, loadingErrors
+            );
+        }
+        catch ( IOException e ) {
+            if ( explicitlyConfigured ) {
+                loadingErrors.add(
+                    "The MapStruct configuration resource '" + resource
+                        + "' could not be read from the mapping compilation classpath: " + e.getMessage()
+                );
+                return new CollectionImplementationConfiguration(
+                    Collections.<String, ConfiguredImplementation>emptyMap(), messager, false, loadingErrors
+                );
+            }
+            return new CollectionImplementationConfiguration(
+                Collections.<String, ConfiguredImplementation>emptyMap(), messager, true, loadingErrors
+            );
+        }
+
+        boolean valid = true;
+        for ( Duplicate duplicate : properties.getConflictingDuplicates() ) {
+            loadingErrors.add(
+                "Invalid MapStruct configuration property '" + duplicate.key + "': conflicting values '"
+                    + duplicate.firstValue + "' and '" + duplicate.secondValue + "'"
+            );
+            valid = false;
+        }
+
+        Map<String, ConfiguredImplementation> implementations = new LinkedHashMap<>();
+        for ( Map.Entry<Object, Object> property : properties.entrySet() ) {
+            String key = (String) property.getKey();
+            String value = (String) property.getValue();
+            if ( !key.startsWith( PROPERTY_PREFIX ) ) {
+                loadingErrors.add(
+                    "Invalid MapStruct configuration property '" + key + "': unknown property"
+                );
+                valid = false;
+                continue;
+            }
+
+            String interfaceName = key.substring( PROPERTY_PREFIX.length() );
+            if ( !SUPPORTED_INTERFACES.contains( interfaceName ) || elements.getTypeElement( interfaceName ) == null ) {
+                loadingErrors.add(
+                    "Invalid MapStruct configuration property '" + key + "': unsupported collection or map interface '"
+                        + interfaceName + "'"
+                );
+                valid = false;
+                continue;
+            }
+            if ( value.isEmpty() ) {
+                loadingErrors.add(
+                    "Invalid value for MapStruct configuration property '" + key + "': value must not be empty"
+                );
+                valid = false;
+                continue;
+            }
+
+            implementations.put( interfaceName, new ConfiguredImplementation( key, value ) );
+        }
+
+        return new CollectionImplementationConfiguration( implementations, messager, valid, loadingErrors );
+    }
+
+    public void reportLoadingErrors(Element mapperElement) {
+        if ( loadingErrorsReported ) {
+            return;
+        }
+        for ( String loadingError : loadingErrors ) {
+            messager.printMessage( Kind.ERROR, loadingError, mapperElement );
+        }
+        loadingErrorsReported = true;
+    }
+
+    public Map<String, ConfiguredImplementation> resolve(Elements elements, Types types) {
+        if ( !valid || implementations.isEmpty() ) {
+            return Collections.emptyMap();
+        }
+
+        ConfiguredImplementationTypeNotAvailableException unresolved = null;
+        for ( Map.Entry<String, ConfiguredImplementation> entry : implementations.entrySet() ) {
+            ConfiguredImplementation implementation = entry.getValue();
+            if ( implementation.invalid || implementation.resolved ) {
+                continue;
+            }
+
+            TypeElement implementationElement = elements.getTypeElement( implementation.qualifiedName );
+            if ( implementationElement == null ) {
+                if ( unresolved == null ) {
+                    unresolved = new ConfiguredImplementationTypeNotAvailableException(
+                        implementation.key, implementation.qualifiedName
+                    );
+                }
+                continue;
+            }
+
+            String error = validate( entry.getKey(), implementationElement, elements, types );
+            if ( error != null ) {
+                messager.printMessage(
+                    Kind.ERROR,
+                    "Invalid value '" + implementation.qualifiedName + "' for MapStruct configuration property '"
+                        + implementation.key + "': " + error
+                );
+                implementation.invalid = true;
+            }
+            else {
+                implementation.initialCapacityConstructor = hasUsableIntConstructor(
+                    implementationElement, elements, types
+                );
+                implementation.resolved = true;
+            }
+        }
+
+        if ( unresolved != null ) {
+            throw unresolved;
+        }
+        return implementations;
+    }
+
+    public void reportUnresolved(Element mapperElement) {
+        for ( ConfiguredImplementation implementation : implementations.values() ) {
+            if ( !implementation.resolved && !implementation.invalid ) {
+                messager.printMessage(
+                    Kind.ERROR,
+                    "Invalid value '" + implementation.qualifiedName + "' for MapStruct configuration property '"
+                        + implementation.key + "': implementation type could not be resolved",
+                    mapperElement
+                );
+                implementation.invalid = true;
+            }
+        }
+    }
+
+    private static String validate(String interfaceName, TypeElement implementation, Elements elements, Types types) {
+        if ( implementation.getKind() != ElementKind.CLASS
+            || implementation.getModifiers().contains( Modifier.ABSTRACT ) ) {
+            return "implementation must be a concrete class";
+        }
+        if ( !isPubliclyAccessible( implementation ) ) {
+            return "implementation must be publicly accessible";
+        }
+        if ( implementation.getNestingKind().isNested()
+            && !implementation.getModifiers().contains( Modifier.STATIC ) ) {
+            return "implementation must not be a non-static nested class";
+        }
+
+        TypeElement interfaceElement = elements.getTypeElement( interfaceName );
+        if ( !types.isAssignable(
+            types.erasure( implementation.asType() ),
+            types.erasure( interfaceElement.asType() )
+        ) ) {
+            return "implementation is not assignable to " + interfaceName;
+        }
+
+        List<? extends TypeParameterElement> implementationParameters = implementation.getTypeParameters();
+        List<? extends TypeParameterElement> interfaceParameters = interfaceElement.getTypeParameters();
+        if ( implementationParameters.size() != interfaceParameters.size() ) {
+            return "implementation must declare the same number of type parameters as " + interfaceName;
+        }
+        for ( TypeParameterElement parameter : implementationParameters ) {
+            if ( !isUnbounded( parameter, elements, types ) ) {
+                return "implementation type parameters must be unbounded";
+            }
+        }
+
+        DeclaredType interfaceSupertype = findSupertype( implementation.asType(), interfaceElement, types );
+        if ( interfaceSupertype == null ) {
+            return "implementation does not preserve the type parameters of " + interfaceName;
+        }
+        List<? extends TypeMirror> interfaceArguments = interfaceSupertype.getTypeArguments();
+        if ( interfaceArguments.size() != implementationParameters.size() ) {
+            return "implementation does not preserve the type parameters of " + interfaceName;
+        }
+        for ( int i = 0; i < implementationParameters.size(); i++ ) {
+            if ( !types.isSameType( implementationParameters.get( i ).asType(), interfaceArguments.get( i ) ) ) {
+                return "implementation does not preserve the type parameters of " + interfaceName;
+            }
+        }
+
+        if ( !hasUsableNoArgConstructor( implementation, elements, types ) ) {
+            return "implementation must expose a public no-argument constructor that declares no checked exceptions";
+        }
+        return null;
+    }
+
+    private static boolean isPubliclyAccessible(TypeElement type) {
+        Element current = type;
+        while ( current instanceof TypeElement ) {
+            if ( !current.getModifiers().contains( Modifier.PUBLIC ) ) {
+                return false;
+            }
+            current = current.getEnclosingElement();
+        }
+        return true;
+    }
+
+    private static boolean isUnbounded(TypeParameterElement parameter, Elements elements, Types types) {
+        List<? extends TypeMirror> bounds = parameter.getBounds();
+        return bounds.size() == 1
+            && types.isSameType( types.erasure( bounds.get( 0 ) ),
+                types.erasure( elements.getTypeElement( Object.class.getCanonicalName() ).asType() ) );
+    }
+
+    private static DeclaredType findSupertype(TypeMirror type, TypeElement wantedType, Types types) {
+        if ( type.getKind() == TypeKind.DECLARED
+            && types.isSameType( types.erasure( type ), types.erasure( wantedType.asType() ) ) ) {
+            return (DeclaredType) type;
+        }
+        for ( TypeMirror supertype : types.directSupertypes( type ) ) {
+            DeclaredType match = findSupertype( supertype, wantedType, types );
+            if ( match != null ) {
+                return match;
+            }
+        }
+        return null;
+    }
+
+    private static boolean hasUsableNoArgConstructor(TypeElement type, Elements elements, Types types) {
+        boolean constructorFound = false;
+        for ( Element enclosedElement : type.getEnclosedElements() ) {
+            if ( enclosedElement.getKind() == ElementKind.CONSTRUCTOR ) {
+                constructorFound = true;
+                ExecutableElement constructor = (ExecutableElement) enclosedElement;
+                if ( constructor.getParameters().isEmpty()
+                    && constructor.getModifiers().contains( Modifier.PUBLIC )
+                    && hasNoCheckedExceptions( constructor, elements, types ) ) {
+                    return true;
+                }
+            }
+        }
+        return !constructorFound && type.getModifiers().contains( Modifier.PUBLIC );
+    }
+
+    private static boolean hasUsableIntConstructor(TypeElement type, Elements elements, Types types) {
+        for ( Element enclosedElement : type.getEnclosedElements() ) {
+            if ( enclosedElement.getKind() != ElementKind.CONSTRUCTOR ) {
+                continue;
+            }
+            ExecutableElement constructor = (ExecutableElement) enclosedElement;
+            if ( constructor.getParameters().size() == 1
+                && constructor.getParameters().get( 0 ).asType().getKind() == TypeKind.INT
+                && constructor.getModifiers().contains( Modifier.PUBLIC )
+                && hasNoCheckedExceptions( constructor, elements, types ) ) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private static boolean hasNoCheckedExceptions(ExecutableElement constructor, Elements elements, Types types) {
+        TypeMirror runtimeException = elements.getTypeElement( RuntimeException.class.getCanonicalName() ).asType();
+        TypeMirror error = elements.getTypeElement( Error.class.getCanonicalName() ).asType();
+        for ( TypeMirror thrownType : constructor.getThrownTypes() ) {
+            if ( !types.isSubtype( thrownType, runtimeException ) && !types.isSubtype( thrownType, error ) ) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    public static class ConfiguredImplementation {
+
+        private final String key;
+        private final String qualifiedName;
+        private boolean resolved;
+        private boolean invalid;
+        private boolean initialCapacityConstructor;
+
+        private ConfiguredImplementation(String key, String qualifiedName) {
+            this.key = key;
+            this.qualifiedName = qualifiedName;
+        }
+
+        public String getQualifiedName() {
+            return qualifiedName;
+        }
+
+        public boolean hasInitialCapacityConstructor() {
+            return initialCapacityConstructor;
+        }
+
+        public boolean isUsable() {
+            return resolved && !invalid;
+        }
+    }
+
+    private static class DuplicateTrackingProperties extends Properties {
+
+        private final List<Duplicate> conflictingDuplicates = new ArrayList<>();
+
+        @Override
+        public synchronized Object put(Object key, Object value) {
+            Object previous = super.put( key, value );
+            if ( previous != null && !previous.equals( value ) ) {
+                conflictingDuplicates.add( new Duplicate( (String) key, (String) previous, (String) value ) );
+            }
+            return previous;
+        }
+
+        public List<Duplicate> getConflictingDuplicates() {
+            return conflictingDuplicates;
+        }
+    }
+
+    private static class Duplicate {
+
+        private final String key;
+        private final String firstValue;
+        private final String secondValue;
+
+        private Duplicate(String key, String firstValue, String secondValue) {
+            this.key = key;
+            this.firstValue = firstValue;
+            this.secondValue = secondValue;
+        }
+    }
+}
