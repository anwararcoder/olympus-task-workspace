+++ b/processor/src/test/java/org/mapstruct/ap/test/collection/configurable/ConfigurableCollectionImplementationTest.java
@@ -0,0 +1,68 @@
+/*
+ * Copyright MapStruct Authors.
+ *
+ * Licensed under the Apache License version 2.0, available at http://www.apache.org/licenses/LICENSE-2.0
+ */
+package org.mapstruct.ap.test.collection.configurable;
+
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.LinkedList;
+import java.util.List;
+import java.util.Map;
+import java.util.stream.Stream;
+
+import org.mapstruct.ap.testutil.ProcessorTest;
+import org.mapstruct.ap.testutil.WithClasses;
+import org.mapstruct.ap.testutil.WithTestDependency;
+import org.mapstruct.ap.testutil.compilation.annotation.ProcessorOption;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+@WithClasses({
+    ConfigurableCollectionMapper.class,
+    FactoryCollectionMapper.class,
+    ConfiguredList.class,
+    ConfiguredMap.class,
+    SourceBean.class,
+    TargetBean.class
+})
+@ProcessorOption(
+    name = "mapstruct.configurationFile",
+    value = "configurable-collections/valid.properties"
+)
+@WithTestDependency("target/test-classes")
+public class ConfigurableCollectionImplementationTest {
+
+    @ProcessorTest
+    public void shouldUseConfiguredImplementationsEverywhere() {
+        List<String> list = ConfigurableCollectionMapper.INSTANCE.mapList( Arrays.asList( 1, 2, 3 ) );
+
+        assertThat( list ).isInstanceOf( ConfiguredList.class ).containsExactly( "1", "2", "3" );
+        assertThat( ConfiguredList.getLastInitialCapacity() ).isEqualTo( 3 );
+
+        Map<Integer, Integer> sourceMap = new LinkedHashMap<>();
+        sourceMap.put( 1, 2 );
+        sourceMap.put( 3, 4 );
+        Map<String, String> map = ConfigurableCollectionMapper.INSTANCE.mapMap( sourceMap );
+
+        assertThat( map ).isInstanceOf( ConfiguredMap.class ).containsEntry( "1", "2" ).containsEntry( "3", "4" );
+        assertThat( ConfiguredMap.getLastInitialCapacity() ).isEqualTo( 2 );
+
+        SourceBean sourceBean = new SourceBean();
+        sourceBean.setValues( Arrays.asList( 5, 6 ) );
+        TargetBean targetBean = ConfigurableCollectionMapper.INSTANCE.mapBean( sourceBean );
+        assertThat( targetBean.getValues() ).isInstanceOf( ConfiguredList.class ).containsExactly( "5", "6" );
+
+        List<String> stream = ConfigurableCollectionMapper.INSTANCE.mapStream( Stream.of( 7, 8 ) );
+        assertThat( stream ).isInstanceOf( ConfiguredList.class ).containsExactly( "7", "8" );
+        assertThat( ConfiguredList.getLastInitialCapacity() ).isZero();
+    }
+
+    @ProcessorTest
+    public void shouldPreferObjectFactory() {
+        List<String> result = FactoryCollectionMapper.INSTANCE.map( Arrays.asList( 1, 2 ) );
+
+        assertThat( result ).isInstanceOf( LinkedList.class ).containsExactly( "1", "2" );
+    }
+}
