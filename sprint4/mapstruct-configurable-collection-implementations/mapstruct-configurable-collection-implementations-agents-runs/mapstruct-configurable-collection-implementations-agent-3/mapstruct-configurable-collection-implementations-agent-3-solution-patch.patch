+ * Licensed under the Apache License version 2.0, available at http://www.apache.org/licenses/LICENSE-2.0
+ */
+package org.mapstruct.ap.internal.option;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Properties;
+import java.util.Set;
+import javax.annotation.processing.Filer;
+import javax.annotation.processing.Messager;
+import javax.lang.model.element.Element;
+import javax.lang.model.element.ElementKind;
+import javax.lang.model.element.ExecutableElement;
+import javax.lang.model.element.Modifier;
+import javax.lang.model.element.TypeElement;
+import javax.lang.model.element.TypeParameterElement;
+import javax.lang.model.type.DeclaredType;
+import javax.lang.model.type.TypeKind;
+import javax.lang.model.type.TypeMirror;
+import javax.lang.model.util.Elements;
+import javax.lang.model.util.Types;
+import javax.tools.Diagnostic;
+import javax.tools.FileObject;
+import javax.tools.StandardLocation;
+
+/**
+ * Configuration for the concrete types used for supported collection and map interfaces.
+ */
+public class CollectionImplementationConfiguration {
+
+    private static final String DEFAULT_CONFIGURATION_FILE = "mapstruct.properties";
+    private static final String PROPERTY_PREFIX = "mapstruct.collectionImplementation.";
+    private static final Set<String> SUPPORTED_INTERFACES = new HashSet<>( Arrays.asList(
+        "java.lang.Iterable",
+        "java.util.Collection",
+        "java.util.List",
+        "java.util.Set",
+        "java.util.SortedSet",
+        "java.util.NavigableSet",
+        "java.util.Map",
+        "java.util.SortedMap",
+        "java.util.NavigableMap",
+        "java.util.concurrent.ConcurrentMap",
+        "java.util.concurrent.ConcurrentNavigableMap",
+        "java.util.SequencedSet",
+        "java.util.SequencedMap"
+    ) );
+
+    private final Elements elements;
+    private final Types types;
+    private final Messager messager;
+    private final Map<String, ConfiguredImplementation> configuredImplementations = new LinkedHashMap<>();
+    private final Map<String, ResolvedImplementation> resolvedImplementations = new HashMap<>();
+    private final Set<String> invalidImplementations = new HashSet<>();
+
+    public CollectionImplementationConfiguration(Filer filer, Elements elements, Types types, Messager messager,
+                                                 String configuredResource) {
+        this.elements = elements;
+        this.types = types;
+        this.messager = messager;
+        load( filer, configuredResource );
+    }
+
+    public void resolveImplementations() {
+        for ( ConfiguredImplementation configuredImplementation : configuredImplementations.values() ) {
+            String interfaceName = configuredImplementation.interfaceName;
+            if ( resolvedImplementations.containsKey( interfaceName )
+                || invalidImplementations.contains( interfaceName ) ) {
+                continue;
+            }
+
+            TypeElement implementationElement = elements.getTypeElement( configuredImplementation.value );
+            if ( implementationElement == null ) {
+                continue;
+            }
+
+            String error = validateImplementation( configuredImplementation, implementationElement );
+            if ( error != null ) {
+                invalidImplementations.add( interfaceName );
+                printInvalidValue( configuredImplementation, error );
+                continue;
+            }
+
+            resolvedImplementations.put(
+                interfaceName,
+                new ResolvedImplementation(
+                    configuredImplementation.value,
+                    hasUsableIntConstructor( implementationElement )
+                )
+            );
+        }
+    }
+
+    public boolean hasUnavailableImplementations() {
+        for ( String interfaceName : configuredImplementations.keySet() ) {
+            if ( !resolvedImplementations.containsKey( interfaceName )
+                && !invalidImplementations.contains( interfaceName ) ) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    public void reportUnavailableImplementations() {
+        for ( ConfiguredImplementation configuredImplementation : configuredImplementations.values() ) {
+            String interfaceName = configuredImplementation.interfaceName;
+            if ( !resolvedImplementations.containsKey( interfaceName )
+                && !invalidImplementations.contains( interfaceName ) ) {
+                invalidImplementations.add( interfaceName );
+                printInvalidValue( configuredImplementation, "the implementation type could not be resolved" );
+            }
+        }
+    }
+
+    public Map<String, ResolvedImplementation> getResolvedImplementations() {
+        return resolvedImplementations;
+    }
+
+    private void load(Filer filer, String configuredResource) {
+        boolean explicitlyConfigured = configuredResource != null;
+        String resourceName = explicitlyConfigured ? configuredResource : DEFAULT_CONFIGURATION_FILE;
+        if ( resourceName == null || resourceName.trim().isEmpty() ) {
+            messager.printMessage(
+                Diagnostic.Kind.ERROR,
+                "Invalid value for '" + MappingOption.CONFIGURATION_FILE.getOptionName()
+                    + "': the resource path must not be empty"
+            );
+            return;
+        }
+
+        DuplicateDetectingProperties properties = new DuplicateDetectingProperties();
+        try {
+            FileObject resource = filer.getResource( StandardLocation.CLASS_PATH, "", resourceName );
+            try ( InputStream inputStream = resource.openInputStream() ) {
+                properties.load( inputStream );
+            }
+        }
+        catch ( IOException exception ) {
+            if ( explicitlyConfigured ) {
+                messager.printMessage(
+                    Diagnostic.Kind.ERROR,
+                    "Invalid value '" + resourceName + "' for '"
+                        + MappingOption.CONFIGURATION_FILE.getOptionName()
+                        + "': the selected classpath resource does not exist or cannot be read"
+                );
+            }
+            return;
+        }
+        catch ( IllegalArgumentException exception ) {
+            messager.printMessage(
+                Diagnostic.Kind.ERROR,
+                "Invalid properties resource '" + resourceName + "': " + exception.getMessage()
+            );
+            return;
+        }
+
+        for ( Map.Entry<String, List<String>> conflict : properties.conflicts.entrySet() ) {
+            messager.printMessage(
+                Diagnostic.Kind.ERROR,
+                "Invalid property '" + conflict.getKey() + "': conflicting duplicate values " + conflict.getValue()
+            );
+        }
+
+        for ( Map.Entry<Object, Object> entry : properties.entrySet() ) {
+            String key = (String) entry.getKey();
+            String value = (String) entry.getValue();
+            if ( !key.startsWith( PROPERTY_PREFIX ) ) {
+                messager.printMessage( Diagnostic.Kind.ERROR, "Unknown MapStruct property '" + key + "'" );
+                continue;
+            }
+
+            String interfaceName = key.substring( PROPERTY_PREFIX.length() );
+            if ( !SUPPORTED_INTERFACES.contains( interfaceName )
+                || elements.getTypeElement( interfaceName ) == null ) {
+                messager.printMessage(
+                    Diagnostic.Kind.ERROR,
+                    "Invalid property '" + key + "': '" + interfaceName
+                        + "' is not a supported collection or map interface"
+                );
+                continue;
+            }
+            if ( value.trim().isEmpty() ) {
+                messager.printMessage(
+                    Diagnostic.Kind.ERROR,
+                    "Invalid value for '" + key + "': it must not be empty"
+                );
+                continue;
+            }
+            if ( properties.conflicts.containsKey( key ) ) {
+                continue;
+            }
+
+            configuredImplementations.put(
+                interfaceName,
+                new ConfiguredImplementation( key, interfaceName, value )
+            );
+        }
+    }
+
+    private String validateImplementation(ConfiguredImplementation configuredImplementation,
+                                          TypeElement implementationElement) {
+        TypeElement interfaceElement = elements.getTypeElement( configuredImplementation.interfaceName );
+        if ( implementationElement.getKind() != ElementKind.CLASS
+            || implementationElement.getModifiers().contains( Modifier.ABSTRACT ) ) {
+            return "the implementation must be a concrete class";
+        }
+        if ( !isPubliclyAccessible( implementationElement ) ) {
+            return "the implementation must be publicly accessible";
+        }
+        if ( !types.isAssignable(
+            types.erasure( implementationElement.asType() ),
+            types.erasure( interfaceElement.asType() )
+        ) ) {
+            return "the implementation is not assignable to " + configuredImplementation.interfaceName;
+        }
+        if ( implementationElement.getTypeParameters().size() != interfaceElement.getTypeParameters().size() ) {
+            return "the implementation must declare the same number of type parameters as "
+                + configuredImplementation.interfaceName;
+        }
+        for ( TypeParameterElement typeParameter : implementationElement.getTypeParameters() ) {
+            if ( !isUnbounded( typeParameter ) ) {
+                return "all implementation type parameters must be unbounded";
+            }
+        }
+        if ( !preservesTypeParameters( implementationElement, interfaceElement ) ) {
+            return "the implementation must preserve the interface type parameters in their declared order";
+        }
+
+        ExecutableElement noArgumentConstructor = findConstructor( implementationElement, false );
+        if ( noArgumentConstructor == null ) {
+            return "the implementation must expose a public no-argument constructor";
+        }
+        if ( declaresCheckedException( noArgumentConstructor ) ) {
+            return "the public no-argument constructor must not declare checked exceptions";
+        }
+        return null;
+    }
+
+    private boolean isPubliclyAccessible(TypeElement typeElement) {
+        Element current = typeElement;
+        while ( current instanceof TypeElement ) {
+            if ( !current.getModifiers().contains( Modifier.PUBLIC ) ) {
+                return false;
+            }
+            current = current.getEnclosingElement();
+        }
+        return !typeElement.getNestingKind().isNested() || typeElement.getModifiers().contains( Modifier.STATIC );
+    }
+
+    private boolean isUnbounded(TypeParameterElement typeParameter) {
+        List<? extends TypeMirror> bounds = typeParameter.getBounds();
+        return bounds.size() == 1 && "java.lang.Object".equals( types.erasure( bounds.get( 0 ) ).toString() );
+    }
+
+    private boolean preservesTypeParameters(TypeElement implementationElement, TypeElement interfaceElement) {
+        DeclaredType interfaceType = findDeclaredSupertype( implementationElement.asType(), interfaceElement );
+        if ( interfaceType == null ) {
+            return false;
+        }
+
+        List<? extends TypeMirror> interfaceArguments = interfaceType.getTypeArguments();
+        List<? extends TypeParameterElement> implementationParameters = implementationElement.getTypeParameters();
+        if ( interfaceArguments.size() != implementationParameters.size() ) {
+            return false;
+        }
+        for ( int i = 0; i < interfaceArguments.size(); i++ ) {
+            if ( !types.isSameType( interfaceArguments.get( i ), implementationParameters.get( i ).asType() ) ) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private DeclaredType findDeclaredSupertype(TypeMirror type, TypeElement targetElement) {
+        if ( type.getKind() != TypeKind.DECLARED ) {
+            return null;
+        }
+        DeclaredType declaredType = (DeclaredType) type;
+        if ( types.isSameType( types.erasure( declaredType ), types.erasure( targetElement.asType() ) ) ) {
+            return declaredType;
+        }
+        for ( TypeMirror supertype : types.directSupertypes( declaredType ) ) {
+            DeclaredType match = findDeclaredSupertype( supertype, targetElement );
+            if ( match != null ) {
+                return match;
+            }
+        }
+        return null;
+    }
+
+    private boolean hasUsableIntConstructor(TypeElement implementationElement) {
+        ExecutableElement constructor = findConstructor( implementationElement, true );
+        return constructor != null && !declaresCheckedException( constructor );
+    }
+
+    private ExecutableElement findConstructor(TypeElement implementationElement, boolean intConstructor) {
+        for ( Element enclosedElement : implementationElement.getEnclosedElements() ) {
+            if ( enclosedElement.getKind() != ElementKind.CONSTRUCTOR
+                || !enclosedElement.getModifiers().contains( Modifier.PUBLIC ) ) {
+                continue;
+            }
+            ExecutableElement constructor = (ExecutableElement) enclosedElement;
+            if ( !intConstructor && constructor.getParameters().isEmpty() ) {
+                return constructor;
+            }
+            if ( intConstructor && constructor.getParameters().size() == 1
+                && constructor.getParameters().get( 0 ).asType().getKind() == TypeKind.INT ) {
+                return constructor;
+            }
+        }
+        return null;
+    }
+
+    private boolean declaresCheckedException(ExecutableElement constructor) {
+        TypeMirror runtimeException = elements.getTypeElement( RuntimeException.class.getName() ).asType();
+        TypeMirror error = elements.getTypeElement( Error.class.getName() ).asType();
+        for ( TypeMirror thrownType : constructor.getThrownTypes() ) {
+            if ( !types.isSubtype( thrownType, runtimeException ) && !types.isSubtype( thrownType, error ) ) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private void printInvalidValue(ConfiguredImplementation configuredImplementation, String cause) {
+        messager.printMessage(
+            Diagnostic.Kind.ERROR,
+            "Invalid value '" + configuredImplementation.value + "' for '" + configuredImplementation.key
+                + "': " + cause
+        );
+    }
+
+    public static class ResolvedImplementation {
+
+        private final String qualifiedName;
+        private final boolean initialCapacityConstructor;
+
+        private ResolvedImplementation(String qualifiedName, boolean initialCapacityConstructor) {
+            this.qualifiedName = qualifiedName;
+            this.initialCapacityConstructor = initialCapacityConstructor;
+        }
+
+        public String getQualifiedName() {
+            return qualifiedName;
+        }
+
+        public boolean hasInitialCapacityConstructor() {
+            return initialCapacityConstructor;
+        }
+    }
+
+    private static class ConfiguredImplementation {
+
+        private final String key;
+        private final String interfaceName;
+        private final String value;
+
+        private ConfiguredImplementation(String key, String interfaceName, String value) {
+            this.key = key;
+            this.interfaceName = interfaceName;
+            this.value = value;
+        }
+    }
+
+    private static class DuplicateDetectingProperties extends Properties {
+
+        private static final long serialVersionUID = 1L;
+
+        private final Map<String, List<String>> conflicts = new LinkedHashMap<>();
+
+        @Override
+        public synchronized Object put(Object key, Object value) {
+            Object previous = super.put( key, value );
+            if ( previous != null && !previous.equals( value ) ) {
+                List<String> values = conflicts.computeIfAbsent( (String) key, ignored -> new ArrayList<>() );
+                if ( values.isEmpty() ) {
+                    values.add( (String) previous );
+                }
+                values.add( (String) value );
+            }
+            return previous;
+        }
+    }
+}
