index 0000000..857b1c4
--- /dev/null
+++ b/processor/src/test/java/org/mapstruct/ap/test/collection/configurable/ConfigurableCollectionImplementationTest.java
@@ -0,0 +1,244 @@
+/*
+ * Copyright MapStruct Authors.
+ *
+ * Licensed under the Apache License version 2.0, available at http://www.apache.org/licenses/LICENSE-2.0
+ */
+package org.mapstruct.ap.test.collection.configurable;
+
+import java.io.File;
+import java.io.IOException;
+import java.io.Writer;
+import java.net.URISyntaxException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.List;
+import java.util.Set;
+import javax.annotation.processing.AbstractProcessor;
+import javax.annotation.processing.Processor;
+import javax.annotation.processing.RoundEnvironment;
+import javax.lang.model.SourceVersion;
+import javax.lang.model.element.TypeElement;
+import javax.tools.Diagnostic;
+import javax.tools.DiagnosticCollector;
+import javax.tools.JavaCompiler;
+import javax.tools.JavaFileObject;
+import javax.tools.StandardJavaFileManager;
+import javax.tools.StandardLocation;
+import javax.tools.ToolProvider;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import org.mapstruct.Mapper;
+import org.mapstruct.ap.MappingProcessor;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+class ConfigurableCollectionImplementationTest {
+
+    @TempDir
+    Path temporaryDirectory;
+
+    @Test
+    void shouldUseConfiguredImplementationForCollectionStreamAndBeanMappings() throws Exception {
+        Path configurationDirectory = Files.createDirectory( temporaryDirectory.resolve( "configuration" ) );
+        write(
+            configurationDirectory.resolve( "config/collections.properties" ),
+            "mapstruct.collectionImplementation.java.util.List=test.CustomList\n"
+        );
+        Path sourceDirectory = Files.createDirectory( temporaryDirectory.resolve( "sources" ) );
+        Path customList = write(
+            sourceDirectory.resolve( "test/CustomList.java" ),
+            "package test;\n"
+                + "public class CustomList<E> extends java.util.ArrayList<E> {\n"
+                + "    public CustomList() {}\n"
+                + "    public CustomList(int size) { super(size); }\n"
+                + "}\n"
+        );
+        Path mapper = write(
+            sourceDirectory.resolve( "test/TestMapper.java" ),
+            "package test;\n"
+                + "import java.util.List;\n"
+                + "import java.util.stream.Stream;\n"
+                + "import org.mapstruct.Mapper;\n"
+                + "@Mapper public interface TestMapper {\n"
+                + "    List<String> map(List<String> source);\n"
+                + "    List<String> map(Stream<String> source);\n"
+                + "    Target map(Source source);\n"
+                + "    class Source { public List<Integer> values; }\n"
+                + "    class Target { public List<Integer> values; }\n"
+                + "}\n"
+        );
+
+        Compilation compilation = compile(
+            configurationDirectory,
+            Arrays.asList( customList, mapper ),
+            Collections.singletonList( new MappingProcessor() ),
+            Collections.singletonList( "-Amapstruct.configurationFile=config/collections.properties" )
+        );
+
+        assertThat( compilation.success ).isTrue();
+        String generatedMapper = read( compilation.generatedSources.resolve( "test/TestMapperImpl.java" ) );
+        assertThat( generatedMapper )
+            .contains( "new CustomList<>( source.size() )" )
+            .contains( "Collectors.toCollection( CustomList<String>::new )" )
+            .contains( "new CustomList<>(list.size())" );
+    }
+
+    @Test
+    void shouldRejectConflictingDuplicateEntries() throws Exception {
+        Path configurationDirectory = Files.createDirectory( temporaryDirectory.resolve( "configuration" ) );
+        write(
+            configurationDirectory.resolve( "mapstruct.properties" ),
+            "mapstruct.collectionImplementation.java.util.List=java.util.ArrayList\n"
+                + "mapstruct.collectionImplementation.java.util.List=java.util.LinkedList\n"
+        );
+        Path sourceDirectory = Files.createDirectory( temporaryDirectory.resolve( "sources" ) );
+        Path mapper = write(
+            sourceDirectory.resolve( "test/TestMapper.java" ),
+            "package test;\n"
+                + "@org.mapstruct.Mapper public interface TestMapper {\n"
+                + "    java.util.List<String> map(java.util.List<String> source);\n"
+                + "}\n"
+        );
+
+        Compilation compilation = compile(
+            configurationDirectory,
+            Collections.singletonList( mapper ),
+            Collections.singletonList( new MappingProcessor() ),
+            Collections.emptyList()
+        );
+
+        assertThat( compilation.success ).isFalse();
+        assertThat( compilation.diagnostics )
+            .anySatisfy( diagnostic -> assertThat( diagnostic.getMessage( null ) )
+                .contains( "mapstruct.collectionImplementation.java.util.List" )
+                .contains( "conflicting duplicate values" ) );
+    }
+
+    @Test
+    void shouldResolveImplementationGeneratedInLaterRound() throws Exception {
+        Path configurationDirectory = Files.createDirectory( temporaryDirectory.resolve( "configuration" ) );
+        write(
+            configurationDirectory.resolve( "mapstruct.properties" ),
+            "mapstruct.collectionImplementation.java.util.List=test.GeneratedList\n"
+        );
+        Path sourceDirectory = Files.createDirectory( temporaryDirectory.resolve( "sources" ) );
+        Path mapper = write(
+            sourceDirectory.resolve( "test/TestMapper.java" ),
+            "package test;\n"
+                + "@org.mapstruct.Mapper public interface TestMapper {\n"
+                + "    java.util.List<String> map(java.util.List<String> source);\n"
+                + "}\n"
+        );
+
+        Compilation compilation = compile(
+            configurationDirectory,
+            Collections.singletonList( mapper ),
+            Arrays.asList( new GeneratedListProcessor(), new MappingProcessor() ),
+            Collections.emptyList()
+        );
+
+        assertThat( compilation.success ).isTrue();
+        assertThat( read( compilation.generatedSources.resolve( "test/TestMapperImpl.java" ) ) )
+            .contains( "new GeneratedList<>( source.size() )" );
+    }
+
+    private Compilation compile(Path configurationDirectory, List<Path> sourceFiles,
+                                List<Processor> processors, List<String> options) throws Exception {
+        JavaCompiler compiler = ToolProvider.getSystemJavaCompiler();
+        DiagnosticCollector<JavaFileObject> diagnostics = new DiagnosticCollector<>();
+        Path classes = Files.createDirectory( temporaryDirectory.resolve( "classes" ) );
+        Path generatedSources = Files.createDirectory( temporaryDirectory.resolve( "generated-sources" ) );
+
+        try ( StandardJavaFileManager fileManager = compiler.getStandardFileManager(
+            diagnostics,
+            null,
+            StandardCharsets.UTF_8
+        ) ) {
+            fileManager.setLocation(
+                StandardLocation.CLASS_PATH,
+                Arrays.asList( getMapStructClasses(), configurationDirectory.toFile() )
+            );
+            fileManager.setLocation( StandardLocation.CLASS_OUTPUT, Collections.singletonList( classes.toFile() ) );
+            fileManager.setLocation(
+                StandardLocation.SOURCE_OUTPUT,
+                Collections.singletonList( generatedSources.toFile() )
+            );
+            Iterable<? extends JavaFileObject> compilationUnits = fileManager.getJavaFileObjectsFromFiles(
+                sourceFiles.stream().map( Path::toFile ).collect( java.util.stream.Collectors.toList() )
+            );
+            JavaCompiler.CompilationTask task = compiler.getTask(
+                null,
+                fileManager,
+                diagnostics,
+                options,
+                null,
+                compilationUnits
+            );
+            task.setProcessors( processors );
+            return new Compilation( task.call(), diagnostics.getDiagnostics(), generatedSources );
+        }
+    }
+
+    private File getMapStructClasses() throws URISyntaxException {
+        return new File( Mapper.class.getProtectionDomain().getCodeSource().getLocation().toURI() );
+    }
+
+    private Path write(Path path, String content) throws IOException {
+        Files.createDirectories( path.getParent() );
+        return Files.write( path, content.getBytes( StandardCharsets.UTF_8 ) );
+    }
+
+    private String read(Path path) throws IOException {
+        return new String( Files.readAllBytes( path ), StandardCharsets.UTF_8 );
+    }
+
+    private static class Compilation {
+
+        private final boolean success;
+        private final List<Diagnostic<? extends JavaFileObject>> diagnostics;
+        private final Path generatedSources;
+
+        private Compilation(boolean success, List<Diagnostic<? extends JavaFileObject>> diagnostics,
+                            Path generatedSources) {
+            this.success = success;
+            this.diagnostics = diagnostics;
+            this.generatedSources = generatedSources;
+        }
+    }
+
+    private static class GeneratedListProcessor extends AbstractProcessor {
+
+        private boolean generated;
+
+        @Override
+        public Set<String> getSupportedAnnotationTypes() {
+            return Collections.singleton( "*" );
+        }
+
+        @Override
+        public SourceVersion getSupportedSourceVersion() {
+            return SourceVersion.latestSupported();
+        }
+
+        @Override
+        public boolean process(Set<? extends TypeElement> annotations, RoundEnvironment roundEnvironment) {
+            if ( !generated && !roundEnvironment.processingOver() ) {
+                generated = true;
+                try ( Writer writer = processingEnv.getFiler().createSourceFile( "test.GeneratedList" ).openWriter() ) {
+                    writer.write(
+                        "package test; public class GeneratedList<E> extends java.util.ArrayList<E> {"
+                            + " public GeneratedList() {} public GeneratedList(int size) { super(size); } }"
+                    );
+                }
+                catch ( IOException exception ) {
+                    throw new RuntimeException( exception );
+                }
+            }
+            return false;
+        }
+    }
+}
