+package org.mapstruct.ap.internal.option;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.Properties;
+import java.util.Set;
+import java.util.TreeSet;
+import javax.annotation.processing.Filer;
+import javax.tools.FileObject;
+import javax.tools.StandardLocation;
+
+/**
+ * Configured implementation types for supported collection and map interfaces.
+ */
+public class CollectionImplementationConfiguration {
+
+    public static final String DEFAULT_CONFIGURATION_FILE = "mapstruct.properties";
+    public static final String PROPERTY_PREFIX = "mapstruct.collectionImplementation.";
+
+    private static final Set<String> SUPPORTED_INTERFACES;
+
+    static {
+        Set<String> supportedInterfaces = new TreeSet<>();
+        supportedInterfaces.add( "java.lang.Iterable" );
+        supportedInterfaces.add( "java.util.Collection" );
+        supportedInterfaces.add( "java.util.List" );
+        supportedInterfaces.add( "java.util.Set" );
+        supportedInterfaces.add( "java.util.SortedSet" );
+        supportedInterfaces.add( "java.util.NavigableSet" );
+        supportedInterfaces.add( "java.util.Map" );
+        supportedInterfaces.add( "java.util.SortedMap" );
+        supportedInterfaces.add( "java.util.NavigableMap" );
+        supportedInterfaces.add( "java.util.concurrent.ConcurrentMap" );
+        supportedInterfaces.add( "java.util.concurrent.ConcurrentNavigableMap" );
+        supportedInterfaces.add( "java.util.SequencedSet" );
+        supportedInterfaces.add( "java.util.SequencedMap" );
+        SUPPORTED_INTERFACES = Collections.unmodifiableSet( supportedInterfaces );
+    }
+
+    private final Map<String, String> implementations;
+
+    private CollectionImplementationConfiguration(Map<String, String> implementations) {
+        this.implementations = implementations;
+    }
+
+    public static CollectionImplementationConfiguration load(Filer filer, String configuredResource) {
+        boolean explicitlyConfigured = configuredResource != null;
+        String resource = explicitlyConfigured ? configuredResource : DEFAULT_CONFIGURATION_FILE;
+        DuplicateAwareProperties properties = new DuplicateAwareProperties();
+
+        try {
+            FileObject resourceFile = filer.getResource( StandardLocation.CLASS_PATH, "", resource );
+            try ( InputStream inputStream = resourceFile.openInputStream() ) {
+                properties.load( inputStream );
+            }
+        }
+        catch ( IOException e ) {
+            if ( explicitlyConfigured ) {
+                throw new IllegalArgumentException(
+                    "Could not read MapStruct configuration resource '" + resource + "' from the compilation "
+                        + "classpath: " + e.getMessage(),
+                    e
+                );
+            }
+            return new CollectionImplementationConfiguration( Collections.<String, String>emptyMap() );
+        }
+        catch ( IllegalArgumentException e ) {
+            throw new IllegalArgumentException(
+                "Invalid MapStruct configuration resource '" + resource + "': " + e.getMessage(),
+                e
+            );
+        }
+
+        Map<String, String> implementations = new LinkedHashMap<>();
+        for ( Map.Entry<Object, Object> entry : properties.entrySet() ) {
+            String key = (String) entry.getKey();
+            String value = (String) entry.getValue();
+            if ( !key.startsWith( PROPERTY_PREFIX ) ) {
+                throw invalidProperty( resource, key, "unknown property" );
+            }
+
+            String interfaceName = key.substring( PROPERTY_PREFIX.length() );
+            if ( !SUPPORTED_INTERFACES.contains( interfaceName ) ) {
+                throw invalidProperty(
+                    resource,
+                    key,
+                    "unsupported collection or map interface '" + interfaceName + "'"
+                );
+            }
+            if ( value.trim().isEmpty() ) {
+                throw invalidProperty( resource, key, "implementation value is empty" );
+            }
+            implementations.put( interfaceName, value.trim() );
+        }
+
+        return new CollectionImplementationConfiguration( Collections.unmodifiableMap( implementations ) );
+    }
+
+    private static IllegalArgumentException invalidProperty(String resource, String key, String cause) {
+        return new IllegalArgumentException(
+            "Invalid MapStruct configuration resource '" + resource + "': property '" + key + "' is invalid: " + cause
+        );
+    }
+
+    public Map<String, String> getImplementations() {
+        return implementations;
+    }
+
+    private static class DuplicateAwareProperties extends Properties {
+
+        private static final long serialVersionUID = 1L;
+
+        @Override
+        public synchronized Object put(Object key, Object value) {
+            Object previous = get( key );
+            if ( previous != null && !previous.equals( value ) ) {
+                throw new IllegalArgumentException(
+                    "property '" + key + "' has conflicting values '" + previous + "' and '" + value + "'"
+                );
+            }
+            return super.put( key, value );
+        }
+    }
+}
