+/*
+ * Copyright MapStruct Authors.
+ *
+ * Licensed under the Apache License version 2.0, available at http://www.apache.org/licenses/LICENSE-2.0
+ */
+package org.mapstruct.ap.test.collectionimplementation;
+
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.LinkedList;
+import java.util.List;
+import java.util.Map;
+import java.util.stream.Stream;
+
+import org.mapstruct.ap.testutil.ProcessorTest;
+import org.mapstruct.ap.testutil.WithClasses;
+import org.mapstruct.ap.testutil.compilation.annotation.ProcessorOption;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+@WithClasses({
+    ConfigurableCollectionMapper.class,
+    DirectBeanMapper.class,
+    DirectBeanFactoryMapper.class,
+    CollectionFactoryMapper.class,
+    CapacityList.class,
+    CapacityMap.class,
+    CollectionSource.class,
+    CollectionTarget.class
+})
+@ProcessorOption(
+    name = "mapstruct.configurationFile",
+    value = "collection-implementations/valid.properties"
+)
+public class ConfigurableCollectionImplementationTest {
+
+    @ProcessorTest
+    public void shouldUseConfiguredImplementations() {
+        List<String> sourceList = Arrays.asList( "one", "two" );
+        Map<String, String> sourceMap = new LinkedHashMap<>();
+        sourceMap.put( "one", "1" );
+        sourceMap.put( "two", "2" );
+
+        List<String> targetList = ConfigurableCollectionMapper.INSTANCE.map( sourceList );
+        Map<String, String> targetMap = ConfigurableCollectionMapper.INSTANCE.map( sourceMap );
+        List<String> streamTarget = ConfigurableCollectionMapper.INSTANCE.map( Stream.of( "one", "two" ) );
+
+        assertThat( targetList ).isInstanceOf( CapacityList.class ).containsExactlyElementsOf( sourceList );
+        assertThat( ( (CapacityList<?>) targetList ).getInitialCapacity() ).isEqualTo( sourceList.size() );
+        assertThat( targetMap ).isInstanceOf( CapacityMap.class ).containsExactlyEntriesOf( sourceMap );
+        assertThat( ( (CapacityMap<?, ?>) targetMap ).getInitialCapacity() ).isEqualTo( sourceMap.size() );
+        assertThat( streamTarget ).isInstanceOf( CapacityList.class ).containsExactly( "one", "two" );
+    }
+
+    @ProcessorTest
+    public void shouldUseConfiguredImplementationsForBeanProperties() {
+        CollectionSource source = new CollectionSource();
+        source.setNames( Arrays.asList( "one", "two", "three" ) );
+        Map<String, String> values = new LinkedHashMap<>();
+        values.put( "one", "1" );
+        values.put( "two", "2" );
+        source.setValues( values );
+
+        CollectionTarget target = DirectBeanMapper.INSTANCE.map( source );
+
+        assertThat( target.getNames() ).isInstanceOf( CapacityList.class );
+        assertThat( ( (CapacityList<?>) target.getNames() ).getInitialCapacity() ).isEqualTo( 3 );
+        assertThat( target.getValues() ).isInstanceOf( CapacityMap.class );
+        assertThat( ( (CapacityMap<?, ?>) target.getValues() ).getInitialCapacity() ).isEqualTo( 2 );
+    }
+
+    @ProcessorTest
+    public void shouldPreferObjectFactory() {
+        List<String> target = CollectionFactoryMapper.INSTANCE.map( Arrays.asList( "one", "two" ) );
+
+        assertThat( target ).isInstanceOf( LinkedList.class ).containsExactly( "one", "two" );
+    }
+
+    @ProcessorTest
+    public void shouldPreferObjectFactoryForDirectBeanProperty() {
+        CollectionSource source = new CollectionSource();
+        source.setNames( Arrays.asList( "one", "two" ) );
+
+        CollectionTarget target = DirectBeanFactoryMapper.INSTANCE.map( source );
+
+        assertThat( target.getNames() ).isInstanceOf( LinkedList.class ).containsExactly( "one", "two" );
+    }
+}
