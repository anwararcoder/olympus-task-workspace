+import javax.lang.model.util.ElementFilter;
+import javax.lang.model.util.Elements;
+import javax.lang.model.util.Types;
+import javax.tools.Diagnostic.Kind;
+import javax.tools.FileObject;
+import javax.tools.StandardLocation;
+
+/**
+ * Configured concrete implementations for supported collection and map interfaces.
+ */
+public class CollectionImplementationConfiguration {
+
+    private static final String DEFAULT_CONFIGURATION_FILE = "mapstruct.properties";
+    private static final String PROPERTY_PREFIX = "mapstruct.collectionImplementation.";
+    private static final Set<String> SUPPORTED_INTERFACES = Collections.unmodifiableSet( new HashSet<>( Arrays.asList(
+        "java.lang.Iterable",
+        "java.util.Collection",
+        "java.util.List",
+        "java.util.Set",
+        "java.util.SortedSet",
+        "java.util.NavigableSet",
+        "java.util.Map",
+        "java.util.SortedMap",
+        "java.util.NavigableMap",
+        "java.util.concurrent.ConcurrentMap",
+        "java.util.concurrent.ConcurrentNavigableMap",
+        JavaCollectionConstants.SEQUENCED_SET_FQN,
+        JavaCollectionConstants.SEQUENCED_MAP_FQN
+    ) ) );
+
+    private final ProcessingEnvironment processingEnvironment;
+    private final Map<String, ConfiguredImplementation> implementations;
+
+    private CollectionImplementationConfiguration(
+        ProcessingEnvironment processingEnvironment,
+        Map<String, ConfiguredImplementation> implementations
+    ) {
+        this.processingEnvironment = processingEnvironment;
+        this.implementations = implementations;
+    }
+
+    public static CollectionImplementationConfiguration load(
+        ProcessingEnvironment processingEnvironment,
+        String configuredResource
+    ) {
+        String resource = configuredResource == null ? DEFAULT_CONFIGURATION_FILE : configuredResource;
+        boolean required = configuredResource != null;
+        TrackingProperties properties = new TrackingProperties();
+
+        try {
+            FileObject resourceFile = processingEnvironment.getFiler()
+                .getResource( StandardLocation.CLASS_PATH, "", resource );
+            try ( InputStream inputStream = resourceFile.openInputStream() ) {
+                properties.load( inputStream );
+            }
+        }
+        catch ( IOException ex ) {
+            if ( required ) {
+                processingEnvironment.getMessager().printMessage(
+                    Kind.ERROR,
+                    "Invalid MapStruct configuration resource '" + resource + "': resource does not exist " +
+                        "on the mapping compilation classpath"
+                );
+            }
+            return new CollectionImplementationConfiguration(
+                processingEnvironment,
+                Collections.<String, ConfiguredImplementation>emptyMap()
+            );
+        }
+        catch ( IllegalArgumentException ex ) {
+            processingEnvironment.getMessager().printMessage(
+                Kind.ERROR,
+                "Invalid MapStruct configuration resource '" + resource + "': " + ex.getMessage()
+            );
+            return new CollectionImplementationConfiguration(
+                processingEnvironment,
+                Collections.<String, ConfiguredImplementation>emptyMap()
+            );
+        }
+
+        Map<String, ConfiguredImplementation> implementations = new LinkedHashMap<>();
+        for ( Map.Entry<Object, Object> property : properties.entrySet() ) {
+            String key = (String) property.getKey();
+            String value = (String) property.getValue();
+            String conflictingValue = properties.getConflict( key );
+            if ( conflictingValue != null ) {
+                reportError(
+                    processingEnvironment,
+                    key,
+                    value,
+                    "conflicting duplicate value '" + conflictingValue + "'"
+                );
+                continue;
+            }
+            if ( !key.startsWith( PROPERTY_PREFIX ) ) {
+                reportError( processingEnvironment, key, value, "unknown property" );
+                continue;
+            }
+            String interfaceName = key.substring( PROPERTY_PREFIX.length() );
+            if ( !SUPPORTED_INTERFACES.contains( interfaceName ) ) {
+                reportError( processingEnvironment, key, value, "unsupported collection or map interface" );
+                continue;
+            }
+            if ( value.isEmpty() ) {
+                reportError( processingEnvironment, key, value, "empty implementation type" );
+                continue;
+            }
+            implementations.put( interfaceName, new ConfiguredImplementation( key, value ) );
+        }
+
+        return new CollectionImplementationConfiguration( processingEnvironment, implementations );
+    }
+
+    public void validateAvailableImplementations() {
+        for ( Map.Entry<String, ConfiguredImplementation> entry : implementations.entrySet() ) {
+            ConfiguredImplementation implementation = entry.getValue();
+            if ( implementation.status != Status.PENDING ) {
+                continue;
+            }
+            TypeElement implementationElement = processingEnvironment.getElementUtils()
+                .getTypeElement( implementation.qualifiedName );
+            if ( implementationElement != null ) {
+                validate( entry.getKey(), implementation, implementationElement );
+            }
+        }
+    }
+
+    public void reportUnavailableImplementations() {
+        for ( ConfiguredImplementation implementation : implementations.values() ) {
+            if ( implementation.status == Status.PENDING ) {
+                invalidate( implementation, "implementation type could not be resolved" );
+            }
+        }
+    }
+
+    public ConfiguredImplementation get(String interfaceName) {
+        return implementations.get( interfaceName );
+    }
+
+    private void validate(
+        String interfaceName,
+        ConfiguredImplementation implementation,
+        TypeElement implementationElement
+    ) {
+        Elements elements = processingEnvironment.getElementUtils();
+        Types types = processingEnvironment.getTypeUtils();
+        TypeElement interfaceElement = elements.getTypeElement( interfaceName );
+
+        if ( interfaceElement == null ) {
+            invalidate( implementation, "configured interface is not available for this Java version" );
+            return;
+        }
+        if ( implementationElement.getKind() != ElementKind.CLASS
+            || implementationElement.getModifiers().contains( Modifier.ABSTRACT ) ) {
+            invalidate( implementation, "implementation is not a concrete class" );
+            return;
+        }
+        if ( !isPubliclyAccessible( implementationElement ) ) {
+            invalidate( implementation, "implementation is not publicly accessible" );
+            return;
+        }
+        if ( !types.isAssignable( types.erasure( implementationElement.asType() ),
+            types.erasure( interfaceElement.asType() ) ) ) {
+            invalidate( implementation, "implementation is not assignable to " + interfaceName );
+            return;
+        }
+
+        if ( !hasUnboundedTypeParameters( implementationElement )
+            || implementationElement.getTypeParameters().size() != interfaceElement.getTypeParameters().size() ) {
+            invalidate( implementation, "implementation must declare the same number of unbounded type parameters" );
+            return;
+        }
+
+        TypeMirror[] typeParameters = new TypeMirror[implementationElement.getTypeParameters().size()];
+        for ( int i = 0; i < typeParameters.length; i++ ) {
+            typeParameters[i] = implementationElement.getTypeParameters().get( i ).asType();
+        }
+        DeclaredType preservedInterface = types.getDeclaredType( interfaceElement, typeParameters );
+        if ( !types.isAssignable( implementationElement.asType(), preservedInterface ) ) {
+            invalidate( implementation, "implementation does not preserve the interface type parameters" );
+            return;
+        }
+
+        ExecutableElement noArgumentConstructor = null;
+        boolean hasInitialCapacityConstructor = false;
+        for ( ExecutableElement constructor : ElementFilter.constructorsIn(
+            implementationElement.getEnclosedElements()
+        ) ) {
+            if ( !constructor.getModifiers().contains( Modifier.PUBLIC ) || declaresCheckedException( constructor ) ) {
+                continue;
+            }
+            if ( constructor.getParameters().isEmpty() ) {
+                noArgumentConstructor = constructor;
+            }
+            else if ( constructor.getParameters().size() == 1
+                && constructor.getParameters().get( 0 ).asType().getKind() == TypeKind.INT ) {
+                hasInitialCapacityConstructor = true;
+            }
+        }
+        if ( noArgumentConstructor == null ) {
+            invalidate(
+                implementation,
+                "implementation has no public no-argument constructor without checked exceptions"
+            );
+            return;
+        }
+
+        implementation.hasInitialCapacityConstructor = hasInitialCapacityConstructor;
+        implementation.status = Status.VALID;
+    }
+
+    private boolean declaresCheckedException(ExecutableElement constructor) {
+        Types types = processingEnvironment.getTypeUtils();
+        Elements elements = processingEnvironment.getElementUtils();
+        TypeMirror runtimeException = elements.getTypeElement( RuntimeException.class.getCanonicalName() ).asType();
+        TypeMirror error = elements.getTypeElement( Error.class.getCanonicalName() ).asType();
+        for ( TypeMirror thrownType : constructor.getThrownTypes() ) {
+            if ( !types.isAssignable( thrownType, runtimeException ) && !types.isAssignable( thrownType, error ) ) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private boolean hasUnboundedTypeParameters(TypeElement implementationElement) {
+        TypeElement objectElement = processingEnvironment.getElementUtils()
+            .getTypeElement( Object.class.getCanonicalName() );
+        Types types = processingEnvironment.getTypeUtils();
+        for ( TypeParameterElement typeParameter : implementationElement.getTypeParameters() ) {
+            if ( typeParameter.getBounds().size() != 1
+                || !types.isSameType( types.erasure( typeParameter.getBounds().get( 0 ) ), objectElement.asType() ) ) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private static boolean isPubliclyAccessible(TypeElement typeElement) {
+        Element current = typeElement;
+        while ( current instanceof TypeElement ) {
+            if ( !current.getModifiers().contains( Modifier.PUBLIC ) ) {
+                return false;
+            }
+            Element enclosingElement = current.getEnclosingElement();
+            if ( enclosingElement instanceof TypeElement && !current.getModifiers().contains( Modifier.STATIC ) ) {
+                return false;
+            }
+            current = enclosingElement;
+        }
+        return true;
+    }
+
+    private void invalidate(ConfiguredImplementation implementation, String cause) {
+        implementation.status = Status.INVALID;
+        reportError( processingEnvironment, implementation.key, implementation.qualifiedName, cause );
+    }
+
+    private static void reportError(
+        ProcessingEnvironment processingEnvironment,
+        String key,
+        String value,
+        String cause
+    ) {
+        processingEnvironment.getMessager().printMessage(
+            Kind.ERROR,
+            "Invalid MapStruct collection implementation property '" + key + "' with value '" + value + "': " + cause
+        );
+    }
+
+    public static class ConfiguredImplementation {
+
+        private final String key;
+        private final String qualifiedName;
+        private Status status = Status.PENDING;
+        private boolean hasInitialCapacityConstructor;
+
+        private ConfiguredImplementation(String key, String qualifiedName) {
+            this.key = key;
+            this.qualifiedName = qualifiedName;
+        }
+
+        public String getQualifiedName() {
+            return qualifiedName;
+        }
+
+        public boolean isPending() {
+            return status == Status.PENDING;
+        }
+
+        public boolean isValid() {
+            return status == Status.VALID;
+        }
+
+        public boolean hasInitialCapacityConstructor() {
+            return hasInitialCapacityConstructor;
+        }
+    }
+
+    private enum Status {
+        PENDING,
+        VALID,
+        INVALID
+    }
+
+    private static class TrackingProperties extends Properties {
+
+        private static final long serialVersionUID = 1L;
+
+        private final Map<String, String> conflicts = new LinkedHashMap<>();
+
+        @Override
+        public synchronized Object put(Object key, Object value) {
+            Object previous = super.put( key, value );
+            if ( previous != null && !previous.equals( value ) ) {
+                conflicts.put( (String) key, (String) previous );
+            }
+            return previous;
+        }
+
+        private String getConflict(String key) {
+            return conflicts.get( key );
+        }
+    }
+}
