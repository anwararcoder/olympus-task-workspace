@@ -0,0 +1,127 @@
+/*
+ * Copyright MapStruct Authors.
+ *
+ * Licensed under the Apache License version 2.0, available at http://www.apache.org/licenses/LICENSE-2.0
+ */
+package org.mapstruct.ap.test.collectionimplementation;
+
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.stream.Stream;
+
+import org.mapstruct.ap.testutil.ProcessorTest;
+import org.mapstruct.ap.testutil.WithClasses;
+import org.mapstruct.ap.testutil.compilation.annotation.CompilationResult;
+import org.mapstruct.ap.testutil.compilation.annotation.Diagnostic;
+import org.mapstruct.ap.testutil.compilation.annotation.ExpectedCompilationOutcome;
+import org.mapstruct.ap.testutil.compilation.annotation.ProcessorOption;
+import org.mapstruct.ap.testutil.runner.Compiler;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+public class CollectionImplementationConfigurationTest {
+
+    @ProcessorTest
+    @ProcessorOption(
+        name = "mapstruct.configurationFile",
+        value = "collectionimplementation/valid.properties"
+    )
+    @WithClasses({
+        ConfiguredCollectionMapper.class,
+        CapacityList.class,
+        CapacityMap.class,
+        CollectionSource.class,
+        CollectionTarget.class,
+        CollectionFactoryMapper.class,
+        FactoryList.class
+    })
+    public void shouldUseConfiguredImplementations() {
+        List<String> source = Arrays.asList( "one", "two" );
+
+        List<String> list = ConfiguredCollectionMapper.INSTANCE.copy( source );
+        List<String> streamList = ConfiguredCollectionMapper.INSTANCE.fromStream( Stream.of( "one", "two" ) );
+
+        CollectionSource beanSource = new CollectionSource();
+        beanSource.setValues( source );
+        beanSource.setEntries( new LinkedHashMap<>() );
+        beanSource.getEntries().put( "one", "1" );
+        beanSource.getEntries().put( "two", "2" );
+        CollectionTarget target = ConfiguredCollectionMapper.INSTANCE.copy( beanSource );
+        List<String> factoryList = CollectionFactoryMapper.INSTANCE.copy( source );
+
+        assertThat( list ).isInstanceOf( CapacityList.class );
+        assertThat( ( (CapacityList<?>) list ).getInitialCapacity() ).isEqualTo( source.size() );
+        assertThat( streamList ).isInstanceOf( CapacityList.class );
+        assertThat( ( (CapacityList<?>) streamList ).getInitialCapacity() ).isEqualTo( -1 );
+        assertThat( target.getValues() ).isInstanceOf( CapacityList.class );
+        assertThat( target.getEntries() ).isInstanceOf( CapacityMap.class );
+        assertThat( ( (CapacityMap<?, ?>) target.getEntries() ).getInitialCapacity() )
+            .isEqualTo( beanSource.getEntries().size() );
+        assertThat( target.getEntries() ).containsExactlyEntriesOf( beanSource.getEntries() );
+        assertThat( factoryList ).isInstanceOf( FactoryList.class );
+    }
+
+    @ProcessorTest(Compiler.JDK)
+    @ProcessorOption(name = "mapstruct.configurationFile", value = "collectionimplementation/missing.properties")
+    @WithClasses(InvalidCollectionMapper.class)
+    @ExpectedCompilationOutcome(
+        value = CompilationResult.FAILED,
+        diagnostics = @Diagnostic(
+            kind = javax.tools.Diagnostic.Kind.ERROR,
+            message = "Invalid MapStruct collection implementation configuration resource "
+                + "'collectionimplementation/missing.properties': resource does not exist on the mapping compilation "
+                + "classpath"
+        )
+    )
+    public void shouldFailForMissingExplicitResource() {
+    }
+
+    @ProcessorTest(Compiler.JDK)
+    @ProcessorOption(name = "mapstruct.configurationFile", value = "collectionimplementation/unknown.properties")
+    @WithClasses(InvalidCollectionMapper.class)
+    @ExpectedCompilationOutcome(
+        value = CompilationResult.FAILED,
+        diagnostics = @Diagnostic(
+            kind = javax.tools.Diagnostic.Kind.ERROR,
+            message = "Invalid MapStruct collection implementation property 'mapstruct.unknown' with value 'value': "
+                + "unknown property"
+        )
+    )
+    public void shouldFailForUnknownProperty() {
+    }
+
+    @ProcessorTest(Compiler.JDK)
+    @ProcessorOption(name = "mapstruct.configurationFile", value = "collectionimplementation/conflict.properties")
+    @WithClasses({ InvalidCollectionMapper.class, CapacityList.class })
+    @ExpectedCompilationOutcome(
+        value = CompilationResult.FAILED,
+        diagnostics = @Diagnostic(
+            kind = javax.tools.Diagnostic.Kind.ERROR,
+            message = "Invalid MapStruct collection implementation property "
+                + "'mapstruct.collectionImplementation.java.util.List' with value 'java.util.ArrayList': conflicts "
+                + "with the value 'org.mapstruct.ap.test.collectionimplementation.CapacityList'"
+        )
+    )
+    public void shouldFailForConflictingDuplicate() {
+    }
+
+    @ProcessorTest(Compiler.JDK)
+    @ProcessorOption(
+        name = "mapstruct.configurationFile",
+        value = "collectionimplementation/no-default-constructor.properties"
+    )
+    @WithClasses({ InvalidCollectionMapper.class, NoDefaultConstructorList.class })
+    @ExpectedCompilationOutcome(
+        value = CompilationResult.FAILED,
+        diagnostics = @Diagnostic(
+            kind = javax.tools.Diagnostic.Kind.ERROR,
+            message = "Invalid MapStruct collection implementation property "
+                + "'mapstruct.collectionImplementation.java.util.List' with value "
+                + "'org.mapstruct.ap.test.collectionimplementation.NoDefaultConstructorList': implementation does not "
+                + "expose a public no-argument constructor"
+        )
+    )
+    public void shouldFailForMissingDefaultConstructor() {
+    }
+}
