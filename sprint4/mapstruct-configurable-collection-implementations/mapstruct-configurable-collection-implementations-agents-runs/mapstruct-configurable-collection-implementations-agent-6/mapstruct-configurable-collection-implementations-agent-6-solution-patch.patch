--- /dev/null
+++ b/processor/src/main/java/org/mapstruct/ap/internal/option/CollectionImplementationConfiguration.java
@@ -0,0 +1,373 @@
+/*
+ * Copyright MapStruct Authors.
+ *
+ * Licensed under the Apache License version 2.0, available at http://www.apache.org/licenses/LICENSE-2.0
+ */
+package org.mapstruct.ap.internal.option;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Properties;
+import java.util.Set;
+import javax.annotation.processing.ProcessingEnvironment;
+import javax.lang.model.element.Element;
+import javax.lang.model.element.ElementKind;
+import javax.lang.model.element.ExecutableElement;
+import javax.lang.model.element.Modifier;
+import javax.lang.model.element.NestingKind;
+import javax.lang.model.element.TypeElement;
+import javax.lang.model.element.TypeParameterElement;
+import javax.lang.model.type.DeclaredType;
+import javax.lang.model.type.TypeKind;
+import javax.lang.model.type.TypeMirror;
+import javax.lang.model.util.ElementFilter;
+import javax.tools.Diagnostic.Kind;
+import javax.tools.FileObject;
+import javax.tools.StandardLocation;
+
+/**
+ * Configuration of the concrete types used for supported collection and map interfaces.
+ */
+public class CollectionImplementationConfiguration {
+
+    public static final String DEFAULT_CONFIGURATION_FILE = "mapstruct.properties";
+    public static final String PROPERTY_PREFIX = "mapstruct.collectionImplementation.";
+
+    private static final Set<String> SUPPORTED_INTERFACES = Collections.unmodifiableSet( new LinkedHashSet<>(
+        Arrays.asList(
+            "java.lang.Iterable",
+            "java.util.Collection",
+            "java.util.List",
+            "java.util.Set",
+            "java.util.SortedSet",
+            "java.util.NavigableSet",
+            "java.util.Map",
+            "java.util.SortedMap",
+            "java.util.NavigableMap",
+            "java.util.concurrent.ConcurrentMap",
+            "java.util.concurrent.ConcurrentNavigableMap",
+            "java.util.SequencedSet",
+            "java.util.SequencedMap"
+        )
+    ) );
+
+    private final Map<String, String> configuredImplementations;
+    private final Map<String, ConfiguredImplementation> resolvedImplementations = new LinkedHashMap<>();
+    private final Set<String> unresolvedInterfaces = new LinkedHashSet<>();
+    private boolean erroneous;
+
+    private CollectionImplementationConfiguration(Map<String, String> configuredImplementations, boolean erroneous) {
+        this.configuredImplementations = configuredImplementations;
+        this.erroneous = erroneous;
+    }
+
+    public static CollectionImplementationConfiguration load(ProcessingEnvironment processingEnvironment,
+                                                              String configuredResource) {
+        boolean explicitlyConfigured = configuredResource != null;
+        String resourceName = explicitlyConfigured ? configuredResource : DEFAULT_CONFIGURATION_FILE;
+        DuplicateAwareProperties properties = new DuplicateAwareProperties();
+
+        try {
+            FileObject resource = processingEnvironment.getFiler()
+                .getResource( StandardLocation.CLASS_PATH, "", resourceName );
+            try ( InputStream inputStream = resource.openInputStream() ) {
+                properties.load( inputStream );
+            }
+        }
+        catch ( IOException ex ) {
+            if ( explicitlyConfigured ) {
+                processingEnvironment.getMessager().printMessage(
+                    Kind.ERROR,
+                    "Invalid MapStruct collection implementation configuration resource '" + resourceName
+                        + "': resource does not exist on the mapping compilation classpath"
+                );
+                return new CollectionImplementationConfiguration( Collections.emptyMap(), true );
+            }
+            return new CollectionImplementationConfiguration( Collections.emptyMap(), false );
+        }
+        catch ( IllegalArgumentException ex ) {
+            processingEnvironment.getMessager().printMessage(
+                Kind.ERROR,
+                "Invalid MapStruct collection implementation configuration resource '" + resourceName
+                    + "': resource is not a valid Java properties file: " + ex.getMessage()
+            );
+            return new CollectionImplementationConfiguration( Collections.emptyMap(), true );
+        }
+
+        Map<String, String> configuredImplementations = new LinkedHashMap<>();
+        boolean erroneous = false;
+        for ( Map.Entry<Object, Object> entry : properties.entrySet() ) {
+            String key = (String) entry.getKey();
+            String value = (String) entry.getValue();
+            if ( !key.startsWith( PROPERTY_PREFIX ) ) {
+                reportInvalidProperty( processingEnvironment, key, value, "unknown property" );
+                erroneous = true;
+                continue;
+            }
+
+            String interfaceName = key.substring( PROPERTY_PREFIX.length() );
+            if ( !SUPPORTED_INTERFACES.contains( interfaceName ) ) {
+                reportInvalidProperty( processingEnvironment, key, value, "unsupported collection or map interface" );
+                erroneous = true;
+            }
+            else if ( value.isEmpty() ) {
+                reportInvalidProperty( processingEnvironment, key, value, "implementation value is empty" );
+                erroneous = true;
+            }
+            else {
+                configuredImplementations.put( interfaceName, value );
+            }
+        }
+
+        for ( Duplicate duplicate : properties.getConflictingDuplicates() ) {
+            reportInvalidProperty(
+                processingEnvironment,
+                duplicate.key,
+                duplicate.value,
+                "conflicts with the value '" + duplicate.previousValue + "'"
+            );
+            erroneous = true;
+        }
+
+        return new CollectionImplementationConfiguration( configuredImplementations, erroneous );
+    }
+
+    public void resolve(ProcessingEnvironment processingEnvironment) {
+        if ( erroneous || configuredImplementations.isEmpty() ) {
+            return;
+        }
+
+        unresolvedInterfaces.clear();
+        for ( Map.Entry<String, String> entry : configuredImplementations.entrySet() ) {
+            if ( resolvedImplementations.containsKey( entry.getKey() ) ) {
+                continue;
+            }
+
+            TypeElement implementation = processingEnvironment.getElementUtils().getTypeElement( entry.getValue() );
+            if ( implementation == null ) {
+                unresolvedInterfaces.add( entry.getKey() );
+                continue;
+            }
+
+            String cause = validateImplementation( processingEnvironment, entry.getKey(), implementation );
+            if ( cause != null ) {
+                reportInvalidProperty(
+                    processingEnvironment,
+                    PROPERTY_PREFIX + entry.getKey(),
+                    entry.getValue(),
+                    cause
+                );
+                erroneous = true;
+                return;
+            }
+
+            resolvedImplementations.put(
+                entry.getKey(),
+                new ConfiguredImplementation(
+                    entry.getValue(),
+                    hasUsableIntConstructor( processingEnvironment, implementation )
+                )
+            );
+        }
+    }
+
+    public void reportUnresolved(ProcessingEnvironment processingEnvironment) {
+        for ( String interfaceName : unresolvedInterfaces ) {
+            String implementationName = configuredImplementations.get( interfaceName );
+            reportInvalidProperty(
+                processingEnvironment,
+                PROPERTY_PREFIX + interfaceName,
+                implementationName,
+                "implementation type could not be resolved"
+            );
+        }
+        erroneous = erroneous || !unresolvedInterfaces.isEmpty();
+    }
+
+    public boolean isPending() {
+        return !unresolvedInterfaces.isEmpty();
+    }
+
+    public boolean isErroneous() {
+        return erroneous;
+    }
+
+    public Map<String, ConfiguredImplementation> getResolvedImplementations() {
+        return resolvedImplementations;
+    }
+
+    private static String validateImplementation(ProcessingEnvironment processingEnvironment, String interfaceName,
+                                                 TypeElement implementation) {
+        TypeElement interfaceElement = processingEnvironment.getElementUtils().getTypeElement( interfaceName );
+        if ( interfaceElement == null ) {
+            return "the configured interface is not available for the current source level";
+        }
+        if ( implementation.getKind() != ElementKind.CLASS
+            || implementation.getModifiers().contains( Modifier.ABSTRACT ) ) {
+            return "implementation is not a concrete class";
+        }
+        if ( !isPubliclyAccessible( implementation ) ) {
+            return "implementation is not publicly accessible";
+        }
+        if ( implementation.getNestingKind() == NestingKind.MEMBER
+            && !implementation.getModifiers().contains( Modifier.STATIC ) ) {
+            return "implementation is a non-static nested class";
+        }
+        if ( !processingEnvironment.getTypeUtils().isAssignable(
+            processingEnvironment.getTypeUtils().erasure( implementation.asType() ),
+            processingEnvironment.getTypeUtils().erasure( interfaceElement.asType() )
+        ) ) {
+            return "implementation is not assignable to the configured interface";
+        }
+
+        List<? extends TypeParameterElement> interfaceParameters = interfaceElement.getTypeParameters();
+        List<? extends TypeParameterElement> implementationParameters = implementation.getTypeParameters();
+        if ( implementationParameters.size() != interfaceParameters.size() ) {
+            return "implementation must declare the same number of type parameters as the interface";
+        }
+        for ( TypeParameterElement parameter : implementationParameters ) {
+            if ( !isUnbounded( processingEnvironment, parameter ) ) {
+                return "implementation type parameters must be unbounded";
+            }
+        }
+
+        TypeMirror[] typeArguments = new TypeMirror[implementationParameters.size()];
+        for ( int i = 0; i < implementationParameters.size(); i++ ) {
+            typeArguments[i] = implementationParameters.get( i ).asType();
+        }
+        DeclaredType parameterizedInterface = processingEnvironment.getTypeUtils()
+            .getDeclaredType( interfaceElement, typeArguments );
+        if ( !processingEnvironment.getTypeUtils().isAssignable( implementation.asType(), parameterizedInterface ) ) {
+            return "implementation does not preserve the interface type parameters";
+        }
+
+        ExecutableElement defaultConstructor = findConstructor( implementation, TypeKind.NONE );
+        if ( defaultConstructor == null || !defaultConstructor.getModifiers().contains( Modifier.PUBLIC ) ) {
+            return "implementation does not expose a public no-argument constructor";
+        }
+        if ( declaresCheckedException( processingEnvironment, defaultConstructor ) ) {
+            return "public no-argument constructor declares a checked exception";
+        }
+
+        return null;
+    }
+
+    private static boolean isPubliclyAccessible(TypeElement implementation) {
+        Element current = implementation;
+        while ( current instanceof TypeElement ) {
+            if ( !current.getModifiers().contains( Modifier.PUBLIC ) ) {
+                return false;
+            }
+            current = current.getEnclosingElement();
+        }
+        return true;
+    }
+
+    private static boolean isUnbounded(ProcessingEnvironment processingEnvironment, TypeParameterElement parameter) {
+        List<? extends TypeMirror> bounds = parameter.getBounds();
+        if ( bounds.size() != 1 ) {
+            return false;
+        }
+        TypeElement objectElement = processingEnvironment.getElementUtils().getTypeElement( Object.class.getName() );
+        return processingEnvironment.getTypeUtils().isSameType( bounds.get( 0 ), objectElement.asType() );
+    }
+
+    private static boolean hasUsableIntConstructor(ProcessingEnvironment processingEnvironment,
+                                                   TypeElement implementation) {
+        ExecutableElement constructor = findConstructor( implementation, TypeKind.INT );
+        return constructor != null
+            && constructor.getModifiers().contains( Modifier.PUBLIC )
+            && !declaresCheckedException( processingEnvironment, constructor );
+    }
+
+    private static ExecutableElement findConstructor(TypeElement implementation, TypeKind parameterKind) {
+        for ( ExecutableElement constructor : ElementFilter.constructorsIn( implementation.getEnclosedElements() ) ) {
+            if ( parameterKind == TypeKind.NONE && constructor.getParameters().isEmpty() ) {
+                return constructor;
+            }
+            if ( parameterKind != TypeKind.NONE && constructor.getParameters().size() == 1
+                && constructor.getParameters().get( 0 ).asType().getKind() == parameterKind ) {
+                return constructor;
+            }
+        }
+        return null;
+    }
+
+    private static boolean declaresCheckedException(ProcessingEnvironment processingEnvironment,
+                                                    ExecutableElement constructor) {
+        TypeMirror runtimeException = processingEnvironment.getElementUtils()
+            .getTypeElement( RuntimeException.class.getName() ).asType();
+        TypeMirror error = processingEnvironment.getElementUtils().getTypeElement( Error.class.getName() ).asType();
+        for ( TypeMirror thrownType : constructor.getThrownTypes() ) {
+            if ( !processingEnvironment.getTypeUtils().isSubtype( thrownType, runtimeException )
+                && !processingEnvironment.getTypeUtils().isSubtype( thrownType, error ) ) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private static void reportInvalidProperty(ProcessingEnvironment processingEnvironment, String key, String value,
+                                              String cause) {
+        processingEnvironment.getMessager().printMessage(
+            Kind.ERROR,
+            "Invalid MapStruct collection implementation property '" + key + "' with value '" + value + "': "
+                + cause
+        );
+    }
+
+    public static class ConfiguredImplementation {
+        private final String qualifiedName;
+        private final boolean initialCapacityConstructor;
+
+        private ConfiguredImplementation(String qualifiedName, boolean initialCapacityConstructor) {
+            this.qualifiedName = qualifiedName;
+            this.initialCapacityConstructor = initialCapacityConstructor;
+        }
+
+        public String getQualifiedName() {
+            return qualifiedName;
+        }
+
+        public boolean hasInitialCapacityConstructor() {
+            return initialCapacityConstructor;
+        }
+    }
+
+    private static class DuplicateAwareProperties extends Properties {
+        private final List<Duplicate> conflictingDuplicates = new ArrayList<>();
+
+        @Override
+        public synchronized Object put(Object key, Object value) {
+            Object previousValue = super.get( key );
+            if ( previousValue != null && !previousValue.equals( value ) ) {
+                conflictingDuplicates.add( new Duplicate( (String) key, (String) previousValue, (String) value ) );
+                return previousValue;
+            }
+            return super.put( key, value );
+        }
+
+        public List<Duplicate> getConflictingDuplicates() {
+            return conflictingDuplicates;
+        }
+    }
+
+    private static class Duplicate {
+        private final String key;
+        private final String previousValue;
+        private final String value;
+
+        private Duplicate(String key, String previousValue, String value) {
+            this.key = key;
+            this.previousValue = previousValue;
+            this.value = value;
+        }
+    }
+}
