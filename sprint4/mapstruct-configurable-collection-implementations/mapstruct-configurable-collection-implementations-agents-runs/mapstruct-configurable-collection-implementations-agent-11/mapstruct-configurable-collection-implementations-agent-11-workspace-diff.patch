+ * Licensed under the Apache License version 2.0, available at http://www.apache.org/licenses/LICENSE-2.0
+ */
+package org.mapstruct.ap.test.collectionimplementation;
+
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.stream.Stream;
+
+import org.mapstruct.ap.testutil.ProcessorTest;
+import org.mapstruct.ap.testutil.WithClasses;
+import org.mapstruct.ap.testutil.WithCompilerResource;
+import org.mapstruct.ap.testutil.compilation.annotation.CompilationResult;
+import org.mapstruct.ap.testutil.compilation.annotation.Diagnostic;
+import org.mapstruct.ap.testutil.compilation.annotation.ExpectedCompilationOutcome;
+import org.mapstruct.ap.testutil.compilation.annotation.ProcessorOption;
+import org.mapstruct.ap.testutil.runner.Compiler;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+public class CollectionImplementationTest {
+
+    private static final String TEST_PACKAGE = "org.mapstruct.ap.test.collectionimplementation.";
+    private static final String CONFIGURED_IMPLEMENTATIONS =
+        "mapstruct.collectionImplementation.java.util.List=" + TEST_PACKAGE + "CustomList\n"
+            + "mapstruct.collectionImplementation.java.util.Map=" + TEST_PACKAGE + "CustomMap\n";
+    private static final String EQUAL_DUPLICATES =
+        "mapstruct.collectionImplementation.java.util.List=" + TEST_PACKAGE + "CustomList\n"
+            + "mapstruct.collectionImplementation.java.util.List=" + TEST_PACKAGE + "CustomList\n"
+            + "mapstruct.collectionImplementation.java.util.Map=" + TEST_PACKAGE + "CustomMap\n";
+    private static final String CONFLICTING_DUPLICATES =
+        "mapstruct.collectionImplementation.java.util.List=" + TEST_PACKAGE + "CustomList\n"
+            + "mapstruct.collectionImplementation.java.util.List=" + TEST_PACKAGE + "CustomMap\n";
+    private static final String BOUNDED_IMPLEMENTATION =
+        "mapstruct.collectionImplementation.java.util.List=" + TEST_PACKAGE + "BoundedList\n";
+    private static final String REORDERED_IMPLEMENTATION =
+        "mapstruct.collectionImplementation.java.util.Map=" + TEST_PACKAGE + "ReorderedMap\n";
+    private static final String MISSING_IMPLEMENTATION =
+        "mapstruct.collectionImplementation.java.util.List=" + TEST_PACKAGE + "MissingList\n";
+
+    @ProcessorTest
+    @WithClasses({
+        CollectionImplementationMapper.class,
+        DirectCollectionMapper.class,
+        CollectionSource.class,
+        CollectionTarget.class,
+        CustomList.class,
+        CustomMap.class
+    })
+    @WithCompilerResource(
+        value = CONFIGURED_IMPLEMENTATIONS,
+        target = "config/mapstruct.properties"
+    )
+    @ProcessorOption(name = "mapstruct.configurationFile", value = "config/mapstruct.properties")
+    public void shouldUseConfiguredImplementations() {
+        List<String> sourceList = Arrays.asList( "one", "two" );
+        Map<String, Integer> sourceMap = new LinkedHashMap<>();
+        sourceMap.put( "one", 1 );
+        sourceMap.put( "two", 2 );
+
+        List<String> mappedList = CollectionImplementationMapper.INSTANCE.mapList( sourceList );
+        Map<String, Integer> mappedMap = CollectionImplementationMapper.INSTANCE.mapMap( sourceMap );
+        List<String> mappedStream = CollectionImplementationMapper.INSTANCE.mapStream( Stream.of( "one", "two" ) );
+
+        CollectionSource source = new CollectionSource();
+        source.setValues( sourceList );
+        source.setIndexes( sourceMap );
+        CollectionTarget mappedBean = DirectCollectionMapper.INSTANCE.map( source );
+
+        assertThat( mappedList ).isInstanceOf( CustomList.class );
+        assertThat( ( (CustomList<?>) mappedList ).getInitialCapacity() ).isEqualTo( sourceList.size() );
+        assertThat( mappedMap ).isInstanceOf( CustomMap.class );
+        assertThat( ( (CustomMap<?, ?>) mappedMap ).getInitialCapacity() ).isEqualTo( sourceMap.size() );
+        assertThat( mappedStream ).isInstanceOf( CustomList.class );
+        assertThat( ( (CustomList<?>) mappedStream ).getInitialCapacity() ).isEqualTo( -1 );
+        assertThat( mappedBean.getValues() ).isInstanceOf( CustomList.class );
+        assertThat( ( (CustomList<?>) mappedBean.getValues() ).getInitialCapacity() ).isEqualTo( sourceList.size() );
+        assertThat( mappedBean.getIndexes() ).isInstanceOf( CustomMap.class );
+        assertThat( ( (CustomMap<?, ?>) mappedBean.getIndexes() ).getInitialCapacity() ).isEqualTo( sourceMap.size() );
+    }
+
+    @ProcessorTest
+    @WithClasses({
+        CollectionImplementationMapper.class,
+        CollectionSource.class,
+        CollectionTarget.class,
+        CustomList.class,
+        CustomMap.class
+    })
+    @WithCompilerResource(
+        value = CONFIGURED_IMPLEMENTATIONS,
+        target = "mapstruct.properties"
+    )
+    public void shouldUseDefaultConfigurationFile() {
+        List<String> mapped = CollectionImplementationMapper.INSTANCE.mapList( Arrays.asList( "one", "two" ) );
+
+        assertThat( mapped ).isInstanceOf( CustomList.class );
+    }
+
+    @ProcessorTest
+    @WithClasses({ CollectionFactoryMapper.class, FactoryList.class, CustomList.class, CustomMap.class })
+    @WithCompilerResource(
+        value = CONFIGURED_IMPLEMENTATIONS,
+        target = "config/factory.properties"
+    )
+    @ProcessorOption(name = "mapstruct.configurationFile", value = "config/factory.properties")
+    public void shouldPreferObjectFactories() {
+        assertThat( CollectionFactoryMapper.INSTANCE.mapList( Arrays.asList( "one" ) ) )
+            .isInstanceOf( FactoryList.class );
+        assertThat( CollectionFactoryMapper.INSTANCE.mapStream( Stream.of( "one" ) ) )
+            .isInstanceOf( FactoryList.class );
+    }
+
+    @ProcessorTest
+    @WithClasses({ CollectionImplementationMapper.class, CollectionSource.class, CollectionTarget.class,
+        CustomList.class, CustomMap.class })
+    @WithCompilerResource(
+        value = EQUAL_DUPLICATES,
+        target = "config/equal-duplicates.properties"
+    )
+    @ProcessorOption(name = "mapstruct.configurationFile", value = "config/equal-duplicates.properties")
+    public void shouldAllowEqualDuplicateProperties() {
+        assertThat( CollectionImplementationMapper.INSTANCE.mapList( Arrays.asList( "one" ) ) )
+            .isInstanceOf( CustomList.class );
+    }
+
+    @ProcessorTest(Compiler.JDK)
+    @WithClasses(ErroneousCollectionMapper.class)
+    @ProcessorOption(name = "mapstruct.configurationFile", value = "missing.properties")
+    @ExpectedCompilationOutcome(
+        value = CompilationResult.FAILED,
+        diagnostics = @Diagnostic(
+            kind = javax.tools.Diagnostic.Kind.ERROR,
+            messageRegExp = "Could not load MapStruct configuration resource 'missing.properties'.*"
+        )
+    )
+    public void shouldFailForMissingExplicitConfigurationFile() {
+    }
+
+    @ProcessorTest(Compiler.JDK)
+    @WithClasses(ErroneousCollectionMapper.class)
+    @WithCompilerResource(
+        value = MISSING_IMPLEMENTATION,
+        target = "config/missing-implementation.properties"
+    )
+    @ProcessorOption(name = "mapstruct.configurationFile", value = "config/missing-implementation.properties")
+    @ExpectedCompilationOutcome(
+        value = CompilationResult.FAILED,
+        diagnostics = @Diagnostic(
+            kind = javax.tools.Diagnostic.Kind.ERROR,
+            messageRegExp = "Invalid value '.*MissingList'.*implementation type could not be found."
+        )
+    )
+    public void shouldFailWhenImplementationNeverBecomesAvailable() {
+    }
+
+    @ProcessorTest(Compiler.JDK)
+    @WithClasses(ErroneousCollectionMapper.class)
+    @WithCompilerResource(
+        value = CONFLICTING_DUPLICATES,
+        target = "config/conflicting-duplicates.properties"
+    )
+    @ProcessorOption(name = "mapstruct.configurationFile", value = "config/conflicting-duplicates.properties")
+    @ExpectedCompilationOutcome(
+        value = CompilationResult.FAILED,
+        diagnostics = @Diagnostic(
+            kind = javax.tools.Diagnostic.Kind.ERROR,
+            messageRegExp = "Invalid MapStruct collection implementation property '.*java.util.List': value "
+                + "'.*CustomMap' conflicts with value '.*CustomList'."
+        )
+    )
+    public void shouldFailForConflictingDuplicates() {
+    }
+
+    @ProcessorTest(Compiler.JDK)
+    @WithClasses({ ErroneousCollectionMapper.class, BoundedList.class })
+    @WithCompilerResource(
+        value = BOUNDED_IMPLEMENTATION,
+        target = "config/bounded.properties"
+    )
+    @ProcessorOption(name = "mapstruct.configurationFile", value = "config/bounded.properties")
+    @ExpectedCompilationOutcome(
+        value = CompilationResult.FAILED,
+        diagnostics = @Diagnostic(
+            kind = javax.tools.Diagnostic.Kind.ERROR,
+            messageRegExp = "Invalid value '.*BoundedList'.*implementation type parameter 'E' is bounded."
+        )
+    )
+    public void shouldFailForBoundedTypeParameter() {
+    }
+
+    @ProcessorTest(Compiler.JDK)
+    @WithClasses({ ErroneousCollectionMapper.class, ReorderedMap.class })
+    @WithCompilerResource(
+        value = REORDERED_IMPLEMENTATION,
+        target = "config/reordered.properties"
+    )
+    @ProcessorOption(name = "mapstruct.configurationFile", value = "config/reordered.properties")
+    @ExpectedCompilationOutcome(
+        value = CompilationResult.FAILED,
