diff --git a/processor/src/test/java/org/mapstruct/ap/test/collectionimplementation/CollectionImplementationResolutionTest.java b/processor/src/test/java/org/mapstruct/ap/test/collectionimplementation/CollectionImplementationResolutionTest.java
new file mode 100644
index 0000000..1a4a6ec
--- /dev/null
+++ b/processor/src/test/java/org/mapstruct/ap/test/collectionimplementation/CollectionImplementationResolutionTest.java
@@ -0,0 +1,156 @@
+/*
+ * Copyright MapStruct Authors.
+ *
+ * Licensed under the Apache License version 2.0, available at http://www.apache.org/licenses/LICENSE-2.0
+ */
+package org.mapstruct.ap.test.collectionimplementation;
+
+import java.io.File;
+import java.io.IOException;
+import java.io.Writer;
+import java.net.URI;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.List;
+import java.util.Set;
+import javax.annotation.processing.AbstractProcessor;
+import javax.annotation.processing.Filer;
+import javax.annotation.processing.RoundEnvironment;
+import javax.lang.model.SourceVersion;
+import javax.lang.model.element.TypeElement;
+import javax.tools.DiagnosticCollector;
+import javax.tools.JavaCompiler;
+import javax.tools.JavaFileObject;
+import javax.tools.SimpleJavaFileObject;
+import javax.tools.StandardJavaFileManager;
+import javax.tools.StandardLocation;
+import javax.tools.ToolProvider;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import org.mapstruct.ap.MappingProcessor;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+public class CollectionImplementationResolutionTest {
+
+    @TempDir
+    Path temporaryDirectory;
+
+    @Test
+    public void shouldResolveImplementationGeneratedInLaterRound() throws Exception {
+        Path classpathResource = temporaryDirectory.resolve( "classpath" );
+        Files.createDirectories( classpathResource );
+        Files.write(
+            classpathResource.resolve( "generated.properties" ),
+            Collections.singletonList(
+                "mapstruct.collectionImplementation.java.util.List=test.GeneratedList"
+            ),
+            StandardCharsets.ISO_8859_1
+        );
+
+        Path classes = temporaryDirectory.resolve( "classes" );
+        Path generatedSources = temporaryDirectory.resolve( "generated-sources" );
+        Files.createDirectories( classes );
+        Files.createDirectories( generatedSources );
+
+        JavaCompiler compiler = ToolProvider.getSystemJavaCompiler();
+        DiagnosticCollector<JavaFileObject> diagnostics = new DiagnosticCollector<>();
+        try ( StandardJavaFileManager fileManager = compiler.getStandardFileManager(
+            diagnostics,
+            null,
+            StandardCharsets.UTF_8
+        ) ) {
+            fileManager.setLocation( StandardLocation.CLASS_PATH, compilerClasspath( classpathResource ) );
+            fileManager.setLocation( StandardLocation.CLASS_OUTPUT, Collections.singletonList( classes.toFile() ) );
+            fileManager.setLocation(
+                StandardLocation.SOURCE_OUTPUT,
+                Collections.singletonList( generatedSources.toFile() )
+            );
+
+            JavaCompiler.CompilationTask task = compiler.getTask(
+                null,
+                fileManager,
+                diagnostics,
+                Collections.singletonList( "-Amapstruct.configurationFile=generated.properties" ),
+                null,
+                Collections.singletonList( mapperSource() )
+            );
+            task.setProcessors( Arrays.asList( new GeneratedListProcessor(), new MappingProcessor() ) );
+
+            assertThat( task.call() )
+                .describedAs( "Compilation diagnostics: %s", diagnostics.getDiagnostics() )
+                .isTrue();
+        }
+
+        assertThat( generatedSources.resolve( "test/GeneratedMapperImpl.java" ) )
+            .content( StandardCharsets.UTF_8 )
+            .contains( "new GeneratedList<>( source.size() )" );
+    }
+
+    private static List<File> compilerClasspath(Path classpathResource) {
+        List<File> classpath = new ArrayList<>();
+        classpath.add( classpathResource.toFile() );
+        for ( String entry : System.getProperty( "java.class.path" ).split( File.pathSeparator ) ) {
+            classpath.add( new File( entry ) );
+        }
+        return classpath;
+    }
+
+    private static JavaFileObject mapperSource() {
+        return new SimpleJavaFileObject( URI.create( "string:///test/GeneratedMapper.java" ),
+            JavaFileObject.Kind.SOURCE ) {
+            @Override
+            public CharSequence getCharContent(boolean ignoreEncodingErrors) {
+                return "package test;\n"
+                    + "import java.util.List;\n"
+                    + "import org.mapstruct.Mapper;\n"
+                    + "@Mapper public interface GeneratedMapper {\n"
+                    + "    List<String> map(List<String> source);\n"
+                    + "}\n";
+            }
+        };
+    }
+
+    private static class GeneratedListProcessor extends AbstractProcessor {
+
+        private boolean generated;
+
+        @Override
+        public Set<String> getSupportedAnnotationTypes() {
+            return Collections.singleton( "*" );
+        }
+
+        @Override
+        public SourceVersion getSupportedSourceVersion() {
+            return SourceVersion.latestSupported();
+        }
+
+        @Override
+        public boolean process(Set<? extends TypeElement> annotations, RoundEnvironment roundEnvironment) {
+            if ( generated || roundEnvironment.processingOver() ) {
+                return false;
+            }
+            generated = true;
+            writeGeneratedList( processingEnv.getFiler() );
+            return false;
+        }
+
+        private static void writeGeneratedList(Filer filer) {
+            try ( Writer writer = filer.createSourceFile( "test.GeneratedList" ).openWriter() ) {
+                writer.write( "package test;\n" );
+                writer.write( "public class GeneratedList<E> extends java.util.ArrayList<E> {\n" );
+                writer.write( "    public GeneratedList() {}\n" );
+                writer.write( "    public GeneratedList(int initialCapacity) { super(initialCapacity); }\n" );
+                writer.write( "}\n" );
+            }
+            catch ( IOException e ) {
+                throw new RuntimeException( e );
+            }
+        }
+    }
+}
