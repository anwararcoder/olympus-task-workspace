+    ET.ElementTree(root).write(output_xml, encoding="utf-8", xml_declaration=True)
+    if base_proc.returncode != 0:
+        raise SystemExit(base_proc.returncode)
+    if new_proc.returncode != 0:
+        raise SystemExit(new_proc.returncode)
