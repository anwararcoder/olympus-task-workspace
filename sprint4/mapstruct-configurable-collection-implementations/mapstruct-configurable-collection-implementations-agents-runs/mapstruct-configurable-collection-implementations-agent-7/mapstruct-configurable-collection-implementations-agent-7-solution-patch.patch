+        }
+        for ( ExecutableElement constructor : constructors ) {
+            if ( constructor.getParameters().isEmpty() && isUsablePublicConstructor( constructor ) ) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private boolean hasUsableIntConstructor(TypeElement implementationElement) {
+        List<ExecutableElement> constructors = ElementFilter.constructorsIn(
+            implementationElement.getEnclosedElements()
+        );
+        for ( ExecutableElement constructor : constructors ) {
+            if ( constructor.getParameters().size() == 1
+                && constructor.getParameters().get( 0 ).asType().getKind() == TypeKind.INT
+                && isUsablePublicConstructor( constructor ) ) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private boolean isUsablePublicConstructor(ExecutableElement constructor) {
+        if ( !constructor.getModifiers().contains( Modifier.PUBLIC ) ) {
+            return false;
+        }
+        TypeMirror runtimeExceptionType = elementUtils.getTypeElement(
+            RuntimeException.class.getCanonicalName()
+        ).asType();
+        TypeMirror errorType = elementUtils.getTypeElement( Error.class.getCanonicalName() ).asType();
+        for ( TypeMirror thrownType : constructor.getThrownTypes() ) {
+            if ( !typeUtils.isAssignable( thrownType, runtimeExceptionType )
+                && !typeUtils.isAssignable( thrownType, errorType ) ) {
+                return false;
+            }
+        }
+        return true;
+    }
