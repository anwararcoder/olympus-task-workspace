+/*
+ * Copyright MapStruct Authors.
+ *
+ * Licensed under the Apache License version 2.0, available at http://www.apache.org/licenses/LICENSE-2.0
+ */
+package org.mapstruct.ap.test.collection.configurableimplementation;
+
+import java.util.Arrays;
+import java.util.List;
+import java.util.stream.Stream;
+
+import org.mapstruct.ap.testutil.ProcessorTest;
+import org.mapstruct.ap.testutil.WithClasses;
+import org.mapstruct.ap.testutil.WithTestDependency;
+import org.mapstruct.ap.testutil.compilation.annotation.ProcessorOption;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+@WithClasses({
+    ConfiguredCollectionMapper.class,
+    FactoryCollectionMapper.class,
+    CustomList.class,
+    Source.class,
+    Target.class
+})
+@ProcessorOption(
+    name = "mapstruct.configurationFile",
+    value = "collection-implementations/custom.properties"
+)
+@WithTestDependency("processor/target/test-classes")
+public class ConfigurableCollectionImplementationTest {
+
+    @ProcessorTest
+    public void shouldUseConfiguredImplementationAndInitialCapacity() {
+        List<String> result = ConfiguredCollectionMapper.INSTANCE.map( Arrays.asList( "one", "two" ) );
+
+        assertThat( result ).isInstanceOf( CustomList.class );
+        assertThat( ( (CustomList<?>) result ).getInitialCapacity() ).isEqualTo( 2 );
+    }
+
+    @ProcessorTest
+    public void shouldUseConfiguredImplementationForDirectBeanPropertyCopy() {
+        Source source = new Source();
+        source.setValues( Arrays.asList( "one", "two", "three" ) );
+
+        Target result = ConfiguredCollectionMapper.INSTANCE.map( source );
+
+        assertThat( result.getValues() ).isInstanceOf( CustomList.class );
+        assertThat( ( (CustomList<?>) result.getValues() ).getInitialCapacity() ).isEqualTo( 3 );
+    }
+
+    @ProcessorTest
+    public void shouldUseConfiguredImplementationForStreamResult() {
+        List<String> result = ConfiguredCollectionMapper.INSTANCE.map( Stream.of( "one", "two" ) );
+
+        assertThat( result ).isInstanceOf( CustomList.class );
+        assertThat( result ).containsExactly( "one", "two" );
+    }
+
+    @ProcessorTest
+    public void shouldPreferObjectFactoryForStreamResult() {
+        List<String> result = FactoryCollectionMapper.INSTANCE.map( Stream.of( "one" ) );
+
+        assertThat( result ).isInstanceOf( CustomList.class );
+        assertThat( ( (CustomList<?>) result ).isFactoryCreated() ).isTrue();
+    }
+}
