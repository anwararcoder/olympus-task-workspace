+    private String getInvalidImplementationCause(String interfaceName, TypeElement implementationElement) {
+        if ( implementationElement.getKind() != ElementKind.CLASS
+            || implementationElement.getModifiers().contains( Modifier.ABSTRACT ) ) {
+            return "the value must name a concrete class";
+        }
+        if ( !isPubliclyAccessible( implementationElement ) ) {
+            return "the class must be publicly accessible";
+        }
+        if ( implementationElement.getNestingKind() != NestingKind.TOP_LEVEL
+            && !implementationElement.getModifiers().contains( Modifier.STATIC ) ) {
+            return "a nested implementation class must be static";
+        }
+
