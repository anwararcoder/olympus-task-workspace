+        if ( interfaceElement == null ) {
+            return "the configured interface is not available for this compilation";
+        }
+
+        List<? extends TypeParameterElement> interfaceParameters = interfaceElement.getTypeParameters();
+        List<? extends TypeParameterElement> implementationParameters = implementationElement.getTypeParameters();
+        if ( implementationParameters.size() != interfaceParameters.size() ) {
+            return "the class must declare the same number of type parameters as " + interfaceName;
+        }
+        for ( TypeParameterElement parameter : implementationParameters ) {
+            if ( !isUnbounded( parameter ) ) {
+                return "all implementation type parameters must be unbounded";
+            }
+        }
+
+        TypeMirror[] typeArguments = new TypeMirror[interfaceParameters.size()];
+        for ( int i = 0; i < interfaceParameters.size(); i++ ) {
+            typeArguments[i] = interfaceParameters.get( i ).asType();
+        }
+        DeclaredType implementationType = typeUtils.getDeclaredType( implementationElement, typeArguments );
+        DeclaredType interfaceType = typeUtils.getDeclaredType( interfaceElement, typeArguments );
+        if ( !typeUtils.isAssignable( implementationType, interfaceType ) ) {
+            return "the class must be assignable to " + interfaceName + " while preserving its type parameters";
+        }
