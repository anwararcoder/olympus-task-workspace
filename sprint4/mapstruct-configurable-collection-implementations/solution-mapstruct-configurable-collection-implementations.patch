+package org.mapstruct.ap.internal.option;
+
+/**
+ * A validated collection implementation and the constructor shape available to generated mappings.
+ */
+public final class ConfiguredImplementationType {
+
+    private final String name;
+    private final boolean initialCapacityConstructor;
+
+    ConfiguredImplementationType(String name, boolean initialCapacityConstructor) {
+        this.name = name;
+        this.initialCapacityConstructor = initialCapacityConstructor;
+    }
+
+    public String getName() {
+        return name;
+    }
+
+    public boolean hasInitialCapacityConstructor() {
+        return initialCapacityConstructor;
+    }
+}
