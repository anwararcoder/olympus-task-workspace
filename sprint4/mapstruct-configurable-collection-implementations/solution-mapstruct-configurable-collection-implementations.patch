index 00000000..5e7856a8
--- /dev/null
+++ b/processor/src/main/java/org/mapstruct/ap/internal/option/CollectionImplementationConfiguration.java
@@ -0,0 +1,418 @@
+/*
+ * Copyright MapStruct Authors.
+ *
+ * Licensed under the Apache License version 2.0, available at http://www.apache.org/licenses/LICENSE-2.0
+ */
+package org.mapstruct.ap.internal.option;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Properties;
+import java.util.Set;
+import java.util.TreeMap;
+import java.util.TreeSet;
+import java.util.concurrent.ConcurrentMap;
+import java.util.concurrent.ConcurrentNavigableMap;
+import javax.annotation.processing.Filer;
+import javax.annotation.processing.Messager;
+import javax.lang.model.element.Element;
+import javax.lang.model.element.ElementKind;
+import javax.lang.model.element.ExecutableElement;
+import javax.lang.model.element.Modifier;
+import javax.lang.model.element.NestingKind;
+import javax.lang.model.element.TypeElement;
+import javax.lang.model.element.TypeParameterElement;
+import javax.lang.model.type.DeclaredType;
+import javax.lang.model.type.TypeKind;
+import javax.lang.model.type.TypeMirror;
+import javax.lang.model.util.ElementFilter;
+import javax.lang.model.util.Elements;
+import javax.lang.model.util.Types;
+import javax.tools.FileObject;
+import javax.tools.StandardLocation;
+
+import static javax.tools.Diagnostic.Kind.ERROR;
+
+/**
+ * The configured implementation types used when MapStruct creates collection and map interfaces.
+ */
+public final class CollectionImplementationConfiguration {
+
+    private static final String DEFAULT_RESOURCE = "mapstruct.properties";
+    private static final String PROPERTY_PREFIX = "mapstruct.collectionImplementation.";
+    private static final Map<String, Integer> SUPPORTED_INTERFACES = supportedInterfaces();
+
+    private final Map<String, String> configuredTypes;
+    private final List<String> problems;
+
+    private Map<String, ConfiguredImplementationType> resolvedTypes;
+    private boolean resolutionAttempted;
+
+    private CollectionImplementationConfiguration(Map<String, String> configuredTypes, List<String> problems) {
+        this.configuredTypes = configuredTypes;
+        this.problems = problems;
+    }
+
+    public static CollectionImplementationConfiguration load(Filer filer, String selectedResource) {
+        String resourceName = selectedResource == null ? DEFAULT_RESOURCE : selectedResource.trim();
+        boolean required = selectedResource != null;
+        List<String> problems = new ArrayList<>();
+
+        if ( resourceName.isEmpty() ) {
+            problems.add( "MapStruct configuration resource name must not be empty" );
+            return new CollectionImplementationConfiguration( Collections.emptyMap(), problems );
+        }
+        DuplicateDetectingProperties properties = new DuplicateDetectingProperties();
+        try {
+            FileObject resource = filer.getResource( StandardLocation.CLASS_PATH, "", resourceName );
+            try ( InputStream inputStream = resource.openInputStream() ) {
+                properties.load( inputStream );
+            }
+        }
+        catch ( IOException e ) {
+            if ( required ) {
+                problems.add( "MapStruct configuration resource '" + resourceName + "' was not found" );
+            }
+            return new CollectionImplementationConfiguration( Collections.emptyMap(), problems );
+        }
+        catch ( IllegalArgumentException e ) {
+            problems.add(
+                "MapStruct configuration resource '" + resourceName + "' could not be read: " + e.getMessage()
+            );
+            return new CollectionImplementationConfiguration( Collections.emptyMap(), problems );
+        }
+
+        addDuplicateProblems( properties, problems );
+        Map<String, String> configuredTypes = extractConfiguredTypes( properties, problems );
+        return new CollectionImplementationConfiguration( configuredTypes, problems );
+    }
+
+    public Map<String, ConfiguredImplementationType> resolve(Elements elementUtils, Types typeUtils, Messager messager,
+                                                             Element diagnosticElement) {
+        if ( resolutionAttempted ) {
+            return resolvedTypes;
+        }
+
+        resolutionAttempted = true;
+        Map<String, ConfiguredImplementationType> validatedTypes = new LinkedHashMap<>();
+        for ( Map.Entry<String, String> configuredType : configuredTypes.entrySet() ) {
+            validate(
+                configuredType.getKey(),
+                configuredType.getValue(),
+                elementUtils,
+                typeUtils,
+                validatedTypes
+            );
+        }
+
+        if ( !problems.isEmpty() ) {
+            for ( String problem : problems ) {
+                messager.printMessage( ERROR, problem, diagnosticElement );
+            }
+            resolvedTypes = null;
+        }
+        else {
+            resolvedTypes = Collections.unmodifiableMap( validatedTypes );
+        }
+        return resolvedTypes;
+    }
+
+    public String findUnavailableImplementation(Elements elementUtils) {
+        if ( !problems.isEmpty() ) {
+            return null;
+        }
+
+        for ( String implementationName : configuredTypes.values() ) {
+            if ( elementUtils.getTypeElement( implementationName ) == null ) {
+                return implementationName;
+            }
+        }
+        return null;
+    }
+
+    private void validate(String interfaceName, String implementationName, Elements elementUtils, Types typeUtils,
+                          Map<String, ConfiguredImplementationType> validatedTypes) {
+        TypeElement interfaceElement = elementUtils.getTypeElement( interfaceName );
+        if ( interfaceElement == null ) {
+            problems.add(
+                "MapStruct configured collection interface '" + interfaceName + "' is not available for compilation"
+            );
+            return;
+        }
+
+        TypeElement implementationElement = elementUtils.getTypeElement( implementationName );
+        if ( implementationElement == null ) {
+            problems.add( "MapStruct implementation type '" + implementationName + "' was not found" );
+            return;
+        }
+
+        if ( !isConcreteClass( implementationElement ) ) {
+            problems.add( "MapStruct implementation type '" + implementationName + "' must be a concrete class" );
+            return;
+        }
+
+        if ( !isPubliclyAccessible( implementationElement ) ) {
+            problems.add( "MapStruct implementation type '" + implementationName + "' must be publicly accessible" );
+            return;
+        }
+
+        if ( !typeUtils.isAssignable(
+            typeUtils.erasure( implementationElement.asType() ),
+            typeUtils.erasure( interfaceElement.asType() )
+        ) ) {
+            problems.add(
+                "MapStruct implementation type '" + implementationName + "' is not assignable to '" +
+                    interfaceName + "'"
+            );
+            return;
+        }
+
+        int expectedTypeParameters = SUPPORTED_INTERFACES.get( interfaceName );
+        int actualTypeParameters = implementationElement.getTypeParameters().size();
+        if ( actualTypeParameters != expectedTypeParameters ) {
+            problems.add(
+                "MapStruct implementation type '" + implementationName + "' has " + actualTypeParameters +
+                    " type parameters, but '" + interfaceName + "' has " + expectedTypeParameters
+            );
+            return;
+        }
+
+        if ( !hasUnrestrictedTypeParameters( implementationElement, elementUtils, typeUtils ) ) {
+            problems.add(
+                "MapStruct implementation type '" + implementationName + "' must have unbounded type parameters"
+            );
+            return;
+        }
+
+        if ( !hasCompatibleGenericShape( implementationElement, interfaceElement, typeUtils ) ) {
+            problems.add(
+                "MapStruct implementation type '" + implementationName +
+                    "' does not preserve the type parameters of '" + interfaceName + "'"
+            );
+            return;
+        }
+
+        if ( !hasAccessibleNoArgConstructor( implementationElement, elementUtils, typeUtils ) ) {
+            problems.add(
+                "MapStruct implementation type '" + implementationName +
+                    "' must have an accessible no-arg constructor that does not declare checked exceptions"
+            );
+            return;
+        }
+
+        validatedTypes.put(
+            interfaceName,
+            new ConfiguredImplementationType(
+                implementationName,
+                hasAccessibleInitialCapacityConstructor( implementationElement, elementUtils, typeUtils )
+            )
+        );
+    }
+
+    private static Map<String, String> extractConfiguredTypes(Properties properties, List<String> problems) {
+        Map<String, String> configuredTypes = new LinkedHashMap<>();
+        Set<String> propertyNames = new TreeSet<>( properties.stringPropertyNames() );
+
+        for ( String propertyName : propertyNames ) {
+            if ( !propertyName.startsWith( PROPERTY_PREFIX ) ) {
+                problems.add( "MapStruct configuration contains unknown property '" + propertyName + "'" );
+                continue;
+            }
+
+            String interfaceName = propertyName.substring( PROPERTY_PREFIX.length() );
+            if ( !SUPPORTED_INTERFACES.containsKey( interfaceName ) ) {
+                problems.add(
+                    "MapStruct configuration contains unsupported collection interface '" + interfaceName + "'"
+                );
+                continue;
+            }
+
+            String implementationName = properties.getProperty( propertyName ).trim();
+            if ( implementationName.isEmpty() ) {
+                problems.add( "MapStruct implementation type for '" + interfaceName + "' must not be empty" );
+                continue;
+            }
+
+            configuredTypes.put( interfaceName, implementationName );
+        }
+        return configuredTypes;
+    }
+
+    private static void addDuplicateProblems(DuplicateDetectingProperties properties, List<String> problems) {
+        for ( Map.Entry<String, String> conflict : properties.getConflicts().entrySet() ) {
+            problems.add(
+                "MapStruct configuration contains conflicting values for '" + conflict.getKey() + "': " +
+                    conflict.getValue()
+            );
+        }
+    }
+
+    private static boolean isConcreteClass(TypeElement type) {
+        return type.getKind() == ElementKind.CLASS && !type.getModifiers().contains( Modifier.ABSTRACT );
+    }
+
+    private static boolean isPubliclyAccessible(TypeElement type) {
+        Element current = type;
+        while ( current instanceof TypeElement ) {
+            TypeElement currentType = (TypeElement) current;
+            if ( !currentType.getModifiers().contains( Modifier.PUBLIC ) ) {
+                return false;
+            }
+            if ( currentType.getNestingKind() == NestingKind.MEMBER &&
+                !currentType.getModifiers().contains( Modifier.STATIC ) ) {
+                return false;
+            }
+            current = currentType.getEnclosingElement();
+        }
+        return true;
+    }
+
+    private static boolean hasCompatibleGenericShape(TypeElement implementationType, TypeElement interfaceType,
+                                                     Types typeUtils) {
+        List<? extends TypeParameterElement> typeParameters = implementationType.getTypeParameters();
+        TypeMirror[] typeArguments = new TypeMirror[typeParameters.size()];
+        for ( int i = 0; i < typeParameters.size(); i++ ) {
+            typeArguments[i] = typeParameters.get( i ).asType();
+        }
+
+        DeclaredType declaredImplementation = typeUtils.getDeclaredType( implementationType, typeArguments );
+        DeclaredType interfaceView = findDeclaredSupertype( declaredImplementation, interfaceType, typeUtils );
+        if ( interfaceView == null || interfaceView.getTypeArguments().size() != typeParameters.size() ) {
+            return false;
+        }
+
+        for ( int i = 0; i < typeParameters.size(); i++ ) {
+            if ( !typeUtils.isSameType(
+                interfaceView.getTypeArguments().get( i ),
+                typeParameters.get( i ).asType()
+            ) ) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private static boolean hasUnrestrictedTypeParameters(TypeElement implementationType, Elements elementUtils,
+                                                         Types typeUtils) {
+        TypeMirror objectType = elementUtils.getTypeElement( Object.class.getName() ).asType();
+        for ( TypeParameterElement typeParameter : implementationType.getTypeParameters() ) {
+            List<? extends TypeMirror> bounds = typeParameter.getBounds();
+            if ( bounds.size() != 1 || !typeUtils.isSameType( bounds.get( 0 ), objectType ) ) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private static DeclaredType findDeclaredSupertype(TypeMirror currentType, TypeElement searchedType,
+                                                      Types typeUtils) {
+        if ( currentType.getKind() != TypeKind.DECLARED ) {
+            return null;
+        }
+
+        DeclaredType declaredType = (DeclaredType) currentType;
+        if ( typeUtils.isSameType( typeUtils.erasure( declaredType ), typeUtils.erasure( searchedType.asType() ) ) ) {
+            return declaredType;
+        }
+
+        for ( TypeMirror supertype : typeUtils.directSupertypes( declaredType ) ) {
+            DeclaredType match = findDeclaredSupertype( supertype, searchedType, typeUtils );
+            if ( match != null ) {
+                return match;
+            }
+        }
+        return null;
+    }
+
+    private static boolean hasAccessibleNoArgConstructor(TypeElement type, Elements elementUtils, Types typeUtils) {
+        List<ExecutableElement> constructors = ElementFilter.constructorsIn( type.getEnclosedElements() );
+        if ( constructors.isEmpty() ) {
+            return true;
+        }
+        for ( ExecutableElement constructor : constructors ) {
+            if ( constructor.getParameters().isEmpty() && constructor.getModifiers().contains( Modifier.PUBLIC ) &&
+                hasNoCheckedExceptions( constructor, elementUtils, typeUtils ) ) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private static boolean hasAccessibleInitialCapacityConstructor(TypeElement type, Elements elementUtils,
+                                                                   Types typeUtils) {
+        for ( ExecutableElement constructor : ElementFilter.constructorsIn( type.getEnclosedElements() ) ) {
+            if ( constructor.getParameters().size() == 1 &&
+                constructor.getParameters().get( 0 ).asType().getKind() == TypeKind.INT &&
+                constructor.getModifiers().contains( Modifier.PUBLIC ) &&
+                hasNoCheckedExceptions( constructor, elementUtils, typeUtils ) ) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private static boolean hasNoCheckedExceptions(ExecutableElement constructor, Elements elementUtils,
+                                                  Types typeUtils) {
+        TypeMirror runtimeExceptionType = elementUtils.getTypeElement( RuntimeException.class.getName() ).asType();
+        TypeMirror errorType = elementUtils.getTypeElement( Error.class.getName() ).asType();
+        for ( TypeMirror thrownType : constructor.getThrownTypes() ) {
+            if ( !typeUtils.isSubtype( thrownType, runtimeExceptionType ) &&
+                !typeUtils.isSubtype( thrownType, errorType ) ) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private static Map<String, Integer> supportedInterfaces() {
+        Map<String, Integer> interfaces = new LinkedHashMap<>();
+        interfaces.put( Iterable.class.getName(), 1 );
+        interfaces.put( java.util.Collection.class.getName(), 1 );
+        interfaces.put( java.util.List.class.getName(), 1 );
+        interfaces.put( java.util.Set.class.getName(), 1 );
+        interfaces.put( java.util.SortedSet.class.getName(), 1 );
+        interfaces.put( java.util.NavigableSet.class.getName(), 1 );
+        interfaces.put( java.util.Map.class.getName(), 2 );
+        interfaces.put( java.util.SortedMap.class.getName(), 2 );
+        interfaces.put( java.util.NavigableMap.class.getName(), 2 );
+        interfaces.put( ConcurrentMap.class.getName(), 2 );
+        interfaces.put( ConcurrentNavigableMap.class.getName(), 2 );
+        interfaces.put( "java.util.SequencedSet", 1 );
+        interfaces.put( "java.util.SequencedMap", 2 );
+        return Collections.unmodifiableMap( interfaces );
+    }
+
+    private static final class DuplicateDetectingProperties extends Properties {
+
+        private final Map<String, Set<String>> conflicts = new TreeMap<>();
+
+        @Override
+        public synchronized Object put(Object key, Object value) {
+            String normalizedValue = value.toString().trim();
+            Object previous = super.put( key, normalizedValue );
+            if ( previous != null && !previous.equals( normalizedValue ) ) {
+                Set<String> values = conflicts.get( key.toString() );
+                if ( values == null ) {
+                    values = new TreeSet<>();
+                    conflicts.put( key.toString(), values );
+                }
+                values.add( previous.toString() );
+                values.add( normalizedValue );
+            }
+            return previous;
+        }
+
+        Map<String, String> getConflicts() {
+            Map<String, String> formattedConflicts = new TreeMap<>();
+            for ( Map.Entry<String, Set<String>> conflict : conflicts.entrySet() ) {
+                formattedConflicts.put( conflict.getKey(), String.join( " and ", conflict.getValue() ) );
+            }
+            return formattedConflicts;
+        }
+    }
+}
