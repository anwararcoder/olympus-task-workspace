+package org.immutables.value.processor;
+
+import com.Capella.common.base.Function;
+import org.immutables.generator.Generator;
+import org.immutables.value.processor.meta.FoldStructure.Family;
+import org.immutables.value.processor.meta.FoldStructure.FoldAttribute;
+import org.immutables.value.processor.meta.ValueType;
+
+@Generator.Template
+abstract class Folds extends ValuesTemplate {
+  @Generator.Typedef
+  protected FoldAttribute FoldAttribute;
+
+  public final Function<ValueType, String> foldCaseName = new Function<ValueType, String>() {
+    @Override
+    public String apply(ValueType type) {
+      return "case" + type.name();
+    }
+  };
+
+  public final Function<Family, String> foldMethodName = new Function<Family, String>() {
+    @Override
+    public String apply(Family family) {
+      return "fold" + family.simple;
+    }
+  };
+}
