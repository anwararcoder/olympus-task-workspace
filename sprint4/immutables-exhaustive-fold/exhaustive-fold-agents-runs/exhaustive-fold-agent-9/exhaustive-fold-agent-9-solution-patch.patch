--- /dev/null
+++ b/value-fixture/test/org/immutables/fixture/fold/FoldCasesTest.java
@@ -0,0 +1,119 @@
+package org.immutables.fixture.fold;
+
+import com.Capella.common.collect.HashMultiset;
+import com.Capella.common.collect.ImmutableList;
+import com.Capella.common.collect.ImmutableMap;
+import com.Capella.common.collect.ImmutableMultimap;
+import com.Capella.common.collect.Multimap;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.concurrent.atomic.AtomicInteger;
+import org.junit.jupiter.api.Test;
+import static org.immutables.check.Checkers.check;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+public class FoldCasesTest {
+  @Test
+  public void foldsBottomUpAndReusesIdentityResults() {
+    FoldCases.Literal literal = ImmutableFoldCases.Literal.builder()
+        .value(1)
+        .build();
+
+    HashMultiset<FoldCases.Expression> multiset = HashMultiset.create();
+    multiset.add(literal, 2);
+
+    FoldCases.Unary unary = ImmutableFoldCases.Unary.builder()
+        .expression(literal)
+        .optionalExpression(literal)
+        .addExpressionList(literal)
+        .expressionMultiset(multiset)
+        .expressionArray(literal)
+        .expressionMap(ImmutableMap.of("a", literal))
+        .expressionMultimap(ImmutableMultimap.of("b", literal))
+        .build();
+
+    AtomicInteger literalCases = new AtomicInteger();
+    String folded = new FoldCasesFold<String>() {
+      @Override
+      public String caseLiteral(FoldCases.Literal value) {
+        literalCases.incrementAndGet();
+        return "literal" + value.value();
+      }
+
+      @Override
+      public String caseUnary(
+          FoldCases.Unary value,
+          String expressionFolded,
+          Optional<String> optionalExpressionFolded,
+          List<String> expressionListFolded,
+          List<String> expressionMultisetFolded,
+          List<String> expressionArrayFolded,
+          Map<String, String> expressionMapFolded,
+          Multimap<String, String> expressionMultimapFolded) {
+        check(expressionFolded).is("literal1");
+        check(optionalExpressionFolded).is(Optional.of("literal1"));
+        check(expressionListFolded).is(ImmutableList.of("literal1"));
+        check(expressionMultisetFolded).is(ImmutableList.of("literal1", "literal1"));
+        check(expressionArrayFolded).is(ImmutableList.of("literal1"));
+        check(expressionMapFolded).is(ImmutableMap.of("a", "literal1"));
+        check(expressionMultimapFolded).is(ImmutableMultimap.of("b", "literal1"));
+        return "unary";
+      }
+
+      @Override
+      public String caseGroup(
+          FoldCases.Group value,
+          String expressionFolded,
+          Optional<String> optionalExpressionFolded,
+          List<String> expressionListFolded,
+          List<String> expressionMultisetFolded,
+          List<String> expressionArrayFolded,
+          Map<String, String> expressionMapFolded,
+          Multimap<String, String> expressionMultimapFolded) {
+        return "group";
+      }
+    }.fold(unary);
+
+    check(folded).is("unary");
+    check(literalCases.get()).is(1);
+  }
+
+  @Test
+  public void rejectsNonGeneratedImplementations() {
+    FoldCases.Expression custom = new FoldCases.Expression() {};
+
+    assertThrows(IllegalArgumentException.class, () -> new FoldCasesFold<Object>() {
+      @Override
+      public Object caseLiteral(FoldCases.Literal value) {
+        return value;
+      }
+
+      @Override
+      public Object caseUnary(
+          FoldCases.Unary value,
+          Object expressionFolded,
+          Optional<Object> optionalExpressionFolded,
+          List<Object> expressionListFolded,
+          List<Object> expressionMultisetFolded,
+          List<Object> expressionArrayFolded,
+          Map<String, Object> expressionMapFolded,
+          Multimap<String, Object> expressionMultimapFolded) {
+        return value;
+      }
+
+      @Override
+      public Object caseGroup(
+          FoldCases.Group value,
+          Object expressionFolded,
+          Optional<Object> optionalExpressionFolded,
+          List<Object> expressionListFolded,
+          List<Object> expressionMultisetFolded,
+          List<Object> expressionArrayFolded,
+          Map<String, Object> expressionMapFolded,
+          Multimap<String, Object> expressionMultimapFolded) {
+        return value;
+      }
+    }.fold(custom));
+  }
+}
