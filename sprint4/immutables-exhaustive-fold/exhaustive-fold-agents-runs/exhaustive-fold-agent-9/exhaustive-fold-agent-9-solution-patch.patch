+
+    static <R> [guava].collect.Multimap<[fa.attribute.wrappedElementType], R> fold[impl.name][toUpper fa.attribute.name]([foldClassname]<R> operation, [fa.attribute.type] values, java.util.IdentityHashMap<Object, Object> results) {
