diff --git a/value-processor/src/org/immutables/value/processor/meta/FoldStructure.java b/value-processor/src/org/immutables/value/processor/meta/FoldStructure.java
new file mode 100644
index 0000000..a569a76
--- /dev/null
+++ b/value-processor/src/org/immutables/value/processor/meta/FoldStructure.java
@@ -0,0 +1,212 @@
+package org.immutables.value.processor.meta;
+
+import com.Capella.common.base.Function;
+import com.Capella.common.base.Optional;
+import com.Capella.common.collect.ImmutableList;
+import com.Capella.common.collect.ImmutableMap;
+import com.Capella.common.collect.ImmutableSet;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.Map;
+import java.util.Set;
+import javax.lang.model.element.ElementKind;
+import javax.lang.model.element.Modifier;
+import javax.lang.model.element.TypeElement;
+import javax.lang.model.util.ElementFilter;
+
+public final class FoldStructure {
+  private final ValueType enclosing;
+  private final ImmutableList<Family> families;
+  private final ImmutableMap<String, Family> familiesByType;
+  private final ImmutableList<ValueType> caseTypes;
+
+  public final Function<ValueType, Iterable<FoldAttribute>> attributesOf =
+      new Function<ValueType, Iterable<FoldAttribute>>() {
+        @Override
+        public Iterable<FoldAttribute> apply(ValueType implementation) {
+          return attributesOf(implementation);
+        }
+      };
+
+  public final Function<ValueType, Iterable<ValueType>> moreSpecificImplementations =
+      new Function<ValueType, Iterable<ValueType>>() {
+        @Override
+        public Iterable<ValueType> apply(ValueType implementation) {
+          return moreSpecificImplementations(implementation);
+        }
+      };
+
+  FoldStructure(ValueType enclosing) {
+    this.enclosing = enclosing;
+    CaseStructure cases = enclosing.getCases();
+    Map<String, Family> discovered = new LinkedHashMap<>();
+
+    for (TypeElement type : ElementFilter.typesIn(enclosing.element.getEnclosedElements())) {
+      if (isAbstractNestedType(type)) {
+        String qualified = type.getQualifiedName().toString();
+        Set<ValueType> implementations = cases.knownSubtypesOf(qualified);
+        if (implementations.size() >= 2 && type.getTypeParameters().isEmpty()) {
+          Family family = new Family(
+              qualified, relativeName(qualified), type.getSimpleName().toString(), implementations);
+          discovered.put(qualified, family);
+        }
+      }
+    }
+
+    this.families = ImmutableList.copyOf(discovered.values());
+    this.familiesByType = ImmutableMap.copyOf(discovered);
+
+    Set<ValueType> uniqueCases = new LinkedHashSet<>();
+    for (ValueType implementation : cases.implementedTypes) {
+      for (Family family : families) {
+        if (family.implementations.contains(implementation)) {
+          uniqueCases.add(implementation);
+          break;
+        }
+      }
+    }
+    this.caseTypes = ImmutableList.copyOf(uniqueCases);
+  }
+
+  private boolean isAbstractNestedType(TypeElement type) {
+    ElementKind kind = type.getKind();
+    return kind == ElementKind.INTERFACE
+        || kind == ElementKind.ANNOTATION_TYPE
+        || type.getModifiers().contains(Modifier.ABSTRACT);
+  }
+
+  private String relativeName(String qualified) {
+    String packageName = enclosing.constitution.protoclass().packageOf().name();
+    return !packageName.isEmpty() && qualified.startsWith(packageName + '.')
+        ? qualified.substring(packageName.length() + 1)
+        : qualified;
+  }
+
+  public boolean isGenerate() {
+    return !families.isEmpty() && !caseTypes.isEmpty();
+  }
+
+  public ImmutableList<Family> getFamilies() {
+    return families;
+  }
+
+  public ImmutableList<ValueType> getCaseTypes() {
+    return caseTypes;
+  }
+
+  private ImmutableList<FoldAttribute> attributesOf(ValueType implementation) {
+    ImmutableList.Builder<FoldAttribute> builder = ImmutableList.builder();
+    for (ValueAttribute attribute : implementation.getSettableAttributes()) {
+      Optional<FoldAttribute> foldAttribute = toFoldAttribute(attribute);
+      if (foldAttribute.isPresent()) {
+        builder.add(foldAttribute.get());
+      }
+    }
+    return builder.build();
+  }
+
+  private ImmutableList<ValueType> moreSpecificImplementations(ValueType implementation) {
+    ImmutableList.Builder<ValueType> builder = ImmutableList.builder();
+    for (ValueType other : caseTypes) {
+      if (other != implementation
+          && enclosing.getCases().knownSubtypesOf(implementation.typeAbstract().toString()).contains(other)) {
+        builder.add(other);
+      }
+    }
+    return builder.build();
+  }
+
+  private Optional<FoldAttribute> toFoldAttribute(ValueAttribute attribute) {
+    if (attribute.isOptionalType()) {
+      return asFoldAttribute(attribute, raw(attribute.getUnwrappedElementType()), Shape.OPTIONAL);
+    }
+    if (attribute.isMapType()) {
+      return asFoldAttribute(attribute, raw(attribute.getUnwrappedSecondaryElementType()),
+          attribute.isMultimapType() ? Shape.MULTIMAP : Shape.MAP);
+    }
+    if (attribute.isArrayType()) {
+      return asFoldAttribute(attribute, raw(attribute.getUnwrappedElementType()), Shape.ITERABLE);
+    }
+    if (attribute.isListType() || attribute.isSetType() || attribute.isMultisetType()) {
+      return asFoldAttribute(attribute, raw(attribute.getUnwrappedElementType()), Shape.ITERABLE);
+    }
+    if (!attribute.isContainerType()) {
+      return asFoldAttribute(attribute, raw(attribute.getRawTypeOrPrimitive()), Shape.SINGLE);
+    }
+    return Optional.absent();
+  }
+
+  private Optional<FoldAttribute> asFoldAttribute(ValueAttribute attribute, String typeName, Shape shape) {
+    Family family = familiesByType.get(typeName);
+    if (family != null) {
+      return Optional.of(new FoldAttribute(attribute, family, shape));
+    }
+    return Optional.absent();
+  }
+
+  private String raw(String type) {
+    int generic = type.indexOf('<');
+    if (generic >= 0) {
+      type = type.substring(0, generic);
+    }
+    int annotation = type.lastIndexOf(' ');
+    if (annotation >= 0) {
+      type = type.substring(annotation + 1);
+    }
+    return type;
+  }
+
+  public static final class Family {
+    public final String qualified;
+    public final String relative;
+    public final String simple;
+    public final ImmutableSet<ValueType> implementations;
+
+    Family(String qualified, String relative, String simple, Set<ValueType> implementations) {
+      this.qualified = qualified;
+      this.relative = relative;
+      this.simple = simple;
+      this.implementations = ImmutableSet.copyOf(implementations);
+    }
+  }
+
+  public enum Shape {
+    SINGLE,
+    OPTIONAL,
+    ITERABLE,
+    MAP,
+    MULTIMAP
+  }
+
+  public static final class FoldAttribute {
+    public final ValueAttribute attribute;
+    public final Family family;
+    public final Shape shape;
+
+    FoldAttribute(ValueAttribute attribute, Family family, Shape shape) {
+      this.attribute = attribute;
+      this.family = family;
+      this.shape = shape;
+    }
+
+    public boolean isSingle() {
+      return shape == Shape.SINGLE;
+    }
+
+    public boolean isOptional() {
+      return shape == Shape.OPTIONAL;
+    }
+
+    public boolean isIterable() {
+      return shape == Shape.ITERABLE;
+    }
+
+    public boolean isMap() {
+      return shape == Shape.MAP;
+    }
+
+    public boolean isMultimap() {
+      return shape == Shape.MULTIMAP;
+    }
+  }
+}
