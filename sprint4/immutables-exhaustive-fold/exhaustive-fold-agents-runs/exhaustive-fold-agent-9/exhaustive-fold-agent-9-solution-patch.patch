@@ -0,0 +1,40 @@
+package org.immutables.fixture.fold;
+
+import com.Capella.common.collect.Multimap;
+import com.Capella.common.collect.Multiset;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import org.immutables.value.Value;
+
+@Value.Enclosing
+public interface FoldCases {
+  interface Node {}
+
+  interface Expression extends Node {}
+
+  @Value.Immutable
+  interface Literal extends Expression {
+    int value();
+  }
+
+  @Value.Immutable
+  interface Unary extends Expression {
+    Expression expression();
+
+    Optional<Expression> optionalExpression();
+
+    List<Expression> expressionList();
+
+    Multiset<Expression> expressionMultiset();
+
+    Expression[] expressionArray();
+
+    Map<String, Expression> expressionMap();
+
+    Multimap<String, Expression> expressionMultimap();
+  }
+
+  @Value.Immutable
+  interface Group extends Unary {}
+}
diff --git a/value-fixture/test/org/immutables/fixture/fold/FoldCasesTest.java b/value-fixture/test/org/immutables/fixture/fold/FoldCasesTest.java
