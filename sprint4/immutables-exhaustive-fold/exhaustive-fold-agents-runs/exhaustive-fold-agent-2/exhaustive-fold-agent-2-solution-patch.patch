@@ -0,0 +1,478 @@
+package org.immutables.value.processor.meta;
+
+import com.Capella.common.collect.ImmutableList;
+import com.Capella.common.collect.Lists;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import javax.lang.model.element.ElementKind;
+import javax.lang.model.element.Modifier;
+import javax.lang.model.element.TypeElement;
+import javax.lang.model.util.ElementFilter;
+
+public final class FoldModel {
+  private static final String RESULT = "R";
+
+  private final ValueType enclosing;
+  private final List<Family> families;
+  private final List<ValueType> cases;
+  private final Map<String, Family> familyByName;
+  private final Map<ValueType, List<FoldedAttribute>> attributesByCase;
+
+  private FoldModel(ValueType enclosing) {
+    this.enclosing = enclosing;
+    this.families = discoverFamilies(enclosing);
+    this.familyByName = indexFamilies(families);
+    this.cases = discoverCases();
+    this.attributesByCase = discoverAttributesByCase();
+  }
+
+  public static FoldModel of(ValueType enclosing) {
+    return new FoldModel(enclosing);
+  }
+
+  public boolean hasContent() {
+    return !families.isEmpty();
+  }
+
+  public String getSimple() {
+    return enclosing.typeAbstract().simple() + "Fold";
+  }
+
+  public CharSequence getBody() {
+    StringBuilder out = new StringBuilder();
+    appendCaseMethods(out);
+    appendFoldMethods(out);
+    return out;
+  }
+
+  private List<Family> discoverFamilies(ValueType enclosing) {
+    CaseStructure caseStructure = enclosing.getCases();
+    Map<String, Family> discovered = new LinkedHashMap<>();
+
+    for (TypeElement nested : ElementFilter.typesIn(enclosing.element.getEnclosedElements())) {
+      if (isAbstractNestedType(nested)) {
+        String name = nested.toString();
+        Family family = new Family(
+            name,
+            enclosing.typeAbstract().relativeRaw() + "." + nested.getSimpleName(),
+            nested.getSimpleName().toString());
+        if (knownSubtypesOf(caseStructure, family).size() >= 2 && nested.getTypeParameters().isEmpty()) {
+          putFamily(discovered, family);
+        }
+      }
+    }
+
+    for (ValueType implementation : enclosing.nested) {
+      Family family = new Family(
+          implementation.typeAbstract().toString(),
+          implementation.typeAbstract().relativeRaw(),
+          implementation.typeAbstract().simple());
+      Set<ValueType> subtypes = knownSubtypesOf(caseStructure, family);
+      if (hasOtherSubtype(implementation, subtypes) && implementation.generics().isEmpty()) {
+        putFamily(discovered, family);
+      }
+    }
+
+    return ImmutableList.copyOf(discovered.values());
+  }
+
+  private static boolean isAbstractNestedType(TypeElement element) {
+    return (element.getEnclosingElement().getKind().isClass()
+        || element.getEnclosingElement().getKind().isInterface())
+        && (element.getKind() == ElementKind.INTERFACE
+            || element.getModifiers().contains(Modifier.ABSTRACT));
+  }
+
+  private static boolean hasOtherSubtype(ValueType implementation, Set<ValueType> subtypes) {
+    for (ValueType subtype : subtypes) {
+      if (subtype != implementation) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  private static void putFamily(Map<String, Family> families, Family family) {
+    families.put(family.qualifiedName, family);
+  }
+
+  private static Set<ValueType> knownSubtypesOf(CaseStructure caseStructure, Family family) {
+    Set<ValueType> subtypes = new LinkedHashSet<>();
+    subtypes.addAll(caseStructure.knownSubtypesOf(family.qualifiedName));
+    subtypes.addAll(caseStructure.knownSubtypesOf(family.relativeName));
+    subtypes.addAll(caseStructure.knownSubtypesOf(family.simpleName));
+    return subtypes;
+  }
+
+
+  private static Map<String, Family> indexFamilies(List<Family> families) {
+    Map<String, Family> index = new LinkedHashMap<>();
+    for (Family family : families) {
+      index.put(family.qualifiedName, family);
+      index.put(family.relativeName, family);
+      index.put(family.simpleName, family);
+    }
+    return index;
+  }
+
+  private List<ValueType> discoverCases() {
+    Set<ValueType> unique = new LinkedHashSet<>();
+    CaseStructure caseStructure = enclosing.getCases();
+    for (Family family : families) {
+      unique.addAll(knownSubtypesOf(caseStructure, family));
+    }
+    return ImmutableList.copyOf(unique);
+  }
+
+  private Map<ValueType, List<FoldedAttribute>> discoverAttributesByCase() {
+    Map<ValueType, List<FoldedAttribute>> result = new LinkedHashMap<>();
+    for (ValueType implementation : cases) {
+      ImmutableList.Builder<FoldedAttribute> folded = ImmutableList.builder();
+      for (ValueAttribute attribute : implementation.getImplementedAttributes()) {
+        FoldedAttribute foldedAttribute = foldedAttribute(attribute);
+        if (foldedAttribute != null) {
+          folded.add(foldedAttribute);
+        }
+      }
+      result.put(implementation, folded.build());
+    }
+    return result;
+  }
+
+  private static boolean isSupportedIterableShape(ValueAttribute attribute) {
+    return attribute.isArrayType()
+        || attribute.isListType()
+        || attribute.isSetType()
+        || attribute.isSortedSetType()
+        || attribute.isGenerateEnumSet()
+        || attribute.isMultisetType();
+  }
+
+  private FoldedAttribute foldedAttribute(ValueAttribute attribute) {
+    if (attribute.isOptionalType() && !attribute.isJdkSpecializedOptional()) {
+      Family family = familyFor(attribute.getElementType());
+      if (family != null) {
+        return new FoldedAttribute(attribute, family, Shape.OPTIONAL);
+      }
+    } else if (attribute.isMapType()) {
+      Family family = familyFor(attribute.getSecondaryElementType());
+      if (family != null) {
+        return new FoldedAttribute(attribute, family, Shape.MAP);
+      }
+    } else if (attribute.isMultimapType()) {
+      Family family = familyFor(attribute.getSecondaryElementType());
+      if (family != null) {
+        return new FoldedAttribute(attribute, family, Shape.MULTIMAP);
+      }
+    } else if (isSupportedIterableShape(attribute)) {
+      Family family = familyFor(attribute.getElementType());
+      if (family != null) {
+        return new FoldedAttribute(attribute, family, Shape.ITERABLE);
+      }
+    } else {
+      Family family = familyFor(attribute.getType());
+      if (family != null) {
+        return new FoldedAttribute(attribute, family, Shape.PLAIN);
+      }
+    }
+    return null;
+  }
+
+  private Family familyFor(String type) {
+    return familyByName.get(normalize(type));
+  }
+
+  private static String normalize(String type) {
+    String normalized = type.trim();
+    while (normalized.startsWith("? extends ")) {
+      normalized = normalized.substring("? extends ".length()).trim();
+    }
+    while (normalized.startsWith("? super ")) {
+      normalized = normalized.substring("? super ".length()).trim();
+    }
+    int generic = normalized.indexOf('<');
+    if (generic >= 0) {
+      normalized = normalized.substring(0, generic).trim();
+    }
+    int lastSpace = normalized.lastIndexOf(' ');
+    if (lastSpace >= 0) {
+      normalized = normalized.substring(lastSpace + 1).trim();
+    }
+    return normalized;
+  }
+
+  private void appendCaseMethods(StringBuilder out) {
+    for (ValueType implementation : cases) {
+      out.append("\n  ").append(RESULT).append(" case")
+          .append(implementation.typeAbstract().simple())
+          .append('(')
+          .append(implementation.typeAbstract().relativeRaw())
+          .append(" value");
+      for (FoldedAttribute attribute : attributesByCase.get(implementation)) {
+        out.append(", ").append(attribute.parameterType()).append(' ').append(attribute.parameterName());
+      }
+      out.append(");\n");
+    }
+  }
+
+  private void appendFoldMethods(StringBuilder out) {
+    for (Family family : families) {
+      out.append("\n  default ").append(RESULT).append(" fold(")
+          .append(family.relativeName).append(" value) {\n")
+          .append("    final java.util.IdentityHashMap<java.lang.Object, ").append(RESULT)
+          .append("> seen = new java.util.IdentityHashMap<>();\n")
+          .append("    class Folder {\n");
+      appendFolderMethods(out);
+      out.append("    }\n")
+          .append("    return new Folder().fold").append(family.simpleName)
+          .append("(value);\n")
+          .append("  }\n");
+    }
+  }
+
+  private void appendFolderMethods(StringBuilder out) {
+    for (Family family : families) {
+      out.append("      ").append(RESULT).append(" fold")
+          .append(family.simpleName).append('(').append(family.relativeName)
+          .append(" value) {\n")
+          .append("        java.util.Objects.requireNonNull(value, \"value\");\n")
+          .append("        if (seen.containsKey(value)) {\n")
+          .append("          return seen.get(value);\n")
+          .append("        }\n");
+
+      List<ValueType> dispatchCases = Lists.newArrayList(knownSubtypesOf(enclosing.getCases(), family));
+      Collections.sort(dispatchCases, mostSpecificFirst());
+      for (ValueType implementation : dispatchCases) {
+        appendDispatchCase(out, implementation);
+      }
+      out.append("        throw new IllegalArgumentException(\"Unsupported ")
+          .append(family.relativeName)
+          .append(" implementation: \" + value.getClass().getName());\n")
+          .append("      }\n");
+    }
+  }
+
+  private Comparator<ValueType> mostSpecificFirst() {
+    return new Comparator<ValueType>() {
+      @Override
+      public int compare(ValueType left, ValueType right) {
+        if (isSubtypeOf(left, right)) {
+          return -1;
+        }
+        if (isSubtypeOf(right, left)) {
+          return 1;
+        }
+        return cases.indexOf(left) - cases.indexOf(right);
+      }
+    };
+  }
+
+  private static boolean isSubtypeOf(ValueType possibleSubtype, ValueType possibleSupertype) {
+    if (possibleSubtype == possibleSupertype) {
+      return false;
+    }
+    String supertypeName = possibleSupertype.typeAbstract().toString();
+    return possibleSubtype.getExtendedClassesNames().contains(supertypeName)
+        || possibleSubtype.getImplementedInterfacesNames().contains(supertypeName);
+  }
+
+  private void appendDispatchCase(StringBuilder out, ValueType implementation) {
+    String local = "_" + implementation.typeAbstract().simple();
+    out.append("        if (value instanceof ").append(implementation.typeImmutable().relativeRaw()).append(") {\n")
+        .append("          ").append(implementation.typeAbstract().relativeRaw()).append(' ')
+        .append(local).append(" = (").append(implementation.typeAbstract().relativeRaw()).append(") value;\n");
+    for (FoldedAttribute attribute : attributesByCase.get(implementation)) {
+      appendFoldAttribute(out, attribute, local);
+    }
+    out.append("          ").append(RESULT).append(" result = case")
+        .append(implementation.typeAbstract().simple()).append('(').append(local);
+    for (FoldedAttribute attribute : attributesByCase.get(implementation)) {
+      out.append(", ").append(attribute.parameterName());
+    }
+    out.append(");\n")
+        .append("          seen.put(value, result);\n")
+        .append("          return result;\n")
+        .append("        }\n");
+  }
+
+  private void appendFoldAttribute(StringBuilder out, FoldedAttribute folded, String value) {
+    ValueAttribute attribute = folded.attribute;
+    String expression = value + "." + attribute.names.get + "()";
+    String parameter = folded.parameterName();
+    switch (folded.shape) {
+    case PLAIN:
+      out.append("          ").append(RESULT).append(' ').append(parameter).append(" = ");
+      if (attribute.isNullable()) {
+        out.append(expression).append(" == null ? null : ");
+      }
+      out.append("fold").append(folded.family.simpleName).append('(').append(expression).append(");\n");
+      break;
+    case OPTIONAL:
+      appendOptionalAttribute(out, folded, expression, parameter);
+      break;
+    case ITERABLE:
+      appendIterableAttribute(out, folded, expression, parameter);
+      break;
+    case MAP:
+      appendMapAttribute(out, folded, expression, parameter);
+      break;
+    case MULTIMAP:
+      appendMultimapAttribute(out, folded, expression, parameter);
+      break;
+    default:
+      throw new AssertionError(folded.shape);
+    }
+  }
+
+  private void appendOptionalAttribute(StringBuilder out, FoldedAttribute folded, String expression, String parameter) {
+    ValueAttribute attribute = folded.attribute;
+    String present = attribute.isFugueOptional() || attribute.isJavaslangOptional()
+        ? ".isDefined()"
+        : ".isPresent()";
+    String empty = attribute.isJdkOptional()
+        ? ".empty()"
+        : attribute.isFugueOptional() || attribute.isJavaslangOptional()
+            ? ".none()"
+            : ".absent()";
+    String of = attribute.isFugueOptional() || attribute.isJavaslangOptional()
+        ? ".some"
+        : ".of";
+    out.append("          ").append(attribute.getRawType()).append('<').append(RESULT).append("> ")
+        .append(parameter).append(" = ");
+    if (attribute.isNullable()) {
+      out.append(expression).append(" == null ? null : ");
+    }
+    out.append(expression).append(present)
+        .append(" ? ").append(attribute.getRawType()).append(of).append("(fold")
+        .append(folded.family.simpleName).append('(').append(expression).append(".get()))")
+        .append(" : ").append(attribute.getRawType()).append(empty).append(";\n");
+  }
+
+  private void appendIterableAttribute(StringBuilder out, FoldedAttribute folded, String expression, String parameter) {
+    ValueAttribute attribute = folded.attribute;
+    out.append("          java.util.List<").append(RESULT).append("> ").append(parameter).append(";");
+    if (attribute.isNullable()) {
+      out.append("\n          if (").append(expression).append(" == null) {\n")
+          .append("            ").append(parameter).append(" = null;\n")
+          .append("          } else {\n")
+          .append("  ");
+    } else {
+      out.append('\n');
+    }
+    out.append("          ").append(parameter).append(" = new java.util.ArrayList<>();\n");
+    out.append("          for (").append(folded.family.relativeName).append(" element : ").append(expression).append(") {\n")
+        .append("            ").append(parameter).append(".add(fold").append(folded.family.simpleName).append("(element));\n")
+        .append("          }\n");
+    if (attribute.isNullable()) {
+      out.append("          }\n");
+    }
+  }
+
+  private void appendMapAttribute(StringBuilder out, FoldedAttribute folded, String expression, String parameter) {
+    ValueAttribute attribute = folded.attribute;
+    String keyType = attribute.firstTypeParameter();
+    out.append("          java.util.Map<").append(keyType).append(", ").append(RESULT).append("> ")
+        .append(parameter).append(";");
+    if (attribute.isNullable()) {
+      out.append("\n          if (").append(expression).append(" == null) {\n")
+          .append("            ").append(parameter).append(" = null;\n")
+          .append("          } else {\n")
+          .append("  ");
+    } else {
+      out.append('\n');
+    }
+    out.append("          ").append(parameter).append(" = new java.util.LinkedHashMap<>();\n")
+        .append("          for (java.util.Map.Entry<").append(keyType).append(", ")
+        .append(folded.family.relativeName).append("> entry : ").append(expression).append(".entrySet()) {\n")
+        .append("            ").append(parameter).append(".put(entry.getKey(), fold")
+        .append(folded.family.simpleName).append("(entry.getValue()));\n")
+        .append("          }\n");
+    if (attribute.isNullable()) {
+      out.append("          }\n");
+    }
+  }
+
+  private void appendMultimapAttribute(StringBuilder out, FoldedAttribute folded, String expression, String parameter) {
+    ValueAttribute attribute = folded.attribute;
+    String keyType = attribute.firstTypeParameter();
+    out.append("          com.Capella.common.collect.ImmutableListMultimap<").append(keyType).append(", ")
+        .append(RESULT).append("> ").append(parameter).append(";");
+    if (attribute.isNullable()) {
+      out.append("\n          if (").append(expression).append(" == null) {\n")
+          .append("            ").append(parameter).append(" = null;\n")
+          .append("          } else {\n")
+          .append("  ");
+    } else {
+      out.append('\n');
+    }
+    out.append("          com.Capella.common.collect.ImmutableListMultimap.Builder<")
+        .append(keyType).append(", ").append(RESULT).append("> ").append(parameter).append("Builder = com.Capella.common.collect.ImmutableListMultimap.builder();\n")
+        .append("          for (java.util.Map.Entry<").append(keyType).append(", ")
+        .append(folded.family.relativeName).append("> entry : ").append(expression).append(".entries()) {\n")
+        .append("            ").append(parameter).append("Builder.put(entry.getKey(), fold")
+        .append(folded.family.simpleName).append("(entry.getValue()));\n")
+        .append("          }\n")
+        .append("          ").append(parameter).append(" = ").append(parameter).append("Builder.build();\n");
+    if (attribute.isNullable()) {
+      out.append("          }\n");
+    }
+  }
+
+  private static final class Family {
+    final String qualifiedName;
+    final String relativeName;
+    final String simpleName;
+
+    Family(String qualifiedName, String relativeName, String simpleName) {
+      this.qualifiedName = qualifiedName;
+      this.relativeName = relativeName;
+      this.simpleName = simpleName;
+    }
+  }
+
+  private enum Shape {
+    PLAIN,
+    OPTIONAL,
+    ITERABLE,
+    MAP,
+    MULTIMAP
+  }
+
+  private static final class FoldedAttribute {
+    final ValueAttribute attribute;
+    final Family family;
+    final Shape shape;
+
+    FoldedAttribute(ValueAttribute attribute, Family family, Shape shape) {
+      this.attribute = attribute;
+      this.family = family;
+      this.shape = shape;
+    }
+
+    String parameterName() {
+      return attribute.names.raw + "Folded";
+    }
+
+    String parameterType() {
+      switch (shape) {
+      case PLAIN:
+        return RESULT;
+      case OPTIONAL:
+        return attribute.getRawType() + "<" + RESULT + ">";
+      case ITERABLE:
+        return "java.util.List<" + RESULT + ">";
+      case MAP:
