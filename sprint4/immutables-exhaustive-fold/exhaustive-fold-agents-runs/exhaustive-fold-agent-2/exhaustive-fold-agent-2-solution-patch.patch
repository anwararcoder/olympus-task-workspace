+package org.immutables.fixture.nested;
+
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import javax.annotation.Nullable;
+import org.immutables.value.Value;
+
+@Value.Enclosing
+interface FoldEnclosing {
+  interface Node {}
+
+  @Value.Immutable
+  interface Lit extends Node {
+    int value();
+  }
+
+  @Value.Immutable
+  interface Add extends Node {
+    Node left();
+    Node right();
+  }
+
+  @Value.Immutable
+  interface SpecialAdd extends Add {
+    Optional<Node> bonus();
+  }
+
+  @Value.Immutable
+  interface Bag extends Node {
+    List<Node> nodes();
+    Map<String, Node> named();
+    @Nullable Node nullable();
+  }
+
+  interface Single {}
+
+  @Value.Immutable
+  interface Only extends Single {}
+
+  interface Generic<T> {}
+
+  @Value.Immutable
+  interface GenericOne extends Generic<String> {}
+
+  @Value.Immutable
+  interface GenericTwo extends Generic<Integer> {}
+}
