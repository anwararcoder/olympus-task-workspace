@@ -0,0 +1,142 @@
+[template public generate]
+  [for type in values.values if type.kind.isEnclosing]
+    [if type.fold.hasFamilies]
+[for String foldClassname = ((toUpper type.name) 'Fold')]
+[output.java type.package foldClassname type.element]
+[type.sourceHeader]
+[generateFold type foldClassname]
+[/output.java]
+[/for]
+    [/if]
+  [/for]
+[/template]
+
+[template generateFold Type foldType String foldClassname]
+[if foldType.package]
+package [foldType.package];
+[/if]
+
+[if foldType.generateSuppressAllWarnings]@SuppressWarnings("all")[/if]
+[if foldType allowsClasspathAnnotation '[jaxarta].annotation.ParametersAreNonnullByDefault']
+@[jaxarta].annotation.ParametersAreNonnullByDefault
+[/if]
+[if foldType allowsClasspathAnnotation 'javax.annotation.processing.Generated']
+@javax.annotation.processing.Generated("org.immutables.processor.ProxyProcessor")
+[else if foldType allowsClasspathAnnotation '[jaxarta].annotation.Generated']
+@[jaxarta].annotation.Generated("org.immutables.processor.ProxyProcessor")
+[/if]
+[if foldType allowsClasspathAnnotation 'org.immutables.value.Generated']
+@org.immutables.value.Generated(from = "[foldType.typeAbstract.relativeRaw]", generator = "Folds")
+[/if]
+public interface [foldClassname]<R> {
+  [for fold = foldType.fold,
+       type in fold.caseTypes,
+       t = type.typeValue,
+       s = type.name]
+
+  [type.generics.def] R case[s]([type.typeAbstract.relative] value[for FoldAttribute... attrs = fold.foldAttributes type][for fa in attrs], [foldAttributeResultType fa.attribute] [fa.attribute.name]Result[/for][/for]);
+  [/for]
+  [for fold = foldType.fold,
+       family in fold.familyTypes]
+
+  default R fold([family.qualifiedName] value) {
+    class Folder {
+      private final java.util.IdentityHashMap<Object, R> seen = new java.util.IdentityHashMap<>();
+      [for localFamily in fold.familyTypes]
+
+      R fold[localFamily.simpleName]([localFamily.qualifiedName] value) {
+        [for Type... subtypes = fold.casesFor localFamily]
+          [for type in subtypes]
+        if (value instanceof [type.typeValue.relativeRaw][type.generics.unknown]) {
+          return foldCase[type.name](([type.typeValue.relativeRaw][type.generics.unknown]) value);
+        }
+          [/for]
+        [/for]
+        throw new IllegalArgumentException("Unsupported [localFamily.qualifiedName] implementation: " + value);
+      }
+      [/for]
+      [for type in fold.caseTypes,
+           t = type.typeValue,
+           s = type.name]
+
+      R foldCase[s]([type.typeValue.relativeRaw][type.generics.unknown] value) {
+        if (seen.containsKey(value)) {
+          return seen.get(value);
+        }
+        R result = case[s](value[for FoldAttribute... attrs = fold.foldAttributes type][for fa in attrs], fold[s][toUpper fa.attribute.name](value.[fa.attribute.names.get]())[/for][/for]);
+        seen.put(value, result);
+        return result;
+      }
+        [for FoldAttribute... attrs = fold.foldAttributes type]
+        [for fa in attrs,
+             a = fa.attribute,
+             f = fa.familyType]
+
+      [foldAttributeResultType a] fold[s][toUpper a.name]([a.atNullability][a.type] attribute) {
+          [if a.nullable]
+        if (attribute == null) {
+          return null;
+        }
+          [/if]
+          [if a.optionalType]
+        if (attribute.[optionalPresent a]) {
+          return [optionalOf a](fold[f.simpleName](attribute.[optionalGet a]));
+        }
+        return [optionalEmpty a];
+          [else if a.mapType]
+            [for wK = a.wrappedElementType]
+              [if a.multimapType]
+        [guava].collect.Multimap<[wK], R> results = [guava].collect.LinkedListMultimap.create();
+        for (java.util.Map.Entry<[wK], [a.wrappedSecondaryElementType]> entry : attribute.entries()) {
+          results.put(entry.getKey(), fold[f.simpleName](entry.getValue()));
+        }
+        return results;
+              [else]
+        java.util.Map<[wK], R> results = new java.util.LinkedHashMap<[wK], R>(attribute.size());
+        for (java.util.Map.Entry<[wK], [a.wrappedSecondaryElementType]> entry : attribute.entrySet()) {
+          results.put(entry.getKey(), fold[f.simpleName](entry.getValue()));
+        }
+        return results;
+              [/if]
+            [/for]
+          [else if a.arrayType]
+        java.util.List<R> results = new java.util.ArrayList<R>(attribute.length);
+        for ([a.unwrappedElementType] element : attribute) {
+          results.add(fold[f.simpleName](element));
+        }
+        return results;
+          [else if a.collectionType]
+        java.util.List<R> results = new java.util.ArrayList<R>(attribute.size());
+        for ([a.unwrappedElementType] element : attribute) {
+          results.add(fold[f.simpleName](element));
+        }
+        return results;
+          [else]
+        return fold[f.simpleName](attribute);
+          [/if]
+      }
+        [/for]
+        [/for]
+      [/for]
+    }
+    return new Folder().fold[family.simpleName](value);
+  }
+  [/for]
+}
+[/template]
+
+[template foldAttributeResultType Attribute a][output.trim]
+[if a.optionalType][a.rawType]<R>
+[else if a.mapType][if a.multimapType][guava].collect.Multimap[else]java.util.Map[/if]<[a.wrappedElementType], R>
+[else if a.collectionType or a.arrayType]java.util.List<R>
+[else]R
+[/if]
+[/output.trim][/template]
+
+[template optionalGet Attribute a][if a.jdkSpecializedOptional]getAs[toUpper a.elementType][else]get[/if]()[/template]
+
+[template optionalEmpty Attribute a][a.rawType].[if a.jdkOptional]empty[else if a.fugueOptional or a.javaslangOptional]none[else]absent[/if]()[/template]
+
+[template optionalOf Attribute a][a.rawType].[if not a.optionalAcceptNullable][if a.fugueOptional or a.javaslangOptional]some[else]of[/if][else if a.jdkOptional]ofNullable[else if a.fugueOptional]option[else if a.javaslangOptional]of[else]fromNullable[/if][/template]
+
+[template optionalPresent Attribute a][if a.fugueOptional or a.javaslangOptional]isDefined[else]isPresent[/if]()[/template]
