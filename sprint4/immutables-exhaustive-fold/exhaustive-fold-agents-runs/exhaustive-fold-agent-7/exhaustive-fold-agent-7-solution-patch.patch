diff --git a/value-processor/src/org/immutables/value/processor/meta/FoldStructure.java b/value-processor/src/org/immutables/value/processor/meta/FoldStructure.java
new file mode 100644
index 0000000..7a49837
--- /dev/null
+++ b/value-processor/src/org/immutables/value/processor/meta/FoldStructure.java
@@ -0,0 +1,178 @@
+package org.immutables.value.processor.meta;
+
+import com.Capella.common.base.Function;
+import com.Capella.common.base.Predicate;
+import com.Capella.common.collect.FluentIterable;
+import com.Capella.common.collect.ImmutableList;
+import com.Capella.common.collect.ImmutableSet;
+import com.Capella.common.collect.Lists;
+import com.Capella.common.collect.Maps;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import javax.annotation.Nullable;
+import javax.lang.model.element.Element;
+import javax.lang.model.element.TypeElement;
+import javax.lang.model.type.DeclaredType;
+import javax.lang.model.type.TypeKind;
+import javax.lang.model.type.TypeMirror;
+
+public final class FoldStructure {
+  public final List<FamilyType> familyTypes;
+  public final List<ValueType> caseTypes;
+  private final CaseStructure cases;
+  private final Map<String, FamilyType> familyTypesByName;
+
+  FoldStructure(ValueType enclosingType) {
+    this.cases = enclosingType.getCases();
+
+    Map<String, TypeElement> elementsByName = Maps.newLinkedHashMap();
+    for (ValueType type : cases.implementedTypes) {
+      collectNestedSupertypes(enclosingType.element, type.element, elementsByName);
+    }
+
+    Map<String, FamilyType> discoveredFamilies = Maps.newLinkedHashMap();
+    for (Map.Entry<String, TypeElement> entry : elementsByName.entrySet()) {
+      Set<ValueType> subtypes = cases.knownSubtypesOf(entry.getKey());
+      if (subtypes.size() >= 2 && entry.getValue().getTypeParameters().isEmpty()) {
+        FamilyType familyType = new FamilyType(entry.getKey(), entry.getValue());
+        discoveredFamilies.put(entry.getKey(), familyType);
+      }
+    }
+
+    this.familyTypesByName = Collections.unmodifiableMap(discoveredFamilies);
+    this.familyTypes = ImmutableList.copyOf(discoveredFamilies.values());
+    this.caseTypes = buildCaseTypes();
+  }
+
+  private List<ValueType> buildCaseTypes() {
+    ImmutableSet.Builder<ValueType> builder = ImmutableSet.builder();
+    for (FamilyType familyType : familyTypes) {
+      builder.addAll(cases.knownSubtypesOf(familyType.qualifiedName));
+    }
+    ImmutableSet<ValueType> included = builder.build();
+    ImmutableList.Builder<ValueType> ordered = ImmutableList.builder();
+    for (ValueType type : cases.implementedTypes) {
+      if (included.contains(type)) {
+        ordered.add(type);
+      }
+    }
+    return ordered.build();
+  }
+
+  private static void collectNestedSupertypes(
+      Element enclosingElement,
+      Element element,
+      Map<String, TypeElement> elementsByName) {
+    if (!(element instanceof TypeElement)) {
+      return;
+    }
+    TypeElement typeElement = (TypeElement) element;
+    if (isNestedIn(typeElement, enclosingElement)) {
+      elementsByName.put(typeElement.getQualifiedName().toString(), typeElement);
+    }
+
+    TypeMirror superclass = typeElement.getSuperclass();
+    if (superclass.getKind() == TypeKind.DECLARED) {
+      collectNestedSupertypes(enclosingElement, ((DeclaredType) superclass).asElement(), elementsByName);
+    }
+    for (TypeMirror interfaceType : typeElement.getInterfaces()) {
+      if (interfaceType.getKind() == TypeKind.DECLARED) {
+        collectNestedSupertypes(enclosingElement, ((DeclaredType) interfaceType).asElement(), elementsByName);
+      }
+    }
+  }
+
+  private static boolean isNestedIn(TypeElement typeElement, Element enclosingElement) {
+    if (!(enclosingElement instanceof TypeElement)) {
+      return false;
+    }
+    String enclosingName = ((TypeElement) enclosingElement).getQualifiedName().toString();
+    return typeElement.getQualifiedName().toString().startsWith(enclosingName + ".");
+  }
+
+  public boolean hasFamilies() {
+    return !familyTypes.isEmpty();
+  }
+
+  public FamilyType familyFor(ValueAttribute attribute) {
+    if (attribute.isMapType()) {
+      return familyTypesByName.get(attribute.getUnwrappedSecondaryElementType());
+    }
+    if (attribute.isContainerType() || attribute.isArrayType()) {
+      return familyTypesByName.get(attribute.getUnwrappedElementType());
+    }
+    return familyTypesByName.get(attribute.getType());
+  }
+
+  public final Function<ValueType, Iterable<FoldAttribute>> foldAttributes =
+      new Function<ValueType, Iterable<FoldAttribute>>() {
+        @Override
+        public Iterable<FoldAttribute> apply(ValueType type) {
+          return FluentIterable.from(type.getSettableAttributes())
+              .transform(new Function<ValueAttribute, FoldAttribute>() {
+                @Override
+                public FoldAttribute apply(ValueAttribute attribute) {
+                  FamilyType familyType = familyFor(attribute);
+                  return familyType != null ? new FoldAttribute(attribute, familyType) : null;
+                }
+              })
+              .filter(new Predicate<FoldAttribute>() {
+                @Override
+                public boolean apply(@Nullable FoldAttribute input) {
+                  return input != null;
+                }
+              });
+        }
+      };
+
+  public final Function<FamilyType, Iterable<ValueType>> casesFor =
+      new Function<FamilyType, Iterable<ValueType>>() {
+        @Override
+        public Iterable<ValueType> apply(final FamilyType familyType) {
+          List<ValueType> subtypes = Lists.newArrayList(cases.knownSubtypesOf(familyType.qualifiedName));
+          Collections.sort(subtypes, new Comparator<ValueType>() {
+            @Override
+            public int compare(ValueType left, ValueType right) {
+              if (isSubtype(left, right)) {
+                return -1;
+              }
+              if (isSubtype(right, left)) {
+                return 1;
+              }
+              return left.name().compareTo(right.name());
+            }
+          });
+          return subtypes;
+        }
+      };
+
+  private boolean isSubtype(ValueType type, ValueType possibleSupertype) {
+    if (type == possibleSupertype) {
+      return false;
+    }
+    return cases.knownSubtypesOf(possibleSupertype.typeAbstract().toString()).contains(type);
+  }
+
+  public static final class FamilyType {
+    public final String qualifiedName;
+    public final String simpleName;
+
+    FamilyType(String qualifiedName, TypeElement element) {
+      this.qualifiedName = qualifiedName;
+      this.simpleName = element.getSimpleName().toString();
+    }
+  }
+
+  public static final class FoldAttribute {
+    public final ValueAttribute attribute;
+    public final FamilyType familyType;
+
+    FoldAttribute(ValueAttribute attribute, FamilyType familyType) {
+      this.attribute = attribute;
+      this.familyType = familyType;
+    }
+  }
+}
