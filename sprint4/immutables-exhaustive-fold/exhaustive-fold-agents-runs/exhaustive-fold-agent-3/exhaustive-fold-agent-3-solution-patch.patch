@@ -0,0 +1,57 @@
+package org.immutables.fixture.fold;
+
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import javax.annotation.Nullable;
+import org.immutables.value.Value;
+
+@Value.Enclosing
+public interface Foldables {
+  @Value.Immutable
+  abstract class Node {}
+
+  @Value.Immutable
+  abstract class Leaf extends Node {
+    public abstract int value();
+  }
+
+  @Value.Immutable
+  abstract class SpecialLeaf extends Leaf {
+    public abstract String label();
+  }
+
+  @Value.Immutable
+  abstract class Pair extends Node {
+    public abstract Node left();
+
+    public abstract Optional<Node> right();
+
+    public abstract List<Node> children();
+
+    public abstract Map<String, Node> named();
+
+    @Nullable
+    public abstract Node nullable();
+  }
+
+  @Value.Immutable
+  abstract class Unary extends Node {
+    public abstract Leaf leaf();
+  }
+
+  interface Expr {}
+
+  @Value.Immutable
+  abstract class Const implements Expr {
+    public abstract int value();
+  }
+
+  @Value.Immutable
+  abstract class Add implements Expr {
+    public abstract Expr left();
+
+    public abstract Expr right();
+  }
+}
+
