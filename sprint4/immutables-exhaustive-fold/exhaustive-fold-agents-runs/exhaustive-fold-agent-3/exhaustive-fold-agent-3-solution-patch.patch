+package org.immutables.value.processor.meta;
+
+import com.Capella.common.collect.ImmutableList;
+import java.util.List;
+
+public final class FoldFamily {
+  public final String typeRaw;
+  public final String typeSimple;
+  public final List<ValueType> implementations;
+  public List<FoldCase> cases = ImmutableList.of();
+
+  FoldFamily(ValueType type, List<ValueType> implementations) {
+    this(type.typeAbstract().relativeRaw(), type.name(), implementations);
+  }
+
+  FoldFamily(String typeRaw, String typeSimple, List<ValueType> implementations) {
+    this.typeRaw = typeRaw;
+    this.typeSimple = typeSimple;
+    this.implementations = ImmutableList.copyOf(implementations);
+  }
+
+  public String folderMethod() {
+    return "fold" + typeSimple;
+  }
+}
diff --git a/value-processor/src/org/immutables/value/processor/meta/FoldModel.java b/value-processor/src/org/immutables/value/processor/meta/FoldModel.java
new file mode 100644
index 0000000..51f6b7f
--- /dev/null
+++ b/value-processor/src/org/immutables/value/processor/meta/FoldModel.java
@@ -0,0 +1,232 @@
+package org.immutables.value.processor.meta;
+
+import com.Capella.common.collect.ImmutableList;
+import com.Capella.common.collect.ImmutableMap;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import javax.annotation.Nullable;
+import javax.lang.model.element.ElementKind;
+import javax.lang.model.element.Modifier;
+import javax.lang.model.element.TypeElement;
+import javax.lang.model.util.ElementFilter;
+
+/** Model for generated fold companions of enclosed immutable value families. */
+public final class FoldModel {
+  public final ValueType enclosing;
+  public final String typeName;
+  public final List<FoldFamily> families;
+  public final List<FoldCase> cases;
+  private final Map<String, FoldFamily> familyByTypeName;
+
+  private FoldModel(
+      ValueType enclosing,
+      String typeName,
+      List<FoldFamily> families,
+      List<FoldCase> cases,
+      Map<String, FoldFamily> familyByTypeName) {
+    this.enclosing = enclosing;
+    this.typeName = typeName;
+    this.families = families;
+    this.cases = cases;
+    this.familyByTypeName = familyByTypeName;
+  }
+
+  public static FoldModel of(ValueType enclosing) {
+    Map<String, List<ValueType>> implementationsByType = new LinkedHashMap<>();
+    for (ValueType implementation : enclosing.nested) {
+      for (String supertype : implementationTypeNames(implementation)) {
+        List<ValueType> implementations = implementationsByType.get(supertype);
+        if (implementations == null) {
+          implementations = new ArrayList<>();
+          implementationsByType.put(supertype, implementations);
+        }
+        implementations.add(implementation);
+      }
+    }
+
+    Map<String, FoldFamily> familyByTypeName = new LinkedHashMap<>();
+    List<FoldFamily> families = new ArrayList<>();
+    for (ValueType type : enclosing.nested) {
+      if (!type.generics().isEmpty()) {
+        continue;
+      }
+      String typeName = type.typeAbstract().toString();
+      List<ValueType> implementations = implementationsByType.get(typeName);
+      if (implementations != null && implementations.size() >= 2) {
+        List<ValueType> sorted = new ArrayList<>(implementations);
+        sortTypesMostSpecificFirst(sorted);
+        FoldFamily family = new FoldFamily(type, sorted);
+        families.add(family);
+        familyByTypeName.put(typeName, family);
+      }
+    }
+    for (TypeElement nestedType : ElementFilter.typesIn(enclosing.element.getEnclosedElements())) {
+      String typeName = nestedType.getQualifiedName().toString();
+      if (familyByTypeName.containsKey(typeName) || !nestedType.getTypeParameters().isEmpty()) {
+        continue;
+      }
+      if (nestedType.getKind() != ElementKind.INTERFACE
+          && !nestedType.getModifiers().contains(Modifier.ABSTRACT)) {
+        continue;
+      }
+      List<ValueType> implementations = implementationsByType.get(typeName);
+      if (implementations != null && implementations.size() >= 2) {
+        List<ValueType> sorted = new ArrayList<>(implementations);
+        sortTypesMostSpecificFirst(sorted);
+        FoldFamily family = new FoldFamily(typeName, nestedType.getSimpleName().toString(), sorted);
+        families.add(family);
+        familyByTypeName.put(typeName, family);
+      }
+    }
+
+    Set<ValueType> casedImplementations = new LinkedHashSet<>();
+    for (FoldFamily family : families) {
+      casedImplementations.addAll(family.implementations);
+    }
+
+    List<FoldCase> cases = new ArrayList<>();
+    for (ValueType implementation : enclosing.nested) {
+      if (casedImplementations.contains(implementation)) {
+        cases.add(new FoldCase(implementation, foldableAttributes(implementation, familyByTypeName)));
+      }
+    }
+    sortMostSpecificFirst(cases);
+    for (FoldFamily family : families) {
+      family.cases = casesFor(family, cases);
+    }
+
+    return new FoldModel(
+        enclosing,
+        enclosing.typeAbstract().simple() + "Fold",
+        ImmutableList.copyOf(families),
+        ImmutableList.copyOf(cases),
+        ImmutableMap.copyOf(familyByTypeName));
+  }
+
+  public boolean isPresent() {
+    return !families.isEmpty();
+  }
+
+  @Nullable
+  FoldFamily familyFor(String typeName) {
+    return familyByTypeName.get(typeName);
+  }
+
+  private static List<FoldCase> casesFor(FoldFamily family, List<FoldCase> cases) {
+    ImmutableList.Builder<FoldCase> builder = ImmutableList.builder();
+    for (ValueType implementation : family.implementations) {
+      for (FoldCase foldCase : cases) {
+        if (foldCase.implementation == implementation) {
+          builder.add(foldCase);
+          break;
+        }
+      }
+    }
+    return builder.build();
+  }
+
+  private static Set<String> implementationTypeNames(ValueType implementation) {
+    LinkedHashSet<String> names = new LinkedHashSet<>();
+    names.add(implementation.typeAbstract().toString());
+    names.addAll(implementation.getExtendedClassesNames());
+    names.addAll(implementation.getImplementedInterfacesNames());
+    return names;
+  }
+
+  private static List<FoldAttribute> foldableAttributes(
+      ValueType implementation,
+      Map<String, FoldFamily> familyByTypeName) {
+    List<FoldAttribute> attributes = new ArrayList<>();
+    for (ValueAttribute attribute : implementation.getImplementedAttributes()) {
+      @Nullable Shape shape = shapeOf(attribute, familyByTypeName);
+      if (shape != null) {
+        attributes.add(new FoldAttribute(attribute, shape, familyMethod(attribute, shape, familyByTypeName)));
+      }
+    }
+    return ImmutableList.copyOf(attributes);
+  }
+
+  private static String familyMethod(
+      ValueAttribute attribute,
+      Shape shape,
+      Map<String, FoldFamily> familyByTypeName) {
+    String typeName = shape == Shape.MAP || shape == Shape.MULTIMAP
+        ? attribute.getUnwrappedSecondaryElementType()
+        : attribute.getUnwrappedElementType();
+    FoldFamily family = familyByTypeName.get(typeName);
+    return family != null ? family.folderMethod() : "fold";
+  }
+
+  @Nullable
+  private static Shape shapeOf(ValueAttribute attribute, Map<String, FoldFamily> familyByTypeName) {
+    if (attribute.isOptionalType()) {
+      return familyByTypeName.containsKey(attribute.getUnwrappedElementType()) ? Shape.OPTIONAL : null;
+    }
+    if (attribute.isMapType()) {
+      return familyByTypeName.containsKey(attribute.getUnwrappedSecondaryElementType()) ? Shape.MAP : null;
+    }
+    if (attribute.isMultimapType()) {
+      return familyByTypeName.containsKey(attribute.getUnwrappedSecondaryElementType()) ? Shape.MULTIMAP : null;
+    }
+    if (attribute.isListType()) {
+      return familyByTypeName.containsKey(attribute.getUnwrappedElementType()) ? Shape.LIST : null;
+    }
+    if (attribute.isSetType() || attribute.isMultisetType()) {
+      return familyByTypeName.containsKey(attribute.getUnwrappedElementType()) ? Shape.SET : null;
+    }
+    if (attribute.isArrayType()) {
+      return familyByTypeName.containsKey(attribute.getUnwrappedElementType()) ? Shape.ARRAY : null;
+    }
+    return familyByTypeName.containsKey(attribute.getUnwrappedElementType()) ? Shape.PLAIN : null;
+  }
+
+  public enum Shape {
+    PLAIN,
+    OPTIONAL,
+    LIST,
+    SET,
+    ARRAY,
+    MAP,
+    MULTIMAP
+  }
+
+  private static void sortMostSpecificFirst(List<FoldCase> cases) {
+    Collections.sort(cases, new Comparator<FoldCase>() {
+      @Override
+      public int compare(FoldCase left, FoldCase right) {
+        return specificityCompare(left.implementation, right.implementation);
+      }
+    });
+  }
+
+  private static void sortTypesMostSpecificFirst(List<ValueType> types) {
+    Collections.sort(types, new Comparator<ValueType>() {
+      @Override
+      public int compare(ValueType left, ValueType right) {
+        return specificityCompare(left, right);
+      }
+    });
+  }
+
+  private static int specificityCompare(ValueType left, ValueType right) {
+    if (isSubtypeOf(left, right)) {
+      return -1;
+    }
+    if (isSubtypeOf(right, left)) {
+      return 1;
+    }
+    return 0;
+  }
+
+  private static boolean isSubtypeOf(ValueType possibleSubtype, ValueType possibleSupertype) {
+    String supertypeName = possibleSupertype.typeAbstract().toString();
+    return !possibleSubtype.typeAbstract().toString().equals(supertypeName)
+        && implementationTypeNames(possibleSubtype).contains(supertypeName);
+  }
+}
