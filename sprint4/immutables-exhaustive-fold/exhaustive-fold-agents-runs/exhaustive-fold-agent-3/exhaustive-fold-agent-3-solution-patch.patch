@@ -0,0 +1,24 @@
+package org.immutables.value.processor.meta;
+
+import com.Capella.common.collect.ImmutableList;
+import java.util.List;
+
+public final class FoldCase {
+  public final ValueType implementation;
+  public final List<FoldAttribute> attributes;
+
+  FoldCase(ValueType implementation, List<FoldAttribute> attributes) {
+    this.implementation = implementation;
+    this.attributes = ImmutableList.copyOf(attributes);
+  }
+
+  public String implementationClassName() {
+    ValueType enclosing = implementation.enclosingValue;
+    if (enclosing != null) {
+      return enclosing.typeEnclosing().packageOf() + "."
+          + enclosing.typeEnclosing().simple() + "$"
+          + implementation.typeImmutable().simple();
+    }
+    return implementation.typeImmutable().relativeRaw();
+  }
+}
