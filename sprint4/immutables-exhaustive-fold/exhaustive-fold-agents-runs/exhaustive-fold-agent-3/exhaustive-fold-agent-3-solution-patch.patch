@@ -0,0 +1,99 @@
+package org.immutables.value.processor.meta;
+
+public final class FoldAttribute {
+  public final ValueAttribute attribute;
+  public final FoldModel.Shape shape;
+  public final String familyMethod;
+
+  FoldAttribute(ValueAttribute attribute, FoldModel.Shape shape, String familyMethod) {
+    this.attribute = attribute;
+    this.shape = shape;
+    this.familyMethod = familyMethod;
+  }
+
+  public String resultName() {
+    return attribute.name() + "Folded";
+  }
+
+  public String valueName() {
+    return attribute.name() + "Value";
+  }
+
+  public String mapName() {
+    return attribute.name() + "Map";
+  }
+
+  public String resultType() {
+    switch (shape) {
+    case PLAIN:
+      return "R";
+    case OPTIONAL:
+      return attribute.getRawType() + "<R>";
+    case MAP:
+      return "java.util.Map<" + attribute.getWrappedElementType() + ", R>";
+    case MULTIMAP:
+      return UnshadeGuava.qualify("collect.Multimap") + "<" + attribute.getWrappedElementType() + ", R>";
+    case LIST:
+    case SET:
+    case ARRAY:
+      return "java.util.List<R>";
+    default:
+      throw new AssertionError(shape);
+    }
+  }
+
+  public String optionalEmpty() {
+    if (attribute.isJdkOptional()) {
+      return attribute.getRawType() + ".empty()";
+    }
+    if (attribute.isFugueOptional() || attribute.isJavaslangOptional()) {
+      return attribute.getRawType() + ".none()";
+    }
+    return attribute.getRawType() + ".absent()";
+  }
+
+  public String optionalOfPrefix() {
+    if (attribute.isFugueOptional() || attribute.isJavaslangOptional()) {
+      return attribute.getRawType() + ".some(";
+    }
+    return attribute.getRawType() + ".of(";
+  }
+
+  public String optionalPresent() {
+    return attribute.isFugueOptional() || attribute.isJavaslangOptional()
+        ? "isDefined()"
+        : "isPresent()";
+  }
+
+  public String optionalGet() {
+    return "get()";
+  }
+
+  public boolean isPlain() {
+    return shape == FoldModel.Shape.PLAIN;
+  }
+
+  public boolean isOptional() {
+    return shape == FoldModel.Shape.OPTIONAL;
+  }
+
+  public boolean isList() {
+    return shape == FoldModel.Shape.LIST;
+  }
+
+  public boolean isSet() {
+    return shape == FoldModel.Shape.SET;
+  }
+
+  public boolean isArray() {
+    return shape == FoldModel.Shape.ARRAY;
+  }
+
+  public boolean isMap() {
+    return shape == FoldModel.Shape.MAP;
+  }
+
+  public boolean isMultimap() {
+    return shape == FoldModel.Shape.MULTIMAP;
+  }
+}
