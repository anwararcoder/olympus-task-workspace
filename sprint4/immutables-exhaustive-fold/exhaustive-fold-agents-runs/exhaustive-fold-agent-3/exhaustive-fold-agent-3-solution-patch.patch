@@ -0,0 +1,99 @@
+package org.immutables.fixture.fold;
+
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import org.junit.jupiter.api.Test;
+import static org.immutables.check.Checkers.check;
+
+public class FoldTest {
+  @Test
+  public void foldsBottomUpAndReusesIdentityResults() {
+    Foldables.SpecialLeaf special = ImmutableFoldables.SpecialLeaf.builder()
+        .value(2)
+        .label("s")
+        .build();
+    Foldables.Leaf leaf = ImmutableFoldables.Leaf.builder()
+        .value(1)
+        .build();
+    Foldables.Pair pair = ImmutableFoldables.Pair.builder()
+        .left(special)
+        .right(Optional.of(special))
+        .addChildren(leaf)
+        .putNamed("again", special)
+        .build();
+
+    CountingFold fold = new CountingFold();
+
+    check(fold.fold(pair)).is("pair(special-s,Optional[special-s],[leaf-1],{again=special-s},null)");
+    check(fold.leafCases).is(2);
+  }
+
+  @Test
+  public void foldsPlainNestedInterfaceFamily() {
+    Foldables.Expr expression = ImmutableFoldables.Add.builder()
+        .left(ImmutableFoldables.Const.builder().value(1).build())
+        .right(ImmutableFoldables.Const.builder().value(2).build())
+        .build();
+
+    check(new CountingFold().fold(expression)).is("(1+2)");
+  }
+
+  @Test
+  public void dispatchesToMostSpecificImplementation() {
+    Foldables.SpecialLeaf special = ImmutableFoldables.SpecialLeaf.builder()
+        .value(3)
+        .label("specific")
+        .build();
+
+    check(new CountingFold().fold((Foldables.Leaf) special)).is("special-specific");
+  }
+
+  private static class CountingFold implements FoldablesFold<String> {
+    int leafCases;
+
+    @Override
+    public String caseNode(Foldables.Node value) {
+      return "node";
+    }
+
+    @Override
+    public String caseLeaf(Foldables.Leaf value) {
+      leafCases++;
+      return "leaf-" + value.value();
+    }
+
+    @Override
+    public String caseSpecialLeaf(Foldables.SpecialLeaf value) {
+      leafCases++;
+      return "special-" + value.label();
+    }
+
+    @Override
+    public String casePair(
+        Foldables.Pair value,
+        String leftFolded,
+        Optional<String> rightFolded,
+        List<String> childrenFolded,
+        Map<String, String> namedFolded,
+        String nullableFolded) {
+      return "pair(" + leftFolded + "," + rightFolded + "," + childrenFolded + ","
+          + namedFolded + "," + nullableFolded + ")";
+    }
+
+    @Override
+    public String caseUnary(Foldables.Unary value, String leafFolded) {
+      return "unary(" + leafFolded + ")";
+    }
+
+    @Override
+    public String caseConst(Foldables.Const value) {
+      return Integer.toString(value.value());
+    }
+
+    @Override
+    public String caseAdd(Foldables.Add value, String leftFolded, String rightFolded) {
+      return "(" + leftFolded + "+" + rightFolded + ")";
+    }
+  }
+}
