+#!/bin/bash
+set -uo pipefail
+
+cd "$(dirname "$0")"
+
+OUTPUT_PATH=""
+MODE=""
+
+while [[ $# -gt 0 ]]; do
+    case "$1" in
+        --output_path)
+            OUTPUT_PATH="$2"
+            shift 2
+            ;;
+        base|new)
+            MODE="$1"
+            shift
+            ;;
+        *)
+            echo "Usage: $0 --output_path <path> {base|new}"
+            exit 1
+            ;;
+    esac
+done
+
+if [[ -z "$MODE" ]]; then
+    echo "Usage: $0 --output_path <path> {base|new}"
+    exit 1
+fi
+
+FOCUS_TEST="ExhaustiveFold_382647_Test"
+REPORTS="value-fixture/target/surefire-reports"
+TMP="$(pwd)/target-mvn-tmp"
+mkdir -p "$TMP"
+export MAVEN_OPTS="-Xmx950m -Djava.io.tmpdir=$TMP"
+MVN="mvn -B -ntp -o -DforkCount=1 -DreuseForks=true -DfailIfNoTests=false"
+MAVEN_LOG="$(mktemp "$TMP/exhaustive-fold-maven.XXXXXX.log")"
+trap 'rm -f "$MAVEN_LOG"' EXIT
+
+run_mvn() {
+    : > "$MAVEN_LOG"
+    $MVN "$@" > >(tee "$MAVEN_LOG") 2>&1
+}
+
+xml_escape() {
+    sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
+}
+
+write_xml() {
+    [[ -z "$OUTPUT_PATH" ]] && return 0
+    local fallback="${1:-0}"
+    local found=0
+    : > "$OUTPUT_PATH"
+    echo '<testsuites>' >> "$OUTPUT_PATH"
+    for xml in "$REPORTS"/TEST-*.xml; do
+        if [[ -e "$xml" ]]; then
+            found=1
+            grep -v '<?xml' "$xml" >> "$OUTPUT_PATH"
+        fi
+    done
+    if [[ "$found" -eq 0 && "$fallback" -ne 0 ]]; then
+        cat >> "$OUTPUT_PATH" <<XML
+<testsuite name="exhaustive-fold-harness" tests="1" failures="1" errors="0" skipped="0">
+  <testcase classname="exhaustive-fold-harness" name="maven-before-surefire">
+    <failure message="Maven failed before Surefire reports were produced">
+XML
+        if [[ -s "$MAVEN_LOG" ]]; then
+            xml_escape < "$MAVEN_LOG" >> "$OUTPUT_PATH"
+        else
+            echo "Maven failed before Surefire reports were produced." >> "$OUTPUT_PATH"
+        fi
+        cat >> "$OUTPUT_PATH" <<XML
+    </failure>
+  </testcase>
+</testsuite>
+XML
+    fi
+    echo '</testsuites>' >> "$OUTPUT_PATH"
+}
+
+rm -rf "$REPORTS"
+
+if ! run_mvn -pl value-fixture -am clean install -DskipTests -Dmaven.test.skip=true; then
+    write_xml 1
+    exit 1
+fi
+
+rm -rf "$REPORTS"
+
+RC=0
+case "$MODE" in
+    base)
+        run_mvn -pl value-fixture test -Dtest="!$FOCUS_TEST" || RC=$?
+        ;;
+    new)
+        run_mvn -pl value-fixture test -Dtest="$FOCUS_TEST" || RC=$?
+        ;;
+esac
+
+write_xml "$RC"
+exit $RC
