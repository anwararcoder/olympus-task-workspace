+  @Test
+  void scalarOperatorFamiliesUseAllAndNoneMatrices() throws Exception {
+    Path values = member(Box.class, "values");
+    Path element = Path.ofClass(String.class);
+    Box empty = Box.values(Collections.<String>emptyList());
+
+    Expression in = Expressions.binaryCall(
+        Operators.IN, element, Expressions.constant(Arrays.asList("x", "z")));
+    checkAllNoneMatrix(values, in,
+        Box.values(Arrays.asList("x", "z")),
+        Box.values(Arrays.asList("x", "y")),
+        Box.values(Arrays.asList("a", "b")), empty);
+
+    Expression atLeastM = Expressions.binaryCall(
+        ComparableOperators.GREATER_THAN_OR_EQUAL, element, Expressions.constant("m"));
+    checkAllNoneMatrix(values, atLeastM,
+        Box.values(Arrays.asList("m", "z")),
+        Box.values(Arrays.asList("m", "a")),
+        Box.values(Arrays.asList("a", "b")), empty);
+
+    Expression explicitNot = Expressions.unaryCall(Operators.NOT, equal(element, "x"));
+    checkAllNoneMatrix(values, explicitNot,
+        Box.values(Arrays.asList("a", "b")),
+        Box.values(Arrays.asList("x", "y")),
+        Box.values(Arrays.asList("x", "x")), empty);
+
+    Expression or = Expressions.or(equal(element, "x"), equal(element, "y"));
+    checkAllNoneMatrix(values, or,
+        Box.values(Arrays.asList("x", "y")),
+        Box.values(Arrays.asList("x", "z")),
+        Box.values(Arrays.asList("a", "b")), empty);
+  }
