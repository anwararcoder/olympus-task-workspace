+  @Test
+  void notEqualScalarTruthTableAndBoundaries() throws Exception {
+    Path values = member(Box.class, "values");
+    Expression isNotX = notEqual(Path.ofClass(String.class), "x");
+
+    Box all = Box.values(Arrays.asList("a", "b"));
+    check(matches(quantifier(IterableOperators.ANY, values, isNotX), all));
+    check(matches(quantifier(IterableOperators.ALL, values, isNotX), all));
+    check(!matches(quantifier(IterableOperators.NONE, values, isNotX), all));
+
+    Box some = Box.values(Arrays.asList("x", "y"));
