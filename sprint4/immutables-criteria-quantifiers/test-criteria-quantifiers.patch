+class CriteriaQuantifiers_6f90c2_InMemoryTest {
+
+  @Test
+  void publicMatcherMethodsHaveDistinctRuntimeSemantics()
+      throws ReflectiveOperationException {
+    Expression allX = matcherExpression("all", "x");
+    check(matches(allX, stringHolder("x", "x")));
+    check(!matches(allX, stringHolder("x", "y")));
+    check(matches(allX, stringHolder()));
+
+    Expression noneX = matcherExpression("none", "x");
+    check(matches(noneX, stringHolder("a", "b")));
+    check(!matches(noneX, stringHolder("x", "y")));
+    check(matches(noneX, stringHolder()));
+  }
+
+  @Test
+  void generatedStringMatchersExecuteInsideQuantifiers()
+      throws ReflectiveOperationException {
+    Expression allStartsWithA = filter(quantifiedStringMatcher("all").startsWith("a"));
+    check(matches(allStartsWithA, stringHolder("alpha", "amber")));
+    check(!matches(allStartsWithA, stringHolder("alpha", "beta")));
+
+    Expression noneContainsPh = filter(quantifiedStringMatcher("none").contains("ph"));
+    check(matches(noneContainsPh, stringHolder("amber", "echo")));
+    check(!matches(noneContainsPh, stringHolder("alpha", "echo")));
+
+    Expression allEndsWithA = filter(quantifiedStringMatcher("all").endsWith("a"));
+    check(matches(allEndsWithA, stringHolder("alpha", "beta")));
+    check(!matches(allEndsWithA, stringHolder("alpha", "echo")));
+
+    Expression noneHasLengthFive = filter(quantifiedStringMatcher("none").hasLength(5));
+    check(matches(noneHasLengthFive, stringHolder("four", "six")));
+    check(!matches(noneHasLengthFive, stringHolder("alpha", "four")));
+  }
+
+  @Test
+  void generatedObjectMatchersRetainTheirQuantifierAtRuntime()
+      throws ReflectiveOperationException {
+    Expression allFluffy = petMatcherExpression("all", "fluffy");
+    check(matches(allFluffy, person(pet("fluffy"), pet("fluffy"))));
+    check(!matches(allFluffy, person(pet("fluffy"), pet("buddy"))));
+    check(matches(allFluffy, person()));
+
+    Expression noneFluffy = petMatcherExpression("none", "fluffy");
+    check(matches(noneFluffy, person(pet("buddy"), pet("spot"))));
+    check(!matches(noneFluffy, person(pet("fluffy"), pet("buddy"))));
+    check(matches(noneFluffy, person()));
+
+    Expression allAddressesPresent = petOptionalMatcherExpression("all", "isPresent");
+    check(matches(allAddressesPresent, person(
+        petWithAddress("fluffy"), petWithAddress("buddy"))));
+    check(!matches(allAddressesPresent, person(
+        petWithAddress("fluffy"), pet("buddy"))));
+    check(matches(allAddressesPresent, person()));
+
+    Expression noAddressesPresent = petOptionalMatcherExpression("none", "isPresent");
+    check(matches(noAddressesPresent, person(pet("fluffy"), pet("buddy"))));
+    check(!matches(noAddressesPresent, person(
+        petWithAddress("fluffy"), pet("buddy"))));
+    check(matches(noAddressesPresent, person()));
+
+    Expression allNotFluffy = petNegatedMatcherExpression("all", "fluffy");
+    check(matches(allNotFluffy, person(pet("buddy"), pet("spot"))));
+    check(!matches(allNotFluffy, person(pet("fluffy"), pet("buddy"))));
+    check(matches(allNotFluffy, person()));
+
+    Expression noneNotFluffy = petNegatedMatcherExpression("none", "fluffy");
+    check(matches(noneNotFluffy, person(pet("fluffy"), pet("fluffy"))));
+    check(!matches(noneNotFluffy, person(pet("fluffy"), pet("buddy"))));
+    check(matches(noneNotFluffy, person()));
+
+    Expression allTagsEmpty = petCollectionMatcherExpression("all", "isEmpty", null);
+    check(matches(allTagsEmpty, person(pet("fluffy"), pet("buddy"))));
+    check(!matches(allTagsEmpty, person(petWithTags("fluffy", "friendly"))));
+    check(matches(allTagsEmpty, person()));
+
+    Expression noTagsNonempty = petCollectionMatcherExpression("none", "notEmpty", null);
+    check(matches(noTagsNonempty, person(pet("fluffy"), pet("buddy"))));
+    check(!matches(noTagsNonempty, person(petWithTags("fluffy", "friendly"))));
+    check(matches(noTagsNonempty, person()));
+
+    Expression allTagListsHaveSizeOne =
+        petCollectionMatcherExpression("all", "hasSize", 1);
+    check(matches(allTagListsHaveSizeOne, person(
+        petWithTags("fluffy", "friendly"), petWithTags("buddy", "playful"))));
+    check(!matches(allTagListsHaveSizeOne, person(
+        petWithTags("fluffy", "friendly"), pet("buddy"))));
+    check(matches(allTagListsHaveSizeOne, person()));
+
+    Expression noTagListContainsRescue =
+        petCollectionMatcherExpression("none", "contains", "rescue");
+    check(matches(noTagListContainsRescue, person(
+        petWithTags("fluffy", "friendly"), pet("buddy"))));
+    check(!matches(noTagListContainsRescue, person(
+        petWithTags("fluffy", "rescue"), pet("buddy"))));
+    check(matches(noTagListContainsRescue, person()));
+  }
