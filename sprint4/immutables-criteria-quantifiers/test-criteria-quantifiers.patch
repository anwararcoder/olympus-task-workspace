+  private static void checkAllNoneMatrix(
+      Path path,
+      Expression predicate,
+      Box allTrue,
+      Box mixed,
+      Box noTrue,
+      Box empty) {
+    check(matches(quantifier(IterableOperators.ALL, path, predicate), allTrue));
+    check(!matches(quantifier(IterableOperators.NONE, path, predicate), allTrue));
+    check(!matches(quantifier(IterableOperators.ALL, path, predicate), mixed));
+    check(!matches(quantifier(IterableOperators.NONE, path, predicate), mixed));
+    check(!matches(quantifier(IterableOperators.ALL, path, predicate), noTrue));
+    check(matches(quantifier(IterableOperators.NONE, path, predicate), noTrue));
+    check(matches(quantifier(IterableOperators.ALL, path, predicate), empty));
+    check(matches(quantifier(IterableOperators.NONE, path, predicate), empty));
+  }
