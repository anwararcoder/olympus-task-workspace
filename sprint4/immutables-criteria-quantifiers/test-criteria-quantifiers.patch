+
+  @Test
+  void compoundPredicateCannotCombineDifferentElements() throws Exception {
+    Path entries = member(Box.class, "entries");
+    Path entry = Path.ofClass(Entry.class);
+    Expression leftA = equal(entry.append(method(Entry.class, "left")), "A");
+    Expression rightY = equal(entry.append(method(Entry.class, "right")), "Y");
+    Expression both = Expressions.and(leftA, rightY);
+    Box box = Box.entries(Arrays.asList(new Entry("A", "X", null), new Entry("B", "Y", null)));
+
+    check(!matches(quantifier(IterableOperators.ANY, entries, both), box));
+    check(!matches(quantifier(IterableOperators.ALL, entries, both), box));
+    check(matches(quantifier(IterableOperators.NONE, entries, both), box));
+
+    Entry shared = new Entry("A", "X", null);
+    Box withShared = Box.entries(Arrays.asList(shared, new Entry("B", "Y", null)));
+    Expression sameElement = equal(entry, shared);
+    check(matches(quantifier(IterableOperators.ANY, entries, sameElement), withShared));
+    check(!matches(quantifier(IterableOperators.ALL, entries, sameElement), withShared));
+    check(!matches(quantifier(IterableOperators.NONE, entries, sameElement), withShared));
+
+    Expression distinctElement = equal(entry, new Entry("A", "X", null));
+    check(!matches(quantifier(IterableOperators.ANY, entries, distinctElement), withShared));
+    check(!matches(quantifier(IterableOperators.ALL, entries, distinctElement), withShared));
+    check(matches(quantifier(IterableOperators.NONE, entries, distinctElement), withShared));
+  }
+
+  @Test
+  void missingNestedValueDoesNotSatisfyPredicate() throws Exception {
+    Path entries = member(Box.class, "entries");
+    Path entry = Path.ofClass(Entry.class);
+    Path detail = Path.ofClass(Entry.class).append(method(Entry.class, "detail"));
+    Expression codeOk = equal(detail.append(method(Detail.class, "code")), "ok");
+    Expression codeNotOk = notEqual(detail.append(method(Detail.class, "code")), "ok");
+    Box box = Box.entries(Arrays.asList(
+        new Entry("A", "X", null),
+        new Entry("B", "Y", new Detail("ok"))));
+
+    check(matches(quantifier(IterableOperators.ANY, entries, codeOk), box));
+    check(!matches(quantifier(IterableOperators.ALL, entries, codeOk), box));
+    check(!matches(quantifier(IterableOperators.NONE, entries, codeOk), box));
+
+    Box missingOnly = Box.entries(Collections.singletonList(new Entry("A", "X", null)));
+    check(!matches(quantifier(IterableOperators.ANY, entries, codeOk), missingOnly));
+    check(!matches(quantifier(IterableOperators.ALL, entries, codeOk), missingOnly));
+    check(matches(quantifier(IterableOperators.NONE, entries, codeOk), missingOnly));
+    check(!matches(quantifier(IterableOperators.ANY, entries, codeNotOk), missingOnly));
+    check(!matches(quantifier(IterableOperators.ALL, entries, codeNotOk), missingOnly));
+    check(matches(quantifier(IterableOperators.NONE, entries, codeNotOk), missingOnly));
+
+    Expression leftA = equal(entry.append(method(Entry.class, "left")), "A");
