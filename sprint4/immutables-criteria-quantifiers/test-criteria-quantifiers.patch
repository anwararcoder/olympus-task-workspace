+  @Test
+  void generatedQuantifierSurvivesRootDisjunctionAtRuntime()
+      throws ReflectiveOperationException {
+    Expression expression = rootDisjunctionMatcherExpression();
+
+    check(matches(expression, stringHolderWithValue("other", "x", "x")));
+    check(matches(expression, stringHolderWithValue("fallback", "x", "y")));
+    check(!matches(expression, stringHolderWithValue("other", "x", "y")));
+  }
+
+  @Test
+  void scalarTruthTableAndVacuousTruth() throws Exception {
+    Path values = member(Box.class, "values");
+    Expression isX = equal(Path.ofClass(String.class), "x");
+
+    Box all = Box.values(Arrays.asList("x", "x"));
+    check(matches(quantifier(IterableOperators.ANY, values, isX), all));
+    check(matches(quantifier(IterableOperators.ALL, values, isX), all));
+    check(!matches(quantifier(IterableOperators.NONE, values, isX), all));
+
+    Box some = Box.values(Arrays.asList("x", "y"));
+    check(matches(quantifier(IterableOperators.ANY, values, isX), some));
+    check(!matches(quantifier(IterableOperators.ALL, values, isX), some));
+    check(!matches(quantifier(IterableOperators.NONE, values, isX), some));
+
+    Box none = Box.values(Arrays.asList("a", "b"));
+    check(!matches(quantifier(IterableOperators.ANY, values, isX), none));
+    check(!matches(quantifier(IterableOperators.ALL, values, isX), none));
+    check(matches(quantifier(IterableOperators.NONE, values, isX), none));
+
+    Box empty = Box.values(Collections.<String>emptyList());
+    check(!matches(quantifier(IterableOperators.ANY, values, isX), empty));
+    check(matches(quantifier(IterableOperators.ALL, values, isX), empty));
+    check(matches(quantifier(IterableOperators.NONE, values, isX), empty));
+  }
