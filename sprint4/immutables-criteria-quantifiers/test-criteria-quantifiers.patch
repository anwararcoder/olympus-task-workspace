+    assertMatches(
+        quantifier(IterableOperators.NONE, entries, nestedAnd),
+        "a_only", "bc_only", "b_only", "c_only", "missing_fields", "null_fields",
+        "split", "empty");
+    assertMatches(
+        quantifier(IterableOperators.ALL, entries, nestedOr),
+        "all_three", "a_only", "bc_only", "split", "empty");
+    assertMatches(
+        quantifier(IterableOperators.NONE, entries, nestedOr),
+        "b_only", "c_only", "missing_fields", "null_fields", "empty");
+  }
+
+  @Test
+  void mixedNestedQuantifiersKeepEveryCollectionScope() throws Exception {
+    insert(
+        "{_id:'all_have_one', groups:[{numbers:[1,2]},{numbers:[1]}]}",
+        "{_id:'all_ones', groups:[{numbers:[1,1]},{numbers:[1]}]}",
+        "{_id:'mixed_has_one', groups:[{numbers:[1]},{numbers:[2]}]}",
+        "{_id:'no_ones', groups:[{numbers:[2]},{numbers:[3]}]}",
+        "{_id:'mixed_values', groups:[{numbers:[1,2]},{numbers:[2]}]}",
+        "{_id:'empty_outer', groups:[]}",
+        "{_id:'inner_empty', groups:[{numbers:[]}]}",
+        "{_id:'inner_null', groups:[{numbers:null}]}",
+        "{_id:'inner_missing', groups:[{}]}",
+        "{_id:'inner_non_array', groups:[{numbers:1}]}",
+        "{_id:'outer_null', groups:null}",
+        "{_id:'outer_missing'}",
+        "{_id:'outer_non_array', groups:{numbers:[1]}}");
+
+    Path groups = member(Root.class, "groups");
+    Path numbers = Path.ofClass(Group.class).append(method(Group.class, "numbers"));
+    Expression isOne = equal(Path.ofClass(Integer.class), 1);
+    Expression allAny = quantifier(
+        IterableOperators.ALL,
+        groups,
+        quantifier(IterableOperators.ANY, numbers, isOne));
+    Expression noneAll = quantifier(
+        IterableOperators.NONE,
+        groups,
+        quantifier(IterableOperators.ALL, numbers, isOne));
+    Expression anyNone = quantifier(
+        IterableOperators.ANY,
+        groups,
+        quantifier(IterableOperators.NONE, numbers, isOne));
+
+    assertMatches(allAny, "all_have_one", "all_ones", "empty_outer");
+    assertMatches(
+        noneAll,
+        "no_ones", "mixed_values", "empty_outer", "inner_null", "inner_missing",
+        "inner_non_array");
+    assertMatches(anyNone, "mixed_has_one", "no_ones", "mixed_values", "inner_empty");
+  }
+
+  @Test
+  void nestedQuantifierAndSiblingStayOnTheSameOuterElement() throws Exception {
+    insert(
+        "{_id:'all_good', groups:[{label:'ok',numbers:[1]},{label:'ok',numbers:[1,2]}]}",
+        "{_id:'split', groups:[{label:'ok',numbers:[2]},{label:'bad',numbers:[1]}]}",
+        "{_id:'one_good', groups:[{label:'ok',numbers:[1]},{label:'bad',numbers:[2]}]}",
+        "{_id:'neither', groups:[{label:'bad',numbers:[2]}]}",
+        "{_id:'inner_invalid', groups:[{label:'ok',numbers:null}]}",
+        "{_id:'empty', groups:[]}");
+
+    Path groups = member(Root.class, "groups");
+    Path group = Path.ofClass(Group.class);
+    Expression labelOk = equal(group.append(method(Group.class, "label")), "ok");
+    Expression hasOne = quantifier(
+        IterableOperators.ANY,
+        group.append(method(Group.class, "numbers")),
+        equal(Path.ofClass(Integer.class), 1));
+    Expression sameElement = Expressions.and(labelOk, hasOne);
+
+    assertMatches(
+        quantifier(IterableOperators.ANY, groups, sameElement), "all_good", "one_good");
+    assertMatches(
+        quantifier(IterableOperators.ALL, groups, sameElement), "all_good", "empty");
+    assertMatches(
+        quantifier(IterableOperators.NONE, groups, sameElement),
+        "split", "neither", "inner_invalid", "empty");
+  }
+
+  @Test
+  void sameNamedCollectionsSeparatedByAPlainObjectStayScoped() throws Exception {
+    insert(
+        "{_id:'matching', numbers:[{holder:{numbers:[2,3]}},{holder:{numbers:[]}}]}",
+        "{_id:'inner_has_target', numbers:[{holder:{numbers:[2]}},{holder:{numbers:[1]}}]}",
+        "{_id:'inner_empty', numbers:[{holder:{numbers:[]}}]}",
+        "{_id:'inner_null', numbers:[{holder:{numbers:null}}]}",
+        "{_id:'inner_missing', numbers:[{holder:{}}]}",
+        "{_id:'holder_null', numbers:[{holder:null}]}",
+        "{_id:'holder_missing', numbers:[{}]}",
+        "{_id:'empty_outer', numbers:[]}",
+        "{_id:'outer_null', numbers:null}",
+        "{_id:'outer_missing'}",
+        "{_id:'outer_non_array', numbers:{holder:{numbers:[2]}}}");
+
+    Expression expression = sameNamedNestedExpression();
+    assertMatches(expression, "matching", "inner_empty", "empty_outer");
+  }
+
+  private static Expression sameNamedNestedExpression() throws Exception {
+    Path outerNumbers = member(Root.class, "numbers");
+    Path holderNumbers = Path.ofClass(Group.class)
+        .append(method(Group.class, "holder"))
+        .append(method(Holder.class, "numbers"));
+    Expression innerNone = quantifier(
+        IterableOperators.NONE,
+        holderNumbers,
+        equal(Path.ofClass(Integer.class), 1));
+    return quantifier(IterableOperators.ALL, outerNumbers, innerNone);
+  }
+
+  private void insert(String... documents) {
+    List<BsonDocument> parsed = Arrays.stream(documents)
+        .map(BsonDocument::parse)
+        .collect(Collectors.toList());
+    Flowable.fromPublisher(collection.insertMany(parsed)).blockingSubscribe();
+  }
+
+  private void assertMatches(Expression expression, String... expectedIds) {
+    List<String> actual = Flowable.fromPublisher(collection.find(render(expression)))
+        .map(document -> document.getString("_id").getValue())
+        .toList()
+        .blockingGet()
+        .stream()
+        .sorted()
+        .collect(Collectors.toList());
+    List<String> expected = Arrays.stream(expectedIds)
+        .sorted()
+        .collect(Collectors.toList());
+    check(actual).is(expected);
+  }
+
+  private static BsonDocument render(Expression expression) {
+    CodecRegistry registry = MongoClientSettings.getDefaultCodecRegistry();
+    Bson filter = expression.accept(new FindVisitor(PathNaming.defaultNaming(), registry));
+    return filter.toBsonDocument(BsonDocument.class, registry);
+  }
+
+  private static Call quantifier(IterableOperators operator, Path path, Expression predicate) {
+    return Expressions.binaryCall(operator, path, predicate);
+  }
+
+  private static Call equal(Path path, Object value) {
+    return binary(Operators.EQUAL, path, value);
+  }
+
+  private static Call binary(Operator operator, Path path, Object value) {
+    return Expressions.binaryCall(operator, path, Expressions.constant(value));
+  }
+
+  private static Path member(Class<?> type, String name) throws NoSuchMethodException {
+    return Path.ofMember(method(type, name));
+  }
+
+  private static Method method(Class<?> type, String name) throws NoSuchMethodException {
+    return type.getDeclaredMethod(name);
+  }
+
+  private static Object invokeQuantifier(Object matcher, String method)
+      throws ReflectiveOperationException {
+    return matcher.getClass().getMethod(method).invoke(matcher);
+  }
+
+  private static Object publicField(Object matcher, String name)
+      throws ReflectiveOperationException {
+    return matcher.getClass().getField(name).get(matcher);
+  }
+
+  static final class Root {
+    public String status() {
+      return null;
+    }
+
+    public List<String> values() {
+      return null;
+    }
+
+    public List<Integer> scores() {
+      return null;
+    }
+
+    public List<Entry> entries() {
+      return null;
+    }
+
+    public List<Group> groups() {
+      return null;
+    }
+
+    public List<Group> numbers() {
+      return null;
+    }
+
+    public List<String> starts() {
+      return null;
+    }
+
+    public List<String> contains() {
+      return null;
+    }
+
+    public List<String> ends() {
+      return null;
+    }
+
+    public List<String> lengths() {
+      return null;
+    }
+
+    public List<String> trailingLengths() {
+      return null;
+    }
+
+    public List<BsonDocument> documents() {
+      return null;
+    }
+  }
+
+  static final class Entry {
+    public String left() {
+      return null;
+    }
+
+    public String right() {
+      return null;
+    }
+
+    public Integer score() {
+      return null;
+    }
+
+    public String optional() {
+      return null;
+    }
+
+    public List<String> tags() {
+      return null;
+    }
+  }
+
+  static final class Group {
+    public List<Integer> numbers() {
+      return null;
+    }
+
+    public Holder holder() {
+      return null;
+    }
+
+    public String label() {
+      return null;
+    }
+
+    public List<String> values() {
+      return null;
+    }
+  }
+
+  static final class Holder {
+    public List<Integer> numbers() {
+      return null;
+    }
+  }
+}
diff --git a/test.sh b/test.sh
new file mode 100755
index 00000000..71ae3785
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,222 @@
+#!/bin/bash
+set -uo pipefail
+
+cd "$(dirname "$0")"
+
+OUTPUT_PATH=""
+MODE=""
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --output_path)
+      OUTPUT_PATH="$2"
+      shift 2
+      ;;
+    base|new)
+      MODE="$1"
+      shift
+      ;;
+    *)
+      echo "Usage: $0 --output_path <path> {base|new}"
+      exit 1
+      ;;
+  esac
+done
+
+if [[ -z "$MODE" ]]; then
+  echo "Usage: $0 --output_path <path> {base|new}"
+  exit 1
+fi
+
+FOCUS_TEST="CriteriaQuantifiers_6f90c2_*"
+MODULES=(
+  "criteria/common"
+  "criteria/inmemory"
+  "criteria/mongo"
+)
+REPORTS=(
+  "criteria/common/target/surefire-reports"
+  "criteria/inmemory/target/surefire-reports"
+  "criteria/mongo/target/surefire-reports"
+)
+FOCUS_CLASSES=(
+  "org.immutables.criteria.matcher.CriteriaQuantifiers_6f90c2_ApiTest"
+  "org.immutables.criteria.inmemory.CriteriaQuantifiers_6f90c2_InMemoryTest"
+  "org.immutables.criteria.mongo.CriteriaQuantifiers_6f90c2_MongoTest"
+)
+FOCUS_TESTS=(
+  "allProducesUsableTypedMatcher"
+  "scalarTruthTableAndVacuousTruth"
+  "scalarAllAndNoneExecuteCompleteTruthTables"
+)
+BASE_CLASSES=(
+  "org.immutables.criteria.matcher.MatchersTest"
+  "org.immutables.criteria.inmemory.ExpressionInterpreterTest"
+  "org.immutables.criteria.mongo.FindVisitorTest"
+)
+BASE_TESTS=(
+  "projection"
+  "booleans"
+  "iterableAnyScalar"
+)
+TMP="${TMPDIR:-/tmp}/immutables-criteria-quantifiers-mvn-tmp"
+mkdir -p "$TMP"
+export MAVEN_OPTS="-Xmx1200m -Djava.io.tmpdir=$TMP"
+MVN=(mvn -B -ntp -o -DforkCount=1 -DreuseForks=true -DfailIfNoTests=false)
+PREP_LOG="$TMP/maven-$MODE-prepare.log"
+MODULE_LOGS=(
+  "$TMP/maven-$MODE-common.log"
+  "$TMP/maven-$MODE-inmemory.log"
+  "$TMP/maven-$MODE-mongo.log"
+)
+MODULE_RCS=(0 0 0)
+REPORT_VALID=(1 1 1)
+
+xml_escape() {
+  sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
+}
+
+run_mvn() {
+  local log="$1"
+  shift
+  "${MVN[@]}" "$@" 2>&1 | tee "$log"
+  return "${PIPESTATUS[0]}"
+}
+
+clear_reports() {
+  local reports
+  for reports in "${REPORTS[@]}"; do
+    rm -rf "$reports"
+  done
+}
+
+write_xml() {
+  local fallback="${1:-0}"
+  local reports xml index expected_class expected_xml total_found=0 fallback_written=0
+  [[ -z "$OUTPUT_PATH" ]] && return 0
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+  : > "$OUTPUT_PATH"
+  echo '<testsuites>' >> "$OUTPUT_PATH"
+  for index in "${!REPORTS[@]}"; do
+    reports="${REPORTS[$index]}"
+    if [[ "$MODE" == "base" ]]; then
+      expected_class="${BASE_CLASSES[$index]}"
+    else
+      expected_class="${FOCUS_CLASSES[$index]}"
+    fi
+    expected_xml="$reports/TEST-$expected_class.xml"
+    for xml in "$reports"/TEST-*.xml; do
+      if [[ -e "$xml" ]]; then
+        total_found=1
+        grep -v '<?xml' "$xml" >> "$OUTPUT_PATH"
+      fi
+    done
+    if [[ "$fallback" -ne 0 && "${MODULE_RCS[$index]}" -ne 0 \
+        && ( ! -e "$expected_xml" || "${REPORT_VALID[$index]}" -eq 0 ) ]]; then
+      fallback_written=1
+      if [[ "$MODE" == "base" ]]; then
+        FALLBACK_CLASS="${BASE_CLASSES[$index]}"
+        FALLBACK_TEST="${BASE_TESTS[$index]}"
+      else
+        FALLBACK_CLASS="${FOCUS_CLASSES[$index]}"
+        FALLBACK_TEST="${FOCUS_TESTS[$index]}"
+      fi
+      write_fallback "$FALLBACK_CLASS" "$FALLBACK_TEST" "${MODULE_LOGS[$index]}"
+    fi
+  done
+  if [[ "$total_found" -eq 0 && "$fallback" -ne 0 && "$fallback_written" -eq 0 ]]; then
+    if [[ "$MODE" == "base" ]]; then
+      FALLBACK_CLASS="${BASE_CLASSES[0]}"
+      FALLBACK_TEST="${BASE_TESTS[0]}"
+    else
+      FALLBACK_CLASS="${FOCUS_CLASSES[0]}"
+      FALLBACK_TEST="${FOCUS_TESTS[0]}"
+    fi
+    write_fallback "$FALLBACK_CLASS" "$FALLBACK_TEST" "$PREP_LOG"
+  fi
+  echo '</testsuites>' >> "$OUTPUT_PATH"
+}
+
+verify_expected_report() {
+  local index="$1"
+  local expected_class reports xml tests
+  reports="${REPORTS[$index]}"
+  if [[ "$MODE" == "base" ]]; then
+    expected_class="${BASE_CLASSES[$index]}"
+  else
+    expected_class="${FOCUS_CLASSES[$index]}"
+  fi
+  xml="$reports/TEST-$expected_class.xml"
+
+  if [[ ! -f "$xml" ]]; then
+    REPORT_VALID[$index]=0
+    printf 'Harness discovery failure: expected Surefire report %s was not produced.\n' "$xml" \
+      | tee -a "${MODULE_LOGS[$index]}"
+    return 1
+  fi
+
+  tests="$(sed -n 's/.*<testsuite[^>]* tests="\([0-9][0-9]*\)".*/\1/p' "$xml" | head -n 1)"
+  if [[ ! "$tests" =~ ^[1-9][0-9]*$ ]]; then
+    REPORT_VALID[$index]=0
+    printf 'Harness discovery failure: expected Surefire report %s has no positive test count (tests=%s).\n' \
+      "$xml" "${tests:-missing}" | tee -a "${MODULE_LOGS[$index]}"
+    return 1
+  fi
+}
+
+write_fallback() {
+  local classname="$1"
+  local testname="$2"
+  local log="$3"
+  cat >> "$OUTPUT_PATH" <<XML
+<testsuite name="$MODE" tests="1" failures="1" errors="0" skipped="0">
+  <testcase name="$testname" classname="$classname">
+    <failure message="Maven failed or expected tests were not discovered">
+XML
+  if [[ -f "$log" ]]; then
+    tail -n 200 "$log" | xml_escape >> "$OUTPUT_PATH"
+  else
+    echo "Maven failed or expected tests were not discovered." >> "$OUTPUT_PATH"
+  fi
+  cat >> "$OUTPUT_PATH" <<XML
+    </failure>
+  </testcase>
+</testsuite>
+XML
+}
+
+clear_reports
+: > "$PREP_LOG"
+
+if ! run_mvn "$PREP_LOG" -pl criteria/common,criteria/inmemory,criteria/mongo -am clean install \
+    -DskipTests; then
+  write_xml 1
+  exit 1
+fi
+
+clear_reports
+
+RC=0
+for index in "${!MODULES[@]}"; do
+  : > "${MODULE_LOGS[$index]}"
+  MODULE_RC=0
+  if [[ "$MODE" == "base" ]]; then
+    run_mvn "${MODULE_LOGS[$index]}" -pl "${MODULES[$index]}" test \
+      -Dtest="!$FOCUS_TEST" || MODULE_RC=$?
+  else
+    run_mvn "${MODULE_LOGS[$index]}" -pl "${MODULES[$index]}" test \
+      -Dtest="$FOCUS_TEST" || MODULE_RC=$?
+  fi
+  if ! verify_expected_report "$index"; then
+    if [[ "$MODULE_RC" -eq 0 ]]; then
+      MODULE_RC=1
+    fi
+  fi
+  MODULE_RCS[$index]="$MODULE_RC"
+  if [[ "$RC" -eq 0 && "$MODULE_RC" -ne 0 ]]; then
+    RC="$MODULE_RC"
+  fi
+done
+
+write_xml "$RC"
+exit "$RC"
