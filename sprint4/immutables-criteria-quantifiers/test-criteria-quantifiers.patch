+  @Test
+  void nullIntermediateCollectionMatchesNoQuantifier() throws Exception {
+    Path numbers = member(Box.class, "group").append(method(Group.class, "numbers"));
+    Expression isOne = equal(Path.ofClass(Integer.class), 1);
+    Box box = Box.group(null);
+
+    check(!matches(quantifier(IterableOperators.ANY, numbers, isOne), box));
