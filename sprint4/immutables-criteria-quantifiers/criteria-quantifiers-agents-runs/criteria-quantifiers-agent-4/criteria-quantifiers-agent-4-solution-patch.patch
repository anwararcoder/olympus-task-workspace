+  private Bson quantifiedCondition(Expression expression) {
+    Preconditions.checkArgument(expression instanceof Call, "Expected call but got %s", expression);
+    Call call = (Call) expression;
+    Operator operator = call.operator();
+
+    if (operator == Operators.AND || operator == Operators.OR) {
+      List<Bson> conditions = call.arguments().stream()
+              .map(this::quantifiedCondition)
+              .collect(Collectors.toList());
+      return operator == Operators.AND ? Filters.and(conditions) : Filters.or(conditions);
+    }
+
+    if (operator == Operators.NOT) {
+      return quantifiedFalseCondition(call.arguments().get(0));
+    }
+
+    if (operator == IterableOperators.ANY
+            || operator == IterableOperators.ALL
+            || operator == IterableOperators.NONE) {
+      return quantified(call);
+    }
+
+    Preconditions.checkArgument(!call.arguments().isEmpty() && call.arguments().get(0) instanceof Path,
+            "Expected path in %s", call);
+    Path path = reconstructFullPath(Visitors.toPath(call.arguments().get(0)));
+    if (path == null) {
+      return strictScalarCondition(call);
+    }
+
+    if (operator == StringOperators.HAS_LENGTH) {
+      int length = ((Number) Visitors.toConstant(call.arguments().get(1)).value()).intValue();
+      return Filters.regex(fieldName(path), Pattern.compile(lengthPattern(length)));
+    }
+
+    Bson condition = buildCondition(call, operator, path);
+    if (operator == Operators.NOT_EQUAL || operator == Operators.NOT_IN) {
+      String field = fieldName(path);
+      condition = Filters.and(Filters.exists(field), Filters.ne(field, null), condition);
+    }
+    return condition;
+  }
+
+  private Bson quantifiedFalseCondition(Expression expression) {
+    Preconditions.checkArgument(expression instanceof Call, "Expected call but got %s", expression);
+    Call call = (Call) expression;
+    Operator operator = call.operator();
+
+    if (operator == Operators.AND || operator == Operators.OR) {
+      List<Bson> conditions = call.arguments().stream()
+              .map(this::quantifiedFalseCondition)
+              .collect(Collectors.toList());
+      return operator == Operators.AND ? Filters.or(conditions) : Filters.and(conditions);
+    }
+
+    if (operator == Operators.NOT) {
+      return quantifiedCondition(call.arguments().get(0));
+    }
+
+    if (operator == IterableOperators.ANY
+            || operator == IterableOperators.ALL
+            || operator == IterableOperators.NONE) {
+      String field = fieldName(call.arguments().get(0));
+      Bson arrayType = new BsonDocument(field, new BsonDocument("$type", new BsonString("array")));
+      return Filters.and(arrayType, Filters.nor(quantified(call)));
+    }
+
+    Path path = reconstructFullPath(Visitors.toPath(call.arguments().get(0)));
+    if (path == null) {
+      return strictScalarFalseCondition(call);
+    }
+
+    if (operator == StringOperators.STARTS_WITH
+            || operator == StringOperators.CONTAINS
+            || operator == StringOperators.ENDS_WITH
+            || operator == StringOperators.MATCHES
+            || operator == StringOperators.HAS_LENGTH) {
+      return Filters.regex(fieldName(path), complement(scalarPattern(call)));
+    }
+
+    Operator opposite = falseOperator(operator);
+    if (opposite != null) {
+      Bson condition = buildCondition(call, opposite, path);
+      if (opposite == Operators.NOT_EQUAL || opposite == Operators.NOT_IN) {
+        String field = fieldName(path);
+        condition = Filters.and(Filters.exists(field), Filters.ne(field, null), condition);
+      }
+      return condition;
+    }
+
+    return Filters.nor(quantifiedCondition(call));
+  }
+
+  private Bson strictScalarFalseCondition(Call call) {
+    Operator operator = call.operator();
+    if (operator == OptionalOperators.IS_PRESENT) {
+      return new BsonDocument("$eq", BsonNull.VALUE);
+    }
+    if (operator == OptionalOperators.IS_ABSENT) {
+      return new BsonDocument("$ne", BsonNull.VALUE);
+    }
+    if (operator == StringOperators.STARTS_WITH
+            || operator == StringOperators.CONTAINS
+            || operator == StringOperators.ENDS_WITH
+            || operator == StringOperators.MATCHES
+            || operator == StringOperators.HAS_LENGTH) {
+      BsonValue regex = Filters.regex("ignore", complement(scalarPattern(call)))
+              .toBsonDocument(BsonDocument.class, codecRegistry)
+              .get("ignore");
+      return new BsonDocument("$regex", regex);
+    }
+    if (operator == Operators.EQUAL || operator == Operators.IN) {
+      return strictScalarCondition(Expressions.binaryCall(
+              operator == Operators.EQUAL ? Operators.NOT_EQUAL : Operators.NOT_IN,
+              call.arguments().get(0), call.arguments().get(1)));
+    }
