+    Operator opposite = falseOperator(operator);
+    return opposite != null ? buildScalarElemMatchCondition(call, opposite)
+            : new BsonDocument("$not", quantifiedCondition(call).toBsonDocument(BsonDocument.class, codecRegistry));
+  }
+
+  private static Operator falseOperator(Operator operator) {
+    if (operator == Operators.EQUAL) {
+      return Operators.NOT_EQUAL;
+    } else if (operator == Operators.NOT_EQUAL) {
+      return Operators.EQUAL;
+    } else if (operator == Operators.IN) {
+      return Operators.NOT_IN;
+    } else if (operator == Operators.NOT_IN) {
+      return Operators.IN;
+    } else if (operator == ComparableOperators.GREATER_THAN) {
+      return ComparableOperators.LESS_THAN_OR_EQUAL;
+    } else if (operator == ComparableOperators.GREATER_THAN_OR_EQUAL) {
+      return ComparableOperators.LESS_THAN;
+    } else if (operator == ComparableOperators.LESS_THAN) {
+      return ComparableOperators.GREATER_THAN_OR_EQUAL;
+    } else if (operator == ComparableOperators.LESS_THAN_OR_EQUAL) {
+      return ComparableOperators.GREATER_THAN;
+    } else if (operator == OptionalOperators.IS_PRESENT) {
+      return OptionalOperators.IS_ABSENT;
+    } else if (operator == OptionalOperators.IS_ABSENT) {
+      return OptionalOperators.IS_PRESENT;
+    } else if (operator == IterableOperators.IS_EMPTY) {
+      return IterableOperators.NOT_EMPTY;
+    } else if (operator == IterableOperators.NOT_EMPTY) {
+      return IterableOperators.IS_EMPTY;
+    }
+    return null;
+  }
+
+  private static Pattern scalarPattern(Call call) {
+    Operator operator = call.operator();
+    Object value = Visitors.toConstant(call.arguments().get(1)).value();
+    if (operator == StringOperators.MATCHES) {
+      return (Pattern) value;
+    }
+    if (operator == StringOperators.HAS_LENGTH) {
+      return Pattern.compile(lengthPattern(((Number) value).intValue()));
+    }
+    String regex = (operator == StringOperators.STARTS_WITH ? "\\A" : "")
+            + Pattern.quote(value.toString())
+            + (operator == StringOperators.ENDS_WITH ? "\\z" : "");
+    return Pattern.compile(regex);
+  }
+
+  private static Pattern complement(Pattern pattern) {
+    return Pattern.compile("\\A(?![\\s\\S]*?(?:" + pattern.pattern() + "))[\\s\\S]*\\z", pattern.flags());
+  }
+
+  private static String lengthPattern(int length) {
+    return "\\A[\\s\\S]{" + length + "}\\z";
+  }
+
+  private Bson strictScalarCondition(Call call) {
+    Operator operator = call.operator();
+    if (operator == OptionalOperators.IS_PRESENT) {
+      return new BsonDocument("$ne", BsonNull.VALUE);
+    }
+    if (operator == OptionalOperators.IS_ABSENT) {
+      return new BsonDocument("$eq", BsonNull.VALUE);
+    }
+    if (operator == IterableOperators.IS_EMPTY || operator == IterableOperators.NOT_EMPTY) {
+      BsonDocument size = new BsonDocument("$size", new org.bson.BsonInt32(0));
+      return operator == IterableOperators.IS_EMPTY ? size : new BsonDocument("$not", size);
+    }
+
+    if (operator == StringOperators.STARTS_WITH
+            || operator == StringOperators.CONTAINS
+            || operator == StringOperators.ENDS_WITH
+            || operator == StringOperators.MATCHES
+            || operator == StringOperators.HAS_LENGTH) {
+      Pattern pattern = scalarPattern(call);
+      BsonValue regex = Filters.regex("ignore", pattern)
+              .toBsonDocument(BsonDocument.class, codecRegistry)
+              .get("ignore");
+      return new BsonDocument("$regex", regex);
+    }
+
+    if (operator == Operators.NOT_EQUAL) {
+      Object value = Visitors.toConstant(call.arguments().get(1)).value();
+      return Filters.nin("ignore", value, null)
+              .toBsonDocument(BsonDocument.class, codecRegistry)
+              .getDocument("ignore");
+    }
+
+    if (operator == Operators.NOT_IN) {
+      List<Object> values = new ArrayList<>(Visitors.toConstant(call.arguments().get(1)).values());
+      values.add(null);
+      return Filters.nin("ignore", values)
+              .toBsonDocument(BsonDocument.class, codecRegistry)
+              .getDocument("ignore");
+    }
+
+    Bson condition = buildScalarElemMatchCondition(call, operator);
+    return condition;
+  }
