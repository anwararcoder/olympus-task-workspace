+package org.immutables.criteria.personmodel;
+
+import org.immutables.check.IterableChecker;
+import org.immutables.criteria.backend.Backend;
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+
+public abstract class QuantifierPersonTemplate {
+
+  private final PersonRepository repository;
+  private final PersonCriteria person = PersonCriteria.person;
+
+  protected QuantifierPersonTemplate(Backend backend) {
+    this.repository = new PersonRepository(backend);
+  }
+
+  @Test
+  void objectAndNestedQuantifiers() {
+    ImmutableAddress newYork = ImmutableAddress.builder()
+            .street("street").city("New York").state(Address.State.NY).zip("10000").build();
+    ImmutableToy redBall = ImmutableToy.builder().name("red").type(Toy.ToyType.ball).build();
+    ImmutableToy redRobot = ImmutableToy.builder().name("red").type(Toy.ToyType.robot).build();
+
+    ImmutablePet alpha = ImmutablePet.builder().name("alpha").type(Pet.PetType.dog)
+            .address(newYork).addToys(redBall).build();
+    ImmutablePet amber = ImmutablePet.builder().name("amber").type(Pet.PetType.cat)
+            .address(newYork).addToys(redBall).build();
+    ImmutablePet alphaWithoutAddress = ImmutablePet.builder().name("alpha").type(Pet.PetType.dog).build();
+    ImmutablePet betaRobot = ImmutablePet.builder().name("beta").type(Pet.PetType.gecko)
+            .addToys(redRobot).build();
+
+    PersonGenerator generator = new PersonGenerator();
+    repository.insert(generator.next().withId("empty").withPets());
+    repository.insert(generator.next().withId("matching").withPets(alpha, amber));
+    repository.insert(generator.next().withId("split").withPets(alphaWithoutAddress, betaRobot));
+
+    ids(person.pets.all().name.startsWith("a")).hasContentInAnyOrder("empty", "matching");
+    ids(person.pets.none().name.startsWith("z")).hasContentInAnyOrder("empty", "matching", "split");
+
+    ids(person.pets.any().with(pet -> pet.name.is("alpha").and(pet.type.is(Pet.PetType.gecko)))).isEmpty();
+    ids(person.pets.none().with(pet -> pet.name.is("alpha").and(pet.type.is(Pet.PetType.gecko))))
+            .hasContentInAnyOrder("empty", "matching", "split");
+
+    ids(person.pets.all().address.isPresent()).hasContentInAnyOrder("empty", "matching");
+    ids(person.pets.all().address.value().city.startsWith("New")).hasContentInAnyOrder("empty", "matching");
+    ids(person.pets.none().address.value().city.startsWith("New")).hasContentInAnyOrder("empty", "split");
+
+    ids(person.pets.all().toys.notEmpty()).hasContentInAnyOrder("empty", "matching");
+    ids(person.pets.all().toys.any().name.is("red")).hasContentInAnyOrder("empty", "matching");
+    ids(person.pets.none().toys.any().type.is(Toy.ToyType.robot)).hasContentInAnyOrder("empty", "matching");
+  }
+
+  private IterableChecker<List<String>, String> ids(PersonCriteria criteria) {
+    return CriteriaChecker.<Person>ofReader(repository.find(criteria)).toList(Person::id);
+  }
+}
