@@ -0,0 +1,61 @@
+package org.immutables.criteria.typemodel;
+
+import org.immutables.check.IterableChecker;
+import org.immutables.criteria.backend.Backend;
+import org.immutables.criteria.personmodel.CriteriaChecker;
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+import java.util.function.Supplier;
+
+public abstract class QuantifierTemplate {
+
+  private final StringHolderRepository repository;
+  private final StringHolderCriteria string = StringHolderCriteria.stringHolder;
+  private final Supplier<ImmutableStringHolder> generator;
+
+  protected QuantifierTemplate(Backend backend) {
+    this.repository = new StringHolderRepository(backend);
+    this.generator = TypeHolder.StringHolder.generator();
+  }
+
+  private void populate() {
+    repository.insert(generator.get().withId("empty").withArray().withList());
+    repository.insert(generator.get().withId("all-a").withArray("a", "aa").withList("a", "aa"));
+    repository.insert(generator.get().withId("mixed").withArray("a", "b").withList("a", "b"));
+    repository.insert(generator.get().withId("no-a").withArray("b", "c").withList("b", "c"));
+    repository.insert(generator.get().withId("null-element").withArray("a", null).withList("a"));
+    repository.insert(generator.get().withId("line-break").withArray("a\n").withList("a\n"));
+  }
+
+  @Test
+  void scalarQuantifiers() {
+    populate();
+    ids(string.array.any().startsWith("a")).hasContentInAnyOrder("all-a", "mixed", "null-element", "line-break");
+    ids(string.array.all().startsWith("a")).hasContentInAnyOrder("empty", "all-a", "line-break");
+    ids(string.array.none().startsWith("a")).hasContentInAnyOrder("empty", "no-a");
+
+    ids(string.list.any().is("a")).hasContentInAnyOrder("all-a", "mixed", "null-element");
+    ids(string.list.all().isNot("b")).hasContentInAnyOrder("empty", "all-a", "null-element", "line-break");
+    ids(string.list.none().is("a")).hasContentInAnyOrder("empty", "no-a", "line-break");
+  }
+
+  @Test
+  void nullElementsDoNotMatchNegativePredicates() {
+    populate();
+    ids(string.array.all().isNot("b")).hasContentInAnyOrder("empty", "all-a", "line-break");
+    ids(string.array.none().isNot("b")).hasContentInAnyOrder("empty");
+  }
+
+  @Test
+  void stringLengthIncludesLineBreaks() {
+    populate();
+    ids(string.array.any().hasLength(2)).hasContentInAnyOrder("all-a", "line-break");
+    ids(string.array.all().hasLength(2)).hasContentInAnyOrder("empty", "line-break");
+    ids(string.array.none().hasLength(2)).hasContentInAnyOrder("empty", "mixed", "no-a", "null-element");
+  }
+
+  private IterableChecker<List<String>, String> ids(StringHolderCriteria criteria) {
+    return CriteriaChecker.<TypeHolder.StringHolder>ofReader(repository.find(criteria)).toList(TypeHolder.StringHolder::id);
+  }
+}
