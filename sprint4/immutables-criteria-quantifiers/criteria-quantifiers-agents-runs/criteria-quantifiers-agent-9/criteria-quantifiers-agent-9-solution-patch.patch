+          left = left.withGuard(comparison("$gte", leftLength, rightLength));
+        }
+        left = left.withGuard(known(left.expression));
+      } else if (operator == StringOperators.MATCHES) {
+        Pattern pattern = (Pattern) Visitors.toConstant(call.arguments().get(1)).value();
+        result = new BsonDocument("$regexMatch", new BsonDocument("input", left.expression)
+                .append("regex", new BsonRegularExpression(pattern.pattern(), regexOptions(pattern))));
+        left = left.withGuard(known(left.expression));
+      } else if (operator == StringOperators.HAS_LENGTH) {
+        result = eq(new BsonDocument("$strLenCP", left.expression), right);
+        left = left.withGuard(known(left.expression));
+      } else if (operator == IterableOperators.HAS_SIZE) {
+        result = eq(new BsonDocument("$size", left.expression), right);
+        left = left.withGuard(isArray(left.expression));
+      } else if (operator == IterableOperators.CONTAINS) {
+        result = new BsonDocument("$in", array(right, left.expression));
+        left = left.withGuard(isArray(left.expression));
+      } else {
+        throw new UnsupportedOperationException("Unsupported scoped call " + call);
+      }
+
+      return guarded(left.guard, result);
+    }
+
+    private Value value(Expression expression, String variable) {
+      if (expression instanceof Constant) {
+        return new Value(constant((Constant) expression), BsonBoolean.TRUE);
+      }
+      if (expression instanceof Path) {
+        Path path = (Path) expression;
+        String name = this.pathNaming.name(path);
+        String reference;
+        if (variable == null) {
+          reference = '$' + name;
+        } else {
+          reference = "$$" + variable + (name.isEmpty() ? "" : "." + name);
+        }
+        BsonString value = new BsonString(reference);
+        return new Value(value, known(value));
+      }
+      Preconditions.checkArgument(expression instanceof Call, "Unsupported scoped value %s", expression);
+      Call call = (Call) expression;
+      Preconditions.checkArgument(call.arguments().size() == 1, "Expected unary value call %s", call);
+      Value argument = value(call.arguments().get(0), variable);
+      if (call.operator() == StringOperators.TO_LOWER_CASE || call.operator() == StringOperators.TO_UPPER_CASE) {
+        String key = call.operator() == StringOperators.TO_LOWER_CASE ? "$toLower" : "$toUpper";
+        BsonValue guard = and(argument.guard, known(argument.expression));
+        return new Value(guarded(guard, new BsonDocument(key, argument.expression)), guard);
+      }
+      throw new UnsupportedOperationException("Unsupported scoped value " + call);
+    }
+
+    private static BsonValue logical(Operator operator, List<BsonValue> values) {
+      BsonArray decisive = new BsonArray();
+      BsonArray complete = new BsonArray();
+      boolean isOr = operator == Operators.OR;
+      for (BsonValue value : values) {
+        decisive.add(eq(value, BsonBoolean.valueOf(isOr)));
+        complete.add(eq(value, BsonBoolean.valueOf(!isOr)));
+      }
+      return new BsonDocument("$cond", array(new BsonDocument("$or", decisive), BsonBoolean.valueOf(isOr),
+              new BsonDocument("$cond", array(new BsonDocument("$and", complete), BsonBoolean.valueOf(!isOr), BsonNull.VALUE))));
+    }
+
+    private static BsonValue triNot(BsonValue value) {
+      return new BsonDocument("$cond", array(eq(value, BsonBoolean.TRUE), BsonBoolean.FALSE,
+              new BsonDocument("$cond", array(eq(value, BsonBoolean.FALSE), BsonBoolean.TRUE, BsonNull.VALUE))));
+    }
+
+    private static BsonValue guarded(BsonValue guard, BsonValue value) {
+      return new BsonDocument("$cond", array(guard, value, BsonNull.VALUE));
+    }
+
+    private static BsonValue known(BsonValue value) {
+      BsonDocument sentinel = new BsonDocument("$literal", new BsonDocument("$criteriaMissing", BsonBoolean.TRUE));
+      BsonValue resolved = new BsonDocument("$ifNull", array(value, sentinel));
+      return not(eq(resolved, sentinel));
+    }
+
+    private static BsonValue isArray(BsonValue value) {
+      return new BsonDocument("$isArray", array(value));
+    }
+
+    private static BsonValue comparison(String operator, BsonValue left, BsonValue right) {
+      return new BsonDocument(operator, array(left, right));
+    }
+
+    private static BsonValue eq(BsonValue left, BsonValue right) {
+      return comparison("$eq", left, right);
+    }
+
+    private static BsonValue not(BsonValue value) {
+      return new BsonDocument("$not", array(value));
+    }
+
+    private static BsonValue and(BsonValue... values) {
+      return new BsonDocument("$and", array(values));
+    }
+
+    private static BsonArray array(BsonValue... values) {
+      BsonArray array = new BsonArray();
+      Collections.addAll(array, values);
+      return array;
+    }
+
+    private BsonValue constant(Constant constant) {
+      Object value = constant.value();
+      if (value == null) {
+        return BsonNull.VALUE;
+      }
+      if (value instanceof Iterable) {
+        return Filters.in("ignore", (Iterable<?>) value)
+                .toBsonDocument(BsonDocument.class, this.codecRegistry)
+                .getDocument("ignore").getArray("$in");
+      }
+      return Filters.eq("ignore", value)
+              .toBsonDocument(BsonDocument.class, this.codecRegistry)
+              .get("ignore");
+    }
+
+    private static String regexOptions(Pattern pattern) {
+      StringBuilder options = new StringBuilder();
+      if ((pattern.flags() & Pattern.CASE_INSENSITIVE) != 0) options.append('i');
+      if ((pattern.flags() & Pattern.MULTILINE) != 0) options.append('m');
+      if ((pattern.flags() & Pattern.DOTALL) != 0) options.append('s');
+      if ((pattern.flags() & Pattern.COMMENTS) != 0) options.append('x');
+      return options.toString();
+    }
+
+    private static class Value {
+      private final BsonValue expression;
+      private final BsonValue guard;
+
+      private Value(BsonValue expression, BsonValue guard) {
+        this.expression = expression;
+        this.guard = guard;
+      }
+
+      private Value withGuard(BsonValue additional) {
+        return new Value(this.expression, and(this.guard, additional));
+      }
+    }
+  }
+
 }
