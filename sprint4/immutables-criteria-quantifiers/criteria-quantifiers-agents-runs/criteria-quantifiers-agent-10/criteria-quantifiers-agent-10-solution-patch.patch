+package org.immutables.criteria.mongo;
+
+import com.mongodb.MongoClientSettings;
+import com.mongodb.reactivestreams.client.MongoCollection;
+import com.mongodb.reactivestreams.client.MongoDatabase;
+import io.reactivex.Flowable;
+import io.reactivex.Single;
+import org.bson.Document;
+import org.bson.conversions.Bson;
+import org.immutables.criteria.Criterias;
+import org.immutables.criteria.backend.KeyExtractor;
+import org.immutables.criteria.backend.PathNaming;
+import org.immutables.criteria.expression.Path;
+import org.immutables.criteria.expression.Query;
+import org.immutables.criteria.expression.Visitors;
+import org.immutables.criteria.personmodel.Pet;
+import org.immutables.criteria.personmodel.PersonCriteria;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.extension.ExtendWith;
+
+import java.util.Arrays;
+import java.util.List;
+
+import static org.immutables.check.Checkers.check;
+
+@ExtendWith(MongoExtension.class)
+class QuantifierMongoTest {
+
+  private final MongoCollection<Document> collection;
+
+  QuantifierMongoTest(MongoDatabase database) {
+    this.collection = database.getCollection("quantifier-runtime");
+  }
+
+  @Test
+  void nullMissingAndNonArrayValues() {
+    check(Single.fromPublisher(collection.insertMany(Arrays.asList(
+            new Document("_id", "empty").append("pets", Arrays.asList()).append("interests", Arrays.asList()),
+            new Document("_id", "good").append("pets", Arrays.asList(new Document("name", "a")))
+                    .append("interests", Arrays.asList("abc", "zzz")),
+            new Document("_id", "reverse").append("pets", Arrays.asList(new Document("type", "dog")))
+                    .append("interests", Arrays.asList("abc", "bbb")),
+            new Document("_id", "null-element").append("pets", Arrays.asList(new Document("name", "a"), null)),
+            new Document("_id", "null-field").append("pets", Arrays.asList(new Document("name", null))),
+            new Document("_id", "missing-field").append("pets", Arrays.asList(new Document())),
+            new Document("_id", "outer-null").append("pets", null),
+            new Document("_id", "outer-missing"),
+            new Document("_id", "non-array").append("pets", "value"))))
+            .blockingGet()).notNull();
+
+    PersonCriteria person = PersonCriteria.person;
+    check(ids(person.pets.all().name.isNot("z"))).hasContentInAnyOrder("empty", "good");
+    check(ids(person.pets.none().name.is("z")))
+            .hasContentInAnyOrder("empty", "good", "reverse", "null-element", "null-field", "missing-field");
+    check(ids(person.pets.none().name.isNot("z")))
+            .hasContentInAnyOrder("empty", "reverse", "null-field", "missing-field");
+
+    check(ids(person.pets.all().with(pet -> pet.name.is("a").or(pet.type.is(Pet.PetType.dog)))))
+            .hasContentInAnyOrder("empty", "good", "reverse");
+    check(ids(person.pets.all().with(pet -> pet.type.is(Pet.PetType.dog).or(pet.name.is("a")))))
+            .hasContentInAnyOrder("empty", "good", "reverse");
+
+    check(ids(person.interests.any().with(value -> value.is("abc").or().is("zzz"))))
+            .hasContentInAnyOrder("good", "reverse");
+    check(ids(person.interests.all().with(value -> value.is("abc").or().is("zzz"))))
+            .hasContentInAnyOrder("empty", "good");
+    check(ids(person.interests.none().with(value -> value.isNot("abc").isNot("zzz"))))
+            .hasContentInAnyOrder("empty", "good");
+  }
+
+  private List<String> ids(PersonCriteria criteria) {
+    Bson filter = filter(criteria);
+    return Flowable.fromPublisher(collection.find(filter).sort(new Document("_id", 1)))
+            .map(document -> document.getString("_id"))
+            .toList()
+            .blockingGet();
+  }
+
+  private static Bson filter(PersonCriteria criteria) {
+    Query query = Criterias.toQuery(criteria);
+    Path idPath = Visitors.toPath(KeyExtractor.defaultFactory().create(query.entityClass()).metadata().keys().get(0));
+    PathNaming naming = new MongoPathNaming(idPath, PathNaming.defaultNaming());
+    FindVisitor visitor = new FindVisitor(naming, MongoClientSettings.getDefaultCodecRegistry());
+    return query.filter().get().accept(visitor);
+  }
+}
