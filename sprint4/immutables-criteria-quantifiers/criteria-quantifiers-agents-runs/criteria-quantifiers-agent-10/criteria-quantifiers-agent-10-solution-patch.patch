+        return new Truth(Filters.and(conditions.stream().map(value -> value.whenTrue).collect(Collectors.toList())),
+                Filters.or(conditions.stream().map(value -> value.whenFalse).collect(Collectors.toList())),
+                Filters.nor(type(field, BsonType.ARRAY)));
+      }
+
+      ScalarMode mode = operator == IterableOperators.ALL ? ScalarMode.NOT_TRUE : ScalarMode.TRUE;
+      Bson elementCondition = scalarCondition(predicate, mode);
+      Preconditions.checkArgument(elementCondition != null, "Unsupported scalar quantified predicate %s", predicate);
+      Bson array = type(field, BsonType.ARRAY);
+      Bson matchingElement = Filters.elemMatch(field, elementCondition);
+      Bson unknown = Filters.nor(array);
+      if (operator == IterableOperators.ANY) {
+        return new Truth(Filters.and(array, matchingElement), Filters.and(array, Filters.nor(matchingElement)), unknown);
+      }
+      if (operator == IterableOperators.ALL) {
+        return new Truth(Filters.and(array, Filters.nor(matchingElement)), Filters.and(array, matchingElement), unknown);
+      }
+      return new Truth(Filters.and(array, Filters.nor(matchingElement)), Filters.and(array, matchingElement), unknown);
+    }
+
+    private Bson scalarCondition(Expression expression, ScalarMode mode) {
+      Call call = (Call) expression;
+      if ((call.operator() == Operators.AND && mode == ScalarMode.TRUE) ||
+              (call.operator() == Operators.OR && mode == ScalarMode.NOT_TRUE)) {
+        return mergeScalar(call.arguments().stream()
+                .map(argument -> scalarCondition(argument, mode))
+                .collect(Collectors.toList()));
+      }
+      if (call.operator() == Operators.NOT) {
+        if (mode == ScalarMode.TRUE) {
+          return scalarCondition(call.arguments().get(0), ScalarMode.FALSE);
+        }
+        return null;
+      }
+      if (call.operator() == Operators.AND || call.operator() == Operators.OR) {
+        return null;
+      }
+      if (mode == ScalarMode.NOT_TRUE) {
+        return scalarNotTrue(call);
+      }
+      Truth value = truth(call);
+      return mode == ScalarMode.TRUE ? value.whenTrue : value.whenFalse;
+    }
+
+    private Bson mergeScalar(List<Bson> conditions) {
+      BsonDocument merged = new BsonDocument();
+      for (Bson condition : conditions) {
+        if (condition == null) {
+          return null;
+        }
+        BsonDocument document = condition.toBsonDocument(BsonDocument.class, codecRegistry);
+        for (String key : document.keySet()) {
+          if (!merged.containsKey(key)) {
+            merged.put(key, document.get(key));
+          } else if (key.equals("$ne")) {
+            BsonArray values = new BsonArray();
+            values.add(merged.remove(key));
+            values.add(document.get(key));
+            merged.put("$nin", values);
+          } else if (key.equals("$nin")) {
+            BsonArray values = new BsonArray(merged.getArray(key));
+            values.addAll(document.getArray(key));
+            merged.put(key, values);
+          } else if (key.equals("$eq") && merged.get(key).equals(document.get(key))) {
+            continue;
+          } else {
+            return null;
+          }
+        }
+      }
+      return merged;
+    }
+
+    private boolean isScalarPredicate(Expression expression) {
+      if (!(expression instanceof Call)) {
+        return false;
+      }
+      Call call = (Call) expression;
+      if (call.operator() == Operators.AND || call.operator() == Operators.OR || call.operator() == Operators.NOT) {
+        return call.arguments().stream().allMatch(this::isScalarPredicate);
+      }
+      return !call.arguments().isEmpty() && call.arguments().get(0) instanceof Path &&
+              relativeField(call.arguments().get(0)).isEmpty();
+    }
+
+    private Truth binary(Call call) {
+      Operator operator = call.operator();
+      String field = relativeField(call.arguments().get(0));
+      Object value = Visitors.toConstant(call.arguments().get(1)).value();
+      if (field.isEmpty()) {
+        return scalarBinary(call, value);
+      }
+      Bson valid = present(field);
+      Bson unknown = absent(field);
+
+      if (operator == Operators.EQUAL || operator == Operators.NOT_EQUAL) {
+        Bson equal = condition(field, Filters.eq("_", value));
+        Bson notEqual = Filters.and(valid, condition(field, Filters.ne("_", value)));
+        return operator == Operators.EQUAL
+                ? new Truth(equal, notEqual, unknown)
+                : new Truth(notEqual, equal, unknown);
+      }
+
+      if (operator == Operators.IN || operator == Operators.NOT_IN) {
+        Collection<?> values = ImmutableSet.copyOf(Visitors.toConstant(call.arguments().get(1)).values());
+        Bson in = condition(field, Filters.in("_", values));
+        Bson notIn = Filters.and(valid, condition(field, Filters.nin("_", values)));
+        return operator == Operators.IN
+                ? new Truth(in, notIn, unknown)
+                : new Truth(notIn, in, unknown);
+      }
+
+      if (ComparableOperators.isComparable(operator)) {
+        Operator inverse;
+        if (operator == ComparableOperators.GREATER_THAN) {
+          inverse = ComparableOperators.LESS_THAN_OR_EQUAL;
+        } else if (operator == ComparableOperators.GREATER_THAN_OR_EQUAL) {
+          inverse = ComparableOperators.LESS_THAN;
+        } else if (operator == ComparableOperators.LESS_THAN) {
+          inverse = ComparableOperators.GREATER_THAN_OR_EQUAL;
+        } else {
+          inverse = ComparableOperators.GREATER_THAN;
+        }
+        return new Truth(comparison(field, operator, value), Filters.and(valid, comparison(field, inverse, value)), unknown);
+      }
+
+      if (operator == IterableOperators.HAS_SIZE) {
+        Bson array = type(field, BsonType.ARRAY);
+        Bson size = condition(field, Filters.size("_", ((Number) value).intValue()));
+        Bson notSize = condition(field, Filters.not(Filters.size("_", ((Number) value).intValue())));
+        return new Truth(Filters.and(array, size), Filters.and(array, notSize), Filters.nor(array));
+      }
+
+      if (operator == IterableOperators.CONTAINS) {
+        Bson array = type(field, BsonType.ARRAY);
+        Bson contains = condition(field, Filters.eq("_", value));
+        Bson notContains = condition(field, Filters.ne("_", value));
+        return new Truth(Filters.and(array, contains), Filters.and(array, notContains), Filters.nor(array));
+      }
+
+      if (operator == StringOperators.HAS_LENGTH || operator == StringOperators.CONTAINS ||
+              operator == StringOperators.STARTS_WITH || operator == StringOperators.ENDS_WITH ||
+              operator == StringOperators.MATCHES) {
+        Pattern pattern;
+        if (operator == StringOperators.HAS_LENGTH) {
+          pattern = Pattern.compile("(?s)^.{" + ((Number) value).intValue() + "}$");
+        } else if (operator == StringOperators.CONTAINS) {
+          pattern = Pattern.compile(Pattern.quote(value.toString()), Pattern.DOTALL);
+        } else if (operator == StringOperators.STARTS_WITH) {
+          pattern = Pattern.compile("^" + Pattern.quote(value.toString()), Pattern.DOTALL);
+        } else if (operator == StringOperators.ENDS_WITH) {
+          pattern = Pattern.compile(Pattern.quote(value.toString()) + "$", Pattern.DOTALL);
+        } else {
+          pattern = (Pattern) value;
+        }
+        Bson string = type(field, BsonType.STRING);
+        Bson matches = condition(field, Filters.regex("_", pattern));
+        Bson notMatches = condition(field, Filters.not(Filters.regex("_", pattern)));
+        return new Truth(Filters.and(string, matches), Filters.and(string, notMatches), Filters.nor(string));
+      }
+
+      throw new UnsupportedOperationException("Unsupported quantified binary call " + call);
+    }
+
+    private Truth scalarBinary(Call call, Object value) {
+      Operator operator = call.operator();
+      Bson unknown = new BsonDocument("$eq", BsonNull.VALUE);
+      if (operator == Operators.EQUAL || operator == Operators.NOT_EQUAL) {
+        Bson equal = condition("", Filters.eq("_", value));
+        Bson notEqual = condition("", Filters.nin("_", value, null));
+        return operator == Operators.EQUAL
+                ? new Truth(equal, notEqual, unknown)
+                : new Truth(notEqual, equal, unknown);
+      }
+      if (operator == Operators.IN || operator == Operators.NOT_IN) {
+        Collection<?> values = ImmutableSet.copyOf(Visitors.toConstant(call.arguments().get(1)).values());
+        List<Object> valuesAndNull = new ArrayList<>(values);
+        valuesAndNull.add(null);
+        Bson in = condition("", Filters.in("_", values));
+        Bson notIn = condition("", Filters.nin("_", valuesAndNull));
+        return operator == Operators.IN
+                ? new Truth(in, notIn, unknown)
+                : new Truth(notIn, in, unknown);
+      }
+      if (ComparableOperators.isComparable(operator)) {
+        Operator inverse;
+        if (operator == ComparableOperators.GREATER_THAN) {
+          inverse = ComparableOperators.LESS_THAN_OR_EQUAL;
+        } else if (operator == ComparableOperators.GREATER_THAN_OR_EQUAL) {
+          inverse = ComparableOperators.LESS_THAN;
+        } else if (operator == ComparableOperators.LESS_THAN) {
+          inverse = ComparableOperators.GREATER_THAN_OR_EQUAL;
+        } else {
+          inverse = ComparableOperators.GREATER_THAN;
+        }
+        return new Truth(comparison("", operator, value), comparison("", inverse, value), unknown);
+      }
+      if (operator == StringOperators.HAS_LENGTH || operator == StringOperators.CONTAINS ||
+              operator == StringOperators.STARTS_WITH || operator == StringOperators.ENDS_WITH ||
+              operator == StringOperators.MATCHES) {
+        Pattern pattern = stringPattern(operator, value);
+        return new Truth(condition("", Filters.regex("_", pattern)),
+                condition("", Filters.not(Filters.regex("_", pattern))), unknown);
+      }
+      throw new UnsupportedOperationException("Unsupported scalar quantified call " + call);
+    }
+
+    private Bson scalarNotTrue(Expression expression) {
+      if (!(expression instanceof Call)) {
+        return null;
+      }
+      Call call = (Call) expression;
+      if (call.arguments().isEmpty() || !(call.arguments().get(0) instanceof Path) ||
+              !relativeField(call.arguments().get(0)).isEmpty() || call.operator().arity() != Operator.Arity.BINARY) {
+        return null;
+      }
+      Object value = Visitors.toConstant(call.arguments().get(1)).value();
+      Operator operator = call.operator();
+      if (operator == Operators.EQUAL) {
+        return condition("", Filters.ne("_", value));
+      }
+      if (operator == Operators.NOT_EQUAL) {
+        return condition("", Filters.in("_", value, null));
+      }
+      if (operator == Operators.IN || operator == Operators.NOT_IN) {
+        Collection<?> values = ImmutableSet.copyOf(Visitors.toConstant(call.arguments().get(1)).values());
+        if (operator == Operators.IN) {
+          return condition("", Filters.nin("_", values));
+        }
+        List<Object> valuesAndNull = new ArrayList<>(values);
+        valuesAndNull.add(null);
+        return condition("", Filters.in("_", valuesAndNull));
+      }
+      if (ComparableOperators.isComparable(operator)) {
+        return condition("", Filters.not(comparison("_", operator, value)));
+      }
+      if (operator == StringOperators.HAS_LENGTH || operator == StringOperators.CONTAINS ||
+              operator == StringOperators.STARTS_WITH || operator == StringOperators.ENDS_WITH ||
+              operator == StringOperators.MATCHES) {
+        return condition("", Filters.not(Filters.regex("_", stringPattern(operator, value))));
+      }
+      return null;
+    }
+
+    private Pattern stringPattern(Operator operator, Object value) {
+      if (operator == StringOperators.HAS_LENGTH) {
+        return Pattern.compile("(?s)^.{" + ((Number) value).intValue() + "}$");
+      } else if (operator == StringOperators.CONTAINS) {
+        return Pattern.compile(Pattern.quote(value.toString()), Pattern.DOTALL);
+      } else if (operator == StringOperators.STARTS_WITH) {
+        return Pattern.compile("^" + Pattern.quote(value.toString()), Pattern.DOTALL);
+      } else if (operator == StringOperators.ENDS_WITH) {
+        return Pattern.compile(Pattern.quote(value.toString()) + "$", Pattern.DOTALL);
+      }
+      return (Pattern) value;
+    }
+
+    private Bson comparison(String field, Operator operator, Object value) {
+      Bson filter;
+      if (operator == ComparableOperators.GREATER_THAN) {
+        filter = Filters.gt("_", value);
+      } else if (operator == ComparableOperators.GREATER_THAN_OR_EQUAL) {
+        filter = Filters.gte("_", value);
+      } else if (operator == ComparableOperators.LESS_THAN) {
+        filter = Filters.lt("_", value);
+      } else if (operator == ComparableOperators.LESS_THAN_OR_EQUAL) {
+        filter = Filters.lte("_", value);
+      } else {
+        throw new UnsupportedOperationException("Unknown comparison " + operator);
+      }
+      return condition(field, filter);
+    }
+
+    private String relativeField(Expression expression) {
+      Preconditions.checkArgument(expression instanceof Path, "%s is not a path", expression);
+      return naming.name((Path) expression);
+    }
+
+    private Bson present(String field) {
+      if (field.isEmpty()) {
+        return new BsonDocument("$ne", BsonNull.VALUE);
+      }
+      return Filters.and(Filters.exists(field), Filters.ne(field, null));
+    }
+
+    private Bson absent(String field) {
+      if (field.isEmpty()) {
+        return new BsonDocument("$eq", BsonNull.VALUE);
+      }
+      return Filters.or(Filters.exists(field, false), Filters.eq(field, null));
+    }
+
+    private Bson type(String field, BsonType type) {
+      return condition(field, Filters.type("_", type));
+    }
+
+    private Bson condition(String field, Bson dummyFilter) {
+      BsonValue value = dummyFilter.toBsonDocument(BsonDocument.class, codecRegistry).get("_");
+      if (field.isEmpty()) {
+        return value.isDocument() ? value.asDocument() : new BsonDocument("$eq", value);
+      }
+      return new BsonDocument(field, value);
+    }
+
+    private Bson matchNone() {
+      return new BsonDocument("$nor", new BsonArray(Collections.singletonList(new BsonDocument())));
+    }
+
+    private class Truth {
+      final Bson whenTrue;
+      final Bson whenFalse;
+      final Bson unknown;
+
+      Truth(Bson whenTrue, Bson whenFalse, Bson unknown) {
+        this.whenTrue = whenTrue;
+        this.whenFalse = whenFalse;
+        this.unknown = unknown;
+      }
+    }
+  }
+
+  private enum ScalarMode {
+    TRUE,
+    FALSE,
+    NOT_TRUE
+  }
+
