+      }
+
+      if (expression instanceof Call) {
+        Call call = (Call) expression;
+        if (call.operator() == StringOperators.TO_LOWER_CASE || call.operator() == StringOperators.TO_UPPER_CASE) {
+          ValueExpression argument = value(call.arguments().get(0), variable);
+          BsonValue known = eq(type(argument.value), new BsonString("string"));
+          String key = call.operator() == StringOperators.TO_LOWER_CASE ? "$toLower" : "$toUpper";
+          return new ValueExpression(guardedValue(known, document(key, argument.value)), known);
+        }
+      }
+
+      throw new UnsupportedOperationException("Unsupported quantified value " + expression);
+    }
+
+    private BsonValue constant(Constant constant) {
+      return constant.accept(new MongoExpr(naming, codecRegistry));
+    }
+
+    private BsonValue guarded(BsonValue condition, BsonValue expression) {
+      return document("$cond", array(condition, expression, BsonBoolean.FALSE));
+    }
+
+    private BsonValue guardedValue(BsonValue condition, BsonValue expression) {
+      return document("$cond", array(condition, expression, BsonNull.VALUE));
+    }
+
+    private BsonValue isArray(BsonValue value) {
+      return document("$isArray", value);
+    }
+
+    private BsonValue size(BsonValue value) {
+      return document("$size", value);
+    }
+
+    private BsonValue type(BsonValue value) {
+      return document("$type", value);
+    }
+
+    private BsonValue eq(BsonValue left, BsonValue right) {
+      return document("$eq", array(left, right));
+    }
+
+    private BsonValue ne(BsonValue left, BsonValue right) {
+      return document("$ne", array(left, right));
+    }
+
+    private BsonValue not(BsonValue value) {
+      return document("$not", array(value));
+    }
+
+    private BsonValue and(BsonValue... values) {
+      return and(java.util.Arrays.asList(values));
+    }
+
+    private BsonValue and(List<BsonValue> values) {
+      return document("$and", new BsonArray(values));
+    }
+
+    private BsonValue or(BsonValue... values) {
+      return or(java.util.Arrays.asList(values));
+    }
+
+    private BsonValue or(List<BsonValue> values) {
+      return document("$or", new BsonArray(values));
+    }
+
+    private BsonArray array(BsonValue... values) {
+      return new BsonArray(java.util.Arrays.asList(values));
+    }
+
+    private BsonDocument document(String key, BsonValue value) {
+      return new BsonDocument(key, value);
+    }
+  }
+
+  private static class PredicateExpression {
+    final BsonValue truth;
+    final BsonValue known;
+
+    private PredicateExpression(BsonValue truth, BsonValue known) {
+      this.truth = truth;
+      this.known = known;
+    }
+  }
+
+  private static class ValueExpression {
+    final BsonValue value;
+    final BsonValue known;
+
+    private ValueExpression(BsonValue value, BsonValue known) {
+      this.value = value;
+      this.known = known;
+    }
+  }
