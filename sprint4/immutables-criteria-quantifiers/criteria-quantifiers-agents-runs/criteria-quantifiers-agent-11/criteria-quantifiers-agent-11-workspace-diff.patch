+  void collectionLeafPredicatesExecuteInsideQuantifierScopes() throws Exception {
+    insert(
+        "{_id:'sized_one', entries:[{tags:['x']}]}",
+        "{_id:'varied', entries:[{tags:['x','y']}]}",
+        "{_id:'other', entries:[{tags:['y']}]}",
+        "{_id:'empty_tags', entries:[{tags:[]}]}",
+        "{_id:'null_tags', entries:[{tags:null}]}",
+        "{_id:'missing_tags', entries:[{}]}",
+        "{_id:'split', entries:[{tags:['x']},{tags:['x','y']}]}",
+        "{_id:'empty_outer', entries:[]}",
+        "{_id:'outer_null', entries:null}",
+        "{_id:'outer_missing'}");
+
+    Path entries = member(Root.class, "entries");
+    Path tags = Path.ofClass(Entry.class).append(method(Entry.class, "tags"));
+    Expression sizeOne = binary(IterableOperators.HAS_SIZE, tags, 1);
+    Expression containsX = binary(IterableOperators.CONTAINS, tags, "x");
+
+    assertMatches(
+        quantifier(IterableOperators.ALL, entries, sizeOne),
+        "sized_one", "other", "empty_outer");
+    assertMatches(
+        quantifier(IterableOperators.NONE, entries, sizeOne),
+        "varied", "empty_tags", "null_tags", "missing_tags", "empty_outer");
+    assertMatches(
+        quantifier(IterableOperators.ALL, entries, containsX),
+        "sized_one", "varied", "split", "empty_outer");
+    assertMatches(
+        quantifier(IterableOperators.NONE, entries, containsX),
+        "other", "empty_tags", "null_tags", "missing_tags", "empty_outer");
+  }
+
+  @Test
+  void nestedBooleanTreesAreComplementedWithinOneElementScope() throws Exception {
+    insert(
+        "{_id:'all_three', entries:[{left:'A', right:'B', score:10}]}",
+        "{_id:'a_only', entries:[{left:'A', right:'X', score:1}]}",
+        "{_id:'bc_only', entries:[{left:'X', right:'B', score:10}]}",
+        "{_id:'b_only', entries:[{left:'X', right:'B', score:1}]}",
+        "{_id:'c_only', entries:[{left:'X', right:'X', score:10}]}",
+        "{_id:'missing_fields', entries:[{}]}",
+        "{_id:'null_fields', entries:[{left:null, right:null, score:null}]}",
+        "{_id:'split', entries:[{left:'A', right:'X', score:1},{left:'X', right:'B', score:10}]}",
+        "{_id:'mixed_truth', entries:[{left:'A', right:'B', score:10},{left:'X', right:'B', score:1}]}",
+        "{_id:'empty', entries:[]}");
+
+    Path entries = member(Root.class, "entries");
+    Path entry = Path.ofClass(Entry.class);
+    Expression leftA = equal(entry.append(method(Entry.class, "left")), "A");
+    Expression rightB = equal(entry.append(method(Entry.class, "right")), "B");
+    Expression scoreHigh = binary(
+        ComparableOperators.GREATER_THAN, entry.append(method(Entry.class, "score")), 5);
+    Expression nestedAnd = Expressions.and(leftA, Expressions.or(rightB, scoreHigh));
+    Expression nestedOr = Expressions.or(leftA, Expressions.and(rightB, scoreHigh));
+
+    assertMatches(
+        quantifier(IterableOperators.ALL, entries, nestedAnd),
+        "all_three", "empty");
+    assertMatches(
+        quantifier(IterableOperators.NONE, entries, nestedAnd),
+        "a_only", "bc_only", "b_only", "c_only", "missing_fields", "null_fields",
+        "split", "empty");
+    assertMatches(
+        quantifier(IterableOperators.ALL, entries, nestedOr),
+        "all_three", "a_only", "bc_only", "split", "empty");
+    assertMatches(
+        quantifier(IterableOperators.NONE, entries, nestedOr),
+        "b_only", "c_only", "missing_fields", "null_fields", "empty");
+  }
+
+  @Test
+  void mixedNestedQuantifiersKeepEveryCollectionScope() throws Exception {
+    insert(
+        "{_id:'all_have_one', groups:[{numbers:[1,2]},{numbers:[1]}]}",
+        "{_id:'all_ones', groups:[{numbers:[1,1]},{numbers:[1]}]}",
+        "{_id:'mixed_has_one', groups:[{numbers:[1]},{numbers:[2]}]}",
+        "{_id:'no_ones', groups:[{numbers:[2]},{numbers:[3]}]}",
+        "{_id:'mixed_values', groups:[{numbers:[1,2]},{numbers:[2]}]}",
+        "{_id:'empty_outer', groups:[]}",
+        "{_id:'inner_empty', groups:[{numbers:[]}]}",
+        "{_id:'inner_null', groups:[{numbers:null}]}",
+        "{_id:'inner_missing', groups:[{}]}",
+        "{_id:'inner_non_array', groups:[{numbers:1}]}",
+        "{_id:'outer_null', groups:null}",
+        "{_id:'outer_missing'}",
+        "{_id:'outer_non_array', groups:{numbers:[1]}}");
+
+    Path groups = member(Root.class, "groups");
+    Path numbers = Path.ofClass(Group.class).append(method(Group.class, "numbers"));
+    Expression isOne = equal(Path.ofClass(Integer.class), 1);
+    Expression allAny = quantifier(
+        IterableOperators.ALL,
+        groups,
+        quantifier(IterableOperators.ANY, numbers, isOne));
+    Expression noneAll = quantifier(
+        IterableOperators.NONE,
+        groups,
+        quantifier(IterableOperators.ALL, numbers, isOne));
+    Expression anyNone = quantifier(
+        IterableOperators.ANY,
+        groups,
+        quantifier(IterableOperators.NONE, numbers, isOne));
+
+    assertMatches(allAny, "all_have_one", "all_ones", "empty_outer");
+    assertMatches(
+        noneAll,
+        "no_ones", "mixed_values", "empty_outer", "inner_null", "inner_missing",
+        "inner_non_array");
+    assertMatches(anyNone, "mixed_has_one", "no_ones", "mixed_values", "inner_empty");
+  }
+
+  @Test
+  void nestedQuantifierAndSiblingStayOnTheSameOuterElement() throws Exception {
+    insert(
+        "{_id:'all_good', groups:[{label:'ok',numbers:[1]},{label:'ok',numbers:[1,2]}]}",
+        "{_id:'split', groups:[{label:'ok',numbers:[2]},{label:'bad',numbers:[1]}]}",
+        "{_id:'one_good', groups:[{label:'ok',numbers:[1]},{label:'bad',numbers:[2]}]}",
+        "{_id:'neither', groups:[{label:'bad',numbers:[2]}]}",
+        "{_id:'inner_invalid', groups:[{label:'ok',numbers:null}]}",
+        "{_id:'empty', groups:[]}");
+
+    Path groups = member(Root.class, "groups");
+    Path group = Path.ofClass(Group.class);
+    Expression labelOk = equal(group.append(method(Group.class, "label")), "ok");
+    Expression hasOne = quantifier(
+        IterableOperators.ANY,
+        group.append(method(Group.class, "numbers")),
+        equal(Path.ofClass(Integer.class), 1));
+    Expression sameElement = Expressions.and(labelOk, hasOne);
+
+    assertMatches(
+        quantifier(IterableOperators.ANY, groups, sameElement), "all_good", "one_good");
+    assertMatches(
+        quantifier(IterableOperators.ALL, groups, sameElement), "all_good", "empty");
+    assertMatches(
+        quantifier(IterableOperators.NONE, groups, sameElement),
+        "split", "neither", "inner_invalid", "empty");
+  }
+
+  @Test
+  void sameNamedCollectionsSeparatedByAPlainObjectStayScoped() throws Exception {
+    insert(
+        "{_id:'matching', numbers:[{holder:{numbers:[2,3]}},{holder:{numbers:[]}}]}",
+        "{_id:'inner_has_target', numbers:[{holder:{numbers:[2]}},{holder:{numbers:[1]}}]}",
+        "{_id:'inner_empty', numbers:[{holder:{numbers:[]}}]}",
+        "{_id:'inner_null', numbers:[{holder:{numbers:null}}]}",
+        "{_id:'inner_missing', numbers:[{holder:{}}]}",
+        "{_id:'holder_null', numbers:[{holder:null}]}",
+        "{_id:'holder_missing', numbers:[{}]}",
+        "{_id:'empty_outer', numbers:[]}",
+        "{_id:'outer_null', numbers:null}",
+        "{_id:'outer_missing'}",
+        "{_id:'outer_non_array', numbers:{holder:{numbers:[2]}}}");
+
+    Expression expression = sameNamedNestedExpression();
+    assertMatches(expression, "matching", "inner_empty", "empty_outer");
+  }
+
+  private static Expression sameNamedNestedExpression() throws Exception {
+    Path outerNumbers = member(Root.class, "numbers");
+    Path holderNumbers = Path.ofClass(Group.class)
+        .append(method(Group.class, "holder"))
+        .append(method(Holder.class, "numbers"));
+    Expression innerNone = quantifier(
+        IterableOperators.NONE,
+        holderNumbers,
+        equal(Path.ofClass(Integer.class), 1));
+    return quantifier(IterableOperators.ALL, outerNumbers, innerNone);
+  }
+
+  private void insert(String... documents) {
+    List<BsonDocument> parsed = Arrays.stream(documents)
+        .map(BsonDocument::parse)
+        .collect(Collectors.toList());
+    Flowable.fromPublisher(collection.insertMany(parsed)).blockingSubscribe();
+  }
+
+  private void assertMatches(Expression expression, String... expectedIds) {
+    List<String> actual = Flowable.fromPublisher(collection.find(render(expression)))
+        .map(document -> document.getString("_id").getValue())
+        .toList()
+        .blockingGet()
+        .stream()
+        .sorted()
+        .collect(Collectors.toList());
+    List<String> expected = Arrays.stream(expectedIds)
+        .sorted()
+        .collect(Collectors.toList());
+    check(actual).is(expected);
+  }
+
+  private static BsonDocument render(Expression expression) {
+    CodecRegistry registry = MongoClientSettings.getDefaultCodecRegistry();
+    Bson filter = expression.accept(new FindVisitor(PathNaming.defaultNaming(), registry));
+    return filter.toBsonDocument(BsonDocument.class, registry);
+  }
+
+  private static Call quantifier(IterableOperators operator, Path path, Expression predicate) {
+    return Expressions.binaryCall(operator, path, predicate);
+  }
+
+  private static Call equal(Path path, Object value) {
+    return binary(Operators.EQUAL, path, value);
+  }
+
+  private static Call binary(Operator operator, Path path, Object value) {
+    return Expressions.binaryCall(operator, path, Expressions.constant(value));
+  }
+
+  private static Path member(Class<?> type, String name) throws NoSuchMethodException {
+    return Path.ofMember(method(type, name));
+  }
+
+  private static Method method(Class<?> type, String name) throws NoSuchMethodException {
+    return type.getDeclaredMethod(name);
+  }
+
+  private static Object invokeQuantifier(Object matcher, String method)
+      throws ReflectiveOperationException {
+    return matcher.getClass().getMethod(method).invoke(matcher);
+  }
+
+  private static Object publicField(Object matcher, String name)
+      throws ReflectiveOperationException {
+    return matcher.getClass().getField(name).get(matcher);
+  }
+
+  static final class Root {
+    public String status() {
+      return null;
+    }
+
+    public List<String> values() {
+      return null;
+    }
+
+    public List<Integer> scores() {
+      return null;
+    }
+
+    public List<Entry> entries() {
+      return null;
+    }
+
+    public List<Group> groups() {
