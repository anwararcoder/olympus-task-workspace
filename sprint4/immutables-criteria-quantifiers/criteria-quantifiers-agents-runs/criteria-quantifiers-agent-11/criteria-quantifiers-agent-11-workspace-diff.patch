+    }
+
+    public List<String> starts() {
+      return null;
+    }
+
+    public List<String> contains() {
+      return null;
+    }
+
+    public List<String> ends() {
+      return null;
+    }
+
+    public List<String> lengths() {
+      return null;
+    }
+
+    public List<String> trailingLengths() {
+      return null;
+    }
+
+    public List<BsonDocument> documents() {
+      return null;
+    }
+  }
+
+  static final class Entry {
+    public String left() {
+      return null;
+    }
+
+    public String right() {
+      return null;
+    }
+
+    public Integer score() {
+      return null;
+    }
+
+    public String optional() {
+      return null;
+    }
+
+    public List<String> tags() {
+      return null;
+    }
+  }
+
+  static final class Group {
