+  @Test
+  void decisiveBooleanBranchesOverrideMissingValuesRegardlessOfOrder() throws Exception {
+    insert(
+        "{_id:'missing_left_true', entries:[{right:'Y'}]}",
+        "{_id:'true_left_missing', entries:[{left:'A'}]}",
+        "{_id:'missing_left_false', entries:[{right:'N'}]}",
+        "{_id:'false_left_missing', entries:[{left:'N'}]}",
+        "{_id:'full_true', entries:[{left:'A',right:'Y'}]}",
+        "{_id:'full_false', entries:[{left:'N',right:'N'}]}",
+        "{_id:'empty', entries:[]}");
+
+    Path entries = member(Root.class, "entries");
+    Path entry = Path.ofClass(Entry.class);
+    Expression leftA = equal(entry.append(method(Entry.class, "left")), "A");
+    Expression rightY = equal(entry.append(method(Entry.class, "right")), "Y");
+    Expression leftThenRight = Expressions.or(leftA, rightY);
+    Expression rightThenLeft = Expressions.or(rightY, leftA);
+
+    assertMatches(
+        quantifier(IterableOperators.ALL, entries, leftThenRight),
+        "missing_left_true", "true_left_missing", "full_true", "empty");
+    assertMatches(
+        quantifier(IterableOperators.NONE, entries, leftThenRight),
+        "missing_left_false", "false_left_missing", "full_false", "empty");
+    assertMatches(
+        quantifier(IterableOperators.ALL, entries, rightThenLeft),
+        "missing_left_true", "true_left_missing", "full_true", "empty");
+    assertMatches(
+        quantifier(IterableOperators.NONE, entries, rightThenLeft),
+        "missing_left_false", "false_left_missing", "full_false", "empty");
+
+    Expression notLeftThenRight = Expressions.unaryCall(
+        Operators.NOT, Expressions.and(leftA, rightY));
+    Expression notRightThenLeft = Expressions.unaryCall(
+        Operators.NOT, Expressions.and(rightY, leftA));
+    assertMatches(
+        quantifier(IterableOperators.ALL, entries, notLeftThenRight),
+        "missing_left_false", "false_left_missing", "full_false", "empty");
+    assertMatches(
+        quantifier(IterableOperators.NONE, entries, notLeftThenRight),
+        "missing_left_true", "true_left_missing", "full_true", "empty");
+    assertMatches(
+        quantifier(IterableOperators.ALL, entries, notRightThenLeft),
+        "missing_left_false", "false_left_missing", "full_false", "empty");
+    assertMatches(
+        quantifier(IterableOperators.NONE, entries, notRightThenLeft),
+        "missing_left_true", "true_left_missing", "full_true", "empty");
+  }
