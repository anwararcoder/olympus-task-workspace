+  private static Expression petCollectionMatcherExpression(
+      String quantifier, String leafMethod, Object argument)
+      throws ReflectiveOperationException {
+    Object matcher = PersonCriteria.person.pets.getClass()
+        .getMethod(quantifier)
+        .invoke(PersonCriteria.person.pets);
+    Object collar = matcher.getClass().getField("collar").get(matcher);
+    Object tags = collar.getClass().getField("tags").get(collar);
+    Method method;
+    if (argument == null) {
+      method = tags.getClass().getMethod(leafMethod);
+    } else if (argument instanceof Integer) {
+      method = tags.getClass().getMethod(leafMethod, int.class);
+    } else {
+      method = tags.getClass().getMethod(leafMethod, Object.class);
+    }
+    Criterion<?> criterion = (Criterion<?>) method.invoke(tags, argument == null
+        ? new Object[0]
+        : new Object[] {argument});
+    return Criterias.toQuery(criterion).filter().get();
+  }
