+  @Test
+  void positiveInExplicitNotAndComparisonBoundsExecute() throws Exception {
+    insert(
+        "{_id:'x_low', entries:[{left:'x', score:5}]}",
+        "{_id:'y_mid', entries:[{left:'y', score:10}]}",
+        "{_id:'z_high', entries:[{left:'z', score:15}]}",
+        "{_id:'null_fields', entries:[{left:null, score:null}]}",
+        "{_id:'missing_fields', entries:[{}]}",
+        "{_id:'empty', entries:[]}");
+
+    Path entries = member(Root.class, "entries");
+    Path entry = Path.ofClass(Entry.class);
+    Path left = entry.append(method(Entry.class, "left"));
+    Path score = entry.append(method(Entry.class, "score"));
+    Expression in = binary(Operators.IN, left, Arrays.asList("x", "z"));
+    Expression explicitNot = Expressions.unaryCall(Operators.NOT, equal(left, "x"));
+    Expression atLeastTen = binary(ComparableOperators.GREATER_THAN_OR_EQUAL, score, 10);
+    Expression belowTen = binary(ComparableOperators.LESS_THAN, score, 10);
+
+    assertMatches(
+        quantifier(IterableOperators.ALL, entries, in),
+        "x_low", "z_high", "empty");
+    assertMatches(
+        quantifier(IterableOperators.NONE, entries, in),
+        "y_mid", "null_fields", "missing_fields", "empty");
+    assertMatches(
+        quantifier(IterableOperators.ALL, entries, explicitNot),
+        "y_mid", "z_high", "empty");
+    assertMatches(
+        quantifier(IterableOperators.NONE, entries, explicitNot),
+        "x_low", "null_fields", "missing_fields", "empty");
+    assertMatches(
+        quantifier(IterableOperators.ALL, entries, atLeastTen),
+        "y_mid", "z_high", "empty");
+    assertMatches(
+        quantifier(IterableOperators.NONE, entries, atLeastTen),
+        "x_low", "null_fields", "missing_fields", "empty");
+    assertMatches(
+        quantifier(IterableOperators.ALL, entries, belowTen),
+        "x_low", "empty");
+    assertMatches(
+        quantifier(IterableOperators.NONE, entries, belowTen),
+        "y_mid", "z_high", "null_fields", "missing_fields", "empty");
+  }
