diff --git a/test.sh b/test.sh
new file mode 100755
index 0000000..71ae378
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,222 @@
+#!/bin/bash
+set -uo pipefail
+
+cd "$(dirname "$0")"
+
+OUTPUT_PATH=""
+MODE=""
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --output_path)
+      OUTPUT_PATH="$2"
+      shift 2
+      ;;
+    base|new)
+      MODE="$1"
+      shift
+      ;;
+    *)
+      echo "Usage: $0 --output_path <path> {base|new}"
+      exit 1
+      ;;
+  esac
+done
+
+if [[ -z "$MODE" ]]; then
+  echo "Usage: $0 --output_path <path> {base|new}"
+  exit 1
+fi
+
+FOCUS_TEST="CriteriaQuantifiers_6f90c2_*"
+MODULES=(
+  "criteria/common"
+  "criteria/inmemory"
+  "criteria/mongo"
+)
+REPORTS=(
+  "criteria/common/target/surefire-reports"
+  "criteria/inmemory/target/surefire-reports"
+  "criteria/mongo/target/surefire-reports"
+)
+FOCUS_CLASSES=(
+  "org.immutables.criteria.matcher.CriteriaQuantifiers_6f90c2_ApiTest"
+  "org.immutables.criteria.inmemory.CriteriaQuantifiers_6f90c2_InMemoryTest"
+  "org.immutables.criteria.mongo.CriteriaQuantifiers_6f90c2_MongoTest"
+)
+FOCUS_TESTS=(
+  "allProducesUsableTypedMatcher"
+  "scalarTruthTableAndVacuousTruth"
+  "scalarAllAndNoneExecuteCompleteTruthTables"
+)
+BASE_CLASSES=(
+  "org.immutables.criteria.matcher.MatchersTest"
+  "org.immutables.criteria.inmemory.ExpressionInterpreterTest"
+  "org.immutables.criteria.mongo.FindVisitorTest"
+)
+BASE_TESTS=(
+  "projection"
+  "booleans"
+  "iterableAnyScalar"
+)
+TMP="${TMPDIR:-/tmp}/immutables-criteria-quantifiers-mvn-tmp"
+mkdir -p "$TMP"
+export MAVEN_OPTS="-Xmx1200m -Djava.io.tmpdir=$TMP"
+MVN=(mvn -B -ntp -o -DforkCount=1 -DreuseForks=true -DfailIfNoTests=false)
+PREP_LOG="$TMP/maven-$MODE-prepare.log"
+MODULE_LOGS=(
+  "$TMP/maven-$MODE-common.log"
+  "$TMP/maven-$MODE-inmemory.log"
+  "$TMP/maven-$MODE-mongo.log"
+)
+MODULE_RCS=(0 0 0)
+REPORT_VALID=(1 1 1)
+
+xml_escape() {
+  sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
+}
+
+run_mvn() {
+  local log="$1"
+  shift
+  "${MVN[@]}" "$@" 2>&1 | tee "$log"
+  return "${PIPESTATUS[0]}"
+}
+
+clear_reports() {
+  local reports
+  for reports in "${REPORTS[@]}"; do
+    rm -rf "$reports"
+  done
+}
+
+write_xml() {
+  local fallback="${1:-0}"
+  local reports xml index expected_class expected_xml total_found=0 fallback_written=0
+  [[ -z "$OUTPUT_PATH" ]] && return 0
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+  : > "$OUTPUT_PATH"
+  echo '<testsuites>' >> "$OUTPUT_PATH"
+  for index in "${!REPORTS[@]}"; do
+    reports="${REPORTS[$index]}"
+    if [[ "$MODE" == "base" ]]; then
+      expected_class="${BASE_CLASSES[$index]}"
+    else
+      expected_class="${FOCUS_CLASSES[$index]}"
+    fi
+    expected_xml="$reports/TEST-$expected_class.xml"
+    for xml in "$reports"/TEST-*.xml; do
+      if [[ -e "$xml" ]]; then
+        total_found=1
+        grep -v '<?xml' "$xml" >> "$OUTPUT_PATH"
+      fi
+    done
+    if [[ "$fallback" -ne 0 && "${MODULE_RCS[$index]}" -ne 0 \
+        && ( ! -e "$expected_xml" || "${REPORT_VALID[$index]}" -eq 0 ) ]]; then
+      fallback_written=1
+      if [[ "$MODE" == "base" ]]; then
+        FALLBACK_CLASS="${BASE_CLASSES[$index]}"
+        FALLBACK_TEST="${BASE_TESTS[$index]}"
+      else
+        FALLBACK_CLASS="${FOCUS_CLASSES[$index]}"
+        FALLBACK_TEST="${FOCUS_TESTS[$index]}"
+      fi
+      write_fallback "$FALLBACK_CLASS" "$FALLBACK_TEST" "${MODULE_LOGS[$index]}"
+    fi
+  done
+  if [[ "$total_found" -eq 0 && "$fallback" -ne 0 && "$fallback_written" -eq 0 ]]; then
+    if [[ "$MODE" == "base" ]]; then
+      FALLBACK_CLASS="${BASE_CLASSES[0]}"
+      FALLBACK_TEST="${BASE_TESTS[0]}"
+    else
+      FALLBACK_CLASS="${FOCUS_CLASSES[0]}"
+      FALLBACK_TEST="${FOCUS_TESTS[0]}"
+    fi
+    write_fallback "$FALLBACK_CLASS" "$FALLBACK_TEST" "$PREP_LOG"
+  fi
+  echo '</testsuites>' >> "$OUTPUT_PATH"
+}
+
+verify_expected_report() {
+  local index="$1"
+  local expected_class reports xml tests
+  reports="${REPORTS[$index]}"
+  if [[ "$MODE" == "base" ]]; then
+    expected_class="${BASE_CLASSES[$index]}"
+  else
+    expected_class="${FOCUS_CLASSES[$index]}"
+  fi
+  xml="$reports/TEST-$expected_class.xml"
+
+  if [[ ! -f "$xml" ]]; then
+    REPORT_VALID[$index]=0
+    printf 'Harness discovery failure: expected Surefire report %s was not produced.\n' "$xml" \
+      | tee -a "${MODULE_LOGS[$index]}"
+    return 1
+  fi
+
+  tests="$(sed -n 's/.*<testsuite[^>]* tests="\([0-9][0-9]*\)".*/\1/p' "$xml" | head -n 1)"
+  if [[ ! "$tests" =~ ^[1-9][0-9]*$ ]]; then
+    REPORT_VALID[$index]=0
+    printf 'Harness discovery failure: expected Surefire report %s has no positive test count (tests=%s).\n' \
+      "$xml" "${tests:-missing}" | tee -a "${MODULE_LOGS[$index]}"
+    return 1
+  fi
+}
+
+write_fallback() {
+  local classname="$1"
+  local testname="$2"
+  local log="$3"
+  cat >> "$OUTPUT_PATH" <<XML
+<testsuite name="$MODE" tests="1" failures="1" errors="0" skipped="0">
+  <testcase name="$testname" classname="$classname">
+    <failure message="Maven failed or expected tests were not discovered">
+XML
+  if [[ -f "$log" ]]; then
+    tail -n 200 "$log" | xml_escape >> "$OUTPUT_PATH"
+  else
+    echo "Maven failed or expected tests were not discovered." >> "$OUTPUT_PATH"
+  fi
+  cat >> "$OUTPUT_PATH" <<XML
+    </failure>
+  </testcase>
+</testsuite>
+XML
+}
+
+clear_reports
+: > "$PREP_LOG"
+
+if ! run_mvn "$PREP_LOG" -pl criteria/common,criteria/inmemory,criteria/mongo -am clean install \
+    -DskipTests; then
+  write_xml 1
+  exit 1
+fi
+
+clear_reports
+
+RC=0
+for index in "${!MODULES[@]}"; do
+  : > "${MODULE_LOGS[$index]}"
+  MODULE_RC=0
+  if [[ "$MODE" == "base" ]]; then
+    run_mvn "${MODULE_LOGS[$index]}" -pl "${MODULES[$index]}" test \
+      -Dtest="!$FOCUS_TEST" || MODULE_RC=$?
+  else
+    run_mvn "${MODULE_LOGS[$index]}" -pl "${MODULES[$index]}" test \
+      -Dtest="$FOCUS_TEST" || MODULE_RC=$?
+  fi
+  if ! verify_expected_report "$index"; then
+    if [[ "$MODULE_RC" -eq 0 ]]; then
+      MODULE_RC=1
+    fi
+  fi
+  MODULE_RCS[$index]="$MODULE_RC"
+  if [[ "$RC" -eq 0 && "$MODULE_RC" -ne 0 ]]; then
+    RC="$MODULE_RC"
+  fi
+done
+
+write_xml "$RC"
+exit "$RC"
