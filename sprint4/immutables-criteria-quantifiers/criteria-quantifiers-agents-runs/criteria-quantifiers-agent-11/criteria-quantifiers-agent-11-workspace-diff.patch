+  private static void checkQuantifiers(
+      Path path,
+      Expression predicate,
+      Box box,
+      boolean expectedAny,
+      boolean expectedAll,
+      boolean expectedNone) {
+    check(matches(quantifier(IterableOperators.ANY, path, predicate), box) == expectedAny);
+    check(matches(quantifier(IterableOperators.ALL, path, predicate), box) == expectedAll);
+    check(matches(quantifier(IterableOperators.NONE, path, predicate), box) == expectedNone);
+  }
