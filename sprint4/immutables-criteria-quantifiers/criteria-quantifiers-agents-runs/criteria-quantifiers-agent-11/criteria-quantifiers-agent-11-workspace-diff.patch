+  @Test
+  @SuppressWarnings("unchecked")
+  void generatedNestedMatcherChainExecutesAsMongoFind()
+      throws ReflectiveOperationException {
+    insert(
+        "{_id:'all_clean', pets:[{collar:{tags:['friendly']}},{collar:{tags:[]}}]}",
+        "{_id:'contains_rescue', pets:[{collar:{tags:['friendly']}},"
+            + "{collar:{tags:['rescue']}}]}",
+        "{_id:'empty_pets', pets:[]}",
+        "{_id:'missing_tags', pets:[{collar:{}}]}");
+
+    Object allPets = invokeQuantifier(PersonCriteria.person.pets, "all");
+    Method with = allPets.getClass().getMethod("with", UnaryOperator.class);
+    Criterion<?> criterion = (Criterion<?>) with.invoke(
+        allPets,
+        (UnaryOperator<Object>) pet -> {
+          try {
+            Object collar = publicField(pet, "collar");
+            Object tags = publicField(collar, "tags");
+            Object noneTags = invokeQuantifier(tags, "none");
+            return ((StringMatcher.Template<?>) noneTags).is("rescue");
+          } catch (ReflectiveOperationException ex) {
+            throw new AssertionError(ex);
+          }
+        });
+    Expression expression = Criterias.toQuery(criterion).filter().get();
+
+    assertMatches(expression, "all_clean", "empty_pets");
+  }
