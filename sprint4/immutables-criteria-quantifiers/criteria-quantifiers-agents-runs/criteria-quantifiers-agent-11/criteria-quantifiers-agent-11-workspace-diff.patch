+package org.immutables.criteria.matcher;
+
+import java.lang.reflect.Method;
+import java.util.function.UnaryOperator;
+import org.immutables.criteria.Criterias;
+import org.immutables.criteria.Criterion;
+import org.immutables.criteria.expression.Call;
+import org.immutables.criteria.expression.Constant;
+import org.immutables.criteria.expression.Expression;
+import org.immutables.criteria.expression.IterableOperators;
+import org.immutables.criteria.expression.Operator;
+import org.immutables.criteria.expression.Operators;
+import org.immutables.criteria.personmodel.PersonCriteria;
+import org.immutables.criteria.typemodel.IntegerHolderCriteria;
+import org.immutables.criteria.typemodel.StringHolderCriteria;
+import org.junit.jupiter.api.Test;
+
+import static org.immutables.check.Checkers.check;
+
+class CriteriaQuantifiers_6f90c2_ApiTest {
+
+  @Test
+  void allProducesUsableTypedMatcher() throws ReflectiveOperationException {
+    StringMatcher.Template<StringHolderCriteria> elements = quantify("all");
+    Expression filter = Criterias.toQuery(elements.is("x")).filter().get();
+
+    check(containsOperator(filter, IterableOperators.ALL));
+    check(containsOperator(filter, Operators.EQUAL));
+  }
+
+  @Test
+  void noneProducesUsableTypedMatcher() throws ReflectiveOperationException {
+    StringMatcher.Template<StringHolderCriteria> elements = quantify("none");
+    Expression filter = Criterias.toQuery(elements.in("x", "y")).filter().get();
+
+    check(containsOperator(filter, IterableOperators.NONE));
+    check(containsOperator(filter, Operators.IN));
+  }
+
+  @Test
+  void quantifiedMatcherRetainsRootDisjunction() throws ReflectiveOperationException {
+    StringMatcher.Template<StringHolderCriteria> elements = quantify("all");
+    StringHolderCriteria criteria = elements.is("x").or().value.is("fallback");
+    Expression filter = Criterias.toQuery(criteria).filter().get();
+
+    check(containsOperator(filter, IterableOperators.ALL));
+    check(containsOperator(filter, Operators.OR));
+    check(containsOperator(filter, Operators.EQUAL));
+  }
+
+  @Test
+  void objectQuantifiersKeepTheirGenericMatcherContract() throws ReflectiveOperationException {
+    assertGenericQuantifier("all");
+    assertGenericQuantifier("none");
+    assertPetQuantifier("all", IterableOperators.ALL);
+    assertPetQuantifier("none", IterableOperators.NONE);
+  }
+
+  @Test
+  void generatedArrayMatchersExposeUsableQuantifiers()
+      throws ReflectiveOperationException {
+    assertStringArrayQuantifier("all", IterableOperators.ALL);
+    assertStringArrayQuantifier("none", IterableOperators.NONE);
+    assertPrimitiveArrayQuantifier("all", IterableOperators.ALL);
+    assertPrimitiveArrayQuantifier("none", IterableOperators.NONE);
+  }
+
+  private static void assertGenericQuantifier(String name) throws NoSuchMethodException {
+    Method method = IterableMatcher.class.getMethod(name);
+    check(method.getGenericReturnType()).is(IterableMatcher.class.getTypeParameters()[1]);
+  }
+
+  private static void assertPetQuantifier(String name, IterableOperators expected)
+      throws ReflectiveOperationException {
+    Object matcher = invokeQuantifier(PersonCriteria.person.pets, name);
+
+    Criterion<?> traversed = (Criterion<?>) petName(matcher).is("fluffy");
+    Expression traversedFilter = Criterias.toQuery(traversed).filter().get();
+    check(containsOperator(traversedFilter, expected));
+    check(containsOperator(traversedFilter, Operators.EQUAL));
+
+    Method with = matcher.getClass().getMethod("with", UnaryOperator.class);
+    Criterion<?> grouped = (Criterion<?>) with.invoke(matcher, (UnaryOperator<Object>) pet -> {
+      Object first = petName(pet).is("fluffy");
+      return petName(first).is("buddy");
+    });
+    Expression groupedFilter = Criterias.toQuery(grouped).filter().get();
+    check(containsOperator(groupedFilter, expected));
+    check(containsOperator(groupedFilter, Operators.AND));
+    check(containsEqualityConstant(groupedFilter, "fluffy"));
+    check(containsEqualityConstant(groupedFilter, "buddy"));
+
+    Object negatedSource = invokeQuantifier(PersonCriteria.person.pets, name);
+    Method not = negatedSource.getClass().getMethod("not", UnaryOperator.class);
+    Criterion<?> negated = (Criterion<?>) not.invoke(
+        negatedSource, (UnaryOperator<Object>) pet -> petName(pet).is("fluffy"));
+    Expression negatedFilter = Criterias.toQuery(negated).filter().get();
+    check(containsOperator(negatedFilter, expected));
+    check(containsOperator(negatedFilter, Operators.NOT));
+    check(containsEqualityConstant(negatedFilter, "fluffy"));
+  }
+
+  private static void assertStringArrayQuantifier(String name, IterableOperators expected)
+      throws ReflectiveOperationException {
+    StringMatcher.Template<?> elements = (StringMatcher.Template<?>)
+        invokeQuantifier(StringHolderCriteria.stringHolder.array, name);
+    Expression filter = Criterias.toQuery((Criterion<?>) elements.is("x")).filter().get();
+    check(containsOperator(filter, expected));
+    check(containsOperator(filter, Operators.EQUAL));
+  }
+
+  private static void assertPrimitiveArrayQuantifier(String name, IterableOperators expected)
+      throws ReflectiveOperationException {
+    IntegerMatcher.Template<?> elements = (IntegerMatcher.Template<?>)
+        invokeQuantifier(IntegerHolderCriteria.integerHolder.array, name);
+    Expression filter = Criterias.toQuery((Criterion<?>) elements.is(2)).filter().get();
+    check(containsOperator(filter, expected));
+    check(containsOperator(filter, Operators.EQUAL));
+  }
+
+  private static StringMatcher.Template<?> petName(Object matcher) {
+    try {
+      return (StringMatcher.Template<?>) matcher.getClass().getField("name").get(matcher);
+    } catch (ReflectiveOperationException ex) {
+      throw new AssertionError(ex);
+    }
+  }
+
+  @SuppressWarnings("unchecked")
+  private static StringMatcher.Template<StringHolderCriteria> quantify(String method)
+      throws ReflectiveOperationException {
+    return (StringMatcher.Template<StringHolderCriteria>)
+        invokeQuantifier(StringHolderCriteria.stringHolder.list, method);
+  }
+
+  private static Object invokeQuantifier(Object matcher, String method)
+      throws ReflectiveOperationException {
+    Method quantifier = matcher.getClass().getMethod(method);
+    return quantifier.invoke(matcher);
+  }
+
+  private static boolean containsOperator(Expression expression, Operator operator) {
+    if (!(expression instanceof Call)) {
+      return false;
+    }
+    Call call = (Call) expression;
+    if (call.operator() == operator) {
+      return true;
+    }
+    for (Expression argument : call.arguments()) {
+      if (containsOperator(argument, operator)) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  private static boolean containsEqualityConstant(Expression expression, Object expected) {
+    if (!(expression instanceof Call)) {
+      return false;
+    }
+    Call call = (Call) expression;
+    if (call.operator() == Operators.EQUAL && call.arguments().size() == 2) {
+      Expression right = call.arguments().get(1);
+      if (right instanceof Constant && expected.equals(((Constant) right).value())) {
+        return true;
+      }
+    }
+    for (Expression argument : call.arguments()) {
+      if (containsEqualityConstant(argument, expected)) {
+        return true;
+      }
+    }
+    return false;
+  }
+}
