+  private static Expression petNegatedMatcherExpression(String method, String value)
+      throws ReflectiveOperationException {
+    Object matcher = PersonCriteria.person.pets.getClass()
+        .getMethod(method)
+        .invoke(PersonCriteria.person.pets);
+    java.lang.reflect.Method not = matcher.getClass()
+        .getMethod("not", java.util.function.UnaryOperator.class);
+    Criterion<?> criterion = (Criterion<?>) not.invoke(
+        matcher,
+        (java.util.function.UnaryOperator<Object>) pet -> {
+          try {
+            Object name = pet.getClass().getField("name").get(pet);
+            return ((StringMatcher.Template<?>) name).is(value);
+          } catch (ReflectiveOperationException ex) {
+            throw new AssertionError(ex);
+          }
+        });
+    return Criterias.toQuery(criterion).filter().get();
