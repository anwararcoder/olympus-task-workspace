@@ -0,0 +1,71 @@
+/*
+ * Copyright MapStruct Authors.
+ *
+ * Licensed under the Apache License version 2.0, available at http://www.apache.org/licenses/LICENSE-2.0
+ */
+package org.mapstruct.ap.test.collection.mapentry;
+
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+import org.mapstruct.ap.testutil.IssueKey;
+import org.mapstruct.ap.testutil.ProcessorTest;
+import org.mapstruct.ap.testutil.WithClasses;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+@IssueKey("3580")
+@WithClasses({ MapEntryMapper.class, Source.class, Target.class })
+public class MapEntryMappingTest {
+
+    @ProcessorTest
+    public void shouldMapMapEntriesToIterableAndArrayInIterationOrder() {
+        Map<String, Source> source = new LinkedHashMap<>();
+        source.put( "first", source( "one" ) );
+        source.put( "second", source( "two" ) );
+
+        List<Target> targets = MapEntryMapper.INSTANCE.toTargets( source );
+        Target[] targetArray = MapEntryMapper.INSTANCE.toTargetArray( source );
+
+        assertThat( targets ).extracting( Target::getKey ).containsExactly( "first", "second" );
+        assertThat( targets ).extracting( Target::getValue ).containsExactly( "one", "two" );
+        assertThat( targetArray ).extracting( Target::getKey ).containsExactly( "first", "second" );
+    }
+
+    @ProcessorTest
+    public void shouldMapIterableAndArrayElementsToMapEntries() {
+        List<Target> source = Arrays.asList( target( "first", "one" ), target( "second", "two" ) );
+
+        Map<String, Source> fromIterable = MapEntryMapper.INSTANCE.toMap( source );
+        Map<String, Source> fromArray = MapEntryMapper.INSTANCE.toMap( source.toArray( new Target[0] ) );
+
+        assertThat( fromIterable.keySet() ).containsExactly( "first", "second" );
+        assertThat( fromIterable.get( "first" ).getValue() ).isEqualTo( "one" );
+        assertThat( fromArray.get( "second" ).getValue() ).isEqualTo( "two" );
+    }
+
+    @ProcessorTest
+    public void shouldUseConcreteEntryTypeForLowerBoundedMap() {
+        Map<? super String, ? super Source> result = MapEntryMapper.INSTANCE.toLowerBoundMap(
+            Arrays.asList( target( "first", "one" ) )
+        );
+
+        assertThat( result ).containsKey( "first" );
+        assertThat( ( (Source) result.get( "first" ) ).getValue() ).isEqualTo( "one" );
+    }
+
+    private static Source source(String value) {
+        Source source = new Source();
+        source.setValue( value );
+        return source;
+    }
+
+    private static Target target(String key, String value) {
+        Target target = new Target();
+        target.setKey( key );
+        target.setValue( value );
+        return target;
+    }
+}
