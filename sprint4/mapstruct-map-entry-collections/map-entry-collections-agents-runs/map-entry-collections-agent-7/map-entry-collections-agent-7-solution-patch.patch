+package org.mapstruct.ap.test.collection.mapentry;
+
+import java.util.AbstractMap;
+import java.util.List;
+import java.util.Map;
+
+import org.mapstruct.IterableMapping;
+import org.mapstruct.Mapper;
+import org.mapstruct.Mapping;
+import org.mapstruct.Named;
+import org.mapstruct.factory.Mappers;
+
+@Mapper
+public interface MapEntryMapper {
+
+    MapEntryMapper INSTANCE = Mappers.getMapper( MapEntryMapper.class );
+
+    @IterableMapping(qualifiedByName = "fromEntry")
+    List<Target> toTargets(Map<String, Source> source);
+
+    @IterableMapping(qualifiedByName = "fromEntry")
+    Target[] toTargetArray(Map<String, Source> source);
+
+    @Named("fromEntry")
+    @Mapping(target = "key", source = "key")
+    @Mapping(target = "value", source = "value.value")
+    Target fromEntry(Map.Entry<String, Source> source);
+
+    @IterableMapping(qualifiedByName = "toEntry")
+    Map<String, Source> toMap(List<Target> source);
+
+    @IterableMapping(qualifiedByName = "toEntry")
+    Map<String, Source> toMap(Target[] source);
+
+    @Named("toEntry")
+    @Mapping(target = "key", source = "key")
+    @Mapping(target = "value", source = ".")
+    Map.Entry<String, Source> toEntry(Target source);
+
+    Source toSource(Target source);
+
+    @IterableMapping(qualifiedByName = "toConcreteEntry")
+    Map<? super String, ? super Source> toLowerBoundMap(List<Target> source);
+
+    @Named("toConcreteEntry")
+    @Mapping(target = "key", source = "key")
+    @Mapping(target = "value", source = ".")
+    AbstractMap.SimpleEntry<String, Source> toConcreteEntry(Target source);
+}
