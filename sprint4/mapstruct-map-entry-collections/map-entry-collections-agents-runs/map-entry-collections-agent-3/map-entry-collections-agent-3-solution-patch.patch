@@ -0,0 +1,112 @@
+/*
+ * Copyright MapStruct Authors.
+ *
+ * Licensed under the Apache License version 2.0, available at http://www.apache.org/licenses/LICENSE-2.0
+ */
+package org.mapstruct.ap.test.collection.mapentry;
+
+import java.util.AbstractMap;
+import java.util.List;
+import java.util.Map;
+
+import org.mapstruct.IterableMapping;
+import org.mapstruct.Mapper;
+import org.mapstruct.Mapping;
+import org.mapstruct.Named;
+import org.mapstruct.factory.Mappers;
+
+@Mapper
+public interface MapEntryMapper {
+
+    MapEntryMapper INSTANCE = Mappers.getMapper( MapEntryMapper.class );
+
+    List<FlatEntry> map(Map<String, Integer> source);
+
+    FlatEntry[] mapToArray(Map<String, Integer> source);
+
+    Map<String, Long> map(List<FlatEntry> source);
+
+    Map<String, Long> map(FlatEntry[] source);
+
+    TargetContainer map(SourceContainer source);
+
+    @IterableMapping(qualifiedByName = "formattedEntry")
+    List<String> mapFormatted(Map<String, Integer> source);
+
+    @IterableMapping(qualifiedByName = "concreteEntry")
+    Map<? super String, ? super Long> mapLowerBounded(List<FlatEntry> source);
+
+    @Mapping(target = "day", source = "key")
+    @Mapping(target = "amount", source = "value")
+    FlatEntry map(Map.Entry<String, Integer> source);
+
+    @Mapping(target = "key", source = "day")
+    @Mapping(target = "value", source = "amount")
+    Map.Entry<String, Long> map(FlatEntry source);
+
+    @Named("formattedEntry")
+    default String formatEntry(Map.Entry<String, Integer> source) {
+        return source.getKey() + "=" + Integer.toHexString( source.getValue() );
+    }
+
+    @Named("concreteEntry")
+    default AbstractMap.SimpleImmutableEntry<String, Long> concreteEntry(FlatEntry source) {
+        return new AbstractMap.SimpleImmutableEntry<>( source.getDay(), source.getAmount() );
+    }
+
+    class FlatEntry {
+
+        private String day;
+        private long amount;
+
+        public FlatEntry() {
+        }
+
+        public FlatEntry(String day, long amount) {
+            this.day = day;
+            this.amount = amount;
+        }
+
+        public String getDay() {
+            return day;
+        }
+
+        public void setDay(String day) {
+            this.day = day;
+        }
+
+        public long getAmount() {
+            return amount;
+        }
+
+        public void setAmount(long amount) {
+            this.amount = amount;
+        }
+    }
+
+    class SourceContainer {
+
+        private Map<String, Integer> entries;
+
+        public Map<String, Integer> getEntries() {
+            return entries;
+        }
+
+        public void setEntries(Map<String, Integer> entries) {
+            this.entries = entries;
+        }
+    }
+
+    class TargetContainer {
+
+        private List<FlatEntry> entries;
+
+        public List<FlatEntry> getEntries() {
+            return entries;
+        }
+
+        public void setEntries(List<FlatEntry> entries) {
+            this.entries = entries;
+        }
+    }
+}
