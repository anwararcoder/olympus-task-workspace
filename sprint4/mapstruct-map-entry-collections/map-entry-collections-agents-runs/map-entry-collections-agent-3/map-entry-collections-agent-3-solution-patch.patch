@@ -0,0 +1,83 @@
+/*
+ * Copyright MapStruct Authors.
+ *
+ * Licensed under the Apache License version 2.0, available at http://www.apache.org/licenses/LICENSE-2.0
+ */
+package org.mapstruct.ap.test.collection.mapentry;
+
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+import org.mapstruct.ap.test.collection.mapentry.MapEntryMapper.FlatEntry;
+import org.mapstruct.ap.test.collection.mapentry.MapEntryMapper.SourceContainer;
+import org.mapstruct.ap.test.collection.mapentry.MapEntryMapper.TargetContainer;
+import org.mapstruct.ap.testutil.ProcessorTest;
+import org.mapstruct.ap.testutil.WithClasses;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.entry;
+
+@WithClasses(MapEntryMapper.class)
+public class MapEntryMappingTest {
+
+    @ProcessorTest
+    public void shouldMapMapToIterableAndArrayInIterationOrder() {
+        Map<String, Integer> source = new LinkedHashMap<>();
+        source.put( "monday", 11 );
+        source.put( "wednesday", 19 );
+
+        List<FlatEntry> list = MapEntryMapper.INSTANCE.map( source );
+        FlatEntry[] array = MapEntryMapper.INSTANCE.mapToArray( source );
+
+        assertThat( list ).extracting( FlatEntry::getDay ).containsExactly( "monday", "wednesday" );
+        assertThat( list ).extracting( FlatEntry::getAmount ).containsExactly( 11L, 19L );
+        assertThat( array ).extracting( FlatEntry::getDay ).containsExactly( "monday", "wednesday" );
+    }
+
+    @ProcessorTest
+    public void shouldMapIterableAndArrayToMapEntries() {
+        FlatEntry monday = new FlatEntry( "monday", 11 );
+        FlatEntry wednesday = new FlatEntry( "wednesday", 19 );
+
+        Map<String, Long> fromList = MapEntryMapper.INSTANCE.map( Arrays.asList( monday, wednesday ) );
+        Map<String, Long> fromArray = MapEntryMapper.INSTANCE.map( new FlatEntry[] { monday, wednesday } );
+
+        assertThat( fromList ).containsExactly( entry( "monday", 11L ), entry( "wednesday", 19L ) );
+        assertThat( fromArray ).containsExactly( entry( "monday", 11L ), entry( "wednesday", 19L ) );
+    }
+
+    @ProcessorTest
+    public void shouldUseIterableMappingQualifiersForMapEntries() {
+        Map<String, Integer> source = new LinkedHashMap<>();
+        source.put( "first", 15 );
+        source.put( "second", 16 );
+
+        assertThat( MapEntryMapper.INSTANCE.mapFormatted( source ) )
+            .containsExactly( "first=f", "second=10" );
+    }
+
+    @ProcessorTest
+    public void shouldForgeMapAndIterablePropertyMappings() {
+        SourceContainer source = new SourceContainer();
+        Map<String, Integer> entries = new LinkedHashMap<>();
+        entries.put( "monday", 11 );
+        entries.put( "wednesday", 19 );
+        source.setEntries( entries );
+
+        TargetContainer target = MapEntryMapper.INSTANCE.map( source );
+
+        assertThat( target.getEntries() ).extracting( FlatEntry::getDay )
+            .containsExactly( "monday", "wednesday" );
+    }
+
+    @ProcessorTest
+    public void shouldUseConcreteEntryTypeForLowerBoundedMap() {
+        Map<? super String, ? super Long> result = MapEntryMapper.INSTANCE.mapLowerBounded(
+            Arrays.asList( new FlatEntry( "monday", 11 ) )
+        );
+
