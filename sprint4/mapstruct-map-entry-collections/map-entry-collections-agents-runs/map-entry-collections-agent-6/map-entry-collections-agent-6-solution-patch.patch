+/*
+ * Copyright MapStruct Authors.
+ *
+ * Licensed under the Apache License version 2.0, available at http://www.apache.org/licenses/LICENSE-2.0
+ */
+package org.mapstruct.ap.test.collection.mapentry;
+
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+import org.mapstruct.ap.testutil.ProcessorTest;
+import org.mapstruct.ap.testutil.WithClasses;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.entry;
+
+@WithClasses({
+    MapEntryMapper.class,
+    PropertyMapEntryMapper.class,
+    EntryDto.class,
+    Source.class,
+    Target.class
+})
+public class MapEntryMappingTest {
+
+    @ProcessorTest
+    public void shouldMapMapEntriesToIterableAndArrayInIterationOrder() {
+        Map<String, Integer> source = sourceMap();
+
+        List<EntryDto> list = MapEntryMapper.INSTANCE.mapToList( source );
+        EntryDto[] array = MapEntryMapper.INSTANCE.mapToArray( source );
+
+        assertEntries( list );
+        assertEntries( Arrays.asList( array ) );
+    }
+
+    @ProcessorTest
+    public void shouldUseIterableMappingQualifierForMapEntries() {
+        List<EntryDto> result = MapEntryMapper.INSTANCE.mapQualified( sourceMap() );
+
+        assertThat( result ).extracting( EntryDto::getKey )
+            .containsExactly( "qualified-first", "qualified-second" );
+    }
+
+    @ProcessorTest
+    public void shouldMapIterableElementsToMapEntries() {
+        Map<String, Integer> result = MapEntryMapper.INSTANCE.mapToMap( entryDtos() );
+
+        assertThat( result ).containsExactly(
+            entry( "first", 1 ),
+            entry( "second", 2 )
+        );
+    }
+
+    @ProcessorTest
+    public void shouldMapArrayAndIterableElementsToMapEntries() {
+        List<EntryDto> entries = entryDtos();
+
+        Map<String, Integer> arrayResult = MapEntryMapper.INSTANCE.mapArrayToMap(
+            entries.toArray( new EntryDto[0] )
+        );
+        Map<String, Integer> iterableResult = MapEntryMapper.INSTANCE.mapIterableToMap( entries );
+
+        assertThat( arrayResult ).containsExactly(
+            entry( "first", 1 ),
+            entry( "second", 2 )
+        );
+        assertThat( iterableResult ).containsExactly(
+            entry( "first", 1 ),
+            entry( "second", 2 )
+        );
+    }
+
+    @ProcessorTest
+    public void shouldUseConcreteEntryTypeForLowerBoundedMap() {
+        Map<? super String, ? super Integer> result = MapEntryMapper.INSTANCE.mapToLowerBoundedMap( entryDtos() );
+
+        assertThat( result ).containsExactly(
+            entry( "first", 1 ),
+            entry( "second", 2 )
+        );
+    }
+
+    @ProcessorTest
+    public void shouldForgePropertyMappingsUsingEntryMappingMethods() {
+        Source source = new Source();
+        source.setEntries( sourceMap() );
+        source.setEntryDtos( entryDtos() );
+
+        Target result = PropertyMapEntryMapper.INSTANCE.map( source );
+
+        assertEntries( result.getEntries() );
+        assertThat( result.getEntryDtos() ).containsExactly(
+            entry( "first", 1 ),
+            entry( "second", 2 )
+        );
+    }
+
+    private static Map<String, Integer> sourceMap() {
+        Map<String, Integer> source = new LinkedHashMap<>();
+        source.put( "first", 1 );
+        source.put( "second", 2 );
+        return source;
+    }
+
+    private static List<EntryDto> entryDtos() {
+        EntryDto first = new EntryDto();
+        first.setKey( "first" );
+        first.setValue( 1 );
+        EntryDto second = new EntryDto();
+        second.setKey( "second" );
+        second.setValue( 2 );
+        return Arrays.asList( first, second );
+    }
+
+    private static void assertEntries(List<EntryDto> entries) {
+        assertThat( entries ).extracting( EntryDto::getKey )
+            .containsExactly( "first", "second" );
+        assertThat( entries ).extracting( EntryDto::getValue )
+            .containsExactly( 1, 2 );
+    }
+}
