+ */
+package org.mapstruct.ap.test.collection.mapentry;
+
+import java.util.AbstractMap;
+import java.util.List;
+import java.util.Map;
+
+import org.mapstruct.IterableMapping;
+import org.mapstruct.Mapper;
+import org.mapstruct.Mapping;
+import org.mapstruct.Named;
+import org.mapstruct.factory.Mappers;
+
+@Mapper
+public interface MapEntryMapper {
+
+    MapEntryMapper INSTANCE = Mappers.getMapper( MapEntryMapper.class );
+
+    List<EntryDto> mapToList(Map<String, Integer> source);
+
+    EntryDto[] mapToArray(Map<String, Integer> source);
+
+    @IterableMapping(qualifiedByName = "qualifiedEntry")
+    List<EntryDto> mapQualified(Map<String, Integer> source);
+
+    Map<String, Integer> mapToMap(List<EntryDto> source);
+
+    Map<String, Integer> mapArrayToMap(EntryDto[] source);
+
+    Map<String, Integer> mapIterableToMap(Iterable<EntryDto> source);
+
+    @IterableMapping(qualifiedByName = "concreteEntry")
+    Map<? super String, ? super Integer> mapToLowerBoundedMap(List<EntryDto> source);
+
+    EntryDto mapEntry(Map.Entry<String, Integer> source);
+
+    @Mapping(target = "key", source = "key")
+    @Mapping(target = "value", source = "value")
+    Map.Entry<String, Integer> mapEntry(EntryDto source);
+
+    @Named("qualifiedEntry")
+    default EntryDto mapQualifiedEntry(Map.Entry<String, Integer> source) {
+        EntryDto target = new EntryDto();
+        target.setKey( "qualified-" + source.getKey() );
+        target.setValue( source.getValue() );
+        return target;
+    }
+
+    @Named("concreteEntry")
+    default AbstractMap.SimpleEntry<String, Integer> mapConcreteEntry(EntryDto source) {
+        return new AbstractMap.SimpleEntry<>( source.getKey(), source.getValue() );
+    }
+}
