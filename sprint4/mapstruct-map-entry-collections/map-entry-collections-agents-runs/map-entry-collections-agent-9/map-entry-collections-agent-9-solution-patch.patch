+/*
+ * Copyright MapStruct Authors.
+ *
+ * Licensed under the Apache License version 2.0, available at http://www.apache.org/licenses/LICENSE-2.0
+ */
+package org.mapstruct.ap.test.collection.entrymapping;
+
+import java.util.AbstractMap;
+import java.util.List;
+import java.util.Map;
+
+import org.mapstruct.IterableMapping;
+import org.mapstruct.Mapper;
+import org.mapstruct.Mapping;
+import org.mapstruct.Named;
+import org.mapstruct.factory.Mappers;
+
+@Mapper
+public interface EntryMappingMapper {
+
+    EntryMappingMapper INSTANCE = Mappers.getMapper( EntryMappingMapper.class );
+
+    @IterableMapping( qualifiedByName = "forward" )
+    List<EntryTarget> toList(Map<String, Integer> source);
+
+    @IterableMapping( qualifiedByName = "forward" )
+    EntryTarget[] toArray(Map<String, Integer> source);
+
+    @IterableMapping( qualifiedByName = "reverse" )
+    Map<String, Integer> toMap(List<EntrySource> source);
+
+    @IterableMapping( qualifiedByName = "reverse" )
+    Map<String, Integer> toMap(EntrySource[] source);
+
+    @IterableMapping( qualifiedByName = "lowerBounded" )
+    Map<? super String, ? super Integer> toLowerBoundedMap(List<EntrySource> source);
+
+    @Named("forward")
+    EntryTarget mapForward(Map.Entry<String, Integer> source);
+
+    @Named("reverse")
+    @Mapping( target = "key", source = "key" )
+    @Mapping( target = "value", source = "value" )
+    Map.Entry<String, Integer> mapReverse(EntrySource source);
+
+    @Named("lowerBounded")
+    default AbstractMap.SimpleEntry<String, Integer> mapLowerBounded(EntrySource source) {
+        return new AbstractMap.SimpleEntry<>( source.getKey(), source.getValue() );
+    }
+}
