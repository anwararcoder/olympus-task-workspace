diff --git a/processor/src/test/java/org/mapstruct/ap/test/collection/entry/MapAndIterableEntryMappingTest.java b/processor/src/test/java/org/mapstruct/ap/test/collection/entry/MapAndIterableEntryMappingTest.java
new file mode 100644
index 0000000..ba536ec
--- /dev/null
+++ b/processor/src/test/java/org/mapstruct/ap/test/collection/entry/MapAndIterableEntryMappingTest.java
@@ -0,0 +1,79 @@
+/*
+ * Copyright MapStruct Authors.
+ *
+ * Licensed under the Apache License version 2.0, available at http://www.apache.org/licenses/LICENSE-2.0
+ */
+package org.mapstruct.ap.test.collection.entry;
+
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+import org.mapstruct.ap.testutil.ProcessorTest;
+import org.mapstruct.ap.testutil.WithClasses;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.entry;
+
+@WithClasses({ EntryMapper.class, Pair.class, LowerPair.class, EntrySource.class, EntryTarget.class })
+public class MapAndIterableEntryMappingTest {
+
+    @ProcessorTest
+    public void shouldMapMapEntriesToIterableAndArrayInIterationOrder() {
+        Map<String, Integer> source = new LinkedHashMap<>();
+        source.put( "first", 1 );
+        source.put( "second", 2 );
+
+        assertThat( EntryMapper.INSTANCE.mapToList( source ) )
+            .containsExactly( "first=1", "second=2" );
+        assertThat( EntryMapper.INSTANCE.mapToArray( source ) )
+            .containsExactly( "first=1", "second=2" );
+        assertThat( EntryMapper.INSTANCE.qualifiedMapToList( source ) )
+            .containsExactly( "[first:1]", "[second:2]" );
+    }
+
+    @ProcessorTest
+    public void shouldMapIterableAndArrayElementsToEntries() {
+        List<Pair> source = Arrays.asList( new Pair( "first", 1 ), new Pair( "second", 2 ) );
+
+        assertThat( EntryMapper.INSTANCE.iterableToMap( source ) )
+            .containsExactly( entry( "first", "1" ), entry( "second", "2" ) );
+        assertThat( EntryMapper.INSTANCE.arrayToMap( source.toArray( new Pair[0] ) ) )
+            .containsExactly( entry( "first", "1" ), entry( "second", "2" ) );
+        assertThat( EntryMapper.INSTANCE.qualifiedIterableToMap( source ) )
+            .containsExactly( entry( "first", "value-1" ), entry( "second", "value-2" ) );
+    }
+
+    @ProcessorTest
+    public void shouldMapAbstractEntryThroughLogicalProperties() {
+        Map.Entry<String, String> result = EntryMapper.INSTANCE.pairToEntry( new Pair( "answer", 42 ) );
+
+        assertThat( result ).isEqualTo( entry( "answer", "42" ) );
+    }
+
+    @ProcessorTest
+    public void shouldMapMapAndIterableProperties() {
+        Map<String, Integer> values = new LinkedHashMap<>();
+        values.put( "first", 1 );
+        values.put( "second", 2 );
+        EntrySource source = new EntrySource();
+        source.setValues( values );
+        source.setPairs( Arrays.asList( new Pair( "first", 1 ), new Pair( "second", 2 ) ) );
+
+        EntryTarget result = EntryMapper.INSTANCE.sourceToTarget( source );
+
+        assertThat( result.getValues() ).containsExactly( "first=1", "second=2" );
+        assertThat( result.getPairs() )
+            .containsExactly( entry( "first", "1" ), entry( "second", "2" ) );
+    }
+
+    @ProcessorTest
+    public void shouldUseConcreteEntryForLowerBoundedMap() {
+        Map<? super String, ? super Integer> result = EntryMapper.INSTANCE.lowerBoundedMap(
+            Arrays.asList( new LowerPair( "answer", 42 ) )
+        );
+
+        assertThat( result ).containsEntry( "answer", 42 );
+    }
+}
