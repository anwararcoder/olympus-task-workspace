+    for ( <@includeModel object=sourceElementType/> ${loopVariableName} : ${sourceParameter.name} ) {
+        <@includeModel object=elementAssignment targetWriteAccessorName=entryVariableName targetType=resultEntryType/>
+        ${resultName}.put( ${entryVariableName}.getKey(), ${entryVariableName}.getValue() );
+    }
+    <#list afterMappingReferences as callback>
+        <#if callback_index = 0>
+
+        </#if>
+        <@includeModel object=callback targetBeanName=resultName targetType=resultType/>
+    </#list>
+    <#if returnType.name != "void">
+
+        return ${resultName};
+    </#if>
+}
+<#macro throws>
+    <#if (thrownTypes?size > 0)><#lt> throws </#if><@compress single_line=true>
+        <#list thrownTypes as exceptionType>
+            <@includeModel object=exceptionType/>
+            <#if exceptionType_has_next>, </#if><#t>
+        </#list>
+    </@compress>
+</#macro>
