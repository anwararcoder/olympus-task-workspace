+/*
+ * Copyright MapStruct Authors.
+ *
+ * Licensed under the Apache License version 2.0, available at http://www.apache.org/licenses/LICENSE-2.0
+ */
+package org.mapstruct.ap.test.collection.entry;
+
+import java.util.AbstractMap;
+import java.util.List;
+import java.util.Map;
+
+import org.mapstruct.IterableMapping;
+import org.mapstruct.Mapper;
+import org.mapstruct.Mapping;
+import org.mapstruct.Named;
+import org.mapstruct.factory.Mappers;
+
+@Mapper
+public interface EntryMapper {
+
+    EntryMapper INSTANCE = Mappers.getMapper( EntryMapper.class );
+
+    List<String> mapToList(Map<String, Integer> source);
+
+    String[] mapToArray(Map<String, Integer> source);
+
+    default String entryToString(Map.Entry<String, Integer> entry) {
+        return entry.getKey() + "=" + entry.getValue();
+    }
+
+    @Named("qualifiedMap")
+    @IterableMapping(qualifiedByName = "bracketed")
+    List<String> qualifiedMapToList(Map<String, Integer> source);
+
+    @Named("bracketed")
+    default String qualifiedEntryToString(Map.Entry<String, Integer> entry) {
+        return "[" + entry.getKey() + ":" + entry.getValue() + "]";
+    }
+
+    Map<String, String> iterableToMap(List<Pair> source);
+
+    Map<String, String> arrayToMap(Pair[] source);
+
+    @Named("qualifiedIterable")
+    @IterableMapping(qualifiedByName = "qualifiedPair")
+    Map<String, String> qualifiedIterableToMap(List<Pair> source);
+
+    @Named("qualifiedPair")
+    default AbstractMap.SimpleEntry<String, String> qualifiedPairToEntry(Pair source) {
+        return new AbstractMap.SimpleEntry<>( source.getKey(), "value-" + source.getValue() );
+    }
+
+    @Mapping(target = "key", source = "key")
+    @Mapping(target = "value", source = "value")
+    Map.Entry<String, String> pairToEntry(Pair source);
+
+    Map<? super String, ? super Integer> lowerBoundedMap(List<LowerPair> source);
+
+    default AbstractMap.SimpleEntry<String, Integer> lowerPairToEntry(LowerPair source) {
+        return new AbstractMap.SimpleEntry<>( source.getKey(), source.getValue() );
+    }
+
+    EntryTarget sourceToTarget(EntrySource source);
+}
