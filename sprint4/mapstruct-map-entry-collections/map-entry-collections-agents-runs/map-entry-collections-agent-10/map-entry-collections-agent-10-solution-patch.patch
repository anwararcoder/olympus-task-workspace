+/**
+ * A {@link MappingMethod} implemented by a {@link Mapper} class which maps an iterable type to a map. Each source
+ * element is mapped to a {@link Map.Entry}, whose key and value are added to the result map.
+ */
+public class IterableToMapMappingMethod extends ContainerMappingMethod {
+
+    public static class Builder extends ContainerMappingMethodBuilder<Builder, IterableToMapMappingMethod> {
+
+        private Type resultEntryType;
+
+        public Builder() {
+            super( Builder.class, "collection element" );
+        }
+
+        @Override
+        protected Type getElementType(Type parameterType) {
+            if ( parameterType.isMapType() ) {
+                List<Type> typeArguments = parameterType.determineTypeArguments( Map.class );
+                return ctx.getTypeFactory().getMapEntryType( typeArguments.get( 0 ), typeArguments.get( 1 ) );
+            }
+            return parameterType.isArrayType() ? parameterType.getComponentType() : first(
+                parameterType.determineTypeArguments( Iterable.class ) ).getTypeBound();
+        }
+
+        @Override
+        protected Assignment getWrapper(Assignment assignment, Method method) {
+            resultEntryType = getAssignmentResultType( assignment, getElementType( method.getResultType() ) );
+            return new LocalVarWrapper( assignment, method.getThrownTypes(), resultEntryType, false );
+        }
+
+        private Type getAssignmentResultType(Assignment assignment, Type fallbackType) {
+            if ( assignment == null ) {
+                return fallbackType;
+            }
+            else if ( assignment instanceof AssignmentWrapper ) {
+                return getAssignmentResultType( ( (AssignmentWrapper) assignment ).getAssignment(), fallbackType );
+            }
+            else if ( assignment instanceof MethodReference ) {
+                Type returnType = ( (MethodReference) assignment ).getReturnType();
+                if ( returnType != null && !returnType.isVoid() && returnType.isAssignableTo( fallbackType ) ) {
+                    return returnType;
+                }
+            }
+            else if ( assignment.getType().isDirect() && assignment.getSourceType().isAssignableTo( fallbackType ) ) {
+                return assignment.getSourceType();
+            }
+            return fallbackType;
+        }
+
+        @Override
+        protected IterableToMapMappingMethod instantiateMappingMethod(Method method,
+            Collection<String> existingVariables, Assignment assignment, MethodReference factoryMethod,
+            boolean mapNullToDefault, String loopVariableName,
+            List<LifecycleCallbackMethodReference> beforeMappingMethods,
+            List<LifecycleCallbackMethodReference> afterMappingMethods, SelectionParameters selectionParameters,
+            PresenceCheck sourceParameterPresenceCheck) {
+            Type sourceElementType = getElementType( first( method.getSourceParameters() ).getType() );
+            return new IterableToMapMappingMethod(
+                method,
+                getMethodAnnotations(),
+                existingVariables,
+                assignment,
+                factoryMethod,
+                mapNullToDefault,
+                loopVariableName,
+                beforeMappingMethods,
+                afterMappingMethods,
+                selectionParameters,
+                sourceParameterPresenceCheck,
+                sourceElementType,
+                resultEntryType
+            );
+        }
+    }
+
+    private final Type sourceElementType;
+    private final Type resultEntryType;
+    private final String entryVariableName;
+
+    //CHECKSTYLE:OFF
+    private IterableToMapMappingMethod(Method method, List<Annotation> annotations,
+                                       Collection<String> existingVariables, Assignment parameterAssignment,
+                                       MethodReference factoryMethod, boolean mapNullToDefault, String loopVariableName,
+                                       List<LifecycleCallbackMethodReference> beforeMappingReferences,
+                                       List<LifecycleCallbackMethodReference> afterMappingReferences,
+        SelectionParameters selectionParameters, PresenceCheck sourceParameterPresenceCheck, Type sourceElementType,
+        Type resultEntryType) {
+        //CHECKSTYLE:ON
+        super(
+            method,
+            annotations,
+            existingVariables,
+            parameterAssignment,
+            factoryMethod,
+            mapNullToDefault,
+            loopVariableName,
+            beforeMappingReferences,
+            afterMappingReferences,
+            selectionParameters,
+            sourceParameterPresenceCheck
+        );
+        this.sourceElementType = sourceElementType;
+        this.resultEntryType = resultEntryType;
+        this.entryVariableName = Strings.getSafeVariableName( "entry", existingVariables );
+    }
+
+    @Override
+    public Set<Type> getImportTypes() {
+        Set<Type> types = super.getImportTypes();
+        types.add( sourceElementType );
+        types.add( resultEntryType );
+        return types;
+    }
+
+    public Type getSourceElementType() {
+        return sourceElementType;
+    }
+
+    @Override
+    public Type getResultElementType() {
+        return resultEntryType;
+    }
+
+    public Type getResultEntryType() {
+        return resultEntryType;
+    }
+
+    public String getEntryVariableName() {
+        return entryVariableName;
+    }
+}
