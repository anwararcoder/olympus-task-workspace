+ *
+ * Licensed under the Apache License version 2.0, available at http://www.apache.org/licenses/LICENSE-2.0
+ */
+package org.mapstruct.ap.test.collection.mapentry;
+
+import java.util.AbstractMap;
+import java.util.List;
+import java.util.Map;
+
+import org.mapstruct.IterableMapping;
+import org.mapstruct.Mapper;
+import org.mapstruct.Mapping;
+import org.mapstruct.Named;
+import org.mapstruct.factory.Mappers;
+
+@Mapper
+public interface EntryMapper {
+
+    EntryMapper INSTANCE = Mappers.getMapper( EntryMapper.class );
+
+    List<String> mapToList(Map<Integer, String> source);
+
+    String[] mapToArray(Map<Integer, String> source);
+
+    Map<Integer, String> mapToMap(List<Item> source);
+
+    Map<Integer, String> mapArrayToMap(Item[] source);
+
+    Map<? super Integer, ? super String> mapToLowerBoundedMap(Iterable<ConcreteItem> source);
+
+    @IterableMapping(qualifiedByName = "qualifiedEntry")
+    List<String> mapQualified(Map<Integer, String> source);
+
+    default String mapEntry(Map.Entry<Integer, String> entry) {
+        return entry.getKey() + ":" + entry.getValue();
+    }
+
+    @Named("qualifiedEntry")
+    default String mapQualifiedEntry(Map.Entry<Integer, String> entry) {
+        return entry.getValue().toUpperCase();
+    }
+
+    @Mapping(target = "key", source = "id")
+    @Mapping(target = "value", source = "name")
+    Map.Entry<Integer, String> mapItem(Item item);
+
+    default AbstractMap.SimpleEntry<Integer, String> mapConcreteItem(ConcreteItem item) {
+        return new AbstractMap.SimpleEntry<>( item.getId(), item.getName() );
+    }
+}
+
+class Item {
+
+    private final Integer id;
+    private final String name;
+
+    Item(Integer id, String name) {
+        this.id = id;
+        this.name = name;
+    }
+
+    public Integer getId() {
+        return id;
+    }
+
+    public String getName() {
+        return name;
+    }
+}
+
+class ConcreteItem extends Item {
+
+    ConcreteItem(Integer id, String name) {
+        super( id, name );
+    }
+}
