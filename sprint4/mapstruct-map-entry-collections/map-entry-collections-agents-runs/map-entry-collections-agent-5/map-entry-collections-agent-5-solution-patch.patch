+package org.mapstruct.ap.test.collection.mapentry;
+
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+import org.mapstruct.ap.testutil.ProcessorTest;
+import org.mapstruct.ap.testutil.WithClasses;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+@WithClasses(EntryMapper.class)
+public class MapEntryMappingTest {
+
+    @ProcessorTest
+    public void shouldMapMapEntriesToIterableAndArrayInIterationOrder() {
+        Map<Integer, String> source = new LinkedHashMap<>();
+        source.put( 2, "two" );
+        source.put( 1, "one" );
+
+        assertThat( EntryMapper.INSTANCE.mapToList( source ) ).containsExactly( "2:two", "1:one" );
+        assertThat( EntryMapper.INSTANCE.mapToArray( source ) ).containsExactly( "2:two", "1:one" );
+        assertThat( EntryMapper.INSTANCE.mapQualified( source ) ).containsExactly( "TWO", "ONE" );
+    }
+
+    @ProcessorTest
+    public void shouldMapIterableAndArrayElementsToEntries() {
+        List<Item> source = Arrays.asList( new Item( 2, "two" ), new Item( 1, "one" ) );
+        Map<Integer, String> expected = new LinkedHashMap<>();
+        expected.put( 2, "two" );
+        expected.put( 1, "one" );
+
+        assertThat( EntryMapper.INSTANCE.mapToMap( source ) ).containsExactlyEntriesOf( expected );
+        assertThat( EntryMapper.INSTANCE.mapArrayToMap( source.toArray( new Item[0] ) ) )
+            .containsExactlyEntriesOf( expected );
+    }
+
+    @ProcessorTest
+    public void shouldMapToLowerBoundedMapUsingConcreteEntryMapping() {
+        Map<? super Integer, ? super String> result = EntryMapper.INSTANCE.mapToLowerBoundedMap(
+            Arrays.asList( new ConcreteItem( 3, "three" ) )
+        );
+
+        assertThat( result ).containsEntry( 3, "three" );
+    }
+}
