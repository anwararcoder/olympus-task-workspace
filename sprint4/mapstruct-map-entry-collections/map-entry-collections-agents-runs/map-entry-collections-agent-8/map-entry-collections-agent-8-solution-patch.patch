+ */
+package org.mapstruct.ap.test.collection.entrymapping;
+
+public class EntrySource {
+
+    private String name;
+    private Integer value;
+
+    public EntrySource() {
+    }
+
+    public EntrySource(String name, Integer value) {
+        this.name = name;
+        this.value = value;
+    }
+
+    public String getName() {
+        return name;
+    }
+
+    public void setName(String name) {
+        this.name = name;
+    }
+
+    public Integer getValue() {
+        return value;
+    }
+
+    public void setValue(Integer value) {
+        this.value = value;
