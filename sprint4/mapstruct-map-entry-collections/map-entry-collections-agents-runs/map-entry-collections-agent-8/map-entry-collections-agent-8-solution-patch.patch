+/*
+ * Copyright MapStruct Authors.
+ *
+ * Licensed under the Apache License version 2.0, available at http://www.apache.org/licenses/LICENSE-2.0
+ */
+package org.mapstruct.ap.test.collection.entrymapping;
+
+import java.util.AbstractMap;
+import java.util.List;
+import java.util.Map;
+
+import org.mapstruct.IterableMapping;
+import org.mapstruct.Mapper;
+import org.mapstruct.Mapping;
+import org.mapstruct.Named;
+import org.mapstruct.factory.Mappers;
+
+@Mapper
+public interface EntryMappingMapper {
+
+    EntryMappingMapper INSTANCE = Mappers.getMapper( EntryMappingMapper.class );
+
+    @Named("entryList")
+    List<String> map(Map<String, Integer> source);
+
+    String[] mapToArray(Map<String, Integer> source);
+
+    @IterableMapping(qualifiedByName = "qualifiedEntry")
+    List<String> mapQualified(Map<String, Integer> source);
+
+    Map<String, Integer> map(List<EntrySource> source);
+
+    Map<String, Integer> map(EntrySource[] source);
+
+    @IterableMapping(qualifiedByName = "lowerBoundedEntry")
+    Map<? super String, ? super Integer> mapLowerBounded(List<EntrySource> source);
+
+    @Mapping(target = "values", qualifiedByName = "entryList")
+    TargetContainer map(SourceContainer source);
+
+    default String mapEntry(Map.Entry<String, Integer> entry) {
+        return entry.getKey() + ":" + entry.getValue();
+    }
+
+    @Named("qualifiedEntry")
+    default String mapQualifiedEntry(Map.Entry<String, Integer> entry) {
+        return entry.getKey().toUpperCase() + ":" + entry.getValue();
+    }
+
+    @Mapping(target = "key", source = "name")
+    @Mapping(target = "value", source = "value")
+    Map.Entry<String, Integer> mapEntry(EntrySource source);
+
+    @Named("lowerBoundedEntry")
+    default ConcreteEntry mapLowerBoundedEntry(EntrySource source) {
+        return new ConcreteEntry( source.getName(), source.getValue() );
+    }
+
+    class ConcreteEntry extends AbstractMap.SimpleEntry<String, Integer> {
+
+        public ConcreteEntry(String key, Integer value) {
+            super( key, value );
+        }
+    }
+}
