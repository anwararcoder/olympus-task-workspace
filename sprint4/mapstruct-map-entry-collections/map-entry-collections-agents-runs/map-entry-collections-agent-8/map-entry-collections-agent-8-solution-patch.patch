@@ -0,0 +1,84 @@
+/*
+ * Copyright MapStruct Authors.
+ *
+ * Licensed under the Apache License version 2.0, available at http://www.apache.org/licenses/LICENSE-2.0
+ */
+package org.mapstruct.ap.test.collection.entrymapping;
+
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+import org.mapstruct.ap.testutil.IssueKey;
+import org.mapstruct.ap.testutil.ProcessorTest;
+import org.mapstruct.ap.testutil.WithClasses;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+@IssueKey("3580")
+@WithClasses({
+    EntryMappingMapper.class,
+    EntrySource.class,
+    SourceContainer.class,
+    TargetContainer.class
+})
+public class EntryMappingTest {
+
+    @ProcessorTest
+    public void shouldMapMapEntriesToIterableAndArrayInIterationOrder() {
+        Map<String, Integer> source = sourceMap();
+
+        assertThat( EntryMappingMapper.INSTANCE.map( source ) )
+            .containsExactly( "first:1", "second:2" );
+        assertThat( EntryMappingMapper.INSTANCE.mapToArray( source ) )
+            .containsExactly( "first:1", "second:2" );
+    }
+
+    @ProcessorTest
+    public void shouldUseIterableMappingQualifierForMapEntries() {
+        assertThat( EntryMappingMapper.INSTANCE.mapQualified( sourceMap() ) )
+            .containsExactly( "FIRST:1", "SECOND:2" );
+    }
+
+    @ProcessorTest
+    public void shouldMapIterableElementsToEntries() {
+        EntrySource[] entries = {
+            new EntrySource( "first", 1 ),
+            new EntrySource( "second", 2 )
+        };
+        List<EntrySource> source = Arrays.asList( entries );
+
+        assertThat( EntryMappingMapper.INSTANCE.map( source ) )
+            .containsExactlyEntriesOf( sourceMap() );
+        assertThat( EntryMappingMapper.INSTANCE.map( entries ) )
+            .containsExactlyEntriesOf( sourceMap() );
+    }
+
+    @ProcessorTest
+    public void shouldSupportConcreteEntriesForLowerBoundedMapResults() {
+        List<EntrySource> source = Arrays.asList(
+            new EntrySource( "first", 1 ),
+            new EntrySource( "second", 2 )
+        );
+
+        assertThat( EntryMappingMapper.INSTANCE.mapLowerBounded( source ) )
+            .containsExactlyEntriesOf( sourceMap() );
+    }
+
+    @ProcessorTest
+    public void shouldForgeMapEntryIterablePropertyMapping() {
+        SourceContainer source = new SourceContainer();
+        source.setValues( sourceMap() );
+
+        assertThat( EntryMappingMapper.INSTANCE.map( source ).getValues() )
+            .containsExactly( "first:1", "second:2" );
+    }
+
+    private Map<String, Integer> sourceMap() {
+        Map<String, Integer> source = new LinkedHashMap<>();
+        source.put( "first", 1 );
+        source.put( "second", 2 );
+        return source;
+    }
+}
