@@ -0,0 +1,62 @@
+/*
+ * Copyright MapStruct Authors.
+ *
+ * Licensed under the Apache License version 2.0, available at http://www.apache.org/licenses/LICENSE-2.0
+ */
+package org.mapstruct.ap.test.collection.mapentry;
+
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+import org.mapstruct.ap.testutil.ProcessorTest;
+import org.mapstruct.ap.testutil.WithClasses;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.entry;
+
+@WithClasses({ MapEntryMapper.class, Source.class, Target.class })
+public class MapEntryMappingTest {
+
+    @ProcessorTest
+    public void shouldMapMapEntriesToIterableAndArrayInIterationOrder() {
+        Map<String, Integer> source = new LinkedHashMap<>();
+        source.put( "first", 1 );
+        source.put( "second", 2 );
+
+        assertThat( MapEntryMapper.INSTANCE.toTargets( source ) )
+            .extracting( Target::getKey, Target::getValue )
+            .containsExactly(
+                org.assertj.core.groups.Tuple.tuple( "first", 1 ),
+                org.assertj.core.groups.Tuple.tuple( "second", 2 )
+            );
+        assertThat( MapEntryMapper.INSTANCE.toTargetArray( source ) )
+            .extracting( Target::getKey )
+            .containsExactly( "first", "second" );
+    }
+
+    @ProcessorTest
+    public void shouldMapIterableElementsToEntriesAndMap() {
+        List<Source> source = Arrays.asList(
+            new Source( "first", 1 ),
+            new Source( "second", 2 )
+        );
+
+        Map<String, Integer> result = MapEntryMapper.INSTANCE.toMap( source );
+        Map<? super String, ? super Integer> lowerBoundedResult = MapEntryMapper.INSTANCE.toLowerBoundedMap( source );
+
+        assertThat( result ).containsExactly( entry( "first", 1 ), entry( "second", 2 ) );
+        assertThat( lowerBoundedResult ).containsExactly( entry( "first", 1 ), entry( "second", 2 ) );
+    }
+
+    @ProcessorTest
+    public void shouldApplyIterableMappingQualifierToEntries() {
+        Map<String, Integer> source = new LinkedHashMap<>();
+        source.put( "first", 1 );
+
+        assertThat( MapEntryMapper.INSTANCE.toQualifiedTargets( source ) )
+            .extracting( Target::getKey )
+            .containsExactly( "qualified-first" );
+    }
+}
