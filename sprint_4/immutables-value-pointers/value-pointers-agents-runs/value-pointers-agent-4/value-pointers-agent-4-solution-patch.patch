index 0000000..d961e58
--- /dev/null
+++ b/value-processor/src/org/immutables/value/processor/Pointers.generator
@@ -0,0 +1,495 @@
+[template public generate]
+  [for type in values.values if type.generatePointers]
+[output.java type.package (type.typeAbstract.simple 'Pointers') type.element]
+[type.sourceHeader]
+[if type.package]package [type.package];[/if]
+[for String arr = '[]']
+
+[if type allowsClasspathAnnotation 'javax.annotation.processing.Generated']
+@javax.annotation.processing.Generated("org.immutables.processor.ProxyProcessor")
+[else if type allowsClasspathAnnotation '[jaxarta].annotation.Generated']
+@[jaxarta].annotation.Generated("org.immutables.processor.ProxyProcessor")
+[/if]
+public final class [type.typeAbstract.simple]Pointers {
+  private static final int SCALAR = 0;
+  private static final int OPTIONAL = 1;
+  private static final int LIST = 2;
+  private static final int ARRAY = 3;
+  private static final int MAP = 4;
+  private static final int BLOCKED = 5;
+
+  private static final Implementation[arr] IMPLEMENTATIONS = {
+  [for implementation in type.pointerImplementations]
+    [if not for.first],[/if]new Implementation([implementation.typeImmutable].class, new Attribute[arr] {
+    [for attribute in implementation.pointerAttributes]
+      [if not for.first],[/if]new Attribute([implementation.typeImmutable].class, "[attribute.name]", "[attribute.names.get]", "[attribute.names.with]",
+          [if attribute.optionalType]OPTIONAL[else if attribute.pointerBlockedContainer]BLOCKED[else if attribute.listType]LIST[else if attribute.referenceArrayType]ARRAY[else if attribute.pointerStringMap]MAP[else]SCALAR[/if],
+          [attribute.generateDerived or attribute.generateLazy], [attribute.nullable], [attribute.pointerElementNullable],
+          "[attribute.pointerValueRawType]", "[attribute.pointerElementRawType]",
+          "[optionalPresent attribute]", "[optionalGet attribute]")
+    [/for]
+    })
+  [/for]
+  };
+
+  private [type.typeAbstract.simple]Pointers() {}
+
+  public static Pointer parse(String input) {
+    if (input == null) {
+      throw new MalformedPointerException("Pointer cannot be null");
+    }
+    if (input.isEmpty()) {
+      return Pointer.ROOT;
+    }
+    if (input.charAt(0) != '/') {
+      throw new MalformedPointerException("Non-root pointer must start with '/'");
+    }
+    java.util.ArrayList<String> steps = new java.util.ArrayList<String>();
+    int start = 1;
+    for (int i = 1; i <= input.length(); i++) {
+      if (i == input.length() || input.charAt(i) == '/') {
+        steps.add(decode(input.substring(start, i)));
+        start = i + 1;
+      }
+    }
+    return new Pointer(steps);
+  }
+
+  public static String render(Pointer pointer) {
+    if (pointer == null) {
+      throw new NullPointerException("pointer");
+    }
+    if (pointer.steps.isEmpty()) {
+      return "";
+    }
+    StringBuilder rendered = new StringBuilder();
+    for (String step : pointer.steps) {
+      rendered.append('/');
+      for (int i = 0; i < step.length(); i++) {
+        char c = step.charAt(i);
+        if (c == '~') rendered.append("~0");
+        else if (c == '/') rendered.append("~1");
+        else rendered.append(c);
+      }
+    }
+    return rendered.toString();
+  }
+
+  public static Object resolve(Object root, Pointer pointer) {
+    Implementation implementation = requireImplementation(root);
+    if (pointer == null) throw new NullPointerException("pointer");
+    if (pointer.steps.isEmpty()) return root;
+    return resolveImplementation(root, implementation, pointer.steps, 0);
+  }
+
+  @SuppressWarnings("unchecked")
+  public static <T> Object update(
+      Object root,
+      Pointer pointer,
+      java.util.function.UnaryOperator<T> operator) {
+    requireImplementation(root);
+    if (pointer == null) throw new NullPointerException("pointer");
+    if (operator == null) throw new NullPointerException("operator");
+    java.util.function.UnaryOperator<Object> erasedOperator =
+        value -> operator.apply((T) value);
+    if (pointer.steps.isEmpty()) {
+      Object replacement = erasedOperator.apply(root);
+      requireImplementation(replacement);
+      return java.util.Objects.equals(root, replacement) ? root : replacement;
+    }
+    return updateImplementation(root, requireImplementation(root), pointer.steps, 0, erasedOperator);
+  }
+
+  private static Object resolveImplementation(
+      Object value, Implementation implementation, java.util.List<String> steps, int offset) {
+    Attribute attribute = implementation.attribute(steps.get(offset));
+    if (attribute == null) throw new PointerMissException("No attribute '" + steps.get(offset) + "'");
+    Object selected = attribute.get(value);
+    if (attribute.kind == OPTIONAL) {
+      if (!attribute.optionalPresent(selected)) throw new PointerMissException("Empty optional '" + attribute.name + "'");
+      selected = attribute.optionalGet(selected);
+    }
+    if (offset + 1 == steps.size()) return selected;
+    if (selected == null) throw new PointerMissException("Cannot step through null '" + attribute.name + "'");
+    if (attribute.kind == BLOCKED) throw new PointerTypeException("Cannot step through '" + attribute.name + "'");
+    if (attribute.kind == LIST || attribute.kind == ARRAY) {
+      int index = index(steps.get(offset + 1));
+      int size = attribute.kind == LIST
+          ? ((java.util.List<?>) selected).size()
+          : java.lang.reflect.Array.getLength(selected);
+      if (index < 0 || index >= size) throw new PointerMissException("Index is outside '" + attribute.name + "'");
+      Object element = attribute.kind == LIST
+          ? ((java.util.List<?>) selected).get(index)
+          : java.lang.reflect.Array.get(selected, index);
+      if (offset + 2 == steps.size()) return element;
+      if (element == null) throw new PointerMissException("Cannot step through null element");
+      return resolveImplementation(element, requireNestedImplementation(element), steps, offset + 2);
+    }
+    if (attribute.kind == MAP) {
+      java.util.Map<?, ?> map = (java.util.Map<?, ?>) selected;
+      String key = steps.get(offset + 1);
+      if (!map.containsKey(key)) throw new PointerMissException("No map key '" + key + "'");
+      Object element = map.get(key);
+      if (offset + 2 == steps.size()) return element;
+      if (element == null) throw new PointerMissException("Cannot step through null map value");
+      return resolveImplementation(element, requireNestedImplementation(element), steps, offset + 2);
+    }
+    return resolveImplementation(selected, requireNestedImplementation(selected), steps, offset + 1);
+  }
+
+  private static Object updateImplementation(
+      Object value,
+      Implementation implementation,
+      java.util.List<String> steps,
+      int offset,
+      java.util.function.UnaryOperator<Object> operator) {
+    Attribute attribute = implementation.attribute(steps.get(offset));
+    if (attribute == null) throw new PointerMissException("No attribute '" + steps.get(offset) + "'");
+    if (attribute.readOnly) throw new PointerTypeException("Cannot update derived or lazy attribute '" + attribute.name + "'");
+    Object stored = attribute.get(value);
+    Object selected = stored;
+    if (attribute.kind == OPTIONAL) {
+      if (!attribute.optionalPresent(stored)) throw new PointerMissException("Empty optional '" + attribute.name + "'");
+      selected = attribute.optionalGet(stored);
+    }
+    if (offset + 1 == steps.size()) {
+      if (attribute.kind == BLOCKED) throw new PointerTypeException("Cannot update '" + attribute.name + "'");
+      Object replacement = operator.apply(selected);
+      attribute.requireValue(replacement, attribute.kind == OPTIONAL ? false : attribute.nullable);
+      if (java.util.Objects.equals(selected, replacement)) return value;
+      return attribute.with(value, replacement);
+    }
+    if (selected == null) throw new PointerMissException("Cannot step through null '" + attribute.name + "'");
+    if (attribute.kind == BLOCKED) throw new PointerTypeException("Cannot step through '" + attribute.name + "'");
+    if (attribute.kind == LIST || attribute.kind == ARRAY) {
+      int position = offset + 1;
+      int index = index(steps.get(position));
+      int size = attribute.kind == LIST
+          ? ((java.util.List<?>) selected).size()
+          : java.lang.reflect.Array.getLength(selected);
+      if (index < 0 || index >= size) throw new PointerMissException("Index is outside '" + attribute.name + "'");
+      Object oldElement = attribute.kind == LIST
+          ? ((java.util.List<?>) selected).get(index)
+          : java.lang.reflect.Array.get(selected, index);
+      Object replacement = updateElement(oldElement, steps, position + 1, operator, attribute);
+      if (replacement == oldElement) return value;
+      Object rebuilt;
+      if (attribute.kind == LIST) {
+        java.util.ArrayList<Object> copy = new java.util.ArrayList<Object>((java.util.List<?>) selected);
+        copy.set(index, replacement);
+        rebuilt = copy;
+      } else {
+        rebuilt = cloneArray(selected);
+        try {
+          java.lang.reflect.Array.set(rebuilt, index, replacement);
+        } catch (RuntimeException ex) {
+          throw new PointerTypeException("Wrong array element type", ex);
+        }
+      }
+      return attribute.with(value, rebuilt);
+    }
+    if (attribute.kind == MAP) {
+      int position = offset + 1;
+      String key = steps.get(position);
+      java.util.Map<?, ?> map = (java.util.Map<?, ?>) selected;
+      if (!map.containsKey(key)) throw new PointerMissException("No map key '" + key + "'");
+      Object oldElement = map.get(key);
+      Object replacement = updateElement(oldElement, steps, position + 1, operator, attribute);
+      if (replacement == oldElement) return value;
+      java.util.LinkedHashMap<Object, Object> copy = new java.util.LinkedHashMap<Object, Object>();
+      copy.putAll(map);
+      copy.put(key, replacement);
+      return attribute.with(value, copy);
+    }
+    Object replacement = updateImplementation(
+        selected, requireNestedImplementation(selected), steps, offset + 1, operator);
+    if (replacement == selected) return value;
+    return attribute.with(value, replacement);
+  }
+
+  private static Object updateElement(
+      Object oldElement,
+      java.util.List<String> steps,
+      int offset,
+      java.util.function.UnaryOperator<Object> operator,
+      Attribute attribute) {
+    if (offset == steps.size()) {
+      Object replacement = operator.apply(oldElement);
+      attribute.requireElement(replacement);
+      return java.util.Objects.equals(oldElement, replacement) ? oldElement : replacement;
+    }
+    if (oldElement == null) throw new PointerMissException("Cannot step through null element");
+    return updateImplementation(oldElement, requireNestedImplementation(oldElement), steps, offset, operator);
+  }
+
+  private static Object cloneArray(Object array) {
+    int length = java.lang.reflect.Array.getLength(array);
+    Object copy = java.lang.reflect.Array.newInstance(array.getClass().getComponentType(), length);
+    System.arraycopy(array, 0, copy, 0, length);
+    return copy;
+  }
+
+  private static int index(String step) {
+    if (step.isEmpty() || (step.length() > 1 && step.charAt(0) == '0')) {
+      throw new PointerTypeException("Invalid list or array index '" + step + "'");
+    }
+    for (int i = 0; i < step.length(); i++) {
+      char c = step.charAt(i);
+      if (c < '0' || c > '9') throw new PointerTypeException("Invalid list or array index '" + step + "'");
+    }
+    try {
+      return Integer.parseInt(step);
+    } catch (NumberFormatException ex) {
+      return -1;
+    }
+  }
+
+  private static String decode(String encoded) {
+    StringBuilder decoded = new StringBuilder(encoded.length());
+    for (int i = 0; i < encoded.length(); i++) {
+      char c = encoded.charAt(i);
+      if (c != '~') {
+        decoded.append(c);
+      } else {
+        if (++i == encoded.length()) throw new MalformedPointerException("Incomplete '~' escape");
+        char escape = encoded.charAt(i);
+        if (escape == '0') decoded.append('~');
+        else if (escape == '1') decoded.append('/');
+        else throw new MalformedPointerException("Invalid '~" + escape + "' escape");
+      }
+    }
+    return decoded.toString();
+  }
+
+  private static Implementation requireImplementation(Object value) {
+    if (value != null) {
+      for (Implementation implementation : IMPLEMENTATIONS) {
+        if (value.getClass() == implementation.type) return implementation;
+      }
+    }
+    throw new IllegalArgumentException("Root is not a generated implementation of [type.typeAbstract.simple]");
+  }
+
+  private static Implementation requireNestedImplementation(Object value) {
+    try {
+      return requireImplementation(value);
+    } catch (IllegalArgumentException ex) {
+      throw new PointerTypeException("No pointer step applies below this value", ex);
+    }
+  }
+
+  public static final class Pointer {
+    private static final Pointer ROOT = new Pointer(java.util.Collections.<String>emptyList());
+    private final java.util.List<String> steps;
+
+    private Pointer(java.util.List<String> steps) {
+      this.steps = java.util.Collections.unmodifiableList(new java.util.ArrayList<String>(steps));
+    }
+
+    @Override public boolean equals(Object other) {
+      return this == other || other instanceof Pointer && steps.equals(((Pointer) other).steps);
+    }
+
+    @Override public int hashCode() {
+      return steps.hashCode();
+    }
+
+    @Override public String toString() {
+      return render(this);
+    }
+  }
+
+  public static final class MalformedPointerException extends IllegalArgumentException {
+    private static final long serialVersionUID = 1L;
+    MalformedPointerException(String message) { super(message); }
+  }
+
+  public static final class PointerMissException extends IllegalArgumentException {
+    private static final long serialVersionUID = 1L;
+    PointerMissException(String message) { super(message); }
+  }
+
+  public static final class PointerTypeException extends IllegalArgumentException {
+    private static final long serialVersionUID = 1L;
+    PointerTypeException(String message) { super(message); }
+    PointerTypeException(String message, Throwable cause) { super(message, cause); }
+  }
+
+  private static final class Implementation {
+    final Class<?> type;
+    final Attribute[arr] attributes;
+
+    Implementation(Class<?> type, Attribute[arr] attributes) {
+      this.type = type;
+      this.attributes = attributes;
+    }
+
+    Attribute attribute(String name) {
+      for (Attribute attribute : attributes) {
+        if (attribute.name.equals(name)) return attribute;
+      }
+      return null;
+    }
+  }
+
+  private static final class Attribute {
+    final String name;
+    final int kind;
+    final boolean readOnly;
+    final boolean nullable;
+    final boolean elementNullable;
+    final String valueType;
+    final String elementType;
+    final java.lang.reflect.Method getter;
+    final java.lang.reflect.Method wither;
+    final String presentMethod;
+    final String getMethod;
+
+    Attribute(
+        Class<?> owner,
+        String name,
+        String getterName,
+        String witherName,
+        int kind,
+        boolean readOnly,
+        boolean nullable,
+        boolean elementNullable,
+        String valueType,
+        String elementType,
+        String presentMethod,
+        String getMethod) {
+      this.name = name;
+      this.kind = kind;
+      this.readOnly = readOnly;
+      this.nullable = nullable;
+      this.elementNullable = elementNullable;
+      this.valueType = valueType;
+      this.elementType = elementType;
+      this.presentMethod = presentMethod;
+      this.getMethod = getMethod;
+      try {
+        this.getter = owner.getDeclaredMethod(getterName);
+        this.wither = readOnly ? null : findWither(owner, witherName, getter.getReturnType(), kind == OPTIONAL);
+      } catch (ReflectiveOperationException ex) {
+        throw new ExceptionInInitializerError(ex);
+      }
+    }
+
+
+    Object get(Object owner) {
+      try {
+        return getter.invoke(owner);
+      } catch (ReflectiveOperationException ex) {
+        throw new AssertionError(ex);
+      }
+    }
+
+    Object with(Object owner, Object replacement) {
+      try {
+        return wither.invoke(owner, replacement);
+      } catch (IllegalArgumentException ex) {
+        throw new PointerTypeException("Wrong replacement type for '" + name + "'", ex);
+      } catch (ReflectiveOperationException ex) {
+        Throwable cause = ex instanceof java.lang.reflect.InvocationTargetException
+            ? ((java.lang.reflect.InvocationTargetException) ex).getCause()
+            : ex;
+        throw new PointerTypeException("Cannot replace '" + name + "'", cause);
+      }
+    }
+
+    boolean optionalPresent(Object optional) {
+      try {
+        return (Boolean) optional.getClass().getMethod(presentMethod).invoke(optional);
+      } catch (ReflectiveOperationException ex) {
+        throw new AssertionError(ex);
+      }
+    }
+
+    Object optionalGet(Object optional) {
+      try {
+        return optional.getClass().getMethod(getMethod).invoke(optional);
+      } catch (ReflectiveOperationException ex) {
+        throw new AssertionError(ex);
+      }
+    }
+
+    void requireValue(Object value, boolean allowNull) {
+      requireType(value, valueType, allowNull);
+    }
+
+    void requireElement(Object value) {
+      requireType(value, elementType, elementNullable);
+    }
+  }
+
+  private static java.lang.reflect.Method findWither(
+      Class<?> owner, String name, Class<?> getterType, boolean optional) throws NoSuchMethodException {
+    java.lang.reflect.Method fallback = null;
+    for (java.lang.reflect.Method method : owner.getDeclaredMethods()) {
+      if (method.getName().equals(name) && method.getParameterTypes().length == 1) {
+        Class<?> parameter = (Class<?>) java.lang.reflect.Array.get(method.getParameterTypes(), 0);
+        if (optional) {
+          if (parameter != getterType) return method;
+        } else if (box(parameter).isAssignableFrom(box(getterType))
+            || box(getterType).isAssignableFrom(box(parameter))) {
+          return method;
+        }
+        fallback = method;
+      }
+    }
+    if (fallback != null) return fallback;
+    throw new NoSuchMethodException(owner.getName() + "." + name);
+  }
+
+  private static void requireType(Object value, String typeName, boolean allowNull) {
+    if (value == null) {
