+++ b/value-processor/src/org/immutables/value/processor/PointersGenerator.java
@@ -0,0 +1,544 @@
+package org.immutables.value.processor;
+
+import com.Capella.common.collect.Multimap;
+import java.io.IOException;
+import java.io.Writer;
+import java.util.ArrayList;
+import java.util.List;
+import javax.annotation.processing.FilerException;
+import javax.annotation.processing.ProcessingEnvironment;
+import javax.lang.model.element.ElementKind;
+import javax.lang.model.element.ExecutableElement;
+import javax.lang.model.element.Modifier;
+import javax.lang.model.element.TypeElement;
+import javax.lang.model.type.ArrayType;
+import javax.lang.model.type.DeclaredType;
+import javax.lang.model.type.ExecutableType;
+import javax.lang.model.type.PrimitiveType;
+import javax.lang.model.type.TypeKind;
+import javax.lang.model.type.TypeMirror;
+import javax.lang.model.util.ElementFilter;
+import javax.tools.JavaFileObject;
+import org.immutables.value.processor.meta.Proto.DeclaringPackage;
+import org.immutables.value.processor.meta.ValueAttribute;
+import org.immutables.value.processor.meta.ValueType;
+
+final class PointersGenerator {
+  private final ProcessingEnvironment processing;
+
+  PointersGenerator(ProcessingEnvironment processing) {
+    this.processing = processing;
+  }
+
+  void generate(Multimap<DeclaringPackage, ValueType> values) {
+    for (ValueType enclosing : values.values()) {
+      if (enclosing.kind().isEnclosing() && qualifies(enclosing)) {
+        write(enclosing);
+      }
+    }
+  }
+
+  private boolean qualifies(ValueType enclosing) {
+    List<ValueType> implementations = implementations(enclosing);
+    if (implementations.isEmpty()) {
+      return false;
+    }
+    for (ValueType implementation : implementations) {
+      if (!implementation.isUseCopyMethods()) {
+        return false;
+      }
+    }
+    for (TypeElement nested : ElementFilter.typesIn(enclosing.element.getEnclosedElements())) {
+      if (!nested.getModifiers().contains(Modifier.ABSTRACT)
+          && nested.getKind() != ElementKind.INTERFACE) {
+        continue;
+      }
+      int count = 0;
+      String name = nested.getQualifiedName().toString();
+      for (ValueType subtype : enclosing.getCases().knownSubtypesOf(name)) {
+        if (!subtype.typeAbstract().toString().equals(name)
+            && subtype.generics().isEmpty()) {
+          count++;
+        }
+      }
+      if (count >= 2) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  private List<ValueType> implementations(ValueType enclosing) {
+    List<ValueType> implementations = new ArrayList<>();
+    for (ValueType nested : enclosing.nested) {
+      if (nested.kind().isValue() && nested.generics().isEmpty()) {
+        implementations.add(nested);
+      }
+    }
+    return implementations;
+  }
+
+  private void write(ValueType enclosing) {
+    String packageName = enclosing.constitution.protoclass().packageOf().name();
+    String simpleName = enclosing.element.getSimpleName() + "Pointers";
+    String qualifiedName = packageName.isEmpty() ? simpleName : packageName + "." + simpleName;
+    try {
+      JavaFileObject file = processing.getFiler().createSourceFile(qualifiedName, enclosing.element);
+      try (Writer writer = file.openWriter()) {
+        writer.write(source(enclosing, packageName, simpleName));
+      }
+    } catch (FilerException ex) {
+      // A later annotation-processing round can rediscover the enclosing type.
+    } catch (IOException ex) {
+      throw new RuntimeException("Cannot generate " + qualifiedName, ex);
+    }
+  }
+
+  private String source(ValueType enclosing, String packageName, String simpleName) {
+    List<ValueType> implementations = implementations(enclosing);
+    StringBuilder out = new StringBuilder(32768);
+    if (!packageName.isEmpty()) {
+      line(out, "package " + packageName + ";");
+      line(out, "");
+    }
+    line(out, "@SuppressWarnings({\"unchecked\", \"rawtypes\"})");
+    line(out, "public final class " + simpleName + " {");
+    line(out, "  private " + simpleName + "() {}");
+    emitPointer(out);
+    emitExceptions(out);
+    emitParsing(out);
+    emitPublicOperations(out);
+    emitRuntimeHelpers(out, implementations);
+    for (ValueType implementation : implementations) {
+      emitResolveImplementation(out, implementation);
+      emitUpdateImplementation(out, implementation);
+    }
+    line(out, "}");
+    return out.toString();
+  }
+
+  private void emitPointer(StringBuilder out) {
+    line(out, "");
+    line(out, "  public static final class Pointer {");
+    line(out, "    private final java.util.List<String> steps;");
+    line(out, "    private Pointer(java.util.List<String> steps) {");
+    line(out, "      this.steps = java.util.Collections.unmodifiableList(steps);");
+    line(out, "    }");
+    line(out, "    @Override public boolean equals(Object other) {");
+    line(out, "      return this == other || other instanceof Pointer && steps.equals(((Pointer) other).steps);");
+    line(out, "    }");
+    line(out, "    @Override public int hashCode() { return steps.hashCode(); }");
+    line(out, "    @Override public String toString() { return render(this); }");
+    line(out, "  }");
+  }
+
+  private void emitExceptions(StringBuilder out) {
+    line(out, "");
+    line(out, "  public static final class MalformedPointerException extends IllegalArgumentException {");
+    line(out, "    private MalformedPointerException(String message) { super(message); }");
+    line(out, "  }");
+    line(out, "  public static final class PointerMissException extends RuntimeException {");
+    line(out, "    private PointerMissException(String message) { super(message); }");
+    line(out, "  }");
+    line(out, "  public static final class PointerTypeException extends RuntimeException {");
+    line(out, "    private PointerTypeException(String message) { super(message); }");
+    line(out, "  }");
+  }
+
+  private void emitParsing(StringBuilder out) {
+    line(out, "");
+    line(out, "  public static Pointer parse(String text) {");
+    line(out, "    if (text == null) throw new MalformedPointerException(\"Pointer is null\");");
+    line(out, "    java.util.List<String> steps = new java.util.ArrayList<>();");
+    line(out, "    if (text.isEmpty()) return new Pointer(steps);");
+    line(out, "    if (text.charAt(0) != '/') throw new MalformedPointerException(\"Pointer must start with '/'\");");
+    line(out, "    int start = 1;");
+    line(out, "    for (int end = 1; end <= text.length(); end++) {");
+    line(out, "      if (end == text.length() || text.charAt(end) == '/') {");
+    line(out, "        StringBuilder step = new StringBuilder();");
+    line(out, "        for (int i = start; i < end; i++) {");
+    line(out, "          char c = text.charAt(i);");
+    line(out, "          if (c != '~') { step.append(c); continue; }");
+    line(out, "          if (++i >= end) throw new MalformedPointerException(\"Incomplete escape\");");
+    line(out, "          char escaped = text.charAt(i);");
+    line(out, "          if (escaped == '0') step.append('~');");
+    line(out, "          else if (escaped == '1') step.append('/');");
+    line(out, "          else throw new MalformedPointerException(\"Invalid escape\");");
+    line(out, "        }");
+    line(out, "        steps.add(step.toString());");
+    line(out, "        start = end + 1;");
+    line(out, "      }");
+    line(out, "    }");
+    line(out, "    return new Pointer(steps);");
+    line(out, "  }");
+    line(out, "");
+    line(out, "  public static String render(Pointer pointer) {");
+    line(out, "    if (pointer == null) throw new NullPointerException(\"pointer\");");
+    line(out, "    StringBuilder text = new StringBuilder();");
+    line(out, "    for (String step : pointer.steps) {");
+    line(out, "      text.append('/');");
+    line(out, "      for (int i = 0; i < step.length(); i++) {");
+    line(out, "        char c = step.charAt(i);");
+    line(out, "        if (c == '~') text.append(\"~0\");");
+    line(out, "        else if (c == '/') text.append(\"~1\");");
+    line(out, "        else text.append(c);");
+    line(out, "      }");
+    line(out, "    }");
+    line(out, "    return text.toString();");
+    line(out, "  }");
+  }
+
+  private void emitPublicOperations(StringBuilder out) {
+    line(out, "");
+    line(out, "  public static Object resolve(Object root, Pointer pointer) {");
+    line(out, "    requireRoot(root);");
+    line(out, "    if (pointer == null) throw new NullPointerException(\"pointer\");");
+    line(out, "    return resolveValue(root, pointer.steps, 0);");
+    line(out, "  }");
+    line(out, "");
+    line(out, "  public static Object update(Object root, Pointer pointer, java.util.function.UnaryOperator operator) {");
+    line(out, "    requireRoot(root);");
+    line(out, "    if (pointer == null) throw new NullPointerException(\"pointer\");");
+    line(out, "    if (operator == null) throw new NullPointerException(\"operator\");");
+    line(out, "    if (pointer.steps.isEmpty()) {");
+    line(out, "      Object replacement = operator.apply(root);");
+    line(out, "      requireRootReplacement(replacement);");
+    line(out, "      return same(root, replacement) ? root : replacement;");
+    line(out, "    }");
+    line(out, "    return updateValue(root, pointer.steps, 0, operator);");
+    line(out, "  }");
+  }
+
+  private void emitRuntimeHelpers(StringBuilder out, List<ValueType> implementations) {
+    line(out, "");
+    line(out, "  private static void requireRoot(Object root) {");
+    line(out, "    if (!isImplementation(root)) throw new IllegalArgumentException(\"Unsupported pointer root\");");
+    line(out, "  }");
+    line(out, "  private static void requireRootReplacement(Object root) {");
+    line(out, "    if (!isImplementation(root)) throw type(\"Replacement root has the wrong type\");");
+    line(out, "  }");
+    line(out, "  private static boolean isImplementation(Object value) {");
+    line(out, "    return value != null && (");
+    for (int i = 0; i < implementations.size(); i++) {
+      line(out, "        " + (i == 0 ? "" : "|| ") + "value instanceof " + implementations.get(i).typeImmutable());
+    }
+    line(out, "    );");
+    line(out, "  }");
+    line(out, "  private static Object resolveValue(Object value, java.util.List<String> steps, int at) {");
+    line(out, "    if (at == steps.size()) return value;");
+    line(out, "    if (value == null) throw miss(\"Step through null\");");
+    for (ValueType implementation : implementations) {
+      line(out, "    if (value instanceof " + implementation.typeImmutable() + ") return resolve(" +
+          "(" + implementation.typeImmutable() + ") value, steps, at);");
+    }
+    line(out, "    throw type(\"No step applies to this value\");");
+    line(out, "  }");
+    line(out, "  private static Object updateValue(Object value, java.util.List<String> steps, int at, java.util.function.UnaryOperator operator) {");
+    line(out, "    if (value == null) throw miss(\"Step through null\");");
+    for (ValueType implementation : implementations) {
+      line(out, "    if (value instanceof " + implementation.typeImmutable() + ") return update(" +
+          "(" + implementation.typeImmutable() + ") value, steps, at, operator);");
+    }
+    line(out, "    throw type(\"No step applies to this value\");");
+    line(out, "  }");
+    line(out, "  private static int index(String text) {");
+    line(out, "    if (text.isEmpty() || text.length() > 1 && text.charAt(0) == '0') throw type(\"Invalid list index\");");
+    line(out, "    long value = 0;");
+    line(out, "    for (int i = 0; i < text.length(); i++) {");
+    line(out, "      char c = text.charAt(i);");
+    line(out, "      if (c < '0' || c > '9') throw type(\"Invalid list index\");");
+    line(out, "      value = Math.min(Integer.MAX_VALUE, value * 10 + c - '0');");
+    line(out, "    }");
+    line(out, "    return (int) value;");
+    line(out, "  }");
+    line(out, "  private static Object listElement(java.util.List<?> list, String text) {");
+    line(out, "    int index = index(text);");
+    line(out, "    if (index >= list.size()) throw miss(\"List index is out of bounds\");");
+    line(out, "    return list.get(index);");
+    line(out, "  }");
+    line(out, "  private static Object arrayElement(Object array, String text) {");
+    line(out, "    int index = index(text);");
+    line(out, "    if (index >= java.lang.reflect.Array.getLength(array)) throw miss(\"Array index is out of bounds\");");
+    line(out, "    return java.lang.reflect.Array.get(array, index);");
+    line(out, "  }");
+    line(out, "  private static Object mapElement(java.util.Map<?, ?> map, String key) {");
+    line(out, "    if (!map.containsKey(key)) throw miss(\"Map key is absent\");");
+    line(out, "    return map.get(key);");
+    line(out, "  }");
+    line(out, "  private static boolean same(Object left, Object right) {");
+    line(out, "    return java.util.Objects.deepEquals(left, right);");
+    line(out, "  }");
+    line(out, "  @SuppressWarnings(\"unchecked\") private static <T> T checked(Object value, Class<?> type, boolean nullable) {");
+    line(out, "    if (value == null) {");
+    line(out, "      if (!nullable) throw type(\"Null replacement for a non-null position\");");
+    line(out, "      return null;");
+    line(out, "    }");
+    line(out, "    if (!type.isInstance(value)) throw type(\"Replacement has the wrong type\");");
+    line(out, "    return (T) value;");
+    line(out, "  }");
+    line(out, "  private static void checkElements(Iterable<?> values, Class<?> type, boolean nullable) {");
+    line(out, "    for (Object value : values) checked(value, type, nullable);");
+    line(out, "  }");
+    line(out, "  private static PointerMissException miss(String message) { return new PointerMissException(message); }");
+    line(out, "  private static PointerTypeException type(String message) { return new PointerTypeException(message); }");
+  }
+
+  private void emitResolveImplementation(StringBuilder out, ValueType type) {
+    String immutable = type.typeImmutable().toString();
+    line(out, "");
+    line(out, "  private static Object resolve(" + immutable + " value, java.util.List<String> steps, int at) {");
+    line(out, "    String step = steps.get(at);");
+    for (ValueAttribute attribute : type.getAllAccessibleAttributes()) {
+      line(out, "    if (step.equals(" + literal(attribute.name()) + ")) {");
+      emitResolveAttribute(out, type, attribute, "      ");
+      line(out, "    }");
+    }
+    line(out, "    throw miss(\"Attribute is absent: \" + step);");
+    line(out, "  }");
+  }
+
+  private void emitResolveAttribute(StringBuilder out, ValueType owner, ValueAttribute attribute, String indent) {
+    String access = "value." + attribute.names.get + "()";
+    String next = "at + 1";
+    if (attribute.isOptionalType()) {
+      line(out, indent + attribute.getType() + " selected = " + access + ";");
+      line(out, indent + "if (selected == null || !selected.isPresent()) throw miss(\"Optional is empty\");");
+      String get = attribute.isJdkSpecializedOptional() ? specializedGet(attribute) : "get()";
+      line(out, indent + "return resolveValue(selected." + get + ", steps, " + next + ");");
+    } else if (attribute.isListType()) {
+      line(out, indent + "java.util.List<?> selected = " + access + ";");
+      line(out, indent + "if (" + next + " == steps.size()) return selected;");
+      line(out, indent + "if (selected == null) throw miss(\"Step through null\");");
+      line(out, indent + "return resolveValue(listElement(selected, steps.get(" + next + ")), steps, at + 2);");
+    } else if (isStringMap(attribute)) {
+      line(out, indent + "java.util.Map<?, ?> selected = " + access + ";");
+      line(out, indent + "if (" + next + " == steps.size()) return selected;");
+      line(out, indent + "if (selected == null) throw miss(\"Step through null\");");
+      line(out, indent + "return resolveValue(mapElement(selected, steps.get(" + next + ")), steps, at + 2);");
+    } else if (attribute.isReferenceArrayType()) {
+      line(out, indent + "Object selected = " + access + ";");
+      line(out, indent + "if (" + next + " == steps.size()) return selected;");
+      line(out, indent + "if (selected == null) throw miss(\"Step through null\");");
+      line(out, indent + "return resolveValue(arrayElement(selected, steps.get(" + next + ")), steps, at + 2);");
+    } else {
+      line(out, indent + "Object selected = " + access + ";");
+      line(out, indent + "return resolveValue(selected, steps, " + next + ");");
+    }
+  }
+
+  private void emitUpdateImplementation(StringBuilder out, ValueType type) {
+    String immutable = type.typeImmutable().toString();
+    line(out, "");
+    line(out, "  private static Object update(" + immutable + " value, java.util.List<String> steps, int at, java.util.function.UnaryOperator operator) {");
+    line(out, "    String step = steps.get(at);");
+    for (ValueAttribute attribute : type.getAllAccessibleAttributes()) {
+      line(out, "    if (step.equals(" + literal(attribute.name()) + ")) {");
+      if (!attribute.isSettable()) {
+        line(out, "      throw type(\"Derived and lazy attributes cannot be updated\");");
+      } else {
+        emitUpdateAttribute(out, type, attribute, "      ");
+      }
+      line(out, "    }");
+    }
+    line(out, "    throw miss(\"Attribute is absent: \" + step);");
+    line(out, "  }");
+  }
+
+  private void emitUpdateAttribute(StringBuilder out, ValueType owner, ValueAttribute attribute, String indent) {
+    String access = "value." + attribute.names.get + "()";
+    String with = "value." + attribute.names.with;
+    String valueClass = classLiteral(memberType(owner, attribute));
+    String elementClass = classLiteral(elementType(owner, attribute, false));
+    String mapValueClass = classLiteral(elementType(owner, attribute, true));
+    boolean nullable = attribute.isNullable();
+    boolean nullableElements = attribute.nullElements.allow();
+
+    if (attribute.isOptionalType()) {
+      line(out, indent + attribute.getType() + " selected = " + access + ";");
+      line(out, indent + "if (selected == null || !selected.isPresent()) throw miss(\"Optional is empty\");");
+      String get = attribute.isJdkSpecializedOptional() ? specializedGet(attribute) : "get()";
+      line(out, indent + "Object old = selected." + get + ";");
+      line(out, indent + "Object replacement = at + 1 == steps.size() ? operator.apply(old) : updateValue(old, steps, at + 1, operator);");
+      line(out, indent + "if (same(old, replacement)) return value;");
+      line(out, indent + "checked(replacement, " + elementClass + ", false);");
+      line(out, indent + "return " + with + "((" + castType(elementType(owner, attribute, false))
+          + ") checked(replacement, " + elementClass + ", false));");
+      return;
+    }
+
+    if (attribute.isListType()) {
+      line(out, indent + "java.util.List<?> selected = " + access + ";");
+      line(out, indent + "if (at + 1 == steps.size()) {");
+      line(out, indent + "  Object replacement = operator.apply(selected);");
+      line(out, indent + "  if (same(selected, replacement)) return value;");
+      line(out, indent + "  java.util.List<?> checked = checked(replacement, java.util.List.class, " + nullable + ");");
+      line(out, indent + "  if (checked != null) checkElements(checked, " + elementClass + ", " + nullableElements + ");");
+      line(out, indent + "  return " + with + "((java.lang.Iterable) checked);");
+      line(out, indent + "}");
+      line(out, indent + "if (selected == null) throw miss(\"Step through null\");");
+      line(out, indent + "int selectedIndex = index(steps.get(at + 1));");
+      line(out, indent + "if (selectedIndex >= selected.size()) throw miss(\"List index is out of bounds\");");
+      line(out, indent + "Object old = selected.get(selectedIndex);");
+      line(out, indent + "Object replacement = at + 2 == steps.size() ? operator.apply(old) : updateValue(old, steps, at + 2, operator);");
+      line(out, indent + "if (same(old, replacement)) return value;");
+      line(out, indent + "checked(replacement, " + elementClass + ", " + nullableElements + ");");
+      line(out, indent + "java.util.List<Object> copy = new java.util.ArrayList<Object>(selected);");
+      line(out, indent + "copy.set(selectedIndex, replacement);");
+      line(out, indent + "return " + with + "((java.lang.Iterable) copy);");
+      return;
+    }
+
+    if (isStringMap(attribute)) {
+      line(out, indent + "java.util.Map<?, ?> selected = " + access + ";");
+      line(out, indent + "if (at + 1 == steps.size()) {");
+      line(out, indent + "  Object replacement = operator.apply(selected);");
+      line(out, indent + "  if (same(selected, replacement)) return value;");
+      line(out, indent + "  java.util.Map<?, ?> checked = checked(replacement, java.util.Map.class, " + nullable + ");");
+      line(out, indent + "  if (checked != null) {");
+      line(out, indent + "    checkElements(checked.keySet(), String.class, false);");
+      line(out, indent + "    checkElements(checked.values(), " + mapValueClass + ", " + nullableElements + ");");
+      line(out, indent + "  }");
+      line(out, indent + "  return " + with + "((java.util.Map) checked);");
+      line(out, indent + "}");
+      line(out, indent + "if (selected == null) throw miss(\"Step through null\");");
+      line(out, indent + "String key = steps.get(at + 1);");
+      line(out, indent + "if (!selected.containsKey(key)) throw miss(\"Map key is absent\");");
+      line(out, indent + "Object old = selected.get(key);");
+      line(out, indent + "Object replacement = at + 2 == steps.size() ? operator.apply(old) : updateValue(old, steps, at + 2, operator);");
+      line(out, indent + "if (same(old, replacement)) return value;");
+      line(out, indent + "checked(replacement, " + mapValueClass + ", " + nullableElements + ");");
+      line(out, indent + "java.util.Map<String, Object> copy = new java.util.LinkedHashMap<String, Object>();");
+      line(out, indent + "for (java.util.Map.Entry<?, ?> entry : selected.entrySet()) copy.put((String) entry.getKey(), entry.getValue());");
+      line(out, indent + "copy.put(key, replacement);");
+      line(out, indent + "return " + with + "((java.util.Map) copy);");
+      return;
+    }
+
+    if (attribute.isReferenceArrayType()) {
+      line(out, indent + "Object selected = " + access + ";");
+      line(out, indent + "if (at + 1 == steps.size()) {");
+      line(out, indent + "  Object replacement = operator.apply(selected);");
+      line(out, indent + "  if (same(selected, replacement)) return value;");
+      line(out, indent + "  return " + with + "(checked(replacement, " + valueClass + ", " + nullable + "));");
+      line(out, indent + "}");
+      line(out, indent + "if (selected == null) throw miss(\"Step through null\");");
+      line(out, indent + "int selectedIndex = index(steps.get(at + 1));");
+      line(out, indent + "int length = java.lang.reflect.Array.getLength(selected);");
+      line(out, indent + "if (selectedIndex >= length) throw miss(\"Array index is out of bounds\");");
+      line(out, indent + "Object old = java.lang.reflect.Array.get(selected, selectedIndex);");
+      line(out, indent + "Object replacement = at + 2 == steps.size() ? operator.apply(old) : updateValue(old, steps, at + 2, operator);");
+      line(out, indent + "if (same(old, replacement)) return value;");
+      line(out, indent + "checked(replacement, " + elementClass + ", " + nullableElements + ");");
+      line(out, indent + "Object copy = java.lang.reflect.Array.newInstance(selected.getClass().getComponentType(), length);");
+      line(out, indent + "System.arraycopy(selected, 0, copy, 0, length);");
+      line(out, indent + "java.lang.reflect.Array.set(copy, selectedIndex, replacement);");
+      line(out, indent + "return " + with + "(checked(copy, " + valueClass + ", false));");
+      return;
+    }
+
+    if (attribute.isSetType() || attribute.isMultisetType() || attribute.isMultimapType()
+        || attribute.isSortedMapType() || attribute.isPrimitiveArrayType()
+        || attribute.isMapType() && !isStringMap(attribute)) {
+      line(out, indent + "throw type(\"This attribute cannot be updated\");");
+      return;
+    }
+
+    line(out, indent + "Object old = " + access + ";");
+    line(out, indent + "Object replacement = at + 1 == steps.size() ? operator.apply(old) : updateValue(old, steps, at + 1, operator);");
+    line(out, indent + "if (same(old, replacement)) return value;");
+    line(out, indent + "return " + with + "(checked(replacement, " + valueClass + ", " + nullable + "));");
+  }
+
+  private TypeMirror memberType(ValueType owner, ValueAttribute attribute) {
+    if (attribute.element() instanceof ExecutableElement && owner.element.asType() instanceof DeclaredType) {
+      try {
+        TypeMirror member = processing.getTypeUtils().asMemberOf(
+            (DeclaredType) owner.element.asType(), attribute.element());
+        if (member instanceof ExecutableType) {
+          return ((ExecutableType) member).getReturnType();
+        }
+      } catch (IllegalArgumentException ex) {
+        // Fall back to the declaration's return type.
+      }
+      return ((ExecutableElement) attribute.element()).getReturnType();
+    }
+    return attribute.element().asType();
+  }
+
+  private TypeMirror elementType(ValueType owner, ValueAttribute attribute, boolean mapValue) {
+    switch (attribute.typeKind()) {
+      case OPTIONAL_INT_JDK:
+        return processing.getTypeUtils().getPrimitiveType(TypeKind.INT);
+      case OPTIONAL_LONG_JDK:
+        return processing.getTypeUtils().getPrimitiveType(TypeKind.LONG);
+      case OPTIONAL_DOUBLE_JDK:
+        return processing.getTypeUtils().getPrimitiveType(TypeKind.DOUBLE);
+      default:
+    }
+    TypeMirror type = memberType(owner, attribute);
+    if (type.getKind() == TypeKind.ARRAY) {
+      return ((ArrayType) type).getComponentType();
+    }
+    if (type instanceof DeclaredType) {
+      List<? extends TypeMirror> arguments = ((DeclaredType) type).getTypeArguments();
+      int index = mapValue ? 1 : 0;
+      if (arguments.size() > index) {
+        return arguments.get(index);
+      }
+    }
+    return processing.getElementUtils().getTypeElement(Object.class.getName()).asType();
+  }
+
+  private String classLiteral(TypeMirror type) {
+    TypeKind kind = type.getKind();
+    if (kind.isPrimitive()) {
+      TypeElement boxed = processing.getTypeUtils().boxedClass((PrimitiveType) type);
+      return boxed.getQualifiedName() + ".class";
+    }
+    if (kind == TypeKind.ARRAY) {
+      return processing.getTypeUtils().erasure(type).toString() + ".class";
+    }
+    if (kind == TypeKind.DECLARED) {
+      return processing.getTypeUtils().erasure(type).toString() + ".class";
+    }
+    return "Object.class";
+  }
+
+  private boolean isStringMap(ValueAttribute attribute) {
+    return attribute.isMapType()
+        && attribute.typeKind().isPlainMapKind()
+        && (String.class.getName().equals(attribute.firstTypeParameter())
+            || String.class.getSimpleName().equals(attribute.firstTypeParameter()));
+  }
+
+  private String specializedGet(ValueAttribute attribute) {
+    switch (attribute.typeKind()) {
+      case OPTIONAL_INT_JDK:
+        return "getAsInt()";
+      case OPTIONAL_LONG_JDK:
+        return "getAsLong()";
+      case OPTIONAL_DOUBLE_JDK:
+        return "getAsDouble()";
+      default:
+        return "get()";
+    }
+  }
+
+  private String castType(TypeMirror type) {
+    if (type.getKind().isPrimitive()) {
+      return processing.getTypeUtils().boxedClass((PrimitiveType) type).getQualifiedName().toString();
+    }
+    if (type.getKind() == TypeKind.DECLARED || type.getKind() == TypeKind.ARRAY) {
+      return processing.getTypeUtils().erasure(type).toString();
+    }
+    return Object.class.getName();
+  }
+
+  private static String literal(String value) {
+    return '"' + value.replace("\\", "\\\\").replace("\"", "\\\"") + '"';
+  }
+
+  private static void line(StringBuilder out, String line) {
+    out.append(line).append('\n');
+  }
+}
