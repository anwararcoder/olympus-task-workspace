@@ -0,0 +1,40 @@
+package org.immutables.fixture;
+
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.Set;
+import javax.annotation.Nullable;
+import org.immutables.value.Value;
+
+@Value.Enclosing
+public interface PointerFamily {
+  interface Node {}
+
+  @Value.Immutable
+  interface Leaf extends Node {
+    String value();
+  }
+
+  @Value.Immutable
+  interface Branch extends Node {
+    Node left();
+    Node right();
+    List<Node> children();
+    Map<String, Node> named();
+    Optional<Node> maybe();
+    Node[] array();
+    @Nullable Node nullable();
+    Set<Node> set();
+
+    @Value.Derived
+    default String derived() {
+      return "derived";
+    }
+  }
+
+  @Value.Immutable
+  interface Outside {
+    String text();
+  }
+}
diff --git a/value-fixture/test/org/immutables/fixture/PointerFamilyTest.java b/value-fixture/test/org/immutables/fixture/PointerFamilyTest.java
new file mode 100644
index 0000000..2cec99b
--- /dev/null
+++ b/value-fixture/test/org/immutables/fixture/PointerFamilyTest.java
@@ -0,0 +1,155 @@
+package org.immutables.fixture;
+
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.Optional;
+import java.util.concurrent.atomic.AtomicBoolean;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+public class PointerFamilyTest {
+  private final ImmutablePointerFamily.Leaf one = ImmutablePointerFamily.Leaf.builder().value("one").build();
+  private final ImmutablePointerFamily.Leaf two = ImmutablePointerFamily.Leaf.builder().value("two").build();
+
+  @Test void generatesOnlyForEligibleEnclosingTypes() {
+    assertThrows(ClassNotFoundException.class,
+        () -> Class.forName("org.immutables.fixture.NoFamilyPointers"));
+    assertThrows(ClassNotFoundException.class,
+        () -> Class.forName("org.immutables.fixture.NoCopiesPointers"));
+  }
+
+  @Test void parsesAndRendersPointers() {
+    String text = "/a~1b/~0/";
+    PointerFamilyPointers.Pointer pointer = PointerFamilyPointers.parse(text);
+
+    assertEquals(text, PointerFamilyPointers.render(pointer));
+    assertEquals(text, pointer.toString());
+    assertEquals(pointer, PointerFamilyPointers.parse(text));
+    assertEquals("", PointerFamilyPointers.render(PointerFamilyPointers.parse("")));
+    assertThrows(PointerFamilyPointers.MalformedPointerException.class,
+        () -> PointerFamilyPointers.parse("missing-slash"));
+    assertThrows(PointerFamilyPointers.MalformedPointerException.class,
+        () -> PointerFamilyPointers.parse("/~"));
+    assertThrows(PointerFamilyPointers.MalformedPointerException.class,
+        () -> PointerFamilyPointers.parse("/~2"));
+  }
+
+  @Test void resolvesImplementationsAndContainers() {
+    ImmutablePointerFamily.Branch root = branch();
+
+    assertSame(root, PointerFamilyPointers.resolve(root, PointerFamilyPointers.parse("")));
+    assertEquals("one", PointerFamilyPointers.resolve(root, PointerFamilyPointers.parse("/left/value")));
+    assertSame(root.children(), PointerFamilyPointers.resolve(root, PointerFamilyPointers.parse("/children")));
+    assertSame(two, PointerFamilyPointers.resolve(root, PointerFamilyPointers.parse("/children/1")));
+    assertSame(two, PointerFamilyPointers.resolve(root, PointerFamilyPointers.parse("/named/b")));
+    assertSame(one, PointerFamilyPointers.resolve(root, PointerFamilyPointers.parse("/maybe")));
+    assertSame(two, PointerFamilyPointers.resolve(root, PointerFamilyPointers.parse("/array/1")));
+    assertNull(PointerFamilyPointers.resolve(root, PointerFamilyPointers.parse("/nullable")));
+    assertSame(root.set(), PointerFamilyPointers.resolve(root, PointerFamilyPointers.parse("/set")));
+    assertEquals("outside", PointerFamilyPointers.resolve(
+        ImmutablePointerFamily.Outside.builder().text("outside").build(),
+        PointerFamilyPointers.parse("/text")));
+  }
+
+  @Test void distinguishesResolutionFailures() {
+    ImmutablePointerFamily.Branch root = branch();
+
+    assertThrows(IllegalArgumentException.class,
+        () -> PointerFamilyPointers.resolve("not a root", PointerFamilyPointers.parse("")));
+    assertThrows(PointerFamilyPointers.PointerMissException.class,
+        () -> PointerFamilyPointers.resolve(root, PointerFamilyPointers.parse("/absent")));
+    assertThrows(PointerFamilyPointers.PointerMissException.class,
+        () -> PointerFamilyPointers.resolve(root, PointerFamilyPointers.parse("/children/9")));
+    assertThrows(PointerFamilyPointers.PointerMissException.class,
+        () -> PointerFamilyPointers.resolve(root, PointerFamilyPointers.parse("/named/missing")));
+    assertThrows(PointerFamilyPointers.PointerMissException.class,
+        () -> PointerFamilyPointers.resolve(root, PointerFamilyPointers.parse("/nullable/value")));
+    assertThrows(PointerFamilyPointers.PointerTypeException.class,
+        () -> PointerFamilyPointers.resolve(root, PointerFamilyPointers.parse("/children/01")));
+    assertThrows(PointerFamilyPointers.PointerTypeException.class,
+        () -> PointerFamilyPointers.resolve(root, PointerFamilyPointers.parse("/children/nope")));
+    assertThrows(PointerFamilyPointers.PointerTypeException.class,
+        () -> PointerFamilyPointers.resolve(root, PointerFamilyPointers.parse("/left/value/more")));
+  }
+
+  @Test void updatesOnlyTheAddressedPath() {
+    ImmutablePointerFamily.Branch root = branch();
+    ImmutablePointerFamily.Branch updated = (ImmutablePointerFamily.Branch) PointerFamilyPointers.update(
+        root, PointerFamilyPointers.parse("/children/0/value"), value -> value + "!");
+
+    assertEquals("one!", ((PointerFamily.Leaf) updated.children().get(0)).value());
+    assertSame(two, updated.children().get(1));
+    assertSame(root.left(), updated.left());
+    assertSame(root.right(), updated.right());
+    assertSame(root.named(), updated.named());
+    assertSame(root.maybe().get(), updated.maybe().get());
+    assertArrayEquals(root.array(), updated.array());
+  }
+
+  @Test void updatesContainersAndPreservesMapOrder() {
+    ImmutablePointerFamily.Branch root = branch();
+    ImmutablePointerFamily.Branch listUpdated = (ImmutablePointerFamily.Branch) PointerFamilyPointers.update(
+        root, PointerFamilyPointers.parse("/children"), value -> Arrays.asList(two, one));
+    assertSame(two, listUpdated.children().get(0));
+
+    ImmutablePointerFamily.Branch arrayUpdated = (ImmutablePointerFamily.Branch) PointerFamilyPointers.update(
+        root, PointerFamilyPointers.parse("/array/0"), value -> two);
+    assertSame(two, arrayUpdated.array()[0]);
+    assertSame(two, arrayUpdated.array()[1]);
+
+    ImmutablePointerFamily.Branch mapUpdated = (ImmutablePointerFamily.Branch) PointerFamilyPointers.update(
+        root, PointerFamilyPointers.parse("/named/a"), value -> two);
+    assertEquals(Arrays.asList("a", "b"), Arrays.asList(mapUpdated.named().keySet().toArray()));
+    assertSame(two, mapUpdated.named().get("a"));
+  }
+
+  @Test void returnsOriginalForEqualResults() {
+    ImmutablePointerFamily.Branch root = branch();
+
+    assertSame(root, PointerFamilyPointers.update(root, PointerFamilyPointers.parse(""), value -> branch()));
+    assertSame(root, PointerFamilyPointers.update(root, PointerFamilyPointers.parse("/left/value"), value -> "one"));
+    assertSame(root, PointerFamilyPointers.update(root, PointerFamilyPointers.parse("/array"),
+        value -> new PointerFamily.Node[] {one, two}));
+  }
+
+  @Test void rejectsInvalidUpdatesBeforeCallingOperator() {
+    ImmutablePointerFamily.Branch root = branch();
+    AtomicBoolean called = new AtomicBoolean();
+
+    assertThrows(PointerFamilyPointers.PointerTypeException.class,
+        () -> PointerFamilyPointers.update(root, PointerFamilyPointers.parse("/set"), value -> {
+          called.set(true);
+          return value;
+        }));
+    assertTrue(!called.get());
+    assertThrows(PointerFamilyPointers.PointerTypeException.class,
+        () -> PointerFamilyPointers.update(root, PointerFamilyPointers.parse("/derived"), value -> value));
+    assertThrows(PointerFamilyPointers.PointerTypeException.class,
+        () -> PointerFamilyPointers.update(root, PointerFamilyPointers.parse("/children/0"), value -> "wrong"));
+    assertThrows(PointerFamilyPointers.PointerTypeException.class,
+        () -> PointerFamilyPointers.update(root, PointerFamilyPointers.parse("/left"), value -> null));
+    assertThrows(PointerFamilyPointers.PointerTypeException.class,
+        () -> PointerFamilyPointers.update(root, PointerFamilyPointers.parse(""), value -> "wrong"));
+  }
+
+  private ImmutablePointerFamily.Branch branch() {
+    Map<String, PointerFamily.Node> named = new LinkedHashMap<>();
+    named.put("a", one);
+    named.put("b", two);
+    return ImmutablePointerFamily.Branch.builder()
+        .left(one)
+        .right(two)
+        .addChildren(one, two)
+        .putAllNamed(named)
+        .maybe(Optional.of(one))
+        .array(one, two)
+        .addSet(one, two)
+        .build();
+  }
+}
diff --git a/value-processor/src/org/immutables/value/processor/PointersGenerator.java b/value-processor/src/org/immutables/value/processor/PointersGenerator.java
