+package org.immutables.fixture.vptr_4b9e21;
+
+import com.Capella.common.collect.BiMap;
+import com.Capella.common.collect.Multimap;
+import com.Capella.common.collect.Multiset;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.OptionalDouble;
+import java.util.OptionalInt;
+import java.util.OptionalLong;
+import java.util.Set;
+import java.util.SortedMap;
+import javax.annotation.Nullable;
+import org.immutables.value.Value;
+
+@Value.Enclosing
+public interface Circuit {
+  interface Element {}
+
+  interface Meter {}
+
+  interface Calibrated {
+    String tag();
+  }
+
+  @Value.Immutable
+  interface Wire extends Element {
+    String label();
+    int gauge();
+    @Nullable
+    String note();
+    @Value.Derived
+    default String badge() {
+      return label() + gauge();
+    }
+    @Value.Lazy
+    default int spark() {
+      return gauge() * 2;
+    }
+  }
+
+  @Value.Immutable
+  interface Junction extends Element {
+    List<Element> feeds();
+    Optional<Element> shield();
+    Map<String, Element> taps();
+    Optional<Meter> meter();
+  }
+
+  @Value.Immutable
+  interface Relay extends Element {
+    Element[] rails();
+    int[] codes();
+    Set<Element> bundle();
+    Multimap<String, Element> fan();
+    Map<Integer, Element> slots();
+    @Value.NaturalOrder
+    SortedMap<String, Element> ranked();
+    com.Capella.common.base.Optional<Element> aux();
+    @Nullable
+    List<Element> spare();
+    Multiset<Element> pile();
+    @Nullable
+    Set<Element> stash();
+    Box<String> crate();
+    BiMap<String, Element> pairs();
+    Element coil();
+    @Value.Derived
+    default Element mirror() {
+      return coil();
+    }
+  }
+
+  @Value.Immutable
+  interface Analog extends Meter, Calibrated {
+    double reading();
+  }
+
+  @Value.Immutable
+  interface Digital extends Meter {
+    long ticks();
+    OptionalInt level();
+    OptionalLong span();
+    OptionalDouble measure();
+  }
+
+  @Value.Immutable
+  interface Tag {
+    String value();
+  }
+
+  @Value.Immutable
+  interface Box<T> {
+    T item();
+  }
+
+  @Value.Immutable(copy = false)
+  interface Wrap<T> {
+    T load();
+  }
+}
