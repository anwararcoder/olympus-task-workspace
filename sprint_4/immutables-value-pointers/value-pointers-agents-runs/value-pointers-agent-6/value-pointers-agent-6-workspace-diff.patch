+    line(out, "      return null;");
+    line(out, "    }");
+    line(out, "    if (!type.isInstance(value)) throw type(\"Replacement has the wrong type\");");
+    line(out, "    return (T) value;");
+    line(out, "  }");
+    line(out, "  private static void checkElements(Iterable<?> values, Class<?> type, boolean nullable) {");
+    line(out, "    for (Object value : values) checked(value, type, nullable);");
+    line(out, "  }");
+    line(out, "  private static PointerMissException miss(String message) { return new PointerMissException(message); }");
+    line(out, "  private static PointerTypeException type(String message) { return new PointerTypeException(message); }");
+  }
+
+  private void emitResolveImplementation(StringBuilder out, ValueType type) {
+    String immutable = type.typeImmutable().toString();
+    line(out, "");
+    line(out, "  private static Object resolve(" + immutable + " value, java.util.List<String> steps, int at) {");
+    line(out, "    String step = steps.get(at);");
+    for (ValueAttribute attribute : type.getAllAccessibleAttributes()) {
+      line(out, "    if (step.equals(" + literal(attribute.name()) + ")) {");
+      emitResolveAttribute(out, type, attribute, "      ");
+      line(out, "    }");
+    }
+    line(out, "    throw miss(\"Attribute is absent: \" + step);");
+    line(out, "  }");
+  }
+
+  private void emitResolveAttribute(StringBuilder out, ValueType owner, ValueAttribute attribute, String indent) {
+    String access = "value." + attribute.names.get + "()";
+    String next = "at + 1";
+    if (attribute.isOptionalType()) {
+      line(out, indent + attribute.getType() + " selected = " + access + ";");
+      line(out, indent + "if (selected == null || !selected.isPresent()) throw miss(\"Optional is empty\");");
+      String get = attribute.isJdkSpecializedOptional() ? specializedGet(attribute) : "get()";
+      line(out, indent + "return resolveValue(selected." + get + ", steps, " + next + ");");
+    } else if (attribute.isListType()) {
+      line(out, indent + "java.util.List<?> selected = " + access + ";");
+      line(out, indent + "if (" + next + " == steps.size()) return selected;");
+      line(out, indent + "if (selected == null) throw miss(\"Step through null\");");
+      line(out, indent + "return resolveValue(listElement(selected, steps.get(" + next + ")), steps, at + 2);");
+    } else if (isStringMap(attribute)) {
+      line(out, indent + "java.util.Map<?, ?> selected = " + access + ";");
+      line(out, indent + "if (" + next + " == steps.size()) return selected;");
+      line(out, indent + "if (selected == null) throw miss(\"Step through null\");");
+      line(out, indent + "return resolveValue(mapElement(selected, steps.get(" + next + ")), steps, at + 2);");
+    } else if (attribute.isReferenceArrayType()) {
+      line(out, indent + "Object selected = " + access + ";");
+      line(out, indent + "if (" + next + " == steps.size()) return selected;");
+      line(out, indent + "if (selected == null) throw miss(\"Step through null\");");
+      line(out, indent + "return resolveValue(arrayElement(selected, steps.get(" + next + ")), steps, at + 2);");
+    } else {
+      line(out, indent + "Object selected = " + access + ";");
+      line(out, indent + "return resolveValue(selected, steps, " + next + ");");
+    }
+  }
+
+  private void emitUpdateImplementation(StringBuilder out, ValueType type) {
+    String immutable = type.typeImmutable().toString();
+    line(out, "");
+    line(out, "  private static Object update(" + immutable + " value, java.util.List<String> steps, int at, java.util.function.UnaryOperator operator) {");
+    line(out, "    String step = steps.get(at);");
+    for (ValueAttribute attribute : type.getAllAccessibleAttributes()) {
+      line(out, "    if (step.equals(" + literal(attribute.name()) + ")) {");
+      if (!attribute.isSettable()) {
+        line(out, "      throw type(\"Derived and lazy attributes cannot be updated\");");
+      } else {
+        emitUpdateAttribute(out, type, attribute, "      ");
+      }
+      line(out, "    }");
+    }
+    line(out, "    throw miss(\"Attribute is absent: \" + step);");
+    line(out, "  }");
+  }
+
+  private void emitUpdateAttribute(StringBuilder out, ValueType owner, ValueAttribute attribute, String indent) {
+    String access = "value." + attribute.names.get + "()";
+    String with = "value." + attribute.names.with;
+    String valueClass = classLiteral(memberType(owner, attribute));
+    String elementClass = classLiteral(elementType(owner, attribute, false));
+    String mapValueClass = classLiteral(elementType(owner, attribute, true));
+    boolean nullable = attribute.isNullable();
+    boolean nullableElements = attribute.nullElements.allow();
+
+    if (attribute.isOptionalType()) {
+      line(out, indent + attribute.getType() + " selected = " + access + ";");
+      line(out, indent + "if (selected == null || !selected.isPresent()) throw miss(\"Optional is empty\");");
+      String get = attribute.isJdkSpecializedOptional() ? specializedGet(attribute) : "get()";
+      line(out, indent + "Object old = selected." + get + ";");
+      line(out, indent + "Object replacement = at + 1 == steps.size() ? operator.apply(old) : updateValue(old, steps, at + 1, operator);");
+      line(out, indent + "if (same(old, replacement)) return value;");
+      line(out, indent + "checked(replacement, " + elementClass + ", false);");
+      line(out, indent + "return " + with + "((" + castType(elementType(owner, attribute, false))
+          + ") checked(replacement, " + elementClass + ", false));");
+      return;
+    }
+
+    if (attribute.isListType()) {
+      line(out, indent + "java.util.List<?> selected = " + access + ";");
+      line(out, indent + "if (at + 1 == steps.size()) {");
+      line(out, indent + "  Object replacement = operator.apply(selected);");
+      line(out, indent + "  if (same(selected, replacement)) return value;");
+      line(out, indent + "  java.util.List<?> checked = checked(replacement, java.util.List.class, " + nullable + ");");
+      line(out, indent + "  if (checked != null) checkElements(checked, " + elementClass + ", " + nullableElements + ");");
+      line(out, indent + "  return " + with + "((java.lang.Iterable) checked);");
+      line(out, indent + "}");
+      line(out, indent + "if (selected == null) throw miss(\"Step through null\");");
+      line(out, indent + "int selectedIndex = index(steps.get(at + 1));");
+      line(out, indent + "if (selectedIndex >= selected.size()) throw miss(\"List index is out of bounds\");");
+      line(out, indent + "Object old = selected.get(selectedIndex);");
+      line(out, indent + "Object replacement = at + 2 == steps.size() ? operator.apply(old) : updateValue(old, steps, at + 2, operator);");
+      line(out, indent + "if (same(old, replacement)) return value;");
+      line(out, indent + "checked(replacement, " + elementClass + ", " + nullableElements + ");");
+      line(out, indent + "java.util.List<Object> copy = new java.util.ArrayList<Object>(selected);");
+      line(out, indent + "copy.set(selectedIndex, replacement);");
+      line(out, indent + "return " + with + "((java.lang.Iterable) copy);");
+      return;
+    }
+
+    if (isStringMap(attribute)) {
+      line(out, indent + "java.util.Map<?, ?> selected = " + access + ";");
+      line(out, indent + "if (at + 1 == steps.size()) {");
+      line(out, indent + "  Object replacement = operator.apply(selected);");
+      line(out, indent + "  if (same(selected, replacement)) return value;");
+      line(out, indent + "  java.util.Map<?, ?> checked = checked(replacement, java.util.Map.class, " + nullable + ");");
+      line(out, indent + "  if (checked != null) {");
+      line(out, indent + "    checkElements(checked.keySet(), String.class, false);");
+      line(out, indent + "    checkElements(checked.values(), " + mapValueClass + ", " + nullableElements + ");");
+      line(out, indent + "  }");
+      line(out, indent + "  return " + with + "((java.util.Map) checked);");
+      line(out, indent + "}");
+      line(out, indent + "if (selected == null) throw miss(\"Step through null\");");
+      line(out, indent + "String key = steps.get(at + 1);");
+      line(out, indent + "if (!selected.containsKey(key)) throw miss(\"Map key is absent\");");
+      line(out, indent + "Object old = selected.get(key);");
+      line(out, indent + "Object replacement = at + 2 == steps.size() ? operator.apply(old) : updateValue(old, steps, at + 2, operator);");
+      line(out, indent + "if (same(old, replacement)) return value;");
+      line(out, indent + "checked(replacement, " + mapValueClass + ", " + nullableElements + ");");
+      line(out, indent + "java.util.Map<String, Object> copy = new java.util.LinkedHashMap<String, Object>();");
+      line(out, indent + "for (java.util.Map.Entry<?, ?> entry : selected.entrySet()) copy.put((String) entry.getKey(), entry.getValue());");
+      line(out, indent + "copy.put(key, replacement);");
+      line(out, indent + "return " + with + "((java.util.Map) copy);");
+      return;
+    }
+
+    if (attribute.isReferenceArrayType()) {
+      line(out, indent + "Object selected = " + access + ";");
+      line(out, indent + "if (at + 1 == steps.size()) {");
+      line(out, indent + "  Object replacement = operator.apply(selected);");
+      line(out, indent + "  if (same(selected, replacement)) return value;");
+      line(out, indent + "  return " + with + "(checked(replacement, " + valueClass + ", " + nullable + "));");
+      line(out, indent + "}");
+      line(out, indent + "if (selected == null) throw miss(\"Step through null\");");
+      line(out, indent + "int selectedIndex = index(steps.get(at + 1));");
+      line(out, indent + "int length = java.lang.reflect.Array.getLength(selected);");
+      line(out, indent + "if (selectedIndex >= length) throw miss(\"Array index is out of bounds\");");
+      line(out, indent + "Object old = java.lang.reflect.Array.get(selected, selectedIndex);");
+      line(out, indent + "Object replacement = at + 2 == steps.size() ? operator.apply(old) : updateValue(old, steps, at + 2, operator);");
+      line(out, indent + "if (same(old, replacement)) return value;");
+      line(out, indent + "checked(replacement, " + elementClass + ", " + nullableElements + ");");
+      line(out, indent + "Object copy = java.lang.reflect.Array.newInstance(selected.getClass().getComponentType(), length);");
+      line(out, indent + "System.arraycopy(selected, 0, copy, 0, length);");
+      line(out, indent + "java.lang.reflect.Array.set(copy, selectedIndex, replacement);");
+      line(out, indent + "return " + with + "(checked(copy, " + valueClass + ", false));");
+      return;
+    }
+
+    if (attribute.isSetType() || attribute.isMultisetType() || attribute.isMultimapType()
+        || attribute.isSortedMapType() || attribute.isPrimitiveArrayType()
+        || attribute.isMapType() && !isStringMap(attribute)) {
+      line(out, indent + "throw type(\"This attribute cannot be updated\");");
+      return;
+    }
+
+    line(out, indent + "Object old = " + access + ";");
+    line(out, indent + "Object replacement = at + 1 == steps.size() ? operator.apply(old) : updateValue(old, steps, at + 1, operator);");
+    line(out, indent + "if (same(old, replacement)) return value;");
+    line(out, indent + "return " + with + "(checked(replacement, " + valueClass + ", " + nullable + "));");
+  }
+
+  private TypeMirror memberType(ValueType owner, ValueAttribute attribute) {
+    if (attribute.element() instanceof ExecutableElement && owner.element.asType() instanceof DeclaredType) {
+      try {
+        TypeMirror member = processing.getTypeUtils().asMemberOf(
+            (DeclaredType) owner.element.asType(), attribute.element());
+        if (member instanceof ExecutableType) {
+          return ((ExecutableType) member).getReturnType();
+        }
+      } catch (IllegalArgumentException ex) {
+        // Fall back to the declaration's return type.
+      }
+      return ((ExecutableElement) attribute.element()).getReturnType();
+    }
+    return attribute.element().asType();
+  }
+
+  private TypeMirror elementType(ValueType owner, ValueAttribute attribute, boolean mapValue) {
+    switch (attribute.typeKind()) {
+      case OPTIONAL_INT_JDK:
+        return processing.getTypeUtils().getPrimitiveType(TypeKind.INT);
+      case OPTIONAL_LONG_JDK:
+        return processing.getTypeUtils().getPrimitiveType(TypeKind.LONG);
+      case OPTIONAL_DOUBLE_JDK:
+        return processing.getTypeUtils().getPrimitiveType(TypeKind.DOUBLE);
+      default:
+    }
+    TypeMirror type = memberType(owner, attribute);
+    if (type.getKind() == TypeKind.ARRAY) {
+      return ((ArrayType) type).getComponentType();
+    }
+    if (type instanceof DeclaredType) {
+      List<? extends TypeMirror> arguments = ((DeclaredType) type).getTypeArguments();
+      int index = mapValue ? 1 : 0;
+      if (arguments.size() > index) {
+        return arguments.get(index);
+      }
+    }
+    return processing.getElementUtils().getTypeElement(Object.class.getName()).asType();
+  }
+
+  private String classLiteral(TypeMirror type) {
+    TypeKind kind = type.getKind();
+    if (kind.isPrimitive()) {
+      TypeElement boxed = processing.getTypeUtils().boxedClass((PrimitiveType) type);
+      return boxed.getQualifiedName() + ".class";
+    }
+    if (kind == TypeKind.ARRAY) {
+      return processing.getTypeUtils().erasure(type).toString() + ".class";
+    }
+    if (kind == TypeKind.DECLARED) {
+      return processing.getTypeUtils().erasure(type).toString() + ".class";
+    }
+    return "Object.class";
+  }
+
+  private boolean isStringMap(ValueAttribute attribute) {
+    return attribute.isMapType()
+        && attribute.typeKind().isPlainMapKind()
+        && (String.class.getName().equals(attribute.firstTypeParameter())
+            || String.class.getSimpleName().equals(attribute.firstTypeParameter()));
+  }
+
+  private String specializedGet(ValueAttribute attribute) {
+    switch (attribute.typeKind()) {
+      case OPTIONAL_INT_JDK:
+        return "getAsInt()";
+      case OPTIONAL_LONG_JDK:
+        return "getAsLong()";
+      case OPTIONAL_DOUBLE_JDK:
+        return "getAsDouble()";
+      default:
+        return "get()";
+    }
+  }
+
+  private String castType(TypeMirror type) {
+    if (type.getKind().isPrimitive()) {
+      return processing.getTypeUtils().boxedClass((PrimitiveType) type).getQualifiedName().toString();
+    }
+    if (type.getKind() == TypeKind.DECLARED || type.getKind() == TypeKind.ARRAY) {
+      return processing.getTypeUtils().erasure(type).toString();
+    }
+    return Object.class.getName();
+  }
+
+  private static String literal(String value) {
+    return '"' + value.replace("\\", "\\\\").replace("\"", "\\\"") + '"';
+  }
+
+  private static void line(StringBuilder out, String line) {
+    out.append(line).append('\n');
+  }
+}
