--- /dev/null
+++ b/value-fixture/test/org/immutables/fixture/pointers/PointerValuesTest.java
@@ -0,0 +1,103 @@
+package org.immutables.fixture.pointers;
+
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.Optional;
+import org.immutables.fixture.pointers.ImmutablePointerValues.Box;
+import org.immutables.fixture.pointers.ImmutablePointerValues.Branch;
+import org.immutables.fixture.pointers.ImmutablePointerValues.Leaf;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+public class PointerValuesTest {
+  private static Leaf leaf(String value) {
+    return Leaf.builder().value(value).build();
+  }
+
+  private static Branch branch() {
+    Leaf left = leaf("left");
+    Map<String, PointerValues.Node> named = new LinkedHashMap<>();
+    named.put("first", leaf("map"));
+    return Branch.builder()
+        .left(left)
+        .addChildren(leaf("zero"), leaf("one"))
+        .named(named)
+        .optional(Optional.of(leaf("optional")))
+        .nullable(null)
+        .numbers(1, 2)
+        .build();
+  }
+
+  @Test public void parseAndRender() {
+    PointerValuesPointers.Pointer pointer = PointerValuesPointers.parse("/a~1b/~0/");
+    assertEquals("/a~1b/~0/", PointerValuesPointers.render(pointer));
+    assertEquals(pointer, PointerValuesPointers.parse(pointer.toString()));
+    assertEquals("", PointerValuesPointers.parse("").toString());
+    assertThrows(PointerValuesPointers.MalformedPointerException.class,
+        () -> PointerValuesPointers.parse("missing-slash"));
+    assertThrows(PointerValuesPointers.MalformedPointerException.class,
+        () -> PointerValuesPointers.parse("/~2"));
+  }
+
+  @Test public void resolveValuesAndContainers() {
+    Branch root = branch();
+    assertSame(root, PointerValuesPointers.resolve(root, PointerValuesPointers.parse("")));
+    assertEquals("left", PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/left/value")));
+    assertEquals("one", PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/children/1/value")));
+    assertEquals("map", PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/named/first/value")));
+    assertEquals("optional", ((PointerValues.Leaf) PointerValuesPointers.resolve(
+        root, PointerValuesPointers.parse("/optional"))).value());
+    assertEquals("optional", PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/optional/value")));
+    assertNull(PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/nullable")));
+    assertSame(root.children(), PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/children")));
+  }
+
+  @Test public void updateSharesOffPathValues() {
+    Branch root = branch();
+    Branch changed = (Branch) PointerValuesPointers.update(root,
+        PointerValuesPointers.parse("/children/1/value"), value -> "changed");
+    assertNotSame(root, changed);
+    assertSame(root.left(), changed.left());
+    assertSame(root.children().get(0), changed.children().get(0));
+    assertEquals("changed", ((PointerValues.Leaf) changed.children().get(1)).value());
+    assertSame(root.named(), changed.named());
+    assertSame(root, PointerValuesPointers.update(root,
+        PointerValuesPointers.parse("/left/value"), value -> new String("left")));
+    Branch changedOptional = (Branch) PointerValuesPointers.update(root,
+        PointerValuesPointers.parse("/optional"), value -> leaf("new optional"));
+    assertEquals("new optional", ((PointerValues.Leaf) changedOptional.optional().get()).value());
+  }
+
+  @Test public void updateContainersAndRoot() {
+    Branch root = branch();
+    Branch changedMap = (Branch) PointerValuesPointers.update(root,
+        PointerValuesPointers.parse("/named/first"), value -> leaf("new"));
+    assertEquals(Arrays.asList("first"), Arrays.asList(changedMap.named().keySet().toArray()));
+    assertEquals("new", ((PointerValues.Leaf) changedMap.named().get("first")).value());
+
+    Box box = Box.builder().node(root).build();
+    Box changedBox = (Box) PointerValuesPointers.update(box,
+        PointerValuesPointers.parse("/node/left"), value -> leaf("replacement"));
+    assertEquals("replacement", ((PointerValues.Leaf) ((PointerValues.Branch) changedBox.node()).left()).value());
+  }
+
+  @Test public void failuresAreDistinct() {
+    Branch root = branch();
+    assertThrows(PointerValuesPointers.PointerMissException.class,
+        () -> PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/missing")));
+    assertThrows(PointerValuesPointers.PointerMissException.class,
+        () -> PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/children/20")));
+    assertThrows(PointerValuesPointers.PointerMissException.class,
+        () -> PointerValuesPointers.resolve(root, PointerValuesPointers.parse(
+            "/children/999999999999999999999999999999999999")));
+    assertThrows(PointerValuesPointers.PointerTypeException.class,
+        () -> PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/children/-1")));
+    assertThrows(PointerValuesPointers.PointerTypeException.class,
+        () -> PointerValuesPointers.update(root, PointerValuesPointers.parse("/numbers"), value -> value));
+    assertThrows(PointerValuesPointers.PointerTypeException.class,
+        () -> PointerValuesPointers.update(root, PointerValuesPointers.parse("/left"), value -> "wrong"));
+    assertThrows(IllegalArgumentException.class,
+        () -> PointerValuesPointers.resolve("wrong", PointerValuesPointers.parse("")));
+  }
+}
diff --git a/value-processor/src/org/immutables/value/processor/Pointers.generator b/value-processor/src/org/immutables/value/processor/Pointers.generator
