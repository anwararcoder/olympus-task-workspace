+[template public generate]
+[for type in values.values]
+[if type.generatePointers]
+[output.java type.package (type.typeAbstract.simple 'Pointers') type.element]
+[type.sourceHeader]
+[if type.package]package [type.package];[/if]
+
+/** Pointer operations for immutable values enclosed by {@link [type.typeAbstract.relativeRaw]}. */
+public final class [type.typeAbstract.simple]Pointers {
+  private [type.typeAbstract.simple]Pointers() {}
+
+  private static final int SCALAR = 0;
+  private static final int LIST = 1;
+  private static final int ARRAY = 2;
+  private static final int MAP = 3;
+  private static final int OPTIONAL = 4;
+  private static final int BLOCKED = 5;
+
+  private static final java.util.Map<Class<?>, Model> MODELS = models();
+
+  private static java.util.Map<Class<?>, Model> models() {
+    java.util.Map<Class<?>, Model> models = new java.util.LinkedHashMap<>();
+[for v in type.pointerImplementations]
+    models.put([v.typeImmutable.relativeRaw].class, new Model([v.typeImmutable.relativeRaw].class, new Attribute['[]'] {
+[for a in v.allAccessibleAttributes]
+      [if not for.first],[/if]new Attribute("[a.name]", "[a.names.with]", [a.pointerKind], [a.nullable], [a.pointerElementNullable], [a.pointerUpdateForbidden])
+[/for]
+    }));
+[/for]
+    return java.util.Collections.unmodifiableMap(models);
+  }
+
+  public static final class Pointer {
+    private final java.util.List<String> steps;
+    private final String rendered;
+
+    private Pointer(java.util.List<String> steps, String rendered) {
+      this.steps = java.util.Collections.unmodifiableList(steps);
+      this.rendered = rendered;
+    }
+
+    @Override public boolean equals(Object other) {
+      return other instanceof Pointer && rendered.equals(((Pointer) other).rendered);
+    }
+
+    @Override public int hashCode() { return rendered.hashCode(); }
+    @Override public String toString() { return rendered; }
+  }
+
+  public static final class MalformedPointerException extends IllegalArgumentException {
+    private static final long serialVersionUID = 1L;
+    MalformedPointerException(String message) { super(message); }
+  }
+
+  public static final class PointerMissException extends RuntimeException {
+    private static final long serialVersionUID = 1L;
+    PointerMissException(String message) { super(message); }
+  }
+
+  public static final class PointerTypeException extends RuntimeException {
+    private static final long serialVersionUID = 1L;
+    PointerTypeException(String message) { super(message); }
+    PointerTypeException(String message, Throwable cause) { super(message, cause); }
+  }
+
+  public static Pointer parse(String value) {
+    java.util.Objects.requireNonNull(value, "value");
+    if (value.isEmpty()) return new Pointer(new java.util.ArrayList<String>(), value);
+    if (value.charAt(0) != '/') throw new MalformedPointerException("Pointer must start with '/'");
+    java.util.List<String> steps = new java.util.ArrayList<>();
+    int start = 1;
+    for (int end = 1; end <= value.length(); end++) {
+      if (end == value.length() || value.charAt(end) == '/') {
+        String raw = value.substring(start, end);
+        StringBuilder step = new StringBuilder();
+        for (int i = 0; i < raw.length(); i++) {
+          char c = raw.charAt(i);
+          if (c != '~') {
+            step.append(c);
+          } else if (++i >= raw.length()) {
+            throw new MalformedPointerException("Incomplete escape");
+          } else {
+            char escaped = raw.charAt(i);
+            if (escaped == '0') step.append('~');
+            else if (escaped == '1') step.append('/');
+            else throw new MalformedPointerException("Invalid escape '~" + escaped + "'");
+          }
+        }
+        steps.add(step.toString());
+        start = end + 1;
+      }
+    }
+    return new Pointer(steps, value);
+  }
+
+  public static String render(Pointer pointer) {
+    return java.util.Objects.requireNonNull(pointer, "pointer").rendered;
+  }
+
+  public static Object resolve(Object root, Pointer pointer) {
+    requireRoot(root);
+    return resolveAt(root, java.util.Objects.requireNonNull(pointer, "pointer").steps, 0);
+  }
+
+  public static Object update(Object root, Pointer pointer, java.util.function.UnaryOperator<Object> operator) {
+    requireRoot(root);
+    java.util.Objects.requireNonNull(pointer, "pointer");
+    java.util.Objects.requireNonNull(operator, "operator");
+    return updateAt(root, pointer.steps, 0, operator, Position.root());
+  }
+
+  private static Object resolveAt(Object value, java.util.List<String> steps, int at) {
+    if (at == steps.size()) return value;
+    if (value == null) throw miss("step through null", steps, at);
+    Model model = MODELS.get(value.getClass());
+    if (model == null) throw type("no step applies", steps, at);
+    Attribute attribute = model.attributes.get(steps.get(at));
+    if (attribute == null) throw miss("absent attribute", steps, at);
+    Object selected = attribute.get(value);
+    return descendResolve(selected, attribute, steps, at + 1);
+  }
+
+  private static Object descendResolve(Object value, Attribute attribute, java.util.List<String> steps, int at) {
+    if (value == null) {
+      if (at == steps.size()) return null;
+      throw miss("step through null", steps, at);
+    }
+    if (attribute.kind == OPTIONAL) {
+      if (!optionalPresent(value)) throw miss("empty optional", steps, at);
+      return resolveAt(optionalGet(value), steps, at);
+    }
+    if (at == steps.size()) return value;
+    switch (attribute.kind) {
+    case LIST:
+      int listIndex = index(steps.get(at), steps, at);
+      java.util.List<?> list = (java.util.List<?>) value;
+      if (listIndex >= list.size()) throw miss("index past end", steps, at);
+      return resolveAt(list.get(listIndex), steps, at + 1);
+    case ARRAY:
+      int arrayIndex = index(steps.get(at), steps, at);
+      int length = java.lang.reflect.Array.getLength(value);
+      if (arrayIndex >= length) throw miss("index past end", steps, at);
+      return resolveAt(java.lang.reflect.Array.get(value, arrayIndex), steps, at + 1);
+    case MAP:
+      String key = steps.get(at);
+      java.util.Map<?, ?> map = (java.util.Map<?, ?>) value;
+      if (!map.containsKey(key)) throw miss("absent map key", steps, at);
+      return resolveAt(map.get(key), steps, at + 1);
+    default:
+      return resolveAt(value, steps, at);
+    }
+  }
+
+  private static Object updateAt(Object value, java.util.List<String> steps, int at,
+      java.util.function.UnaryOperator<Object> operator, Position position) {
+    if (at == steps.size()) {
+      if (position.updateForbidden) throw type("position cannot be updated", steps, at);
+      Object replacement = operator.apply(value);
+      position.check(replacement, steps, at);
+      return equivalent(value, replacement) ? value : replacement;
+    }
+    if (value == null) throw miss("step through null", steps, at);
+    Model model = MODELS.get(value.getClass());
+    if (model == null) throw type("no step applies", steps, at);
+    Attribute attribute = model.attributes.get(steps.get(at));
+    if (attribute == null) throw miss("absent attribute", steps, at);
+    if (attribute.updateForbidden) throw type("attribute cannot be updated", steps, at);
+    Object selected = attribute.get(value);
+    Object changed = descendUpdate(selected, attribute, steps, at + 1, operator);
+    return changed == selected ? value : attribute.with(value, changed, steps, at);
+  }
+
+  private static Object descendUpdate(Object value, Attribute attribute, java.util.List<String> steps,
+      int at, java.util.function.UnaryOperator<Object> operator) {
+    if (attribute.kind == OPTIONAL) {
+      if (value == null || !optionalPresent(value)) throw miss("empty optional", steps, at);
+      Object content = optionalGet(value);
+      Object changedContent = updateAt(content, steps, at, operator, Position.optionalContent(content));
+      return changedContent == content ? value : optionalWith(value, changedContent, steps, at);
+    }
+    Position position = attribute.position();
+    if (at == steps.size()) return updateAt(value, steps, at, operator, position);
+    if (value == null) throw miss("step through null", steps, at);
+    switch (attribute.kind) {
+    case LIST:
+      int listIndex = index(steps.get(at), steps, at);
+      java.util.List<?> list = (java.util.List<?>) value;
+      if (listIndex >= list.size()) throw miss("index past end", steps, at);
+      Object oldElement = list.get(listIndex);
+      Object newElement = updateAt(oldElement, steps, at + 1, operator,
+          Position.element(oldElement, attribute.elementNullable));
+      if (newElement == oldElement) return value;
+      java.util.List<Object> newList = new java.util.ArrayList<Object>(list);
+      newList.set(listIndex, newElement);
+      return newList;
+    case ARRAY:
+      int arrayIndex = index(steps.get(at), steps, at);
+      int length = java.lang.reflect.Array.getLength(value);
+      if (arrayIndex >= length) throw miss("index past end", steps, at);
+      Object oldArrayElement = java.lang.reflect.Array.get(value, arrayIndex);
+      Object newArrayElement = updateAt(oldArrayElement, steps, at + 1, operator,
+          Position.arrayElement(value.getClass().getComponentType(), attribute.elementNullable));
+      if (newArrayElement == oldArrayElement) return value;
+      Object newArray = cloneArray(value);
+      try {
+        java.lang.reflect.Array.set(newArray, arrayIndex, newArrayElement);
+      } catch (RuntimeException ex) {
+        throw new PointerTypeException("Wrong array element type", ex);
+      }
+      return newArray;
+    case MAP:
+      String key = steps.get(at);
+      java.util.Map<?, ?> map = (java.util.Map<?, ?>) value;
+      if (!map.containsKey(key)) throw miss("absent map key", steps, at);
+      Object oldMapValue = map.get(key);
+      Object newMapValue = updateAt(oldMapValue, steps, at + 1, operator,
+          Position.element(oldMapValue, attribute.elementNullable));
+      if (newMapValue == oldMapValue) return value;
+      java.util.Map<Object, Object> newMap = new java.util.LinkedHashMap<Object, Object>();
+      for (java.util.Map.Entry<?, ?> entry : map.entrySet()) {
+        newMap.put(entry.getKey(), entry.getKey().equals(key) ? newMapValue : entry.getValue());
+      }
+      return newMap;
+    case BLOCKED:
+      throw type("no step applies", steps, at);
+    default:
+      return updateAt(value, steps, at, operator, Position.nested(value));
+    }
+  }
+
+  private static void requireRoot(Object root) {
+    if (root == null || !MODELS.containsKey(root.getClass())) {
+      throw new IllegalArgumentException("Root is not an immutable implementation of [type.typeAbstract.relativeRaw]");
+    }
+  }
+
+  private static int index(String value, java.util.List<String> steps, int at) {
+    if (value.isEmpty() || (value.length() > 1 && value.charAt(0) == '0')) {
+      throw type("invalid index", steps, at);
+    }
+    long result = 0;
+    for (int i = 0; i < value.length(); i++) {
+      char c = value.charAt(i);
+      if (c < '0' || c > '9') throw type("invalid index", steps, at);
+      int digit = c - '0';
+      if (result > (Integer.MAX_VALUE - digit) / 10) throw miss("index past end", steps, at);
+      result = result * 10 + digit;
+    }
+    return (int) result;
+  }
+
+  private static boolean optionalPresent(Object optional) {
+    try {
+      return (Boolean) optional.getClass().getMethod("isPresent").invoke(optional);
+    } catch (ReflectiveOperationException ex) {
+      throw new PointerTypeException("Unsupported optional type", ex);
+    }
+  }
+
+  private static Object optionalGet(Object optional) {
+    String method = optional.getClass().getName().endsWith("OptionalInt") ? "getAsInt"
+        : optional.getClass().getName().endsWith("OptionalLong") ? "getAsLong"
+        : optional.getClass().getName().endsWith("OptionalDouble") ? "getAsDouble" : "get";
+    try {
+      return optional.getClass().getMethod(method).invoke(optional);
+    } catch (ReflectiveOperationException ex) {
+      throw new PointerTypeException("Unsupported optional type", ex);
+    }
+  }
+
+  private static Object optionalWith(Object optional, Object value, java.util.List<String> steps, int at) {
+    Class<?> type = optional.getClass();
+    String method = type.getName().startsWith("java.util.Optional") ? "ofNullable" : "fromNullable";
+    if (type.getName().endsWith("OptionalInt") || type.getName().endsWith("OptionalLong")
+        || type.getName().endsWith("OptionalDouble")) method = "of";
+    for (java.lang.reflect.Method candidate : type.getMethods()) {
+      if (java.lang.reflect.Modifier.isStatic(candidate.getModifiers())
+          && candidate.getName().equals(method) && candidate.getParameterTypes().length == 1) {
+        try {
+          return candidate.invoke(null, value);
+        } catch (ReflectiveOperationException | IllegalArgumentException ex) {
+          throw new PointerTypeException("Wrong optional content type", ex);
+        }
+      }
+    }
+    throw type("Unsupported optional type", steps, at);
+  }
+
+  private static Object cloneArray(Object array) {
+    int length = java.lang.reflect.Array.getLength(array);
+    Object copy = java.lang.reflect.Array.newInstance(array.getClass().getComponentType(), length);
+    System.arraycopy(array, 0, copy, 0, length);
+    return copy;
+  }
+
+  private static boolean equivalent(Object left, Object right) {
+    if (left == right) return true;
+    if (left == null || right == null) return false;
+    if (!left.getClass().isArray() || !right.getClass().isArray()) return left.equals(right);
+    int length = java.lang.reflect.Array.getLength(left);
+    if (length != java.lang.reflect.Array.getLength(right)) return false;
+    for (int i = 0; i < length; i++) {
+      if (!java.util.Objects.deepEquals(java.lang.reflect.Array.get(left, i),
+          java.lang.reflect.Array.get(right, i))) return false;
+    }
+    return true;
+  }
+
+  private static PointerMissException miss(String reason, java.util.List<String> steps, int at) {
+    return new PointerMissException(reason + " at step " + at + " of " + steps);
+  }
+
+  private static PointerTypeException type(String reason, java.util.List<String> steps, int at) {
+    return new PointerTypeException(reason + " at step " + at + " of " + steps);
+  }
+
+  private static final class Model {
+    final Class<?> type;
+    final java.util.Map<String, Attribute> attributes;
+
+    Model(Class<?> type, Attribute['[]'] attributes) {
+      this.type = type;
+      java.util.Map<String, Attribute> byName = new java.util.LinkedHashMap<>();
+      for (Attribute attribute : attributes) {
+        attribute.bind(type);
+        byName.put(attribute.name, attribute);
+      }
+      this.attributes = java.util.Collections.unmodifiableMap(byName);
+    }
+  }
+
+  private static final class Attribute {
+    final String name;
+    final String witherName;
+    final int kind;
+    final boolean nullable;
+    final boolean elementNullable;
+    final boolean updateForbidden;
+    java.lang.reflect.Method getter;
+    java.util.List<java.lang.reflect.Method> withers;
+
+    Attribute(String name, String witherName, int kind, boolean nullable,
+        boolean elementNullable, boolean updateForbidden) {
+      this.name = name;
+      this.witherName = witherName;
+      this.kind = kind;
+      this.nullable = nullable;
+      this.elementNullable = elementNullable;
+      this.updateForbidden = updateForbidden;
+    }
+
+    void bind(Class<?> type) {
+      try {
+        getter = type.getMethod(name);
+      } catch (NoSuchMethodException ex) {
+        throw new ExceptionInInitializerError(ex);
+      }
+      withers = new java.util.ArrayList<>();
+      for (java.lang.reflect.Method method : type.getMethods()) {
+        if (method.getName().equals(witherName) && method.getParameterTypes().length == 1) {
+          withers.add(method);
+        }
+      }
+    }
+
+    Object get(Object instance) {
+      try {
+        return getter.invoke(instance);
+      } catch (ReflectiveOperationException ex) {
+        throw new PointerTypeException("Cannot read attribute " + name, ex);
+      }
+    }
+
+    Object with(Object instance, Object value, java.util.List<String> steps, int at) {
+      Position position = position();
+      position.check(value, steps, at);
+      for (java.lang.reflect.Method wither : withers) {
+        Class<?> parameter = wither.getParameterTypes()['[0]'];
+        Object argument = value;
+        if (kind == LIST && Iterable.class.isAssignableFrom(parameter)) argument = (Iterable<?>) value;
+        if (argument == null ? parameter.isPrimitive() : box(parameter).isInstance(argument)) {
+          try {
+            return wither.invoke(instance, argument);
+          } catch (ReflectiveOperationException | IllegalArgumentException ex) {
+            throw new PointerTypeException("Wrong replacement for attribute " + name, ex);
+          }
+        }
+      }
+      throw type("Wrong replacement for attribute " + name, steps, at);
+    }
+
+    Position position() {
+      Class<?> positionType = kind == LIST ? java.util.List.class
+          : kind == MAP ? java.util.Map.class
+          : getter.getReturnType();
+      return new Position(positionType, nullable, updateForbidden);
+    }
+  }
+
+  private static final class Position {
+    final Class<?> type;
+    final boolean nullable;
+    final boolean updateForbidden;
+    final boolean root;
+
+    Position(Class<?> type, boolean nullable, boolean updateForbidden) {
+      this(type, nullable, updateForbidden, false);
+    }
+
+    Position(Class<?> type, boolean nullable, boolean updateForbidden, boolean root) {
+      this.type = type;
+      this.nullable = nullable;
+      this.updateForbidden = updateForbidden;
+      this.root = root;
+    }
+
+    static Position root() { return new Position(Object.class, false, false, true); }
+    static Position nested(Object value) {
