+package org.immutables.fixture.pointers;
+
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import javax.annotation.Nullable;
+import org.immutables.value.Value;
+
+@Value.Enclosing
+public interface PointerValues {
+  interface Node {}
+
+  @Value.Immutable
+  interface Leaf extends Node {
+    String value();
+  }
+
+  @Value.Immutable
+  interface Branch extends Node {
+    Node left();
+    List<Node> children();
+    Map<String, Node> named();
+    Optional<Node> optional();
+    @Nullable Node nullable();
+    int[] numbers();
+  }
+
+  @Value.Immutable
+  interface Box {
+    Node node();
+  }
+}
diff --git a/value-fixture/test/org/immutables/fixture/pointers/PointerValuesTest.java b/value-fixture/test/org/immutables/fixture/pointers/PointerValuesTest.java
new file mode 100644
