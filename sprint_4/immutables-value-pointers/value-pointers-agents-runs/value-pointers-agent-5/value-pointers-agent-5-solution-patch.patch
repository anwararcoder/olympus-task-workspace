+package org.immutables.fixture.pointers;
+
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.Optional;
+import java.util.concurrent.atomic.AtomicBoolean;
+import org.immutables.fixture.pointers.ImmutablePointerValues.Branch;
+import org.immutables.fixture.pointers.ImmutablePointerValues.Leaf;
+import org.immutables.fixture.pointers.ImmutablePointerValues.Other;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotSame;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+public class PointerValuesTest {
+  private static Leaf leaf(String value) {
+    return Leaf.builder().value(value).build();
+  }
+
+  private static Branch branch() {
+    Leaf a = leaf("a");
+    Leaf b = leaf("b");
+    Map<String, PointerValues.Node> map = new LinkedHashMap<>();
+    map.put("first", a);
+    map.put("second", b);
+    return Branch.builder()
+        .child(a)
+        .children(Arrays.asList(a, b))
+        .array(a, b)
+        .map(map)
+        .optional(Optional.of(b))
+        .nullable(null)
+        .build();
+  }
+
+  @Test
+  public void parsesAndRendersPointers() {
+    PointerValuesPointers.Pointer root = PointerValuesPointers.parse("");
+    PointerValuesPointers.Pointer pointer = PointerValuesPointers.parse("/a~1b/~0/");
+
+    assertEquals("", root.toString());
+    assertEquals("/a~1b/~0/", PointerValuesPointers.render(pointer));
+    assertEquals(pointer, PointerValuesPointers.parse(pointer.toString()));
+    assertThrows(PointerValuesPointers.MalformedPointerException.class,
+        () -> PointerValuesPointers.parse("a"));
+    assertThrows(PointerValuesPointers.MalformedPointerException.class,
+        () -> PointerValuesPointers.parse("/~2"));
+  }
+
+  @Test
+  public void resolvesValuesAndContainers() {
+    Branch root = branch();
+
+    assertSame(root, PointerValuesPointers.resolve(root, PointerValuesPointers.parse("")));
+    assertSame(root.child(), PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/child")));
+    assertEquals("a", PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/child/value")));
+    assertSame(root.children(), PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/children")));
+    assertEquals("b", PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/children/1/value")));
+    assertEquals("a", PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/array/0/value")));
+    assertEquals("b", PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/map/second/value")));
+    assertSame(root.optional().get(),
+        PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/optional")));
+    assertEquals(null, PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/nullable")));
+
+    assertThrows(PointerValuesPointers.PointerMissException.class,
+        () -> PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/missing")));
+    assertThrows(PointerValuesPointers.PointerMissException.class,
+        () -> PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/children/9")));
+    assertThrows(PointerValuesPointers.PointerTypeException.class,
+        () -> PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/children/01")));
+    assertThrows(PointerValuesPointers.PointerMissException.class,
+        () -> PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/nullable/value")));
+  }
+
+  @Test
+  public void updatesOnlyThePointerPath() {
+    Branch root = branch();
+    Branch updated = PointerValuesPointers.update(
+        root,
+        PointerValuesPointers.parse("/children/1/value"),
+        value -> value + "!");
+
+    assertNotSame(root, updated);
+    assertSame(root.child(), updated.child());
+    assertSame(root.children().get(0), updated.children().get(0));
+    assertNotSame(root.children().get(1), updated.children().get(1));
+    assertSame(root.array()[0], updated.array()[0]);
+    assertSame(root.array()[1], updated.array()[1]);
+    assertSame(root.map(), updated.map());
+    assertEquals("b!", ((PointerValues.Leaf) updated.children().get(1)).value());
+
+    assertSame(root, PointerValuesPointers.update(
+        root, PointerValuesPointers.parse("/child/value"), value -> new String("a")));
+  }
+
+  @Test
+  public void updatesContainersAndOtherImplementations() {
+    Branch root = branch();
+    Branch mapUpdated = PointerValuesPointers.update(
+        root, PointerValuesPointers.parse("/map/first"), value -> leaf("x"));
+    assertEquals(Arrays.asList("first", "second"), Arrays.asList(mapUpdated.map().keySet().toArray()));
+    assertSame(root.map().get("second"), mapUpdated.map().get("second"));
+
+    Other other = Other.builder().text("x").build();
+    Other changed = PointerValuesPointers.update(
+        other, PointerValuesPointers.parse("/text"), value -> "y");
+    assertEquals("y", changed.text());
+  }
+
+  @Test
+  public void rejectsInvalidUpdatesBeforeMutation() {
+    Branch root = branch();
+    AtomicBoolean called = new AtomicBoolean();
+
+    assertThrows(PointerValuesPointers.PointerTypeException.class,
+        () -> PointerValuesPointers.update(root, PointerValuesPointers.parse("/derived"), value -> {
+          called.set(true);
+          return value;
+        }));
+    assertEquals(false, called.get());
+    assertThrows(PointerValuesPointers.PointerTypeException.class,
+        () -> PointerValuesPointers.update(root, PointerValuesPointers.parse("/child"), value -> "wrong"));
+    assertThrows(PointerValuesPointers.PointerTypeException.class,
+        () -> PointerValuesPointers.update(root, PointerValuesPointers.parse(""), value -> "wrong"));
+    assertThrows(IllegalArgumentException.class,
+        () -> PointerValuesPointers.resolve("wrong", PointerValuesPointers.parse("")));
+  }
+}
