+package org.immutables.fixture.pointers;
+
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import javax.annotation.Nullable;
+import org.immutables.value.Value;
+
+@Value.Enclosing
+public interface PointerValues {
+  interface Node {}
+
+  @Value.Immutable
+  interface Leaf extends Node {
+    String value();
+  }
+
+  @Value.Immutable
+  interface Branch extends Node {
+    Node child();
+    List<Node> children();
+    Node[] array();
+    Map<String, Node> map();
+    Optional<Node> optional();
+    @Nullable Node nullable();
+
+    @Value.Derived
+    default String derived() {
+      return "derived";
+    }
+  }
+
+  @Value.Immutable
+  interface Other {
+    String text();
+  }
+}
