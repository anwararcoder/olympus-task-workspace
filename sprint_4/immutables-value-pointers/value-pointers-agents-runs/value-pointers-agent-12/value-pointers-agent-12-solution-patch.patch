index 0000000..4bbbffc
--- /dev/null
+++ b/value-processor/src/org/immutables/value/processor/Pointers.generator
@@ -0,0 +1,745 @@
+[template public generate]
+  [for type in values.values if type.generatePointers]
+[output.java type.pointerPackage type.pointerClassName type.element]
+[generatePointers type]
+[/output.java]
+  [/for]
+[/template]
+
+[template generatePointers Type type]
+[if type.pointerPackage]
+package [type.pointerPackage];
+[/if]
+
+/** Pointer operations for immutable values enclosed by {@code [type.typeAbstract.relativeRaw]}. */
+[if type allowsClasspathAnnotation 'javax.annotation.processing.Generated']
+@javax.annotation.processing.Generated("org.immutables.processor.ProxyProcessor")
+[else if type allowsClasspathAnnotation '[jaxarta].annotation.Generated']
+@[jaxarta].annotation.Generated("org.immutables.processor.ProxyProcessor")
+[/if]
+@SuppressWarnings({"all", "rawtypes", "unchecked"})
+public final class [type.pointerClassName] {
+  private static final int SCALAR = 0;
+  private static final int OPTIONAL = 1;
+  private static final int LIST = 2;
+  private static final int ARRAY = 3;
+  private static final int MAP = 4;
+  private static final int WHOLE = 5;
+  private static final Object ABSENT = new Object();
+
+  private static final Implementation['[]'] IMPLEMENTATIONS = {
+  [for implementation in type.pointerImplementations]
+      [if not for.first],[/if]new Implementation([literal implementation.pointerImplementationBinaryName], new Attribute['[]'] {
+    [for attribute in implementation.allAccessibleAttributes]
+          [if not for.first],[/if]new Attribute([literal attribute.name], [literal attribute.names.get],
+              [literal attribute.names.with], [attribute.pointerKind], [attribute.nullable],
+              [attribute.pointerElementsNullable], [attribute.pointerUpdatable])
+    [/for]
+      })
+  [/for]
+  };
+
+  private [type.pointerClassName]() {}
+
+  public static final class Pointer {
+    private final java.util.List<String> steps;
+    private final String rendered;
+
+    private Pointer(java.util.List<String> steps, String rendered) {
+      this.steps = java.util.Collections.unmodifiableList(steps);
+      this.rendered = rendered;
+    }
+
+    @Override
+    public boolean equals(Object other) {
+      return other instanceof Pointer && rendered.equals(((Pointer) other).rendered);
+    }
+
+    @Override
+    public int hashCode() {
+      return rendered.hashCode();
+    }
+
+    @Override
+    public String toString() {
+      return rendered;
+    }
+  }
+
+  public static class MalformedPointerException extends IllegalArgumentException {
+    private static final long serialVersionUID = 1L;
+
+    public MalformedPointerException(String message) {
+      super(message);
+    }
+  }
+
+  public static class PointerMissException extends IllegalArgumentException {
+    private static final long serialVersionUID = 1L;
+
+    public PointerMissException(String message) {
+      super(message);
+    }
+  }
+
+  public static class PointerTypeException extends IllegalArgumentException {
+    private static final long serialVersionUID = 1L;
+
+    public PointerTypeException(String message) {
+      super(message);
+    }
+
+    private PointerTypeException(String message, Throwable cause) {
+      super(message, cause);
+    }
+  }
+
+  public static Pointer parse(String value) {
+    if (value == null) {
+      throw new MalformedPointerException("Pointer must not be null");
+    }
+    if (value.isEmpty()) {
+      return new Pointer(new java.util.ArrayList<String>(), value);
+    }
+    if (value.charAt(0) != '/') {
+      throw new MalformedPointerException("Pointer must start with '/'");
+    }
+
+    java.util.List<String> steps = new java.util.ArrayList<String>();
+    int start = 1;
+    for (int index = 1; index <= value.length(); index++) {
+      if (index == value.length() || value.charAt(index) == '/') {
+        steps.add(decode(value.substring(start, index)));
+        start = index + 1;
+      }
+    }
+    return new Pointer(steps, value);
+  }
+
+  public static String render(Pointer pointer) {
+    return java.util.Objects.requireNonNull(pointer, "pointer").rendered;
+  }
+
+  public static Object resolve(Object root, Pointer pointer) {
+    requireRoot(root);
+    java.util.List<String> steps = java.util.Objects.requireNonNull(pointer, "pointer").steps;
+    return steps.isEmpty() ? root : resolveValue(root, steps, 0);
+  }
+
+  public static Object update(
+      Object root,
+      Pointer pointer,
+      java.util.function.UnaryOperator operator) {
+    requireRoot(root);
+    java.util.List<String> steps = java.util.Objects.requireNonNull(pointer, "pointer").steps;
+    java.util.Objects.requireNonNull(operator, "operator");
+    if (steps.isEmpty()) {
+      Object replacement = operator.apply(root);
+      if (implementation(replacement) == null) {
+        throw type("Replacement root is not an enclosed immutable implementation");
+      }
+      return equalValues(root, replacement) ? root : replacement;
+    }
+    return updateValue(root, steps, 0, operator);
+  }
+
+  private static String decode(String encoded) {
+    StringBuilder decoded = new StringBuilder(encoded.length());
+    for (int index = 0; index < encoded.length(); index++) {
+      char character = encoded.charAt(index);
+      if (character != '~') {
+        decoded.append(character);
+        continue;
+      }
+      if (++index == encoded.length()) {
+        throw new MalformedPointerException("Incomplete '~' escape");
+      }
+      char escaped = encoded.charAt(index);
+      if (escaped == '0') {
+        decoded.append('~');
+      } else if (escaped == '1') {
+        decoded.append('/');
+      } else {
+        throw new MalformedPointerException("Unknown '~" + escaped + "' escape");
+      }
+    }
+    return decoded.toString();
+  }
+
+  private static Object resolveValue(Object value, java.util.List<String> steps, int offset) {
+    if (value == null) {
+      throw miss("Cannot step through null");
+    }
+    Implementation implementation = implementation(value);
+    if (implementation == null) {
+      throw type("No pointer step applies below " + value.getClass().getName());
+    }
+    Attribute attribute = implementation.attributes.get(steps.get(offset));
+    if (attribute == null) {
+      throw miss("No attribute '" + steps.get(offset) + "'");
+    }
+    Object selected = attribute.read(value);
+    if (selected == ABSENT) {
+      throw miss("Optional attribute '" + attribute.name + "' is empty");
+    }
+    int next = offset + 1;
+    if (next == steps.size()) {
+      return selected;
+    }
+    if (selected == null) {
+      throw miss("Cannot step through null attribute '" + attribute.name + "'");
+    }
+    switch (attribute.kind) {
+      case LIST:
+        return resolveList((java.util.List<?>) selected, steps, next);
+      case ARRAY:
+        return resolveArray(selected, steps, next);
+      case MAP:
+        return resolveMap((java.util.Map<?, ?>) selected, steps, next);
+      case WHOLE:
+        throw type("No pointer step applies below attribute '" + attribute.name + "'");
+      default:
+        return resolveValue(selected, steps, next);
+    }
+  }
+
+  private static Object resolveList(
+      java.util.List<?> list, java.util.List<String> steps, int offset) {
+    int index = index(steps.get(offset), list.size());
+    Object selected = list.get(index);
+    return offset + 1 == steps.size()
+        ? selected
+        : resolveValue(selected, steps, offset + 1);
+  }
+
+  private static Object resolveArray(Object array, java.util.List<String> steps, int offset) {
+    int index = index(steps.get(offset), java.lang.reflect.Array.getLength(array));
+    Object selected = java.lang.reflect.Array.get(array, index);
+    return offset + 1 == steps.size()
+        ? selected
+        : resolveValue(selected, steps, offset + 1);
+  }
+
+  private static Object resolveMap(
+      java.util.Map<?, ?> map, java.util.List<String> steps, int offset) {
+    String key = steps.get(offset);
+    if (!map.containsKey(key)) {
+      throw miss("No map key '" + key + "'");
+    }
+    Object selected = map.get(key);
+    return offset + 1 == steps.size()
+        ? selected
+        : resolveValue(selected, steps, offset + 1);
+  }
+
+  private static Object updateValue(
+      Object value,
+      java.util.List<String> steps,
+      int offset,
+      java.util.function.UnaryOperator operator) {
+    if (value == null) {
+      throw miss("Cannot step through null");
+    }
+    Implementation implementation = implementation(value);
+    if (implementation == null) {
+      throw type("No pointer step applies below " + value.getClass().getName());
+    }
+    Attribute attribute = implementation.attributes.get(steps.get(offset));
+    if (attribute == null) {
+      throw miss("No attribute '" + steps.get(offset) + "'");
+    }
+    if (!attribute.updatable) {
+      throw type("Attribute '" + attribute.name + "' cannot be updated by pointer");
+    }
+
+    Object selected = attribute.read(value);
+    if (selected == ABSENT) {
+      throw miss("Optional attribute '" + attribute.name + "' is empty");
+    }
+    int next = offset + 1;
+    Object replacement;
+    if (next == steps.size()) {
+      replacement = operator.apply(selected);
+      attribute.validate(replacement);
+    } else {
+      if (selected == null) {
+        throw miss("Cannot step through null attribute '" + attribute.name + "'");
+      }
+      switch (attribute.kind) {
+        case LIST:
+          replacement = updateList(
+              (java.util.List<?>) selected, steps, next, operator, attribute);
+          break;
+        case ARRAY:
+          replacement = updateArray(selected, steps, next, operator, attribute);
+          break;
+        case MAP:
+          replacement = updateMap(
+              (java.util.Map<?, ?>) selected, steps, next, operator, attribute);
+          break;
+        default:
+          replacement = updateValue(selected, steps, next, operator);
+      }
+    }
+    return equalValues(selected, replacement) ? value : attribute.write(value, replacement);
+  }
+
+  private static Object updateList(
+      java.util.List<?> list,
+      java.util.List<String> steps,
+      int offset,
+      java.util.function.UnaryOperator operator,
+      Attribute attribute) {
+    int index = index(steps.get(offset), list.size());
+    Object selected = list.get(index);
+    Object replacement;
+    if (offset + 1 == steps.size()) {
+      replacement = operator.apply(selected);
+      attribute.validateElement(replacement);
+    } else {
+      if (selected == null) {
+        throw miss("Cannot step through null list element");
+      }
+      replacement = updateValue(selected, steps, offset + 1, operator);
+      attribute.validateElement(replacement);
+    }
+    if (equalValues(selected, replacement)) {
+      return list;
+    }
+    java.util.ArrayList<Object> copy = new java.util.ArrayList<Object>(list);
+    copy.set(index, replacement);
+    return copy;
+  }
+
+  private static Object updateArray(
+      Object array,
+      java.util.List<String> steps,
+      int offset,
+      java.util.function.UnaryOperator operator,
+      Attribute attribute) {
+    int length = java.lang.reflect.Array.getLength(array);
+    int index = index(steps.get(offset), length);
+    Object selected = java.lang.reflect.Array.get(array, index);
+    Object replacement;
+    if (offset + 1 == steps.size()) {
+      replacement = operator.apply(selected);
+      attribute.validateElement(replacement);
+    } else {
+      if (selected == null) {
+        throw miss("Cannot step through null array element");
+      }
+      replacement = updateValue(selected, steps, offset + 1, operator);
+      attribute.validateElement(replacement);
+    }
+    if (equalValues(selected, replacement)) {
+      return array;
+    }
+    Object copy = java.lang.reflect.Array.newInstance(array.getClass().getComponentType(), length);
+    System.arraycopy(array, 0, copy, 0, length);
+    java.lang.reflect.Array.set(copy, index, replacement);
+    return copy;
+  }
+
+  private static Object updateMap(
+      java.util.Map<?, ?> map,
+      java.util.List<String> steps,
+      int offset,
+      java.util.function.UnaryOperator operator,
+      Attribute attribute) {
+    String key = steps.get(offset);
+    if (!map.containsKey(key)) {
+      throw miss("No map key '" + key + "'");
+    }
+    Object selected = map.get(key);
+    Object replacement;
+    if (offset + 1 == steps.size()) {
+      replacement = operator.apply(selected);
+      attribute.validateElement(replacement);
+    } else {
+      if (selected == null) {
+        throw miss("Cannot step through null map value");
+      }
+      replacement = updateValue(selected, steps, offset + 1, operator);
+      attribute.validateElement(replacement);
+    }
+    if (equalValues(selected, replacement)) {
