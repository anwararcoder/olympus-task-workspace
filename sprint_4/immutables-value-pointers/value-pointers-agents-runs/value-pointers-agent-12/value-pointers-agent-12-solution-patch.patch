@@ -0,0 +1,93 @@
+package org.immutables.fixture;
+
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.Set;
+import javax.annotation.Nullable;
+import org.immutables.value.Value;
+
+@Value.Enclosing
+public abstract class PointerFamily {
+  public interface Node {}
+
+  @Value.Immutable
+  public abstract static class Leaf implements Node {
+    public abstract String value();
+
+    @Nullable
+    public abstract String nullable();
+  }
+
+  @Value.Immutable
+  public abstract static class Branch implements Node {
+    public abstract Node child();
+
+    public abstract Node untouched();
+
+    public abstract List<Node> children();
+
+    public abstract Node[] array();
+
+    public abstract Map<String, Node> named();
+
+    public abstract Optional<Node> optional();
+
+    public abstract Set<Node> set();
+
+    public abstract int[] integers();
+
+    @Value.Derived
+    public Node derived() {
+      return child();
+    }
+
+    @Value.Lazy
+    public Node lazy() {
+      return untouched();
+    }
+  }
+
+  @Value.Immutable
+  public abstract static class Outside {
+    public abstract String value();
+  }
+
+  @Value.Immutable(copy = false)
+  public abstract static class Generic<T> {
+    public abstract T value();
+  }
+}
+
+@Value.Enclosing
+abstract class PointerNoFamily {
+  @Value.Immutable
+  abstract static class First {
+    abstract String value();
+  }
+
+  @Value.Immutable
+  abstract static class Second {
+    abstract String value();
+  }
+}
+
+@Value.Enclosing
+abstract class PointerNoCopies {
+  interface Node {}
+
+  @Value.Immutable
+  abstract static class First implements Node {
+    abstract String value();
+  }
+
+  @Value.Immutable
+  abstract static class Second implements Node {
+    abstract String value();
+  }
+
+  @Value.Immutable(copy = false)
+  abstract static class Outside {
+    abstract String value();
+  }
+}
diff --git a/value-fixture/test/org/immutables/fixture/PointerFamilyTest.java b/value-fixture/test/org/immutables/fixture/PointerFamilyTest.java
new file mode 100644
index 0000000..85a2c88
--- /dev/null
+++ b/value-fixture/test/org/immutables/fixture/PointerFamilyTest.java
@@ -0,0 +1,213 @@
+package org.immutables.fixture;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertInstanceOf;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.concurrent.atomic.AtomicBoolean;
+import org.immutables.fixture.PointerFamily.Branch;
+import org.immutables.fixture.PointerFamily.Leaf;
+import org.immutables.fixture.PointerFamily.Node;
+import org.immutables.fixture.PointerFamily.Outside;
+import org.junit.jupiter.api.Test;
+
+public class PointerFamilyTest {
+  private final Leaf first = ImmutablePointerFamily.Leaf.builder()
+      .value("first")
+      .nullable(null)
+      .build();
+  private final Leaf second = ImmutablePointerFamily.Leaf.builder()
+      .value("second")
+      .nullable("present")
+      .build();
+  private final Branch root = ImmutablePointerFamily.Branch.builder()
+      .child(first)
+      .untouched(second)
+      .addChildren(first, second)
+      .array(first, second)
+      .putNamed("a/b", first)
+      .putNamed("~", second)
+      .putNamed("", first)
+      .optional(second)
+      .addSet(first)
+      .integers(1, 2)
+      .build();
+
+  @Test
+  public void parsesAndRendersPointers() {
+    PointerFamilyPointers.Pointer rootPointer = PointerFamilyPointers.parse("");
+    assertEquals("", PointerFamilyPointers.render(rootPointer));
+    assertEquals(rootPointer, PointerFamilyPointers.parse(""));
+    assertEquals("/named/a~1b", PointerFamilyPointers.parse("/named/a~1b").toString());
+    assertEquals("/named/~0", PointerFamilyPointers.parse("/named/~0").toString());
+    assertEquals("/named/", PointerFamilyPointers.parse("/named/").toString());
+
+    assertThrows(PointerFamilyPointers.MalformedPointerException.class,
+        () -> PointerFamilyPointers.parse("named"));
+    assertThrows(PointerFamilyPointers.MalformedPointerException.class,
+        () -> PointerFamilyPointers.parse("/named/~"));
+    assertThrows(PointerFamilyPointers.MalformedPointerException.class,
+        () -> PointerFamilyPointers.parse("/named/~2"));
+  }
+
+  @Test
+  public void resolvesDynamicValuesAndContainers() {
+    assertSame(root, PointerFamilyPointers.resolve(root, PointerFamilyPointers.parse("")));
+    assertEquals("first", resolve("/child/value"));
+    assertNull(resolve("/child/nullable"));
+    assertSame(first, resolve("/children/0"));
+    assertEquals("second", resolve("/array/1/value"));
+    assertSame(first, resolve("/named/a~1b"));
+    assertSame(second, resolve("/named/~0"));
+    assertSame(first, resolve("/named/"));
+    assertEquals("second", resolve("/optional/value"));
+    assertEquals("first", resolve("/derived/value"));
+    assertEquals("second", resolve("/lazy/value"));
+    assertSame(root.children(), resolve("/children"));
+    assertSame(root.named(), resolve("/named"));
+    assertArrayEquals(root.array(), (Node[]) resolve("/array"));
+    assertSame(root.set(), resolve("/set"));
+    assertArrayEquals(root.integers(), (int[]) resolve("/integers"));
+  }
+
+  @Test
+  public void reportsDistinctResolutionFailures() {
+    assertThrows(PointerFamilyPointers.PointerMissException.class,
+        () -> resolve("/missing"));
+    assertThrows(PointerFamilyPointers.PointerMissException.class,
+        () -> resolve("/children/2"));
+    assertThrows(PointerFamilyPointers.PointerMissException.class,
+        () -> resolve("/children/999999999999999999999999"));
+    assertThrows(PointerFamilyPointers.PointerMissException.class,
+        () -> resolve("/named/missing"));
+    assertThrows(PointerFamilyPointers.PointerTypeException.class,
+        () -> resolve("/children/01"));
+    assertThrows(PointerFamilyPointers.PointerTypeException.class,
+        () -> resolve("/children/no"));
+    assertThrows(PointerFamilyPointers.PointerTypeException.class,
+        () -> resolve("/child/value/more"));
+    assertThrows(PointerFamilyPointers.PointerTypeException.class,
+        () -> resolve("/set/0"));
+    assertThrows(IllegalArgumentException.class,
+        () -> PointerFamilyPointers.resolve("not a value", PointerFamilyPointers.parse("")));
+
+    Branch emptyOptional = ImmutablePointerFamily.Branch.builder()
+        .child(first)
+        .untouched(second)
+        .array(first)
+        .integers(1)
+        .build();
+    assertThrows(PointerFamilyPointers.PointerMissException.class,
+        () -> PointerFamilyPointers.resolve(
+            emptyOptional, PointerFamilyPointers.parse("/optional")));
+  }
+
+  @Test
+  public void updatesOnlyTheSelectedPath() {
+    Branch changed = update("/child/value", value -> value + "!");
+    assertEquals("first!", ((Leaf) changed.child()).value());
+    assertSame(root.untouched(), changed.untouched());
+    assertSame(root.children(), changed.children());
+    assertArrayEquals(root.array(), changed.array());
+    assertSame(root.named(), changed.named());
+
+    Branch listChanged = update("/children/0/value", value -> "changed");
+    assertEquals("changed", ((Leaf) listChanged.children().get(0)).value());
+    assertSame(root.children().get(1), listChanged.children().get(1));
+    assertSame(root.child(), listChanged.child());
+
+    Branch arrayChanged = update("/array/0", value -> second);
+    assertArrayEquals(new Node[] {second, second}, arrayChanged.array());
+    assertSame(root.array()[1], arrayChanged.array()[1]);
+
+    Branch mapChanged = update("/named/a~1b", value -> second);
+    assertEquals(Arrays.asList("a/b", "~", ""), new ArrayList<>(mapChanged.named().keySet()));
+    assertSame(root.named().get("~"), mapChanged.named().get("~"));
+
+    Branch optionalChanged = update("/optional/value", value -> "optional!");
+    assertEquals("optional!", ((Leaf) optionalChanged.optional().get()).value());
+  }
+
+  @Test
+  public void updatesContainersAndRootsWithTypeChecks() {
+    Branch same = update("/child/value", value -> new String("first"));
+    assertSame(root, same);
+    assertSame(root, update("/child/nullable", value -> null));
+    Branch nullableChanged = update("/child/nullable", value -> "now present");
+    assertEquals("now present", ((Leaf) nullableChanged.child()).nullable());
+
+    Branch listChanged = update("/children", value -> {
+      ArrayList<Node> replacement = new ArrayList<>((java.util.List<Node>) value);
+      replacement.add(first);
+      return replacement;
+    });
+    assertEquals(3, listChanged.children().size());
+    assertSame(root.child(), listChanged.child());
+
+    Outside outside = ImmutablePointerFamily.Outside.builder().value("outside").build();
+    assertSame(outside, PointerFamilyPointers.update(
+        first, PointerFamilyPointers.parse(""), value -> outside));
+    assertSame(first, PointerFamilyPointers.update(
+        first, PointerFamilyPointers.parse(""), value -> first));
+
+    assertThrows(PointerFamilyPointers.PointerTypeException.class,
+        () -> update("/children", value -> "wrong"));
+    assertThrows(PointerFamilyPointers.PointerTypeException.class,
+        () -> update("/children", value -> Arrays.asList("wrong element")));
+    assertThrows(PointerFamilyPointers.PointerTypeException.class, () -> update("/named", value -> {
+      Map<String, Object> replacement = new LinkedHashMap<>();
+      replacement.put("key", "wrong value");
+      return replacement;
+    }));
+    assertThrows(PointerFamilyPointers.PointerTypeException.class,
+        () -> update("/child/value", value -> null));
+    assertThrows(PointerFamilyPointers.PointerTypeException.class,
+        () -> PointerFamilyPointers.update(
+            root, PointerFamilyPointers.parse(""), value -> "wrong"));
+  }
+
+  @Test
+  public void rejectsForbiddenUpdatesBeforeInvokingOperator() {
+    AtomicBoolean invoked = new AtomicBoolean();
+    assertThrows(PointerFamilyPointers.PointerTypeException.class,
+        () -> PointerFamilyPointers.update(root, PointerFamilyPointers.parse("/derived"), value -> {
+          invoked.set(true);
+          return value;
+        }));
+    assertFalse(invoked.get());
+
+    assertThrows(PointerFamilyPointers.PointerTypeException.class,
+        () -> update("/lazy/value", value -> value));
+    assertThrows(PointerFamilyPointers.PointerTypeException.class,
+        () -> update("/set", value -> value));
+    assertThrows(PointerFamilyPointers.PointerTypeException.class,
+        () -> update("/integers", value -> value));
+    assertThrows(PointerFamilyPointers.PointerTypeException.class,
+        () -> update("/set/0", value -> value));
+  }
+
+  @Test
+  public void generatesOnlyForEligibleEnclosures() {
+    assertThrows(ClassNotFoundException.class,
+        () -> Class.forName("org.immutables.fixture.PointerNoFamilyPointers"));
+    assertThrows(ClassNotFoundException.class,
+        () -> Class.forName("org.immutables.fixture.PointerNoCopiesPointers"));
+  }
+
+  private Object resolve(String pointer) {
+    return PointerFamilyPointers.resolve(root, PointerFamilyPointers.parse(pointer));
+  }
+
+  private Branch update(String pointer, java.util.function.UnaryOperator<Object> operator) {
+    Object updated = PointerFamilyPointers.update(root, PointerFamilyPointers.parse(pointer), operator);
+    return assertInstanceOf(Branch.class, updated);
+  }
+}
diff --git a/value-processor/src/org/immutables/value/processor/Pointers.generator b/value-processor/src/org/immutables/value/processor/Pointers.generator
