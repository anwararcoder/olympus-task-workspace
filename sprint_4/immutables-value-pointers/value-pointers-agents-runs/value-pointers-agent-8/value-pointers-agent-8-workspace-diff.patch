diff --git a/value-fixture/test/org/immutables/fixture/pointer/PointerValuesTest.java b/value-fixture/test/org/immutables/fixture/pointer/PointerValuesTest.java
new file mode 100644
index 0000000..c6ff9f8
--- /dev/null
+++ b/value-fixture/test/org/immutables/fixture/pointer/PointerValuesTest.java
@@ -0,0 +1,133 @@
+package org.immutables.fixture.pointer;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertIterableEquals;
+import static org.junit.jupiter.api.Assertions.assertNotSame;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.Optional;
+import org.junit.jupiter.api.Test;
+
+public class PointerValuesTest {
+  private static ImmutablePointerValues.Text text(String name) {
+    return ImmutablePointerValues.Text.builder().name(name).build();
+  }
+
+  private static ImmutablePointerValues.Branch branch() {
+    ImmutablePointerValues.Text first = text("first");
+    ImmutablePointerValues.Text second = text("second");
+    Map<String, PointerValues.Node> named = new LinkedHashMap<>();
+    named.put("a/b", first);
+    named.put("~", second);
+    return ImmutablePointerValues.Branch.builder()
+        .name("root")
+        .child(first)
+        .addChildren(first, second)
+        .putAllNamed(named)
+        .optional(Optional.of(second))
+        .array(first, second)
+        .addSet(first)
+        .numbers(1, 2)
+        .nullable(null)
+        .build();
+  }
+
+  @Test
+  public void omitsCompanionsWithoutEligibleFamilies() {
+    assertThrows(ClassNotFoundException.class,
+        () -> Class.forName("org.immutables.fixture.pointer.PointerNoFamilyPointers"));
+    assertThrows(ClassNotFoundException.class,
+        () -> Class.forName("org.immutables.fixture.pointer.PointerNoCopyPointers"));
+  }
+
+  @Test
+  public void parsesAndRenders() {
+    PointerValuesPointers.Pointer pointer = PointerValuesPointers.parse("/named/a~1b/name");
+    assertEquals("/named/a~1b/name", PointerValuesPointers.render(pointer));
+    assertEquals("/named/a~1b/name", pointer.toString());
+    assertEquals(pointer, PointerValuesPointers.parse("/named/a~1b/name"));
+    assertEquals("", PointerValuesPointers.parse("").toString());
+    assertEquals("/", PointerValuesPointers.parse("/").toString());
+    assertThrows(PointerValuesPointers.MalformedPointerException.class, () -> PointerValuesPointers.parse("x"));
+    assertThrows(PointerValuesPointers.MalformedPointerException.class, () -> PointerValuesPointers.parse("/~2"));
+  }
+
+  @Test
+  public void resolvesValuesAndContainers() {
+    ImmutablePointerValues.Other other = ImmutablePointerValues.Other.builder().value("other").build();
+    assertEquals("other", PointerValuesPointers.resolve(other, PointerValuesPointers.parse("/value")));
+    ImmutablePointerValues.Other updatedOther = (ImmutablePointerValues.Other) PointerValuesPointers.update(
+        other, PointerValuesPointers.parse("/value"), value -> "updated");
+    assertEquals("updated", updatedOther.value());
+    ImmutablePointerValues.Branch root = branch();
+    assertSame(root, PointerValuesPointers.resolve(root, PointerValuesPointers.parse("")));
+    assertEquals("first", PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/child/name")));
+    assertEquals("second", PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/children/1/name")));
+    assertEquals("first", PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/named/a~1b/name")));
+    assertEquals("second", PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/named/~0/name")));
+    assertEquals("second", PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/optional/name")));
+    assertEquals("first", PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/array/0/name")));
+    assertSame(root.children(), PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/children")));
+    assertNull(PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/nullable")));
+  }
+
+  @Test
+  public void updatesOnlyTheAddressedPath() {
+    ImmutablePointerValues.Branch root = branch();
+    ImmutablePointerValues.Branch updated = (ImmutablePointerValues.Branch) PointerValuesPointers.update(
+        root, PointerValuesPointers.parse("/children/1/name"), value -> value + "!");
+
+    assertNotSame(root, updated);
+    assertSame(root.child(), updated.child());
+    assertSame(root.children().get(0), updated.children().get(0));
+    assertNotSame(root.children().get(1), updated.children().get(1));
+    assertSame(root.named(), updated.named());
+    assertEquals("second!", ((PointerValues.Named) updated.children().get(1)).name());
+
+    assertSame(root, PointerValuesPointers.update(
+        root, PointerValuesPointers.parse("/child/name"), value -> new String("first")));
+  }
+
+  @Test
+  public void updatesContainersAndElements() {
+    ImmutablePointerValues.Branch root = branch();
+    ImmutablePointerValues.Branch mapUpdated = (ImmutablePointerValues.Branch) PointerValuesPointers.update(
+        root, PointerValuesPointers.parse("/named/~0/name"), value -> "changed");
+    assertIterableEquals(Arrays.asList("a/b", "~"), mapUpdated.named().keySet());
+    assertSame(root.named().get("a/b"), mapUpdated.named().get("a/b"));
+
+    ImmutablePointerValues.Branch arrayUpdated = (ImmutablePointerValues.Branch) PointerValuesPointers.update(
+        root, PointerValuesPointers.parse("/array/1/name"), value -> "changed");
+    assertSame(root.array()[0], arrayUpdated.array()[0]);
+    assertNotSame(root.array()[1], arrayUpdated.array()[1]);
+
+    Object replacement = Arrays.asList(text("replacement"));
+    ImmutablePointerValues.Branch listUpdated = (ImmutablePointerValues.Branch) PointerValuesPointers.update(
+        root, PointerValuesPointers.parse("/children"), value -> replacement);
+    assertEquals(1, listUpdated.children().size());
+  }
+
+  @Test
+  public void distinguishesMissesAndTypeFailures() {
+    ImmutablePointerValues.Branch root = branch();
+    assertThrows(PointerValuesPointers.PointerMissException.class, () -> PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/missing")));
+    assertThrows(PointerValuesPointers.PointerTypeException.class, () -> PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/children/01")));
+    assertThrows(PointerValuesPointers.PointerMissException.class, () -> PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/children/9")));
+    assertThrows(PointerValuesPointers.PointerTypeException.class, () -> PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/name/x")));
+    assertThrows(PointerValuesPointers.PointerMissException.class, () -> PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/nullable/x")));
+    assertThrows(PointerValuesPointers.PointerTypeException.class, () -> PointerValuesPointers.update(
+        root, PointerValuesPointers.parse("/derived"), value -> value));
+    assertThrows(PointerValuesPointers.PointerTypeException.class, () -> PointerValuesPointers.update(
+        root, PointerValuesPointers.parse("/set"), value -> value));
+    assertThrows(PointerValuesPointers.PointerTypeException.class, () -> PointerValuesPointers.resolve(
+        root, PointerValuesPointers.parse("/numbers/0")));
+    assertThrows(PointerValuesPointers.PointerTypeException.class, () -> PointerValuesPointers.update(
+        root, PointerValuesPointers.parse("/name"), value -> 1));
+    assertThrows(IllegalArgumentException.class, () -> PointerValuesPointers.resolve("not a root", PointerValuesPointers.parse("")));
+  }
+}
