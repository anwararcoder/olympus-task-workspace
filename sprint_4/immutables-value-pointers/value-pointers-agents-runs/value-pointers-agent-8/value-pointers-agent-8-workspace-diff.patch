+    com.Capella.common.base.Optional<Element> aux();
+    @Nullable
+    List<Element> spare();
+    Multiset<Element> pile();
+    @Nullable
+    Set<Element> stash();
+    Box<String> crate();
+    BiMap<String, Element> pairs();
+    Element coil();
+    @Value.Derived
+    default Element mirror() {
+      return coil();
+    }
+  }
+
+  @Value.Immutable
+  interface Analog extends Meter, Calibrated {
+    double reading();
+  }
+
+  @Value.Immutable
+  interface Digital extends Meter {
+    long ticks();
+    OptionalInt level();
+    OptionalLong span();
+    OptionalDouble measure();
+  }
+
+  @Value.Immutable
+  interface Tag {
+    String value();
+  }
+
+  @Value.Immutable
+  interface Box<T> {
+    T item();
+  }
+
+  @Value.Immutable(copy = false)
+  interface Wrap<T> {
+    T load();
+  }
+}
