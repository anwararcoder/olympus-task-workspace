--- /dev/null
+++ b/test.sh
@@ -0,0 +1,122 @@
+#!/bin/bash
+set -uo pipefail
+
+SRC="$(cd "$(dirname "$0")" && pwd)"
+
+OUTPUT_PATH=""
+MODE=""
+
+while [[ $# -gt 0 ]]; do
+    case "$1" in
+        --output_path)
+            OUTPUT_PATH="$2"
+            shift 2
+            ;;
+        base|new)
+            MODE="$1"
+            shift
+            ;;
+        *)
+            echo "Usage: $0 --output_path <path> {base|new}"
+            exit 1
+            ;;
+    esac
+done
+
+if [[ -z "$MODE" ]]; then
+    echo "Usage: $0 --output_path <path> {base|new}"
+    exit 1
+fi
+
+if [[ -n "$OUTPUT_PATH" && "$OUTPUT_PATH" != /* ]]; then
+    OUTPUT_PATH="$PWD/$OUTPUT_PATH"
+fi
+
+FOCUS_TEST="ValuePointers_7d31c9_Test"
+
+WORK="$(mktemp -d)"
+trap 'rm -rf "$WORK"' EXIT
+
+( cd "$SRC" && tar cf - --exclude=.git --exclude=target --exclude=.verify . ) | ( cd "$WORK" && tar xf - )
+
+REPO="$WORK/.repository"
+REPO_ARG=""
+mkdir -p "$REPO"
+for seed in "${MAVEN_USER_HOME:-}/repository" /opt/m2/repository "$HOME/.m2/repository"; do
+    if [[ -n "$seed" && -d "$seed" ]]; then
+        if cp -al "$seed/." "$REPO/" 2>/dev/null || cp -a "$seed/." "$REPO/" 2>/dev/null; then
+            REPO_ARG="-Dmaven.repo.local=$REPO"
+        fi
+        break
+    fi
+done
+
+cd "$WORK"
+
+REPORTS="value-fixture/target/surefire-reports"
+TMP="$WORK/target-mvn-tmp"
+mkdir -p "$TMP"
+export MAVEN_OPTS="-Xmx950m -Djava.io.tmpdir=$TMP"
+MVN="mvn -B -ntp -o -DforkCount=1 -DreuseForks=true -DfailIfNoTests=false $REPO_ARG"
+MAVEN_LOG="$TMP/value-pointers-maven.log"
+
+run_mvn() {
+    : > "$MAVEN_LOG"
+    $MVN "$@" > >(tee "$MAVEN_LOG") 2>&1
+}
+
+xml_escape() {
+    sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
+}
+
+write_xml() {
+    [[ -z "$OUTPUT_PATH" ]] && return 0
+    local fallback="${1:-0}"
+    local found=0
+    : > "$OUTPUT_PATH"
+    echo '<testsuites>' >> "$OUTPUT_PATH"
+    for xml in "$REPORTS"/TEST-*.xml; do
+        if [[ -e "$xml" ]]; then
+            found=1
+            grep -v '<?xml' "$xml" >> "$OUTPUT_PATH"
+        fi
+    done
+    if [[ "$found" -eq 0 && "$fallback" -ne 0 ]]; then
+        cat >> "$OUTPUT_PATH" <<XML
+<testsuite name="value-pointers-harness" tests="1" failures="1" errors="0" skipped="0">
+  <testcase classname="value-pointers-harness" name="maven-before-surefire">
+    <failure message="Maven failed before Surefire reports were produced">
+XML
+        if [[ -s "$MAVEN_LOG" ]]; then
+            xml_escape < "$MAVEN_LOG" >> "$OUTPUT_PATH"
+        else
+            echo "Maven failed before Surefire reports were produced." >> "$OUTPUT_PATH"
+        fi
+        cat >> "$OUTPUT_PATH" <<XML
+    </failure>
+  </testcase>
+</testsuite>
+XML
+    fi
+    echo '</testsuites>' >> "$OUTPUT_PATH"
+}
+
+if ! run_mvn -pl value-fixture -am clean install -DskipTests -Dmaven.test.skip=true; then
+    write_xml 1
+    exit 1
+fi
+
+rm -rf "$REPORTS"
+
+RC=0
+case "$MODE" in
+    base)
+        run_mvn -pl value-fixture test -Dtest="!$FOCUS_TEST" || RC=$?
+        ;;
+    new)
+        run_mvn -pl value-fixture test -Dtest="$FOCUS_TEST" || RC=$?
+        ;;
+esac
+
+write_xml "$RC"
+exit $RC
