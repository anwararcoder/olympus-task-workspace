+package org.immutables.fixture.pointer;
+
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.Set;
+import javax.annotation.Nullable;
+import org.immutables.value.Value;
+
+@Value.Enclosing
+public interface PointerValues {
+  interface Node {}
+
+  interface Named {
+    String name();
+  }
+
+  @Value.Immutable
+  interface Text extends Node, Named {}
+
+  @Value.Immutable
+  interface Branch extends Node, Named {
+    Node child();
+    List<Node> children();
+    Map<String, Node> named();
+    Optional<Node> optional();
+    Node[] array();
+    Set<Node> set();
+    int[] numbers();
+    @Nullable Node nullable();
+
+    @Value.Derived
+    default Node derived() {
+      return child();
+    }
+  }
+
+  @Value.Immutable
+  interface Other {
+    String value();
+  }
+
+  @Value.Immutable
+  interface Generic<T> {
+    T value();
+  }
+}
+
+@Value.Enclosing
+interface PointerNoFamily {
+  @Value.Immutable
+  interface First {}
+
+  @Value.Immutable
+  interface Second {}
+}
+
+@Value.Enclosing
+interface PointerNoCopy {
+  interface Node {}
+
+  @Value.Immutable
+  interface First extends Node {}
+
+  @Value.Immutable
+  interface Second extends Node {}
+
+  @Value.Immutable(copy = false)
+  interface Unrelated {}
+}
