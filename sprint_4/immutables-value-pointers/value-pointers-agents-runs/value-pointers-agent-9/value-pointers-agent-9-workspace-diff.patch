+package org.immutables.value.processor;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+import javax.lang.model.element.Element;
+import javax.lang.model.element.ElementKind;
+import javax.lang.model.element.Modifier;
+import javax.lang.model.element.PackageElement;
+import javax.lang.model.element.TypeElement;
+import javax.lang.model.type.DeclaredType;
+import javax.lang.model.type.TypeKind;
+import javax.lang.model.type.TypeMirror;
+import org.immutables.value.processor.meta.ValueAttribute;
+import org.immutables.value.processor.meta.ValueType;
+
+public final class PointersGenerator {
+  public boolean shouldGenerate(ValueType enclosing) {
+    List<ValueType> implementations = implementations(enclosing);
+    if (implementations.size() < 2) return false;
+    for (ValueType implementation : implementations) {
+      if (!implementation.isUseCopyMethods()) return false;
+    }
+    for (Element element : enclosing.element.getEnclosedElements()) {
+      if (!(element instanceof TypeElement) || !isAbstractType(element)) continue;
+      int count = 0;
+      TypeElement family = (TypeElement) element;
+      for (ValueType implementation : implementations) {
+        if (belongsTo((TypeElement) implementation.element, family, new HashSet<String>()) && ++count >= 2) {
+          return true;
+        }
+      }
+    }
+    return false;
+  }
+
+
+  private static boolean belongsTo(TypeElement type, TypeElement family, Set<String> visited) {
+    String name = type.getQualifiedName().toString();
+    if (!visited.add(name)) return false;
+    if (name.equals(family.getQualifiedName().toString())) return true;
+    for (TypeMirror interfaceType : type.getInterfaces()) {
+      if (interfaceType instanceof DeclaredType
+          && belongsTo((TypeElement) ((DeclaredType) interfaceType).asElement(), family, visited)) {
+        return true;
+      }
+    }
+    TypeMirror superclass = type.getSuperclass();
+    return superclass.getKind() != TypeKind.NONE
+        && superclass instanceof DeclaredType
+        && belongsTo((TypeElement) ((DeclaredType) superclass).asElement(), family, visited);
+  }
+
+  private static boolean isAbstractType(Element element) {
+    return element.getKind().isInterface()
+        || (element.getKind() == ElementKind.CLASS
+            && element.getModifiers().contains(Modifier.ABSTRACT));
+  }
+
+  private static String sourcePackage(Element element) {
+    Element current = element;
+    while (current.getKind() != ElementKind.PACKAGE) current = current.getEnclosingElement();
+    return ((PackageElement) current).getQualifiedName().toString();
+  }
+
+  private static List<ValueType> implementations(ValueType enclosing) {
+    List<ValueType> implementations = new ArrayList<>();
+    for (ValueType nested : enclosing.nested) {
+      if (nested.kind().isNested() && nested.generics().isEmpty()) implementations.add(nested);
+    }
+    return implementations;
+  }
+
+  public String packageName(ValueType enclosing) {
+    return sourcePackage(enclosing.element);
+  }
+
+  public String simpleName(ValueType enclosing) {
+    return enclosing.element.getSimpleName() + "Pointers";
+  }
+
+  public String source(ValueType enclosing) {
+    String packageName = packageName(enclosing);
+    String simpleName = simpleName(enclosing);
+    StringBuilder out = new StringBuilder(30000);
+    line(out, "//-no-import-rewrite");
+    if (!packageName.isEmpty()) line(out, "package " + packageName + ";\n");
+    line(out, "@SuppressWarnings({\"all\", \"unchecked\", \"rawtypes\"})");
+    line(out, "public final class " + simpleName + " {");
+    line(out, "  private static final int VALUE=0, OPTIONAL=1, LIST=2, ARRAY=3, MAP=4, WHOLE=5;");
+    line(out, "  private static final TypeInfo[] TYPES = {");
+    List<ValueType> implementations = implementations(enclosing);
+    for (int i = 0; i < implementations.size(); i++) {
+      ValueType implementation = implementations.get(i);
+      line(out, "    new TypeInfo(\"" + escape(binaryName(enclosing, implementation)) + "\", new Attribute[] {");
+      for (int j = 0; j < implementation.attributes.size(); j++) {
+        ValueAttribute attribute = implementation.attributes.get(j);
+        int kind = kind(attribute);
+        boolean updatable = attribute.isSettable() && kind != 5;
+        line(out, "      new Attribute(\"" + escape(attribute.name()) + "\", \""
+            + escape(attribute.names.get) + "\", \"" + escape(attribute.names.with) + "\", "
+            + kind + ", " + attribute.isNullable() + ", " + attribute.nullElements.allow()
+            + ", " + updatable + ")" + (j + 1 < implementation.attributes.size() ? "," : ""));
+      }
+      line(out, "    })" + (i + 1 < implementations.size() ? "," : ""));
+    }
+    line(out, "  };");
+    runtime(out, simpleName);
+    line(out, "}");
+    return out.toString();
+  }
+
+  private static String binaryName(ValueType enclosing, ValueType implementation) {
+    String outer = enclosing.typeEnclosing().absolute();
+    String nested = implementation.typeImmutable().absolute();
+    String prefix = outer + '.';
+    return nested.startsWith(prefix)
+        ? outer + '$' + nested.substring(prefix.length()).replace('.', '$')
+        : nested;
+  }
+
+  private static int kind(ValueAttribute attribute) {
+    if (attribute.isOptionalType()) return 1;
+    if (attribute.isListType()) return 2;
+    if (attribute.isReferenceArrayType()) return 3;
+    if (attribute.isMapType()
+        && !attribute.isSortedMapType()
+        && !attribute.isMultimapType()
+        && "java.lang.String".equals(attribute.getUnwrapperOrRawElementType())) return 4;
+    if (attribute.isMapType()) return 5;
+    if (attribute.isSetType() || attribute.isMultisetType() || attribute.isMultimapType()
+        || attribute.isSortedMapType() || attribute.isSortedSetType()
+        || attribute.isPrimitiveArrayType()) return 5;
+    return 0;
+  }
+
+  private static String escape(String value) {
+    return value.replace("\\", "\\\\").replace("\"", "\\\"");
+  }
+
+  private static void line(StringBuilder out, String value) {
+    out.append(value).append('\n');
+  }
+
+  private static void runtime(StringBuilder out, String companion) {
+    line(out, "  private " + companion + "() {}");
+    line(out, "  public static final class Pointer {");
+    line(out, "    private final String rendered; private final String[] steps;");
+    line(out, "    private Pointer(String rendered,String[] steps){this.rendered=rendered;this.steps=steps;}");
+    line(out, "    @Override public boolean equals(Object o){return o instanceof Pointer&&rendered.equals(((Pointer)o).rendered);}");
+    line(out, "    @Override public int hashCode(){return rendered.hashCode();}");
+    line(out, "    @Override public String toString(){return rendered;}");
+    line(out, "  }");
+    line(out, "  public static final class MalformedPointerException extends IllegalArgumentException {");
+    line(out, "    private MalformedPointerException(String p){super(\"Malformed pointer: \"+p);}");
+    line(out, "  }");
+    line(out, "  public static final class PointerMissException extends RuntimeException {");
+    line(out, "    private PointerMissException(String s){super(\"Pointer missed at step: \"+s);}");
+    line(out, "  }");
+    line(out, "  public static final class PointerTypeException extends RuntimeException {");
+    line(out, "    private PointerTypeException(String m){super(m);} private PointerTypeException(String m,Throwable c){super(m,c);}");
+    line(out, "  }");
+    line(out, "  public static Pointer parse(String value){");
+    line(out, "    if(value==null)throw new NullPointerException(\"value\");");
+    line(out, "    if(value.isEmpty())return new Pointer(value,new String[0]);");
+    line(out, "    if(value.charAt(0)!='/')throw new MalformedPointerException(value);");
+    line(out, "    String[] encoded=value.substring(1).split(\"/\",-1),steps=new String[encoded.length];");
+    line(out, "    for(int i=0;i<encoded.length;i++)steps[i]=decode(encoded[i],value);");
+    line(out, "    return new Pointer(value,steps);");
+    line(out, "  }");
+    line(out, "  public static String render(Pointer pointer){if(pointer==null)throw new NullPointerException(\"pointer\");return pointer.rendered;}");
+    line(out, "  private static String decode(String encoded,String pointer){");
+    line(out, "    StringBuilder decoded=new StringBuilder(encoded.length());");
+    line(out, "    for(int i=0;i<encoded.length();i++){char c=encoded.charAt(i);if(c!='~'){decoded.append(c);continue;}");
+    line(out, "      if(++i==encoded.length())throw new MalformedPointerException(pointer);char e=encoded.charAt(i);");
+    line(out, "      if(e=='0')decoded.append('~');else if(e=='1')decoded.append('/');else throw new MalformedPointerException(pointer);}");
+    line(out, "    return decoded.toString();");
+    line(out, "  }");
+    resolve(out);
+    update(out);
+    helpers(out);
+    metadata(out);
+  }
+
+  private static void resolve(StringBuilder out) {
+    line(out, "  public static Object resolve(Object root,Pointer pointer){");
+    line(out, "    requireRoot(root);if(pointer==null)throw new NullPointerException(\"pointer\");Object current=root;");
+    line(out, "    for(int offset=0;offset<pointer.steps.length;offset++){String step=pointer.steps[offset];");
+    line(out, "      if(current==null)throw new PointerMissException(step);TypeInfo type=typeOf(current);");
+    line(out, "      if(type==null)throw new PointerTypeException(\"No step applies to value\");");
+    line(out, "      Attribute attribute=type.attribute(step);if(attribute==null)throw new PointerMissException(step);");
+    line(out, "      Object value=attribute.read(current);");
+    line(out, "      if(attribute.kind==OPTIONAL)value=optionalValue(value,step);");
+    line(out, "      else if(attribute.kind==LIST||attribute.kind==ARRAY||attribute.kind==MAP){");
+    line(out, "        if(offset+1==pointer.steps.length)return value;if(value==null)throw new PointerMissException(step);");
+    line(out, "        value=containerValue(attribute.kind,value,pointer.steps[++offset]);}");
+    line(out, "      current=value;}");
+    line(out, "    return current;");
+    line(out, "  }");
+  }
+
+  private static void update(StringBuilder out) {
+    line(out, "  public static Object update(Object root,Pointer pointer,java.util.function.UnaryOperator operator){");
+    line(out, "    requireRoot(root);if(pointer==null)throw new NullPointerException(\"pointer\");if(operator==null)throw new NullPointerException(\"operator\");");
+    line(out, "    if(pointer.steps.length==0){Object replacement=operator.apply(root);");
+    line(out, "      if(replacement==null||typeOf(replacement)==null)throw new PointerTypeException(\"Replacement root has the wrong type\");");
+    line(out, "      return java.util.Objects.equals(root,replacement)?root:replacement;}");
+    line(out, "    java.util.ArrayList<Frame> frames=new java.util.ArrayList<Frame>();Object current=root;Position position=null;");
+    line(out, "    for(int offset=0;offset<pointer.steps.length;offset++){String step=pointer.steps[offset];");
+    line(out, "      if(current==null)throw new PointerMissException(step);TypeInfo type=typeOf(current);");
+    line(out, "      if(type==null)throw new PointerTypeException(\"No step applies to value\");");
+    line(out, "      Attribute attribute=type.attribute(step);if(attribute==null)throw new PointerMissException(step);");
+    line(out, "      if(!attribute.updatable)throw new PointerTypeException(\"Attribute cannot be updated: \"+step);");
