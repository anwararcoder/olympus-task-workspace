diff --git a/value-fixture/test/org/immutables/fixture/pointers/PointerValuesTest.java b/value-fixture/test/org/immutables/fixture/pointers/PointerValuesTest.java
new file mode 100644
index 0000000..587edf6
--- /dev/null
+++ b/value-fixture/test/org/immutables/fixture/pointers/PointerValuesTest.java
@@ -0,0 +1,145 @@
+package org.immutables.fixture.pointers;
+
+import static org.immutables.fixture.pointers.PointerValuesPointers.parse;
+import static org.immutables.fixture.pointers.PointerValuesPointers.render;
+import static org.immutables.fixture.pointers.PointerValuesPointers.resolve;
+import static org.immutables.fixture.pointers.PointerValuesPointers.update;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotSame;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.Optional;
+import org.junit.jupiter.api.Test;
+
+class PointerValuesTest {
+  private static ImmutablePointerValues.Leaf leaf(String value) {
+    return ImmutablePointerValues.Leaf.builder().value(value).build();
+  }
+
+  private static ImmutablePointerValues.Branch branch() {
+    ImmutablePointerValues.Leaf first = leaf("first");
+    ImmutablePointerValues.Leaf second = leaf("second");
+    Map<String, PointerValues.Node> byName = new LinkedHashMap<>();
+    byName.put("first", first);
+    byName.put("", second);
+    return ImmutablePointerValues.Branch.builder()
+        .child(first)
+        .addChildren(first, second)
+        .nullableChildren(Arrays.asList(first, null))
+        .putAllByName(byName)
+        .putByNumber(1, first)
+        .optional(Optional.of(second))
+        .nullable(null)
+        .array(first, second)
+        .primitiveArray(1, 2)
+        .addSet(first)
+        .build();
+  }
+
+  @Test void parsesAndRenders() {
+    assertEquals("", render(parse("")));
+    assertEquals("/~0/~1/", render(parse("/~0/~1/")));
+    assertEquals(parse("/child/value"), parse("/child/value"));
+    assertEquals("/child/value", parse("/child/value").toString());
+    assertThrows(PointerValuesPointers.MalformedPointerException.class, () -> parse("child"));
+    assertThrows(PointerValuesPointers.MalformedPointerException.class, () -> parse("/~"));
+    assertThrows(PointerValuesPointers.MalformedPointerException.class, () -> parse("/~2"));
+  }
+
+  @Test void resolvesValuesAndContainers() {
+    ImmutablePointerValues.Branch root = branch();
+    assertSame(root, resolve(root, parse("")));
+    assertEquals("first", resolve(root, parse("/child/value")));
+    assertEquals("second", resolve(root, parse("/children/1/value")));
+    assertEquals("second", resolve(root, parse("/byName//value")));
+    assertEquals("second", resolve(root, parse("/optional/value")));
+    assertSame(root.children(), resolve(root, parse("/children")));
+    assertEquals(null, resolve(root, parse("/nullableChildren/1")));
+    assertSame(root.byNumber(), resolve(root, parse("/byNumber")));
+    assertEquals(null, resolve(root, parse("/nullable")));
+    assertThrows(PointerValuesPointers.PointerMissException.class, () -> resolve(root, parse("/missing")));
+    assertThrows(PointerValuesPointers.PointerMissException.class, () -> resolve(root, parse("/children/3")));
+    assertThrows(PointerValuesPointers.PointerTypeException.class, () -> resolve(root, parse("/children/01")));
+    assertThrows(PointerValuesPointers.PointerTypeException.class, () -> resolve(root, parse("/primitiveArray/0")));
+    assertThrows(PointerValuesPointers.PointerTypeException.class, () -> resolve(root, parse("/byNumber/1")));
+    assertThrows(PointerValuesPointers.PointerMissException.class, () -> resolve(root, parse("/nullable/value")));
+    assertThrows(PointerValuesPointers.PointerMissException.class,
+        () -> resolve(root, parse("/byName/missing")));
+    assertThrows(PointerValuesPointers.PointerMissException.class,
+        () -> resolve(ImmutablePointerValues.Branch.builder().from(root).optional(Optional.empty()).build(),
+            parse("/optional")));
+    assertEquals("first", resolve(ImmutablePointerValues.Box.builder().node(root.child()).build(),
+        parse("/node/value")));
+    assertThrows(IllegalArgumentException.class, () -> resolve("not a value", parse("")));
+  }
+
+  @Test void updatesWithStructuralSharing() {
+    ImmutablePointerValues.Branch root = branch();
+    ImmutablePointerValues.Branch changed = (ImmutablePointerValues.Branch) update(
+        root, parse("/children/1/value"), value -> "changed");
+    assertNotSame(root, changed);
+    assertSame(root.child(), changed.child());
+    assertSame(root.children().get(0), changed.children().get(0));
+    assertEquals("changed", ((PointerValues.Leaf) changed.children().get(1)).value());
+    assertSame(root.byName(), changed.byName());
+    assertSame(root, update(root, parse("/child/value"), value -> value));
+  }
+
+  @Test void updatesMapsArraysOptionalsAndRoot() {
+    ImmutablePointerValues.Branch root = branch();
+    ImmutablePointerValues.Branch mapChanged = (ImmutablePointerValues.Branch) update(
+        root, parse("/byName/first/value"), value -> "map");
+    assertEquals(Arrays.asList("first", ""), Arrays.asList(mapChanged.byName().keySet().toArray()));
+    assertSame(root.byName().get(""), mapChanged.byName().get(""));
+
+    ImmutablePointerValues.Branch arrayChanged = (ImmutablePointerValues.Branch) update(
+        root, parse("/array/0/value"), value -> "array");
+    assertSame(root.array()[1], arrayChanged.array()[1]);
+
+    ImmutablePointerValues.Branch optionalChanged = (ImmutablePointerValues.Branch) update(
+        root, parse("/optional/value"), value -> "optional");
+    assertEquals("optional", ((PointerValues.Leaf) optionalChanged.optional().get()).value());
+
+    ImmutablePointerValues.Leaf replacement = leaf("root");
+    assertSame(replacement, update(root, parse(""), ignored -> replacement));
+  }
+
+  @Test void rejectsInvalidUpdatesBeforeCallingOperator() {
+    ImmutablePointerValues.Branch root = branch();
+    int[] calls = {0};
+    assertThrows(PointerValuesPointers.PointerTypeException.class,
+        () -> update(root, parse("/derived"), value -> { calls[0]++; return value; }));
+    assertThrows(PointerValuesPointers.PointerTypeException.class,
+        () -> update(root, parse("/set"), value -> { calls[0]++; return Collections.emptySet(); }));
+    assertThrows(PointerValuesPointers.PointerTypeException.class,
+        () -> update(root, parse("/primitiveArray"), value -> { calls[0]++; return value; }));
+    assertEquals(0, calls[0]);
+    assertThrows(PointerValuesPointers.PointerTypeException.class,
+        () -> update(root, parse("/child/value"), value -> 1));
+    assertThrows(PointerValuesPointers.PointerTypeException.class,
+        () -> update(root, parse("/nullable"), value -> "wrong"));
+    assertThrows(PointerValuesPointers.PointerTypeException.class,
+        () -> update(root, parse("/children/0"), value -> null));
+    ImmutablePointerValues.Branch withNull = (ImmutablePointerValues.Branch) update(
+        root, parse("/nullableChildren/0"), value -> null);
+    assertEquals(null, withNull.nullableChildren().get(0));
+    assertThrows(PointerValuesPointers.PointerTypeException.class,
+        () -> update(root, parse("/children"), value -> Arrays.asList("wrong")));
+    assertThrows(PointerValuesPointers.PointerTypeException.class,
+        () -> update(root, parse("/byNumber"), value -> value));
+    assertThrows(PointerValuesPointers.PointerTypeException.class,
+        () -> update(root, parse(""), value -> "wrong"));
+  }
+
+  @Test void omitsCompanionsWithoutEligibleFamilies() {
+    assertThrows(ClassNotFoundException.class,
+        () -> Class.forName("org.immutables.fixture.pointers.NoPointerValuesPointers"));
+    assertThrows(ClassNotFoundException.class,
+        () -> Class.forName("org.immutables.fixture.pointers.UnrelatedValuesPointers"));
+  }
+}
