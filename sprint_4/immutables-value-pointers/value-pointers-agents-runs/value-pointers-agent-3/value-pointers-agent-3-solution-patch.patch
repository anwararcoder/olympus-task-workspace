+[template generatePointersCompanion Type type]
+[packageWhenTopLevel type true]
+
+/** Pointer operations for immutable values enclosed by {@link [type.typeAbstract.relativeRaw]}. */
+[annotationsWhenTopLevel type true]
+public final class [pointerCompanionName type] {
+  private static final java.util.Map<Class<?>, TypeInfo> TYPES =
+      new java.util.HashMap<Class<?>, TypeInfo>();
+
+  static {
+[for Type implementation in pointerImplementations type]
+    register("[type pointerImplementationName implementation]", new Attribute['[]'] {
+[for Attribute attribute in implementation.implementedAttributes]
+        new Attribute([literal attribute.name], [literal attribute.names.get],
+            [literal attribute.names.with], Kind.[pointerKind attribute],
+            [attribute.nullable], [pointerElementNullable attribute], [pointerMutable attribute]),
+[/for]
+    });
+[/for]
+  }
+
+  private [pointerCompanionName type]() {}
+
+  /** Parses a pointer string. */
+  public static Pointer parse(String value) {
+    if (value == null) {
+      throw new MalformedPointerException("Pointer must not be null");
+    }
+    if (value.isEmpty()) {
+      return new Pointer(java.util.Collections.<String>emptyList());
+    }
+    if (value.charAt(0) != '/') {
+      throw new MalformedPointerException("Pointer must be empty or start with '/'");
+    }
+    java.util.ArrayList<String> steps = new java.util.ArrayList<String>();
+    int start = 1;
+    for (int index = 1; index <= value.length(); index++) {
+      if (index == value.length() || value.charAt(index) == '/') {
+        steps.add(unescape(value.substring(start, index)));
+        start = index + 1;
+      }
+    }
+    return new Pointer(steps);
+  }
+
+  /** Renders a pointer string. */
+  public static String render(Pointer pointer) {
+    if (pointer == null) {
+      throw new NullPointerException("pointer");
+    }
+    StringBuilder builder = new StringBuilder();
+    for (String step : pointer.steps) {
+      builder.append('/');
+      for (int index = 0; index < step.length(); index++) {
+        char character = step.charAt(index);
+        if (character == '~') {
+          builder.append("~0");
+        } else if (character == '/') {
+          builder.append("~1");
+        } else {
+          builder.append(character);
+        }
+      }
+    }
+    return builder.toString();
+  }
+
+  /** Resolves the value addressed by a pointer. */
+  public static Object resolve(Object root, Pointer pointer) {
+    TypeInfo type = rootType(root);
+    if (pointer == null) {
+      throw new NullPointerException("pointer");
+    }
+    return resolveImplementation(root, type, pointer.steps, 0);
+  }
+
+  /** Updates the value addressed by a pointer. */
+  public static Object update(
+      Object root, Pointer pointer, java.util.function.UnaryOperator<Object> operator) {
+    TypeInfo type = rootType(root);
+    if (pointer == null) {
+      throw new NullPointerException("pointer");
+    }
+    if (operator == null) {
+      throw new NullPointerException("operator");
+    }
+    if (pointer.steps.isEmpty()) {
+      Object replacement = operator.apply(root);
+      if (replacement == null || !TYPES.containsKey(replacement.getClass())) {
+        throw new PointerTypeException("Replacement root is not an enclosed immutable value");
+      }
+      return java.util.Objects.equals(root, replacement) ? root : replacement;
+    }
+    return updateImplementation(root, type, pointer.steps, 0, operator).value;
+  }
+
+  private static String unescape(String step) {
+    StringBuilder builder = new StringBuilder(step.length());
+    for (int index = 0; index < step.length(); index++) {
+      char character = step.charAt(index);
+      if (character != '~') {
+        builder.append(character);
+        continue;
+      }
+      if (++index == step.length()) {
+        throw new MalformedPointerException("Unfinished '~' escape");
+      }
+      char escaped = step.charAt(index);
+      if (escaped == '0') {
+        builder.append('~');
+      } else if (escaped == '1') {
+        builder.append('/');
+      } else {
+        throw new MalformedPointerException("Invalid '~" + escaped + "' escape");
+      }
+    }
+    return builder.toString();
+  }
+
+  private static TypeInfo rootType(Object root) {
+    if (root == null) {
+      throw new IllegalArgumentException("Root must be an enclosed immutable value");
+    }
+    TypeInfo type = TYPES.get(root.getClass());
+    if (type == null) {
+      throw new IllegalArgumentException("Root must be an enclosed immutable value");
+    }
+    return type;
+  }
+
+  private static Object resolveImplementation(
+      Object value, TypeInfo type, java.util.List<String> steps, int offset) {
+    if (offset == steps.size()) {
+      return value;
+    }
+    Attribute attribute = type.attributes.get(steps.get(offset));
+    if (attribute == null) {
+      throw new PointerMissException("No attribute '" + steps.get(offset) + "'");
+    }
+    Object selected = attribute.get(value);
+    if (offset + 1 == steps.size()) {
+      return attribute.kind == Kind.OPTIONAL ? optionalValue(selected) : selected;
+    }
+    return resolveBelow(attribute, selected, steps, offset + 1);
+  }
+
+  private static Object resolveBelow(
+      Attribute attribute, Object value, java.util.List<String> steps, int offset) {
+    if (value == null) {
+      throw new PointerMissException("Cannot step through null");
+    }
+    switch (attribute.kind) {
+      case OPTIONAL:
+        return resolveSelected(optionalValue(value), steps, offset);
+      case LIST: {
+        java.util.List<?> list = (java.util.List<?>) value;
+        int index = index(steps.get(offset), list.size());
+        return resolveSelected(list.get(index), steps, offset + 1);
+      }
+      case ARRAY: {
+        int length = java.lang.reflect.Array.getLength(value);
+        int index = index(steps.get(offset), length);
+        return resolveSelected(java.lang.reflect.Array.get(value, index), steps, offset + 1);
+      }
+      case MAP: {
+        java.util.Map<?, ?> map = (java.util.Map<?, ?>) value;
+        String key = steps.get(offset);
+        if (!map.containsKey(key)) {
+          throw new PointerMissException("No map key '" + key + "'");
+        }
+        return resolveSelected(map.get(key), steps, offset + 1);
+      }
+      case SCALAR:
+        return resolveSelected(value, steps, offset);
+      default:
+        throw new PointerTypeException("No step applies below attribute '" + attribute.name + "'");
+    }
+  }
+
+  private static Object resolveSelected(
+      Object value, java.util.List<String> steps, int offset) {
+    if (offset == steps.size()) {
+      return value;
+    }
+    if (value == null) {
+      throw new PointerMissException("Cannot step through null");
+    }
+    TypeInfo type = TYPES.get(value.getClass());
+    if (type == null) {
+      throw new PointerTypeException("No step applies below selected value");
+    }
+    return resolveImplementation(value, type, steps, offset);
+  }
+
+  private static Change updateImplementation(
+      Object value,
+      TypeInfo type,
+      java.util.List<String> steps,
+      int offset,
+      java.util.function.UnaryOperator<Object> operator) {
+    Attribute attribute = type.attributes.get(steps.get(offset));
+    if (attribute == null) {
+      throw new PointerMissException("No attribute '" + steps.get(offset) + "'");
+    }
+    if (!attribute.mutable) {
+      throw new PointerTypeException("Derived or lazy attribute '" + attribute.name + "' cannot be updated");
+    }
+    if (attribute.kind == Kind.WHOLE) {
+      throw new PointerTypeException("Attribute '" + attribute.name + "' cannot be updated");
+    }
+    Object selected = attribute.get(value);
+    Change change;
+    if (offset + 1 == steps.size()) {
+      if (attribute.kind == Kind.OPTIONAL) {
+        Object content = optionalValue(selected);
+        Object replacement = operator.apply(content);
+        attribute.requireElement(replacement);
+        change = changed(content, replacement);
+      } else {
+        Object replacement = operator.apply(selected);
+        attribute.requireAttribute(replacement);
+        change = changed(selected, replacement);
+      }
+    } else {
+      change = updateBelow(attribute, selected, steps, offset + 1, operator);
+    }
+    if (!change.changed) {
+      return new Change(value, false);
+    }
+    return new Change(attribute.with(value, change.value), true);
+  }
+
+  private static Change updateBelow(
+      Attribute attribute,
+      Object value,
+      java.util.List<String> steps,
+      int offset,
+      java.util.function.UnaryOperator<Object> operator) {
+    if (value == null) {
+      throw new PointerMissException("Cannot step through null");
+    }
+    switch (attribute.kind) {
+      case OPTIONAL: {
+        Object content = optionalValue(value);
+        Change change = updateSelected(content, steps, offset, operator, attribute, false);
+        return change;
+      }
+      case LIST: {
+        java.util.List<?> list = (java.util.List<?>) value;
+        int selectedIndex = index(steps.get(offset), list.size());
+        Object selected = list.get(selectedIndex);
+        Change change = updateSelected(selected, steps, offset + 1, operator, attribute, true);
+        if (!change.changed) {
+          return new Change(value, false);
+        }
+        java.util.ArrayList<Object> copy = new java.util.ArrayList<Object>(list);
+        copy.set(selectedIndex, change.value);
+        return new Change(copy, true);
+      }
+      case ARRAY: {
+        int length = java.lang.reflect.Array.getLength(value);
+        int selectedIndex = index(steps.get(offset), length);
+        Object selected = java.lang.reflect.Array.get(value, selectedIndex);
+        Change change = updateSelected(selected, steps, offset + 1, operator, attribute, true);
+        if (!change.changed) {
+          return new Change(value, false);
+        }
+        Object copy = ((Object['[]']) value).clone();
+        java.lang.reflect.Array.set(copy, selectedIndex, change.value);
+        return new Change(copy, true);
+      }
+      case MAP: {
+        java.util.Map<?, ?> map = (java.util.Map<?, ?>) value;
+        String key = steps.get(offset);
+        if (!map.containsKey(key)) {
+          throw new PointerMissException("No map key '" + key + "'");
+        }
+        Object selected = map.get(key);
+        Change change = updateSelected(selected, steps, offset + 1, operator, attribute, true);
+        if (!change.changed) {
+          return new Change(value, false);
+        }
+        java.util.LinkedHashMap<Object, Object> copy =
+            new java.util.LinkedHashMap<Object, Object>();
+        for (java.util.Map.Entry<?, ?> entry : map.entrySet()) {
+          copy.put(entry.getKey(), entry.getKey().equals(key) ? change.value : entry.getValue());
+        }
+        return new Change(copy, true);
+      }
+      case SCALAR:
+        return updateSelected(value, steps, offset, operator, attribute, false);
+      default:
+        throw new PointerTypeException("No update applies below attribute '" + attribute.name + "'");
+    }
+  }
+
+  private static Change updateSelected(
+      Object value,
+      java.util.List<String> steps,
+      int offset,
+      java.util.function.UnaryOperator<Object> operator,
+      Attribute position,
+      boolean element) {
+    if (offset == steps.size()) {
+      Object replacement = operator.apply(value);
+      if (element) {
+        position.requireElement(replacement);
+      } else {
+        position.requireAttribute(replacement);
+      }
+      return changed(value, replacement);
+    }
+    if (value == null) {
+      throw new PointerMissException("Cannot step through null");
+    }
+    TypeInfo type = TYPES.get(value.getClass());
+    if (type == null) {
+      throw new PointerTypeException("No update applies below selected value");
+    }
+    return updateImplementation(value, type, steps, offset, operator);
+  }
+
+  private static Change changed(Object oldValue, Object newValue) {
+    return java.util.Objects.equals(oldValue, newValue)
+        ? new Change(oldValue, false)
+        : new Change(newValue, true);
+  }
+
+  private static int index(String step, int size) {
+    if (step.isEmpty() || (step.length() > 1 && step.charAt(0) == '0')) {
+      throw new PointerTypeException("Invalid list or array index '" + step + "'");
+    }
+    long value = 0;
+    for (int index = 0; index < step.length(); index++) {
+      char digit = step.charAt(index);
+      if (digit < '0' || digit > '9') {
+        throw new PointerTypeException("Invalid list or array index '" + step + "'");
+      }
+      if (value <= size) {
+        value = value * 10 + digit - '0';
+      }
+    }
+    if (value >= size) {
+      throw new PointerMissException("Index " + step + " is past the end");
+    }
+    return (int) value;
+  }
+
+  private static Object optionalValue(Object optional) {
+    if (optional == null) {
+      throw new PointerMissException("Optional is null");
+    }
+    if (optional instanceof java.util.Optional<?>) {
+      java.util.Optional<?> value = (java.util.Optional<?>) optional;
+      if (!value.isPresent()) {
+        throw new PointerMissException("Optional is empty");
+      }
+      return value.get();
+    }
+    if (optional instanceof java.util.OptionalInt) {
+      java.util.OptionalInt value = (java.util.OptionalInt) optional;
+      if (!value.isPresent()) {
+        throw new PointerMissException("Optional is empty");
+      }
+      return value.getAsInt();
+    }
+    if (optional instanceof java.util.OptionalLong) {
+      java.util.OptionalLong value = (java.util.OptionalLong) optional;
+      if (!value.isPresent()) {
+        throw new PointerMissException("Optional is empty");
+      }
+      return value.getAsLong();
+    }
+    if (optional instanceof java.util.OptionalDouble) {
+      java.util.OptionalDouble value = (java.util.OptionalDouble) optional;
+      if (!value.isPresent()) {
+        throw new PointerMissException("Optional is empty");
+      }
+      return value.getAsDouble();
+    }
+    try {
+      boolean present;
+      try {
+        present = ((Boolean) optional.getClass().getMethod("isPresent").invoke(optional)).booleanValue();
+      } catch (NoSuchMethodException noIsPresent) {
+        try {
+          present = ((Boolean) optional.getClass().getMethod("isDefined").invoke(optional)).booleanValue();
+        } catch (NoSuchMethodException noIsDefined) {
+          present = !((Boolean) optional.getClass().getMethod("isEmpty").invoke(optional)).booleanValue();
+        }
+      }
+      if (!present) {
+        throw new PointerMissException("Optional is empty");
+      }
+      try {
+        return optional.getClass().getMethod("get").invoke(optional);
+      } catch (NoSuchMethodException noGet) {
+        if (optional instanceof Iterable<?>) {
+          return ((Iterable<?>) optional).iterator().next();
+        }
+        throw noGet;
+      }
+    } catch (PointerMissException exception) {
+      throw exception;
+    } catch (ReflectiveOperationException | java.util.NoSuchElementException exception) {
+      throw new PointerTypeException("Unsupported optional value", exception);
+    }
+  }
+
+  private static void register(String className, Attribute['[]'] attributes) {
+    try {
+      Class<?> implementation = Class.forName(className, false,
+          [pointerCompanionName type].class.getClassLoader());
+      TYPES.put(implementation, new TypeInfo(implementation, attributes));
+    } catch (ClassNotFoundException exception) {
+      throw new ExceptionInInitializerError(exception);
+    }
+  }
+
+  private static java.lang.reflect.Method findMethod(
+      Class<?> implementation, String name, int parameterCount) {
+    for (Class<?> current = implementation; current != null; current = current.getSuperclass()) {
+      for (java.lang.reflect.Method method : current.getDeclaredMethods()) {
+        if (method.getName().equals(name) && method.getParameterTypes().length == parameterCount) {
+          method.setAccessible(true);
+          return method;
+        }
+      }
