+package org.immutables.fixture.pointers;
+
+import static org.immutables.check.Checkers.check;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import org.junit.jupiter.api.Test;
+
+public class PointerValuesTest {
+  private static PointerValues.Leaf leaf(String name) {
+    return ImmutablePointerValues.Leaf.builder().name(name).build();
+  }
+
+  private static PointerValues.Branch branch() {
+    PointerValues.Leaf first = leaf("first");
+    PointerValues.Leaf second = leaf("second");
+    Map<String, PointerValues.Node> named = new LinkedHashMap<>();
+    named.put("a/b", first);
+    named.put("", second);
+    return ImmutablePointerValues.Branch.builder()
+        .child(first)
+        .addChildren(first)
+        .addChildren(second)
+        .putAllNamed(named)
+        .optional(second)
+        .array(first, second)
+        .addSet(first)
+        .numbers(1, 2)
+        .build();
+  }
+
+  @Test
+  public void parseAndRender() {
+    check(PointerValuesPointers.render(PointerValuesPointers.parse(""))).is("");
+    check(PointerValuesPointers.parse("/a~1b/~0/").toString()).is("/a~1b/~0/");
+    check(PointerValuesPointers.parse("/same")).is(PointerValuesPointers.parse("/same"));
+    assertThrows(PointerValuesPointers.MalformedPointerException.class, () -> PointerValuesPointers.parse("x"));
+    assertThrows(PointerValuesPointers.MalformedPointerException.class, () -> PointerValuesPointers.parse("/~2"));
+  }
+
+  @Test
+  public void resolveValuesAndContainers() {
+    PointerValues.Branch root = branch();
+    check(PointerValuesPointers.resolve(root, PointerValuesPointers.parse(""))).same(root);
+    check(PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/child/name"))).is("first");
+    check(PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/children/1/name"))).is("second");
+    check(PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/named/a~1b/name"))).is("first");
+    check(PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/named//name"))).is("second");
+    check(PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/optional/name"))).is("second");
+    check(PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/array/0/name"))).is("first");
+    check(PointerValuesPointers.resolve(leaf("x"), PointerValuesPointers.parse("/nullable"))).isNull();
+  }
+
+  @Test
+  public void updateRebuildsOnlyThePath() {
+    PointerValues.Branch root = branch();
+    PointerValues.Branch updated = (PointerValues.Branch) PointerValuesPointers.update(
+        root, PointerValuesPointers.parse("/children/0/name"), value -> value + "!");
+
+    check(updated).not().same(root);
+    check(updated.children().get(0)).not().same(root.children().get(0));
+    check(updated.children().get(1)).same(root.children().get(1));
+    check(updated.child()).same(root.child());
+    check(((PointerValues.Leaf) updated.children().get(0)).name()).is("first!");
+
+    Object unchanged = PointerValuesPointers.update(
+        root, PointerValuesPointers.parse("/child/name"), value -> new String((String) value));
+    check(unchanged).same(root);
+  }
+
+  @Test
+  public void updateContainersAndFailures() {
+    PointerValues.Branch root = branch();
+    PointerValues.Branch mapUpdated = (PointerValues.Branch) PointerValuesPointers.update(
+        root, PointerValuesPointers.parse("/named/a~1b/name"), value -> "changed");
+    check(((PointerValues.Leaf) mapUpdated.named().get("a/b")).name()).is("changed");
+    PointerValues.Branch optionalUpdated = (PointerValues.Branch) PointerValuesPointers.update(
+        root, PointerValuesPointers.parse("/optional/name"), value -> "optional changed");
+    check(((PointerValues.Leaf) optionalUpdated.optional().get()).name()).is("optional changed");
+    check(mapUpdated.named().keySet()).isOf("a/b", "");
+
+    assertThrows(PointerValuesPointers.PointerMissException.class,
+        () -> PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/missing")));
+    assertThrows(PointerValuesPointers.PointerTypeException.class,
+        () -> PointerValuesPointers.resolve(root, PointerValuesPointers.parse("/children/01")));
+    assertThrows(PointerValuesPointers.PointerMissException.class, () -> PointerValuesPointers.resolve(
+        root, PointerValuesPointers.parse("/children/999999999999999999999")));
+    assertThrows(PointerValuesPointers.PointerTypeException.class, () -> PointerValuesPointers.update(
+        root, PointerValuesPointers.parse("/derived"), value -> value));
+    assertThrows(PointerValuesPointers.PointerTypeException.class, () -> PointerValuesPointers.update(
+        root, PointerValuesPointers.parse("/set"), value -> value));
+    assertThrows(PointerValuesPointers.PointerTypeException.class, () -> PointerValuesPointers.update(
+        root, PointerValuesPointers.parse("/set/0"), value -> value));
+    assertThrows(PointerValuesPointers.PointerTypeException.class, () -> PointerValuesPointers.update(
+        root, PointerValuesPointers.parse("/numbers"), value -> value));
+    assertThrows(PointerValuesPointers.PointerTypeException.class, () -> PointerValuesPointers.update(
+        root, PointerValuesPointers.parse("/numbers/0"), value -> value));
+    assertThrows(PointerValuesPointers.PointerTypeException.class, () -> PointerValuesPointers.update(
+        root, PointerValuesPointers.parse("/child"), value -> "wrong"));
+    assertThrows(PointerValuesPointers.PointerTypeException.class, () -> PointerValuesPointers.update(
+        root, PointerValuesPointers.parse("/child"), value -> null));
+    assertThrows(IllegalArgumentException.class,
+        () -> PointerValuesPointers.resolve(new Object(), PointerValuesPointers.parse("")));
+  }
+}
