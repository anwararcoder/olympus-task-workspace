+package org.immutables.fixture.pointers;
+
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.Set;
+import javax.annotation.Nullable;
+import org.immutables.value.Value;
+
+@Value.Enclosing
+public interface PointerValues {
+  interface Node {}
+
+  @Value.Immutable
+  interface Leaf extends Node {
+    String name();
+    @Nullable String nullable();
+  }
+
+  @Value.Immutable
+  interface Branch extends Node {
+    Node child();
+    List<Node> children();
+    Map<String, Node> named();
+    Optional<Node> optional();
+    Node[] array();
+    Set<Node> set();
+    int[] numbers();
+
+    @Value.Derived
+    default String derived() {
+      return child().toString();
+    }
+  }
+
+  @Value.Immutable
+  interface Extra {
+    String value();
+  }
+}
