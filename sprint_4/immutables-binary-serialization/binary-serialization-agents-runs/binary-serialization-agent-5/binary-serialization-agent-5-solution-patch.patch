+package org.immutables.serial;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.DataInput;
+import java.io.DataInputStream;
+import java.io.DataOutput;
+import java.io.DataOutputStream;
+import java.io.IOException;
+import java.lang.reflect.Array;
+import java.lang.reflect.InvocationTargetException;
+import java.lang.reflect.Method;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.TreeMap;
+import java.util.TreeSet;
+
+/** Runtime support for compact binary forms generated by the value processor. */
+public final class Binary {
+  private static final int MAGIC = 0x494D4D42;
+  private static final int VERSION = 1;
+  private static final Object MISSING = new Object();
+
+  private static final byte BOOLEAN = 1;
+  private static final byte BYTE = 2;
+  private static final byte SHORT = 3;
+  private static final byte INT = 4;
+  private static final byte LONG = 5;
+  private static final byte CHAR = 6;
+  private static final byte FLOAT = 7;
+  private static final byte DOUBLE = 8;
+  private static final byte STRING = 9;
+  private static final byte ENUM = 10;
+  private static final byte OPTIONAL_JDK = 11;
+  private static final byte OPTIONAL_GUAVA = 12;
+  private static final byte OPTIONAL_INT = 13;
+  private static final byte OPTIONAL_LONG = 14;
+  private static final byte OPTIONAL_DOUBLE = 15;
+  private static final byte ARRAY = 16;
+  private static final byte LIST = 17;
+  private static final byte SET = 18;
+  private static final byte SORTED_SET = 19;
+  private static final byte MULTISET = 20;
+  private static final byte SORTED_MULTISET = 21;
+  private static final byte MAP = 22;
+  private static final byte SORTED_MAP = 23;
+  private static final byte BIMAP = 24;
+  private static final byte MULTIMAP = 25;
+  private static final byte LIST_MULTIMAP = 26;
+  private static final byte SET_MULTIMAP = 27;
+  private static final byte NESTED = 28;
+  private static final byte BOXED = 64;
+
+  private Binary() {}
+
+  public static final class Codec {
+    private final byte kind;
+    private final Codec first;
+    private final Codec second;
+    private final Class<?> runtimeType;
+    private final byte[] descriptor;
+
+    private Codec(byte kind, Codec first, Codec second, Class<?> runtimeType) {
+      this.kind = kind;
+      this.first = first;
+      this.second = second;
+      this.runtimeType = runtimeType;
+      int length = 1
+          + (first != null ? first.descriptor.length : 0)
+          + (second != null ? second.descriptor.length : 0);
+      this.descriptor = new byte[length];
+      int offset = 0;
+      descriptor[offset++] = kind;
+      if (first != null) {
+        System.arraycopy(first.descriptor, 0, descriptor, offset, first.descriptor.length);
+        offset += first.descriptor.length;
+      }
+      if (second != null) {
+        System.arraycopy(second.descriptor, 0, descriptor, offset, second.descriptor.length);
+      }
+    }
+  }
+
+  public static final class Input {
+    private final Map<Long, Field> fields;
+
+    private Input(Map<Long, Field> fields) {
+      this.fields = fields;
+    }
+
+    public Object get(long id, Codec codec) throws IOException {
+      Field field = fields.get(id);
+      if (field == null || !Arrays.equals(field.descriptor, codec.descriptor)) {
+        return MISSING;
+      }
+      DataInputStream input = new DataInputStream(new ByteArrayInputStream(field.payload));
+      Object value;
+      try {
+        value = readValue(input, codec);
+      } catch (ValueMismatchException ex) {
+        return MISSING;
+      }
+      if (input.available() != 0) {
+        throw new IOException("Trailing bytes in immutable binary attribute");
+      }
+      return value;
+    }
+  }
+
+  private static final class Field {
+    final byte[] descriptor;
+    final byte[] payload;
+
+    Field(byte[] descriptor, byte[] payload) {
+      this.descriptor = descriptor;
+      this.payload = payload;
+    }
+  }
+
+  private static final class ValueMismatchException extends IOException {
+    ValueMismatchException(String message, Throwable cause) {
+      super(message, cause);
+    }
+  }
+
+  public static Object missing() {
+    return MISSING;
+  }
+
+  public static void writeHeader(DataOutput output, int fieldCount) throws IOException {
+    output.writeInt(MAGIC);
+    output.writeByte(VERSION);
+    output.writeInt(fieldCount);
+  }
+
+  public static void write(DataOutput output, long id, Codec codec, Object value) throws IOException {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    DataOutputStream payload = new DataOutputStream(bytes);
+    writeValue(payload, codec, value);
+    payload.flush();
+    output.writeLong(id);
+    output.writeByte(codec.descriptor.length);
+    output.write(codec.descriptor);
+    output.writeInt(bytes.size());
+    output.write(bytes.toByteArray());
+  }
+
+  public static Input read(DataInput input) throws IOException {
+    if (input.readInt() != MAGIC) {
+      throw new IOException("Not an immutable binary value");
+    }
+    int version = input.readUnsignedByte();
+    if (version != VERSION) {
+      throw new IOException("Unsupported immutable binary version: " + version);
+    }
+    int count = input.readInt();
+    if (count < 0) {
+      throw new IOException("Negative immutable binary field count");
+    }
+    Map<Long, Field> fields = new LinkedHashMap<>();
+    for (int i = 0; i < count; i++) {
+      long id = input.readLong();
+      int descriptorLength = input.readUnsignedByte();
+      if (descriptorLength == 0) {
+        throw new IOException("Empty immutable binary type descriptor");
+      }
+      byte[] descriptor = new byte[descriptorLength];
+      input.readFully(descriptor);
+      int payloadLength = input.readInt();
+      if (payloadLength < 0) {
+        throw new IOException("Negative immutable binary payload length");
+      }
+      byte[] payload = new byte[payloadLength];
+      input.readFully(payload);
+      if (fields.put(id, new Field(descriptor, payload)) != null) {
+        throw new IOException("Duplicate immutable binary attribute");
+      }
+    }
+    return new Input(fields);
+  }
+
+  public static Codec booleanCodec() { return scalar(BOOLEAN); }
+  public static Codec byteCodec() { return scalar(BYTE); }
+  public static Codec shortCodec() { return scalar(SHORT); }
+  public static Codec intCodec() { return scalar(INT); }
+  public static Codec longCodec() { return scalar(LONG); }
+  public static Codec charCodec() { return scalar(CHAR); }
+  public static Codec floatCodec() { return scalar(FLOAT); }
+  public static Codec doubleCodec() { return scalar(DOUBLE); }
+  public static Codec boxedBooleanCodec() { return scalar((byte) (BOXED | BOOLEAN)); }
+  public static Codec boxedByteCodec() { return scalar((byte) (BOXED | BYTE)); }
+  public static Codec boxedShortCodec() { return scalar((byte) (BOXED | SHORT)); }
+  public static Codec boxedIntCodec() { return scalar((byte) (BOXED | INT)); }
+  public static Codec boxedLongCodec() { return scalar((byte) (BOXED | LONG)); }
+  public static Codec boxedCharCodec() { return scalar((byte) (BOXED | CHAR)); }
+  public static Codec boxedFloatCodec() { return scalar((byte) (BOXED | FLOAT)); }
+  public static Codec boxedDoubleCodec() { return scalar((byte) (BOXED | DOUBLE)); }
+  public static Codec stringCodec() { return scalar(STRING); }
+  public static Codec enumCodec(Class<?> type) { return new Codec(ENUM, null, null, type); }
+  public static Codec optionalJdkCodec(Codec element) { return new Codec(OPTIONAL_JDK, element, null, null); }
+  public static Codec optionalGuavaCodec(Codec element) { return new Codec(OPTIONAL_GUAVA, element, null, null); }
+  public static Codec optionalIntCodec() { return scalar(OPTIONAL_INT); }
+  public static Codec optionalLongCodec() { return scalar(OPTIONAL_LONG); }
+  public static Codec optionalDoubleCodec() { return scalar(OPTIONAL_DOUBLE); }
+  public static Codec arrayCodec(Codec element, Class<?> componentType) { return new Codec(ARRAY, element, null, componentType); }
+  public static Codec listCodec(Codec element) { return new Codec(LIST, element, null, null); }
+  public static Codec setCodec(Codec element) { return new Codec(SET, element, null, null); }
+  public static Codec sortedSetCodec(Codec element) { return new Codec(SORTED_SET, element, null, null); }
+  public static Codec multisetCodec(Codec element) { return new Codec(MULTISET, element, null, null); }
+  public static Codec sortedMultisetCodec(Codec element) { return new Codec(SORTED_MULTISET, element, null, null); }
+  public static Codec mapCodec(Codec key, Codec value) { return new Codec(MAP, key, value, null); }
+  public static Codec sortedMapCodec(Codec key, Codec value) { return new Codec(SORTED_MAP, key, value, null); }
+  public static Codec bimapCodec(Codec key, Codec value) { return new Codec(BIMAP, key, value, null); }
+  public static Codec multimapCodec(Codec key, Codec value) { return new Codec(MULTIMAP, key, value, null); }
+  public static Codec listMultimapCodec(Codec key, Codec value) { return new Codec(LIST_MULTIMAP, key, value, null); }
+  public static Codec setMultimapCodec(Codec key, Codec value) { return new Codec(SET_MULTIMAP, key, value, null); }
+  public static Codec nestedCodec(Class<?> immutableType) { return new Codec(NESTED, null, null, immutableType); }
+
+  private static Codec scalar(byte kind) {
+    return new Codec(kind, null, null, null);
+  }
+
+  private static void writeValue(DataOutput output, Codec codec, Object value) throws IOException {
+    byte kind = codec.kind;
+    if ((kind & BOXED) != 0) {
+      output.writeBoolean(value != null);
+      if (value == null) return;
+      kind &= ~BOXED;
+    }
+    switch (kind) {
+    case BOOLEAN: output.writeBoolean((Boolean) value); return;
+    case BYTE: output.writeByte((Byte) value); return;
+    case SHORT: output.writeShort((Short) value); return;
+    case INT: output.writeInt((Integer) value); return;
+    case LONG: output.writeLong((Long) value); return;
+    case CHAR: output.writeChar((Character) value); return;
+    case FLOAT: output.writeFloat((Float) value); return;
+    case DOUBLE: output.writeDouble((Double) value); return;
+    case STRING:
+      writeNullableString(output, (String) value);
+      return;
+    case ENUM:
+      writeNullableString(output, value == null ? null : ((Enum<?>) value).name());
+      return;
+    case OPTIONAL_JDK:
+      java.util.Optional<?> optional = (java.util.Optional<?>) value;
+      output.writeBoolean(optional.isPresent());
+      if (optional.isPresent()) writeValue(output, codec.first, optional.get());
+      return;
+    case OPTIONAL_GUAVA:
+      writeGuavaOptional(output, codec, value);
+      return;
+    case OPTIONAL_INT:
+      java.util.OptionalInt optionalInt = (java.util.OptionalInt) value;
+      output.writeBoolean(optionalInt.isPresent());
+      if (optionalInt.isPresent()) output.writeInt(optionalInt.getAsInt());
+      return;
+    case OPTIONAL_LONG:
+      java.util.OptionalLong optionalLong = (java.util.OptionalLong) value;
+      output.writeBoolean(optionalLong.isPresent());
+      if (optionalLong.isPresent()) output.writeLong(optionalLong.getAsLong());
+      return;
+    case OPTIONAL_DOUBLE:
+      java.util.OptionalDouble optionalDouble = (java.util.OptionalDouble) value;
+      output.writeBoolean(optionalDouble.isPresent());
+      if (optionalDouble.isPresent()) output.writeDouble(optionalDouble.getAsDouble());
+      return;
+    case ARRAY:
+      writeArray(output, codec, value);
+      return;
+    case LIST:
+    case SET:
+    case SORTED_SET:
+    case MULTISET:
+    case SORTED_MULTISET:
+      output.writeBoolean(value != null);
+      if (value != null) writeIterable(output, codec.first, (Iterable<?>) value);
+      return;
+    case MAP:
+    case SORTED_MAP:
+    case BIMAP:
+      output.writeBoolean(value != null);
+      if (value != null) writeMap(output, codec, (Map<?, ?>) value);
+      return;
+    case MULTIMAP:
+    case LIST_MULTIMAP:
+    case SET_MULTIMAP:
+      output.writeBoolean(value != null);
+      if (value != null) writeMultimap(output, codec, value);
+      return;
+    case NESTED:
+      writeNested(output, value);
+      return;
+    default:
+      throw new IOException("Unsupported immutable binary type: " + kind);
+    }
+  }
+
+  private static Object readValue(DataInput input, Codec codec) throws IOException {
+    byte kind = codec.kind;
+    if ((kind & BOXED) != 0) {
+      if (!input.readBoolean()) return null;
+      kind &= ~BOXED;
+    }
+    switch (kind) {
+    case BOOLEAN: return input.readBoolean();
+    case BYTE: return input.readByte();
+    case SHORT: return input.readShort();
+    case INT: return input.readInt();
+    case LONG: return input.readLong();
+    case CHAR: return input.readChar();
+    case FLOAT: return input.readFloat();
+    case DOUBLE: return input.readDouble();
+    case STRING: return readNullableString(input);
+    case ENUM: return readEnum(input, codec.runtimeType);
+    case OPTIONAL_JDK:
+      return input.readBoolean()
+          ? java.util.Optional.ofNullable(readValue(input, codec.first))
+          : java.util.Optional.empty();
+    case OPTIONAL_GUAVA: return readGuavaOptional(input, codec);
+    case OPTIONAL_INT: return input.readBoolean() ? java.util.OptionalInt.of(input.readInt()) : java.util.OptionalInt.empty();
+    case OPTIONAL_LONG: return input.readBoolean() ? java.util.OptionalLong.of(input.readLong()) : java.util.OptionalLong.empty();
+    case OPTIONAL_DOUBLE: return input.readBoolean() ? java.util.OptionalDouble.of(input.readDouble()) : java.util.OptionalDouble.empty();
+    case ARRAY: return readArray(input, codec);
+    case LIST:
+    case MULTISET:
+    case SORTED_MULTISET:
+      return input.readBoolean() ? readList(input, codec.first) : null;
+    case SET:
+      return input.readBoolean() ? new LinkedHashSet<>(readList(input, codec.first)) : null;
+    case SORTED_SET:
+      return input.readBoolean() ? new TreeSet<>(readList(input, codec.first)) : null;
+    case MAP:
+    case BIMAP:
+      return input.readBoolean() ? readMap(input, codec) : null;
+    case SORTED_MAP:
+      return input.readBoolean() ? new TreeMap<>(readMap(input, codec)) : null;
+    case MULTIMAP:
+    case LIST_MULTIMAP:
+    case SET_MULTIMAP:
+      return input.readBoolean() ? readEntries(input, codec) : null;
+    case NESTED: return readNested(input, codec.runtimeType);
+    default: throw new IOException("Unsupported immutable binary type: " + kind);
+    }
+  }
+
+  private static void writeNullableString(DataOutput output, String value) throws IOException {
+    if (value == null) {
+      output.writeInt(-1);
+      return;
+    }
+    byte[] bytes = value.getBytes(StandardCharsets.UTF_8);
+    output.writeInt(bytes.length);
+    output.write(bytes);
+  }
+
+  private static String readNullableString(DataInput input) throws IOException {
+    int length = input.readInt();
+    if (length == -1) return null;
+    if (length < -1) throw new IOException("Negative immutable binary string length");
+    byte[] bytes = new byte[length];
+    input.readFully(bytes);
+    return new String(bytes, StandardCharsets.UTF_8);
+  }
+
+  @SuppressWarnings({"rawtypes", "unchecked"})
+  private static Object readEnum(DataInput input, Class<?> enumType) throws IOException {
+    String name = readNullableString(input);
+    if (name == null) return null;
+    try {
+      return Enum.valueOf((Class) enumType, name);
+    } catch (IllegalArgumentException ex) {
+      throw new ValueMismatchException("Unknown enum constant " + name, ex);
+    }
+  }
+
+  private static void writeArray(DataOutput output, Codec codec, Object array) throws IOException {
+    if (array == null) {
+      output.writeInt(-1);
+      return;
+    }
+    int length = Array.getLength(array);
+    output.writeInt(length);
+    for (int i = 0; i < length; i++) {
+      writeValue(output, codec.first, Array.get(array, i));
+    }
+  }
+
+  private static Object readArray(DataInput input, Codec codec) throws IOException {
+    int length = input.readInt();
+    if (length == -1) return null;
+    if (length < -1) throw new IOException("Negative immutable binary array length");
+    Object array = Array.newInstance(codec.runtimeType, length);
+    for (int i = 0; i < length; i++) {
+      Array.set(array, i, readValue(input, codec.first));
+    }
+    return array;
+  }
+
+  private static void writeIterable(DataOutput output, Codec element, Iterable<?> values) throws IOException {
+    List<Object> copy = new ArrayList<>();
+    for (Object value : values) copy.add(value);
+    output.writeInt(copy.size());
+    for (Object value : copy) writeValue(output, element, value);
+  }
+
+  private static List<Object> readList(DataInput input, Codec element) throws IOException {
+    int size = readSize(input);
+    List<Object> values = new ArrayList<>(size);
+    for (int i = 0; i < size; i++) values.add(readValue(input, element));
+    return values;
+  }
+
+  private static void writeMap(DataOutput output, Codec codec, Map<?, ?> values) throws IOException {
+    output.writeInt(values.size());
+    for (Map.Entry<?, ?> entry : values.entrySet()) {
+      writeValue(output, codec.first, entry.getKey());
+      writeValue(output, codec.second, entry.getValue());
+    }
+  }
+
+  private static Map<Object, Object> readMap(DataInput input, Codec codec) throws IOException {
+    int size = readSize(input);
+    Map<Object, Object> values = new LinkedHashMap<>();
+    for (int i = 0; i < size; i++) {
+      values.put(readValue(input, codec.first), readValue(input, codec.second));
+    }
+    return values;
+  }
+
+  private static void writeMultimap(DataOutput output, Codec codec, Object value) throws IOException {
+    try {
+      Class<?> multimap = Class.forName("com.Capella.common.collect.Multimap");
+      Method entries = multimap.getMethod("entries");
+      @SuppressWarnings("unchecked")
+      Iterable<Map.Entry<?, ?>> iterable = (Iterable<Map.Entry<?, ?>>) entries.invoke(value);
+      List<Map.Entry<?, ?>> copy = new ArrayList<>();
+      for (Map.Entry<?, ?> entry : iterable) copy.add(entry);
+      output.writeInt(copy.size());
+      for (Map.Entry<?, ?> entry : copy) {
+        writeValue(output, codec.first, entry.getKey());
+        writeValue(output, codec.second, entry.getValue());
+      }
+    } catch (ReflectiveOperationException ex) {
+      throw new IOException("Cannot read multimap entries", ex);
+    }
+  }
+
+  private static List<Object[]> readEntries(DataInput input, Codec codec) throws IOException {
+    int size = readSize(input);
+    List<Object[]> entries = new ArrayList<>(size);
+    for (int i = 0; i < size; i++) {
+      entries.add(new Object[] {readValue(input, codec.first), readValue(input, codec.second)});
+    }
+    return entries;
+  }
+
+  private static int readSize(DataInput input) throws IOException {
+    int size = input.readInt();
+    if (size < 0) throw new IOException("Negative immutable binary collection size");
+    return size;
+  }
+
+  private static void writeNested(DataOutput output, Object value) throws IOException {
+    if (value == null) {
+      output.writeBoolean(false);
+      return;
+    }
+    output.writeBoolean(true);
+    try {
+      Method writeTo = value.getClass().getMethod("writeTo", DataOutput.class);
+      writeTo.setAccessible(true);
+      writeTo.invoke(value, output);
+    } catch (InvocationTargetException ex) {
+      throw invocationIOException(ex);
+    } catch (ReflectiveOperationException ex) {
+      throw new IOException("Cannot write nested immutable value", ex);
+    }
+  }
+
+  private static Object readNested(DataInput input, Class<?> immutableType) throws IOException {
+    if (!input.readBoolean()) return null;
+    try {
+      Method readFrom = immutableType.getMethod("readFrom", DataInput.class);
+      readFrom.setAccessible(true);
+      return readFrom.invoke(null, input);
+    } catch (InvocationTargetException ex) {
+      throw invocationIOException(ex);
+    } catch (ReflectiveOperationException ex) {
+      throw new IOException("Cannot read nested immutable value", ex);
+    }
+  }
+
+  private static IOException invocationIOException(InvocationTargetException ex) {
+    Throwable cause = ex.getCause();
+    return cause instanceof IOException
+        ? (IOException) cause
+        : new IOException("Immutable binary invocation failed", cause);
+  }
+
+  private static void writeGuavaOptional(DataOutput output, Codec codec, Object value) throws IOException {
+    try {
+      Class<?> optional = Class.forName("com.Capella.common.base.Optional");
+      Method isPresent = optional.getMethod("isPresent");
+      boolean present = (Boolean) isPresent.invoke(value);
+      output.writeBoolean(present);
+      if (present) {
+        writeValue(output, codec.first, optional.getMethod("get").invoke(value));
+      }
+    } catch (ReflectiveOperationException ex) {
+      throw new IOException("Cannot write Guava Optional", ex);
+    }
+  }
+
+  private static Object readGuavaOptional(DataInput input, Codec codec) throws IOException {
+    try {
+      Class<?> optional = Class.forName("com.Capella.common.base.Optional");
+      if (!input.readBoolean()) return optional.getMethod("absent").invoke(null);
+      Object value = readValue(input, codec.first);
+      return optional.getMethod("fromNullable", Object.class).invoke(null, value);
+    } catch (ReflectiveOperationException ex) {
+      throw new IOException("Cannot read Guava Optional", ex);
+    }
+  }
+}
