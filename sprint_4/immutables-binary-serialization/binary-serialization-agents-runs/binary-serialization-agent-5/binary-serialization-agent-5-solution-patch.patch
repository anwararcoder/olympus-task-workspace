+package org.immutables.serial.fixture;
+
+import com.Capella.common.base.Optional;
+import com.Capella.common.collect.BiMap;
+import com.Capella.common.collect.ListMultimap;
+import com.Capella.common.collect.Multiset;
+import com.Capella.common.collect.SetMultimap;
+import java.io.DataOutput;
+import java.io.IOException;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.SortedMap;
+import java.util.SortedSet;
+import org.immutables.value.Value;
+
+enum CompactKind {
+  FIRST,
+  SECOND
+}
+
+@Value.Immutable
+interface CompactNested<T> {
+  String name();
+  int number();
+}
+
+@Value.Immutable
+interface CompactBuilderValue {
+  boolean flag();
+  Byte boxed();
+  String text();
+  CompactKind kind();
+  java.util.Optional<String> optional();
+  Optional<Integer> guavaOptional();
+  java.util.OptionalInt optionalInt();
+  java.util.OptionalLong optionalLong();
+  java.util.OptionalDouble optionalDouble();
+  int[] ints();
+  String[] strings();
+  List<String> list();
+  Set<Integer> set();
+  SortedSet<String> sortedSet();
+  Multiset<String> multiset();
+  Map<String, Integer> map();
+  SortedMap<String, Integer> sortedMap();
+  BiMap<String, Integer> bimap();
+  ListMultimap<String, Integer> listMultimap();
+  SetMultimap<String, Integer> setMultimap();
+  CompactNested<String> nested();
+
+  @Value.Derived
+  default int textLength() {
+    return text().length();
+  }
+
+  @Value.Auxiliary
+  Optional<String> auxiliary();
+}
+
+@Value.Immutable(builder = false)
+interface CompactConstructorValue {
+  @Value.Parameter int number();
+  @Value.Parameter String text();
+  @Value.Parameter CompactKind kind();
+  @Value.Parameter java.util.Optional<String> optional();
+  @Value.Parameter List<String> list();
+  @Value.Parameter Set<Integer> set();
+  @Value.Parameter Map<String, Integer> map();
+}
+
+@Value.Immutable
+interface CompactUnsupported {
+  Object value();
+}
+
+@Value.Immutable
+interface CompactRecursive {
+  CompactRecursive next();
+}
+
+@Value.Immutable
+interface CompactConflict {
+  int value();
+
+  default void writeTo(DataOutput output) throws IOException {
+    output.writeInt(value());
+  }
+}
+
+@Value.Immutable
+interface CompactVersionOne {
+  String shared();
+  int changed();
+  java.util.Optional<String> removed();
+}
+
+@Value.Immutable
+interface CompactVersionTwo {
+  java.util.Optional<Integer> changed();
+  java.util.Optional<String> added();
+  String shared();
+}
diff --git a/serial/test/org/immutables/serial/fixture/CompactBinaryTest.java b/serial/test/org/immutables/serial/fixture/CompactBinaryTest.java
