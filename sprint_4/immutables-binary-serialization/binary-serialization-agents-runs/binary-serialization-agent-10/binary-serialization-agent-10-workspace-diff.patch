+  @Test
+  public void scalarRoundTrip() throws Exception {
+    BinScalars value = ImmutableBinScalars.builder().n(7).s("hi").flag(true).big(99L).d(1.5).f(0.5f).sh((short) 3).bt((byte) 4).ch('z').build();
+    check(fromBytes(ImmutableBinScalars.class, toBytes(value))).is(value);
+    Method write = ImmutableBinScalars.class.getMethod("writeTo", DataOutput.class);
+    check(Modifier.isPublic(write.getModifiers()));
+    check(!Modifier.isStatic(write.getModifiers()));
+    Method read = ImmutableBinScalars.class.getMethod("readFrom", DataInput.class);
+    check(Modifier.isPublic(read.getModifiers()));
+    check(Modifier.isStatic(read.getModifiers()));
+    check(BinScalars.class.isAssignableFrom(read.getReturnType()));
+  }
