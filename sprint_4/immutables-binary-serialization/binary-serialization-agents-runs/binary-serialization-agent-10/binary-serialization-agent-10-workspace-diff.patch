+  static byte[] toBytes(Object value) throws Exception {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    value.getClass().getMethod("writeTo", DataOutput.class).invoke(value, new DataOutputStream(bytes));
+    return bytes.toByteArray();
+  }
+
+  static Object fromBytes(Class<?> immutable, byte[] data) throws Exception {
+    Method readFrom = immutable.getMethod("readFrom", DataInput.class);
+    return readFrom.invoke(null, new DataInputStream(new ByteArrayInputStream(data)));
+  }
+
+  static Object get(Object value, String attribute) throws Exception {
+    return value.getClass().getMethod(attribute).invoke(value);
+  }
