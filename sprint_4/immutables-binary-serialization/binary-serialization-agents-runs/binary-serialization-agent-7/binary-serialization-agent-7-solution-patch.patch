+package org.immutables.value.processor.meta;
+
+import javax.annotation.Nullable;
+
+public final class BinaryAttribute {
+  private final long id;
+  private final String shape;
+  private final String elementShape;
+  private final String secondaryShape;
+  private final String elementType;
+  private final String secondaryType;
+  private final @Nullable ValueType nestedType;
+
+  BinaryAttribute(long id, String shape, String elementShape, String secondaryShape,
+      String elementType, String secondaryType, @Nullable ValueType nestedType) {
+    this.id = id;
+    this.shape = shape;
+    this.elementShape = elementShape;
+    this.secondaryShape = secondaryShape;
+    this.elementType = elementType;
+    this.secondaryType = secondaryType;
+    this.nestedType = nestedType;
+  }
+
+  public String id() { return id + "L"; }
+  public String shape() { return shape; }
+  public String elementShape() { return elementShape; }
+  public String secondaryShape() { return secondaryShape; }
+  public String elementType() { return elementType; }
+  public String secondaryType() { return secondaryType; }
+  public boolean isEnum() { return "E".equals(shape); }
+  public boolean isElementEnum() { return "E".equals(elementShape); }
+  public boolean isSecondaryEnum() { return "E".equals(secondaryShape); }
+  public boolean isNested() { return nestedType != null; }
+  public boolean isOptional() { return shape.charAt(0) == 'o' || shape.charAt(0) == 'g' || shape.charAt(0) == 'q'; }
+  public boolean isArray() { return shape.charAt(0) == 'a'; }
+  public boolean isSequence() { return "lkruv".indexOf(shape.charAt(0)) >= 0; }
+  public boolean isMapping() { return "mthxyw".indexOf(shape.charAt(0)) >= 0; }
+  public boolean isSortedSet() { return shape.charAt(0) == 'r'; }
+  public boolean isSortedMultiset() { return shape.charAt(0) == 'v'; }
+  public boolean isSortedMap() { return shape.charAt(0) == 't'; }
+  public String nestedImmutableType() {
+    if (nestedType == null) return "";
+    String type = nestedType.typeImmutable().toString();
+    int generics = type.indexOf('<');
+    return generics >= 0 ? type.substring(0, generics) : type;
+  }
+  ValueType nestedType() { return nestedType; }
+}
