+package org.immutables.value.processor.meta;
+
+import com.Capella.common.collect.ImmutableList;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import javax.annotation.Nullable;
+import javax.lang.model.element.Element;
+import javax.lang.model.element.ExecutableElement;
+import javax.lang.model.element.ElementKind;
+import javax.lang.model.element.TypeElement;
+import javax.lang.model.type.ArrayType;
+import javax.lang.model.type.DeclaredType;
+import javax.lang.model.type.TypeKind;
+import javax.lang.model.type.TypeMirror;
+import javax.lang.model.util.ElementFilter;
+
+final class BinaryEncoding {
+  private BinaryEncoding() {}
+
+  static void configure(Iterable<ValueType> values) {
+    Map<String, ValueType> byType = new HashMap<>();
+    ImmutableList.Builder<ValueType> allBuilder = ImmutableList.builder();
+    for (ValueType value : values) {
+      if (value.kind().isValue() && value.element instanceof TypeElement) {
+        allBuilder.add(value);
+        byType.put(((TypeElement) value.element).getQualifiedName().toString(), value);
+      }
+    }
+    List<ValueType> all = allBuilder.build();
+    for (ValueType value : all) inspect(value, byType);
+    for (ValueType value : all) {
+      if (value.binaryForm && !eligibleGraph(value, new HashSet<ValueType>(), new HashSet<ValueType>())) {
+        value.binaryForm = false;
+      }
+    }
+  }
+
+  private static void inspect(ValueType value, Map<String, ValueType> byType) {
+    if (!value.constitution.protoclass().environment().hasSerialModule()
+        || hasConflict(value) || hasRequiredAuxiliary(value)) return;
+
+    if (!value.isUseBuilder()) {
+      Set<ValueAttribute> constructor = value.getConstructorArguments();
+      for (ValueAttribute attribute : value.getSettableAttributes()) {
+        if (!attribute.isAuxiliary() && !attribute.isGenerateDerived
+            && (!constructor.contains(attribute) || !constructorSupported(attribute))) return;
+      }
+    }
+
+    Set<Long> ids = new HashSet<>();
+    ImmutableList.Builder<ValueAttribute> encoded = ImmutableList.builder();
+    for (ValueAttribute attribute : value.getSettableAttributes()) {
+      if (attribute.isAuxiliary() || attribute.isGenerateDerived) continue;
+      BinaryAttribute binary = inspect(attribute, byType);
+      if (!value.isUseBuilder() && binary != null
+          && (binary.isNested()
+              || (binary.isSequence() && !attribute.isCollectionType())
+              || (binary.isMapping() && !attribute.isMapType()))) return;
+      if (binary == null || !ids.add(hash(attribute.name()))) return;
+      attribute.binary = binary;
+      encoded.add(attribute);
+    }
+    value.binaryAttributes = encoded.build();
+    value.binaryForm = true;
+  }
+
+  private static boolean constructorSupported(ValueAttribute attribute) {
+    if (attribute.isArrayType() || attribute.isMultisetType() || attribute.isMultimapType()) return false;
+    return !attribute.isCollectionType() || attribute.isListType() || attribute.isSetType();
+  }
+
+  private static boolean hasRequiredAuxiliary(ValueType value) {
+    for (ValueAttribute attribute : value.getImplementedAttributes()) {
+      if (attribute.isAuxiliary() && attribute.isMandatory()) return true;
+    }
+    return false;
+  }
+
+  private static boolean hasConflict(ValueType value) {
+    TypeElement dataInput = elements(value).getTypeElement("java.io.DataInput");
+    TypeElement dataOutput = elements(value).getTypeElement("java.io.DataOutput");
+    for (ExecutableElement method : ElementFilter.methodsIn(
+        elements(value).getAllMembers(CachingElements.getDelegate((TypeElement) value.element)))) {
+      if (method.getParameters().size() != 1) continue;
+      String name = method.getSimpleName().toString();
+      TypeMirror parameter = method.getParameters().get(0).asType();
+      if (name.equals("writeTo") && sameErasure(value, parameter, dataOutput.asType())) return true;
+      if (name.equals("readFrom") && sameErasure(value, parameter, dataInput.asType())) return true;
+    }
+    return false;
+  }
+
+  private static javax.lang.model.util.Elements elements(ValueType value) {
+    return value.constitution.protoclass().environment().processing().getElementUtils();
+  }
+
+  private static boolean sameErasure(ValueType value, TypeMirror left, TypeMirror right) {
+    javax.lang.model.util.Types types =
+        value.constitution.protoclass().environment().processing().getTypeUtils();
+    return types.isSameType(types.erasure(left), types.erasure(right));
+  }
+
+  private static @Nullable BinaryAttribute inspect(
+      ValueAttribute attribute, Map<String, ValueType> byType) {
+    long id = hash(attribute.name());
+    TypeMirror type = attribute.returnType;
+    if (attribute.isArrayType()) {
+      TypeMirror component = ((ArrayType) type).getComponentType();
+      String element = component.getKind() != TypeKind.ARRAY ? scalar(component) : null;
+      return element != null ? new BinaryAttribute(id, "a" + element, element, "", component.toString(), "", null) : null;
+    }
+    if (attribute.isOptionalType()) {
+      if (attribute.isJdkSpecializedOptional()) {
+        String element = attribute.getElementType();
+        String shape = "int".equals(element) ? "qI" : "long".equals(element) ? "qJ" : "qD";
+        return new BinaryAttribute(id, shape, shape.substring(1), "", attribute.getElementType(), "", null);
+      }
+      TypeMirror elementType = firstArgument(type);
+      String element = scalar(elementType);
+      String prefix = attribute.isJdkOptional() ? "o" : attribute.isGuavaOptional() ? "g" : null;
+      return element != null && prefix != null
+          ? new BinaryAttribute(id, prefix + element, element, "", elementType.toString(), "", null) : null;
+    }
+    if (attribute.isCollectionType() || isCollectionRaw(type)) {
+      TypeMirror elementType = firstArgument(type);
+      String element = scalar(elementType);
+      String prefix = collectionPrefix(attribute.typeKind(), type);
+      return element != null && prefix != null
+          ? new BinaryAttribute(id, prefix + element, element, "", elementType.toString(), "", null) : null;
+    }
+    if (attribute.isMapType() || isMapRaw(type)) {
+      DeclaredType declared = declared(type);
+      if (declared == null || declared.getTypeArguments().size() != 2) return null;
+      String key = scalar(declared.getTypeArguments().get(0));
+      String mapValue = scalar(declared.getTypeArguments().get(1));
+      String prefix = mapPrefix(attribute.typeKind(), type);
+      return key != null && mapValue != null && prefix != null
+          ? new BinaryAttribute(id, prefix + key + mapValue, key, mapValue, declared.getTypeArguments().get(0).toString(), declared.getTypeArguments().get(1).toString(), null) : null;
+    }
+    ValueType nested = nested(type, byType);
+    if (nested != null) return new BinaryAttribute(id, "n", "", "", "", "", nested);
+    String shape = scalar(type);
+    return shape != null ? new BinaryAttribute(id, shape, "", "", "", "", null) : null;
+  }
+
+  private static @Nullable String collectionPrefix(AttributeTypeKind kind, TypeMirror type) {
+    String raw = rawName(type);
+    if (raw.equals("java.util.SortedSet") || raw.equals("java.util.NavigableSet")) return "r";
+    if (raw.endsWith(".SortedMultiset") || raw.endsWith(".ImmutableSortedMultiset")) return "v";
+    if (kind.isList()) return "l";
+    if (kind.isSortedSet()) return "r";
+    if (kind.isMultiset()) return "u";
+    if (kind.isSortedMultiset()) return "v";
+    if (kind.isSet() || kind.isEnumSet()) return "k";
+    return null;
+  }
+
+  private static @Nullable String mapPrefix(AttributeTypeKind kind, TypeMirror type) {
+    String raw = rawName(type);
+    if (raw.equals("java.util.SortedMap") || raw.equals("java.util.NavigableMap")) return "t";
+    if (kind.isSortedMap()) return "t";
+    if (kind.isBiMap()) return "h";
+    if (kind.isListMultimap()) return "y";
+    if (kind.isSetMultimap()) return "w";
+    if (kind.isMultimap()) return "x";
+    if (kind.isMap() || kind.isEnumMap()) return "m";
+    return null;
+  }
+
+  private static boolean isCollectionRaw(TypeMirror type) {
+    String raw = rawName(type);
+    return raw.equals("java.util.List") || raw.equals("java.util.Set")
+        || raw.equals("java.util.SortedSet") || raw.equals("java.util.NavigableSet")
+        || raw.endsWith(".SortedMultiset") || raw.endsWith(".ImmutableSortedMultiset");
+  }
+
+  private static boolean isMapRaw(TypeMirror type) {
+    String raw = rawName(type);
+    return raw.equals("java.util.Map") || raw.equals("java.util.SortedMap")
+        || raw.equals("java.util.NavigableMap");
+  }
+
+  private static String rawName(TypeMirror type) {
+    DeclaredType declared = declared(type);
+    return declared != null ? ((TypeElement) declared.asElement()).getQualifiedName().toString() : "";
+  }
+
+  private static @Nullable String scalar(TypeMirror type) {
+    switch (type.getKind()) {
+    case BOOLEAN: return "Z";
+    case BYTE: return "B";
+    case SHORT: return "S";
+    case INT: return "I";
+    case LONG: return "J";
+    case CHAR: return "C";
+    case FLOAT: return "F";
+    case DOUBLE: return "D";
+    case DECLARED:
+      TypeElement element = (TypeElement) ((DeclaredType) type).asElement();
+      String name = element.getQualifiedName().toString();
+      if (name.equals(Boolean.class.getName())) return "z";
+      if (name.equals(Byte.class.getName())) return "b";
+      if (name.equals(Short.class.getName())) return "s";
+      if (name.equals(Integer.class.getName())) return "i";
+      if (name.equals(Long.class.getName())) return "j";
+      if (name.equals(Character.class.getName())) return "c";
+      if (name.equals(Float.class.getName())) return "f";
+      if (name.equals(Double.class.getName())) return "d";
+      if (name.equals(String.class.getName())) return "T";
+      if (element.getKind() == ElementKind.ENUM) return "E";
+      return null;
+    default: return null;
+    }
+  }
+
+  private static @Nullable ValueType nested(TypeMirror type, Map<String, ValueType> byType) {
+    DeclaredType declared = declared(type);
+    if (declared == null) return null;
+    for (TypeMirror argument : declared.getTypeArguments()) {
+      if (argument.getKind() == TypeKind.TYPEVAR || argument.getKind() == TypeKind.WILDCARD) return null;
+    }
+    Element element = declared.asElement();
+    return element instanceof TypeElement
+        ? byType.get(((TypeElement) element).getQualifiedName().toString()) : null;
+  }
+
+  private static @Nullable DeclaredType declared(TypeMirror type) {
+    return type.getKind() == TypeKind.DECLARED ? (DeclaredType) type : null;
+  }
+
+  private static TypeMirror firstArgument(TypeMirror type) {
+    DeclaredType declared = declared(type);
+    return declared != null && declared.getTypeArguments().size() == 1
+        ? declared.getTypeArguments().get(0) : type;
+  }
+
+  private static boolean eligibleGraph(
+      ValueType value, Set<ValueType> visiting, Set<ValueType> visited) {
+    if (!value.binaryForm) return false;
+    if (visited.contains(value)) return true;
+    if (!visiting.add(value)) return false;
+    for (ValueAttribute attribute : value.binaryAttributes) {
+      if (attribute.binary.isNested()
+          && !eligibleGraph(attribute.binaryNestedType(), visiting, visited)) return false;
+    }
+    visiting.remove(value);
+    visited.add(value);
+    return true;
+  }
+
+  private static long hash(String value) {
+    long hash = 0xcbf29ce484222325L;
+    for (int i = 0; i < value.length(); i++) {
+      hash ^= value.charAt(i);
+      hash *= 0x100000001b3L;
+    }
+    return hash;
+  }
+}
