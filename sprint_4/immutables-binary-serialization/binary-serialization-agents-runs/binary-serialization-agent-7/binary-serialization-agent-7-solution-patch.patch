index 0000000..3f8052f
--- /dev/null
+++ b/serial/src/org/immutables/serial/Binary.java
@@ -0,0 +1,347 @@
+package org.immutables.serial;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.DataInput;
+import java.io.DataInputStream;
+import java.io.DataOutput;
+import java.io.DataOutputStream;
+import java.io.EOFException;
+import java.io.IOException;
+import java.lang.reflect.Array;
+import java.lang.reflect.InvocationTargetException;
+import java.lang.reflect.Method;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Runtime support for compact binary forms generated by the value processor. */
+public final class Binary {
+  private static final int MAGIC = 0x494d4d42;
+  public static final Object MISSING = new Object();
+
+  private Binary() {}
+
+  public static final class OptionalValue {
+    public final boolean present;
+    public final Object value;
+
+    OptionalValue(boolean present, Object value) {
+      this.present = present;
+      this.value = value;
+    }
+  }
+
+  public static final class Input {
+    private final Map<Long, Field> fields;
+
+    Input(Map<Long, Field> fields) {
+      this.fields = fields;
+    }
+
+    public Object value(long id, String shape) throws IOException {
+      Field field = fields.get(id);
+      if (field == null || !field.shape.equals(shape)) {
+        return MISSING;
+      }
+      DataInputStream input = new DataInputStream(new ByteArrayInputStream(field.data));
+      Object value = readValue(input, shape);
+      if (input.available() != 0) {
+        throw new IOException("Trailing data in immutable binary attribute");
+      }
+      return value;
+    }
+  }
+
+  private static final class Field {
+    final String shape;
+    final byte[] data;
+
+    Field(String shape, byte[] data) {
+      this.shape = shape;
+      this.data = data;
+    }
+  }
+
+  public static void writeHeader(DataOutput output, int count) throws IOException {
+    output.writeInt(MAGIC);
+    output.writeInt(count);
+  }
+
+  public static void writeField(DataOutput output, long id, String shape, Object value)
+      throws IOException {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    DataOutputStream field = new DataOutputStream(bytes);
+    writeValue(field, shape, value);
+    field.flush();
+    byte[] data = bytes.toByteArray();
+    output.writeLong(id);
+    writeString(output, shape);
+    output.writeInt(data.length);
+    output.write(data);
+  }
+
+  public static Input read(DataInput input) throws IOException {
+    if (input.readInt() != MAGIC) {
+      throw new IOException("Invalid immutable binary header");
+    }
+    int count = input.readInt();
+    if (count < 0) {
+      throw new IOException("Invalid immutable binary field count");
+    }
+    Map<Long, Field> fields = new HashMap<Long, Field>();
+    for (int i = 0; i < count; i++) {
+      long id = input.readLong();
+      String shape = readString(input);
+      int length = input.readInt();
+      if (length < 0) {
+        throw new IOException("Invalid immutable binary field length");
+      }
+      byte[] data = new byte[length];
+      input.readFully(data);
+      fields.put(id, new Field(shape, data));
+    }
+    return new Input(fields);
+  }
+
+  public static <E extends Enum<E>> E enumValue(Class<E> type, Object value) throws IOException {
+    try {
+      return Enum.valueOf(type, (String) value);
+    } catch (IllegalArgumentException e) {
+      throw new IOException("Unknown immutable binary enum constant", e);
+    }
+  }
+
+  @SuppressWarnings("unchecked")
+  public static List<Object> values(Object value) throws IOException {
+    if (!(value instanceof List)) throw new IOException("Invalid immutable binary collection");
+    return (List<Object>) value;
+  }
+
+  public static DataInput input(Object value) throws IOException {
+    if (!(value instanceof byte[])) {
+      throw new IOException("Invalid nested immutable binary value");
+    }
+    return new DataInputStream(new ByteArrayInputStream((byte[]) value));
+  }
+
+  private static void writeValue(DataOutput output, String shape, Object value) throws IOException {
+    char kind = shape.charAt(0);
+    switch (kind) {
+    case 'Z': output.writeBoolean((Boolean) value); return;
+    case 'B': output.writeByte((Byte) value); return;
+    case 'S': output.writeShort((Short) value); return;
+    case 'I': output.writeInt((Integer) value); return;
+    case 'J': output.writeLong((Long) value); return;
+    case 'C': output.writeChar((Character) value); return;
+    case 'F': output.writeFloat((Float) value); return;
+    case 'D': output.writeDouble((Double) value); return;
+    case 'z': case 'b': case 's': case 'i': case 'j': case 'c': case 'f': case 'd':
+      output.writeBoolean(value != null);
+      if (value != null) writeValue(output, shape.toUpperCase(), value);
+      return;
+    case 'T': writeString(output, (String) value); return;
+    case 'E': writeString(output, ((Enum<?>) value).name()); return;
+    case 'n': writeNested(output, value); return;
+    case 'o': case 'g': writeOptional(output, shape.substring(1), value); return;
+    case 'q': writeSpecialOptional(output, shape.charAt(1), value); return;
+    case 'a': writeSequence(output, shape.substring(1), arrayValues(value)); return;
+    case 'l': case 'k': case 'r': case 'u': case 'v':
+      writeSequence(output, shape.substring(1), (Iterable<?>) value); return;
+    case 'm': case 't': case 'h': writeMap(output, shape, (Map<?, ?>) value); return;
+    case 'x': case 'y': case 'w': writeMultimap(output, shape, value); return;
+    default: throw new IOException("Unsupported immutable binary shape " + shape);
+    }
+  }
+
+  private static Object readValue(DataInput input, String shape) throws IOException {
+    char kind = shape.charAt(0);
+    switch (kind) {
+    case 'Z': return input.readBoolean();
+    case 'B': return input.readByte();
+    case 'S': return input.readShort();
+    case 'I': return input.readInt();
+    case 'J': return input.readLong();
+    case 'C': return input.readChar();
+    case 'F': return input.readFloat();
+    case 'D': return input.readDouble();
+    case 'z': case 'b': case 's': case 'i': case 'j': case 'c': case 'f': case 'd':
+      return input.readBoolean() ? readValue(input, shape.toUpperCase()) : null;
+    case 'T': case 'E': return readString(input);
+    case 'n': return readBytes(input);
+    case 'o': case 'g': return readOptional(input, shape.substring(1));
+    case 'q': return readSpecialOptional(input, shape.charAt(1));
+    case 'a': case 'l': case 'k': case 'r': case 'u': case 'v':
+      return readSequence(input, shape.substring(1));
+    case 'm': case 't': case 'h': case 'x': case 'y': case 'w': return readPairs(input, shape);
+    default: throw new IOException("Unsupported immutable binary shape " + shape);
+    }
+  }
+
+  private static void writeOptional(DataOutput output, String elementShape, Object optional)
+      throws IOException {
+    boolean present = invokeBoolean(optional, "isPresent");
+    output.writeBoolean(present);
+    if (present) writeValue(output, elementShape, invoke(optional, "get"));
+  }
+
+  private static void writeSpecialOptional(DataOutput output, char kind, Object optional)
+      throws IOException {
+    boolean present = invokeBoolean(optional, "isPresent");
+    output.writeBoolean(present);
+    if (present) {
+      String method = kind == 'I' ? "getAsInt" : kind == 'J' ? "getAsLong" : "getAsDouble";
+      writeValue(output, String.valueOf(kind), invoke(optional, method));
+    }
+  }
+
+  private static OptionalValue readOptional(DataInput input, String shape) throws IOException {
+    boolean present = input.readBoolean();
+    return new OptionalValue(present, present ? readValue(input, shape) : null);
+  }
+
+  private static OptionalValue readSpecialOptional(DataInput input, char kind) throws IOException {
+    boolean present = input.readBoolean();
+    return new OptionalValue(present, present ? readValue(input, String.valueOf(kind)) : null);
+  }
+
+  private static void writeSequence(DataOutput output, String elementShape, Iterable<?> values)
+      throws IOException {
+    Collection<?> collection = values instanceof Collection ? (Collection<?>) values : toList(values);
+    output.writeInt(collection.size());
+    for (Object value : collection) writeValue(output, elementShape, value);
+  }
+
+  private static List<Object> readSequence(DataInput input, String elementShape) throws IOException {
+    int size = readSize(input);
+    List<Object> values = new ArrayList<Object>(size);
+    for (int i = 0; i < size; i++) values.add(readValue(input, elementShape));
+    return values;
+  }
+
+  private static void writeMap(DataOutput output, String shape, Map<?, ?> map) throws IOException {
+    String keyShape = shape.substring(1, 2);
+    String valueShape = shape.substring(2);
+    output.writeInt(map.size());
+    for (Map.Entry<?, ?> entry : map.entrySet()) {
+      writeValue(output, keyShape, entry.getKey());
+      writeValue(output, valueShape, entry.getValue());
+    }
+  }
+
+  private static void writeMultimap(DataOutput output, String shape, Object multimap)
+      throws IOException {
+    Object entries = invoke(multimap, "entries");
+    if (!(entries instanceof Collection)) {
+      throw new IOException("Invalid multimap entries");
+    }
+    String keyShape = shape.substring(1, 2);
+    String valueShape = shape.substring(2);
+    Collection<?> collection = (Collection<?>) entries;
+    output.writeInt(collection.size());
+    for (Object object : collection) {
+      Map.Entry<?, ?> entry = (Map.Entry<?, ?>) object;
+      writeValue(output, keyShape, entry.getKey());
+      writeValue(output, valueShape, entry.getValue());
+    }
+  }
+
+  private static List<Object> readPairs(DataInput input, String shape) throws IOException {
+    int size = readSize(input);
+    String keyShape = shape.substring(1, 2);
+    String valueShape = shape.substring(2);
+    List<Object> values = new ArrayList<Object>(size * 2);
+    for (int i = 0; i < size; i++) {
+      values.add(readValue(input, keyShape));
+      values.add(readValue(input, valueShape));
+    }
+    return values;
+  }
+
+  private static Iterable<?> arrayValues(final Object array) {
+    return new Iterable<Object>() {
+      public java.util.Iterator<Object> iterator() {
+        return new java.util.Iterator<Object>() {
+          int index;
+          public boolean hasNext() { return index < Array.getLength(array); }
+          public Object next() { return Array.get(array, index++); }
+          public void remove() { throw new UnsupportedOperationException(); }
+        };
+      }
+    };
+  }
+
+  private static void writeNested(DataOutput output, Object value) throws IOException {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    DataOutputStream nested = new DataOutputStream(bytes);
+    try {
+      Method method = value.getClass().getMethod("writeTo", DataOutput.class);
+      if (!method.isAccessible()) method.setAccessible(true);
+      method.invoke(value, nested);
+    } catch (NoSuchMethodException | IllegalAccessException e) {
+      throw new IOException("Nested immutable has no accessible binary form", e);
+    } catch (InvocationTargetException e) {
+      Throwable cause = e.getCause();
+      if (cause instanceof IOException) throw (IOException) cause;
+      throw new IOException("Cannot write nested immutable", cause);
+    }
+    nested.flush();
+    byte[] data = bytes.toByteArray();
+    output.writeInt(data.length);
+    output.write(data);
+  }
+
+  private static byte[] readBytes(DataInput input) throws IOException {
+    int length = input.readInt();
+    if (length < 0) throw new IOException("Invalid nested immutable length");
+    byte[] data = new byte[length];
+    input.readFully(data);
+    return data;
+  }
+
+  private static int readSize(DataInput input) throws IOException {
+    int size = input.readInt();
+    if (size < 0) throw new EOFException("Invalid immutable binary collection size");
+    return size;
+  }
+
+  private static List<Object> toList(Iterable<?> iterable) {
+    List<Object> values = new ArrayList<Object>();
+    for (Object value : iterable) values.add(value);
+    return values;
+  }
+
+  private static Object invoke(Object target, String method) throws IOException {
+    try {
+      Class<?> type = target.getClass();
+      while (type != null && !java.lang.reflect.Modifier.isPublic(type.getModifiers())) {
+        type = type.getSuperclass();
+      }
+      if (type == null) throw new NoSuchMethodException(method);
+      return type.getMethod(method).invoke(target);
+    } catch (ReflectiveOperationException e) {
+      throw new IOException("Cannot inspect immutable binary value", e);
+    }
+  }
+
+  private static boolean invokeBoolean(Object target, String method) throws IOException {
+    return (Boolean) invoke(target, method);
+  }
+
+  private static void writeString(DataOutput output, String value) throws IOException {
+    byte[] bytes = value.getBytes(StandardCharsets.UTF_8);
+    output.writeInt(bytes.length);
+    output.write(bytes);
+  }
+
+  private static String readString(DataInput input) throws IOException {
+    int length = input.readInt();
+    if (length < 0) throw new IOException("Invalid immutable binary string length");
+    byte[] bytes = new byte[length];
+    input.readFully(bytes);
+    return new String(bytes, StandardCharsets.UTF_8);
+  }
+}
