@@ -0,0 +1,95 @@
+package org.immutables.serial.fixture;
+
+import com.Capella.common.base.Optional;
+import com.Capella.common.collect.BiMap;
+import com.Capella.common.collect.ListMultimap;
+import com.Capella.common.collect.Multimap;
+import com.Capella.common.collect.Multiset;
+import com.Capella.common.collect.SetMultimap;
+import com.Capella.common.collect.SortedMultiset;
+import java.io.DataOutput;
+import java.io.IOException;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.SortedMap;
+import java.util.SortedSet;
+import java.util.OptionalDouble;
+import java.util.OptionalInt;
+import java.util.OptionalLong;
+import org.immutables.value.Value;
+
+@Value.Immutable
+interface BinaryNested {
+  int number();
+  String text();
+}
+
+@Value.Immutable
+interface GenericNested<T> {
+  int number();
+}
+
+@Value.Immutable
+interface BinaryShapes {
+  enum Shade { RED, GREEN }
+
+  boolean primitive();
+  Integer boxed();
+  String text();
+  Shade shade();
+  java.util.Optional<String> jdkOptional();
+  Optional<Shade> guavaOptional();
+  OptionalInt optionalInt();
+  OptionalLong optionalLong();
+  OptionalDouble optionalDouble();
+  int[] ints();
+  String[] strings();
+  Shade[] shades();
+  List<String> list();
+  Set<Shade> set();
+  SortedSet<Integer> sortedSet();
+  Multiset<String> multiset();
+  SortedMultiset<Integer> sortedMultiset();
+  Map<String, Shade> map();
+  SortedMap<Integer, String> sortedMap();
+  BiMap<String, Integer> biMap();
+  Multimap<String, Integer> multimap();
+  ListMultimap<String, Integer> listMultimap();
+  SetMultimap<String, Integer> setMultimap();
+  BinaryNested nested();
+  GenericNested<String> genericNested();
+}
+
+@Value.Immutable(builder = false)
+interface BinaryConstructor {
+  @Value.Parameter int number();
+  @Value.Parameter String text();
+  @Value.Parameter java.util.Optional<String> optional();
+  @Value.Parameter List<Integer> list();
+  @Value.Parameter Set<String> set();
+  @Value.Parameter Map<String, Integer> map();
+}
+
+@Value.Immutable
+interface BinaryDefaults {
+  @Value.Default default String text() { return "default"; }
+  java.util.Optional<Integer> optional();
+}
+
+@Value.Immutable
+interface BinaryConflict {
+  default void writeTo(DataOutput output) throws IOException {
+    output.writeByte(1);
+  }
+}
+
+@Value.Immutable
+interface BinaryUnsupported {
+  Object object();
+}
+
+@Value.Immutable
+interface BinaryRecursive {
+  BinaryRecursive next();
+}
diff --git a/serial/test/org/immutables/serial/fixture/BinaryFormTest.java b/serial/test/org/immutables/serial/fixture/BinaryFormTest.java
new file mode 100644
index 0000000..aa11dff
--- /dev/null
+++ b/serial/test/org/immutables/serial/fixture/BinaryFormTest.java
@@ -0,0 +1,130 @@
+package org.immutables.serial.fixture;
+
+import static org.immutables.check.Checkers.check;
+import static org.junit.Assert.assertFalse;
+
+import com.Capella.common.collect.ImmutableBiMap;
+import com.Capella.common.collect.ImmutableList;
+import com.Capella.common.collect.ImmutableListMultimap;
+import com.Capella.common.collect.ImmutableMap;
+import com.Capella.common.collect.ImmutableMultimap;
+import com.Capella.common.collect.ImmutableMultiset;
+import com.Capella.common.collect.ImmutableSet;
+import com.Capella.common.collect.ImmutableSetMultimap;
+import com.Capella.common.collect.ImmutableSortedMap;
+import com.Capella.common.collect.ImmutableSortedMultiset;
+import com.Capella.common.collect.ImmutableSortedSet;
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.DataInputStream;
+import java.io.DataOutputStream;
+import java.lang.reflect.Method;
+import java.util.Arrays;
+import java.util.OptionalDouble;
+import java.util.OptionalInt;
+import java.util.OptionalLong;
+import org.immutables.serial.Binary;
+import org.junit.Test;
+
+public class BinaryFormTest {
+  @Test
+  public void allBuilderShapesAndNestedRoundTrip() throws Exception {
+    ImmutableBinaryShapes value = ImmutableBinaryShapes.builder()
+        .primitive(true)
+        .boxed(2)
+        .text(longText())
+        .shade(BinaryShapes.Shade.GREEN)
+        .jdkOptional("jdk")
+        .guavaOptional(BinaryShapes.Shade.RED)
+        .optionalInt(OptionalInt.of(3))
+        .optionalLong(OptionalLong.of(4))
+        .optionalDouble(OptionalDouble.of(5.5))
+        .ints(1, 2)
+        .strings("a", "b")
+        .shades(BinaryShapes.Shade.RED, BinaryShapes.Shade.GREEN)
+        .list(ImmutableList.of("a", "b"))
+        .set(ImmutableSet.of(BinaryShapes.Shade.GREEN))
+        .sortedSet(ImmutableSortedSet.of(1, 2))
+        .multiset(ImmutableMultiset.of("a", "a", "b"))
+        .sortedMultiset(ImmutableSortedMultiset.of(1, 1, 2))
+        .map(ImmutableMap.of("a", BinaryShapes.Shade.RED))
+        .sortedMap(ImmutableSortedMap.of(1, "a"))
+        .biMap(ImmutableBiMap.of("a", 1))
+        .multimap(ImmutableMultimap.of("a", 1, "a", 1))
+        .listMultimap(ImmutableListMultimap.of("a", 1, "a", 1))
+        .setMultimap(ImmutableSetMultimap.of("a", 1))
+        .nested(ImmutableBinaryNested.builder().number(6).text("nested").build())
+        .genericNested(ImmutableGenericNested.<String>builder().number(7).build())
+        .build();
+
+    check(roundTrip(value::writeTo, ImmutableBinaryShapes::readFrom)).is(value);
+  }
+
+  @Test
+  public void constructorRoundTrip() throws Exception {
+    ImmutableBinaryConstructor value = ImmutableBinaryConstructor.of(
+        1, "x", java.util.Optional.of("o"), Arrays.asList(1, 2),
+        ImmutableSet.of("s"), ImmutableMap.of("k", 2));
+    check(roundTrip(value::writeTo, ImmutableBinaryConstructor::readFrom)).is(value);
+  }
+
+  @Test
+  public void missingMismatchedAndUnknownFieldsUseDefaults() throws Exception {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    DataOutputStream output = new DataOutputStream(bytes);
+    Binary.writeHeader(output, 3);
+    Binary.writeField(output, hash("unknown"), "T", "ignored");
+    Binary.writeField(output, hash("optional"), "oT", java.util.Optional.of("wrong element shape"));
+    Binary.writeField(output, hash("text"), "T", "from wire");
+    ImmutableBinaryDefaults value = ImmutableBinaryDefaults.readFrom(
+        new DataInputStream(new ByteArrayInputStream(bytes.toByteArray())));
+    check(value.text()).is("from wire");
+    check(value.optional()).is(java.util.Optional.empty());
+  }
+
+  @Test(expected = java.io.EOFException.class)
+  public void incompleteInputFails() throws Exception {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    DataOutputStream output = new DataOutputStream(bytes);
+    Binary.writeHeader(output, 1);
+    ImmutableBinaryDefaults.readFrom(
+        new DataInputStream(new ByteArrayInputStream(bytes.toByteArray())));
+  }
+
+  @Test
+  public void conflictsAndUnsupportedShapesDoNotGetPartialForms() {
+    assertFalse(hasDeclared(ImmutableBinaryConflict.class, "writeTo"));
+    assertFalse(hasDeclared(ImmutableBinaryConflict.class, "readFrom"));
+    assertFalse(hasDeclared(ImmutableBinaryUnsupported.class, "writeTo"));
+    assertFalse(hasDeclared(ImmutableBinaryUnsupported.class, "readFrom"));
+    assertFalse(hasDeclared(ImmutableBinaryRecursive.class, "writeTo"));
+    assertFalse(hasDeclared(ImmutableBinaryRecursive.class, "readFrom"));
+  }
+
+  private static boolean hasDeclared(Class<?> type, String name) {
+    for (Method method : type.getDeclaredMethods()) if (method.getName().equals(name)) return true;
+    return false;
+  }
+
+  private static String longText() {
+    return new String(new char[70000]).replace("\0", "x");
+  }
+
+  private static long hash(String value) {
+    long hash = 0xcbf29ce484222325L;
+    for (int i = 0; i < value.length(); i++) {
+      hash ^= value.charAt(i);
+      hash *= 0x100000001b3L;
+    }
+    return hash;
+  }
+
+  private static <T> T roundTrip(BinaryWritable value, BinaryReader<T> reader) throws Exception {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    value.write(new DataOutputStream(bytes));
+    return reader.read(new DataInputStream(new ByteArrayInputStream(bytes.toByteArray())));
+  }
+
+  private interface BinaryWritable { void write(DataOutputStream output) throws Exception; }
+  private interface BinaryReader<T> { T read(DataInputStream input) throws Exception; }
+}
