+package org.immutables.value.processor.meta;
+
+import com.Capella.common.collect.ImmutableList;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+import javax.lang.model.element.ExecutableElement;
+import javax.lang.model.element.Modifier;
+import javax.lang.model.element.TypeElement;
+import javax.lang.model.element.VariableElement;
+import javax.lang.model.type.ArrayType;
+import javax.lang.model.type.DeclaredType;
+import javax.lang.model.type.TypeKind;
+import javax.lang.model.type.TypeMirror;
+import javax.lang.model.util.ElementFilter;
+import javax.lang.model.util.Types;
+import org.immutables.value.processor.meta.Proto.Environment;
+import org.immutables.value.processor.meta.Proto.Protoclass;
+
+/** Metadata for the optional compact binary form. */
+public final class BinaryEncoding {
+  private static final String BINARY = "org.immutables.serial.Binary";
+  private static final String DATA_INPUT = "java.io.DataInput";
+  private static final String DATA_OUTPUT = "java.io.DataOutput";
+
+  public static final int BOOLEAN = 1;
+  public static final int BYTE = 2;
+  public static final int SHORT = 3;
+  public static final int CHAR = 4;
+  public static final int INT = 5;
+  public static final int LONG = 6;
+  public static final int FLOAT = 7;
+  public static final int DOUBLE = 8;
+  public static final int BOXED_BOOLEAN = 9;
+  public static final int BOXED_BYTE = 10;
+  public static final int BOXED_SHORT = 11;
+  public static final int BOXED_CHAR = 12;
+  public static final int BOXED_INT = 13;
+  public static final int BOXED_LONG = 14;
+  public static final int BOXED_FLOAT = 15;
+  public static final int BOXED_DOUBLE = 16;
+  public static final int STRING = 17;
+  public static final int ENUM = 18;
+  public static final int NESTED = 19;
+
+  public static final int OPTIONAL = 1 << 8;
+  public static final int OPTIONAL_INT = 2 << 8;
+  public static final int OPTIONAL_LONG = 3 << 8;
+  public static final int OPTIONAL_DOUBLE = 4 << 8;
+  public static final int ARRAY = 5 << 8;
+  public static final int LIST = 6 << 8;
+  public static final int SET = 7 << 8;
+  public static final int SORTED_SET = 8 << 8;
+  public static final int MULTISET = 9 << 8;
+  public static final int SORTED_MULTISET = 10 << 8;
+  public static final int MAP = 11 << 8;
+  public static final int SORTED_MAP = 12 << 8;
+  public static final int BIMAP = 13 << 8;
+  public static final int MULTIMAP = 14 << 8;
+  public static final int LIST_MULTIMAP = 15 << 8;
+  public static final int SET_MULTIMAP = 16 << 8;
+
+  private final boolean enabled;
+  private final ImmutableList<Attribute> attributes;
+
+  private BinaryEncoding(boolean enabled, ImmutableList<Attribute> attributes) {
+    this.enabled = enabled;
+    this.attributes = attributes;
+  }
+
+  public boolean isEnabled() {
+    return enabled;
+  }
+
+  public ImmutableList<Attribute> getAttributes() {
+    return attributes;
+  }
+
+  static BinaryEncoding create(ValueType type, Set<ValueType> visiting) {
+    Environment environment = type.constitution.protoclass().environment();
+    if (environment.processing().getElementUtils().getTypeElement(BINARY) == null
+        || hasConflict(type, environment)
+        || !visiting.add(type)) {
+      return disabled();
+    }
+
+    ImmutableList.Builder<Attribute> attributes = ImmutableList.builder();
+    Set<String> identifiers = new HashSet<>();
+    boolean supported = true;
+    for (ValueAttribute attribute : type.getSettableAttributes()) {
+      if (attribute.isAuxiliary()) {
+        if (attribute.isMandatory()) {
+          supported = false;
+        }
+        continue;
+      }
+      Attribute binary = Attribute.create(attribute, visiting);
+      if (binary == null || !identifiers.add(binary.identifier())) {
+        supported = false;
+        break;
+      }
+      attribute.binaryEncoding = binary;
+      attributes.add(binary);
+    }
+
+    ImmutableList<Attribute> built = attributes.build();
+    if (!type.isUseBuilder()) {
+      Set<ValueAttribute> constructor = type.getConstructorArguments();
+      for (Attribute attribute : built) {
+        if (!constructor.contains(attribute.value)) {
+          supported = false;
+          break;
+        }
+      }
+      if (!type.getWithSettableAfterConstruction().isEmpty()) {
+        supported = false;
+      }
+    }
+    visiting.remove(type);
+    return supported ? new BinaryEncoding(true, built) : disabled();
+  }
+
+  private static BinaryEncoding disabled() {
+    return new BinaryEncoding(false, ImmutableList.<Attribute>of());
+  }
+
+  private static boolean hasConflict(ValueType type, Environment environment) {
+    Types types = environment.processing().getTypeUtils();
+    TypeMirror input = environment.processing().getElementUtils().getTypeElement(DATA_INPUT).asType();
+    TypeMirror output = environment.processing().getElementUtils().getTypeElement(DATA_OUTPUT).asType();
+    for (ExecutableElement method : ElementFilter.methodsIn(
+        environment.processing().getElementUtils().getAllMembers(CachingElements.getDelegate((TypeElement) type.element)))) {
+      List<? extends VariableElement> parameters = method.getParameters();
+      if (parameters.size() != 1) {
+        continue;
+      }
+      if (method.getSimpleName().contentEquals("writeTo")
+          && types.isSameType(types.erasure(parameters.get(0).asType()), types.erasure(output))) {
+        return true;
+      }
+      if (method.getSimpleName().contentEquals("readFrom")
+          && types.isSameType(types.erasure(parameters.get(0).asType()), types.erasure(input))) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  public static final class Attribute {
+    public final ValueAttribute value;
+    private final long idHigh;
+    private final long idLow;
+    private final int shape;
+    private final String firstClass;
+    private final String secondClass;
+    private final String nestedImmutable;
+
+    private Attribute(ValueAttribute value, long idHigh, long idLow, int shape,
+        String firstClass, String secondClass, String nestedImmutable) {
+      this.value = value;
+      this.idHigh = idHigh;
+      this.idLow = idLow;
+      this.shape = shape;
+      this.firstClass = firstClass;
+      this.secondClass = secondClass;
+      this.nestedImmutable = nestedImmutable;
+    }
+
+    static Attribute create(ValueAttribute value, Set<ValueType> visiting) {
+      value.ensureTypeIntrospected();
+      Shape shape = shape(value, visiting);
+      if (shape == null || value.isNullable() || value.hasTypeVariables) {
+        return null;
+      }
+      long[] id = identifier(value.name());
+      return new Attribute(value, id[0], id[1], shape.code,
+          shape.firstClass, shape.secondClass, shape.nestedImmutable);
+    }
+
+    public long getIdHigh() { return idHigh; }
+    public long getIdLow() { return idLow; }
+    public int getShape() { return shape; }
+    public String getFirstClass() { return firstClass; }
+    public String getSecondClass() { return secondClass; }
+    public String getNestedImmutable() { return nestedImmutable; }
+    public boolean isNested() { return nestedImmutable != null; }
+    public boolean isOptional() { return (shape & 0xff00) == OPTIONAL || isSpecializedOptional(); }
+    public boolean isSpecializedOptional() {
+      int container = shape & 0xff00;
+      return container == OPTIONAL_INT || container == OPTIONAL_LONG || container == OPTIONAL_DOUBLE;
+    }
+    public boolean isArray() { return (shape & 0xff00) == ARRAY; }
+    public boolean isCollection() {
+      int container = shape & 0xff00;
+      return container >= LIST && container <= SORTED_MULTISET;
+    }
+    public boolean isMapping() { return (shape & 0xff00) >= MAP; }
+    public String identifier() { return idHigh + ":" + idLow; }
+
+    private static Shape shape(ValueAttribute value, Set<ValueType> visiting) {
+      AttributeTypeKind kind = value.typeKind();
+      if (kind.isRegular()) {
+        int scalar = scalar(value.returnType);
+        if (scalar != 0) {
+          return new Shape(scalar, classFor(value.returnType), "null", null);
+        }
+        ValueType nested = nestedValue(value, visiting);
+        if (nested != null) {
+          String declared = nested.constitution.typeImmutable().absoluteRaw();
+          return new Shape(NESTED, "null", "null", declared);
+        }
+        return null;
+      }
+      if (kind.isArray()) {
+        TypeMirror component = ((ArrayType) value.returnType).getComponentType();
+        if (component.getKind() == TypeKind.ARRAY) return null;
+        int scalar = scalar(component);
+        return scalar == 0 ? null : new Shape(ARRAY | scalar, classFor(component), "null", null);
+      }
+      if (kind.isOptionalKind()) {
+        if (kind.isOptionalSpecializedJdk()) {
+          int scalar = kind == AttributeTypeKind.OPTIONAL_INT_JDK ? INT
+              : kind == AttributeTypeKind.OPTIONAL_LONG_JDK ? LONG : DOUBLE;
+          int container = kind == AttributeTypeKind.OPTIONAL_INT_JDK ? OPTIONAL_INT
+              : kind == AttributeTypeKind.OPTIONAL_LONG_JDK ? OPTIONAL_LONG : OPTIONAL_DOUBLE;
+          return new Shape(container | scalar, classForName(value.getElementType()), "null", null);
+        }
+        TypeMirror element = firstArgument(value.returnType);
+        int scalar = scalar(element);
+        return scalar == 0 ? null : new Shape(OPTIONAL | scalar, classFor(element), "null", null);
+      }
+      if (kind.isCollectionKind()) {
+        TypeMirror element = firstArgument(value.returnType);
+        int scalar = scalar(element);
+        if (scalar == 0) return null;
+        int container;
+        if (kind.isList()) container = LIST;
+        else if (kind.isSortedSet()) container = SORTED_SET;
+        else if (kind.isSet() || kind.isEnumSet()) container = SET;
+        else if (kind.isSortedMultiset()) container = SORTED_MULTISET;
+        else if (kind.isMultiset()) container = MULTISET;
+        else return null;
+        return new Shape(container | scalar, classFor(element), "null", null);
+      }
+      if (kind.isMappingKind()) {
+        TypeMirror first = firstArgument(value.returnType);
+        TypeMirror second = secondArgument(value.returnType);
+        int firstScalar = scalar(first);
+        int secondScalar = scalar(second);
+        if (firstScalar == 0 || secondScalar == 0) return null;
+        int container;
+        if (kind.isSortedMap()) container = SORTED_MAP;
+        else if (kind.isBiMap()) container = BIMAP;
+        else if (kind.isListMultimap()) container = LIST_MULTIMAP;
+        else if (kind.isSetMultimap()) container = SET_MULTIMAP;
+        else if (kind.isMultimap()) container = MULTIMAP;
+        else if (kind.isMap() || kind.isEnumMap()) container = MAP;
+        else return null;
+        int code = container | firstScalar | (secondScalar << 16);
+        return new Shape(code, classFor(first), classFor(second), null);
+      }
+      return null;
+    }
+
+    private static ValueType nestedValue(ValueAttribute value, Set<ValueType> visiting) {
+      if (value.containedTypeElement == null
+          || value.containedTypeElement.getKind().isClass() && value.containedTypeElement.getModifiers().contains(Modifier.FINAL)) {
+        return null;
+      }
+      Environment environment = value.containingType.constitution.protoclass().environment();
+      for (Protoclass protoclass : environment.protoclassesFrom(
+          java.util.Collections.singleton(value.containedTypeElement))) {
+        if (!protoclass.kind().isValue()
+            || !(protoclass.constitution().implementationVisibility().isPublic()
+                || protoclass.constitution().implementationPackage()
+                    .equals(value.containingType.constitution.protoclass().constitution().implementationPackage()))) {
+          return null;
+        }
+        ValueType nested = environment.composeValue(protoclass);
+        if (!nested.getBinaryEncoding(visiting).isEnabled()) return null;
+        return nested;
+      }
+      return null;
+    }
+
+    private static TypeMirror firstArgument(TypeMirror mirror) {
+      return ((DeclaredType) mirror).getTypeArguments().get(0);
+    }
+
+    private static TypeMirror secondArgument(TypeMirror mirror) {
+      return ((DeclaredType) mirror).getTypeArguments().get(1);
+    }
+
+    private static int scalar(TypeMirror mirror) {
+      switch (mirror.getKind()) {
+      case BOOLEAN: return BOOLEAN;
+      case BYTE: return BYTE;
+      case SHORT: return SHORT;
+      case CHAR: return CHAR;
+      case INT: return INT;
+      case LONG: return LONG;
+      case FLOAT: return FLOAT;
+      case DOUBLE: return DOUBLE;
+      case DECLARED:
+        TypeElement element = (TypeElement) ((DeclaredType) mirror).asElement();
+        String name = element.getQualifiedName().toString();
+        if (name.equals(Boolean.class.getName())) return BOXED_BOOLEAN;
+        if (name.equals(Byte.class.getName())) return BOXED_BYTE;
+        if (name.equals(Short.class.getName())) return BOXED_SHORT;
+        if (name.equals(Character.class.getName())) return BOXED_CHAR;
+        if (name.equals(Integer.class.getName())) return BOXED_INT;
+        if (name.equals(Long.class.getName())) return BOXED_LONG;
+        if (name.equals(Float.class.getName())) return BOXED_FLOAT;
+        if (name.equals(Double.class.getName())) return BOXED_DOUBLE;
+        if (name.equals(String.class.getName())) return STRING;
+        if (element.getKind() == javax.lang.model.element.ElementKind.ENUM) return ENUM;
+        return 0;
+      default:
+        return 0;
+      }
+    }
+
+    private static String classFor(TypeMirror mirror) {
+      if (mirror.getKind().isPrimitive()) return classForName(mirror.toString());
+      return ((TypeElement) ((DeclaredType) mirror).asElement()).getQualifiedName() + ".class";
+    }
+
+    private static String classForName(String name) {
+      return name + ".class";
+    }
+
+    private static long[] identifier(String name) {
+      try {
+        byte[] digest = MessageDigest.getInstance("SHA-256").digest(name.getBytes(StandardCharsets.UTF_8));
+        long high = 0;
+        long low = 0;
+        for (int i = 0; i < 8; i++) high = (high << 8) | (digest[i] & 0xffL);
+        for (int i = 8; i < 16; i++) low = (low << 8) | (digest[i] & 0xffL);
+        return new long[] {high, low};
+      } catch (NoSuchAlgorithmException ex) {
+        throw new AssertionError(ex);
+      }
+    }
+  }
+
+  private static final class Shape {
+    final int code;
+    final String firstClass;
+    final String secondClass;
+    final String nestedImmutable;
+
+    Shape(int code, String firstClass, String secondClass, String nestedImmutable) {
+      this.code = code;
+      this.firstClass = firstClass;
+      this.secondClass = secondClass;
+      this.nestedImmutable = nestedImmutable;
+    }
+  }
+}
