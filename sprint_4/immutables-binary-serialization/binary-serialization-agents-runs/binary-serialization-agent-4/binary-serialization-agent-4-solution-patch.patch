diff --git a/serial/src/org/immutables/serial/Binary.java b/serial/src/org/immutables/serial/Binary.java
new file mode 100644
index 0000000..c84c814
--- /dev/null
+++ b/serial/src/org/immutables/serial/Binary.java
@@ -0,0 +1,223 @@
+package org.immutables.serial;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.DataInput;
+import java.io.DataInputStream;
+import java.io.DataOutput;
+import java.io.DataOutputStream;
+import java.io.EOFException;
+import java.io.IOException;
+import java.lang.reflect.Array;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+
+/** Runtime support for compact binary forms generated by the value processor. */
+public final class Binary {
+  private static final int BOOLEAN = 1;
+  private static final int BYTE = 2;
+  private static final int SHORT = 3;
+  private static final int CHAR = 4;
+  private static final int INT = 5;
+  private static final int LONG = 6;
+  private static final int FLOAT = 7;
+  private static final int DOUBLE = 8;
+  private static final int BOXED_BOOLEAN = 9;
+  private static final int BOXED_BYTE = 10;
+  private static final int BOXED_SHORT = 11;
+  private static final int BOXED_CHAR = 12;
+  private static final int BOXED_INT = 13;
+  private static final int BOXED_LONG = 14;
+  private static final int BOXED_FLOAT = 15;
+  private static final int BOXED_DOUBLE = 16;
+  private static final int STRING = 17;
+  private static final int ENUM = 18;
+
+  private static final int OPTIONAL = 1 << 8;
+  private static final int OPTIONAL_INT = 2 << 8;
+  private static final int OPTIONAL_LONG = 3 << 8;
+  private static final int OPTIONAL_DOUBLE = 4 << 8;
+  private static final int ARRAY = 5 << 8;
+  private static final int LIST = 6 << 8;
+  private static final int SORTED_MULTISET = 10 << 8;
+  private static final int MAP = 11 << 8;
+
+  /** Marker returned for an absent optional. */
+  public static final Object ABSENT = new Object();
+
+  private Binary() {}
+
+  public static void writeField(DataOutput output, long idHigh, long idLow, int shape,
+      Object value) throws IOException {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    DataOutputStream field = new DataOutputStream(bytes);
+    writeValue(field, shape, value);
+    field.flush();
+    writePayload(output, idHigh, idLow, shape, bytes.toByteArray());
+  }
+
+  public static void writeIterableField(DataOutput output, long idHigh, long idLow, int shape,
+      Iterable<?> values) throws IOException {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    DataOutputStream field = new DataOutputStream(bytes);
+    List<Object> copy = new ArrayList<>();
+    for (Object value : values) copy.add(value);
+    field.writeInt(copy.size());
+    int scalar = shape & 0xff;
+    for (Object value : copy) writeScalar(field, scalar, value);
+    field.flush();
+    writePayload(output, idHigh, idLow, shape, bytes.toByteArray());
+  }
+
+  public static void writeMappingField(DataOutput output, long idHigh, long idLow, int shape,
+      Iterable<? extends Map.Entry<?, ?>> entries) throws IOException {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    DataOutputStream field = new DataOutputStream(bytes);
+    List<Map.Entry<?, ?>> copy = new ArrayList<>();
+    for (Map.Entry<?, ?> entry : entries) copy.add(entry);
+    field.writeInt(copy.size());
+    int first = shape & 0xff;
+    int second = (shape >>> 16) & 0xff;
+    for (Map.Entry<?, ?> entry : copy) {
+      writeScalar(field, first, entry.getKey());
+      writeScalar(field, second, entry.getValue());
+    }
+    field.flush();
+    writePayload(output, idHigh, idLow, shape, bytes.toByteArray());
+  }
+
+  public static void writePayload(DataOutput output, long idHigh, long idLow, int shape,
+      byte[] payload) throws IOException {
+    output.writeLong(idHigh);
+    output.writeLong(idLow);
+    output.writeInt(shape);
+    output.writeInt(payload.length);
+    output.write(payload);
+  }
+
+  public static byte[] readPayload(DataInput input) throws IOException {
+    int length = input.readInt();
+    if (length < 0) throw new IOException("Negative compact binary field length");
+    byte[] payload = new byte[length];
+    input.readFully(payload);
+    return payload;
+  }
+
+  public static DataInputStream input(byte[] payload) {
+    return new DataInputStream(new ByteArrayInputStream(payload));
+  }
+
+  public static Object readValue(DataInput input, int shape, Class<?> firstClass,
+      Class<?> secondClass) throws IOException {
+    int container = shape & 0xff00;
+    int first = shape & 0xff;
+    if (container == 0) return readScalar(input, first, firstClass);
+    if (container == OPTIONAL) {
+      return input.readBoolean() ? readScalar(input, first, firstClass) : ABSENT;
+    }
+    if (container == OPTIONAL_INT || container == OPTIONAL_LONG || container == OPTIONAL_DOUBLE) {
+      return input.readBoolean() ? readScalar(input, first, firstClass) : ABSENT;
+    }
+    if (container == ARRAY) {
+      int size = readSize(input);
+      Object array = Array.newInstance(firstClass, size);
+      for (int i = 0; i < size; i++) Array.set(array, i, readScalar(input, first, firstClass));
+      return array;
+    }
+    if (container >= LIST && container <= SORTED_MULTISET) {
+      int size = readSize(input);
+      List<Object> values = new ArrayList<>(size);
+      for (int i = 0; i < size; i++) values.add(readScalar(input, first, firstClass));
+      return values;
+    }
+    if (container >= MAP) {
+      int size = readSize(input);
+      int second = (shape >>> 16) & 0xff;
+      List<Object> entries = new ArrayList<>(size * 2);
+      for (int i = 0; i < size; i++) {
+        entries.add(readScalar(input, first, firstClass));
+        entries.add(readScalar(input, second, secondClass));
+      }
+      return entries;
+    }
+    throw new IOException("Unsupported compact binary shape " + shape);
+  }
+
+  private static void writeValue(DataOutput output, int shape, Object value) throws IOException {
+    int container = shape & 0xff00;
+    int scalar = shape & 0xff;
+    if (container == 0) {
+      writeScalar(output, scalar, value);
+    } else if (container == OPTIONAL || container == OPTIONAL_INT
+        || container == OPTIONAL_LONG || container == OPTIONAL_DOUBLE) {
+      output.writeBoolean(value != ABSENT);
+      if (value != ABSENT) writeScalar(output, scalar, value);
+    } else if (container == ARRAY) {
+      int size = Array.getLength(value);
+      output.writeInt(size);
+      for (int i = 0; i < size; i++) writeScalar(output, scalar, Array.get(value, i));
+    } else {
+      throw new IOException("Shape requires an iterable writer " + shape);
+    }
+  }
+
+  private static void writeScalar(DataOutput output, int scalar, Object value) throws IOException {
+    switch (scalar) {
+    case BOOLEAN: case BOXED_BOOLEAN: output.writeBoolean((Boolean) value); return;
+    case BYTE: case BOXED_BYTE: output.writeByte((Byte) value); return;
+    case SHORT: case BOXED_SHORT: output.writeShort((Short) value); return;
+    case CHAR: case BOXED_CHAR: output.writeChar((Character) value); return;
+    case INT: case BOXED_INT: output.writeInt((Integer) value); return;
+    case LONG: case BOXED_LONG: output.writeLong((Long) value); return;
+    case FLOAT: case BOXED_FLOAT: output.writeFloat((Float) value); return;
+    case DOUBLE: case BOXED_DOUBLE: output.writeDouble((Double) value); return;
+    case STRING: writeString(output, (String) value); return;
+    case ENUM: writeString(output, ((Enum<?>) value).name()); return;
+    default: throw new IOException("Unsupported compact binary scalar " + scalar);
+    }
+  }
+
+  @SuppressWarnings({"unchecked", "rawtypes"})
+  private static Object readScalar(DataInput input, int scalar, Class<?> type) throws IOException {
+    switch (scalar) {
+    case BOOLEAN: case BOXED_BOOLEAN: return input.readBoolean();
+    case BYTE: case BOXED_BYTE: return input.readByte();
+    case SHORT: case BOXED_SHORT: return input.readShort();
+    case CHAR: case BOXED_CHAR: return input.readChar();
+    case INT: case BOXED_INT: return input.readInt();
+    case LONG: case BOXED_LONG: return input.readLong();
+    case FLOAT: case BOXED_FLOAT: return input.readFloat();
+    case DOUBLE: case BOXED_DOUBLE: return input.readDouble();
+    case STRING: return readString(input);
+    case ENUM:
+      String name = readString(input);
+      try {
+        return Enum.valueOf((Class) type, name);
+      } catch (IllegalArgumentException ex) {
+        throw new IOException("Unknown enum constant " + name, ex);
+      }
+    default: throw new IOException("Unsupported compact binary scalar " + scalar);
+    }
+  }
+
+  private static void writeString(DataOutput output, String value) throws IOException {
+    byte[] bytes = value.getBytes(StandardCharsets.UTF_8);
+    output.writeInt(bytes.length);
+    output.write(bytes);
+  }
+
+  private static String readString(DataInput input) throws IOException {
+    int length = readSize(input);
+    byte[] bytes = new byte[length];
+    input.readFully(bytes);
+    return new String(bytes, StandardCharsets.UTF_8);
+  }
+
+  private static int readSize(DataInput input) throws IOException {
+    int size = input.readInt();
+    if (size < 0) throw new EOFException("Negative compact binary size");
+    return size;
+  }
+}
diff --git a/serial/test/org/immutables/serial/fixture/BinaryCompact.java b/serial/test/org/immutables/serial/fixture/BinaryCompact.java
