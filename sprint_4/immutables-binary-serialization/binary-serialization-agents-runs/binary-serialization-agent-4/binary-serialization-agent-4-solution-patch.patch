@@ -0,0 +1,140 @@
+package org.immutables.serial.fixture;
+
+import com.Capella.common.base.Optional;
+import com.Capella.common.collect.BiMap;
+import com.Capella.common.collect.ListMultimap;
+import com.Capella.common.collect.Multimap;
+import com.Capella.common.collect.Multiset;
+import com.Capella.common.collect.SetMultimap;
+import com.Capella.common.collect.ImmutableSortedMap;
+import com.Capella.common.collect.ImmutableSortedMultiset;
+import com.Capella.common.collect.ImmutableSortedSet;
+import java.io.DataOutput;
+import java.io.IOException;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import org.immutables.value.Value;
+
+class BinaryCompact {
+  enum Choice { FIRST, SECOND }
+
+  @Value.Immutable
+  interface Everything {
+    boolean bool();
+    byte byteValue();
+    short shortValue();
+    char charValue();
+    int intValue();
+    long longValue();
+    float floatValue();
+    double doubleValue();
+    Boolean boxedBoolean();
+    Integer boxedInt();
+    String string();
+    Choice choice();
+    Optional<String> guavaOptional();
+    java.util.Optional<Choice> jdkOptional();
+    java.util.OptionalInt optionalInt();
+    java.util.OptionalLong optionalLong();
+    java.util.OptionalDouble optionalDouble();
+    int[] ints();
+    String[] strings();
+    Choice[] choices();
+    List<String> list();
+    Set<Choice> set();
+    @Value.NaturalOrder
+    ImmutableSortedSet<Integer> sortedSet();
+    Multiset<String> multiset();
+    @Value.NaturalOrder
+    ImmutableSortedMultiset<Integer> sortedMultiset();
+    Map<String, Integer> map();
+    @Value.NaturalOrder
+    ImmutableSortedMap<Integer, String> sortedMap();
+    BiMap<String, Integer> biMap();
+    Multimap<String, Choice> multimap();
+    ListMultimap<String, Choice> listMultimap();
+    SetMultimap<String, Choice> setMultimap();
+  }
+
+  @Value.Immutable(builder = false)
+  interface ConstructorValue {
+    @Value.Parameter int number();
+    @Value.Parameter List<String> values();
+    @Value.Parameter java.util.Optional<String> optional();
+    @Value.Parameter Map<String, Integer> map();
+  }
+
+  @Value.Immutable
+  interface VersionOne {
+    String label();
+    @Value.Default default int count() { return 7; }
+  }
+
+  @Value.Immutable
+  interface VersionTwo {
+    @Value.Default default int count() { return 7; }
+    java.util.Optional<Long> added();
+    String label();
+  }
+
+  @Value.Immutable
+  interface Mismatch {
+    @Value.Default default int label() { return 41; }
+    @Value.Default default String renamed() { return "missing"; }
+  }
+
+  @Value.Immutable
+  interface NestedOne {
+    String value();
+  }
+
+  @Value.Immutable
+  interface NestedTwo {
+    java.util.OptionalInt added();
+    String value();
+  }
+
+  @Value.Immutable
+  interface OuterOne {
+    NestedOne nested();
+    String following();
+  }
+
+  @Value.Immutable
+  interface OuterTwo {
+    NestedTwo nested();
+    String following();
+  }
+
+  @Value.Immutable
+  interface GenericNested<T> {
+    String value();
+  }
+
+  @Value.Immutable
+  interface GenericOuter {
+    GenericNested<String> nested();
+  }
+
+  interface ExistingBinaryApi {
+    default void writeTo(DataOutput output) throws IOException {
+      output.writeInt(0);
+    }
+  }
+
+  @Value.Immutable
+  interface Conflict extends ExistingBinaryApi {
+    String value();
+  }
+
+  @Value.Immutable
+  interface Unsupported {
+    Object value();
+  }
+
+  @Value.Immutable
+  interface Recursive {
+    Recursive next();
+  }
+}
diff --git a/serial/test/org/immutables/serial/fixture/BinaryCompactTest.java b/serial/test/org/immutables/serial/fixture/BinaryCompactTest.java
new file mode 100644
index 0000000..b97c54a
--- /dev/null
+++ b/serial/test/org/immutables/serial/fixture/BinaryCompactTest.java
@@ -0,0 +1,176 @@
+package org.immutables.serial.fixture;
+
+import com.Capella.common.base.Optional;
+import com.Capella.common.collect.ImmutableBiMap;
+import com.Capella.common.collect.ImmutableList;
+import com.Capella.common.collect.ImmutableListMultimap;
+import com.Capella.common.collect.ImmutableMap;
+import com.Capella.common.collect.ImmutableMultimap;
+import com.Capella.common.collect.ImmutableMultiset;
+import com.Capella.common.collect.ImmutableSet;
+import com.Capella.common.collect.ImmutableSetMultimap;
+import com.Capella.common.collect.ImmutableSortedMultiset;
+import com.Capella.common.collect.ImmutableSortedSet;
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.DataInputStream;
+import java.io.DataOutputStream;
+import java.lang.reflect.Method;
+import java.util.Arrays;
+import org.junit.Test;
+import static org.immutables.check.Checkers.check;
+import static org.junit.Assert.assertFalse;
+
+public class BinaryCompactTest {
+  @Test
+  public void roundTripsSupportedShapes() throws Exception {
+    ImmutableEverything value = ImmutableEverything.builder()
+        .bool(true)
+        .byteValue((byte) 2)
+        .shortValue((short) 3)
+        .charValue('x')
+        .intValue(4)
+        .longValue(5L)
+        .floatValue(6.5f)
+        .doubleValue(7.5)
+        .boxedBoolean(false)
+        .boxedInt(8)
+        .string(repeat("long-string-", 10000))
+        .choice(BinaryCompact.Choice.SECOND)
+        .guavaOptional("guava")
+        .jdkOptional(BinaryCompact.Choice.FIRST)
+        .optionalInt(11)
+        .optionalLong(12L)
+        .optionalDouble(13.5)
+        .ints(1, 2, 3)
+        .strings("a", "b")
+        .choices(BinaryCompact.Choice.SECOND, BinaryCompact.Choice.FIRST)
+        .addAllList(ImmutableList.of("a", "b"))
+        .addAllSet(ImmutableSet.of(BinaryCompact.Choice.FIRST, BinaryCompact.Choice.SECOND))
+        .sortedSet(ImmutableSortedSet.of(3, 1, 2))
+        .addAllMultiset(ImmutableMultiset.of("x", "x", "y"))
+        .sortedMultiset(ImmutableSortedMultiset.of(3, 1, 1))
+        .putAllMap(ImmutableMap.of("one", 1))
+        .sortedMap(com.Capella.common.collect.ImmutableSortedMap.of(2, "two"))
+        .putAllBiMap(ImmutableBiMap.of("one", 1))
+        .putAllMultimap(ImmutableMultimap.of("key", BinaryCompact.Choice.FIRST))
+        .putAllListMultimap(ImmutableListMultimap.of(
+            "key", BinaryCompact.Choice.FIRST, "key", BinaryCompact.Choice.FIRST))
+        .putAllSetMultimap(ImmutableSetMultimap.of(
+            "key", BinaryCompact.Choice.FIRST, "key", BinaryCompact.Choice.SECOND))
+        .build();
+
+    check(readEverything(write(value))).is(value);
+  }
+
+  @Test
+  public void constructorBuiltRoundTrips() throws Exception {
+    ImmutableConstructorValue value = ImmutableConstructorValue.of(
+        3, Arrays.asList("a", "b"), java.util.Optional.of("present"),
+        ImmutableMap.of("one", 1));
+
+    check(ImmutableConstructorValue.readFrom(input(write(value)))).is(value);
+  }
+
+  @Test
+  public void versionsMatchByAttributeAndShape() throws Exception {
+    ImmutableVersionOne one = ImmutableVersionOne.builder().label("same").count(9).build();
+    ImmutableVersionTwo two = ImmutableVersionTwo.readFrom(input(write(one)));
+    check(two.label()).is("same");
+    check(two.count()).is(9);
+    check(two.added()).is(java.util.Optional.empty());
+
+    ImmutableVersionTwo newer = ImmutableVersionTwo.builder()
+        .label("newer").count(10).added(100L).build();
+    check(ImmutableVersionOne.readFrom(input(write(newer))))
+        .is(ImmutableVersionOne.builder().label("newer").count(10).build());
+
+    ImmutableMismatch mismatch = ImmutableMismatch.readFrom(input(write(one)));
+    check(mismatch.label()).is(41);
+    check(mismatch.renamed()).is("missing");
+  }
+
+  @Test
+  public void nestedVersionsRemainDelimited() throws Exception {
+    ImmutableOuterOne one = ImmutableOuterOne.builder()
+        .nested(ImmutableNestedOne.builder().value("nested").build())
+        .following("after")
+        .build();
+
+    ImmutableOuterTwo two = ImmutableOuterTwo.readFrom(input(write(one)));
+    check(two.nested().value()).is("nested");
+    check(two.nested().added()).is(java.util.OptionalInt.empty());
+    check(two.following()).is("after");
+  }
+
+  @Test
+  public void concreteGenericNestedValuesRoundTrip() throws Exception {
+    ImmutableGenericOuter value = ImmutableGenericOuter.builder()
+        .nested(ImmutableGenericNested.<String>builder().value("generic").build())
+        .build();
+
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    DataOutputStream output = new DataOutputStream(bytes);
+    value.writeTo(output);
+    check(ImmutableGenericOuter.readFrom(input(bytes.toByteArray()))).is(value);
+  }
+
+  @Test
+  public void conflictsAndUnsupportedShapesGenerateNeitherMethod() {
+    assertFalse(hasDeclaredMethod(ImmutableConflict.class, "readFrom"));
+    assertFalse(hasDeclaredMethod(ImmutableConflict.class, "writeTo"));
+    assertFalse(hasDeclaredMethod(ImmutableUnsupported.class, "readFrom"));
+    assertFalse(hasDeclaredMethod(ImmutableUnsupported.class, "writeTo"));
+    assertFalse(hasDeclaredMethod(ImmutableRecursive.class, "readFrom"));
+    assertFalse(hasDeclaredMethod(ImmutableRecursive.class, "writeTo"));
+  }
+
+  private static byte[] write(ImmutableEverything value) throws Exception {
+    return writeValue(value);
+  }
+
+  private static byte[] write(ImmutableConstructorValue value) throws Exception {
+    return writeValue(value);
+  }
+
+  private static byte[] write(ImmutableVersionOne value) throws Exception {
+    return writeValue(value);
+  }
+
+  private static byte[] write(ImmutableVersionTwo value) throws Exception {
+    return writeValue(value);
+  }
+
+  private static byte[] write(ImmutableOuterOne value) throws Exception {
+    return writeValue(value);
+  }
+
+  private static byte[] writeValue(Object value) throws Exception {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    DataOutputStream output = new DataOutputStream(bytes);
+    value.getClass().getMethod("writeTo", java.io.DataOutput.class).invoke(value, output);
+    output.flush();
+    return bytes.toByteArray();
+  }
+
+  private static ImmutableEverything readEverything(byte[] bytes) throws Exception {
+    return ImmutableEverything.readFrom(input(bytes));
+  }
+
+  private static DataInputStream input(byte[] bytes) {
+    return new DataInputStream(new ByteArrayInputStream(bytes));
+  }
+
+  private static boolean hasDeclaredMethod(Class<?> type, String name) {
+    for (Method method : type.getDeclaredMethods()) {
+      if (method.getName().equals(name)) return true;
+    }
+    return false;
+  }
+
+  private static String repeat(String value, int count) {
+    StringBuilder builder = new StringBuilder(value.length() * count);
+    for (int i = 0; i < count; i++) builder.append(value);
+    return builder.toString();
+  }
+}
