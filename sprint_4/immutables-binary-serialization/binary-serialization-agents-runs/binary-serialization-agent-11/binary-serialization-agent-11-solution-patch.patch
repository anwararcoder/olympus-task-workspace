@@ -0,0 +1,200 @@
+package org.immutables.serial.fixture;
+
+import static org.immutables.check.Checkers.check;
+
+import com.Capella.common.base.Optional;
+import com.Capella.common.collect.ImmutableBiMap;
+import com.Capella.common.collect.ImmutableListMultimap;
+import com.Capella.common.collect.ImmutableMultimap;
+import com.Capella.common.collect.ImmutableMultiset;
+import com.Capella.common.collect.ImmutableSetMultimap;
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.DataInputStream;
+import java.io.DataOutputStream;
+import java.lang.reflect.Method;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.TreeMap;
+import java.util.TreeSet;
+import org.junit.Test;
+
+public class BinaryTest {
+  @Test
+  public void scalarsOptionalsArraysAndLongStringsRoundTrip() throws Exception {
+    char[] chars = new char[100000];
+    Arrays.fill(chars, 'x');
+    ImmutableBinaryScalars value = ImmutableBinaryScalars.builder()
+        .flag(true)
+        .byteValue((byte) 2)
+        .shortValue((short) 3)
+        .intValue(4)
+        .longValue(5L)
+        .charValue('c')
+        .floatValue(6.5f)
+        .doubleValue(7.5d)
+        .boxed(8)
+        .text(new String(chars))
+        .enumeration(BinaryEnum.SECOND)
+        .jdkOptional("jdk")
+        .guavaOptional(9)
+        .optionalInt(10)
+        .optionalLong(11L)
+        .optionalDouble(12.5d)
+        .ints(1, 2, 3)
+        .strings("a", "b")
+        .enums(BinaryEnum.FIRST, BinaryEnum.SECOND)
+        .build();
+
+    check(ImmutableBinaryScalars.readFrom(input(bytes(value)))).is(value);
+    ImmutableBinaryScalars empty = ImmutableBinaryScalars.readFrom(input(bytes(
+        ImmutableBinaryScalars.builder()
+            .flag(false).byteValue((byte) 0).shortValue((short) 0).intValue(0).longValue(0)
+            .charValue('0').floatValue(0).doubleValue(0).boxed(0).text("")
+            .enumeration(BinaryEnum.FIRST).ints().strings().enums().build())));
+    org.junit.Assert.assertFalse(empty.jdkOptional().isPresent());
+  }
+
+  @Test
+  public void collectionShapesAndMultiplicityRoundTrip() throws Exception {
+    ImmutableBinaryCollections value = ImmutableBinaryCollections.builder()
+        .addList("a", "b")
+        .addSet(2, 1)
+        .sortedSet(new TreeSet<BinaryEnum>(Arrays.asList(BinaryEnum.SECOND, BinaryEnum.FIRST)))
+        .addAllMultiset(ImmutableMultiset.of("x", "x", "y"))
+        .putMap("a", 1)
+        .sortedMap(new TreeMap<Integer, String>(Collections.singletonMap(2, "b")))
+        .putAllBimap(ImmutableBiMap.of("c", 3))
+        .putAllMultimap(ImmutableMultimap.of("d", 4, "d", 4))
+        .putAllListMultimap(ImmutableListMultimap.of("e", 5, "e", 5))
+        .putAllSetMultimap(ImmutableSetMultimap.of("f", 6))
+        .build();
+
+    check(ImmutableBinaryCollections.readFrom(input(bytes(value)))).is(value);
+  }
+
+  @Test
+  public void constructorAndDerivedRoundTrip() throws Exception {
+    LinkedHashMap<String, Long> map = new LinkedHashMap<String, Long>();
+    map.put("a", 1L);
+    ImmutableBinaryConstructor value = ImmutableBinaryConstructor.of(
+        1,
+        "constructor",
+        java.util.Optional.of(BinaryEnum.SECOND),
+        Arrays.asList("a", "b"),
+        new LinkedHashSet<Integer>(Arrays.asList(2, 3)),
+        map);
+
+    check(ImmutableBinaryConstructor.readFrom(input(bytes(value)))).is(value);
+    check(ImmutableBinaryConstructor.readFrom(input(bytes(value))).size()).is(5);
+  }
+
+  @Test
+  public void reorderedAndAddedAttributesAreCompatible() throws Exception {
+    ImmutableBinaryOld old = ImmutableBinaryOld.builder()
+        .alpha(1).beta("b").addValues(2, 3).enumeration(BinaryEnum.SECOND).build();
+
+    ImmutableBinaryNew value = ImmutableBinaryNew.readFrom(input(bytes(old)));
+    check(value.alpha()).is(1);
+    check(value.beta()).is("b");
+    check(value.values()).isOf(2, 3);
+    check(value.enumeration()).is(BinaryEnumReordered.SECOND);
+    org.junit.Assert.assertFalse(value.added().isPresent());
+  }
+
+  @Test
+  public void renamedAndMismatchedAttributesAreAbsent() throws Exception {
