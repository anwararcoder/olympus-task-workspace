+package org.immutables.serial.fixture;
+
+import com.Capella.common.base.Optional;
+import com.Capella.common.collect.BiMap;
+import com.Capella.common.collect.ListMultimap;
+import com.Capella.common.collect.Multimap;
+import com.Capella.common.collect.Multiset;
+import com.Capella.common.collect.SetMultimap;
+import java.io.DataOutput;
+import java.io.IOException;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.SortedMap;
+import java.util.SortedSet;
+import org.immutables.value.Value;
+
+@Value.Immutable
+interface BinaryScalars {
+  boolean flag();
+  byte byteValue();
+  short shortValue();
+  int intValue();
+  long longValue();
+  char charValue();
+  float floatValue();
+  double doubleValue();
+  Integer boxed();
+  String text();
+  BinaryEnum enumeration();
+  java.util.Optional<String> jdkOptional();
+  Optional<Integer> guavaOptional();
+  java.util.OptionalInt optionalInt();
+  java.util.OptionalLong optionalLong();
+  java.util.OptionalDouble optionalDouble();
+  int[] ints();
+  String[] strings();
+  BinaryEnum[] enums();
+}
+
+enum BinaryEnum { FIRST, SECOND }
+enum BinaryEnumReordered { SECOND, FIRST }
+
+@Value.Immutable
+interface BinaryCollections {
+  List<String> list();
+  Set<Integer> set();
+  @Value.NaturalOrder SortedSet<BinaryEnum> sortedSet();
+  Multiset<String> multiset();
+  Map<String, Integer> map();
+  @Value.NaturalOrder SortedMap<Integer, String> sortedMap();
+  BiMap<String, Integer> bimap();
+  Multimap<String, Integer> multimap();
+  ListMultimap<String, Integer> listMultimap();
+  SetMultimap<String, Integer> setMultimap();
+}
+
+@Value.Immutable(builder = false)
+interface BinaryConstructor {
+  @Value.Parameter int number();
+  @Value.Parameter String text();
+  @Value.Parameter java.util.Optional<BinaryEnum> optional();
+  @Value.Parameter List<String> list();
+  @Value.Parameter Set<Integer> set();
+  @Value.Parameter Map<String, Long> map();
+
+  @Value.Derived
+  default int size() {
+    return list().size() + set().size() + map().size();
+  }
+}
+
+@Value.Immutable
+interface BinaryOld {
+  int alpha();
+  String beta();
+  List<Integer> values();
+  BinaryEnum enumeration();
+}
+
+@Value.Immutable
+interface BinaryNew {
+  String beta();
+  BinaryEnumReordered enumeration();
+  int alpha();
+  List<Integer> values();
+  java.util.Optional<String> added();
+}
+
+@Value.Immutable
+interface BinaryRenamed {
+  @Value.Default default int renamed() { return 7; }
+  String beta();
+  List<Integer> values();
+  BinaryEnumReordered enumeration();
+}
+
+@Value.Immutable
+interface BinaryMismatched {
+  @Value.Default default String alpha() { return "default"; }
+  String beta();
+  Set<Integer> values();
+  BinaryEnumReordered enumeration();
+}
+
+@Value.Immutable(builder = false)
+interface BinaryConstructorOld {
+  @Value.Parameter int number();
+  @Value.Parameter List<String> values();
+}
+
+@Value.Immutable(builder = false)
+interface BinaryConstructorNew {
+  @Value.Parameter List<String> values();
+  @Value.Parameter int number();
+  @Value.Parameter java.util.Optional<String> added();
+}
+
+@Value.Immutable
+interface BinaryNestedOld {
+  int value();
+  java.util.Optional<String> later();
+}
+
+@Value.Immutable
+interface BinaryOuterOld {
+  BinaryNestedOld nested();
+  String following();
+}
+
+@Value.Immutable
+interface BinaryNestedNew {
+  int value();
+  java.util.Optional<String> later();
+  java.util.OptionalLong added();
+}
+
+@Value.Immutable
+interface BinaryOuterNew {
+  BinaryNestedNew nested();
+  String following();
+}
+
+@Value.Immutable
+interface BinaryGenericNested<T> {
+  int value();
+}
+
+@Value.Immutable
+interface BinaryGenericOuter {
+  BinaryGenericNested<String> nested();
+}
+
+@Value.Immutable
+interface BinaryDerivedAuxiliary {
+  String value();
+  @Value.Auxiliary java.util.Optional<String> auxiliary();
+
+  @Value.Derived
+  default int length() {
+    return value().length();
+  }
+}
+
+@Value.Immutable
+interface BinaryUnsupported {
+  Object value();
+}
+
+@Value.Immutable
+interface BinaryRecursive {
+  BinaryRecursive next();
+}
+
+@Value.Immutable
+interface BinaryRequiredAuxiliary {
+  int value();
+  @Value.Auxiliary String requiredAuxiliary();
+}
+
+@Value.Immutable
+interface BinaryConflict {
+  int value();
+
+  default void writeTo(DataOutput output) throws IOException {
+    output.writeInt(value());
+  }
+}
