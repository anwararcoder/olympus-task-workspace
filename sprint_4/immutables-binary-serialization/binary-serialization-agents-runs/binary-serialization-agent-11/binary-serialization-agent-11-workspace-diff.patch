+        ImmutableBinaryScalars.builder()
+            .flag(false).byteValue((byte) 0).shortValue((short) 0).intValue(0).longValue(0)
+            .charValue('0').floatValue(0).doubleValue(0).boxed(0).text("")
+            .enumeration(BinaryEnum.FIRST).ints().strings().enums().build())));
+    org.junit.Assert.assertFalse(empty.jdkOptional().isPresent());
+  }
+
+  @Test
+  public void collectionShapesAndMultiplicityRoundTrip() throws Exception {
+    ImmutableBinaryCollections value = ImmutableBinaryCollections.builder()
+        .addList("a", "b")
+        .addSet(2, 1)
+        .sortedSet(new TreeSet<BinaryEnum>(Arrays.asList(BinaryEnum.SECOND, BinaryEnum.FIRST)))
+        .addAllMultiset(ImmutableMultiset.of("x", "x", "y"))
+        .putMap("a", 1)
+        .sortedMap(new TreeMap<Integer, String>(Collections.singletonMap(2, "b")))
+        .putAllBimap(ImmutableBiMap.of("c", 3))
+        .putAllMultimap(ImmutableMultimap.of("d", 4, "d", 4))
+        .putAllListMultimap(ImmutableListMultimap.of("e", 5, "e", 5))
+        .putAllSetMultimap(ImmutableSetMultimap.of("f", 6))
+        .build();
+
+    check(ImmutableBinaryCollections.readFrom(input(bytes(value)))).is(value);
+  }
+
+  @Test
+  public void constructorAndDerivedRoundTrip() throws Exception {
+    LinkedHashMap<String, Long> map = new LinkedHashMap<String, Long>();
+    map.put("a", 1L);
+    ImmutableBinaryConstructor value = ImmutableBinaryConstructor.of(
+        1,
+        "constructor",
+        java.util.Optional.of(BinaryEnum.SECOND),
+        Arrays.asList("a", "b"),
+        new LinkedHashSet<Integer>(Arrays.asList(2, 3)),
+        map);
+
+    check(ImmutableBinaryConstructor.readFrom(input(bytes(value)))).is(value);
+    check(ImmutableBinaryConstructor.readFrom(input(bytes(value))).size()).is(5);
+  }
+
+  @Test
+  public void reorderedAndAddedAttributesAreCompatible() throws Exception {
+    ImmutableBinaryOld old = ImmutableBinaryOld.builder()
+        .alpha(1).beta("b").addValues(2, 3).enumeration(BinaryEnum.SECOND).build();
+
+    ImmutableBinaryNew value = ImmutableBinaryNew.readFrom(input(bytes(old)));
+    check(value.alpha()).is(1);
+    check(value.beta()).is("b");
+    check(value.values()).isOf(2, 3);
+    check(value.enumeration()).is(BinaryEnumReordered.SECOND);
+    org.junit.Assert.assertFalse(value.added().isPresent());
+  }
+
+  @Test
+  public void renamedAndMismatchedAttributesAreAbsent() throws Exception {
+    ImmutableBinaryOld old = ImmutableBinaryOld.builder()
+        .alpha(1).beta("b").addValues(2, 3).enumeration(BinaryEnum.FIRST).build();
+
+    ImmutableBinaryRenamed renamed = ImmutableBinaryRenamed.readFrom(input(bytes(old)));
+    check(renamed.renamed()).is(7);
+    check(renamed.beta()).is("b");
+
+    ImmutableBinaryMismatched mismatched = ImmutableBinaryMismatched.readFrom(input(bytes(old)));
+    check(mismatched.alpha()).is("default");
+    check(mismatched.values()).isEmpty();
+    check(mismatched.beta()).is("b");
+  }
+
+  @Test
+  public void constructorVersionsUseNamesAndDefaults() throws Exception {
+    ImmutableBinaryConstructorOld old = ImmutableBinaryConstructorOld.of(5, Arrays.asList("a", "b"));
+
+    ImmutableBinaryConstructorNew value =
+        ImmutableBinaryConstructorNew.readFrom(input(bytes(old)));
+    check(value.number()).is(5);
+    check(value.values()).isOf("a", "b");
+    org.junit.Assert.assertFalse(value.added().isPresent());
+  }
+
+  @Test
+  public void nestedVersionsDoNotDesynchronizeOuterAttributes() throws Exception {
+    ImmutableBinaryOuterOld old = ImmutableBinaryOuterOld.builder()
+        .nested(ImmutableBinaryNestedOld.builder().value(3).later("x").build())
+        .following("after")
+        .build();
+
+    ImmutableBinaryOuterNew value = ImmutableBinaryOuterNew.readFrom(input(bytes(old)));
+    check(value.nested().value()).is(3);
+    check(value.nested().later().get()).is("x");
+    org.junit.Assert.assertFalse(value.nested().added().isPresent());
+    check(value.following()).is("after");
+  }
+
+  @Test
+  public void concreteGenericNestedValueRoundTrips() throws Exception {
+    ImmutableBinaryGenericOuter value = ImmutableBinaryGenericOuter.builder()
+        .nested(ImmutableBinaryGenericNested.<String>builder().value(4).build())
+        .build();
+
+    check(ImmutableBinaryGenericOuter.readFrom(input(bytes(value)))).is(value);
+  }
+
+  @Test
+  public void derivedAndOptionalAuxiliaryUseNormalConstruction() throws Exception {
+    ImmutableBinaryDerivedAuxiliary value = ImmutableBinaryDerivedAuxiliary.builder()
+        .value("four")
+        .auxiliary("not encoded")
+        .build();
+
+    ImmutableBinaryDerivedAuxiliary read =
+        ImmutableBinaryDerivedAuxiliary.readFrom(input(bytes(value)));
+    check(read.value()).is("four");
+    check(read.length()).is(4);
+    org.junit.Assert.assertFalse(read.auxiliary().isPresent());
+  }
+
+  @Test
+  public void unsupportedAndConflictingTypesReceiveNoPair() {
+    org.junit.Assert.assertFalse(hasMethod(ImmutableBinaryUnsupported.class, "writeTo"));
+    org.junit.Assert.assertFalse(hasMethod(ImmutableBinaryUnsupported.class, "readFrom"));
+    org.junit.Assert.assertTrue(hasMethod(ImmutableBinaryConflict.class, "writeTo"));
+    org.junit.Assert.assertFalse(hasMethod(ImmutableBinaryConflict.class, "readFrom"));
+    org.junit.Assert.assertFalse(hasMethod(ImmutableBinaryRecursive.class, "writeTo"));
+    org.junit.Assert.assertFalse(hasMethod(ImmutableBinaryRecursive.class, "readFrom"));
+    org.junit.Assert.assertFalse(hasMethod(ImmutableBinaryRequiredAuxiliary.class, "writeTo"));
+    org.junit.Assert.assertFalse(hasMethod(ImmutableBinaryRequiredAuxiliary.class, "readFrom"));
+  }
+
+  private static boolean hasMethod(Class<?> type, String name) {
+    for (Method method : type.getMethods()) {
+      if (method.getName().equals(name)) return true;
+    }
+    return false;
+  }
+
+  private static byte[] bytes(Object value) throws Exception {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    DataOutputStream output = new DataOutputStream(bytes);
+    value.getClass().getMethod("writeTo", java.io.DataOutput.class).invoke(value, output);
+    output.close();
+    return bytes.toByteArray();
+  }
+
+  private static DataInputStream input(byte[] bytes) {
+    return new DataInputStream(new ByteArrayInputStream(bytes));
+  }
+}
diff --git a/test.sh b/test.sh
