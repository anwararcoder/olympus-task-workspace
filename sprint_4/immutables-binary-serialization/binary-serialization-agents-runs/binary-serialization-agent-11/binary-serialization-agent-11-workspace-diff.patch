+package org.immutables.serial;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.DataInput;
+import java.io.DataInputStream;
+import java.io.DataOutput;
+import java.io.DataOutputStream;
+import java.io.EOFException;
+import java.io.IOException;
+import java.lang.reflect.Array;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Runtime support for compact binary forms generated by the value processor. */
+public final class Binary {
+  private static final int MAGIC = 0x494D4D42;
+  private static final int VERSION = 1;
+
+  public static final int LIST = 40;
+  public static final int SET = 41;
+  public static final int SORTED_SET = 42;
+  public static final int MULTISET = 43;
+  public static final int SORTED_MULTISET = 44;
+  public static final int MAP = 45;
+  public static final int SORTED_MAP = 46;
+  public static final int BIMAP = 47;
+  public static final int MULTIMAP = 48;
+  public static final int LIST_MULTIMAP = 49;
+  public static final int SET_MULTIMAP = 50;
+  public static final int ARRAY = 51;
+  public static final int OPTIONAL_JDK = 52;
+  public static final int OPTIONAL_GUAVA = 53;
+  public static final int OPTIONAL_INT = 54;
+  public static final int OPTIONAL_LONG = 55;
+  public static final int OPTIONAL_DOUBLE = 56;
+  public static final int NESTED = 60;
+
+  public static final Codec BOOLEAN = scalar(1, Scalar.BOOLEAN);
+  public static final Codec BYTE = scalar(2, Scalar.BYTE);
+  public static final Codec SHORT = scalar(3, Scalar.SHORT);
+  public static final Codec INT = scalar(4, Scalar.INT);
+  public static final Codec LONG = scalar(5, Scalar.LONG);
+  public static final Codec CHAR = scalar(6, Scalar.CHAR);
+  public static final Codec FLOAT = scalar(7, Scalar.FLOAT);
+  public static final Codec DOUBLE = scalar(8, Scalar.DOUBLE);
+  public static final Codec BOXED_BOOLEAN = nullableScalar(11, Scalar.BOOLEAN);
+  public static final Codec BOXED_BYTE = nullableScalar(12, Scalar.BYTE);
+  public static final Codec BOXED_SHORT = nullableScalar(13, Scalar.SHORT);
+  public static final Codec BOXED_INT = nullableScalar(14, Scalar.INT);
+  public static final Codec BOXED_LONG = nullableScalar(15, Scalar.LONG);
+  public static final Codec BOXED_CHAR = nullableScalar(16, Scalar.CHAR);
+  public static final Codec BOXED_FLOAT = nullableScalar(17, Scalar.FLOAT);
+  public static final Codec BOXED_DOUBLE = nullableScalar(18, Scalar.DOUBLE);
+  public static final Codec STRING = new Codec(20) {
+    @Override protected void writeValue(DataOutput output, Object value) throws IOException {
+      output.writeBoolean(value != null);
+      if (value != null) {
+        byte[] bytes = ((String) value).getBytes(StandardCharsets.UTF_8);
+        output.writeInt(bytes.length);
+        output.write(bytes);
+      }
+    }
+
+    @Override protected Object readValue(DataInput input) throws IOException {
+      if (!input.readBoolean()) return null;
+      int length = checkedLength(input.readInt());
+      byte[] bytes = new byte[length];
+      input.readFully(bytes);
+      return new String(bytes, StandardCharsets.UTF_8);
+    }
+  };
+
+  private Binary() {}
+
+  public abstract static class Codec {
+    private final int shape;
+
+    protected Codec(int shape) {
+      this.shape = shape;
+    }
+
+    public final int shape() {
+      return shape;
+    }
+
+    protected abstract void writeValue(DataOutput output, Object value) throws IOException;
+    protected abstract Object readValue(DataInput input) throws IOException;
+  }
+
+  public static final class Value {
+    private static final Value ABSENT = new Value(false, null);
+    private final boolean present;
+    private final Object value;
+
+    private Value(boolean present, Object value) {
+      this.present = present;
+      this.value = value;
+    }
+
+    public boolean isPresent() {
+      return present;
+    }
+
+    public Object get() {
+      if (!present) throw new IllegalStateException("Binary attribute is absent");
+      return value;
+    }
+  }
+
+  public static final class OptionalValue {
+    private static final OptionalValue ABSENT = new OptionalValue(false, null);
+    private final boolean present;
+    private final Object value;
+
+    private OptionalValue(boolean present, Object value) {
+      this.present = present;
+      this.value = value;
+    }
+
+    public boolean isPresent() {
+      return present;
+    }
+
+    public Object get() {
+      if (!present) throw new IllegalStateException("Optional value is absent");
+      return value;
+    }
+  }
+
+  public static OptionalValue present(Object value) {
+    return new OptionalValue(true, value);
+  }
+
+  public static OptionalValue absent() {
+    return OptionalValue.ABSENT;
+  }
+
+  public static final class Pair {
+    private final Object key;
+    private final Object value;
+
+    Pair(Object key, Object value) {
+      this.key = key;
+      this.value = value;
+    }
+
+    public Object key() {
+      return key;
+    }
+
+    public Object value() {
+      return value;
+    }
+  }
+
+  public static void begin(DataOutput output, int attributeCount) throws IOException {
+    output.writeInt(MAGIC);
+    output.writeInt(VERSION);
+    output.writeInt(attributeCount);
+  }
+
+  public static void write(DataOutput output, long id, Codec codec, Object value) throws IOException {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    DataOutputStream payload = new DataOutputStream(bytes);
+    codec.writeValue(payload, value);
+    payload.flush();
+    byte[] encoded = bytes.toByteArray();
+    output.writeLong(id);
+    output.writeInt(codec.shape());
+    output.writeInt(encoded.length);
+    output.write(encoded);
+  }
+
+  public static Input read(DataInput input) throws IOException {
+    if (input.readInt() != MAGIC) throw new IOException("Invalid immutable binary form");
+    if (input.readInt() != VERSION) throw new IOException("Unsupported immutable binary version");
+    int count = checkedLength(input.readInt());
+    Map<Long, Field> fields = new HashMap<Long, Field>();
+    for (int i = 0; i < count; i++) {
+      long id = input.readLong();
+      int shape = input.readInt();
+      int length = checkedLength(input.readInt());
+      byte[] bytes = new byte[length];
+      input.readFully(bytes);
+      Field previous = fields.put(id, new Field(shape, bytes));
+      if (previous != null) fields.put(id, Field.DUPLICATE);
+    }
+    return new Input(fields);
+  }
+
+  public static final class Input {
+    private final Map<Long, Field> fields;
+
+    Input(Map<Long, Field> fields) {
+      this.fields = fields;
+    }
+
+    public Value get(long id, Codec codec) throws IOException {
+      Field field = fields.get(id);
+      if (field == null || field == Field.DUPLICATE || field.shape != codec.shape()) {
+        return Value.ABSENT;
+      }
+      ByteArrayInputStream bytes = new ByteArrayInputStream(field.bytes);
+      DataInputStream payload = new DataInputStream(bytes);
+      Object value;
+      try {
+        value = codec.readValue(payload);
+      } catch (MismatchException ex) {
+        return Value.ABSENT;
+      } catch (EOFException ex) {
+        throw new IOException("Incomplete immutable binary attribute", ex);
+      }
+      if (bytes.available() != 0) throw new IOException("Invalid immutable binary attribute");
+      return new Value(true, value);
+    }
+  }
+
+  public static Codec enumCodec(final Class<? extends Enum> enumType) {
+    return new Codec(21) {
+      @Override protected void writeValue(DataOutput output, Object value) throws IOException {
+        STRING.writeValue(output, value == null ? null : ((Enum<?>) value).name());
+      }
+
+      @SuppressWarnings({"unchecked", "rawtypes"})
+      @Override protected Object readValue(DataInput input) throws IOException {
+        String name = (String) STRING.readValue(input);
+        if (name == null) return null;
+        try {
+          return Enum.valueOf((Class) enumType, name);
+        } catch (IllegalArgumentException ex) {
+          throw new MismatchException();
+        }
+      }
+    };
+  }
+
+  public static Codec optional(final int kind, final Codec element) {
+    return new Codec(combine(kind, element.shape())) {
+      @Override protected void writeValue(DataOutput output, Object value) throws IOException {
+        OptionalValue optional = (OptionalValue) value;
+        output.writeBoolean(optional.isPresent());
+        if (optional.isPresent()) element.writeValue(output, optional.get());
+      }
+
+      @Override protected Object readValue(DataInput input) throws IOException {
+        return input.readBoolean() ? present(element.readValue(input)) : absent();
+      }
+    };
+  }
+
+  public static Codec iterable(final int kind, final Codec element) {
+    return new Codec(combine(kind, element.shape())) {
+      @Override protected void writeValue(DataOutput output, Object value) throws IOException {
+        Iterable<?> iterable = (Iterable<?>) value;
+        List<Object> values = new ArrayList<Object>();
+        for (Object item : iterable) values.add(item);
+        output.writeInt(values.size());
+        for (Object item : values) element.writeValue(output, item);
+      }
+
+      @Override protected Object readValue(DataInput input) throws IOException {
+        int size = checkedLength(input.readInt());
+        List<Object> values = new ArrayList<Object>(size);
+        for (int i = 0; i < size; i++) values.add(element.readValue(input));
+        return values;
+      }
+    };
+  }
+
+  public static Codec mapping(final int kind, final Codec key, final Codec value) {
+    return new Codec(combine(kind, combine(key.shape(), value.shape()))) {
+      @Override protected void writeValue(DataOutput output, Object object) throws IOException {
+        Iterable<?> entries = (Iterable<?>) object;
+        List<Object> values = new ArrayList<Object>();
+        for (Object entry : entries) values.add(entry);
+        output.writeInt(values.size());
+        for (Object objectEntry : values) {
+          Map.Entry<?, ?> entry = (Map.Entry<?, ?>) objectEntry;
+          key.writeValue(output, entry.getKey());
+          value.writeValue(output, entry.getValue());
+        }
+      }
+
+      @Override protected Object readValue(DataInput input) throws IOException {
+        int size = checkedLength(input.readInt());
+        List<Pair> entries = new ArrayList<Pair>(size);
+        for (int i = 0; i < size; i++) {
+          entries.add(new Pair(key.readValue(input), value.readValue(input)));
+        }
+        return entries;
+      }
+    };
+  }
+
+  public static Codec array(final Codec element, final Class<?> componentType) {
+    return new Codec(combine(ARRAY, element.shape())) {
+      @Override protected void writeValue(DataOutput output, Object value) throws IOException {
+        int length = Array.getLength(value);
+        output.writeInt(length);
+        for (int i = 0; i < length; i++) element.writeValue(output, Array.get(value, i));
+      }
+
+      @Override protected Object readValue(DataInput input) throws IOException {
+        int length = checkedLength(input.readInt());
+        Object array = Array.newInstance(componentType, length);
+        for (int i = 0; i < length; i++) Array.set(array, i, element.readValue(input));
+        return array;
+      }
+    };
+  }
+
+  private enum Scalar { BOOLEAN, BYTE, SHORT, INT, LONG, CHAR, FLOAT, DOUBLE }
+
+  private static Codec scalar(int shape, final Scalar scalar) {
+    return new Codec(shape) {
+      @Override protected void writeValue(DataOutput output, Object value) throws IOException {
+        writeScalar(output, scalar, value);
+      }
+
+      @Override protected Object readValue(DataInput input) throws IOException {
+        return readScalar(input, scalar);
+      }
+    };
+  }
+
+  private static Codec nullableScalar(int shape, final Scalar scalar) {
+    return new Codec(shape) {
+      @Override protected void writeValue(DataOutput output, Object value) throws IOException {
+        output.writeBoolean(value != null);
+        if (value != null) writeScalar(output, scalar, value);
+      }
+
+      @Override protected Object readValue(DataInput input) throws IOException {
+        return input.readBoolean() ? readScalar(input, scalar) : null;
+      }
+    };
+  }
+
+  private static void writeScalar(DataOutput output, Scalar scalar, Object value) throws IOException {
+    switch (scalar) {
+    case BOOLEAN: output.writeBoolean((Boolean) value); break;
+    case BYTE: output.writeByte((Byte) value); break;
+    case SHORT: output.writeShort((Short) value); break;
+    case INT: output.writeInt((Integer) value); break;
+    case LONG: output.writeLong((Long) value); break;
+    case CHAR: output.writeChar((Character) value); break;
+    case FLOAT: output.writeFloat((Float) value); break;
+    case DOUBLE: output.writeDouble((Double) value); break;
+    default: throw new AssertionError(scalar);
+    }
+  }
+
+  private static Object readScalar(DataInput input, Scalar scalar) throws IOException {
+    switch (scalar) {
+    case BOOLEAN: return input.readBoolean();
+    case BYTE: return input.readByte();
+    case SHORT: return input.readShort();
+    case INT: return input.readInt();
+    case LONG: return input.readLong();
+    case CHAR: return input.readChar();
+    case FLOAT: return input.readFloat();
+    case DOUBLE: return input.readDouble();
+    default: throw new AssertionError(scalar);
+    }
+  }
+
+  private static int combine(int left, int right) {
+    return left * 1000003 + right;
+  }
+
+  private static int checkedLength(int length) throws IOException {
+    if (length < 0) throw new IOException("Negative immutable binary length");
+    return length;
+  }
+
+  private static final class MismatchException extends IOException {
+    private static final long serialVersionUID = 1L;
+  }
+
+  private static final class Field {
+    static final Field DUPLICATE = new Field(0, new byte[0]);
+    final int shape;
+    final byte[] bytes;
+
+    Field(int shape, byte[] bytes) {
+      this.shape = shape;
+      this.bytes = bytes;
+    }
+  }
+}
