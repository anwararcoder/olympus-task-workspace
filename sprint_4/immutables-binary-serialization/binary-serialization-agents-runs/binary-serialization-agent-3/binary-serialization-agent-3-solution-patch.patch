+  private boolean hasDistinctBinaryAttributes() {
+    Set<String> fingerprints = new LinkedHashSet<>();
+    for (ValueAttribute attribute : getBinaryAttributes()) {
+      if (!fingerprints.add(binaryFingerprint(attribute.name()))) {
+        return false;
