+    case LIST_MULTIMAP:
+    case SET_MULTIMAP:
+      if (arguments.size() != 2) return null;
+      String keyCodec = binaryScalarCodec(arguments.get(0));
+      String valueCodec = binaryScalarCodec(arguments.get(1));
+      if (keyCodec == null || valueCodec == null) return null;
+      String mapFactory;
+      switch (typeKind()) {
+      case MAP:
+      case ENUM_MAP: mapFactory = "mapCodec"; break;
+      case SORTED_MAP: mapFactory = "sortedMapCodec"; break;
+      case BI_MAP: mapFactory = "bimapCodec"; break;
+      case MULTIMAP: mapFactory = "multimapCodec"; break;
+      case LIST_MULTIMAP: mapFactory = "listMultimapCodec"; break;
+      case SET_MULTIMAP: mapFactory = "setMultimapCodec"; break;
+      default: throw new AssertionError(typeKind());
+      }
+      return "org.immutables.serial.Binary." + mapFactory + "(" + keyCodec + ", "
+          + valueCodec + ")";
+    case REGULAR:
+      ValueType nested = binaryValueType();
+      return nested != null
+          ? "org.immutables.serial.Binary.nestedCodec(\"" + nested.getBinaryImplementationName() + "\")"
+          : null;
+    default:
+      return null;
+    }
+  }
+
+  private @Nullable String binaryScalarCodec(TypeMirror type) {
+    switch (type.getKind()) {
+    case BOOLEAN:
+      return "org.immutables.serial.Binary.BOOLEAN_CODEC";
+    case BYTE:
+      return "org.immutables.serial.Binary.BYTE_CODEC";
+    case SHORT:
+      return "org.immutables.serial.Binary.SHORT_CODEC";
+    case INT:
+      return "org.immutables.serial.Binary.INT_CODEC";
+    case LONG:
+      return "org.immutables.serial.Binary.LONG_CODEC";
+    case CHAR:
+      return "org.immutables.serial.Binary.CHAR_CODEC";
+    case FLOAT:
+      return "org.immutables.serial.Binary.FLOAT_CODEC";
+    case DOUBLE:
+      return "org.immutables.serial.Binary.DOUBLE_CODEC";
+    case DECLARED:
+      Element declaredElement = ((DeclaredType) type).asElement();
+      String name = ((TypeElement) declaredElement).getQualifiedName().toString();
+      if (name.equals(Boolean.class.getName())) return "org.immutables.serial.Binary.BOOLEAN_CODEC";
+      if (name.equals(Byte.class.getName())) return "org.immutables.serial.Binary.BYTE_CODEC";
+      if (name.equals(Short.class.getName())) return "org.immutables.serial.Binary.SHORT_CODEC";
+      if (name.equals(Integer.class.getName())) return "org.immutables.serial.Binary.INT_CODEC";
+      if (name.equals(Long.class.getName())) return "org.immutables.serial.Binary.LONG_CODEC";
+      if (name.equals(Character.class.getName())) return "org.immutables.serial.Binary.CHAR_CODEC";
+      if (name.equals(Float.class.getName())) return "org.immutables.serial.Binary.FLOAT_CODEC";
+      if (name.equals(Double.class.getName())) return "org.immutables.serial.Binary.DOUBLE_CODEC";
+      if (name.equals(String.class.getName())) return "org.immutables.serial.Binary.STRING_CODEC";
+      if (declaredElement.getKind() == ElementKind.ENUM) {
+        return "org.immutables.serial.Binary.enumCodec(" + type.toString() + ".class)";
+      }
+      return null;
+    default:
+      return null;
+    }
+  }
+
+  private boolean binaryValueTypeInitialized;
+  private @Nullable ValueType binaryValueType;
+
+  public @Nullable ValueType binaryValueType() {
+    if (!binaryValueTypeInitialized) {
+      binaryValueTypeInitialized = true;
+      ensureTypeIntrospected();
+      if (containedTypeElement != null) {
+        Environment environment = protoclass().environment();
+        for (Protoclass p : environment.protoclassesFrom(Collections.singleton(containedTypeElement))) {
+          if (p.kind().isValue()) {
+            binaryValueType = environment.composeValue(p);
+          }
+          break;
+        }
+      }
+    }
+    return binaryValueType;
+  }
+
   public boolean isEncoding() {
     return typeKind == AttributeTypeKind.ENCODING;
   }
