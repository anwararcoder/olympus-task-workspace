+      if (!isUseBuilder() && isUseConstructor()) {
+        Set<ValueAttribute> constructor = getConstructorArguments();
+        for (ValueAttribute attribute : getBinaryAttributes()) {
+          if (!constructor.contains(attribute) || attribute.isGenerateDefault) {
+            return false;
