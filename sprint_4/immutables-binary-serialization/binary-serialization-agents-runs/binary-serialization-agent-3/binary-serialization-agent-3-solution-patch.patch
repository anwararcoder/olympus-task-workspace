+    TypeElement dataInput = constitution.protoclass().processing().getElementUtils()
+        .getTypeElement("java.io.DataInput");
+    TypeElement dataOutput = constitution.protoclass().processing().getElementUtils()
+        .getTypeElement("java.io.DataOutput");
+    for (ExecutableElement method : ElementFilter.methodsIn(
+        constitution.protoclass().processing().getElementUtils()
+            .getAllMembers(CachingElements.getDelegate((TypeElement) element)))) {
+      if (method.getParameters().size() != 1) {
+        continue;
+      }
+      TypeMirror parameter = method.getParameters().get(0).asType();
+      if (method.getSimpleName().contentEquals("writeTo")
+          && sameErasure(parameter, dataOutput.asType())) {
+        return true;
+      }
+      if (method.getSimpleName().contentEquals("readFrom")
+          && sameErasure(parameter, dataInput.asType())) {
