+  private boolean binaryEligible(Set<ValueType> visiting) {
+    if (!binaryRuntimeAvailable()
+        || !kind().isValue()
+        || (!isUseBuilder() && !isUseConstructor())
+        || hasBinaryMethodConflict()
+        || !visiting.add(this)) {
+      return false;
+    }
+    try {
+      for (ValueAttribute attribute : getSettableAttributes()) {
+        if (attribute.isAuxiliary()) {
