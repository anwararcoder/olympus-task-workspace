+
+/** Runtime support for compact binary forms generated by the value processor. */
+public final class Binary {
+  private static final int MAGIC = 0x494D4231;
+  private static final int FINGERPRINT_SIZE = 32;
+  private static final int MAX_ATTRIBUTES = 1 << 20;
+  private static final int MAX_BLOCK_SIZE = 1 << 28;
+
+  private static final int BOOLEAN = 1;
+  private static final int BYTE = 2;
+  private static final int SHORT = 3;
+  private static final int INT = 4;
+  private static final int LONG = 5;
+  private static final int CHAR = 6;
+  private static final int FLOAT = 7;
+  private static final int DOUBLE = 8;
+  private static final int STRING = 9;
+  private static final int ENUM = 10;
+  private static final int ARRAY = 11;
+  private static final int LIST = 12;
+  private static final int SET = 13;
+  private static final int SORTED_SET = 14;
+  private static final int MULTISET = 15;
+  private static final int SORTED_MULTISET = 16;
+  private static final int MAP = 17;
+  private static final int SORTED_MAP = 18;
+  private static final int BIMAP = 19;
+  private static final int MULTIMAP = 20;
+  private static final int LIST_MULTIMAP = 21;
+  private static final int SET_MULTIMAP = 22;
+  private static final int OPTIONAL_JDK = 23;
+  private static final int OPTIONAL_GUAVA = 24;
+  private static final int OPTIONAL_INT = 25;
+  private static final int OPTIONAL_LONG = 26;
+  private static final int OPTIONAL_DOUBLE = 27;
+  private static final int NESTED = 28;
+
+  public static final Codec BOOLEAN_CODEC = scalar(BOOLEAN);
+  public static final Codec BYTE_CODEC = scalar(BYTE);
+  public static final Codec SHORT_CODEC = scalar(SHORT);
+  public static final Codec INT_CODEC = scalar(INT);
+  public static final Codec LONG_CODEC = scalar(LONG);
+  public static final Codec CHAR_CODEC = scalar(CHAR);
+  public static final Codec FLOAT_CODEC = scalar(FLOAT);
+  public static final Codec DOUBLE_CODEC = scalar(DOUBLE);
+  public static final Codec STRING_CODEC = scalar(STRING);
+  public static final Codec OPTIONAL_INT_CODEC = specializedOptional(OPTIONAL_INT);
+  public static final Codec OPTIONAL_LONG_CODEC = specializedOptional(OPTIONAL_LONG);
+  public static final Codec OPTIONAL_DOUBLE_CODEC = specializedOptional(OPTIONAL_DOUBLE);
+
+  private Binary() {}
+
+  public abstract static class Codec {
+    private final byte[] shape;
+
+    Codec(byte[] shape) {
+      this.shape = shape;
+    }
+
+    final void writeNullable(DataOutput output, Object value) throws IOException {
+      output.writeBoolean(value != null);
+      if (value != null) {
+        writeValue(output, value);
+      }
+    }
+
+    final Object readNullable(DataInput input) throws IOException {
+      return input.readBoolean() ? readValue(input) : null;
+    }
+
+    abstract void writeValue(DataOutput output, Object value) throws IOException;
+
+    abstract Object readValue(DataInput input) throws IOException;
+
+    public Object defaultValue() throws IOException {
+      return null;
+    }
+  }
+
+  public static final class Writer {
+    private final DataOutput output;
+
+    private Writer(DataOutput output, int attributes) throws IOException {
+      if (attributes < 0 || attributes > MAX_ATTRIBUTES) {
+        throw new IOException("Invalid binary attribute count: " + attributes);
+      }
+      this.output = output;
+      output.writeInt(MAGIC);
+      output.writeInt(attributes);
+    }
+
+    public void write(String attribute, Codec codec, Object value) throws IOException {
+      ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+      DataOutputStream payload = new DataOutputStream(bytes);
+      codec.writeNullable(payload, value);
+      payload.flush();
+      byte[] encoded = bytes.toByteArray();
+
+      output.write(fingerprint(attribute));
+      output.writeInt(codec.shape.length);
+      output.write(codec.shape);
+      output.writeInt(encoded.length);
+      output.write(encoded);
+    }
+  }
+
+  public static final class Reader {
+    private final Map<Fingerprint, Entry> entries = new LinkedHashMap<>();
+
+    private Reader(DataInput input) throws IOException {
+      if (input.readInt() != MAGIC) {
+        throw new IOException("Invalid immutable binary form");
+      }
+      int attributes = checkedLength(input.readInt(), MAX_ATTRIBUTES, "attribute count");
+      for (int i = 0; i < attributes; i++) {
+        byte[] fingerprint = new byte[FINGERPRINT_SIZE];
+        input.readFully(fingerprint);
+        byte[] shape = new byte[checkedLength(input.readInt(), MAX_BLOCK_SIZE, "shape")];
+        input.readFully(shape);
+        byte[] payload = new byte[checkedLength(input.readInt(), MAX_BLOCK_SIZE, "payload")];
+        input.readFully(payload);
+        Fingerprint key = new Fingerprint(fingerprint);
+        if (entries.put(key, new Entry(shape, payload)) != null) {
+          throw new IOException("Duplicate immutable binary attribute");
+        }
+      }
+    }
+
+    public Value read(String attribute, Codec codec) throws IOException {
+      Entry entry = entries.get(new Fingerprint(fingerprint(attribute)));
+      if (entry == null || !Arrays.equals(entry.shape, codec.shape)) {
+        return Value.ABSENT;
+      }
+      DataInputStream payload = new DataInputStream(new ByteArrayInputStream(entry.payload));
+      Object value = codec.readNullable(payload);
+      if (payload.read() != -1) {
+        throw new IOException("Unread immutable binary attribute data");
+      }
+      return new Value(true, value);
+    }
+  }
+
+  public static final class Value {
+    private static final Value ABSENT = new Value(false, null);
+    private final boolean present;
+    private final Object value;
+
+    private Value(boolean present, Object value) {
+      this.present = present;
+      this.value = value;
+    }
+
+    public boolean isPresent() {
+      return present;
+    }
+
+    public Object get() {
+      if (!present) {
+        throw new IllegalStateException("Binary value is absent");
+      }
+      return value;
+    }
+
+    public Object required(String attribute) throws IOException {
+      if (!present) {
+        throw new EOFException("Missing required immutable attribute: " + attribute);
+      }
+      return value;
+    }
+  }
+
+  public static Writer writer(DataOutput output, int attributes) throws IOException {
+    return new Writer(output, attributes);
+  }
+
+  public static Reader reader(DataInput input) throws IOException {
+    return new Reader(input);
+  }
+
+  public static Codec enumCodec(final Class<?> enumType) {
+    return new Codec(shape(ENUM)) {
+      @Override void writeValue(DataOutput output, Object value) throws IOException {
+        writeString(output, ((Enum<?>) value).name());
+      }
+
+      @SuppressWarnings({"unchecked", "rawtypes"})
+      @Override Object readValue(DataInput input) throws IOException {
+        String name = readString(input);
+        try {
+          return Enum.valueOf((Class) enumType, name);
+        } catch (IllegalArgumentException ex) {
+          throw new IOException("Unknown enum constant " + name, ex);
+        }
+      }
+
+    };
+  }
+
+  public static Codec arrayCodec(final Codec element, final Class<?> componentType) {
+    return new Codec(shape(ARRAY, element)) {
+      @Override void writeValue(DataOutput output, Object value) throws IOException {
+        int length = Array.getLength(value);
+        output.writeInt(length);
+        for (int i = 0; i < length; i++) {
+          element.writeNullable(output, Array.get(value, i));
+        }
+      }
+
+      @Override Object readValue(DataInput input) throws IOException {
+        int length = checkedLength(input.readInt(), MAX_BLOCK_SIZE, "array");
+        Object array = Array.newInstance(componentType, length);
+        for (int i = 0; i < length; i++) {
+          Array.set(array, i, element.readNullable(input));
+        }
+        return array;
+      }
+
+      @Override public Object defaultValue() {
+        return Array.newInstance(componentType, 0);
+      }
+    };
+  }
+
+  public static Codec listCodec(Codec element) {
+    return collectionCodec(LIST, element);
+  }
+
+  public static Codec setCodec(Codec element) {
+    return collectionCodec(SET, element);
+  }
+
+  public static Codec sortedSetCodec(Codec element) {
+    return collectionCodec(SORTED_SET, element);
+  }
+
+  public static Codec multisetCodec(Codec element) {
+    return multisetCodec(MULTISET, element);
+  }
+
+  public static Codec sortedMultisetCodec(Codec element) {
+    return multisetCodec(SORTED_MULTISET, element);
+  }
+
+  public static Codec mapCodec(Codec key, Codec value) {
+    return mapCodec(MAP, key, value);
+  }
+
+  public static Codec sortedMapCodec(Codec key, Codec value) {
+    return mapCodec(SORTED_MAP, key, value);
+  }
+
+  public static Codec bimapCodec(Codec key, Codec value) {
+    return mapCodec(BIMAP, key, value);
+  }
+
+  public static Codec multimapCodec(Codec key, Codec value) {
+    return multimapCodec(MULTIMAP, key, value);
+  }
+
+  public static Codec listMultimapCodec(Codec key, Codec value) {
+    return multimapCodec(LIST_MULTIMAP, key, value);
+  }
+
+  public static Codec setMultimapCodec(Codec key, Codec value) {
+    return multimapCodec(SET_MULTIMAP, key, value);
+  }
+
+  public static Codec jdkOptionalCodec(final Codec element) {
+    return optionalCodec(OPTIONAL_JDK, element);
+  }
+
+  public static Codec guavaOptionalCodec(final Codec element) {
+    return optionalCodec(OPTIONAL_GUAVA, element);
+  }
+
+  public static Codec nestedCodec(final String implementationClass) {
+    return new Codec(shape(NESTED)) {
+      @Override void writeValue(DataOutput output, Object value) throws IOException {
+        invoke(value.getClass(), value, "writeTo", new Class<?>[] {DataOutput.class}, output);
+      }
+
+      @Override Object readValue(DataInput input) throws IOException {
+        try {
+          Class<?> implementation = Class.forName(implementationClass, true,
+              Thread.currentThread().getContextClassLoader());
+          return invoke(implementation, null, "readFrom", new Class<?>[] {DataInput.class}, input);
+        } catch (ClassNotFoundException ex) {
+          throw new IOException("Cannot load nested immutable " + implementationClass, ex);
+        }
+      }
+    };
+  }
+
+  private static Codec scalar(final int kind) {
+    return new Codec(shape(kind)) {
+      @Override void writeValue(DataOutput output, Object value) throws IOException {
+        switch (kind) {
+        case BOOLEAN: output.writeBoolean((Boolean) value); return;
+        case BYTE: output.writeByte((Byte) value); return;
+        case SHORT: output.writeShort((Short) value); return;
+        case INT: output.writeInt((Integer) value); return;
+        case LONG: output.writeLong((Long) value); return;
+        case CHAR: output.writeChar((Character) value); return;
+        case FLOAT: output.writeFloat((Float) value); return;
+        case DOUBLE: output.writeDouble((Double) value); return;
+        case STRING: writeString(output, (String) value); return;
+        default: throw new AssertionError(kind);
+        }
+      }
+
+      @Override Object readValue(DataInput input) throws IOException {
+        switch (kind) {
+        case BOOLEAN: return input.readBoolean();
+        case BYTE: return input.readByte();
+        case SHORT: return input.readShort();
+        case INT: return input.readInt();
+        case LONG: return input.readLong();
+        case CHAR: return input.readChar();
+        case FLOAT: return input.readFloat();
+        case DOUBLE: return input.readDouble();
+        case STRING: return readString(input);
+        default: throw new AssertionError(kind);
+        }
+      }
+
+      @Override public Object defaultValue() {
+        switch (kind) {
+        case BOOLEAN: return false;
+        case BYTE: return (byte) 0;
+        case SHORT: return (short) 0;
+        case INT: return 0;
+        case LONG: return 0L;
+        case CHAR: return (char) 0;
+        case FLOAT: return 0.0f;
+        case DOUBLE: return 0.0d;
+        default: return null;
+        }
+      }
+    };
+  }
+
+  private static Codec specializedOptional(final int kind) {
+    return new Codec(shape(kind)) {
+      @Override void writeValue(DataOutput output, Object value) throws IOException {
+        boolean present = (Boolean) invokeUnchecked(value, "isPresent");
+        output.writeBoolean(present);
+        if (present) {
+          if (kind == OPTIONAL_INT) output.writeInt((Integer) invokeUnchecked(value, "getAsInt"));
+          if (kind == OPTIONAL_LONG) output.writeLong((Long) invokeUnchecked(value, "getAsLong"));
+          if (kind == OPTIONAL_DOUBLE) output.writeDouble((Double) invokeUnchecked(value, "getAsDouble"));
+        }
+      }
+
+      @Override Object readValue(DataInput input) throws IOException {
+        boolean present = input.readBoolean();
+        String className;
+        Class<?> parameter;
+        Object value;
+        if (kind == OPTIONAL_INT) {
+          className = "java.util.OptionalInt";
+          parameter = int.class;
+          value = present ? input.readInt() : null;
+        } else if (kind == OPTIONAL_LONG) {
+          className = "java.util.OptionalLong";
+          parameter = long.class;
+          value = present ? input.readLong() : null;
+        } else {
+          className = "java.util.OptionalDouble";
+          parameter = double.class;
+          value = present ? input.readDouble() : null;
+        }
+        try {
+          Class<?> optional = Class.forName(className);
+          return present
+              ? invoke(optional, null, "of", new Class<?>[] {parameter}, value)
+              : invoke(optional, null, "empty", new Class<?>[0]);
+        } catch (ClassNotFoundException ex) {
+          throw new IOException(ex);
+        }
+      }
+
+      @Override public Object defaultValue() throws IOException {
+        try {
+          Class<?> optional = Class.forName(kind == OPTIONAL_INT
+              ? "java.util.OptionalInt"
+              : kind == OPTIONAL_LONG ? "java.util.OptionalLong" : "java.util.OptionalDouble");
+          return invoke(optional, null, "empty", new Class<?>[0]);
+        } catch (ClassNotFoundException ex) {
+          throw new IOException(ex);
+        }
+      }
+    };
+  }
+
+  private static Codec optionalCodec(final int kind, final Codec element) {
+    return new Codec(shape(kind, element)) {
+      @Override void writeValue(DataOutput output, Object value) throws IOException {
+        boolean present = (Boolean) invokeUnchecked(value, "isPresent");
+        output.writeBoolean(present);
+        if (present) {
+          element.writeNullable(output, invokeUnchecked(value, "get"));
+        }
+      }
+
+      @Override Object readValue(DataInput input) throws IOException {
+        boolean present = input.readBoolean();
+        Object value = present ? element.readNullable(input) : null;
+        try {
+          Class<?> optional = Class.forName(
+              kind == OPTIONAL_JDK ? "java.util.Optional" : "com.Capella.common.base.Optional");
+          return present
+              ? invoke(optional, null, "of", new Class<?>[] {Object.class}, value)
+              : invoke(optional, null, kind == OPTIONAL_JDK ? "empty" : "absent", new Class<?>[0]);
+        } catch (ClassNotFoundException ex) {
+          throw new IOException(ex);
+        }
+      }
+
+      @Override public Object defaultValue() throws IOException {
+        try {
+          Class<?> optional = Class.forName(
+              kind == OPTIONAL_JDK ? "java.util.Optional" : "com.Capella.common.base.Optional");
+          return invoke(optional, null, kind == OPTIONAL_JDK ? "empty" : "absent",
+              new Class<?>[0]);
+        } catch (ClassNotFoundException ex) {
+          throw new IOException(ex);
+        }
+      }
+    };
+  }
+
+  private static Codec collectionCodec(final int kind, final Codec element) {
+    return new Codec(shape(kind, element)) {
+      @Override void writeValue(DataOutput output, Object value) throws IOException {
+        Collection<?> collection = (Collection<?>) value;
+        output.writeInt(collection.size());
+        for (Object item : collection) {
+          element.writeNullable(output, item);
+        }
+      }
+
+      @Override Object readValue(DataInput input) throws IOException {
+        int size = checkedLength(input.readInt(), MAX_BLOCK_SIZE, "collection");
+        Collection<Object> collection;
+        if (kind == SET) {
+          collection = new LinkedHashSet<>(capacity(size));
+        } else if (kind == SORTED_SET) {
+          collection = new TreeSet<>();
+        } else {
+          collection = new ArrayList<>(size);
+        }
+        for (int i = 0; i < size; i++) {
+          collection.add(element.readNullable(input));
+        }
+        return collection;
+      }
+
+      @Override public Object defaultValue() {
+        if (kind == SET) return new LinkedHashSet<Object>();
+        if (kind == SORTED_SET) return new TreeSet<Object>();
+        return new ArrayList<Object>();
+      }
+    };
+  }
+
+  private static Codec multisetCodec(final int kind, final Codec element) {
+    return new Codec(shape(kind, element)) {
+      @Override void writeValue(DataOutput output, Object value) throws IOException {
+        Iterable<?> entries = (Iterable<?>) invokeUnchecked(value, "entrySet");
+        int size = sizeOf(entries);
+        output.writeInt(size);
+        for (Object entry : entries) {
+          element.writeNullable(output, invokeUnchecked(entry, "getElement"));
+          output.writeInt((Integer) invokeUnchecked(entry, "getCount"));
+        }
+      }
+
+      @Override Object readValue(DataInput input) throws IOException {
+        int size = checkedLength(input.readInt(), MAX_BLOCK_SIZE, "multiset");
+        Object builder = staticInvoke(
+            kind == SORTED_MULTISET
+                ? "com.Capella.common.collect.ImmutableSortedMultiset"
+                : "com.Capella.common.collect.ImmutableMultiset",
+            kind == SORTED_MULTISET ? "naturalOrder" : "builder");
+        for (int i = 0; i < size; i++) {
+          Object item = element.readNullable(input);
+          int count = checkedLength(input.readInt(), MAX_BLOCK_SIZE, "multiset count");
+          invokeCompatible(builder, "addCopies", item, count);
+        }
+        return invokeCompatible(builder, "build");
+      }
+
+      @Override public Object defaultValue() throws IOException {
+        Object builder = staticInvoke(
+            kind == SORTED_MULTISET
+                ? "com.Capella.common.collect.ImmutableSortedMultiset"
+                : "com.Capella.common.collect.ImmutableMultiset",
+            kind == SORTED_MULTISET ? "naturalOrder" : "builder");
+        return invokeCompatible(builder, "build");
+      }
+    };
+  }
+
+  private static Codec mapCodec(final int kind, final Codec key, final Codec value) {
+    return new Codec(shape(kind, key, value)) {
+      @Override void writeValue(DataOutput output, Object object) throws IOException {
+        Map<?, ?> map = (Map<?, ?>) object;
+        output.writeInt(map.size());
+        for (Map.Entry<?, ?> entry : map.entrySet()) {
+          key.writeNullable(output, entry.getKey());
+          value.writeNullable(output, entry.getValue());
+        }
+      }
+
+      @Override Object readValue(DataInput input) throws IOException {
+        int size = checkedLength(input.readInt(), MAX_BLOCK_SIZE, "map");
+        Map<Object, Object> map = kind == SORTED_MAP
+            ? new TreeMap<Object, Object>()
+            : new LinkedHashMap<Object, Object>(capacity(size));
+        for (int i = 0; i < size; i++) {
+          map.put(key.readNullable(input), value.readNullable(input));
+        }
+        if (kind == BIMAP) {
+          return staticInvoke("com.Capella.common.collect.ImmutableBiMap", "copyOf", map);
+        }
+        return map;
+      }
+
+      @Override public Object defaultValue() throws IOException {
+        if (kind == BIMAP) {
+          return staticInvoke("com.Capella.common.collect.ImmutableBiMap", "of");
+        }
+        return kind == SORTED_MAP
+            ? new TreeMap<Object, Object>()
+            : new LinkedHashMap<Object, Object>();
+      }
+    };
+  }
+
+  private static Codec multimapCodec(final int kind, final Codec key, final Codec value) {
+    return new Codec(shape(kind, key, value)) {
+      @Override void writeValue(DataOutput output, Object object) throws IOException {
+        Iterable<?> entries = (Iterable<?>) invokeUnchecked(object, "entries");
+        int size = sizeOf(entries);
+        output.writeInt(size);
+        for (Object objectEntry : entries) {
+          Map.Entry<?, ?> entry = (Map.Entry<?, ?>) objectEntry;
+          key.writeNullable(output, entry.getKey());
+          value.writeNullable(output, entry.getValue());
+        }
+      }
+
+      @Override Object readValue(DataInput input) throws IOException {
+        int size = checkedLength(input.readInt(), MAX_BLOCK_SIZE, "multimap");
+        String implementation = kind == LIST_MULTIMAP
+            ? "com.Capella.common.collect.ImmutableListMultimap"
+            : kind == SET_MULTIMAP
+                ? "com.Capella.common.collect.ImmutableSetMultimap"
+                : "com.Capella.common.collect.ImmutableMultimap";
+        Object builder = staticInvoke(implementation, "builder");
+        for (int i = 0; i < size; i++) {
+          invokeCompatible(builder, "put", key.readNullable(input), value.readNullable(input));
+        }
+        return invokeCompatible(builder, "build");
+      }
+
+      @Override public Object defaultValue() throws IOException {
+        String implementation = kind == LIST_MULTIMAP
+            ? "com.Capella.common.collect.ImmutableListMultimap"
+            : kind == SET_MULTIMAP
+                ? "com.Capella.common.collect.ImmutableSetMultimap"
+                : "com.Capella.common.collect.ImmutableMultimap";
+        return staticInvoke(implementation, "of");
+      }
+    };
+  }
+
+  private static byte[] shape(int kind, Codec... children) {
+    try {
+      ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+      DataOutputStream output = new DataOutputStream(bytes);
+      output.writeByte(kind);
+      for (Codec child : children) {
+        output.writeInt(child.shape.length);
+        output.write(child.shape);
+      }
+      output.flush();
+      return bytes.toByteArray();
+    } catch (IOException ex) {
+      throw new AssertionError(ex);
+    }
+  }
+
+  private static byte[] fingerprint(String attribute) throws IOException {
+    try {
+      return MessageDigest.getInstance("SHA-256").digest(attribute.getBytes(StandardCharsets.UTF_8));
+    } catch (NoSuchAlgorithmException ex) {
+      throw new IOException("SHA-256 is unavailable", ex);
+    }
+  }
+
+  private static void writeString(DataOutput output, String value) throws IOException {
+    byte[] bytes = value.getBytes(StandardCharsets.UTF_8);
+    output.writeInt(bytes.length);
+    output.write(bytes);
+  }
+
+  private static String readString(DataInput input) throws IOException {
+    byte[] bytes = new byte[checkedLength(input.readInt(), MAX_BLOCK_SIZE, "string")];
+    input.readFully(bytes);
+    return new String(bytes, StandardCharsets.UTF_8);
+  }
+
+  private static int checkedLength(int value, int maximum, String description) throws IOException {
+    if (value < 0 || value > maximum) {
+      throw new IOException("Invalid immutable binary " + description + ": " + value);
+    }
+    return value;
+  }
+
+  private static int capacity(int size) {
+    return size < 3 ? size + 1 : (int) Math.min(Integer.MAX_VALUE, size / 0.75f + 1.0f);
+  }
+
+  private static int sizeOf(Iterable<?> iterable) {
+    if (iterable instanceof Collection<?>) {
+      return ((Collection<?>) iterable).size();
+    }
+    int size = 0;
+    for (Object ignored : iterable) {
+      size++;
+    }
+    return size;
+  }
+
+  private static Object invokeUnchecked(Object target, String name) throws IOException {
+    return invokeCompatible(target, name);
+  }
+
+  private static Object staticInvoke(String className, String name, Object... arguments)
+      throws IOException {
+    try {
+      return invokeCompatible(Class.forName(className), name, arguments);
+    } catch (ClassNotFoundException ex) {
+      throw new IOException("Missing collection implementation " + className, ex);
+    }
+  }
+
+  private static Object invokeCompatible(Object target, String name, Object... arguments)
+      throws IOException {
+    Class<?> type = target instanceof Class<?> ? (Class<?>) target : target.getClass();
+    boolean requireStatic = target instanceof Class<?>;
+    for (Method method : type.getMethods()) {
+      if (method.getName().equals(name)
+          && method.getParameterTypes().length == arguments.length
+          && Modifier.isStatic(method.getModifiers()) == requireStatic
+          && compatible(method.getParameterTypes(), arguments)) {
+        return invokeMethod(method, requireStatic ? null : target, arguments);
+      }
+    }
+    throw new IOException("Cannot invoke " + type.getName() + "." + name);
+  }
+
+  private static Object invoke(Class<?> type, Object target, String name, Class<?>[] parameters,
+      Object... arguments) throws IOException {
+    try {
+      Method method = type.getMethod(name, parameters);
+      return invokeMethod(method, target, arguments);
+    } catch (NoSuchMethodException ex) {
+      try {
+        Method method = type.getDeclaredMethod(name, parameters);
+        return invokeMethod(method, target, arguments);
+      } catch (NoSuchMethodException nested) {
+        throw new IOException("Cannot invoke " + type.getName() + "." + name, nested);
+      }
+    }
+  }
+
+  private static Object invokeMethod(Method method, Object target, Object... arguments)
+      throws IOException {
+    try {
+      if (!method.isAccessible()) {
+        method.setAccessible(true);
+      }
+      return method.invoke(target, arguments);
+    } catch (IllegalAccessException ex) {
+      throw new IOException("Cannot access " + method, ex);
+    } catch (InvocationTargetException ex) {
+      Throwable cause = ex.getCause();
+      if (cause instanceof IOException) {
+        throw (IOException) cause;
+      }
+      throw new IOException("Invocation failed for " + method, cause);
+    } catch (RuntimeException ex) {
+      throw new IOException("Invocation failed for " + method, ex);
+    }
+  }
+
+  private static boolean compatible(Class<?>[] parameters, Object[] arguments) {
+    for (int i = 0; i < parameters.length; i++) {
+      if (arguments[i] == null) {
+        if (parameters[i].isPrimitive()) return false;
+      } else if (!box(parameters[i]).isInstance(arguments[i])) {
+        return false;
+      }
+    }
+    return true;
+  }
+
+  private static Class<?> box(Class<?> type) {
+    if (!type.isPrimitive()) return type;
+    if (type == boolean.class) return Boolean.class;
+    if (type == byte.class) return Byte.class;
+    if (type == short.class) return Short.class;
+    if (type == int.class) return Integer.class;
+    if (type == long.class) return Long.class;
+    if (type == char.class) return Character.class;
+    if (type == float.class) return Float.class;
+    if (type == double.class) return Double.class;
+    return type;
+  }
+
+  private static final class Entry {
+    final byte[] shape;
+    final byte[] payload;
+
+    Entry(byte[] shape, byte[] payload) {
+      this.shape = shape;
+      this.payload = payload;
+    }
+  }
+
+  private static final class Fingerprint {
+    final byte[] bytes;
+
+    Fingerprint(byte[] bytes) {
+      this.bytes = bytes;
+    }
+
+    @Override public boolean equals(Object object) {
+      return object instanceof Fingerprint && Arrays.equals(bytes, ((Fingerprint) object).bytes);
+    }
+
+    @Override public int hashCode() {
+      return Arrays.hashCode(bytes);
+    }
+  }
+}
