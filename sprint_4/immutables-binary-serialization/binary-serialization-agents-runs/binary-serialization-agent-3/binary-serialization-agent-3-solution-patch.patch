+  private boolean sameErasure(TypeMirror left, TypeMirror right) {
+    return constitution.protoclass().processing().getTypeUtils().isSameType(
+        constitution.protoclass().processing().getTypeUtils().erasure(left),
+        constitution.protoclass().processing().getTypeUtils().erasure(right));
