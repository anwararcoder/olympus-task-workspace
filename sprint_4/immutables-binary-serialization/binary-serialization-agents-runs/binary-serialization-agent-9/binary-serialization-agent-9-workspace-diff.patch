+package org.immutables.serial.fixture;
+
+import com.Capella.common.collect.ImmutableBiMap;
+import com.Capella.common.collect.ImmutableListMultimap;
+import com.Capella.common.collect.ImmutableSetMultimap;
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.DataInputStream;
+import java.io.DataOutputStream;
+import java.io.EOFException;
+import java.lang.reflect.Method;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.Optional;
+import java.util.OptionalDouble;
+import java.util.OptionalInt;
+import java.util.OptionalLong;
+import java.util.TreeMap;
+import java.util.TreeSet;
+import org.junit.Test;
+import static org.immutables.check.Checkers.check;
+
+public class CompactBinaryTest {
+  @Test
+  public void roundTripsBuilderValue() throws Exception {
+    char[] characters = new char[100_000];
+    Arrays.fill(characters, 'x');
+    String longText = new String(characters);
+    TreeMap<Integer, String> sortedMap = new TreeMap<>();
+    sortedMap.put(2, "two");
+    sortedMap.put(1, "one");
+    ImmutableCompactNested nested = ImmutableCompactNested.builder().number(7).text("nested").build();
+    ImmutableCompactBinaryValue value = ImmutableCompactBinaryValue.builder()
+        .flag(true)
+        .boxed(12)
+        .text(longText)
+        .color(BinaryColor.RED)
+        .optional("present")
+        .guavaOptional(BinaryColor.BLUE)
+        .optionalInt(OptionalInt.of(3))
+        .optionalLong(OptionalLong.of(4))
+        .optionalDouble(OptionalDouble.of(5.5))
+        .numbers(1, 2, 3)
+        .colors(BinaryColor.BLUE, BinaryColor.RED)
+        .addList("a", "b")
+        .addSet(BinaryColor.RED)
+        .addSortedSet(3, 1)
+        .addMultiset("same", "same", "other")
+        .putMap("one", 1)
+        .putAllSortedMap(sortedMap)
+        .putAllBiMap(ImmutableBiMap.of("red", BinaryColor.RED))
+        .putAllListMultimap(ImmutableListMultimap.of("k", 1, "k", 1))
+        .putAllSetMultimap(ImmutableSetMultimap.of("k", BinaryColor.BLUE))
+        .nested(nested)
+        .build();
+
+    ImmutableCompactBinaryValue copy = ImmutableCompactBinaryValue.readFrom(input(bytes(value)));
+
+    check(copy).is(value);
+    check(Arrays.equals(copy.numbers(), value.numbers()));
+    check(copy.colors()).isOf(value.colors());
+    check(copy.doubled()).is(24);
+    check(copy.auxiliary()).is(Optional.empty());
+  }
+
+  @Test
+  public void roundTripsConstructorValue() throws Exception {
+    ImmutableCompactConstructorValue value = ImmutableCompactConstructorValue.of(
+        9,
+        "constructor",
+        Optional.of(BinaryColor.BLUE),
+        Arrays.asList(1, 2),
+        new TreeSet<>(Arrays.asList("a", "b")),
+        Collections.singletonMap("x", 10L));
+
+    check(ImmutableCompactConstructorValue.readFrom(input(bytes(value)))).is(value);
+  }
+
+  @Test
+  public void matchesByNameAndShapeAcrossVersions() throws Exception {
+    ImmutableCompactVersionOne one = ImmutableCompactVersionOne.builder()
+        .number(1)
+        .text("text")
+        .changed(2)
+        .renamed("old")
+        .build();
+    ImmutableCompactVersionTwo two = ImmutableCompactVersionTwo.readFrom(input(bytes(one)));
+
+    check(two.number()).is(1);
+    check(two.text()).is("text");
+    check(two.added()).is(Optional.empty());
+    check(two.changed()).is(Optional.empty());
+    check(two.replacement()).is(Optional.empty());
+
+    ImmutableCompactVersionTwo newer = ImmutableCompactVersionTwo.builder()
+        .number(3)
+        .text("new")
+        .added(4L)
+        .changed("different")
+        .replacement("renamed")
+        .build();
+    ImmutableCompactVersionOne older = ImmutableCompactVersionOne.readFrom(input(bytes(newer)));
