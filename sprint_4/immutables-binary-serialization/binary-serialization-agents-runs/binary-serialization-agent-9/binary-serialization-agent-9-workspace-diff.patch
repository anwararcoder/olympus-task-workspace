+  @Test
+  public void scalarRoundTrip() throws Exception {
+    BinScalars value = ImmutableBinScalars.builder().n(7).s("hi").flag(true).big(99L).d(1.5).f(0.5f).sh((short) 3).bt((byte) 4).ch('z').build();
+    check(fromBytes(ImmutableBinScalars.class, toBytes(value))).is(value);
+    Method write = ImmutableBinScalars.class.getMethod("writeTo", DataOutput.class);
+    check(Modifier.isPublic(write.getModifiers()));
+    check(!Modifier.isStatic(write.getModifiers()));
+    Method read = ImmutableBinScalars.class.getMethod("readFrom", DataInput.class);
+    check(Modifier.isPublic(read.getModifiers()));
+    check(Modifier.isStatic(read.getModifiers()));
+    check(BinScalars.class.isAssignableFrom(read.getReturnType()));
+  }
+
+  @Test
+  public void serialArtifactControlsActivation() throws Exception {
+    BinScalars supported = ImmutableBinScalars.builder().n(3).s("serial").flag(true).big(4L)
+        .d(5.0).f(6.0f).sh((short) 7).bt((byte) 8).ch('s').build();
+    check(fromBytes(ImmutableBinScalars.class, toBytes(supported))).is(supported);
+
+    JavaCompiler compiler = ToolProvider.getSystemJavaCompiler();
+    check(compiler != null);
+    Path root = Files.createTempDirectory("immutables-value-only-");
+    Path source = root.resolve("probe/ValueOnlyProbe.java");
+    Path generated = root.resolve("generated");
+    Path classes = root.resolve("classes");
+    Files.createDirectories(source.getParent());
+    Files.createDirectories(generated);
+    Files.createDirectories(classes);
+    Files.write(source, Arrays.asList(
+        "package probe;",
+        "import org.immutables.value.Value;",
+        "@Value.Immutable interface ValueOnlyProbe { int value(); }"), StandardCharsets.UTF_8);
+
+    String valuePath = Paths.get(Value.class.getProtectionDomain().getCodeSource().getLocation().toURI()).toString();
+    List<String> options = Arrays.asList(
+        "-proc:only",
+        "-classpath", valuePath,
+        "-processorpath", valuePath,
+        "-processor", "org.immutables.processor.ProxyProcessor",
+        "-s", generated.toString(),
+        "-d", classes.toString());
+    DiagnosticCollector<JavaFileObject> diagnostics = new DiagnosticCollector<>();
+    try (StandardJavaFileManager files = compiler.getStandardFileManager(diagnostics, null, StandardCharsets.UTF_8)) {
+      Iterable<? extends JavaFileObject> units = files.getJavaFileObjects(source.toFile());
+      check(compiler.getTask(null, files, diagnostics, options, null, units).call());
+    }
+
+    String generatedSource = new String(
+        Files.readAllBytes(generated.resolve("probe/ImmutableValueOnlyProbe.java")),
+        StandardCharsets.UTF_8);
+    check(!generatedSource.contains("writeTo(java.io.DataOutput"));
+    check(!generatedSource.contains("readFrom(java.io.DataInput"));
+  }
