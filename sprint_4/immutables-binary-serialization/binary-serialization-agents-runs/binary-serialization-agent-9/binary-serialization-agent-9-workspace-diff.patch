+    check(!hasDeclaredMethod(ImmutableCompactRecursive.class, "writeTo"));
+    check(!hasDeclaredMethod(ImmutableCompactRecursive.class, "readFrom"));
+    check(!hasDeclaredMethod(ImmutableCompactUnsupported.class, "writeTo"));
+    check(!hasDeclaredMethod(ImmutableCompactUnsupported.class, "readFrom"));
+    check(!hasDeclaredMethod(ImmutableCompactRequiredAuxiliary.class, "writeTo"));
+    check(!hasDeclaredMethod(ImmutableCompactRequiredAuxiliary.class, "readFrom"));
+    check(!hasDeclaredMethod(ImmutableCompactConflict.class, "readFrom"));
