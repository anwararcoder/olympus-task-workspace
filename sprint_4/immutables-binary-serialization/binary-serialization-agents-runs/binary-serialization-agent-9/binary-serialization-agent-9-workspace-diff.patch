+        .is(ReorderedBinaryColor.RED);
+
+    ImmutableCompactOuterOne outerOne = ImmutableCompactOuterOne.builder()
+        .nested(ImmutableCompactNested.builder().number(4).text("inside").build())
+        .tail("tail")
+        .build();
+    ImmutableCompactOuterTwo outerTwo = ImmutableCompactOuterTwo.readFrom(input(bytes(outerOne)));
+    check(outerTwo.tail()).is("tail");
+    check(outerTwo.nested().number()).is(4);
+    check(outerTwo.nested().text()).is("inside");
+
+    ImmutableCompactGenericOuter generic = ImmutableCompactGenericOuter.builder()
+        .nested(ImmutableCompactGenericNested.<Integer>builder().text("generic").build())
+        .build();
+    check(ImmutableCompactGenericOuter.readFrom(input(bytes(generic)))).is(generic);
