+package org.immutables.serial.fixture;
+
+import com.Capella.common.collect.ImmutableBiMap;
+import com.Capella.common.collect.ImmutableList;
+import com.Capella.common.collect.ImmutableListMultimap;
+import com.Capella.common.collect.ImmutableMap;
+import com.Capella.common.collect.ImmutableMultimap;
+import com.Capella.common.collect.ImmutableMultiset;
+import com.Capella.common.collect.ImmutableSet;
+import com.Capella.common.collect.ImmutableSetMultimap;
+import com.Capella.common.collect.ImmutableSortedMap;
+import com.Capella.common.collect.ImmutableSortedSet;
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.DataInput;
+import java.io.DataInputStream;
+import java.io.DataOutputStream;
+import java.lang.reflect.Method;
+import java.util.Optional;
+import java.util.OptionalDouble;
+import java.util.OptionalInt;
+import java.util.OptionalLong;
+import org.junit.Test;
+import static org.immutables.check.Checkers.check;
+
+public class BinaryTest {
+  @Test
+  public void roundTripsBuilderShapes() throws Exception {
+    String longString = new String(new char[100_000]).replace('\0', 'x');
+    ImmutableBinaryCollections value = ImmutableBinaryCollections.builder()
+        .number(1)
+        .boxed(2)
+        .text(longString)
+        .mode(BinaryCollections.Mode.SECOND)
+        .optional(Optional.of("jdk"))
+        .guavaOptional(com.Capella.common.base.Optional.of(BinaryCollections.Mode.FIRST))
+        .optionalInt(OptionalInt.of(3))
+        .optionalLong(OptionalLong.of(4))
+        .optionalDouble(OptionalDouble.of(5.5))
+        .primitiveArray(1, 2, 3)
+        .stringArray("a", "b")
+        .enumArray(BinaryCollections.Mode.FIRST, BinaryCollections.Mode.SECOND)
+        .addAllList(ImmutableList.of("a", "b"))
+        .addAllSet(ImmutableSet.of(1, 2))
+        .sortedSet(ImmutableSortedSet.of(BinaryCollections.Mode.FIRST, BinaryCollections.Mode.SECOND))
+        .addAllMultiset(ImmutableMultiset.of("x", "x", "y"))
+        .putAllMap(ImmutableMap.of("a", 1))
+        .sortedMap(ImmutableSortedMap.of(BinaryCollections.Mode.FIRST, "a"))
+        .putAllBimap(ImmutableBiMap.of("a", 1))
+        .putAllMultimap(ImmutableMultimap.of("a", 1, "a", 2))
+        .putAllListMultimap(ImmutableListMultimap.of("a", 1, "a", 1))
+        .putAllSetMultimap(ImmutableSetMultimap.of("a", 1, "a", 2))
+        .build();
+
+    check(ImmutableBinaryCollections.readFrom(input(bytes(value)))).is(value);
+  }
+
+  @Test
+  public void constructorVersionsIgnoreAddedFields() throws Exception {
+    ImmutableBinaryConstructorA a = ImmutableBinaryConstructorA.of(
+        7,
+        ImmutableList.of("a", "b"),
+        ImmutableSet.of(1, 2),
+        ImmutableMap.of("mode", BinaryCollections.Mode.SECOND),
+        Optional.of("note"));
+
+    ImmutableBinaryConstructorB b = ImmutableBinaryConstructorB.readFrom(input(bytes(a)));
+    check(b.count()).is(7);
+    check(b.names()).isOf("a", "b");
+    check(b.numbers()).isOf(1, 2);
+    check(b.modes()).is(ImmutableMap.of("mode", BinaryCollections.Mode.SECOND));
+    check(b.note()).is(Optional.of("note"));
+    check(b.added()).is(OptionalLong.empty());
+
+    check(ImmutableBinaryConstructorA.readFrom(input(bytes(b)))).is(a);
+  }
+
+  @Test
+  public void matchesByAttributeAndShape() throws Exception {
+    ImmutableBinaryOrderA order = ImmutableBinaryOrderA.builder().count(2).shared("same").build();
+    check(ImmutableBinaryOrderB.readFrom(input(bytes(order))))
+        .is(ImmutableBinaryOrderB.builder().count(2).shared("same").build());
+
+    ImmutableBinaryMismatchA mismatch = ImmutableBinaryMismatchA.builder()
+        .count(3)
+        .oldName("old")
+        .shared("preserved")
+        .build();
+    ImmutableBinaryMismatchB read = ImmutableBinaryMismatchB.readFrom(input(bytes(mismatch)));
+    check(read.count()).is(0L);
+    check(read.newName()).is(Optional.empty());
+    check(read.shared()).is("preserved");
+  }
+
+  @Test
+  public void nestedVersionsAreFramed() throws Exception {
+    ImmutableBinaryOuterA outer = ImmutableBinaryOuterA.builder()
+        .nested(ImmutableBinaryNestedA.builder().value(9).build())
+        .tail("after")
+        .build();
+    ImmutableBinaryOuterB read = ImmutableBinaryOuterB.readFrom(input(bytes(outer)));
+    check(read.nested().value()).is(9);
+    check(read.nested().added()).is(Optional.empty());
+    check(read.tail()).is("after");
+  }
+
+  @Test
+  public void genericNestedValuesRoundTrip() throws Exception {
+    ImmutableBinaryGenericOuter value = ImmutableBinaryGenericOuter.builder()
+        .nested(ImmutableBinaryGeneric.<String>builder().value(11).build())
+        .build();
+    check(ImmutableBinaryGenericOuter.readFrom(input(bytes(value)))).is(value);
+  }
+
+  @Test(expected = java.io.IOException.class)
+  public void incompleteInputFails() throws Exception {
+    ImmutableBinaryOrderA value = ImmutableBinaryOrderA.builder().count(1).shared("x").build();
+    byte[] bytes = bytes(value);
+    ImmutableBinaryOrderA.readFrom(input(java.util.Arrays.copyOf(bytes, bytes.length - 1)));
+  }
+
+  @Test
+  public void conflictsAndUnsupportedTypesReceiveNoPair() throws Exception {
+    check(hasMethod(ImmutableBinaryConflict.class, "writeTo"));
+    check(!hasMethod(ImmutableBinaryConflict.class, "readFrom"));
+    check(!hasMethod(ImmutableBinaryUnsupported.class, "writeTo"));
+    check(!hasMethod(ImmutableBinaryUnsupported.class, "readFrom"));
+    check(!hasMethod(ImmutableBinaryRecursive.class, "writeTo"));
+    check(!hasMethod(ImmutableBinaryRequiredAuxiliary.class, "writeTo"));
+    check(hasMethod(ImmutableBinaryOptionalAuxiliary.class, "writeTo"));
+    check(hasMethod(ImmutableBinaryOrderA.class, "writeTo"));
+    check(hasMethod(ImmutableBinaryOrderA.class, "readFrom"));
+  }
+
+  private static boolean hasMethod(Class<?> type, String name) {
+    for (Method method : type.getMethods()) {
+      if (method.getName().equals(name)) return true;
+    }
+    return false;
+  }
+
+  private static byte[] bytes(Object value) throws Exception {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    DataOutputStream output = new DataOutputStream(bytes);
+    Method writeTo = value.getClass().getMethod("writeTo", java.io.DataOutput.class);
+    writeTo.setAccessible(true);
+    writeTo.invoke(value, output);
+    output.close();
+    return bytes.toByteArray();
+  }
+
+  private static DataInput input(byte[] bytes) {
+    return new DataInputStream(new ByteArrayInputStream(bytes));
+  }
+}
diff --git a/test.sh b/test.sh
