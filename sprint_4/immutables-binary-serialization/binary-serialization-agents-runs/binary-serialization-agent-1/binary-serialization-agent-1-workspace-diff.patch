index 0000000..11525f1
--- /dev/null
+++ b/serial/src/org/immutables/serial/Binary.java
@@ -0,0 +1,490 @@
+package org.immutables.serial;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.DataInput;
+import java.io.DataInputStream;
+import java.io.DataOutput;
+import java.io.DataOutputStream;
+import java.io.EOFException;
+import java.io.IOException;
+import java.lang.reflect.Array;
+import java.lang.reflect.InvocationTargetException;
+import java.lang.reflect.Method;
+import java.lang.reflect.Modifier;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Runtime support for compact binary forms generated by the value processor. */
+public final class Binary {
+  private static final int MAGIC = 0x494D4231;
+
+  public static final Object ABSENT = new Object();
+
+  private Binary() {}
+
+  public static void writeHeader(DataOutput output, int attributes) throws IOException {
+    output.writeInt(MAGIC);
+    output.writeInt(attributes);
+  }
+
+  public static void write(
+      DataOutput output,
+      long attribute,
+      long shape,
+      String descriptor,
+      Object value) throws IOException {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    DataOutputStream payload = new DataOutputStream(bytes);
+    writeValue(payload, descriptor, value);
+    payload.flush();
+    byte[] data = bytes.toByteArray();
+    output.writeLong(attribute);
+    output.writeLong(shape);
+    output.writeInt(data.length);
+    output.write(data);
+  }
+
+  public static Input read(DataInput input) throws IOException {
+    if (input.readInt() != MAGIC) {
+      throw new IOException("Invalid immutable binary form");
+    }
+    int count = input.readInt();
+    if (count < 0) {
+      throw new IOException("Negative attribute count");
+    }
+    Map<Key, byte[]> fields = new HashMap<Key, byte[]>();
+    for (int i = 0; i < count; i++) {
+      long attribute = input.readLong();
+      long shape = input.readLong();
+      int length = input.readInt();
+      if (length < 0) {
+        throw new IOException("Negative attribute length");
+      }
+      byte[] data = new byte[length];
+      input.readFully(data);
+      fields.put(new Key(attribute, shape), data);
+    }
+    return new Input(fields);
+  }
+
+  public static final class Input {
+    private final Map<Key, byte[]> fields;
+
+    private Input(Map<Key, byte[]> fields) {
+      this.fields = fields;
+    }
+
+    public Object get(long attribute, long shape, String descriptor) throws IOException {
+      byte[] data = fields.get(new Key(attribute, shape));
+      if (data == null) {
+        return ABSENT;
+      }
+      DataInputStream input = new DataInputStream(new ByteArrayInputStream(data));
+      Object value = readValue(input, descriptor);
+      if (input.read() != -1) {
+        throw new IOException("Trailing data in immutable attribute");
+      }
+      return value;
+    }
+  }
+
+  private static void writeValue(DataOutput output, String descriptor, Object value)
+      throws IOException {
+    char kind = descriptor.charAt(0);
+    switch (kind) {
+    case 'z': output.writeBoolean((Boolean) value); return;
+    case 'b': output.writeByte((Byte) value); return;
+    case 'c': output.writeChar((Character) value); return;
+    case 's': output.writeShort((Short) value); return;
+    case 'i': output.writeInt((Integer) value); return;
+    case 'j': output.writeLong((Long) value); return;
+    case 'f': output.writeFloat((Float) value); return;
+    case 'd': output.writeDouble((Double) value); return;
+    case 'Z': case 'B': case 'C': case 'H': case 'I': case 'J': case 'F': case 'D':
+      output.writeBoolean(value != null);
+      if (value != null) writeValue(output, primitiveDescriptor(kind), value);
+      return;
+    case 'T':
+      output.writeBoolean(value != null);
+      if (value != null) writeString(output, (String) value);
+      return;
+    case 'E':
+      output.writeBoolean(value != null);
+      if (value != null) writeString(output, ((Enum<?>) value).name());
+      return;
+    case 'N':
+      output.writeBoolean(value != null);
+      if (value != null) invokeWrite(value, output);
+      return;
+    case 'O':
+      writeOptional(output, descriptor, value);
+      return;
+    case 'A':
+      writeSequence(output, nested(descriptor, 1), value);
+      return;
+    case 'L': case 'S': case 'Q': case 'U': case 'V':
+      writeSequence(output, nested(descriptor, 1), value);
+      return;
+    case 'M': case 'R': case 'K': case 'X': case 'Y': case 'W':
+      writeMapping(output, descriptor, value);
+      return;
+    default:
+      throw new IOException("Unsupported immutable binary descriptor: " + descriptor);
+    }
+  }
+
+  private static Object readValue(DataInput input, String descriptor) throws IOException {
+    char kind = descriptor.charAt(0);
+    switch (kind) {
+    case 'z': return input.readBoolean();
+    case 'b': return input.readByte();
+    case 'c': return input.readChar();
+    case 's': return input.readShort();
+    case 'i': return input.readInt();
+    case 'j': return input.readLong();
+    case 'f': return input.readFloat();
+    case 'd': return input.readDouble();
+    case 'Z': case 'B': case 'C': case 'H': case 'I': case 'J': case 'F': case 'D':
+      return input.readBoolean() ? readValue(input, primitiveDescriptor(kind)) : null;
+    case 'T': return input.readBoolean() ? readString(input) : null;
+    case 'E': return input.readBoolean() ? readEnum(input, descriptor.substring(2)) : null;
+    case 'N': return input.readBoolean()
+        ? invokeRead(descriptor.substring(descriptor.indexOf('@') + 1), input)
+        : null;
+    case 'O': return readOptional(input, descriptor);
+    case 'A': return readArray(input, nested(descriptor, 1));
+    case 'L': case 'S': case 'U':
+      return readSequence(input, nested(descriptor, 1));
+    case 'Q':
+      return new java.util.TreeSet<Object>(java.util.Arrays.asList(
+          readSequence(input, nested(descriptor, 1))));
+    case 'V':
+      return immutableSortedMultiset(readSequence(input, nested(descriptor, 1)));
+    case 'M': case 'K': case 'X': case 'Y': case 'W':
+      return readMapping(input, descriptor);
+    case 'R':
+      return readSortedMap(input, descriptor);
+    default:
+      throw new IOException("Unsupported immutable binary descriptor: " + descriptor);
+    }
+  }
+
+  private static void writeOptional(DataOutput output, String descriptor, Object value)
+      throws IOException {
+    String optionalKind = descriptor.substring(0, descriptor.indexOf('('));
+    boolean present;
+    Object contained = null;
+    if ("OI".equals(optionalKind)) {
+      present = ((java.util.OptionalInt) value).isPresent();
+      if (present) contained = ((java.util.OptionalInt) value).getAsInt();
+    } else if ("OJ".equals(optionalKind)) {
+      present = ((java.util.OptionalLong) value).isPresent();
+      if (present) contained = ((java.util.OptionalLong) value).getAsLong();
+    } else if ("OD".equals(optionalKind)) {
+      present = ((java.util.OptionalDouble) value).isPresent();
+      if (present) contained = ((java.util.OptionalDouble) value).getAsDouble();
+    } else if ("OU".equals(optionalKind)) {
+      java.util.Optional<?> optional = (java.util.Optional<?>) value;
+      present = optional.isPresent();
+      if (present) contained = optional.get();
+    } else {
+      present = invokeBoolean(value, "isPresent");
+      if (present) contained = invoke(value, "get");
+    }
+    output.writeBoolean(present);
+    if (present) {
+      writeValue(output, nested(descriptor, descriptor.indexOf('(')), contained);
+    }
+  }
+
+  private static Object readOptional(DataInput input, String descriptor) throws IOException {
+    String optionalKind = descriptor.substring(0, descriptor.indexOf('('));
+    boolean present = input.readBoolean();
+    Object value = present ? readValue(input, nested(descriptor, descriptor.indexOf('('))) : null;
+    if ("OI".equals(optionalKind)) {
+      return present ? java.util.OptionalInt.of((Integer) value) : java.util.OptionalInt.empty();
+    }
+    if ("OJ".equals(optionalKind)) {
+      return present ? java.util.OptionalLong.of((Long) value) : java.util.OptionalLong.empty();
+    }
+    if ("OD".equals(optionalKind)) {
+      return present ? java.util.OptionalDouble.of((Double) value) : java.util.OptionalDouble.empty();
+    }
+    if ("OU".equals(optionalKind)) {
+      return java.util.Optional.ofNullable(value);
+    }
+    try {
+      Class<?> optional = loadClass("com.Capella.common.base.Optional");
+      Method method = optional.getMethod("fromNullable", Object.class);
+      return method.invoke(null, value);
+    } catch (ReflectiveOperationException ex) {
+      throw new IOException("Cannot create Guava Optional", ex);
+    }
+  }
+
+  private static void writeSequence(DataOutput output, String element, Object value)
+      throws IOException {
+    if (value.getClass().isArray()) {
+      int length = Array.getLength(value);
+      output.writeInt(length);
+      for (int i = 0; i < length; i++) writeValue(output, element, Array.get(value, i));
+      return;
+    }
+    Collection<?> collection = value instanceof Collection
+        ? (Collection<?>) value
+        : iterableToList((Iterable<?>) value);
+    output.writeInt(collection.size());
+    for (Object item : collection) writeValue(output, element, item);
+  }
+
+  private static Object[] readSequence(DataInput input, String element) throws IOException {
+    int length = readLength(input);
+    Object[] values = new Object[length];
+    for (int i = 0; i < length; i++) values[i] = readValue(input, element);
+    return values;
+  }
+
+  private static Object readArray(DataInput input, String element) throws IOException {
+    int length = readLength(input);
+    Class<?> component = componentClass(element);
+    Object array = Array.newInstance(component, length);
+    for (int i = 0; i < length; i++) Array.set(array, i, readValue(input, element));
+    return array;
+  }
+
+  private static void writeMapping(DataOutput output, String descriptor, Object value)
+      throws IOException {
+    String[] elements = pair(descriptor);
+    Iterable<?> entries;
+    if (value instanceof Map) {
+      entries = ((Map<?, ?>) value).entrySet();
+    } else {
+      Object reflected = invoke(value, "entries");
+      entries = (Iterable<?>) reflected;
+    }
+    List<?> list = iterableToList(entries);
+    output.writeInt(list.size());
+    for (Object entry : list) {
+      Map.Entry<?, ?> e = (Map.Entry<?, ?>) entry;
+      writeValue(output, elements[0], e.getKey());
+      writeValue(output, elements[1], e.getValue());
+    }
+  }
+
+  private static Object[] readMapping(DataInput input, String descriptor) throws IOException {
+    String[] elements = pair(descriptor);
+    int length = readLength(input);
+    Object[] entries = new Object[length * 2];
+    for (int i = 0; i < length; i++) {
+      entries[i * 2] = readValue(input, elements[0]);
+      entries[i * 2 + 1] = readValue(input, elements[1]);
+    }
+    return entries;
+  }
+
+  private static Object readSortedMap(DataInput input, String descriptor) throws IOException {
+    Object[] entries = readMapping(input, descriptor);
+    java.util.SortedMap<Object, Object> map = new java.util.TreeMap<Object, Object>();
+    for (int i = 0; i < entries.length; i += 2) map.put(entries[i], entries[i + 1]);
+    return map;
+  }
+
+  private static Object immutableSortedMultiset(Object[] values) throws IOException {
+    try {
+      Class<?> type = loadClass("com.Capella.common.collect.ImmutableSortedMultiset");
+      Method copyOf = type.getMethod("copyOf", Iterable.class);
+      return copyOf.invoke(null, java.util.Arrays.asList(values));
+    } catch (ReflectiveOperationException ex) {
+      throw new IOException("Cannot create Guava sorted multiset", ex);
+    }
+  }
+
+  private static void invokeWrite(Object value, DataOutput output) throws IOException {
+    try {
+      Method method = value.getClass().getMethod("writeTo", DataOutput.class);
+      method.setAccessible(true);
+      method.invoke(value, output);
+    } catch (InvocationTargetException ex) {
+      throw rethrow(ex.getCause());
+    } catch (ReflectiveOperationException ex) {
+      throw new IOException("Cannot write nested immutable", ex);
+    }
+  }
+
+  private static Object invokeRead(String className, DataInput input) throws IOException {
+    try {
+      Method method = loadClass(className).getMethod("readFrom", DataInput.class);
+      if (!Modifier.isStatic(method.getModifiers())) {
+        throw new IOException("Nested immutable readFrom is not static");
+      }
+      method.setAccessible(true);
+      return method.invoke(null, input);
+    } catch (InvocationTargetException ex) {
+      throw rethrow(ex.getCause());
+    } catch (ReflectiveOperationException ex) {
+      throw new IOException("Cannot read nested immutable " + className, ex);
+    }
+  }
+
+  private static Object readEnum(DataInput input, String className) throws IOException {
+    String name = readString(input);
+    try {
+      @SuppressWarnings({"rawtypes", "unchecked"})
+      Object value = Enum.valueOf((Class) loadClass(className), name);
+      return value;
+    } catch (ReflectiveOperationException | IllegalArgumentException ex) {
+      throw new IOException("Cannot read enum " + className + "." + name, ex);
+    }
+  }
+
+  private static Class<?> componentClass(String descriptor) throws IOException {
+    switch (descriptor.charAt(0)) {
+    case 'z': return boolean.class;
+    case 'b': return byte.class;
+    case 'c': return char.class;
+    case 's': return short.class;
+    case 'i': return int.class;
+    case 'j': return long.class;
+    case 'f': return float.class;
+    case 'd': return double.class;
+    case 'Z': return Boolean.class;
+    case 'B': return Byte.class;
+    case 'C': return Character.class;
+    case 'H': return Short.class;
+    case 'I': return Integer.class;
+    case 'J': return Long.class;
+    case 'F': return Float.class;
+    case 'D': return Double.class;
+    case 'T': return String.class;
+    case 'E':
+      try {
+        return loadClass(descriptor.substring(2));
+      } catch (ClassNotFoundException ex) {
+        throw new IOException("Cannot load array component", ex);
+      }
+    default: return Object.class;
+    }
+  }
+
+  private static String primitiveDescriptor(char wrapper) {
+    switch (wrapper) {
+    case 'Z': return "z";
+    case 'B': return "b";
+    case 'C': return "c";
+    case 'H': return "s";
+    case 'I': return "i";
+    case 'J': return "j";
+    case 'F': return "f";
+    case 'D': return "d";
+    default: throw new AssertionError(wrapper);
+    }
+  }
+
+  private static String nested(String descriptor, int openAt) throws IOException {
+    int open = descriptor.indexOf('(', openAt);
+    if (open < 0 || descriptor.charAt(descriptor.length() - 1) != ')') {
+      throw new IOException("Malformed immutable binary descriptor: " + descriptor);
+    }
+    return descriptor.substring(open + 1, descriptor.length() - 1);
+  }
+
+  private static String[] pair(String descriptor) throws IOException {
+    String content = nested(descriptor, 1);
+    int depth = 0;
+    for (int i = 0; i < content.length(); i++) {
+      char c = content.charAt(i);
+      if (c == '(') depth++;
+      if (c == ')') depth--;
+      if (c == ',' && depth == 0) {
+        return new String[] {content.substring(0, i), content.substring(i + 1)};
+      }
+    }
+    throw new IOException("Malformed immutable mapping descriptor: " + descriptor);
+  }
+
+  private static int readLength(DataInput input) throws IOException {
+    int length = input.readInt();
+    if (length < 0) throw new EOFException("Negative immutable sequence length");
+    return length;
+  }
+
+  private static void writeString(DataOutput output, String value) throws IOException {
+    byte[] bytes = value.getBytes(StandardCharsets.UTF_8);
+    output.writeInt(bytes.length);
+    output.write(bytes);
+  }
+
+  private static String readString(DataInput input) throws IOException {
+    int length = readLength(input);
+    byte[] bytes = new byte[length];
+    input.readFully(bytes);
+    return new String(bytes, StandardCharsets.UTF_8);
+  }
+
+  private static List<?> iterableToList(Iterable<?> iterable) {
+    List<Object> values = new ArrayList<Object>();
+    for (Object value : iterable) values.add(value);
+    return values;
+  }
+
+  private static Object invoke(Object receiver, String name) throws IOException {
+    try {
+      Method method = receiver.getClass().getMethod(name);
+      method.setAccessible(true);
+      return method.invoke(receiver);
+    } catch (InvocationTargetException ex) {
+      throw rethrow(ex.getCause());
+    } catch (ReflectiveOperationException ex) {
+      throw new IOException("Cannot invoke " + name, ex);
+    }
+  }
+
+  private static boolean invokeBoolean(Object receiver, String name) throws IOException {
+    return (Boolean) invoke(receiver, name);
+  }
+
+  private static IOException rethrow(Throwable throwable) {
+    return throwable instanceof IOException
+        ? (IOException) throwable
+        : new IOException(throwable);
+  }
+
+  private static Class<?> loadClass(String name) throws ClassNotFoundException {
+    ClassLoader loader = Thread.currentThread().getContextClassLoader();
+    String candidate = name;
+    while (true) {
+      try {
+        return Class.forName(candidate, true, loader);
+      } catch (ClassNotFoundException ex) {
+        int dot = candidate.lastIndexOf('.');
+        if (dot < 0) throw ex;
+        candidate = candidate.substring(0, dot) + '$' + candidate.substring(dot + 1);
+      }
+    }
+  }
+
+  private static final class Key {
+    private final long attribute;
+    private final long shape;
+
+    Key(long attribute, long shape) {
+      this.attribute = attribute;
+      this.shape = shape;
+    }
+
+    @Override public boolean equals(Object other) {
+      if (!(other instanceof Key)) return false;
+      Key key = (Key) other;
+      return attribute == key.attribute && shape == key.shape;
+    }
+
+    @Override public int hashCode() {
+      return (int) (attribute ^ (attribute >>> 32) ^ shape ^ (shape >>> 32));
+    }
+  }
+}
