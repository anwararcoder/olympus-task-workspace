diff --git a/serial/test/org/immutables/serial/fixture/BinaryFormTest.java b/serial/test/org/immutables/serial/fixture/BinaryFormTest.java
new file mode 100644
index 0000000..eb46576
--- /dev/null
+++ b/serial/test/org/immutables/serial/fixture/BinaryFormTest.java
@@ -0,0 +1,210 @@
+package org.immutables.serial.fixture;
+
+import static org.immutables.check.Checkers.check;
+import static org.junit.Assert.assertFalse;
+
+import com.Capella.common.base.Optional;
+import com.Capella.common.collect.ImmutableBiMap;
+import com.Capella.common.collect.ImmutableListMultimap;
+import com.Capella.common.collect.ImmutableMultimap;
+import com.Capella.common.collect.ImmutableMultiset;
+import com.Capella.common.collect.ImmutableSetMultimap;
+import com.Capella.common.collect.ImmutableSortedMultiset;
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.DataInput;
+import java.io.DataInputStream;
+import java.io.DataOutput;
+import java.io.DataOutputStream;
+import java.io.IOException;
+import java.lang.reflect.Method;
+import java.lang.reflect.Modifier;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.OptionalDouble;
+import java.util.OptionalInt;
+import java.util.OptionalLong;
+import java.util.TreeMap;
+import java.util.TreeSet;
+import org.junit.Test;
+
+public class BinaryFormTest {
+  @Test
+  public void builderRoundTrip() throws Exception {
+    TreeMap<Integer, String> sortedMap = new TreeMap<>();
+    sortedMap.put(2, "two");
+    sortedMap.put(1, "one");
+
+    ImmutableBinaryBuilderValue value = ImmutableBinaryBuilderValue.builder()
+        .flag(true)
+        .boxed(4)
+        .text(repeat("long text ", 10000))
+        .enumeration(BinaryEnum.SECOND)
+        .javaOptional(java.util.Optional.of("java"))
+        .guavaOptional(Optional.of(8))
+        .optionalInt(OptionalInt.of(9))
+        .optionalLong(OptionalLong.of(10L))
+        .optionalDouble(OptionalDouble.of(11.5))
+        .primitiveArray(1, 2, 3)
+        .referenceArray("a", "b")
+        .addList("list", "list")
+        .addSet(1, 2)
+        .sortedSet(new TreeSet<>(Arrays.asList("b", "a")))
+        .addAllMultiset(ImmutableMultiset.of("x", "x", "y"))
+        .sortedMultiset(ImmutableSortedMultiset.of(3, 1, 3))
+        .putMap("one", 1)
+        .sortedMap(sortedMap)
+        .putAllBiMap(ImmutableBiMap.of("two", 2))
+        .putAllMultimap(ImmutableMultimap.of("m", 1, "m", 1))
+        .putAllListMultimap(ImmutableListMultimap.of("l", 1, "l", 1))
+        .putAllSetMultimap(ImmutableSetMultimap.of("s", 1))
+        .nested(ImmutableBinaryNested.builder().number(12).text("nested").build())
+        .build();
+
+    ImmutableBinaryBuilderValue copy = roundTrip(value::writeTo, ImmutableBinaryBuilderValue::readFrom);
+    check(copy).is(value);
+    check(copy.primitiveArray()).isOf(1, 2, 3);
+    check(copy.referenceArray()).isOf("a", "b");
+    check(copy.multiset().count("x")).is(2);
+    check(copy.listMultimap().get("l")).isOf(1, 1);
+    check(copy.auxiliary()).is("default auxiliary");
+  }
+
+  @Test
+  public void constructorRoundTrip() throws Exception {
+    ImmutableBinaryConstructorValue value = ImmutableBinaryConstructorValue.of(
+        1,
+        "constructor",
+        BinaryEnum.FIRST,
+        java.util.Optional.of("optional"),
+        Arrays.asList(1, 2),
+        new TreeSet<>(Arrays.asList("a", "b")),
+        Collections.singletonMap("key", 3L));
+
+    check(roundTrip(value::writeTo, ImmutableBinaryConstructorValue::readFrom)).is(value);
+  }
+
+  @Test
+  public void versionsMatchByNameAndShape() throws Exception {
+    ImmutableBinaryVersionOne one = ImmutableBinaryVersionOne.builder()
+        .number(3)
+        .text("text")
+        .removedLater("removed")
+        .build();
+    ImmutableBinaryVersionTwo two = read(write(one::writeTo), ImmutableBinaryVersionTwo::readFrom);
+    check(two.number()).is(3);
+    check(two.text()).is("text");
+    check(two.addedLater()).is(java.util.Optional.empty());
+
+    ImmutableBinaryVersionTwo newer = ImmutableBinaryVersionTwo.builder()
+        .number(4)
+        .text("newer")
+        .addedLater(5L)
+        .build();
+    ImmutableBinaryVersionOne older = read(write(newer::writeTo), ImmutableBinaryVersionOne::readFrom);
+    check(older.number()).is(4);
+    check(older.text()).is("newer");
+    check(older.removedLater()).is(java.util.Optional.empty());
+
+    ImmutableBinaryMismatchOne mismatch = ImmutableBinaryMismatchOne.builder()
+        .stable(7)
+        .changed("wrong type")
+        .build();
+    ImmutableBinaryMismatchTwo mismatchRead = read(
+        write(mismatch::writeTo), ImmutableBinaryMismatchTwo::readFrom);
+    check(mismatchRead.stable()).is(7);
+    check(mismatchRead.changed()).is(java.util.Optional.empty());
+  }
+
+  @Test
+  public void nestedCompatibilityIsStructuralAndFramed() throws Exception {
+    ImmutableBinaryNestedOuterOne one = ImmutableBinaryNestedOuterOne.builder()
+        .nested(ImmutableBinaryNested.builder().number(6).text("six").build())
+        .following("after")
+        .build();
+    ImmutableBinaryNestedOuterTwo two = read(write(one::writeTo), ImmutableBinaryNestedOuterTwo::readFrom);
+    check(two.nested().number()).is(6);
+    check(two.nested().text()).is("six");
+    check(two.nested().added()).is(java.util.Optional.empty());
+    check(two.following()).is("after");
+
+    ImmutableBinaryGenericOuter generic = ImmutableBinaryGenericOuter.builder()
+        .nested(ImmutableBinaryGenericNested.<String>builder().number(8).build())
+        .build();
+    check(roundTrip(generic::writeTo, ImmutableBinaryGenericOuter::readFrom)).is(generic);
+  }
+
+  @Test
+  public void unsupportedAndConflictingTypesHaveNoPair() {
+    assertFalse(hasBinaryPair(ImmutableBinaryUnsupported.class));
+    assertFalse(hasBinaryPair(ImmutableBinaryRecursive.class));
+    assertFalse(hasBinaryPair(ImmutableBinaryRequiredAuxiliary.class));
+    assertFalse(hasDeclaredReadFrom(ImmutableBinaryConflict.class));
+    assertFalse(hasDeclaredWriteTo(ImmutableBinaryReadConflict.class));
+  }
+
+  @Test(expected = IOException.class)
+  public void incompleteInputFails() throws Exception {
+    ImmutableBinaryVersionOne value = ImmutableBinaryVersionOne.builder()
+        .number(1)
+        .text("incomplete")
+        .build();
+    byte[] complete = write(value::writeTo);
+    byte[] incomplete = Arrays.copyOf(complete, complete.length - 1);
+    read(incomplete, ImmutableBinaryVersionOne::readFrom);
+  }
+
+  private static boolean hasBinaryPair(Class<?> type) {
+    return hasDeclaredReadFrom(type) && hasDeclaredWriteTo(type);
+  }
+
+  private static boolean hasDeclaredReadFrom(Class<?> type) {
+    for (Method method : type.getDeclaredMethods()) {
+      if (method.getName().equals("readFrom")
+          && Modifier.isStatic(method.getModifiers())
+          && Arrays.equals(method.getParameterTypes(), new Class<?>[] {DataInput.class})) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  private static boolean hasDeclaredWriteTo(Class<?> type) {
+    for (Method method : type.getDeclaredMethods()) {
+      if (method.getName().equals("writeTo")
+          && !Modifier.isStatic(method.getModifiers())
+          && Arrays.equals(method.getParameterTypes(), new Class<?>[] {DataOutput.class})) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  private static <T> T roundTrip(BinaryWriter value, BinaryReader<T> reader) throws Exception {
+    return read(write(value), reader);
+  }
+
+  private static byte[] write(BinaryWriter value) throws Exception {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    value.writeTo(new DataOutputStream(bytes));
+    return bytes.toByteArray();
+  }
+
+  private static <T> T read(byte[] bytes, BinaryReader<T> reader) throws Exception {
+    return reader.readFrom(new DataInputStream(new ByteArrayInputStream(bytes)));
+  }
+
+  private static String repeat(String value, int count) {
+    StringBuilder result = new StringBuilder(value.length() * count);
+    for (int i = 0; i < count; i++) result.append(value);
+    return result.toString();
+  }
+
+  private interface BinaryWriter {
+    void writeTo(DataOutput output) throws Exception;
+  }
+
+  private interface BinaryReader<T> {
+    T readFrom(DataInput input) throws Exception;
+  }
+}
diff --git a/test.sh b/test.sh
new file mode 100755
index 0000000..89bb341
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,115 @@
+#!/bin/bash
+set -uo pipefail
+
+INVOKE_DIR="$PWD"
+cd "$(dirname "$0")"
+
+OUTPUT_PATH=""
+MODE=""
+
+while [[ $# -gt 0 ]]; do
+    case "$1" in
+        --output_path)
+            OUTPUT_PATH="$2"
+            shift 2
+            ;;
+        base|new)
+            MODE="$1"
+            shift
+            ;;
+        *)
+            echo "Usage: $0 --output_path <path> {base|new}"
+            exit 1
+            ;;
+    esac
+done
+
+if [[ -n "$OUTPUT_PATH" && "$OUTPUT_PATH" != /* ]]; then
+    OUTPUT_PATH="$INVOKE_DIR/$OUTPUT_PATH"
+fi
+
+if [[ -z "$MODE" ]]; then
+    echo "Usage: $0 --output_path <path> {base|new}"
+    exit 1
+fi
+
+FOCUS_TEST="BinarySerialization_7e2d4f_Test"
+REPORTS="value-fixture/target/surefire-reports"
+TMP="${TMPDIR:-/tmp}/immutables-binary-serialization-mvn-tmp"
+mkdir -p "$TMP"
+export MAVEN_OPTS="-Xmx950m -Djava.io.tmpdir=$TMP"
+MVN="mvn -B -ntp -o -DforkCount=1 -DreuseForks=true -DfailIfNoTests=false"
+LOG="$TMP/maven-$MODE.log"
+
+xml_escape() {
+    sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
+}
+
+run_mvn() {
+    $MVN "$@" 2>&1 | tee "$LOG"
+    return "${PIPESTATUS[0]}"
+}
+
+write_xml() {
+    local fallback="${1:-0}"
+    [[ -z "$OUTPUT_PATH" ]] && return 0
+    : > "$OUTPUT_PATH"
+    echo '<testsuites>' >> "$OUTPUT_PATH"
+    FOUND=0
+    for xml in "$REPORTS"/TEST-*.xml; do
+        if [[ -e "$xml" ]]; then
+            FOUND=1
+            grep -v '<?xml' "$xml" >> "$OUTPUT_PATH"
+        fi
+    done
+    if [[ "$FOUND" -eq 0 && "$fallback" -ne 0 ]]; then
+        case "$MODE" in
+            base)
+                FALLBACK_CLASS="org.immutables.fixture.ValuesTest"
+                FALLBACK_TEST="plainAttributes"
+                ;;
+            new)
+                FALLBACK_CLASS="org.immutables.fixture.binser_9c3f2a.BinarySerialization_7e2d4f_Test"
+                FALLBACK_TEST="scalarRoundTrip"
+                ;;
+        esac
+        cat >> "$OUTPUT_PATH" <<XML
+<testsuite name="$MODE" tests="1" failures="1" errors="0" skipped="0">
+  <testcase name="$FALLBACK_TEST" classname="$FALLBACK_CLASS">
+    <failure message="Maven failed before Surefire reports were produced">
+XML
+        if [[ -f "$LOG" ]]; then
+            tail -n 200 "$LOG" | xml_escape >> "$OUTPUT_PATH"
+        else
+            echo "Maven failed before Surefire reports were produced." >> "$OUTPUT_PATH"
+        fi
+        cat >> "$OUTPUT_PATH" <<XML
+    </failure>
+  </testcase>
+</testsuite>
+XML
+    fi
+    echo '</testsuites>' >> "$OUTPUT_PATH"
+}
+
+rm -rf "$REPORTS"
+
+if ! run_mvn -pl value-fixture -am clean install -DskipTests -Dmaven.test.skip=true; then
+    write_xml 1
+    exit 1
+fi
+
+rm -rf "$REPORTS"
+
+RC=0
+case "$MODE" in
+    base)
+        run_mvn -pl value-fixture test -Dtest="!$FOCUS_TEST" || RC=$?
+        ;;
+    new)
+        run_mvn -pl value-fixture test -Dtest="$FOCUS_TEST" || RC=$?
+        ;;
+esac
+
+write_xml "$RC"
+exit $RC
