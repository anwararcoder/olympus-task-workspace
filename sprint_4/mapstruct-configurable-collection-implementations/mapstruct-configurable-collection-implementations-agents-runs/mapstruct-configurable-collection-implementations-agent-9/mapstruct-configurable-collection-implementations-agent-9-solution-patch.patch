+ */
+package org.mapstruct.ap.internal.option;
+
+import java.io.FileNotFoundException;
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.file.NoSuchFileException;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Properties;
+import java.util.Set;
+import javax.annotation.processing.ProcessingEnvironment;
+import javax.lang.model.element.Element;
+import javax.lang.model.element.ElementKind;
+import javax.lang.model.element.ExecutableElement;
+import javax.lang.model.element.Modifier;
+import javax.lang.model.element.TypeElement;
+import javax.lang.model.element.TypeParameterElement;
+import javax.lang.model.type.DeclaredType;
+import javax.lang.model.type.TypeKind;
+import javax.lang.model.type.TypeMirror;
+import javax.lang.model.util.ElementFilter;
+import javax.lang.model.util.Elements;
+import javax.lang.model.util.Types;
+import javax.tools.Diagnostic;
+import javax.tools.FileObject;
+import javax.tools.StandardLocation;
+
+/**
+ * Configuration for the concrete types used for supported collection and map interfaces.
+ */
+public class CollectionImplementationConfiguration {
+
+    private static final String DEFAULT_CONFIGURATION_FILE = "mapstruct.properties";
+    private static final String PROPERTY_PREFIX = "mapstruct.collectionImplementation.";
+    private static final Set<String> SUPPORTED_INTERFACES = Collections.unmodifiableSet( new HashSet<>( Arrays.asList(
+        "java.lang.Iterable",
+        "java.util.Collection",
+        "java.util.List",
+        "java.util.Set",
+        "java.util.SortedSet",
+        "java.util.NavigableSet",
+        "java.util.Map",
+        "java.util.SortedMap",
+        "java.util.NavigableMap",
+        "java.util.concurrent.ConcurrentMap",
+        "java.util.concurrent.ConcurrentNavigableMap",
+        "java.util.SequencedSet",
+        "java.util.SequencedMap"
+    ) ) );
+
+    private final ProcessingEnvironment processingEnvironment;
+    private final Map<String, String> configuredTypes;
+    private final List<String> errors;
+    private Set<String> unresolvedInterfaces = Collections.emptySet();
+    private Map<String, ConfiguredImplementation> resolvedImplementations = Collections.emptyMap();
+    private boolean errorsReported;
+
+    private CollectionImplementationConfiguration(ProcessingEnvironment processingEnvironment,
+                                                  Map<String, String> configuredTypes,
+                                                  List<String> errors) {
+        this.processingEnvironment = processingEnvironment;
+        this.configuredTypes = configuredTypes;
+        this.errors = errors;
+    }
+
+    public static CollectionImplementationConfiguration load(ProcessingEnvironment processingEnvironment,
+                                                             Options options) {
+        String configuredFile = options.getConfigurationFile();
+        String resourceName = configuredFile == null ? DEFAULT_CONFIGURATION_FILE : configuredFile;
+        List<String> errors = new ArrayList<>();
+        Map<String, List<String>> entries = new LinkedHashMap<>();
+
+        if ( resourceName.trim().isEmpty() ) {
+            errors.add( "The MapStruct configuration resource name must not be empty." );
+            return new CollectionImplementationConfiguration( processingEnvironment, Collections.emptyMap(), errors );
+        }
+
+        try {
+            FileObject resource = processingEnvironment.getFiler()
+                .getResource( StandardLocation.CLASS_PATH, "", resourceName );
+            try (InputStream inputStream = resource.openInputStream()) {
+                Properties properties = new Properties() {
+                    @Override
+                    public synchronized Object put(Object key, Object value) {
+                        entries.computeIfAbsent( String.valueOf( key ), ignored -> new ArrayList<>() )
+                            .add( String.valueOf( value ) );
+                        return super.put( key, value );
+                    }
+                };
+                properties.load( inputStream );
+            }
+        }
+        catch ( IOException exception ) {
+            if ( configuredFile != null || !isMissingResource( exception ) ) {
+                errors.add( "Could not read MapStruct configuration resource '" + resourceName + "': "
+                    + exception.getMessage() );
+            }
+        }
+        catch ( RuntimeException exception ) {
+            errors.add( "Could not read MapStruct configuration resource '" + resourceName + "': "
+                + exception.getMessage() );
+        }
+
+        Map<String, String> configuredTypes = new LinkedHashMap<>();
+        for ( Map.Entry<String, List<String>> entry : entries.entrySet() ) {
+            String key = entry.getKey();
+            List<String> values = entry.getValue();
+            if ( !key.startsWith( PROPERTY_PREFIX ) ) {
+                errors.add( "Unknown MapStruct configuration property '" + key + "'." );
+                continue;
+            }
+
+            String interfaceName = key.substring( PROPERTY_PREFIX.length() );
+            if ( !SUPPORTED_INTERFACES.contains( interfaceName ) ) {
+                errors.add( "Unsupported collection or map interface in property '" + key + "'." );
+                continue;
+            }
+
+            Set<String> distinctValues = new HashSet<>( values );
+            if ( distinctValues.size() > 1 ) {
+                errors.add( "Conflicting duplicate values for property '" + key + "': " + distinctValues + "." );
+                continue;
+            }
+
+            String value = values.get( 0 ).trim();
+            if ( value.isEmpty() ) {
+                errors.add( "Empty implementation value for property '" + key + "'." );
+                continue;
+            }
+            configuredTypes.put( interfaceName, value );
+        }
+
+        return new CollectionImplementationConfiguration( processingEnvironment, configuredTypes, errors );
+    }
+
+    private static boolean isMissingResource(IOException exception) {
+        return exception instanceof FileNotFoundException || exception instanceof NoSuchFileException;
+    }
+
+    public boolean resolve(Elements elements, Types types) {
+        if ( !errors.isEmpty() ) {
+            return false;
+        }
+
+        Map<String, ConfiguredImplementation> resolved = new HashMap<>();
+        Set<String> unresolved = new HashSet<>();
+        for ( Map.Entry<String, String> entry : configuredTypes.entrySet() ) {
+            String interfaceName = entry.getKey();
+            String implementationName = entry.getValue();
+            TypeElement implementation = elements.getTypeElement( implementationName );
+            if ( implementation == null ) {
+                unresolved.add( interfaceName );
+                continue;
+            }
+
+            String error = validate( interfaceName, implementationName, implementation, elements, types );
+            if ( error != null ) {
+                errors.add( error );
+                continue;
+            }
+
+            resolved.put(
+                interfaceName,
+                new ConfiguredImplementation(
+                    implementationName,
+                    hasUsableIntConstructor( implementation, elements, types )
+                )
+            );
+        }
+
+        unresolvedInterfaces = unresolved;
+        if ( errors.isEmpty() && unresolved.isEmpty() ) {
+            resolvedImplementations = resolved;
+            return true;
+        }
+        return false;
+    }
+
+    private static String validate(String interfaceName, String implementationName, TypeElement implementation,
+                                   Elements elements, Types types) {
+        String key = PROPERTY_PREFIX + interfaceName;
+        TypeElement interfaceElement = elements.getTypeElement( interfaceName );
+        if ( interfaceElement == null ) {
+            return "Invalid property '" + key + "': interface '" + interfaceName
+                + "' is not available for this compilation.";
+        }
+        if ( implementation.getKind() != ElementKind.CLASS
+            || implementation.getModifiers().contains( Modifier.ABSTRACT ) ) {
+            return invalidValue( key, implementationName, "it is not a concrete class" );
+        }
+        if ( !isPubliclyAccessible( implementation ) ) {
+            return invalidValue( key, implementationName, "it is not publicly accessible" );
+        }
+        if ( !types.isAssignable(
+            types.erasure( implementation.asType() ),
+            types.erasure( interfaceElement.asType() )
+        ) ) {
+            return invalidValue( key, implementationName, "it is not assignable to " + interfaceName );
+        }
+
+        List<? extends TypeParameterElement> implementationParameters = implementation.getTypeParameters();
+        List<? extends TypeParameterElement> interfaceParameters = interfaceElement.getTypeParameters();
+        if ( implementationParameters.size() != interfaceParameters.size() ) {
+            return invalidValue( key, implementationName, "it does not declare the same number of type parameters as "
+                + interfaceName );
+        }
+        for ( TypeParameterElement parameter : implementationParameters ) {
+            if ( !isUnbounded( parameter, elements, types ) ) {
+                return invalidValue( key, implementationName, "its type parameters must be unbounded" );
+            }
+        }
+        if ( !preservesTypeParameters( implementation, interfaceElement, types ) ) {
+            return invalidValue( key, implementationName, "it does not preserve the type parameters of "
+                + interfaceName );
+        }
+        if ( !hasUsableNoArgsConstructor( implementation, elements, types ) ) {
+            return invalidValue( key, implementationName,
+                "it does not expose a public no-argument constructor without checked exceptions" );
+        }
+        return null;
+    }
+
+    private static String invalidValue(String key, String value, String cause) {
+        return "Invalid value '" + value + "' for property '" + key + "': " + cause + ".";
+    }
+
+    private static boolean isPubliclyAccessible(TypeElement type) {
+        Element current = type;
+        while ( current instanceof TypeElement ) {
+            if ( !current.getModifiers().contains( Modifier.PUBLIC ) ) {
+                return false;
+            }
+            Element enclosing = current.getEnclosingElement();
+            if ( enclosing instanceof TypeElement && !current.getModifiers().contains( Modifier.STATIC ) ) {
+                return false;
+            }
+            current = enclosing;
+        }
+        return true;
+    }
+
+    private static boolean isUnbounded(TypeParameterElement parameter, Elements elements, Types types) {
+        List<? extends TypeMirror> bounds = parameter.getBounds();
+        return bounds.size() == 1
+            && types.isSameType(
+                types.erasure( bounds.get( 0 ) ),
+                types.erasure( elements.getTypeElement( Object.class.getCanonicalName() ).asType() )
+            );
+    }
+
+    private static boolean preservesTypeParameters(TypeElement implementation, TypeElement targetInterface,
+                                                   Types types) {
+        DeclaredType implementedInterface = findSupertype( implementation.asType(), targetInterface, types );
+        if ( implementedInterface == null ) {
+            return false;
+        }
+        List<? extends TypeMirror> arguments = implementedInterface.getTypeArguments();
+        List<? extends TypeParameterElement> parameters = implementation.getTypeParameters();
+        if ( arguments.size() != parameters.size() ) {
+            return false;
+        }
+        for ( int i = 0; i < arguments.size(); i++ ) {
+            if ( arguments.get( i ).getKind() != TypeKind.TYPEVAR
+                || !types.isSameType( arguments.get( i ), parameters.get( i ).asType() ) ) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private static DeclaredType findSupertype(TypeMirror type, TypeElement target, Types types) {
+        if ( type.getKind() == TypeKind.DECLARED && ( (DeclaredType) type ).asElement().equals( target ) ) {
+            return (DeclaredType) type;
+        }
+        for ( TypeMirror supertype : types.directSupertypes( type ) ) {
+            DeclaredType match = findSupertype( supertype, target, types );
+            if ( match != null ) {
+                return match;
+            }
+        }
+        return null;
+    }
+
+    private static boolean hasUsableNoArgsConstructor(TypeElement implementation, Elements elements, Types types) {
+        for ( ExecutableElement constructor : ElementFilter.constructorsIn( implementation.getEnclosedElements() ) ) {
+            if ( constructor.getModifiers().contains( Modifier.PUBLIC )
+                && constructor.getParameters().isEmpty()
+                && declaresNoCheckedExceptions( constructor, elements, types ) ) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private static boolean hasUsableIntConstructor(TypeElement implementation, Elements elements, Types types) {
+        for ( ExecutableElement constructor : ElementFilter.constructorsIn( implementation.getEnclosedElements() ) ) {
+            if ( constructor.getModifiers().contains( Modifier.PUBLIC )
+                && constructor.getParameters().size() == 1
+                && constructor.getParameters().get( 0 ).asType().getKind() == TypeKind.INT
+                && declaresNoCheckedExceptions( constructor, elements, types ) ) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private static boolean declaresNoCheckedExceptions(ExecutableElement constructor, Elements elements, Types types) {
+        TypeMirror runtimeException = elements.getTypeElement( RuntimeException.class.getCanonicalName() ).asType();
+        TypeMirror error = elements.getTypeElement( Error.class.getCanonicalName() ).asType();
+        for ( TypeMirror thrownType : constructor.getThrownTypes() ) {
+            if ( !types.isSubtype( thrownType, runtimeException ) && !types.isSubtype( thrownType, error ) ) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    public void reportErrors() {
+        if ( errorsReported ) {
+            return;
+        }
+        for ( String error : errors ) {
+            processingEnvironment.getMessager().printMessage( Diagnostic.Kind.ERROR, error );
+        }
+        errorsReported = true;
+    }
+
+    public void reportUnresolvedImplementations() {
+        for ( String interfaceName : unresolvedInterfaces ) {
+            processingEnvironment.getMessager().printMessage(
+                Diagnostic.Kind.ERROR,
+                invalidValue(
+                    PROPERTY_PREFIX + interfaceName,
+                    configuredTypes.get( interfaceName ),
+                    "the implementation type could not be resolved"
+                )
+            );
+        }
+    }
+
+    public boolean hasErrors() {
+        return !errors.isEmpty();
+    }
+
+    public Map<String, ConfiguredImplementation> getResolvedImplementations() {
+        return resolvedImplementations;
+    }
+
+    public static class ConfiguredImplementation {
+        private final String qualifiedName;
+        private final boolean initialCapacityConstructor;
+
+        ConfiguredImplementation(String qualifiedName, boolean initialCapacityConstructor) {
+            this.qualifiedName = qualifiedName;
+            this.initialCapacityConstructor = initialCapacityConstructor;
+        }
+
+        public String getQualifiedName() {
+            return qualifiedName;
+        }
+
+        public boolean hasInitialCapacityConstructor() {
+            return initialCapacityConstructor;
+        }
+    }
+}
