+/*
+ * Copyright MapStruct Authors.
+ *
+ * Licensed under the Apache License version 2.0, available at http://www.apache.org/licenses/LICENSE-2.0
+ */
+package org.mapstruct.ap.test.collection.configurableimplementation;
+
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.stream.Stream;
+
+import org.mapstruct.ap.testutil.ProcessorTest;
+import org.mapstruct.ap.testutil.WithClasses;
+import org.mapstruct.ap.testutil.compilation.annotation.ProcessorOption;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+@WithClasses({
+    ConfigurableCollectionMapper.class,
+    CapacityList.class,
+    CapacityMap.class,
+    Source.class,
+    Target.class
+})
+@ProcessorOption(
+    name = "mapstruct.configurationFile",
+    value = "collection-implementations/custom.properties"
+)
+public class ConfigurableCollectionImplementationTest {
+
+    @ProcessorTest
+    public void shouldUseConfiguredImplementationsInAllMappingForms() {
+        List<String> list = ConfigurableCollectionMapper.INSTANCE.map( Arrays.asList( "a", "b" ) );
+        assertThat( list ).isInstanceOf( CapacityList.class );
+        assertThat( ( (CapacityList<?>) list ).getInitialCapacity() ).isEqualTo( 2 );
+
+        Map<String, String> sourceMap = new LinkedHashMap<>();
+        sourceMap.put( "a", "b" );
+        Map<String, String> map = ConfigurableCollectionMapper.INSTANCE.map( sourceMap );
+        assertThat( map ).isInstanceOf( CapacityMap.class );
+        assertThat( ( (CapacityMap<?, ?>) map ).getInitialCapacity() ).isEqualTo( 1 );
+
+        List<String> stream = ConfigurableCollectionMapper.INSTANCE.map( Stream.of( "a", "b" ) );
+        assertThat( stream ).isInstanceOf( CapacityList.class );
+        assertThat( ( (CapacityList<?>) stream ).getInitialCapacity() ).isEqualTo( -1 );
+
+        Source source = new Source();
+        source.setValues( Arrays.asList( "a", "b", "c" ) );
+        Target target = ConfigurableCollectionMapper.INSTANCE.map( source );
+        assertThat( target.getValues() ).isInstanceOf( CapacityList.class );
+        assertThat( ( (CapacityList<?>) target.getValues() ).getInitialCapacity() ).isEqualTo( 3 );
+    }
+}
