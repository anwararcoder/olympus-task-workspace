+package org.mapstruct.ap.internal.option;
+
+/**
+ * A configured implementation for a supported collection or map interface.
+ */
+public class CollectionImplementation {
+
+    private final String implementationType;
+    private final boolean initialCapacityConstructor;
+
+    public CollectionImplementation(String implementationType, boolean initialCapacityConstructor) {
+        this.implementationType = implementationType;
+        this.initialCapacityConstructor = initialCapacityConstructor;
+    }
+
+    public String getImplementationType() {
+        return implementationType;
+    }
+
+    public boolean hasInitialCapacityConstructor() {
+        return initialCapacityConstructor;
+    }
+}
