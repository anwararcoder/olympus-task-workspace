+public class CollectionImplementationTest {
+
+    private static final String TEST_PACKAGE = "org.mapstruct.ap.test.collectionimplementation.";
+    private static final String CONFIGURED_IMPLEMENTATIONS =
+        "mapstruct.collectionImplementation.java.util.List=" + TEST_PACKAGE + "CustomList\n"
+            + "mapstruct.collectionImplementation.java.util.Map=" + TEST_PACKAGE + "CustomMap\n";
