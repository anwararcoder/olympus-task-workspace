+/**
+ * Loads and validates configured implementations for supported collection and map interfaces.
+ */
+public class CollectionImplementationConfiguration {
+
+    public enum ResolutionStatus {
+        READY,
+        PENDING,
+        INVALID
+    }
+
+    private static final String DEFAULT_CONFIGURATION_FILE = "mapstruct.properties";
+    private static final String PROPERTY_PREFIX = "mapstruct.collectionImplementation.";
+    private static final Set<String> SUPPORTED_INTERFACES = Collections.unmodifiableSet(
+        new LinkedHashSet<>( Arrays.asList(
+            "java.lang.Iterable",
+            "java.util.Collection",
+            "java.util.List",
+            "java.util.Set",
+            "java.util.SortedSet",
+            "java.util.NavigableSet",
+            "java.util.Map",
+            "java.util.SortedMap",
+            "java.util.NavigableMap",
+            "java.util.concurrent.ConcurrentMap",
+            "java.util.concurrent.ConcurrentNavigableMap",
+            JavaCollectionConstants.SEQUENCED_SET_FQN,
+            JavaCollectionConstants.SEQUENCED_MAP_FQN
+        ) )
+    );
+
+    private final Map<String, String> configuredTypes;
+    private final Map<String, CollectionImplementation> resolvedImplementations = new LinkedHashMap<>();
+    private boolean invalid;
+    private boolean unresolvedReported;
+
+    private CollectionImplementationConfiguration(Map<String, String> configuredTypes, boolean invalid) {
+        this.configuredTypes = configuredTypes;
+        this.invalid = invalid;
+    }
+
+    public static CollectionImplementationConfiguration load(ProcessingEnvironment processingEnvironment,
+                                                              String configuredFile) {
+        boolean explicitlyConfigured = configuredFile != null;
+        String configurationFile = explicitlyConfigured ? configuredFile : DEFAULT_CONFIGURATION_FILE;
+        if ( configurationFile.isEmpty() ) {
+            processingEnvironment.getMessager().printMessage(
+                Kind.ERROR,
+                "Invalid value '' for processor option 'mapstruct.configurationFile': the resource path is empty."
+            );
+            return new CollectionImplementationConfiguration( Collections.emptyMap(), true );
+        }
+
+        TrackingProperties properties = new TrackingProperties();
+        try {
+            FileObject resource = processingEnvironment.getFiler().getResource( CLASS_PATH, "", configurationFile );
+            try ( InputStream inputStream = resource.openInputStream() ) {
+                properties.load( inputStream );
+            }
+        }
+        catch ( IOException | IllegalArgumentException ex ) {
+            if ( !explicitlyConfigured && ex instanceof IOException ) {
+                return new CollectionImplementationConfiguration( Collections.emptyMap(), false );
+            }
+
+            processingEnvironment.getMessager().printMessage(
+                Kind.ERROR,
+                "Could not load MapStruct configuration resource '" + configurationFile
+                    + "' from the mapping compilation classpath: " + ex.getMessage()
+            );
+            return new CollectionImplementationConfiguration( Collections.emptyMap(), true );
+        }
+
+        boolean invalid = false;
+        for ( DuplicateProperty duplicate : properties.getConflictingDuplicates() ) {
+            processingEnvironment.getMessager().printMessage(
+                Kind.ERROR,
+                "Invalid MapStruct collection implementation property '" + duplicate.key + "': value '"
+                    + duplicate.secondValue + "' conflicts with value '" + duplicate.firstValue + "'."
+            );
+            invalid = true;
+        }
+
+        Map<String, String> configuredTypes = new LinkedHashMap<>();
+        for ( Map.Entry<String, String> property : properties.getEntries().entrySet() ) {
+            String key = property.getKey();
+            String value = property.getValue();
+            if ( !key.startsWith( PROPERTY_PREFIX ) ) {
+                processingEnvironment.getMessager().printMessage(
+                    Kind.ERROR,
+                    "Invalid MapStruct configuration property '" + key + "': unknown property."
+                );
+                invalid = true;
+                continue;
+            }
+
+            String interfaceType = key.substring( PROPERTY_PREFIX.length() );
+            if ( !SUPPORTED_INTERFACES.contains( interfaceType ) ) {
+                processingEnvironment.getMessager().printMessage(
+                    Kind.ERROR,
+                    "Invalid MapStruct collection implementation property '" + key + "': unsupported interface '"
+                        + interfaceType + "'."
+                );
+                invalid = true;
+                continue;
+            }
+
+            if ( value.isEmpty() ) {
+                processingEnvironment.getMessager().printMessage(
+                    Kind.ERROR,
+                    "Invalid MapStruct collection implementation property '" + key
+                        + "': the implementation value is empty."
+                );
+                invalid = true;
+                continue;
+            }
+
+            configuredTypes.put( interfaceType, value );
+        }
+
+        return new CollectionImplementationConfiguration( configuredTypes, invalid );
+    }
+
+    public ResolutionStatus resolve(ProcessingEnvironment processingEnvironment) {
+        if ( invalid ) {
+            return ResolutionStatus.INVALID;
+        }
+
+        Elements elements = processingEnvironment.getElementUtils();
+        Types types = processingEnvironment.getTypeUtils();
+        boolean pending = false;
+        boolean validationFailed = false;
+        Map<String, CollectionImplementation> resolved = new LinkedHashMap<>();
+        for ( Map.Entry<String, String> configuredType : configuredTypes.entrySet() ) {
+            String interfaceType = configuredType.getKey();
+            String implementationType = configuredType.getValue();
+            TypeElement implementationElement = elements.getTypeElement( implementationType );
+            if ( implementationElement == null ) {
+                pending = true;
+                continue;
+            }
+
+            ValidationResult validationResult = validate(
+                interfaceType,
+                implementationElement,
+                elements,
+                types
+            );
+            if ( validationResult.error != null ) {
+                processingEnvironment.getMessager().printMessage(
+                    Kind.ERROR,
+                    "Invalid value '" + implementationType + "' for MapStruct collection implementation property '"
+                        + PROPERTY_PREFIX + interfaceType + "': " + validationResult.error
+                );
+                validationFailed = true;
+            }
+            else {
+                resolved.put(
+                    interfaceType,
+                    new CollectionImplementation( implementationType, validationResult.initialCapacityConstructor )
+                );
+            }
+        }
+
+        resolvedImplementations.clear();
+        resolvedImplementations.putAll( resolved );
+        invalid = validationFailed;
+        if ( invalid ) {
+            return ResolutionStatus.INVALID;
+        }
+        return pending ? ResolutionStatus.PENDING : ResolutionStatus.READY;
+    }
+
+    public void reportUnresolved(ProcessingEnvironment processingEnvironment) {
+        if ( unresolvedReported ) {
+            return;
+        }
+        unresolvedReported = true;
+
+        Elements elements = processingEnvironment.getElementUtils();
+        for ( Map.Entry<String, String> configuredType : configuredTypes.entrySet() ) {
+            if ( elements.getTypeElement( configuredType.getValue() ) == null ) {
+                processingEnvironment.getMessager().printMessage(
+                    Kind.ERROR,
+                    "Invalid value '" + configuredType.getValue()
+                        + "' for MapStruct collection implementation property '" + PROPERTY_PREFIX
+                        + configuredType.getKey() + "': the implementation type could not be found."
+                );
+            }
+        }
+    }
+
+    public Map<String, CollectionImplementation> getResolvedImplementations() {
+        return Collections.unmodifiableMap( resolvedImplementations );
+    }
+
+    private static ValidationResult validate(String interfaceName, TypeElement implementation, Elements elements,
+                                             Types types) {
+        if ( implementation.getKind() != ElementKind.CLASS ) {
+            return ValidationResult.error( "the implementation type is not a class." );
+        }
+        if ( implementation.getModifiers().contains( Modifier.ABSTRACT ) ) {
+            return ValidationResult.error( "the implementation class is abstract." );
+        }
+        if ( !isPubliclyAccessible( implementation ) ) {
+            return ValidationResult.error( "the implementation class is not publicly accessible." );
+        }
+        if ( implementation.getNestingKind() == NestingKind.MEMBER
+            && !implementation.getModifiers().contains( Modifier.STATIC ) ) {
+            return ValidationResult.error( "the implementation class is a non-static member class." );
+        }
+
+        TypeElement interfaceElement = elements.getTypeElement( interfaceName );
+        if ( interfaceElement == null ) {
+            return ValidationResult.error( "the configured interface is not available for this source version." );
+        }
+
+        List<? extends TypeParameterElement> interfaceParameters = interfaceElement.getTypeParameters();
+        List<? extends TypeParameterElement> implementationParameters = implementation.getTypeParameters();
+        if ( interfaceParameters.size() != implementationParameters.size() ) {
+            return ValidationResult.error(
+                "the implementation declares " + implementationParameters.size() + " type parameter(s), but '"
+                    + interfaceName + "' declares " + interfaceParameters.size() + "."
+            );
+        }
+        for ( TypeParameterElement parameter : implementationParameters ) {
+            if ( !isUnbounded( parameter, elements, types ) ) {
+                return ValidationResult.error(
+                    "implementation type parameter '" + parameter.getSimpleName() + "' is bounded."
+                );
+            }
+        }
+
+        DeclaredType interfaceSupertype = findSupertype( implementation.asType(), interfaceElement, types );
+        if ( interfaceSupertype == null ) {
+            return ValidationResult.error( "the implementation is not assignable to '" + interfaceName + "'." );
+        }
+        List<? extends TypeMirror> interfaceArguments = interfaceSupertype.getTypeArguments();
+        if ( interfaceArguments.size() != implementationParameters.size() ) {
+            return ValidationResult.error(
+                "the implementation does not preserve the type parameters of '" + interfaceName + "'."
+            );
+        }
+        for ( int i = 0; i < implementationParameters.size(); i++ ) {
+            if ( !types.isSameType( interfaceArguments.get( i ), implementationParameters.get( i ).asType() ) ) {
+                return ValidationResult.error(
+                    "the implementation does not preserve the type parameters of '" + interfaceName + "'."
+                );
+            }
+        }
+
+        List<ExecutableElement> constructors = ElementFilter.constructorsIn( implementation.getEnclosedElements() );
+        ExecutableElement noArgumentConstructor = null;
+        if ( !constructors.isEmpty() ) {
+            for ( ExecutableElement constructor : constructors ) {
+                if ( constructor.getModifiers().contains( Modifier.PUBLIC ) && constructor.getParameters().isEmpty() ) {
+                    noArgumentConstructor = constructor;
+                    break;
+                }
+            }
+            if ( noArgumentConstructor == null ) {
+                return ValidationResult.error( "the implementation has no public no-argument constructor." );
+            }
+            if ( declaresCheckedException( noArgumentConstructor, elements, types ) ) {
+                return ValidationResult.error( "the public no-argument constructor declares a checked exception." );
+            }
+        }
+
+        boolean initialCapacityConstructor = false;
+        for ( ExecutableElement constructor : constructors ) {
+            if ( constructor.getModifiers().contains( Modifier.PUBLIC )
+                && constructor.getParameters().size() == 1
+                && constructor.getParameters().get( 0 ).asType().getKind() == TypeKind.INT
+                && !declaresCheckedException( constructor, elements, types ) ) {
+                initialCapacityConstructor = true;
+                break;
+            }
+        }
+        return ValidationResult.valid( initialCapacityConstructor );
+    }
+
+    private static boolean isPubliclyAccessible(TypeElement type) {
+        Element current = type;
+        while ( current instanceof TypeElement ) {
+            if ( !current.getModifiers().contains( Modifier.PUBLIC ) ) {
+                return false;
+            }
+            current = current.getEnclosingElement();
+        }
+        return true;
+    }
+
+    private static boolean isUnbounded(TypeParameterElement parameter, Elements elements, Types types) {
+        List<? extends TypeMirror> bounds = parameter.getBounds();
+        TypeElement objectElement = elements.getTypeElement( Object.class.getName() );
+        return bounds.size() == 1 && types.isSameType( bounds.get( 0 ), objectElement.asType() );
+    }
+
+    private static DeclaredType findSupertype(TypeMirror type, TypeElement interfaceElement, Types types) {
+        if ( type.getKind() != TypeKind.DECLARED ) {
+            return null;
+        }
+        if ( types.isSameType( types.erasure( type ), types.erasure( interfaceElement.asType() ) ) ) {
+            return (DeclaredType) type;
+        }
+        for ( TypeMirror supertype : types.directSupertypes( type ) ) {
+            DeclaredType result = findSupertype( supertype, interfaceElement, types );
+            if ( result != null ) {
+                return result;
+            }
+        }
+        return null;
+    }
+
+    private static boolean declaresCheckedException(ExecutableElement constructor, Elements elements, Types types) {
+        TypeMirror runtimeException = elements.getTypeElement( RuntimeException.class.getName() ).asType();
+        TypeMirror error = elements.getTypeElement( Error.class.getName() ).asType();
+        for ( TypeMirror thrownType : constructor.getThrownTypes() ) {
+            if ( !types.isSubtype( thrownType, runtimeException ) && !types.isSubtype( thrownType, error ) ) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private static class TrackingProperties extends Properties {
+
+        private final Map<String, String> entries = new LinkedHashMap<>();
+        private final List<DuplicateProperty> conflictingDuplicates = new ArrayList<>();
+
+        @Override
+        public synchronized Object put(Object key, Object value) {
+            String stringKey = (String) key;
+            String stringValue = (String) value;
+            String previousValue = entries.get( stringKey );
+            if ( previousValue == null ) {
+                entries.put( stringKey, stringValue );
+            }
+            else if ( !previousValue.equals( stringValue ) ) {
+                conflictingDuplicates.add( new DuplicateProperty( stringKey, previousValue, stringValue ) );
+            }
+            return super.put( key, value );
+        }
+
+        Map<String, String> getEntries() {
+            return entries;
+        }
+
+        List<DuplicateProperty> getConflictingDuplicates() {
+            return conflictingDuplicates;
+        }
+    }
+
+    private static class DuplicateProperty {
+
+        private final String key;
+        private final String firstValue;
+        private final String secondValue;
+
+        private DuplicateProperty(String key, String firstValue, String secondValue) {
+            this.key = key;
+            this.firstValue = firstValue;
+            this.secondValue = secondValue;
+        }
+    }
+
+    private static class ValidationResult {
+
+        private final String error;
+        private final boolean initialCapacityConstructor;
+
+        private ValidationResult(String error, boolean initialCapacityConstructor) {
+            this.error = error;
+            this.initialCapacityConstructor = initialCapacityConstructor;
+        }
+
+        private static ValidationResult error(String error) {
+            return new ValidationResult( error, false );
+        }
+
+        private static ValidationResult valid(boolean initialCapacityConstructor) {
+            return new ValidationResult( null, initialCapacityConstructor );
+        }
+    }
+}
