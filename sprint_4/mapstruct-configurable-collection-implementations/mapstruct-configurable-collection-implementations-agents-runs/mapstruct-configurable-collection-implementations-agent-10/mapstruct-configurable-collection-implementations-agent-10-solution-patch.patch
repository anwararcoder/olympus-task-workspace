--- /dev/null
+++ b/processor/src/main/java/org/mapstruct/ap/internal/option/CollectionImplementationConfiguration.java
@@ -0,0 +1,356 @@
+/*
+ * Copyright MapStruct Authors.
+ *
+ * Licensed under the Apache License version 2.0, available at http://www.apache.org/licenses/LICENSE-2.0
+ */
+package org.mapstruct.ap.internal.option;
+
+import java.io.BufferedReader;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.InputStreamReader;
+import java.io.StringReader;
+import java.nio.charset.StandardCharsets;
+import java.util.Arrays;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Properties;
+import java.util.Set;
+import javax.annotation.processing.Filer;
+import javax.annotation.processing.Messager;
+import javax.lang.model.element.Element;
+import javax.lang.model.element.ElementKind;
+import javax.lang.model.element.ExecutableElement;
+import javax.lang.model.element.Modifier;
+import javax.lang.model.element.TypeElement;
+import javax.lang.model.element.TypeParameterElement;
+import javax.lang.model.type.DeclaredType;
+import javax.lang.model.type.TypeKind;
+import javax.lang.model.type.TypeMirror;
+import javax.lang.model.util.ElementFilter;
+import javax.lang.model.util.Elements;
+import javax.lang.model.util.Types;
+import javax.tools.Diagnostic;
+import javax.tools.FileObject;
+import javax.tools.StandardLocation;
+
+/**
+ * Configured concrete implementations for supported collection and map interfaces.
+ */
+public class CollectionImplementationConfiguration {
+
+    private static final String DEFAULT_RESOURCE = "mapstruct.properties";
+    private static final String PROPERTY_PREFIX = "mapstruct.collectionImplementation.";
+    private static final Set<String> SUPPORTED_INTERFACES = new HashSet<>( Arrays.asList(
+        "java.lang.Iterable",
+        "java.util.Collection",
+        "java.util.List",
+        "java.util.Set",
+        "java.util.SortedSet",
+        "java.util.NavigableSet",
+        "java.util.Map",
+        "java.util.SortedMap",
+        "java.util.NavigableMap",
+        "java.util.concurrent.ConcurrentMap",
+        "java.util.concurrent.ConcurrentNavigableMap",
+        "java.util.SequencedSet",
+        "java.util.SequencedMap"
+    ) );
+
+    private final Map<String, ConfiguredImplementation> implementations = new HashMap<>();
+    private final Messager messager;
+
+    private CollectionImplementationConfiguration(Messager messager) {
+        this.messager = messager;
+    }
+
+    public static CollectionImplementationConfiguration load(
+        Filer filer,
+        Messager messager,
+        String configuredResource
+    ) {
+        CollectionImplementationConfiguration configuration = new CollectionImplementationConfiguration( messager );
+        boolean explicitlyConfigured = configuredResource != null;
+        String resource = explicitlyConfigured ? configuredResource : DEFAULT_RESOURCE;
+
+        if ( resource.isEmpty() ) {
+            configuration.error( "Invalid value for 'mapstruct.configurationFile': the resource path is empty" );
+            return configuration;
+        }
+
+        try {
+            FileObject file = filer.getResource( StandardLocation.CLASS_PATH, "", resource );
+            try ( InputStream inputStream = file.openInputStream() ) {
+                configuration.loadProperties( inputStream );
+            }
+        }
+        catch ( IOException | IllegalArgumentException ex ) {
+            if ( explicitlyConfigured ) {
+                configuration.error(
+                    "Invalid value '" + resource + "' for 'mapstruct.configurationFile': resource could not be read (" +
+                        ex.getMessage() + ")"
+                );
+            }
+        }
+
+        return configuration;
+    }
+
+    private void loadProperties(InputStream inputStream) throws IOException {
+        try ( BufferedReader reader = new BufferedReader(
+            new InputStreamReader( inputStream, StandardCharsets.ISO_8859_1 )
+        ) ) {
+            StringBuilder logicalLine = new StringBuilder();
+            String line;
+            while ( ( line = reader.readLine() ) != null ) {
+                logicalLine.append( line ).append( '\n' );
+                if ( continues( line ) ) {
+                    continue;
+                }
+                loadProperty( logicalLine.toString() );
+                logicalLine.setLength( 0 );
+            }
+            if ( logicalLine.length() > 0 ) {
+                loadProperty( logicalLine.toString() );
+            }
+        }
+        catch ( IllegalArgumentException ex ) {
+            error( "Invalid mapstruct properties resource: " + ex.getMessage() );
+        }
+    }
+
+    private void loadProperty(String logicalLine) throws IOException {
+        Properties property = new Properties();
+        property.load( new StringReader( logicalLine ) );
+        if ( property.isEmpty() ) {
+            return;
+        }
+
+        String key = property.stringPropertyNames().iterator().next();
+        String value = property.getProperty( key );
+        if ( !key.startsWith( PROPERTY_PREFIX ) ) {
+            error( "Invalid property '" + key + "': unknown MapStruct configuration property" );
+            return;
+        }
+
+        String interfaceName = key.substring( PROPERTY_PREFIX.length() );
+        if ( !SUPPORTED_INTERFACES.contains( interfaceName ) ) {
+            error( "Invalid property '" + key + "': unsupported collection or map interface '" + interfaceName + "'" );
+            return;
+        }
+        if ( value.trim().isEmpty() ) {
+            error( "Invalid value for property '" + key + "': implementation type is empty" );
+            return;
+        }
+
+        ConfiguredImplementation previous = implementations.get( interfaceName );
+        if ( previous != null && !previous.qualifiedName.equals( value ) ) {
+            error(
+                "Invalid value '" + value + "' for property '" + key + "': conflicts with duplicate value '" +
+                    previous.qualifiedName + "'"
+            );
+            return;
+        }
+        implementations.put( interfaceName, new ConfiguredImplementation( key, value ) );
+    }
+
+    private static boolean continues(String line) {
+        int backslashes = 0;
+        for ( int i = line.length() - 1; i >= 0 && line.charAt( i ) == '\\'; i-- ) {
+            backslashes++;
+        }
+        return backslashes % 2 != 0;
+    }
+
+    public void resolve(Elements elements, Types types) {
+        TypeElement runtimeException = elements.getTypeElement( RuntimeException.class.getCanonicalName() );
+        TypeElement error = elements.getTypeElement( Error.class.getCanonicalName() );
+
+        for ( Map.Entry<String, ConfiguredImplementation> entry : implementations.entrySet() ) {
+            ConfiguredImplementation configured = entry.getValue();
+            if ( configured.resolved || configured.invalid ) {
+                continue;
+            }
+
+            TypeElement interfaceElement = elements.getTypeElement( entry.getKey() );
+            if ( interfaceElement == null ) {
+                invalid( configured, "the configured interface is not available for this source version" );
+                continue;
+            }
+
+            TypeElement implementationElement = elements.getTypeElement( configured.qualifiedName );
+            if ( implementationElement == null ) {
+                continue;
+            }
+
+            String invalidCause = validateType(
+                interfaceElement,
+                implementationElement,
+                runtimeException.asType(),
+                error.asType(),
+                types
+            );
+            if ( invalidCause != null ) {
+                invalid( configured, invalidCause );
+                continue;
+            }
+
+            configured.initialCapacityConstructor = hasUsableConstructor(
+                implementationElement,
+                1,
+                runtimeException.asType(),
+                error.asType(),
+                types
+            );
+            configured.resolved = true;
+        }
+    }
+
+    private static String validateType(TypeElement interfaceElement, TypeElement implementationElement,
+                                       TypeMirror runtimeException, TypeMirror error, Types types) {
+        if ( implementationElement.getKind() != ElementKind.CLASS ||
+            implementationElement.getModifiers().contains( Modifier.ABSTRACT ) ) {
+            return "the implementation must be a concrete class";
+        }
+        if ( !isPubliclyAccessible( implementationElement ) ) {
+            return "the implementation must be publicly accessible";
+        }
+        if ( implementationElement.getNestingKind().isNested() &&
+            !implementationElement.getModifiers().contains( Modifier.STATIC ) ) {
+            return "the implementation must not be a non-static nested class";
+        }
+
+        List<? extends TypeParameterElement> interfaceParameters = interfaceElement.getTypeParameters();
+        List<? extends TypeParameterElement> implementationParameters = implementationElement.getTypeParameters();
+        if ( interfaceParameters.size() != implementationParameters.size() ) {
+            return "the implementation must declare the same number of type parameters as the interface";
+        }
+        for ( TypeParameterElement parameter : implementationParameters ) {
+            List<? extends TypeMirror> bounds = parameter.getBounds();
+            if ( bounds.size() != 1 || !"java.lang.Object".equals( bounds.get( 0 ).toString() ) ) {
+                return "the implementation type parameters must be unbounded";
+            }
+        }
+
+        TypeMirror[] typeArguments = new TypeMirror[implementationParameters.size()];
+        for ( int i = 0; i < implementationParameters.size(); i++ ) {
+            typeArguments[i] = implementationParameters.get( i ).asType();
+        }
+        DeclaredType implementationType = types.getDeclaredType( implementationElement, typeArguments );
+        DeclaredType interfaceType = types.getDeclaredType( interfaceElement, typeArguments );
+        if ( !types.isAssignable( implementationType, interfaceType ) ) {
+            return "the implementation must preserve and be assignable to the interface type parameters";
+        }
+        if ( !hasUsableConstructor( implementationElement, 0, runtimeException, error, types ) ) {
+            return "the implementation must expose a public no-argument constructor " +
+                "that declares no checked exceptions";
+        }
+        return null;
+    }
+
+    private static boolean isPubliclyAccessible(TypeElement type) {
+        Element current = type;
+        while ( current instanceof TypeElement ) {
+            if ( !current.getModifiers().contains( Modifier.PUBLIC ) ) {
+                return false;
+            }
+            current = current.getEnclosingElement();
+        }
+        return true;
+    }
+
+    private static boolean hasUsableConstructor(TypeElement type, int parameterCount, TypeMirror runtimeException,
+                                                TypeMirror error, Types types) {
+        for ( ExecutableElement constructor : ElementFilter.constructorsIn( type.getEnclosedElements() ) ) {
+            if ( !constructor.getModifiers().contains( Modifier.PUBLIC ) ||
+                constructor.getParameters().size() != parameterCount ) {
+                continue;
+            }
+            if ( parameterCount == 1 && constructor.getParameters().get( 0 ).asType().getKind() != TypeKind.INT ) {
+                continue;
+            }
+            boolean checkedException = false;
+            for ( TypeMirror thrownType : constructor.getThrownTypes() ) {
+                if ( !types.isAssignable( thrownType, runtimeException ) && !types.isAssignable( thrownType, error ) ) {
+                    checkedException = true;
+                    break;
+                }
+            }
+            if ( !checkedException ) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    public Implementation get(String interfaceName) {
+        ConfiguredImplementation configured = implementations.get( interfaceName );
+        if ( configured == null || configured.invalid ) {
+            return null;
+        }
+        if ( !configured.resolved ) {
+            return Implementation.unresolved();
+        }
+        return new Implementation( configured.qualifiedName, configured.initialCapacityConstructor, false );
+    }
+
+    public void reportUnresolved() {
+        for ( ConfiguredImplementation configured : implementations.values() ) {
+            if ( !configured.resolved && !configured.invalid ) {
+                invalid( configured, "the implementation type could not be found" );
+            }
+        }
+    }
+
+    private void invalid(ConfiguredImplementation configured, String cause) {
+        configured.invalid = true;
+        error( "Invalid value '" + configured.qualifiedName + "' for property '" + configured.key + "': " + cause );
+    }
+
+    private void error(String message) {
+        messager.printMessage( Diagnostic.Kind.ERROR, message );
+    }
+
+    private static class ConfiguredImplementation {
+        private final String key;
+        private final String qualifiedName;
+        private boolean resolved;
+        private boolean invalid;
+        private boolean initialCapacityConstructor;
+
+        private ConfiguredImplementation(String key, String qualifiedName) {
+            this.key = key;
+            this.qualifiedName = qualifiedName;
+        }
+    }
+
+    public static class Implementation {
+        private final String qualifiedName;
+        private final boolean initialCapacityConstructor;
+        private final boolean unresolved;
+
+        private Implementation(String qualifiedName, boolean initialCapacityConstructor, boolean unresolved) {
+            this.qualifiedName = qualifiedName;
+            this.initialCapacityConstructor = initialCapacityConstructor;
+            this.unresolved = unresolved;
+        }
+
+        private static Implementation unresolved() {
+            return new Implementation( null, false, true );
+        }
+
+        public String getQualifiedName() {
+            return qualifiedName;
+        }
+
+        public boolean hasInitialCapacityConstructor() {
+            return initialCapacityConstructor;
+        }
+
+        public boolean isUnresolved() {
+            return unresolved;
+        }
+    }
+}
