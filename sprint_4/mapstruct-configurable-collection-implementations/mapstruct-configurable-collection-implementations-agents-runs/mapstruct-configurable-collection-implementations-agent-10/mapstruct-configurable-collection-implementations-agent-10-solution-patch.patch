+/*
+ * Copyright MapStruct Authors.
+ *
+ * Licensed under the Apache License version 2.0, available at http://www.apache.org/licenses/LICENSE-2.0
+ */
+package org.mapstruct.ap.test.collection.configurable;
+
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.LinkedList;
+import java.util.List;
+import java.util.Map;
+import java.util.stream.Stream;
+
+import org.mapstruct.ap.testutil.ProcessorTest;
+import org.mapstruct.ap.testutil.WithClasses;
+import org.mapstruct.ap.testutil.compilation.annotation.ProcessorOption;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+@WithClasses({
+    BeanCopyMapper.class,
+    BeanFactoryMapper.class,
+    CapacityList.class,
+    CapacityMap.class,
+    ConfigurableCollectionMapper.class,
+    FactoryMapper.class,
+    Source.class,
+    Target.class
+})
+@ProcessorOption(
+    name = "mapstruct.configurationFile",
+    value = "collection-implementations/valid.properties"
+)
+public class ConfigurableCollectionImplementationTest {
+
+    @ProcessorTest
+    public void shouldUseConfiguredImplementationsAndCapacityConstructors() {
+        List<String> sourceList = Arrays.asList( "one", "two" );
+        Map<String, String> sourceMap = new LinkedHashMap<>();
+        sourceMap.put( "one", "1" );
+        sourceMap.put( "two", "2" );
+
+        List<String> list = ConfigurableCollectionMapper.INSTANCE.copy( sourceList );
+        Map<String, String> map = ConfigurableCollectionMapper.INSTANCE.copy( sourceMap );
+
+        assertThat( list ).isInstanceOf( CapacityList.class );
+        assertThat( ( (CapacityList<?>) list ).getInitialCapacity() ).isEqualTo( sourceList.size() );
+        assertThat( map ).isInstanceOf( CapacityMap.class );
+        assertThat( ( (CapacityMap<?, ?>) map ).getInitialCapacity() ).isEqualTo( sourceMap.size() );
+    }
+
+    @ProcessorTest
+    public void shouldUseConfiguredImplementationForBeanPropertyCopy() {
+        Source source = new Source();
+        source.setValues( Arrays.asList( "one", "two", "three" ) );
+
+        Target target = BeanCopyMapper.INSTANCE.map( source );
+
+        assertThat( target.getValues() ).isInstanceOf( CapacityList.class );
+        assertThat( ( (CapacityList<?>) target.getValues() ).getInitialCapacity() ).isEqualTo( 3 );
+    }
+
+    @ProcessorTest
+    public void shouldUseConfiguredImplementationForStreamResult() {
+        List<String> result = ConfigurableCollectionMapper.INSTANCE.fromStream( Stream.of( "one", "two" ) );
+
+        assertThat( result ).isInstanceOf( CapacityList.class );
+        assertThat( result ).containsExactly( "one", "two" );
+    }
+
+    @ProcessorTest
+    public void shouldPreferObjectFactoryOverConfiguredImplementation() {
+        List<String> result = FactoryMapper.INSTANCE.copy( Arrays.asList( "one", "two" ) );
+
+        assertThat( result ).isInstanceOf( LinkedList.class );
+    }
+
+    @ProcessorTest
+    public void shouldPreferObjectFactoryForDirectBeanPropertyCopy() {
+        Source source = new Source();
+        source.setValues( Arrays.asList( "one", "two" ) );
+
+        Target target = BeanFactoryMapper.INSTANCE.map( source );
+
+        assertThat( target.getValues() ).isInstanceOf( LinkedList.class );
+    }
+}
