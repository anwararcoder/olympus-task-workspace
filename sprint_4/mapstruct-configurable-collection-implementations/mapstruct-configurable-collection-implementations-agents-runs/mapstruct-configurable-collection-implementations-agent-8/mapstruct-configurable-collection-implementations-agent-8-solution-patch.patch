+ * Licensed under the Apache License version 2.0, available at http://www.apache.org/licenses/LICENSE-2.0
+ */
+package org.mapstruct.ap.internal.option;
+
+import java.io.FileNotFoundException;
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.file.NoSuchFileException;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Properties;
+import java.util.Set;
+import javax.annotation.processing.ProcessingEnvironment;
+import javax.lang.model.element.Element;
+import javax.lang.model.element.ElementKind;
+import javax.lang.model.element.ExecutableElement;
+import javax.lang.model.element.Modifier;
+import javax.lang.model.element.NestingKind;
+import javax.lang.model.element.TypeElement;
+import javax.lang.model.element.TypeParameterElement;
+import javax.lang.model.type.DeclaredType;
+import javax.lang.model.type.TypeKind;
+import javax.lang.model.type.TypeMirror;
+import javax.lang.model.util.ElementFilter;
+import javax.lang.model.util.Elements;
+import javax.lang.model.util.Types;
+import javax.tools.FileObject;
+import javax.tools.StandardLocation;
+
+/**
+ * Configuration for replacing the built-in implementations of supported collection and map interfaces.
+ */
+public final class CollectionImplementationConfiguration {
+
+    private static final String DEFAULT_RESOURCE = "mapstruct.properties";
+    private static final String PROPERTY_PREFIX = "mapstruct.collectionImplementation.";
+    private static final Set<String> SUPPORTED_INTERFACES = Collections.unmodifiableSet( new LinkedHashSet<>(
+        Arrays.asList(
+            "java.lang.Iterable",
+            "java.util.Collection",
+            "java.util.List",
+            "java.util.Set",
+            "java.util.SortedSet",
+            "java.util.NavigableSet",
+            "java.util.Map",
+            "java.util.SortedMap",
+            "java.util.NavigableMap",
+            "java.util.concurrent.ConcurrentMap",
+            "java.util.concurrent.ConcurrentNavigableMap",
+            "java.util.SequencedSet",
+            "java.util.SequencedMap"
+        )
+    ) );
+
+    private final Map<String, String> configuredImplementations;
+    private final List<String> errors;
+    private Map<String, ConfiguredImplementation> resolvedImplementations = Collections.emptyMap();
+    private List<String> unresolvedImplementations = Collections.emptyList();
+
+    private CollectionImplementationConfiguration(Map<String, String> configuredImplementations, List<String> errors) {
+        this.configuredImplementations = configuredImplementations;
+        this.errors = errors;
+    }
+
+    public static CollectionImplementationConfiguration load(ProcessingEnvironment processingEnvironment,
+                                                              String configuredResource) {
+        boolean explicitlyConfigured = configuredResource != null;
+        String resource = explicitlyConfigured ? configuredResource : DEFAULT_RESOURCE;
+        Map<String, String> entries = new LinkedHashMap<>();
+        List<String> errors = new ArrayList<>();
+
+        if ( resource.isEmpty() ) {
+            errors.add( "Invalid value for 'mapstruct.configurationFile': the resource path must not be empty" );
+            return new CollectionImplementationConfiguration( entries, errors );
+        }
+
+        try {
+            FileObject resourceFile = processingEnvironment.getFiler()
+                .getResource( StandardLocation.CLASS_PATH, "", resource );
+            try ( InputStream inputStream = resourceFile.openInputStream() ) {
+                DuplicateDetectingProperties properties = new DuplicateDetectingProperties();
+                properties.load( inputStream );
+                errors.addAll( properties.getErrors() );
+                for ( Map.Entry<Object, Object> entry : properties.entrySet() ) {
+                    String key = (String) entry.getKey();
+                    String value = (String) entry.getValue();
+                    if ( !key.startsWith( PROPERTY_PREFIX ) ) {
+                        errors.add( invalidKey( key, "unknown property" ) );
+                        continue;
+                    }
+                    String interfaceName = key.substring( PROPERTY_PREFIX.length() );
+                    if ( !SUPPORTED_INTERFACES.contains( interfaceName ) ) {
+                        errors.add(
+                            invalidKey( key, "unsupported collection or map interface '" + interfaceName + "'" )
+                        );
+                        continue;
+                    }
+                    if ( value.trim().isEmpty() ) {
+                        errors.add( invalidValue( key, value, "implementation name must not be empty" ) );
+                        continue;
+                    }
+                    entries.put( interfaceName, value.trim() );
+                }
+            }
+        }
+        catch ( FileNotFoundException | NoSuchFileException e ) {
+            if ( explicitlyConfigured ) {
+                errors.add( "Configuration resource '" + resource + "' selected by 'mapstruct.configurationFile'"
+                    + " was not found on the mapping compilation classpath" );
+            }
+        }
+        catch ( IllegalArgumentException e ) {
+            errors.add( "Invalid Java properties resource '" + resource + "': " + e.getMessage() );
+        }
+        catch ( IOException e ) {
+            errors.add( "Could not read configuration resource '" + resource + "' from the mapping compilation"
+                + " classpath: " + e.getMessage() );
+        }
+
+        return new CollectionImplementationConfiguration( entries, errors );
+    }
+
+    public Resolution resolve(ProcessingEnvironment processingEnvironment) {
+        if ( !errors.isEmpty() ) {
+            return Resolution.INVALID;
+        }
+
+        Elements elements = processingEnvironment.getElementUtils();
+        Types types = processingEnvironment.getTypeUtils();
+        Map<String, ConfiguredImplementation> resolved = new LinkedHashMap<>();
+        List<String> unresolved = new ArrayList<>();
+
+        for ( Map.Entry<String, String> entry : configuredImplementations.entrySet() ) {
+            String interfaceName = entry.getKey();
+            String implementationName = entry.getValue();
+            String key = PROPERTY_PREFIX + interfaceName;
+            TypeElement implementation = elements.getTypeElement( implementationName );
+            if ( implementation == null ) {
+                unresolved.add( invalidValue( key, implementationName, "type is not available" ) );
+                continue;
+            }
+
+            TypeElement interfaceElement = elements.getTypeElement( interfaceName );
+            if ( interfaceElement == null ) {
+                errors.add( invalidKey( key, "interface is not available for the configured source level" ) );
+                continue;
+            }
+
+            String validationError = validate( interfaceElement, implementation, elements, types );
+            if ( validationError != null ) {
+                errors.add( invalidValue( key, implementationName, validationError ) );
+                continue;
+            }
+
+            resolved.put(
+                interfaceName,
+                new ConfiguredImplementation( implementationName, hasUsableIntConstructor( implementation, types,
+                    elements ) )
+            );
+        }
+
+        resolvedImplementations = Collections.unmodifiableMap( resolved );
+        unresolvedImplementations = Collections.unmodifiableList( unresolved );
+        if ( !errors.isEmpty() ) {
+            return Resolution.INVALID;
+        }
+        return unresolved.isEmpty() ? Resolution.VALID : Resolution.UNRESOLVED;
+    }
+
+    public Map<String, ConfiguredImplementation> getResolvedImplementations() {
+        return resolvedImplementations;
+    }
+
+    public List<String> getErrors() {
+        return errors;
+    }
+
+    public List<String> getUnresolvedImplementations() {
+        return unresolvedImplementations;
+    }
+
+    private static String validate(TypeElement interfaceElement, TypeElement implementation, Elements elements,
+                                   Types types) {
+        if ( implementation.getKind() != ElementKind.CLASS
+            || implementation.getModifiers().contains( Modifier.ABSTRACT ) ) {
+            return "type must be a concrete class";
+        }
+        if ( !isPubliclyAccessible( implementation ) ) {
+            return "type must be publicly accessible";
+        }
+        if ( !types.isAssignable(
+            types.erasure( implementation.asType() ),
+            types.erasure( interfaceElement.asType() )
+        ) ) {
+            return "type is not assignable to '" + interfaceElement.getQualifiedName() + "'";
+        }
+        if ( !hasMatchingUnboundedTypeParameters( interfaceElement, implementation, elements, types ) ) {
+            return "type must declare the same number of unbounded type parameters and preserve the interface type"
+                + " parameters";
+        }
+        if ( !hasUsableNoArgConstructor( implementation, types, elements ) ) {
+            return "type must expose a public no-argument constructor that declares no checked exceptions";
+        }
+        return null;
+    }
+
+    private static boolean isPubliclyAccessible(TypeElement type) {
+        Element current = type;
+        while ( current instanceof TypeElement ) {
+            if ( !current.getModifiers().contains( Modifier.PUBLIC ) ) {
+                return false;
+            }
+            TypeElement currentType = (TypeElement) current;
+            if ( currentType.getNestingKind() == NestingKind.MEMBER
+                && !currentType.getModifiers().contains( Modifier.STATIC ) ) {
+                return false;
+            }
+            current = current.getEnclosingElement();
+        }
+        return true;
+    }
+
+    private static boolean hasMatchingUnboundedTypeParameters(TypeElement interfaceElement, TypeElement implementation,
+                                                               Elements elements, Types types) {
+        List<? extends TypeParameterElement> interfaceParameters = interfaceElement.getTypeParameters();
+        List<? extends TypeParameterElement> implementationParameters = implementation.getTypeParameters();
+        if ( interfaceParameters.size() != implementationParameters.size() ) {
+            return false;
+        }
+
+        TypeMirror objectType = elements.getTypeElement( Object.class.getCanonicalName() ).asType();
+        for ( TypeParameterElement parameter : implementationParameters ) {
+            List<? extends TypeMirror> bounds = parameter.getBounds();
+            if ( bounds.size() != 1 || !types.isSameType( bounds.get( 0 ), objectType ) ) {
+                return false;
+            }
+        }
+
+        DeclaredType preservedInterface = findInterface( implementation.asType(), interfaceElement, types );
+        if ( preservedInterface == null
+            || preservedInterface.getTypeArguments().size() != implementationParameters.size() ) {
+            return false;
+        }
+        for ( int i = 0; i < implementationParameters.size(); i++ ) {
+            if ( !types.isSameType(
+                preservedInterface.getTypeArguments().get( i ),
+                implementationParameters.get( i ).asType()
+            ) ) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private static DeclaredType findInterface(TypeMirror type, TypeElement interfaceElement, Types types) {
+        if ( type.getKind() != TypeKind.DECLARED ) {
+            return null;
+        }
+        DeclaredType declaredType = (DeclaredType) type;
+        if ( types.isSameType( types.erasure( declaredType ), types.erasure( interfaceElement.asType() ) ) ) {
+            return declaredType;
+        }
+        for ( TypeMirror supertype : types.directSupertypes( declaredType ) ) {
+            DeclaredType match = findInterface( supertype, interfaceElement, types );
+            if ( match != null ) {
+                return match;
+            }
+        }
+        return null;
+    }
+
+    private static boolean hasUsableNoArgConstructor(TypeElement implementation, Types types, Elements elements) {
+        for ( ExecutableElement constructor : ElementFilter.constructorsIn( implementation.getEnclosedElements() ) ) {
+            if ( constructor.getParameters().isEmpty()
+                && constructor.getModifiers().contains( Modifier.PUBLIC )
+                && declaresNoCheckedExceptions( constructor, types, elements ) ) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private static boolean hasUsableIntConstructor(TypeElement implementation, Types types, Elements elements) {
+        for ( ExecutableElement constructor : ElementFilter.constructorsIn( implementation.getEnclosedElements() ) ) {
+            if ( constructor.getParameters().size() == 1
+                && constructor.getParameters().get( 0 ).asType().getKind() == TypeKind.INT
+                && constructor.getModifiers().contains( Modifier.PUBLIC )
+                && declaresNoCheckedExceptions( constructor, types, elements ) ) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private static boolean declaresNoCheckedExceptions(ExecutableElement constructor, Types types, Elements elements) {
+        TypeMirror runtimeException = elements.getTypeElement( RuntimeException.class.getCanonicalName() ).asType();
+        TypeMirror error = elements.getTypeElement( Error.class.getCanonicalName() ).asType();
+        for ( TypeMirror thrownType : constructor.getThrownTypes() ) {
+            if ( !types.isSubtype( thrownType, runtimeException ) && !types.isSubtype( thrownType, error ) ) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private static String invalidKey(String key, String cause) {
+        return "Invalid collection implementation configuration key '" + key + "': " + cause;
+    }
+
+    private static String invalidValue(String key, String value, String cause) {
+        return "Invalid value '" + value + "' for collection implementation configuration key '" + key + "': "
+            + cause;
+    }
+
+    public enum Resolution {
+        VALID,
+        UNRESOLVED,
+        INVALID
+    }
+
+    public static final class ConfiguredImplementation {
+        private final String qualifiedName;
+        private final boolean initialCapacityConstructor;
+
+        private ConfiguredImplementation(String qualifiedName, boolean initialCapacityConstructor) {
+            this.qualifiedName = qualifiedName;
+            this.initialCapacityConstructor = initialCapacityConstructor;
+        }
+
+        public String getQualifiedName() {
+            return qualifiedName;
+        }
+
+        public boolean hasInitialCapacityConstructor() {
+            return initialCapacityConstructor;
+        }
+    }
+
+    private static final class DuplicateDetectingProperties extends Properties {
+        private final List<String> errors = new ArrayList<>();
+
+        @Override
+        public synchronized Object put(Object key, Object value) {
+            Object previous = super.put( key, value );
+            if ( previous != null && !previous.equals( value ) ) {
+                errors.add( invalidValue( String.valueOf( key ), String.valueOf( value ),
+                    "conflicts with duplicate value '" + previous + "'" ) );
+            }
+            return previous;
+        }
+
+        private List<String> getErrors() {
+            return errors;
+        }
+    }
+}
