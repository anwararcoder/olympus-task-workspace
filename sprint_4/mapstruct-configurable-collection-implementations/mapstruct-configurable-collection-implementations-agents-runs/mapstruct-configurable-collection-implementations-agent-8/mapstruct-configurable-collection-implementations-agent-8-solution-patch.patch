+package org.mapstruct.ap.test.collection.configurable;
+
+import java.util.ArrayList;
+
+public class ConfiguredList<E> extends ArrayList<E> {
+
+    private final int initialCapacity;
+
+    public ConfiguredList() {
+        initialCapacity = -1;
+    }
+
+    public ConfiguredList(int initialCapacity) {
+        super( initialCapacity );
+        this.initialCapacity = initialCapacity;
+    }
+
+    public int getInitialCapacity() {
+        return initialCapacity;
+    }
+}
