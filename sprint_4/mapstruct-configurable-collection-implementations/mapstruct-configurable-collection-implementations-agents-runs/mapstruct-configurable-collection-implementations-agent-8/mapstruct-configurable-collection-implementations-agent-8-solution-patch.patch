@@ -0,0 +1,116 @@
+/*
+ * Copyright MapStruct Authors.
+ *
+ * Licensed under the Apache License version 2.0, available at http://www.apache.org/licenses/LICENSE-2.0
+ */
+package org.mapstruct.ap.test.collection.configurable;
+
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.stream.Stream;
+
+import org.mapstruct.ap.test.collection.configurable.ConfigurableCollectionMapper.Source;
+import org.mapstruct.ap.test.collection.configurable.ConfigurableCollectionMapper.Target;
+import org.mapstruct.ap.testutil.ProcessorTest;
+import org.mapstruct.ap.testutil.WithClasses;
+import org.mapstruct.ap.testutil.compilation.annotation.CompilationResult;
+import org.mapstruct.ap.testutil.compilation.annotation.Diagnostic;
+import org.mapstruct.ap.testutil.compilation.annotation.ExpectedCompilationOutcome;
+import org.mapstruct.ap.testutil.compilation.annotation.ProcessorOption;
+import org.mapstruct.ap.testutil.runner.Compiler;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+@WithClasses({
+    ConfigurableCollectionMapper.class,
+    ConfiguredList.class,
+    ConfiguredMap.class
+})
+public class ConfigurableCollectionImplementationTest {
+
+    private static final String CONFIGURATION_OPTION = "mapstruct.configurationFile";
+    private static final String RESOURCE_ROOT = "org/mapstruct/ap/test/collection/configurable/";
+
+    @ProcessorTest(Compiler.ECLIPSE)
+    @ProcessorOption(name = CONFIGURATION_OPTION, value = RESOURCE_ROOT + "valid.properties")
+    public void shouldUseConfiguredImplementationsForAllConstructionPaths() {
+        List<String> list = ConfigurableCollectionMapper.INSTANCE.copyList( Arrays.asList( "a", "b" ) );
+        assertThat( list ).isInstanceOf( ConfiguredList.class );
+        assertThat( ( (ConfiguredList<?>) list ).getInitialCapacity() ).isEqualTo( 2 );
+
+        Map<String, String> sourceMap = new LinkedHashMap<>();
+        sourceMap.put( "a", "b" );
+        Map<String, String> map = ConfigurableCollectionMapper.INSTANCE.copyMap( sourceMap );
+        assertThat( map ).isInstanceOf( ConfiguredMap.class );
+        assertThat( ( (ConfiguredMap<?, ?>) map ).getInitialCapacity() ).isEqualTo( 1 );
+
+        List<String> streamResult = ConfigurableCollectionMapper.INSTANCE.streamToList( Stream.of( "a" ) );
+        assertThat( streamResult ).isInstanceOf( ConfiguredList.class );
+        assertThat( ( (ConfiguredList<?>) streamResult ).getInitialCapacity() ).isEqualTo( -1 );
+
+        Source source = new Source();
+        source.setNames( Arrays.asList( "a", "b" ) );
+        source.setValues( Collections.singletonMap( "a", "b" ) );
+        Target target = ConfigurableCollectionMapper.INSTANCE.map( source );
+        assertThat( target.getNames() ).isInstanceOf( ConfiguredList.class );
+        assertThat( target.getValues() ).isInstanceOf( ConfiguredMap.class );
+    }
+
+    @ProcessorTest(Compiler.ECLIPSE)
+    @WithClasses({ FactoryCollectionMapper.class, ConfiguredList.class })
+    @ProcessorOption(name = CONFIGURATION_OPTION, value = RESOURCE_ROOT + "valid.properties")
+    public void shouldPreferObjectFactoryForStreamResult() {
+        List<String> result = FactoryCollectionMapper.INSTANCE.streamToList( Stream.of( "a" ) );
+
+        assertThat( result ).isInstanceOf( java.util.LinkedList.class );
+        assertThat( result ).containsExactly( "a" );
+    }
+
+    @ProcessorTest(Compiler.ECLIPSE)
+    @ProcessorOption(name = CONFIGURATION_OPTION, value = RESOURCE_ROOT + "unknown-property.properties")
+    @ExpectedCompilationOutcome(
+        value = CompilationResult.FAILED,
+        diagnostics = @Diagnostic(
+            kind = javax.tools.Diagnostic.Kind.ERROR,
+            type = ConfigurableCollectionMapper.class,
+            line = 16,
+            message = "Invalid collection implementation configuration key 'unknown': unknown property"
+        )
+    )
+    public void shouldRejectUnknownProperties() {
+    }
+
+    @ProcessorTest(Compiler.ECLIPSE)
+    @ProcessorOption(name = CONFIGURATION_OPTION, value = RESOURCE_ROOT + "conflicting-duplicate.properties")
+    @ExpectedCompilationOutcome(
+        value = CompilationResult.FAILED,
+        diagnostics = @Diagnostic(
+            kind = javax.tools.Diagnostic.Kind.ERROR,
+            type = ConfigurableCollectionMapper.class,
+            line = 16,
+            message = "Invalid value 'java.util.LinkedList' for collection implementation configuration key "
+                + "'mapstruct.collectionImplementation.java.util.List': conflicts with duplicate value "
+                + "'org.mapstruct.ap.test.collection.configurable.ConfiguredList'"
+        )
+    )
+    public void shouldRejectConflictingDuplicates() {
+    }
+
+    @ProcessorTest(Compiler.ECLIPSE)
+    @ProcessorOption(name = CONFIGURATION_OPTION, value = RESOURCE_ROOT + "missing.properties")
+    @ExpectedCompilationOutcome(
+        value = CompilationResult.FAILED,
+        diagnostics = @Diagnostic(
+            kind = javax.tools.Diagnostic.Kind.ERROR,
+            type = ConfigurableCollectionMapper.class,
+            line = 16,
+            message = "Configuration resource 'org/mapstruct/ap/test/collection/configurable/missing.properties' "
+                + "selected by 'mapstruct.configurationFile' was not found on the mapping compilation classpath"
+        )
+    )
+    public void shouldRejectMissingExplicitResource() {
+    }
+}
