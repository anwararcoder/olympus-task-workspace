+/*
+ * Copyright MapStruct Authors.
+ *
+ * Licensed under the Apache License version 2.0, available at http://www.apache.org/licenses/LICENSE-2.0
+ */
+package org.mapstruct.ap.test.collection.configurable;
+
+import java.util.Arrays;
+import java.util.LinkedList;
+import java.util.List;
+import java.util.stream.Stream;
+
+import org.mapstruct.ap.testutil.ProcessorTest;
+import org.mapstruct.ap.testutil.WithClasses;
+import org.mapstruct.ap.testutil.WithClasspathResource;
+import org.mapstruct.ap.testutil.compilation.annotation.CompilationResult;
+import org.mapstruct.ap.testutil.compilation.annotation.Diagnostic;
+import org.mapstruct.ap.testutil.compilation.annotation.ExpectedCompilationOutcome;
+import org.mapstruct.ap.testutil.compilation.annotation.ProcessorOption;
+import org.mapstruct.ap.testutil.runner.Compiler;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+@WithClasses({
+    CapacityList.class,
+    Source.class,
+    Target.class,
+    ConfigurableCollectionMapper.class
+})
+public class ConfigurableCollectionImplementationTest {
+
+    private static final String CONFIGURATION_FILE = "mapstruct-test/configurable-collections.properties";
+    private static final String CONFIGURATION_PROPERTY =
+        "mapstruct.collectionImplementation.java.util.List="
+            + "org.mapstruct.ap.test.collection.configurable.CapacityList";
+
+    @ProcessorTest
+    @ProcessorOption(name = "mapstruct.configurationFile", value = CONFIGURATION_FILE)
+    @WithClasspathResource(
+        path = CONFIGURATION_FILE,
+        value = { CONFIGURATION_PROPERTY, CONFIGURATION_PROPERTY }
+    )
+    public void shouldUseConfiguredImplementationAcrossMappingForms() {
+        List<String> source = Arrays.asList( "one", "two", "three" );
+
+        List<String> mapped = ConfigurableCollectionMapper.INSTANCE.map( source );
+        Target target = ConfigurableCollectionMapper.INSTANCE.map( source( source ) );
+        List<String> streamMapped = ConfigurableCollectionMapper.INSTANCE.map( Stream.of( "one", "two" ) );
+
+        assertThat( mapped ).isInstanceOf( CapacityList.class );
+        assertThat( ( (CapacityList<?>) mapped ).getInitialCapacity() ).isEqualTo( source.size() );
+        assertThat( target.getValues() ).isInstanceOf( CapacityList.class );
+        assertThat( streamMapped ).isInstanceOf( CapacityList.class );
+    }
+
+    @ProcessorTest
+    @WithClasspathResource(path = "mapstruct.properties", value = CONFIGURATION_PROPERTY)
+    public void shouldReadDefaultConfigurationResource() {
+        List<String> mapped = ConfigurableCollectionMapper.INSTANCE.map( Arrays.asList( "one", "two" ) );
+
+        assertThat( mapped ).isInstanceOf( CapacityList.class );
+    }
+
+    @ProcessorTest
+    @ProcessorOption(name = "mapstruct.configurationFile", value = CONFIGURATION_FILE)
+    @WithClasspathResource(path = CONFIGURATION_FILE, value = CONFIGURATION_PROPERTY)
+    public void shouldPreferApplicableObjectFactory() {
+        List<String> mapped = ConfigurableCollectionMapper.INSTANCE.mapWithFactory(
+            new ConfigurableCollectionMapper.FactoryContext(),
+            Arrays.asList( "one", "two" )
+        );
+
+        assertThat( mapped ).isInstanceOf( LinkedList.class );
+    }
+
+    @ProcessorTest(Compiler.JDK)
+    @WithClasses(ConfigurableCollectionMapper.class)
+    @ProcessorOption(name = "mapstruct.configurationFile", value = "mapstruct-test/missing.properties")
+    @ExpectedCompilationOutcome(
+        value = CompilationResult.FAILED,
+        diagnostics = @Diagnostic(
+            kind = javax.tools.Diagnostic.Kind.ERROR,
+            messageRegExp = "Configured MapStruct collection implementation resource.*missing.properties.*"
+                + "could not be read.*"
+        )
+    )
+    public void shouldFailForMissingExplicitConfiguration() {
+    }
+
+    @ProcessorTest(Compiler.JDK)
+    @ProcessorOption(name = "mapstruct.configurationFile", value = "mapstruct-test/invalid-implementation.properties")
+    @WithClasspathResource(
+        path = "mapstruct-test/invalid-implementation.properties",
+        value = "mapstruct.collectionImplementation.java.util.List=java.lang.String"
+    )
+    @ExpectedCompilationOutcome(
+        value = CompilationResult.FAILED,
+        diagnostics = @Diagnostic(
+            kind = javax.tools.Diagnostic.Kind.ERROR,
+            messageRegExp = "Invalid value 'java.lang.String'.*not assignable to 'java.util.List'.*"
+        )
+    )
+    public void shouldRejectInvalidImplementation() {
+    }
+
+    @ProcessorTest(Compiler.JDK)
+    @ProcessorOption(name = "mapstruct.configurationFile", value = "mapstruct-test/conflicting.properties")
+    @WithClasspathResource(
+        path = "mapstruct-test/conflicting.properties",
+        value = {
+            "mapstruct.collectionImplementation.java.util.List=java.util.ArrayList",
+            "mapstruct.collectionImplementation.java.util.List=java.util.LinkedList"
+        }
+    )
+    @ExpectedCompilationOutcome(
+        value = CompilationResult.FAILED,
+        diagnostics = @Diagnostic(
+            kind = javax.tools.Diagnostic.Kind.ERROR,
+            messageRegExp = "Invalid duplicate.*java.util.List.*"
+                + "(ArrayList.*LinkedList|LinkedList.*ArrayList).*conflict.*"
+        )
+    )
+    public void shouldRejectConflictingDuplicate() {
+    }
+
+    private Source source(List<String> values) {
+        Source source = new Source();
+        source.setValues( values );
+        return source;
+    }
+}
