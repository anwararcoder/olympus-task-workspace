--- /dev/null
+++ b/processor/src/main/java/org/mapstruct/ap/internal/option/CollectionImplementationConfiguration.java
@@ -0,0 +1,384 @@
+/*
+ * Copyright MapStruct Authors.
+ *
+ * Licensed under the Apache License version 2.0, available at http://www.apache.org/licenses/LICENSE-2.0
+ */
+package org.mapstruct.ap.internal.option;
+
+import java.io.FileNotFoundException;
+import java.io.IOException;
+import java.io.InputStream;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Properties;
+import java.util.Set;
+import javax.annotation.processing.Filer;
+import javax.annotation.processing.Messager;
+import javax.lang.model.element.Element;
+import javax.lang.model.element.ElementKind;
+import javax.lang.model.element.ExecutableElement;
+import javax.lang.model.element.Modifier;
+import javax.lang.model.element.TypeElement;
+import javax.lang.model.element.TypeParameterElement;
+import javax.lang.model.type.DeclaredType;
+import javax.lang.model.type.TypeMirror;
+import javax.lang.model.util.ElementFilter;
+import javax.lang.model.util.Elements;
+import javax.lang.model.util.Types;
+import javax.tools.Diagnostic;
+import javax.tools.FileObject;
+import javax.tools.StandardLocation;
+
+/**
+ * Configured concrete implementations for supported collection and map interfaces.
+ */
+public class CollectionImplementationConfiguration {
+
+    public static final String DEFAULT_RESOURCE = "mapstruct.properties";
+    public static final String PROPERTY_PREFIX = "mapstruct.collectionImplementation.";
+
+    private static final Set<String> SUPPORTED_INTERFACES = Collections.unmodifiableSet( new HashSet<>( Arrays.asList(
+        "java.lang.Iterable",
+        "java.util.Collection",
+        "java.util.List",
+        "java.util.Set",
+        "java.util.SortedSet",
+        "java.util.NavigableSet",
+        "java.util.Map",
+        "java.util.SortedMap",
+        "java.util.NavigableMap",
+        "java.util.concurrent.ConcurrentMap",
+        "java.util.concurrent.ConcurrentNavigableMap",
+        "java.util.SequencedSet",
+        "java.util.SequencedMap"
+    ) ) );
+
+    private final Map<String, String> implementations;
+    private final Map<String, ConfiguredImplementation> resolvedImplementations = new HashMap<>();
+    private final Set<String> invalidImplementations = new HashSet<>();
+
+    private CollectionImplementationConfiguration(Map<String, String> implementations) {
+        this.implementations = implementations;
+    }
+
+    public static CollectionImplementationConfiguration load(Filer filer, Messager messager,
+                                                             String configuredResource) {
+        String resourceName = configuredResource == null ? DEFAULT_RESOURCE : configuredResource;
+        boolean required = configuredResource != null;
+        DuplicateDetectingProperties properties = new DuplicateDetectingProperties();
+
+        try {
+            FileObject resource = filer.getResource( StandardLocation.CLASS_PATH, "", resourceName );
+            try ( InputStream inputStream = resource.openInputStream() ) {
+                properties.load( inputStream );
+            }
+        }
+        catch ( FileNotFoundException e ) {
+            if ( required ) {
+                reportUnreadableResource( messager, resourceName, e );
+            }
+            return new CollectionImplementationConfiguration( Collections.emptyMap() );
+        }
+        catch ( IOException e ) {
+            reportUnreadableResource( messager, resourceName, e );
+            return new CollectionImplementationConfiguration( Collections.emptyMap() );
+        }
+        catch ( IllegalArgumentException e ) {
+            if ( required || !isMissingResource( e ) ) {
+                reportUnreadableResource( messager, resourceName, e );
+            }
+            return new CollectionImplementationConfiguration( Collections.emptyMap() );
+        }
+
+        Map<String, String> implementations = new LinkedHashMap<>();
+        for ( Map.Entry<Object, Object> property : properties.entrySet() ) {
+            String key = (String) property.getKey();
+            String value = (String) property.getValue();
+            if ( !key.startsWith( PROPERTY_PREFIX ) ) {
+                messager.printMessage(
+                    Diagnostic.Kind.ERROR,
+                    "Invalid MapStruct collection implementation property '" + key + "': unknown property"
+                );
+                continue;
+            }
+
+            String interfaceName = key.substring( PROPERTY_PREFIX.length() );
+            if ( !SUPPORTED_INTERFACES.contains( interfaceName ) ) {
+                messager.printMessage(
+                    Diagnostic.Kind.ERROR,
+                    "Invalid MapStruct collection implementation property '" + key
+                        + "': unsupported collection or map interface '" + interfaceName + "'"
+                );
+                continue;
+            }
+            if ( value.trim().isEmpty() ) {
+                messager.printMessage(
+                    Diagnostic.Kind.ERROR,
+                    "Invalid value for MapStruct collection implementation property '" + key
+                        + "': implementation type is empty"
+                );
+                continue;
+            }
+
+            String conflictingValue = properties.getConflictingValue( key, value );
+            if ( conflictingValue != null ) {
+                messager.printMessage(
+                    Diagnostic.Kind.ERROR,
+                    "Invalid duplicate MapStruct collection implementation property '" + key + "': values '"
+                        + value + "' and '" + conflictingValue + "' conflict"
+                );
+                continue;
+            }
+            implementations.put( interfaceName, value.trim() );
+        }
+
+        return new CollectionImplementationConfiguration( implementations );
+    }
+
+    private static void reportUnreadableResource(Messager messager, String resourceName, Exception exception) {
+        messager.printMessage(
+            Diagnostic.Kind.ERROR,
+            "Configured MapStruct collection implementation resource '" + resourceName
+                + "' could not be read: " + exception.getMessage()
+        );
+    }
+
+    private static boolean isMissingResource(IllegalArgumentException exception) {
+        return exception.getMessage() != null && exception.getMessage().contains( "Resource does not exist" );
+    }
+
+    public void validate(Elements elements, Types types, Messager messager) {
+        for ( String interfaceName : implementations.keySet() ) {
+            resolve( interfaceName, elements, types, messager );
+        }
+    }
+
+    public ConfiguredImplementation get(String interfaceName) {
+        if ( !implementations.containsKey( interfaceName ) ) {
+            return null;
+        }
+
+        ConfiguredImplementation implementation = resolvedImplementations.get( interfaceName );
+        if ( implementation == null && !invalidImplementations.contains( interfaceName ) ) {
+            throw new ConfiguredImplementationUnavailableException(
+                interfaceName,
+                implementations.get( interfaceName )
+            );
+        }
+        return implementation;
+    }
+
+    public void reportUnavailable(Messager messager) {
+        for ( Map.Entry<String, String> implementation : implementations.entrySet() ) {
+            if ( !resolvedImplementations.containsKey( implementation.getKey() )
+                && !invalidImplementations.contains( implementation.getKey() ) ) {
+                messager.printMessage(
+                    Diagnostic.Kind.ERROR,
+                    invalidValueMessage(
+                        implementation.getKey(),
+                        implementation.getValue(),
+                        "implementation type could not be resolved"
+                    )
+                );
+            }
+        }
+    }
+
+    private ConfiguredImplementation resolve(String interfaceName, Elements elements, Types types, Messager messager) {
+        ConfiguredImplementation resolved = resolvedImplementations.get( interfaceName );
+        if ( resolved != null || invalidImplementations.contains( interfaceName ) ) {
+            return resolved;
+        }
+
+        TypeElement interfaceElement = elements.getTypeElement( interfaceName );
+        if ( interfaceElement == null ) {
+            reportInvalid( interfaceName, messager, "configured interface is not available in this compilation" );
+            return null;
+        }
+
+        String implementationName = implementations.get( interfaceName );
+        TypeElement implementationElement = elements.getTypeElement( implementationName );
+        if ( implementationElement == null ) {
+            return null;
+        }
+
+        String validationError = validateImplementation( interfaceElement, implementationElement, elements, types );
+        if ( validationError != null ) {
+            reportInvalid( interfaceName, messager, validationError );
+            return null;
+        }
+
+        boolean initialCapacityConstructor = hasUsableConstructor(
+            implementationElement,
+            types,
+            elements,
+            true
+        );
+        resolved = new ConfiguredImplementation( implementationName, initialCapacityConstructor );
+        resolvedImplementations.put( interfaceName, resolved );
+        return resolved;
+    }
+
+    private String validateImplementation(TypeElement interfaceElement, TypeElement implementationElement,
+                                          Elements elements, Types types) {
+        if ( implementationElement.getKind() != ElementKind.CLASS
+            || implementationElement.getModifiers().contains( Modifier.ABSTRACT ) ) {
+            return "implementation type must be a concrete class";
+        }
+        if ( !isPubliclyAccessible( implementationElement ) ) {
+            return "implementation type must be publicly accessible";
+        }
+        if ( !types.isAssignable(
+            types.erasure( implementationElement.asType() ),
+            types.erasure( interfaceElement.asType() )
+        ) ) {
+            return "implementation type is not assignable to '" + interfaceElement.getQualifiedName() + "'";
+        }
+
+        List<? extends TypeParameterElement> interfaceParameters = interfaceElement.getTypeParameters();
+        List<? extends TypeParameterElement> implementationParameters = implementationElement.getTypeParameters();
+        if ( implementationParameters.size() != interfaceParameters.size() ) {
+            return "implementation type must declare the same number of type parameters as the interface";
+        }
+        for ( TypeParameterElement parameter : implementationParameters ) {
+            if ( !isUnbounded( parameter, elements, types ) ) {
+                return "implementation type parameters must be unbounded";
+            }
+        }
+        if ( !preservesTypeParameters( interfaceElement, implementationElement, types ) ) {
+            return "implementation type must preserve the interface type parameters";
+        }
+        if ( !hasUsableConstructor( implementationElement, types, elements, false ) ) {
+            return "implementation type must expose a public no-argument constructor that declares no checked "
+                + "exceptions";
+        }
+        return null;
+    }
+
+    private boolean isPubliclyAccessible(TypeElement type) {
+        Element current = type;
+        while ( current instanceof TypeElement ) {
+            if ( !current.getModifiers().contains( Modifier.PUBLIC ) ) {
+                return false;
+            }
+            current = current.getEnclosingElement();
+        }
+        return true;
+    }
+
+    private boolean isUnbounded(TypeParameterElement parameter, Elements elements, Types types) {
+        List<? extends TypeMirror> bounds = parameter.getBounds();
+        TypeElement objectElement = elements.getTypeElement( Object.class.getCanonicalName() );
+        return bounds.size() == 1
+            && types.isSameType( types.erasure( bounds.get( 0 ) ), types.erasure( objectElement.asType() ) );
+    }
+
+    private boolean preservesTypeParameters(TypeElement interfaceElement, TypeElement implementationElement,
+                                            Types types) {
+        List<? extends TypeParameterElement> parameters = implementationElement.getTypeParameters();
+        TypeMirror[] arguments = new TypeMirror[parameters.size()];
+        for ( int i = 0; i < parameters.size(); i++ ) {
+            arguments[i] = parameters.get( i ).asType();
+        }
+        DeclaredType implementationType = types.getDeclaredType( implementationElement, arguments );
+        DeclaredType interfaceType = types.getDeclaredType( interfaceElement, arguments );
+        return types.isAssignable( implementationType, interfaceType );
+    }
+
+    private boolean hasUsableConstructor(TypeElement implementationElement, Types types, Elements elements,
+                                         boolean initialCapacity) {
+        TypeMirror runtimeException = elements.getTypeElement( RuntimeException.class.getCanonicalName() ).asType();
+        TypeMirror error = elements.getTypeElement( Error.class.getCanonicalName() ).asType();
+        List<ExecutableElement> constructors = ElementFilter.constructorsIn(
+            implementationElement.getEnclosedElements()
+        );
+        for ( ExecutableElement constructor : constructors ) {
+            if ( !constructor.getModifiers().contains( Modifier.PUBLIC ) ) {
+                continue;
+            }
+            if ( initialCapacity ) {
+                if ( constructor.getParameters().size() != 1
+                    || constructor.getParameters().get( 0 ).asType().getKind() != javax.lang.model.type.TypeKind.INT ) {
+                    continue;
+                }
+            }
+            else if ( !constructor.getParameters().isEmpty() ) {
+                continue;
+            }
+
+            boolean checkedException = false;
+            for ( TypeMirror thrownType : constructor.getThrownTypes() ) {
+                if ( !types.isSubtype( thrownType, runtimeException ) && !types.isSubtype( thrownType, error ) ) {
+                    checkedException = true;
+                    break;
+                }
+            }
+            if ( !checkedException ) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private void reportInvalid(String interfaceName, Messager messager, String cause) {
+        invalidImplementations.add( interfaceName );
+        messager.printMessage(
+            Diagnostic.Kind.ERROR,
+            invalidValueMessage( interfaceName, implementations.get( interfaceName ), cause )
+        );
+    }
+
+    private String invalidValueMessage(String interfaceName, String implementationName, String cause) {
+        return "Invalid value '" + implementationName + "' for MapStruct collection implementation property '"
+            + PROPERTY_PREFIX + interfaceName + "': " + cause;
+    }
+
+    public static class ConfiguredImplementation {
+
+        private final String name;
+        private final boolean initialCapacityConstructor;
+
+        private ConfiguredImplementation(String name, boolean initialCapacityConstructor) {
+            this.name = name;
+            this.initialCapacityConstructor = initialCapacityConstructor;
+        }
+
+        public String getName() {
+            return name;
+        }
+
+        public boolean hasInitialCapacityConstructor() {
+            return initialCapacityConstructor;
+        }
+    }
+
+    private static class DuplicateDetectingProperties extends Properties {
+
+        private final Map<String, List<String>> values = new HashMap<>();
+
+        @Override
+        public synchronized Object put(Object key, Object value) {
+            values.computeIfAbsent( (String) key, ignored -> new ArrayList<>() ).add( (String) value );
+            return super.put( key, value );
+        }
+
+        private String getConflictingValue(String key, String currentValue) {
+            List<String> propertyValues = values.get( key );
+            if ( propertyValues == null || propertyValues.size() < 2 ) {
+                return null;
+            }
+            for ( String propertyValue : propertyValues ) {
+                if ( !currentValue.equals( propertyValue ) ) {
+                    return propertyValue;
+                }
+            }
+            return null;
+        }
+    }
+}
