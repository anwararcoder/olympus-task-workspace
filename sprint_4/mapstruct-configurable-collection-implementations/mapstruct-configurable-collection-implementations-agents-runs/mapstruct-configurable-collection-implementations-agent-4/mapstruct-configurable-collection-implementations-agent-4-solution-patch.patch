+/*
+ * Copyright MapStruct Authors.
+ *
+ * Licensed under the Apache License version 2.0, available at http://www.apache.org/licenses/LICENSE-2.0
+ */
+package org.mapstruct.ap.internal.option;
+
+import org.mapstruct.ap.spi.TypeHierarchyErroneousException;
+
+/**
+ * Signals that a configured collection implementation may be generated in a later processing round.
+ */
+public class ConfiguredImplementationUnavailableException extends TypeHierarchyErroneousException {
+
+    private static final long serialVersionUID = 1L;
+
+    private final String interfaceName;
+    private final String implementationName;
+
+    public ConfiguredImplementationUnavailableException(String interfaceName, String implementationName) {
+        super( (javax.lang.model.type.TypeMirror) null );
+        this.interfaceName = interfaceName;
+        this.implementationName = implementationName;
+    }
+
+    public String getInterfaceName() {
+        return interfaceName;
+    }
+
+    public String getImplementationName() {
+        return implementationName;
+    }
+}
