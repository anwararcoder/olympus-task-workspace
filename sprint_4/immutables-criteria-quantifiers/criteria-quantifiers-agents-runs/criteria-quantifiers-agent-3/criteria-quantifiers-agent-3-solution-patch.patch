+
+  private static BsonValue isType(BsonValue value, String type) {
+    return binaryExpression("$eq", document("$type", value), new BsonString(type));
+  }
+
+  private static BsonValue condition(BsonValue test, BsonValue whenTrue, BsonValue whenFalse) {
+    return document("$cond", new BsonArray(java.util.Arrays.asList(test, whenTrue, whenFalse)));
