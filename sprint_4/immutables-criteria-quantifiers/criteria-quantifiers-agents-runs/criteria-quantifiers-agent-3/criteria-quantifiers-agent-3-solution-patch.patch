+
+  private static BsonValue not(BsonValue value) {
+    return document("$not", new BsonArray(Collections.singletonList(value)));
+  }
+
+  private static BsonValue binaryExpression(String operator, BsonValue left, BsonValue right) {
+    return document(operator, new BsonArray(java.util.Arrays.asList(left, right)));
+  }
+
+  private static BsonValue logical(String operator, BsonValue... values) {
+    return logical(operator, java.util.Arrays.asList(values));
+  }
+
+  private static BsonValue logical(String operator, List<BsonValue> values) {
+    return document(operator, new BsonArray(values));
+  }
+
+  private static BsonDocument document(String key, BsonValue value) {
+    return new BsonDocument(key, value);
+  }
+
+  private static class ValueExpression {
+    final BsonValue value;
+    final BsonValue defined;
+
+    ValueExpression(BsonValue value, BsonValue defined) {
+      this.value = value;
