+package org.immutables.criteria.typemodel;
+
+import org.immutables.check.IterableChecker;
+import org.immutables.criteria.backend.Backend;
+import org.immutables.criteria.personmodel.CriteriaChecker;
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+import java.util.Optional;
+import java.util.function.Supplier;
+
+public abstract class QuantifierTemplate {
+
+  private final StringHolderRepository strings;
+  private final IntegerHolderRepository integers;
+  private final CompositeHolderRepository composites;
+  private final StringHolderCriteria string = StringHolderCriteria.stringHolder;
+  private final IntegerHolderCriteria integer = IntegerHolderCriteria.integerHolder;
+  private final CompositeHolderCriteria composite = CompositeHolderCriteria.compositeHolder;
+  private final Supplier<ImmutableStringHolder> stringGenerator = TypeHolder.StringHolder.generator();
+  private final Supplier<ImmutableIntegerHolder> integerGenerator = TypeHolder.IntegerHolder.generator();
+  private final Supplier<ImmutableCompositeHolder> compositeGenerator = TypeHolder.CompositeHolder.generator();
+
+  protected QuantifierTemplate(Backend backend) {
+    this.strings = new StringHolderRepository(backend);
+    this.integers = new IntegerHolderRepository(backend);
+    this.composites = new CompositeHolderRepository(backend);
+  }
+
+  @Test
+  void scalarCollections() {
+    strings.insert(stringGenerator.get().withId("empty").withArray().withList());
+    strings.insert(stringGenerator.get().withId("all-a").withArray("alpha", "atom").withList("alpha", "atom"));
+    strings.insert(stringGenerator.get().withId("mixed").withArray("alpha", "beta").withList("alpha", "beta"));
+    strings.insert(stringGenerator.get().withId("none-a").withArray("beta").withList("beta"));
+    strings.insert(stringGenerator.get().withId("lines").withArray("a\n", "ab").withList("a\n", "ab"));
+    strings.insert(stringGenerator.get().withId("null-array").withArray(new String[] {null}).withList("alpha"));
+
+    stringIds(string.list.any().startsWith("a")).hasContentInAnyOrder("all-a", "mixed", "lines", "null-array");
+    stringIds(string.list.all().startsWith("a")).hasContentInAnyOrder("empty", "all-a", "lines", "null-array");
+    stringIds(string.list.none().startsWith("a")).hasContentInAnyOrder("empty", "none-a");
+    stringIds(string.list.all().hasLength(2)).hasContentInAnyOrder("empty", "lines");
+    stringIds(string.list.none().isNot("alpha")).hasContentInAnyOrder("empty", "null-array");
+    stringIds(string.array.all().isNot("alpha")).hasContentInAnyOrder("empty", "none-a", "lines");
+    stringIds(string.array.none().isNot("alpha")).hasContentInAnyOrder("empty", "null-array");
+  }
+
+  @Test
+  void objectAndPrimitiveArrays() {
+    integers.insert(integerGenerator.get().withId("empty").withArray().withList());
+    integers.insert(integerGenerator.get().withId("positive").withArray(1, 2).withList(1, 2));
+    integers.insert(integerGenerator.get().withId("mixed").withArray(-1, 2).withList(-1, 2));
+
+    integerIds(integer.array.any().greaterThan(0)).hasContentInAnyOrder("positive", "mixed");
+    integerIds(integer.array.all().greaterThan(0)).hasContentInAnyOrder("empty", "positive");
+    integerIds(integer.array.none().greaterThan(0)).hasContentInAnyOrder("empty");
+  }
+
+  @Test
+  void objectScopesAndNestedQuantifiers() {
+    ImmutableStringHolder left = stringGenerator.get().withId("left").withValue("a")
+            .withOptional(Optional.empty()).withList("x");
+    ImmutableStringHolder right = stringGenerator.get().withId("right").withValue("b")
+            .withOptional("present").withList("y");
+    ImmutableStringHolder correlated = stringGenerator.get().withId("correlated").withValue("a")
+            .withOptional("present").withList("y");
+
+    composites.insert(compositeGenerator.get().withId("empty").withStringList());
+    composites.insert(compositeGenerator.get().withId("split").withStringList(left, right));
+    composites.insert(compositeGenerator.get().withId("same").withStringList(correlated));
+
+    compositeIds(composite.stringList.any().with(value -> value.value.is("a").and(value.list.contains("y"))))
+            .hasContentInAnyOrder("same");
+    compositeIds(composite.stringList.all().list.none().is("bad"))
+            .hasContentInAnyOrder("empty", "split", "same");
+    compositeIds(composite.stringList.none().list.any().is("y"))
+            .hasContentInAnyOrder("empty");
+    compositeIds(composite.stringList.all().optional.isPresent())
+            .hasContentInAnyOrder("empty", "same");
+    compositeIds(composite.stringList.any().optional.isAbsent())
+            .hasContentInAnyOrder("split");
+    compositeIds(composite.stringList.all().with(value -> value.nullable.is("x").or(value.value.is("a"))))
+            .hasContentInAnyOrder("empty", "same");
+    compositeIds(composite.stringList.all().with(value -> value.value.is("a").or(value.nullable.is("x"))))
+            .hasContentInAnyOrder("empty", "same");
+    compositeIds(composite.stringList.none().with(value -> value.nullable.is("x").and(value.value.is("no"))))
+            .hasContentInAnyOrder("empty", "split", "same");
+    compositeIds(composite.stringList.none().nullable.isNot("x"))
+            .hasContentInAnyOrder("empty", "split", "same");
+  }
+
+  private IterableChecker<List<String>, String> stringIds(StringHolderCriteria criteria) {
+    return CriteriaChecker.<TypeHolder.StringHolder>ofReader(strings.find(criteria)).toList(TypeHolder.StringHolder::id);
+  }
+
+  private IterableChecker<List<String>, String> integerIds(IntegerHolderCriteria criteria) {
+    return CriteriaChecker.<TypeHolder.IntegerHolder>ofReader(integers.find(criteria)).toList(TypeHolder.IntegerHolder::id);
+  }
+
+  private IterableChecker<List<String>, String> compositeIds(CompositeHolderCriteria criteria) {
+    return CriteriaChecker.<TypeHolder.CompositeHolder>ofReader(composites.find(criteria)).toList(TypeHolder.CompositeHolder::id);
+  }
+}
