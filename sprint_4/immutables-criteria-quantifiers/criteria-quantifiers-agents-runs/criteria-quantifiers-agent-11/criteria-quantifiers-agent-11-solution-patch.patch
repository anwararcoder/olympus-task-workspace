+package org.immutables.criteria.typemodel;
+
+import org.immutables.check.IterableChecker;
+import org.immutables.criteria.backend.Backend;
+import org.immutables.criteria.personmodel.CriteriaChecker;
+import org.junit.jupiter.api.Test;
+
+import java.util.Arrays;
+import java.util.List;
+
+public abstract class QuantifierTemplate {
+
+  private final StringHolderRepository strings;
+  private final IntegerHolderRepository integers;
+  private final StringHolderCriteria string = StringHolderCriteria.stringHolder;
+  private final IntegerHolderCriteria integer = IntegerHolderCriteria.integerHolder;
+
+  protected QuantifierTemplate(Backend backend) {
+    this.strings = new StringHolderRepository(backend);
+    this.integers = new IntegerHolderRepository(backend);
+  }
+
+  @Test
+  void scalarIterableQuantifiers() {
+    insertString("empty");
+    insertString("exact", "alpha");
+    insertString("all", "alpha", "alpine");
+    insertString("mixed", "alpha", "beta");
+    insertString("none", "beta", "gamma");
+    insertString("line", "a\nb");
+
+    stringIds(string.array.any().startsWith("a")).hasContentInAnyOrder("exact", "all", "mixed", "line");
+    stringIds(string.array.all().startsWith("a")).hasContentInAnyOrder("empty", "exact", "all", "line");
+    stringIds(string.array.none().startsWith("a")).hasContentInAnyOrder("empty", "none");
+
+    stringIds(string.list.any().isNot("alpha")).hasContentInAnyOrder("all", "mixed", "none", "line");
+    stringIds(string.list.all().isNot("alpha")).hasContentInAnyOrder("empty", "none", "line");
+    stringIds(string.list.none().isNot("alpha")).hasContentInAnyOrder("empty", "exact");
+    stringIds(string.array.none().not(value -> value.is("alpha"))).hasContentInAnyOrder("empty", "exact");
+
+    stringIds(string.array.any().with(value -> value.startsWith("a").endsWith("a")))
+        .hasContentInAnyOrder("exact", "all", "mixed");
+    stringIds(string.array.all().with(value -> value.startsWith("a").or().startsWith("b")))
+        .hasContentInAnyOrder("empty", "exact", "all", "mixed", "line");
+
+    stringIds(string.array.any().hasLength(3)).isOf("line");
+    stringIds(string.array.all().contains("l")).hasContentInAnyOrder("empty", "exact", "all");
+    stringIds(string.array.any().contains("\n")).isOf("line");
+
+    stringIds(string.array.isEmpty()).isOf("empty");
+    stringIds(string.array.notEmpty()).hasContentInAnyOrder("exact", "all", "mixed", "none", "line");
+    stringIds(string.array.hasSize(2)).hasContentInAnyOrder("all", "mixed", "none");
+    stringIds(string.array.contains("gamma")).isOf("none");
+  }
+
+  @Test
+  void primitiveArrayQuantifiers() {
+    insertInteger("empty");
+    insertInteger("positive", 1, 2);
+    insertInteger("mixed", -1, 2);
+    insertInteger("negative", -2, -1);
+
+    integerIds(integer.array.any().greaterThan(0)).hasContentInAnyOrder("positive", "mixed");
+    integerIds(integer.array.all().greaterThan(0)).hasContentInAnyOrder("empty", "positive");
+    integerIds(integer.array.none().greaterThan(0)).hasContentInAnyOrder("empty", "negative");
+  }
+
+  private void insertString(String id, String... values) {
+    strings.insert(ImmutableStringHolder.builder()
+        .id(id)
+        .value(id)
+        .array(values)
+        .addAllList(Arrays.asList(values))
+        .build());
+  }
+
+  private void insertInteger(String id, int... values) {
+    integers.insert(ImmutableIntegerHolder.builder()
+        .id(id)
+        .value(0)
+        .boxed(0)
+        .nullable(0)
+        .array(values)
+        .build());
+  }
+
+  private IterableChecker<List<String>, String> stringIds(StringHolderCriteria criteria) {
+    return CriteriaChecker.<TypeHolder.StringHolder>ofReader(strings.find(criteria)).toList(TypeHolder.StringHolder::id);
+  }
+
+  private IterableChecker<List<String>, String> integerIds(IntegerHolderCriteria criteria) {
+    return CriteriaChecker.<TypeHolder.IntegerHolder>ofReader(integers.find(criteria)).toList(TypeHolder.IntegerHolder::id);
+  }
+}
