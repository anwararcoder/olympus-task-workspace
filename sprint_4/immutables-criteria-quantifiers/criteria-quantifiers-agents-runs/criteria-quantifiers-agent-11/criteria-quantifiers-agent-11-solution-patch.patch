+
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.Set;
+
+@ExtendWith(MongoExtension.class)
+class MongoQuantifierSemanticsTest {
+
+  private final MongoDatabase database;
+  private final StringHolderCriteria string = StringHolderCriteria.stringHolder;
+  private final PersonCriteria person = PersonCriteria.person;
+
+  MongoQuantifierSemanticsTest(MongoDatabase database) {
+    this.database = database;
+  }
+
+  @Test
+  void malformedCollectionsAndNullElements() {
+    MongoCollection<Document> collection = collection(TypeHolder.StringHolder.class);
+    insert(collection,
+        new Document("_id", "missing"),
+        new Document("_id", "null").append("array", null),
+        new Document("_id", "scalar").append("array", "x"),
+        new Document("_id", "empty").append("array", Collections.emptyList()),
+        new Document("_id", "nullElement").append("array", Collections.singletonList(null)),
+        new Document("_id", "x").append("array", Collections.singletonList("x")),
+        new Document("_id", "y").append("array", Collections.singletonList("y")));
+
+    checkIds(string.array.any().is("x"), "scalar", "x");
+    checkIds(string.array.any().isNot("x"), "y");
+    checkIds(string.array.all().isNot("x"), "empty", "y");
+    checkIds(string.array.none().isNot("x"), "empty", "nullElement", "x");
+    checkIds(string.array.all().is("x"), "empty", "x");
+    checkIds(string.array.none().is("x"), "empty", "nullElement", "y");
+  }
+
+  @Test
+  void missingFieldsAndDecisiveBooleanBranches() {
+    MongoCollection<Document> collection = collection(org.immutables.criteria.personmodel.Person.class);
+    insert(collection,
+        new Document("_id", "empty").append("pets", Collections.emptyList()),
+        new Document("_id", "nullElement").append("pets", Collections.singletonList(null)),
+        new Document("_id", "missingName").append("pets", Collections.singletonList(new Document())),
+        new Document("_id", "nullName").append("pets", Collections.singletonList(new Document("name", null))),
+        new Document("_id", "x").append("pets", Collections.singletonList(new Document("name", "x"))));
+
+    checkIds(person.pets.any().name.isNot("z"), "x");
+    checkIds(person.pets.all().name.isNot("z"), "empty", "x");
+    checkIds(person.pets.none().name.isNot("z"), "empty", "nullElement", "missingName", "nullName");
+
+    checkIds(person.pets.any().with(pet ->
+        pet.name.is("x").or(pet.address.value().city.is("missing"))), "x");
+    checkIds(person.pets.any().with(pet ->
+        pet.address.value().city.is("missing").or(pet.name.is("x"))), "x");
+    checkIds(person.pets.any().with(pet ->
+        pet.name.is("z").and(pet.address.value().city.is("missing"))));
+    checkIds(person.pets.any().with(pet ->
+        pet.address.value().city.is("missing").and(pet.name.is("z"))));
+  }
+
+  @Test
+  void nestedAnyRejectsNonArrayValues() {
+    MongoCollection<Document> collection = collection(org.immutables.criteria.personmodel.Person.class);
+    insert(collection, new Document("_id", "scalarNested").append("pets",
+        Collections.singletonList(new Document("name", "pet").append("toys", "not-an-array"))));
+
+    checkIds(person.pets.all().with(pet -> pet.toys.any().name.is("x")));
+    checkIds(person.pets.none().with(pet -> pet.toys.any().name.is("x")), "scalarNested");
+  }
+
+  private MongoCollection<Document> collection(Class<?> entityType) {
+    return database.getCollection(ContainerNaming.DEFAULT.name(entityType));
+  }
+
+  private static void insert(MongoCollection<Document> collection, Document... documents) {
+    Flowable.fromPublisher(collection.insertMany(Arrays.asList(documents))).blockingSubscribe();
+  }
+
+  private void checkIds(Criterion<?> criterion, String... expected) {
+    Query query = Criterias.toQuery(criterion);
+    MongoCollection<Document> collection = collection(query.entityClass());
+    Set<String> actual = new HashSet<>(Flowable.fromPublisher(collection.find(filter(query)))
+        .map(document -> document.getString("_id"))
+        .toList()
+        .blockingGet());
+    Assertions.assertEquals(new HashSet<>(Arrays.asList(expected)), actual);
+  }
+
+  private static Bson filter(Query query) {
+    Path idPath = Visitors.toPath(KeyExtractor.defaultFactory().create(query.entityClass()).metadata().keys().get(0));
+    PathNaming naming = new MongoPathNaming(idPath, PathNaming.defaultNaming());
+    CodecRegistry registry = MongoClientSettings.getDefaultCodecRegistry();
+    FindVisitor visitor = new FindVisitor(naming, registry);
+    return query.filter().map(expression -> expression.accept(visitor)).orElseGet(Document::new);
+  }
+}
