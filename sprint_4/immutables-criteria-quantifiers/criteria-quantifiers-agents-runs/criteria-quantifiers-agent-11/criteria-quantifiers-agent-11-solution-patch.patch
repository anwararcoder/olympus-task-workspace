diff --git a/criteria/mongo/src/org/immutables/criteria/mongo/QuantifierFindExpression.java b/criteria/mongo/src/org/immutables/criteria/mongo/QuantifierFindExpression.java
new file mode 100644
index 0000000..de03355
--- /dev/null
+++ b/criteria/mongo/src/org/immutables/criteria/mongo/QuantifierFindExpression.java
@@ -0,0 +1,325 @@
+package org.immutables.criteria.mongo;
+
+import com.Capella.common.base.Preconditions;
+import com.mongodb.client.model.Filters;
+import org.bson.BsonArray;
+import org.bson.BsonBoolean;
+import org.bson.BsonDocument;
+import org.bson.BsonInt32;
+import org.bson.BsonNull;
+import org.bson.BsonString;
+import org.bson.BsonValue;
+import org.bson.codecs.configuration.CodecRegistry;
+import org.bson.conversions.Bson;
+import org.immutables.criteria.backend.PathNaming;
+import org.immutables.criteria.expression.Call;
+import org.immutables.criteria.expression.ComparableOperators;
+import org.immutables.criteria.expression.Constant;
+import org.immutables.criteria.expression.Expression;
+import org.immutables.criteria.expression.IterableOperators;
+import org.immutables.criteria.expression.Operator;
+import org.immutables.criteria.expression.Operators;
+import org.immutables.criteria.expression.OptionalOperators;
+import org.immutables.criteria.expression.Path;
+import org.immutables.criteria.expression.StringOperators;
+import org.immutables.criteria.expression.Visitors;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.Objects;
+
+/**
+ * Builds aggregation expressions for collection quantifiers. Element predicates use nullable booleans:
+ * {@code null} represents a missing or null value and only {@code true} satisfies a quantifier.
+ */
+final class QuantifierFindExpression {
+
+  private static final BsonBoolean TRUE = BsonBoolean.TRUE;
+  private static final BsonBoolean FALSE = BsonBoolean.FALSE;
+  private static final BsonNull NULL = BsonNull.VALUE;
+
+  private final PathNaming naming;
+  private final CodecRegistry codecRegistry;
+  private int variableCounter;
+
+  QuantifierFindExpression(PathNaming naming, CodecRegistry codecRegistry) {
+    this.naming = Objects.requireNonNull(naming, "naming");
+    this.codecRegistry = Objects.requireNonNull(codecRegistry, "codecRegistry");
+  }
+
+  Bson toFilter(Call call) {
+    return new BsonDocument("$expr", isTrue(predicate(call, null)));
+  }
+
+  private BsonValue predicate(Call call, Scope scope) {
+    Operator operator = call.operator();
+    List<Expression> arguments = call.arguments();
+
+    if (isQuantifier(operator)) {
+      return quantify(call, scope);
+    }
+
+    if (operator == Operators.AND || operator == Operators.OR) {
+      List<BsonValue> values = new ArrayList<>();
+      for (Expression argument : arguments) {
+        Preconditions.checkArgument(argument instanceof Call, "%s is not a call", argument);
+        values.add(predicate((Call) argument, scope));
+      }
+      return operator == Operators.AND ? triAnd(values) : triOr(values);
+    }
+
+    if (operator == Operators.NOT) {
+      Preconditions.checkArgument(arguments.size() == 1 && arguments.get(0) instanceof Call,
+          "Expected one call argument for %s", call);
+      return triNot(predicate((Call) arguments.get(0), scope));
+    }
+
+    if (operator == OptionalOperators.IS_PRESENT || operator == OptionalOperators.IS_ABSENT) {
+      Preconditions.checkArgument(arguments.size() == 1, "Expected one argument for %s", call);
+      BsonValue present = nonNull(value(arguments.get(0), scope));
+      return operator == OptionalOperators.IS_PRESENT ? present : boolNot(present);
+    }
+
+    if (operator == IterableOperators.IS_EMPTY || operator == IterableOperators.NOT_EMPTY) {
+      Preconditions.checkArgument(arguments.size() == 1, "Expected one argument for %s", call);
+      BsonValue collection = value(arguments.get(0), scope);
+      BsonValue empty = comparison("$eq", size(collection), new BsonInt32(0));
+      return guarded(isArray(collection), operator == IterableOperators.IS_EMPTY ? empty : boolNot(empty));
+    }
+
+    if (operator.arity() == Operator.Arity.BINARY) {
+      Preconditions.checkArgument(arguments.size() == 2, "Expected two arguments for %s", call);
+      return binary(call, scope);
+    }
+
+    throw new UnsupportedOperationException("Unsupported quantified predicate " + call);
+  }
+
+  private BsonValue quantify(Call call, Scope parentScope) {
+    Preconditions.checkArgument(call.arguments().size() == 2, "Expected two arguments for %s", call);
+    Preconditions.checkArgument(call.arguments().get(0) instanceof Path, "%s is not a path", call.arguments().get(0));
+    Preconditions.checkArgument(call.arguments().get(1) instanceof Call, "%s is not a call", call.arguments().get(1));
+
+    BsonValue collection = path((Path) call.arguments().get(0), parentScope);
+    String variable = "criteria" + variableCounter++;
+    Scope scope = new Scope(variable);
+    BsonValue element = new BsonString("$$" + variable);
+    BsonValue matches = boolAnd(nonNull(element), isTrue(predicate((Call) call.arguments().get(1), scope)));
+
+    BsonDocument map = operation("$map", new BsonDocument()
+        .append("input", collection)
+        .append("as", new BsonString(variable))
+        .append("in", matches));
+    BsonValue any = operation("$anyElementTrue", arguments(map));
+    BsonValue result;
+    if (call.operator() == IterableOperators.ANY) {
+      result = any;
+    } else if (call.operator() == IterableOperators.ALL) {
+      result = operation("$allElementsTrue", arguments(map));
+    } else if (call.operator() == IterableOperators.NONE) {
+      result = boolNot(any);
+    } else {
+      throw new IllegalArgumentException("Not a quantifier: " + call.operator());
+    }
+
+    return conditional(isArray(collection), result, NULL);
+  }
+
+  private BsonValue binary(Call call, Scope scope) {
+    Operator operator = call.operator();
+    BsonValue left = value(call.arguments().get(0), scope);
+    BsonValue right = value(call.arguments().get(1), scope);
+
+    if (operator == Operators.EQUAL || operator == Operators.NOT_EQUAL) {
+      BsonValue comparison = comparison(operator == Operators.EQUAL ? "$eq" : "$ne", left, right);
+      return guarded(nonNull(left), comparison);
+    }
+
+    if (operator == Operators.IN || operator == Operators.NOT_IN) {
+      BsonValue in = comparison("$in", left, right);
+      return guarded(nonNull(left), operator == Operators.IN ? in : boolNot(in));
+    }
+
+    if (ComparableOperators.isComparable(operator)) {
+      String mongoOperator;
+      if (operator == ComparableOperators.GREATER_THAN) {
+        mongoOperator = "$gt";
+      } else if (operator == ComparableOperators.GREATER_THAN_OR_EQUAL) {
+        mongoOperator = "$gte";
+      } else if (operator == ComparableOperators.LESS_THAN) {
+        mongoOperator = "$lt";
+      } else {
+        mongoOperator = "$lte";
+      }
+      return guarded(nonNull(left), comparison(mongoOperator, left, right));
+    }
+
+    if (operator == StringOperators.HAS_LENGTH) {
+      return guarded(nonNull(left), comparison("$eq", stringLength(left), right));
+    }
+
+    if (operator == StringOperators.STARTS_WITH || operator == StringOperators.CONTAINS) {
+      BsonValue index = operation("$indexOfCP", arguments(left, right));
+      BsonValue expected = new BsonInt32(operator == StringOperators.STARTS_WITH ? 0 : -1);
+      String comparison = operator == StringOperators.STARTS_WITH ? "$eq" : "$gt";
+      return guarded(nonNull(left), comparison(comparison, index, expected));
+    }
+
+    if (operator == StringOperators.ENDS_WITH) {
+      Object constant = Visitors.toConstant(call.arguments().get(1)).value();
+      int suffixLength = constant.toString().codePointCount(0, constant.toString().length());
+      BsonValue inputLength = stringLength(left);
+      BsonValue longEnough = comparison("$gte", inputLength, new BsonInt32(suffixLength));
+      BsonValue start = operation("$subtract", arguments(inputLength, new BsonInt32(suffixLength)));
+      BsonValue suffix = operation("$substrCP", arguments(left, start, new BsonInt32(suffixLength)));
+      BsonValue matches = conditional(longEnough, comparison("$eq", suffix, right), FALSE);
+      return guarded(nonNull(left), matches);
+    }
+
+    if (operator == StringOperators.MATCHES) {
+      BsonDocument regex = new BsonDocument().append("input", left).append("regex", right);
+      return guarded(nonNull(left), operation("$regexMatch", regex));
+    }
+
+    if (operator == IterableOperators.HAS_SIZE) {
+      return guarded(isArray(left), comparison("$eq", size(left), right));
+    }
+
+    if (operator == IterableOperators.CONTAINS) {
+      return guarded(isArray(left), comparison("$in", right, left));
+    }
+
+    throw new UnsupportedOperationException("Unsupported quantified binary call " + call);
+  }
+
+  private BsonValue value(Expression expression, Scope scope) {
+    if (expression instanceof Path) {
+      return path((Path) expression, scope);
+    }
+
+    if (expression instanceof Constant) {
+      return constant((Constant) expression);
+    }
+
+    Preconditions.checkArgument(expression instanceof Call, "%s is not a value expression", expression);
+    Call call = (Call) expression;
+    if (call.operator() == StringOperators.TO_UPPER_CASE || call.operator() == StringOperators.TO_LOWER_CASE) {
+      BsonValue input = value(call.arguments().get(0), scope);
+      String operator = call.operator() == StringOperators.TO_UPPER_CASE ? "$toUpper" : "$toLower";
+      return conditional(nonNull(input), operation(operator, input), NULL);
+    }
+
+    throw new UnsupportedOperationException("Unsupported quantified value " + expression);
+  }
+
+  private BsonValue path(Path path, Scope scope) {
+    String pathName = naming.name(path);
+    if (scope == null) {
+      return new BsonString("$" + pathName);
+    }
+
+    String prefix = "$$" + scope.variable;
+    return new BsonString(pathName.isEmpty() ? prefix : prefix + "." + pathName);
+  }
+
+  private BsonValue constant(Constant constant) {
+    Object value = constant.value();
+    if (value == null) {
+      return NULL;
+    }
+    return Filters.eq("_", value).toBsonDocument(BsonDocument.class, codecRegistry).get("_");
+  }
+
+  private static boolean isQuantifier(Operator operator) {
+    return operator == IterableOperators.ANY || operator == IterableOperators.ALL || operator == IterableOperators.NONE;
+  }
+
+  private static BsonValue guarded(BsonValue valid, BsonValue result) {
+    return conditional(valid, result, NULL);
+  }
+
+  private static BsonValue isTrue(BsonValue value) {
+    return comparison("$eq", value, TRUE);
+  }
+
+  private static BsonValue nonNull(BsonValue value) {
+    return comparison("$ne", value, NULL);
+  }
+
+  private static BsonValue isArray(BsonValue value) {
+    return operation("$isArray", arguments(value));
+  }
+
+  private static BsonValue size(BsonValue value) {
+    return operation("$size", value);
+  }
+
+  private static BsonValue stringLength(BsonValue value) {
+    return operation("$strLenCP", value);
+  }
+
+  private static BsonValue triNot(BsonValue value) {
+    return conditional(comparison("$eq", value, NULL), NULL, boolNot(value));
+  }
+
+  private static BsonValue triAnd(List<BsonValue> values) {
+    BsonValue result = TRUE;
+    for (BsonValue value : values) {
+      BsonValue hasFalse = operation("$or", arguments(
+          comparison("$eq", value, FALSE),
+          comparison("$eq", result, FALSE)));
+      BsonValue hasUnknown = operation("$or", arguments(
+          comparison("$eq", value, NULL),
+          comparison("$eq", result, NULL)));
+      result = conditional(hasFalse, FALSE, conditional(hasUnknown, NULL, TRUE));
+    }
+    return result;
+  }
+
+  private static BsonValue triOr(List<BsonValue> values) {
+    BsonValue result = FALSE;
+    for (BsonValue value : values) {
+      BsonValue hasTrue = operation("$or", arguments(
+          comparison("$eq", value, TRUE),
+          comparison("$eq", result, TRUE)));
+      BsonValue hasUnknown = operation("$or", arguments(
+          comparison("$eq", value, NULL),
+          comparison("$eq", result, NULL)));
+      result = conditional(hasTrue, TRUE, conditional(hasUnknown, NULL, FALSE));
+    }
+    return result;
+  }
+
+  private static BsonValue boolAnd(BsonValue... values) {
+    return operation("$and", arguments(values));
+  }
+
+  private static BsonValue boolNot(BsonValue value) {
+    return operation("$not", arguments(value));
+  }
+
+  private static BsonValue comparison(String operator, BsonValue left, BsonValue right) {
+    return operation(operator, arguments(left, right));
+  }
+
+  private static BsonValue conditional(BsonValue condition, BsonValue ifTrue, BsonValue ifFalse) {
+    return operation("$cond", arguments(condition, ifTrue, ifFalse));
+  }
+
+  private static BsonDocument operation(String operator, BsonValue value) {
+    return new BsonDocument(operator, value);
+  }
+
+  private static BsonArray arguments(BsonValue... values) {
+    return new BsonArray(Arrays.asList(values));
+  }
+
+  private static final class Scope {
+    private final String variable;
+
+    private Scope(String variable) {
+      this.variable = variable;
+    }
+  }
+}
