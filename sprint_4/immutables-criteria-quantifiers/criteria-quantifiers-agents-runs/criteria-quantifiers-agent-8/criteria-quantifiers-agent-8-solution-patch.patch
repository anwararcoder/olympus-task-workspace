+    if (operator == IterableOperators.IS_EMPTY || operator == IterableOperators.NOT_EMPTY) {
+      BsonValue empty = document("$eq", array(document("$size", document("$ifNull", array(target, new BsonArray()))), new BsonInt32(0)));
+      return operator == IterableOperators.IS_EMPTY ? empty : document("$not", array(empty));
+    }
+
+    Preconditions.checkArgument(call.arguments().size() == 2, "Expected binary call %s", call);
+    BsonValue argument = constant(Visitors.toConstant(call.arguments().get(1)));
+
+    if (operator == Operators.EQUAL || operator == Operators.NOT_EQUAL) {
+      return document(operator == Operators.EQUAL ? "$eq" : "$ne", array(target, argument));
+    }
+    if (operator == Operators.IN || operator == Operators.NOT_IN) {
+      BsonValue in = document("$in", array(target, argument));
+      return operator == Operators.IN ? in : document("$not", array(in));
+    }
+    if (ComparableOperators.isComparable(operator)) {
+      String mongoOperator;
+      if (operator == ComparableOperators.GREATER_THAN) mongoOperator = "$gt";
+      else if (operator == ComparableOperators.GREATER_THAN_OR_EQUAL) mongoOperator = "$gte";
+      else if (operator == ComparableOperators.LESS_THAN) mongoOperator = "$lt";
+      else mongoOperator = "$lte";
+      return document(mongoOperator, array(target, argument));
+    }
+    if (operator == IterableOperators.HAS_SIZE) {
+      return document("$eq", array(document("$size", document("$ifNull", array(target, new BsonArray()))), argument));
+    }
+    if (operator == IterableOperators.CONTAINS) {
+      return document("$in", array(argument, target));
+    }
+    if (operator == StringOperators.HAS_LENGTH) {
+      int length = ((Number) Visitors.toConstant(call.arguments().get(1)).value()).intValue();
+      BsonValue regex = constant(Pattern.compile("(?s)^.{" + length + "}$"));
+      return new BsonDocument("$regexMatch", new BsonDocument("input", document("$ifNull", array(target, new BsonString(""))))
+          .append("regex", regex));
+    }
+    if (operator == StringOperators.MATCHES || operator == StringOperators.STARTS_WITH ||
+        operator == StringOperators.CONTAINS || operator == StringOperators.ENDS_WITH) {
+      BsonValue regex = argument;
+      if (operator != StringOperators.MATCHES) {
+        Object raw = Visitors.toConstant(call.arguments().get(1)).value();
+        String pattern = (operator == StringOperators.STARTS_WITH ? "^" : "") +
+            Pattern.quote(raw.toString()) + (operator == StringOperators.ENDS_WITH ? "$" : "");
+        regex = constant(Pattern.compile(pattern));
+      }
+      return new BsonDocument("$regexMatch", new BsonDocument("input", target).append("regex", regex));
+    }
+
+    throw new UnsupportedOperationException("Unsupported quantified operation " + call);
+  }
+
+  private static BsonValue guard(Call call, BsonValue target) {
+    Operator operator = call.operator();
+    if (operator == IterableOperators.IS_EMPTY || operator == IterableOperators.NOT_EMPTY ||
+        operator == IterableOperators.HAS_SIZE || operator == IterableOperators.CONTAINS) {
+      return document("$isArray", target);
+    }
+    if (operator == StringOperators.MATCHES || operator == StringOperators.STARTS_WITH ||
+        operator == StringOperators.CONTAINS || operator == StringOperators.ENDS_WITH ||
+        operator == StringOperators.HAS_LENGTH) {
+      return known(target);
+    }
+    return known(target);
+  }
+
+  private BsonValue value(Expression expression, String scope) {
+    if (expression instanceof Path) {
+      Path expressionPath = (Path) expression;
+      String path = expressionPath.members().isEmpty() ? "" : naming.name(expressionPath);
+      String reference = scope == null ? "$" + path : "$$" + scope + (path.isEmpty() ? "" : "." + path);
+      return new BsonString(reference);
+    }
+    if (expression instanceof Constant) {
+      return constant((Constant) expression);
+    }
+    Preconditions.checkArgument(expression instanceof Call, "Unsupported value expression %s", expression);
+    Call call = (Call) expression;
+    BsonValue argument = value(call.arguments().get(0), scope);
+    if (call.operator() == StringOperators.TO_UPPER_CASE) {
+      return document("$toUpper", argument);
+    }
+    if (call.operator() == StringOperators.TO_LOWER_CASE) {
+      return document("$toLower", argument);
+    }
+    throw new UnsupportedOperationException("Unsupported quantified value " + call);
+  }
+
+  private static BsonValue known(BsonValue value) {
+    return document("$ne", array(value, BsonNull.VALUE));
+  }
+
+  private BsonValue constant(Constant constant) {
+    if (constant.value() instanceof Collection) {
+      BsonArray values = new BsonArray();
+      for (Object value : constant.values()) {
+        values.add(rawConstant(value));
+      }
+      return document("$literal", values);
+    }
+    return constant(constant.value());
+  }
+
+  private BsonValue constant(Object value) {
+    return document("$literal", rawConstant(value));
+  }
+
+  private BsonValue rawConstant(Object value) {
+    if (value == null) return BsonNull.VALUE;
+    BsonDocument encoded = Filters.eq("_", value).toBsonDocument(BsonDocument.class, codecRegistry);
+    return encoded.get("_");
+  }
+
+  private static boolean isQuantifier(Operator operator) {
+    return operator == IterableOperators.ANY || operator == IterableOperators.ALL || operator == IterableOperators.NONE;
+  }
+
+  private static BsonDocument document(String key, BsonValue value) {
+    return new BsonDocument(key, value);
+  }
+
+  private static BsonArray array(BsonValue... values) {
+    List<BsonValue> list = new ArrayList<>(values.length);
+    java.util.Collections.addAll(list, values);
+    return new BsonArray(list);
+  }
+}
