+
+  QuantifierExpr(PathNaming naming, CodecRegistry codecRegistry) {
+    this.naming = Objects.requireNonNull(naming, "naming");
+    this.codecRegistry = Objects.requireNonNull(codecRegistry, "codecRegistry");
+  }
+
+  Bson create(Call call) {
+    return new BsonDocument("$expr", quantified(call, null));
+  }
+
+  private BsonValue quantified(Call call, String scope) {
+    Operator operator = call.operator();
+    Preconditions.checkArgument(isQuantifier(operator), "%s is not a quantifier", operator);
+    Preconditions.checkArgument(call.arguments().size() == 2, "Expected two arguments for %s", call);
+    Preconditions.checkArgument(call.arguments().get(0) instanceof Path, "%s is not a path", call.arguments().get(0));
+
+    BsonValue input = value(call.arguments().get(0), scope);
+    String variable = "q" + variables.incrementAndGet();
+    BsonValue predicate = predicate(call.arguments().get(1), variable);
+    BsonValue matches = document("$eq", array(predicate, BsonBoolean.TRUE));
+    BsonValue safeInput = document("$ifNull", array(input, new BsonArray()));
+    BsonDocument map = new BsonDocument("$map", new BsonDocument("input", safeInput)
+        .append("as", new BsonString(variable))
+        .append("in", matches));
+
+    String aggregate = operator == IterableOperators.ALL ? "$allElementsTrue" : "$anyElementTrue";
+    BsonValue result = document(aggregate, array(map));
+    if (operator == IterableOperators.NONE) {
+      result = document("$not", array(result));
+    }
+
+    return document("$and", array(document("$isArray", input), result));
+  }
+
+  private BsonValue predicate(Expression expression, String scope) {
+    Preconditions.checkArgument(expression instanceof Call, "%s is not a call", expression);
+    Call call = (Call) expression;
+    Operator operator = call.operator();
+
+    if (isQuantifier(operator)) {
+      return quantified(call, scope);
+    }
+
+    if (operator == Operators.NOT) {
+      BsonValue nested = predicate(call.arguments().get(0), scope);
+      return document("$eq", array(nested, BsonBoolean.FALSE));
+    }
