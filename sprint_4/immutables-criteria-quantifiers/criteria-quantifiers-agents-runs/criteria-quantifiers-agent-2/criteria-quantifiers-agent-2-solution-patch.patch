+    if (operator == IterableOperators.IS_EMPTY || operator == IterableOperators.NOT_EMPTY) {
+      Bson known = type(path, BsonType.ARRAY);
+      Bson unknown = notType(path, BsonType.ARRAY);
+      Bson empty = condition(path, new BsonDocument("$eq", new org.bson.BsonArray()));
+      Bson nonEmpty = condition(path, new BsonDocument("$ne", new org.bson.BsonArray()));
+      return operator == IterableOperators.IS_EMPTY
+          ? new Truth(Filters.and(known, empty), Filters.and(known, nonEmpty), unknown, scalar)
+          : new Truth(Filters.and(known, nonEmpty), Filters.and(known, empty), unknown, scalar);
+    }
+
+    Preconditions.checkArgument(operator.arity() == Operator.Arity.BINARY, "Unsupported quantified call %s", call);
+    Object value = Visitors.toConstant(call.arguments().get(1)).value();
+    Bson trueCondition;
+    Bson falseCondition;
+    Bson unknownCondition = absent(path);
+
+    if (scalar && (operator == Operators.EQUAL || operator == Operators.NOT_EQUAL)) {
+      Bson equal = new BsonDocument("$eq", encode(value));
+      Bson notEqual = new BsonDocument("$nin", new org.bson.BsonArray(Arrays.asList(encode(value), BsonNull.VALUE)));
+      trueCondition = operator == Operators.EQUAL ? equal : notEqual;
+      falseCondition = operator == Operators.EQUAL ? notEqual : equal;
+    } else if (operator == Operators.EQUAL || operator == Operators.NOT_EQUAL) {
+      Bson equal = condition(path, new BsonDocument("$eq", encode(value)));
+      Bson notEqual = condition(path, new BsonDocument("$ne", encode(value)));
+      trueCondition = operator == Operators.EQUAL ? equal : notEqual;
+      falseCondition = operator == Operators.EQUAL ? notEqual : equal;
+    } else if (operator == Operators.IN || operator == Operators.NOT_IN) {
+      Collection<?> values = ImmutableSet.copyOf(Visitors.toConstant(call.arguments().get(1)).values());
+      BsonValue encoded = encode(values);
+      Collection<Object> valuesWithNull = new ArrayList<>();
+      valuesWithNull.addAll(values);
+      valuesWithNull.add(null);
+      Bson in = condition(path, new BsonDocument("$in", encoded));
+      Bson notIn = condition(path, new BsonDocument("$nin", scalar ? encode(valuesWithNull) : encoded));
+      trueCondition = operator == Operators.IN ? in : notIn;
+      falseCondition = operator == Operators.IN ? notIn : in;
+    } else if (ComparableOperators.isComparable(operator)) {
+      String queryOperator = comparisonName(operator);
+      String inverseOperator = inverseComparisonName(operator);
+      BsonDocument trueComparison = new BsonDocument(queryOperator, encode(value));
+      BsonDocument falseComparison = new BsonDocument(inverseOperator, encode(value));
+      if (scalar) {
+        trueComparison.append("$ne", BsonNull.VALUE);
+        falseComparison.append("$ne", BsonNull.VALUE);
+      }
+      trueCondition = condition(path, trueComparison);
+      falseCondition = condition(path, falseComparison);
+    } else if (operator == IterableOperators.HAS_SIZE) {
+      Bson known = type(path, BsonType.ARRAY);
+      unknownCondition = notType(path, BsonType.ARRAY);
+      Bson size = condition(path, new BsonDocument("$size", new BsonInt32(((Number) value).intValue())));
+      trueCondition = Filters.and(known, size);
+      falseCondition = Filters.and(known, Filters.nor(size));
+    } else if (operator == IterableOperators.CONTAINS) {
+      Bson known = type(path, BsonType.ARRAY);
+      unknownCondition = notType(path, BsonType.ARRAY);
+      Bson contains = condition(path, new BsonDocument("$eq", encode(value)));
+      trueCondition = Filters.and(known, contains);
+      falseCondition = Filters.and(known, Filters.nor(contains));
+    } else if (operator == StringOperators.MATCHES || operator == StringOperators.CONTAINS ||
+        operator == StringOperators.STARTS_WITH || operator == StringOperators.ENDS_WITH ||
+        operator == StringOperators.HAS_LENGTH) {
+      Pattern pattern = stringPattern(operator, value);
+      Bson known = type(path, BsonType.STRING);
+      unknownCondition = notType(path, BsonType.STRING);
+      Bson matches = regex(path, pattern);
+      if (scalar) {
+        BsonValue regexValue = Filters.regex("_", pattern).toBsonDocument(BsonDocument.class, codecRegistry).get("_");
+        BsonValue complement = Filters.regex("_", negate(pattern))
+            .toBsonDocument(BsonDocument.class, codecRegistry).get("_");
+        trueCondition = scalarRegex(regexValue);
+        falseCondition = scalarRegex(complement);
+      } else {
+        trueCondition = Filters.and(known, matches);
+        falseCondition = Filters.and(known, Filters.nor(matches));
+      }
+    } else {
+      throw new UnsupportedOperationException("Unsupported operator in quantified scope: " + operator);
+    }
+
+    Bson known = present(path);
+    if (!scalar && (operator == Operators.NOT_EQUAL || operator == Operators.NOT_IN ||
+        operator == Operators.EQUAL || operator == Operators.IN || ComparableOperators.isComparable(operator))) {
+      trueCondition = Filters.and(known, trueCondition);
+      falseCondition = Filters.and(known, falseCondition);
+    }
+    return new Truth(trueCondition, falseCondition, unknownCondition, scalar);
+  }
+
+  private Truth quantified(Call call) {
+    Preconditions.checkArgument(call.arguments().size() == 2, "Expected two arguments for %s", call);
+    Path path = Visitors.toPath(call.arguments().get(0));
+    Preconditions.checkArgument(!path.members().isEmpty(), "Nested collection elements are not supported");
+    Truth element = truth(call.arguments().get(1));
+    Bson array = type(path, BsonType.ARRAY);
+    Bson notArray = notType(path, BsonType.ARRAY);
+    Bson anyTrue = elemMatch(path, element.trueCondition);
+    Bson noTrue = notElemMatch(path, element.trueCondition);
+    Bson anyNotTrue = element.scalar
+        ? Filters.or(elemMatch(path, element.falseCondition), elemMatch(path, element.unknownCondition))
+        : elemMatch(path, Filters.or(element.falseCondition, element.unknownCondition));
+    Bson noNotTrue = element.scalar
+        ? Filters.and(notElemMatch(path, element.falseCondition), notElemMatch(path, element.unknownCondition))
+        : notElemMatch(path, Filters.or(element.falseCondition, element.unknownCondition));
+
+    if (call.operator() == IterableOperators.ANY) {
+      return new Truth(Filters.and(array, anyTrue), Filters.and(array, noTrue), notArray, false);
+    }
+    if (call.operator() == IterableOperators.ALL) {
+      return new Truth(Filters.and(array, noNotTrue), Filters.and(array, anyNotTrue), notArray, false);
+    }
+    return new Truth(Filters.and(array, noTrue), Filters.and(array, anyTrue), notArray, false);
+  }
+
+  private Bson condition(Path path, BsonValue condition) {
+    if (path.members().isEmpty()) {
+      return condition.asDocument();
+    }
+    return new BsonDocument(naming.name(path), condition);
+  }
+
+  private Bson regex(Path path, Pattern pattern) {
+    BsonDocument document = Filters.regex("_", pattern).toBsonDocument(BsonDocument.class, codecRegistry);
+    BsonValue regex = document.get("_");
+    return path.members().isEmpty() ? new BsonDocument("$regex", regex) : condition(path, regex);
+  }
+
+  private Bson present(Path path) {
+    if (path.members().isEmpty()) {
+      return new BsonDocument("$ne", BsonNull.VALUE);
+    }
+    String field = naming.name(path);
+    return Filters.and(Filters.exists(field), Filters.ne(field, null));
+  }
+
+  private Bson absent(Path path) {
+    if (path.members().isEmpty()) {
+      return new BsonDocument("$eq", BsonNull.VALUE);
+    }
+    String field = naming.name(path);
+    return Filters.or(Filters.exists(field, false), Filters.eq(field, null));
+  }
+
+  private Bson type(Path path, BsonType type) {
+    if (path.members().isEmpty()) {
+      return new BsonDocument("$type", new BsonInt32(type.getValue()));
+    }
+    return Filters.type(naming.name(path), type);
+  }
+
+  private Bson notType(Path path, BsonType type) {
+    BsonDocument typeCondition = new BsonDocument("$type", new BsonInt32(type.getValue()));
+    if (path.members().isEmpty()) {
+      return new BsonDocument("$not", typeCondition);
+    }
+    return new BsonDocument(naming.name(path), new BsonDocument("$not", typeCondition));
+  }
+
+  private Bson elemMatch(Path path, Bson condition) {
+    return Filters.elemMatch(naming.name(path), condition);
+  }
+
+  private Bson notElemMatch(Path path, Bson condition) {
+    BsonDocument elemMatch = new BsonDocument("$elemMatch", bson(condition));
+    return new BsonDocument(naming.name(path), new BsonDocument("$not", elemMatch));
+  }
+
+  private BsonValue encode(Object value) {
+    return Filters.eq("_", value).toBsonDocument(BsonDocument.class, codecRegistry).get("_");
+  }
+
+  private BsonDocument bson(Bson value) {
+    return value.toBsonDocument(BsonDocument.class, codecRegistry);
+  }
+
+  private static Bson scalarRegex(BsonValue regexValue) {
+    org.bson.BsonRegularExpression regex = regexValue.asRegularExpression();
+    BsonDocument condition = new BsonDocument("$type", new BsonInt32(BsonType.STRING.getValue()))
+        .append("$regex", new org.bson.BsonString(regex.getPattern()));
+    if (!regex.getOptions().isEmpty()) {
+      condition.append("$options", new org.bson.BsonString(regex.getOptions()));
+    }
+    return condition;
+  }
+
+  private Bson scalarAnd(List<Bson> conditions) {
+    BsonDocument result = new BsonDocument();
+    List<BsonValue> excluded = new ArrayList<>();
+    for (Bson condition : conditions) {
+      BsonDocument document = bson(condition);
+      for (String key : document.keySet()) {
+        BsonValue value = document.get(key);
+        if (key.equals("$ne")) {
+          excluded.add(value);
+        } else if (key.equals("$nin")) {
+          excluded.addAll(value.asArray());
+        } else if (key.equals("$eq") && result.containsKey("$eq") && !result.get("$eq").equals(value)) {
+          return new BsonDocument("$in", new org.bson.BsonArray());
+        } else {
+          result.put(key, value);
+        }
+      }
+    }
+    if (!excluded.isEmpty()) {
+      result.put("$nin", new org.bson.BsonArray(excluded));
+    }
+    return result;
+  }
+
+  private Bson scalarOr(List<Bson> conditions) {
+    List<BsonValue> included = new ArrayList<>();
+    for (Bson condition : conditions) {
+      BsonDocument document = bson(condition);
+      if (document.size() == 1 && document.containsKey("$eq")) {
+        included.add(document.get("$eq"));
+      } else if (document.size() == 1 && document.containsKey("$in")) {
+        included.addAll(document.getArray("$in"));
+      } else {
+        return Filters.or(conditions);
+      }
+    }
+    return new BsonDocument("$in", new org.bson.BsonArray(included));
+  }
+
+  private static Pattern negate(Pattern pattern) {
+    return Pattern.compile("^(?![\\s\\S]*?(?:" + pattern.pattern() + "))[\\s\\S]*$", pattern.flags());
+  }
+
+  private static Pattern stringPattern(Operator operator, Object value) {
+    if (operator == StringOperators.MATCHES) {
+      return (Pattern) value;
+    }
+    if (operator == StringOperators.HAS_LENGTH) {
+      return Pattern.compile("^(?:[\\s\\S]){" + ((Number) value).intValue() + "}$");
+    }
+    String quoted = Pattern.quote(value.toString());
+    if (operator == StringOperators.STARTS_WITH) {
+      return Pattern.compile("^" + quoted);
+    }
+    if (operator == StringOperators.ENDS_WITH) {
+      return Pattern.compile(quoted + "$");
+    }
+    return Pattern.compile(quoted);
+  }
+
+  private static boolean isQuantifier(Operator operator) {
+    return operator == IterableOperators.ANY || operator == IterableOperators.ALL || operator == IterableOperators.NONE;
+  }
+
+  private static String comparisonName(Operator operator) {
+    if (operator == ComparableOperators.GREATER_THAN) return "$gt";
+    if (operator == ComparableOperators.GREATER_THAN_OR_EQUAL) return "$gte";
+    if (operator == ComparableOperators.LESS_THAN) return "$lt";
+    if (operator == ComparableOperators.LESS_THAN_OR_EQUAL) return "$lte";
+    throw new IllegalArgumentException("Not a comparison: " + operator);
+  }
+
+  private static String inverseComparisonName(Operator operator) {
+    if (operator == ComparableOperators.GREATER_THAN) return "$lte";
+    if (operator == ComparableOperators.GREATER_THAN_OR_EQUAL) return "$lt";
+    if (operator == ComparableOperators.LESS_THAN) return "$gte";
+    if (operator == ComparableOperators.LESS_THAN_OR_EQUAL) return "$gt";
+    throw new IllegalArgumentException("Not a comparison: " + operator);
+  }
+
+  private static Bson impossible(boolean scalar) {
+    return scalar
+        ? new BsonDocument("$in", new org.bson.BsonArray())
+        : Filters.and(Filters.exists("_criteria_impossible_"), Filters.exists("_criteria_impossible_", false));
+  }
+
+  private static final class Truth {
+    private final Bson trueCondition;
+    private final Bson falseCondition;
+    private final Bson unknownCondition;
+    private final boolean scalar;
+
+    private Truth(Bson trueCondition, Bson falseCondition, Bson unknownCondition, boolean scalar) {
+      this.trueCondition = trueCondition;
+      this.falseCondition = falseCondition;
+      this.unknownCondition = unknownCondition;
+      this.scalar = scalar;
+    }
+  }
+}
