+
+final class QuantifierFindVisitor {
+
+  private final PathNaming naming;
+  private final CodecRegistry codecRegistry;
+
+  QuantifierFindVisitor(PathNaming naming, CodecRegistry codecRegistry) {
+    this.naming = Objects.requireNonNull(naming, "naming");
+    this.codecRegistry = Objects.requireNonNull(codecRegistry, "codecRegistry");
+  }
+
+  Bson filter(Call call) {
+    return truth(call).trueCondition;
+  }
+
+  private Truth truth(Expression expression) {
+    Preconditions.checkArgument(expression instanceof Call, "%s is not a call", expression);
+    Call call = (Call) expression;
+    Operator operator = call.operator();
+
+    if (operator == Operators.NOT) {
+      Truth inner = truth(call.arguments().get(0));
+      return new Truth(inner.falseCondition, inner.trueCondition, inner.unknownCondition, inner.scalar);
+    }
+
+    if (operator == Operators.AND || operator == Operators.OR) {
+      List<Bson> trueConditions = new ArrayList<>();
+      List<Bson> falseConditions = new ArrayList<>();
+      List<Bson> unknownConditions = new ArrayList<>();
+      boolean scalar = true;
+      for (Expression argument : call.arguments()) {
+        Truth child = truth(argument);
+        trueConditions.add(child.trueCondition);
+        falseConditions.add(child.falseCondition);
+        unknownConditions.add(child.unknownCondition);
+        scalar &= child.scalar;
+      }
+
+      if (operator == Operators.AND) {
+        Bson trueCondition = scalar ? scalarAnd(trueConditions) : Filters.and(trueConditions);
+        Bson falseCondition = scalar ? scalarOr(falseConditions) : Filters.or(falseConditions);
+        Bson unknownCondition = scalar
+            ? new BsonDocument("$eq", BsonNull.VALUE)
+            : Filters.and(Filters.nor(falseCondition), Filters.or(unknownConditions));
+        return new Truth(trueCondition, falseCondition, unknownCondition, scalar);
+      }
+
+      Bson trueCondition = scalar ? scalarOr(trueConditions) : Filters.or(trueConditions);
+      Bson falseCondition = scalar ? scalarAnd(falseConditions) : Filters.and(falseConditions);
+      Bson unknownCondition = scalar
+          ? new BsonDocument("$eq", BsonNull.VALUE)
+          : Filters.and(Filters.nor(trueCondition), Filters.or(unknownConditions));
+      return new Truth(trueCondition, falseCondition, unknownCondition, scalar);
+    }
+
+    if (isQuantifier(operator)) {
+      return quantified(call);
+    }
+
+    Path path = Visitors.toPath(call.arguments().get(0));
+    boolean scalar = path.members().isEmpty();
+
+    if (operator == OptionalOperators.IS_PRESENT || operator == OptionalOperators.IS_ABSENT) {
+      Bson present = present(path);
+      Bson absent = absent(path);
+      return operator == OptionalOperators.IS_PRESENT
+          ? new Truth(present, absent, impossible(scalar), scalar)
+          : new Truth(absent, present, impossible(scalar), scalar);
+    }
