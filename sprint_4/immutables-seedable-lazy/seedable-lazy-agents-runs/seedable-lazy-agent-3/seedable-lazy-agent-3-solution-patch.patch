diff --git a/value-fixture/src/org/immutables/fixture/SeedableLazy.java b/value-fixture/src/org/immutables/fixture/SeedableLazy.java
new file mode 100644
index 0000000..082e9ad
--- /dev/null
+++ b/value-fixture/src/org/immutables/fixture/SeedableLazy.java
@@ -0,0 +1,52 @@
+package org.immutables.fixture;
+
+import java.io.Serializable;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.concurrent.atomic.AtomicInteger;
+import javax.annotation.Nullable;
+import org.immutables.value.Value;
+
+@Value.Immutable
+@Value.Modifiable
+@Value.Style(toBuilder = "toBuilder")
+public abstract class SeedableLazy implements Serializable {
+  private static final long serialVersionUID = 1L;
+
+  public abstract AtomicInteger counter();
+
+  @Value.Lazy
+  @Value.Default
+  public int number() {
+    return counter().incrementAndGet();
+  }
+
+  @Nullable
+  @Value.Lazy
+  @Value.Default
+  public String nullable() {
+    return "fallback-" + counter().incrementAndGet();
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public Optional<String> optional() {
+    counter().incrementAndGet();
+    return Optional.of("fallback");
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public List<String> list() {
+    counter().incrementAndGet();
+    return java.util.Collections.singletonList("fallback");
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public Map<String, Integer> map() {
+    counter().incrementAndGet();
+    return java.util.Collections.singletonMap("fallback", 1);
+  }
+}
diff --git a/value-fixture/test/org/immutables/fixture/SeedableLazyTest.java b/value-fixture/test/org/immutables/fixture/SeedableLazyTest.java
new file mode 100644
index 0000000..56530f0
--- /dev/null
+++ b/value-fixture/test/org/immutables/fixture/SeedableLazyTest.java
@@ -0,0 +1,136 @@
+package org.immutables.fixture;
+
+import static org.immutables.check.Checkers.check;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.ObjectInputStream;
+import java.io.ObjectOutputStream;
+import java.util.Collections;
+import java.util.Optional;
+import java.util.concurrent.atomic.AtomicInteger;
+import org.junit.jupiter.api.Test;
+
+public class SeedableLazyTest {
+  @Test
+  public void builderKeepsInitializerColdUntilNeeded() {
+    AtomicInteger counter = new AtomicInteger();
+    ImmutableSeedableLazy value = ImmutableSeedableLazy.builder().counter(counter).build();
+
+    check(counter.get()).is(0);
+    check(value.number()).is(1);
+    check(value.number()).is(1);
+    check(counter.get()).is(1);
+  }
+
+  @Test
+  public void explicitFalsyAndEmptyValuesAreSeeds() {
+    AtomicInteger counter = new AtomicInteger();
+    ImmutableSeedableLazy value = ImmutableSeedableLazy.builder()
+        .counter(counter)
+        .number(0)
+        .nullable(null)
+        .optional(Optional.empty())
+        .addAllList(Collections.emptyList())
+        .putAllMap(Collections.emptyMap())
+        .build();
+
+    check(value.number()).is(0);
+    check(value.nullable()).isNull();
+    check(value.optional()).is(Optional.empty());
+    check(value.list()).isEmpty();
+    check(value.map()).is(Collections.emptyMap());
+    check(counter.get()).is(0);
+  }
+
+  @Test
+  public void copiesPreserveOnlyExplicitSeeds() {
+    AtomicInteger seededCounter = new AtomicInteger();
+    ImmutableSeedableLazy seeded = ImmutableSeedableLazy.builder()
+        .counter(seededCounter)
+        .number(1)
+        .build();
+    check(seeded.withCounter(new AtomicInteger(10)).number()).is(1);
+
+    AtomicInteger computedCounter = new AtomicInteger();
+    ImmutableSeedableLazy computed = ImmutableSeedableLazy.builder().counter(computedCounter).build();
+    check(computed.number()).is(1);
+    AtomicInteger copyCounter = new AtomicInteger(10);
+    ImmutableSeedableLazy copy = computed.withCounter(copyCounter);
+    check(copyCounter.get()).is(10);
+    check(copy.number()).is(11);
+
+    ImmutableSeedableLazy explicitlyEqual = computed.withNumber(1);
+    check(explicitlyEqual.withCounter(new AtomicInteger(20)).number()).is(1);
+  }
+
+  @Test
+  public void builderCopyPathsDoNotForceFallbacks() {
+    AtomicInteger counter = new AtomicInteger();
+    ImmutableSeedableLazy source = ImmutableSeedableLazy.builder().counter(counter).build();
+
+    ImmutableSeedableLazy from = ImmutableSeedableLazy.builder().from(source).build();
+    ImmutableSeedableLazy rebuilt = source.toBuilder().build();
+    check(counter.get()).is(0);
+    check(from.number()).is(1);
+    check(rebuilt.number()).is(2);
+
+    ImmutableSeedableLazy destination = ImmutableSeedableLazy.builder()
+        .counter(counter)
+        .number(7)
+        .from(source)
+        .build();
+    check(destination.number()).is(7);
+  }
+
+  @Test
+  public void arbitraryImplementationsAreNotReadForHybrid() {
+    AtomicInteger counter = new AtomicInteger();
+    SeedableLazy external = new SeedableLazy() {
+      @Override public AtomicInteger counter() { return counter; }
+      @Override public int number() { throw new AssertionError(); }
+      @Override public String nullable() { throw new AssertionError(); }
+      @Override public Optional<String> optional() { throw new AssertionError(); }
+      @Override public java.util.List<String> list() { throw new AssertionError(); }
+      @Override public java.util.Map<String, Integer> map() { throw new AssertionError(); }
+    };
+
+    ImmutableSeedableLazy copy = ImmutableSeedableLazy.copyOf(external);
+    check(counter.get()).is(0);
+    check(copy.number()).is(1);
+  }
+
+  @Test
+  public void modifiableFallbacksStayUnseeded() {
+    AtomicInteger counter = new AtomicInteger();
+    ModifiableSeedableLazy value = ModifiableSeedableLazy.create().setCounter(counter);
+    check(value.number()).is(1);
+    check(value.number()).is(2);
+    value.setNumber(0);
+    check(value.number()).is(0);
+    value.unsetNumber();
+    check(value.number()).is(3);
+  }
+
+  @Test
+  public void javaSerializationResetsLazyState() throws Exception {
+    AtomicInteger counter = new AtomicInteger();
+    ImmutableSeedableLazy seeded = ImmutableSeedableLazy.builder()
+        .counter(counter)
+        .number(7)
+        .build();
+
+    ImmutableSeedableLazy restored = roundTrip(seeded);
+    check(restored.number()).is(1);
+  }
+
+  private static ImmutableSeedableLazy roundTrip(ImmutableSeedableLazy value) throws Exception {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    try (ObjectOutputStream output = new ObjectOutputStream(bytes)) {
+      output.writeObject(value);
+    }
+    try (ObjectInputStream input = new ObjectInputStream(new ByteArrayInputStream(bytes.toByteArray()))) {
+      return (ImmutableSeedableLazy) input.readObject();
+    }
+  }
+}
