new file mode 100644
index 0000000..2c5d09c
--- /dev/null
+++ b/value-fixture/src/org/immutables/fixture/SeedableLazyAttributes.java
@@ -0,0 +1,94 @@
+package org.immutables.fixture;
+
+import java.io.IOException;
+import java.io.Serializable;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.concurrent.atomic.AtomicInteger;
+import javax.annotation.Nullable;
+import org.immutables.serial.Serial;
+import org.immutables.value.Value;
+
+@Value.Immutable
+@Value.Style(toBuilder = "toBuilder")
+@Value.Modifiable
+public abstract class SeedableLazyAttributes implements Serializable {
+  private static final long serialVersionUID = 1L;
+
+  public abstract AtomicInteger counter();
+
+  public abstract int regular();
+
+  @Value.Lazy
+  @Value.Default
+  public int number() throws IOException {
+    return counter().incrementAndGet();
+  }
+
+  @Nullable
+  @Value.Lazy
+  @Value.Default
+  public String nullable() {
+    counter().incrementAndGet();
+    return "fallback";
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public Optional<String> optional() {
+    counter().incrementAndGet();
+    return Optional.of("fallback");
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public int[] array() {
+    counter().incrementAndGet();
+    return new int[] {1};
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public List<String> list() {
+    counter().incrementAndGet();
+    return Arrays.asList("fallback");
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public Map<String, String> map() {
+    counter().incrementAndGet();
+    return Collections.singletonMap("fallback", "fallback");
+  }
+}
+
+
+@Value.Immutable
+@Serial.Structural
+abstract class StructuralSeedableLazy implements Serializable {
+  private static final long serialVersionUID = 1L;
+
+  abstract AtomicInteger counter();
+
+  @Value.Lazy
+  @Value.Default
+  int number() {
+    return counter().incrementAndGet();
+  }
+}
+
+@Value.Immutable
+@Value.Modifiable
+@Value.Style(from = "")
+abstract class SeedableLazyWithoutFrom {
+  abstract AtomicInteger counter();
+
+  @Value.Lazy
+  @Value.Default
+  int number() {
+    return counter().incrementAndGet();
+  }
+}
diff --git a/value-fixture/test/org/immutables/fixture/SeedableLazyAttributesTest.java b/value-fixture/test/org/immutables/fixture/SeedableLazyAttributesTest.java
new file mode 100644
index 0000000..11b2e58
--- /dev/null
+++ b/value-fixture/test/org/immutables/fixture/SeedableLazyAttributesTest.java
@@ -0,0 +1,176 @@
+package org.immutables.fixture;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.ObjectInputStream;
+import java.io.ObjectOutputStream;
+import java.util.Collections;
+import java.util.Optional;
+import java.util.concurrent.atomic.AtomicInteger;
+import org.junit.jupiter.api.Test;
+
+public class SeedableLazyAttributesTest {
+  @Test
+  public void builderSeedsFalsyAndEmptyValues() throws Exception {
+    AtomicInteger counter = new AtomicInteger();
+    ImmutableSeedableLazyAttributes value = ImmutableSeedableLazyAttributes.builder()
+        .counter(counter)
+        .regular(1)
+        .number(0)
+        .nullable(null)
+        .optional(Optional.empty())
+        .array()
+        .addAllList(Collections.emptyList())
+        .putAllMap(Collections.emptyMap())
+        .build();
+
+    assertEquals(0, value.number());
+    assertNull(value.nullable());
+    assertEquals(Optional.empty(), value.optional());
+    assertArrayEquals(new int[0], value.array());
+    assertTrue(value.list().isEmpty());
+    assertTrue(value.map().isEmpty());
+    assertEquals(0, counter.get());
+  }
+
+  @Test
+  public void copiesPreserveOnlyExplicitSeeds() throws Exception {
+    AtomicInteger counter = new AtomicInteger();
+    ImmutableSeedableLazyAttributes unseeded = ImmutableSeedableLazyAttributes.builder()
+        .counter(counter)
+        .regular(1)
+        .build();
+
+    assertEquals(1, unseeded.number());
+    ImmutableSeedableLazyAttributes coldCopy = unseeded.withRegular(2);
+    assertEquals(2, coldCopy.number());
+
+    ImmutableSeedableLazyAttributes seeded = unseeded.withNumber(1);
+    assertEquals(1, seeded.number());
+    assertEquals(1, seeded.withRegular(3).number());
+    assertEquals(1, seeded.toBuilder().regular(4).build().number());
+    assertEquals(1, ImmutableSeedableLazyAttributes.builder().from(seeded).build().number());
+    assertEquals(2, counter.get());
+  }
+
+  @Test
+  public void unseededSourcesDoNotClearOrHeatDestinations() throws Exception {
+    AtomicInteger counter = new AtomicInteger();
+    ImmutableSeedableLazyAttributes unseeded = ImmutableSeedableLazyAttributes.builder()
+        .counter(counter)
+        .regular(1)
+        .build();
+
+    ImmutableSeedableLazyAttributes preserved = ImmutableSeedableLazyAttributes.builder()
+        .counter(counter)
+        .regular(2)
+        .number(7)
+        .from(unseeded)
+        .build();
+    assertEquals(7, preserved.number());
+    assertEquals(0, counter.get());
+
+    SeedableLazyAttributes external = new SeedableLazyAttributes() {
+      @Override public AtomicInteger counter() { return counter; }
+      @Override public int regular() { return 5; }
+    };
+    ImmutableSeedableLazyAttributes copied = ImmutableSeedableLazyAttributes.copyOf(external);
+    assertEquals(0, counter.get());
+    assertEquals(1, copied.number());
+  }
+
+  @Test
+  public void modifiableFallbackIsFreshAndSeedsRoundTrip() throws Exception {
+    AtomicInteger counter = new AtomicInteger();
+    ModifiableSeedableLazyAttributes modifiable = ModifiableSeedableLazyAttributes.create()
+        .setCounter(counter)
+        .setRegular(1);
+
+    assertFalse(modifiable.numberIsSet());
+    assertEquals(1, modifiable.number());
+    assertEquals(2, modifiable.number());
+    assertFalse(modifiable.numberIsSet());
+
+    modifiable.setNumber(0);
+    assertTrue(modifiable.numberIsSet());
+    assertEquals(0, modifiable.toImmutable().number());
+    modifiable.unsetNumber();
+    assertFalse(modifiable.numberIsSet());
+    ImmutableSeedableLazyAttributes cold = modifiable.toImmutable();
+    assertEquals(3, cold.number());
+  }
+
+  @Test
+  public void copyOfWithoutBuilderFromPreservesGeneratedSeedsOnly() {
+    AtomicInteger counter = new AtomicInteger();
+    ModifiableSeedableLazyWithoutFrom modifiable = ModifiableSeedableLazyWithoutFrom.create()
+        .setCounter(counter)
+        .setNumber(0);
+
+    assertEquals(0, ImmutableSeedableLazyWithoutFrom.copyOf(modifiable).number());
+    assertEquals(0, counter.get());
+
+    SeedableLazyWithoutFrom external = new SeedableLazyWithoutFrom() {
+      @Override AtomicInteger counter() { return counter; }
+    };
+    ImmutableSeedableLazyWithoutFrom copied = ImmutableSeedableLazyWithoutFrom.copyOf(external);
+    assertEquals(0, counter.get());
+    assertEquals(1, copied.number());
+  }
+
+  @Test
+  public void structuralSerializationOmitsSeed() throws Exception {
+    AtomicInteger counter = new AtomicInteger();
+    ImmutableStructuralSeedableLazy value = ImmutableStructuralSeedableLazy.builder()
+        .counter(counter)
+        .number(0)
+        .build();
+
+    ImmutableStructuralSeedableLazy restored = roundTripStructural(value);
+    assertEquals(1, restored.number());
+  }
+
+  @Test
+  public void javaSerializationResetsSeedAndComputedState() throws Exception {
+    AtomicInteger counter = new AtomicInteger();
+    ImmutableSeedableLazyAttributes value = ImmutableSeedableLazyAttributes.builder()
+        .counter(counter)
+        .regular(1)
+        .number(0)
+        .build();
+
+    ImmutableSeedableLazyAttributes restored = roundTrip(value);
+    assertEquals(1, restored.number());
+    assertEquals(0, counter.get());
+  }
+
+  private static ImmutableStructuralSeedableLazy roundTripStructural(
+      ImmutableStructuralSeedableLazy value) throws Exception {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    try (ObjectOutputStream output = new ObjectOutputStream(bytes)) {
+      output.writeObject(value);
+    }
+    try (ObjectInputStream input = new ObjectInputStream(
+        new ByteArrayInputStream(bytes.toByteArray()))) {
+      return (ImmutableStructuralSeedableLazy) input.readObject();
+    }
+  }
+
+  private static ImmutableSeedableLazyAttributes roundTrip(
+      ImmutableSeedableLazyAttributes value) throws Exception {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    try (ObjectOutputStream output = new ObjectOutputStream(bytes)) {
+      output.writeObject(value);
+    }
+    try (ObjectInputStream input = new ObjectInputStream(
+        new ByteArrayInputStream(bytes.toByteArray()))) {
+      return (ImmutableSeedableLazyAttributes) input.readObject();
+    }
+  }
+}
