diff --git a/value-fixture/test/org/immutables/fixture/SeedableLazyTest.java b/value-fixture/test/org/immutables/fixture/SeedableLazyTest.java
new file mode 100644
index 0000000..6d84c6a
--- /dev/null
+++ b/value-fixture/test/org/immutables/fixture/SeedableLazyTest.java
@@ -0,0 +1,172 @@
+package org.immutables.fixture;
+
+import static org.immutables.check.Checkers.check;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.ObjectInputStream;
+import java.io.ObjectOutputStream;
+import java.util.Collections;
+import java.util.Optional;
+import java.util.concurrent.atomic.AtomicInteger;
+import org.junit.jupiter.api.Test;
+
+class SeedableLazyTest {
+  @Test void fallbackStaysColdAcrossCopies() {
+    AtomicInteger counter = new AtomicInteger();
+    ImmutableSeedableLazy value = value(counter);
+
+    ImmutableSeedableLazy copy = value.withLabel("copy");
+    check(counter.get()).is(0);
+    check(copy.number()).is(1);
+
+    ImmutableSeedableLazy computed = value(counter);
+    check(computed.number()).is(2);
+    ImmutableSeedableLazy computedCopy = computed.withLabel("computed-copy");
+    check(counter.get()).is(2);
+    check(computedCopy.number()).is(3);
+  }
+
+  @Test void checkedFallbackSignatureIsPreserved() throws Exception {
+    AtomicInteger counter = new AtomicInteger();
+    ImmutableSeedableLazy value = value(counter);
+    check(value.checked()).is(1);
+    check(value.checked()).is(1);
+  }
+
+  @Test void explicitSeedsIncludeDefaultLikeValues() {
+    AtomicInteger counter = new AtomicInteger();
+    ImmutableSeedableLazy seeded = ImmutableSeedableLazy.builder()
+        .counter(counter)
+        .label("seeded")
+        .number(0)
+        .nullable(null)
+        .optional(Optional.empty())
+        .addAllItems(Collections.emptyList())
+        .putAllEntries(Collections.emptyMap())
+        .numbers(new int[0])
+        .build();
+
+    check(seeded.number()).is(0);
+    check(seeded.nullable()).isNull();
+    check(seeded.optional()).is(Optional.empty());
+    check(seeded.items()).isEmpty();
+    check(seeded.entries().size()).is(0);
+    check(seeded.numbers().length).is(0);
+    check(counter.get()).is(0);
+
+    ImmutableSeedableLazy copy = seeded.withLabel("copy");
+    check(copy.number()).is(0);
+    check(copy.optional()).is(Optional.empty());
+    check(copy.items()).isEmpty();
+    check(counter.get()).is(0);
+  }
+
+  @Test void equalWithValueStillEstablishesSeed() {
+    AtomicInteger counter = new AtomicInteger();
+    ImmutableSeedableLazy value = value(counter);
+    int fallback = value.number();
+
+    ImmutableSeedableLazy seeded = value.withNumber(fallback);
+    ImmutableSeedableLazy copy = seeded.withLabel("copy");
+    check(copy.number()).is(fallback);
+    check(counter.get()).is(1);
+  }
+
+  @Test void generatedCopyPathsPreserveOnlyExplicitSeeds() {
+    AtomicInteger counter = new AtomicInteger();
+    ImmutableSeedableLazy unseeded = value(counter);
+    ImmutableSeedableLazy seeded = unseeded.withNumber(0);
+
+    ImmutableSeedableLazy copied = ImmutableSeedableLazy.builder()
+        .number(7)
+        .from(unseeded)
+        .build();
+    check(copied.number()).is(7);
+
+    ImmutableSeedableLazy roundTrip = seeded.toBuilder().build();
+    check(roundTrip.number()).is(0);
+    check(counter.get()).is(0);
+  }
+
+  @Test void arbitraryImplementationsDoNotReadHybridAccessors() {
+    AtomicInteger reads = new AtomicInteger();
+    AtomicInteger counter = new AtomicInteger();
+    SeedableLazy external = new SeedableLazy() {
+      @Override public AtomicInteger counter() { return counter; }
+      @Override public String label() { return "external"; }
+      @Override public int number() { reads.incrementAndGet(); return 9; }
+      @Override public Optional<String> optional() { reads.incrementAndGet(); return Optional.of("x"); }
+      @Override public java.util.List<String> items() { reads.incrementAndGet(); return Collections.emptyList(); }
+      @Override public int[] numbers() { reads.incrementAndGet(); return new int[0]; }
+      @Override public String nullable() { reads.incrementAndGet(); return "x"; }
+    };
+
+    ImmutableSeedableLazy copied = ImmutableSeedableLazy.copyOf(external);
+    check(reads.get()).is(0);
+    check(copied.number()).is(1);
+    check(reads.get()).is(0);
+  }
+
+  @Test void copyOfWithoutBuilderFromDoesNotReadExternalHybrid() {
+    AtomicInteger reads = new AtomicInteger();
+    SeedableLazyNoFrom external = new SeedableLazyNoFrom() {
+      @Override public AtomicInteger counter() { return new AtomicInteger(); }
+      @Override public int value() { reads.incrementAndGet(); return 10; }
+    };
+
+    ImmutableSeedableLazyNoFrom copied = ImmutableSeedableLazyNoFrom.copyOf(external);
+    check(reads.get()).is(0);
+    check(copied.value()).is(1);
+  }
+
+  @Test void modifiableFallbacksStayUnsetAndFresh() {
+    AtomicInteger counter = new AtomicInteger();
+    ModifiableSeedableLazy modifiable = ModifiableSeedableLazy.create();
+    modifiable.setCounter(counter);
+    modifiable.setLabel("modifiable");
+
+    check(modifiable.number()).is(1);
+    check(modifiable.number()).is(2);
+    check(!modifiable.numberIsSet());
+
+    modifiable.setNumber(0);
+    check(modifiable.numberIsSet());
+    check(modifiable.number()).is(0);
+    modifiable.unsetNumber();
+    check(!modifiable.numberIsSet());
+    check(modifiable.number()).is(3);
+
+    modifiable.addAllItems(Collections.emptyList());
+    check(modifiable.itemsIsSet());
+    modifiable.putAllEntries(Collections.emptyMap());
+    check(modifiable.entriesIsSet());
+    modifiable.setOptional(Optional.empty());
+    ImmutableSeedableLazy immutable = modifiable.toImmutable();
+    check(immutable.optional()).is(Optional.empty());
+    check(counter.get()).is(3);
+  }
+
+  @Test void javaSerializationResetsSeedAndComputedState() throws Exception {
+    AtomicInteger counter = new AtomicInteger();
+    ImmutableSeedableLazy seeded = value(counter).withNumber(0);
+    ImmutableSeedableLazy restored = roundTrip(seeded);
+
+    check(restored.number()).is(1);
+    check(restored.number()).is(1);
+  }
+
+  private static ImmutableSeedableLazy value(AtomicInteger counter) {
+    return ImmutableSeedableLazy.builder().counter(counter).label("value").build();
+  }
+
+  private static ImmutableSeedableLazy roundTrip(ImmutableSeedableLazy value) throws Exception {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    try (ObjectOutputStream output = new ObjectOutputStream(bytes)) {
+      output.writeObject(value);
+    }
+    try (ObjectInputStream input = new ObjectInputStream(new ByteArrayInputStream(bytes.toByteArray()))) {
+      return (ImmutableSeedableLazy) input.readObject();
+    }
+  }
+}
