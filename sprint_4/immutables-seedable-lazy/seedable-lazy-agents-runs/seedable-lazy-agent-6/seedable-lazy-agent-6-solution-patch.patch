new file mode 100644
index 0000000..2d2eaf7
--- /dev/null
+++ b/value-fixture/src/org/immutables/fixture/SeedableLazy.java
@@ -0,0 +1,68 @@
+package org.immutables.fixture;
+
+import java.io.IOException;
+import java.io.Serializable;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.concurrent.atomic.AtomicInteger;
+import javax.annotation.Nullable;
+import org.immutables.value.Value;
+
+@Value.Immutable
+@Value.Modifiable
+@Value.Style(toBuilder = "toBuilder")
+public abstract class SeedableLazy implements Serializable {
+  private static final long serialVersionUID = 1L;
+  public abstract AtomicInteger counter();
+
+  public abstract String label();
+
+  @Value.Lazy
+  @Value.Default
+  public int number() {
+    return counter().incrementAndGet();
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public int checked() throws IOException {
+    return counter().incrementAndGet();
+  }
+
+  @Value.Lazy
+  @Value.Default
+  @Nullable
+  public String nullable() {
+    counter().incrementAndGet();
+    return null;
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public Optional<String> optional() {
+    counter().incrementAndGet();
+    return Optional.empty();
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public List<String> items() {
+    counter().incrementAndGet();
+    return java.util.Collections.singletonList(label());
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public Map<String, String> entries() {
+    counter().incrementAndGet();
+    return java.util.Collections.singletonMap(label(), label());
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public int[] numbers() {
+    counter().incrementAndGet();
+    return new int[] {1};
+  }
+}
