diff --git a/value-fixture/src/org/immutables/fixture/SeedableLazy.java b/value-fixture/src/org/immutables/fixture/SeedableLazy.java
new file mode 100644
index 0000000..9f0c8c8
--- /dev/null
+++ b/value-fixture/src/org/immutables/fixture/SeedableLazy.java
@@ -0,0 +1,44 @@
+package org.immutables.fixture;
+
+import java.io.IOException;
+import java.io.Serializable;
+import java.util.List;
+import java.util.Optional;
+import java.util.concurrent.atomic.AtomicInteger;
+import org.immutables.value.Value;
+
+@Value.Immutable
+@Value.Modifiable
+@Value.Style(toBuilder = "toBuilder")
+public abstract class SeedableLazy implements Serializable {
+  private static final long serialVersionUID = 1L;
+
+  public abstract AtomicInteger counter();
+
+  @Value.Lazy
+  @Value.Default
+  public int number() {
+    return counter().getAndIncrement();
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public Optional<String> optional() {
+    counter().incrementAndGet();
+    return Optional.empty();
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public List<String> values() {
+    counter().incrementAndGet();
+    return java.util.Collections.emptyList();
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public String checked() throws IOException {
+    counter().incrementAndGet();
+    return "fallback";
+  }
+}
diff --git a/value-fixture/test/org/immutables/fixture/SeedableLazyTest.java b/value-fixture/test/org/immutables/fixture/SeedableLazyTest.java
new file mode 100644
index 0000000..855a37c
--- /dev/null
+++ b/value-fixture/test/org/immutables/fixture/SeedableLazyTest.java
@@ -0,0 +1,157 @@
+package org.immutables.fixture;
+
+import static org.immutables.check.Checkers.check;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.ObjectInputStream;
+import java.io.ObjectOutputStream;
+import java.util.Collections;
+import java.util.Optional;
+import java.util.concurrent.atomic.AtomicInteger;
+import org.junit.Test;
+
+public class SeedableLazyTest {
+  @Test
+  public void builderSeedsAndLeavesFallbacksCold() {
+    AtomicInteger counter = new AtomicInteger();
+    ImmutableSeedableLazy value = ImmutableSeedableLazy.builder()
+        .counter(counter)
+        .number(0)
+        .optional(Optional.empty())
+        .values(Collections.<String>emptyList())
+        .checked("seed")
+        .build();
+
+    check(value.number()).is(0);
+    check(value.optional()).is(Optional.empty());
+    check(value.values()).isEmpty();
+    try {
+      check(value.checked()).is("seed");
+    } catch (Exception ex) {
+      throw new AssertionError(ex);
+    }
+    check(counter.get()).is(0);
+  }
+
+  @Test
+  public void copyPreservesSeedProvenance() {
+    AtomicInteger counter = new AtomicInteger();
+    ImmutableSeedableLazy unseeded = ImmutableSeedableLazy.builder().counter(counter).build();
+    ImmutableSeedableLazy copy = unseeded.withCounter(new AtomicInteger());
+
+    check(counter.get()).is(0);
+    check(copy.number()).is(0);
+
+    ImmutableSeedableLazy seeded = unseeded.withNumber(1).withCounter(new AtomicInteger());
+    check(seeded.number()).is(1);
+  }
+
+  @Test
+  public void equalFallbackWitherStillSeeds() {
+    ImmutableSeedableLazy value = ImmutableSeedableLazy.builder()
+        .counter(new AtomicInteger())
+        .build();
+
+    check(value.number()).is(0);
+    ImmutableSeedableLazy seeded = value.withNumber(0);
+    check(seeded != value);
+    check(seeded.withCounter(new AtomicInteger()).number()).is(0);
+
+    ImmutableSeedableLazy optionalFallback = ImmutableSeedableLazy.builder()
+        .counter(new AtomicInteger())
+        .build();
+    check(optionalFallback.optional()).is(Optional.empty());
+    ImmutableSeedableLazy optionalSeeded = optionalFallback.withOptional(Optional.empty());
+    check(optionalSeeded != optionalFallback);
+
+    ImmutableSeedableLazy collectionFallback = ImmutableSeedableLazy.builder()
+        .counter(new AtomicInteger())
+        .build();
+    check(collectionFallback.values()).isEmpty();
+    ImmutableSeedableLazy collectionSeeded = collectionFallback.withValues(Collections.<String>emptyList());
+    check(collectionSeeded != collectionFallback);
+  }
+
+  @Test
+  public void generatedFromPreservesOnlyExplicitSeeds() {
+    AtomicInteger counter = new AtomicInteger();
+    ImmutableSeedableLazy unseeded = ImmutableSeedableLazy.builder().counter(counter).build();
+    ImmutableSeedableLazy rebuilt = ImmutableSeedableLazy.builder().from(unseeded).build();
+
+    check(counter.get()).is(0);
+    check(rebuilt.number()).is(0);
+
+    ImmutableSeedableLazy seeded = unseeded.withNumber(0);
+    check(ImmutableSeedableLazy.builder().from(seeded).build().number()).is(0);
+  }
+
+  @Test
+  public void toBuilderAndExternalFromDoNotForceFallback() {
+    AtomicInteger counter = new AtomicInteger();
+    ImmutableSeedableLazy value = ImmutableSeedableLazy.builder().counter(counter).build();
+
+    ImmutableSeedableLazy rebuilt = value.toBuilder().build();
+    check(counter.get()).is(0);
+    check(rebuilt.number()).is(0);
+
+    AtomicInteger externalCounter = new AtomicInteger();
+    SeedableLazy external = new SeedableLazy() {
+      @Override public AtomicInteger counter() {
+        return externalCounter;
+      }
+    };
+    ImmutableSeedableLazy.builder().from(external).counter(new AtomicInteger()).build();
+    check(externalCounter.get()).is(0);
+  }
+
+  @Test
+  public void modifiableFallbackRemainsUnset() {
+    AtomicInteger counter = new AtomicInteger();
+    ModifiableSeedableLazy value = ModifiableSeedableLazy.create().setCounter(counter);
+
+    check(value.number()).is(0);
+    check(value.number()).is(1);
+    check(!value.numberIsSet());
+
+    value.setNumber(0);
+    check(value.number()).is(0);
+    value.unsetNumber();
+    check(value.number()).is(2);
+  }
+
+  @Test
+  public void modifiableFromPreservesSeedsOnly() {
+    ImmutableSeedableLazy unseeded = ImmutableSeedableLazy.builder()
+        .counter(new AtomicInteger())
+        .build();
+    ModifiableSeedableLazy destination = ModifiableSeedableLazy.create()
+        .setCounter(new AtomicInteger())
+        .setNumber(5)
+        .from(unseeded);
+
+    check(destination.number()).is(5);
+    destination.from(unseeded.withNumber(0));
+    check(destination.number()).is(0);
+  }
+
+  @Test
+  public void javaSerializationResetsLazyAndSeedState() throws Exception {
+    AtomicInteger counter = new AtomicInteger();
+    ImmutableSeedableLazy seeded = ImmutableSeedableLazy.builder()
+        .counter(counter)
+        .number(7)
+        .build();
+
+    ImmutableSeedableLazy restored = roundTrip(seeded);
+    check(counter.get()).is(0);
+    check(restored.number()).is(0);
+  }
+
+  private static ImmutableSeedableLazy roundTrip(ImmutableSeedableLazy value) throws Exception {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    new ObjectOutputStream(bytes).writeObject(value);
+    return (ImmutableSeedableLazy) new ObjectInputStream(
+        new ByteArrayInputStream(bytes.toByteArray())).readObject();
+  }
+}
