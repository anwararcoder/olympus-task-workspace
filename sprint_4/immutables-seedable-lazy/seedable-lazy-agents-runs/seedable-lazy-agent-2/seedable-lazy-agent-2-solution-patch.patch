diff --git a/value-fixture/test/org/immutables/fixture/SeedableLazyTest.java b/value-fixture/test/org/immutables/fixture/SeedableLazyTest.java
new file mode 100644
index 0000000..da2e369
--- /dev/null
+++ b/value-fixture/test/org/immutables/fixture/SeedableLazyTest.java
@@ -0,0 +1,109 @@
+package org.immutables.fixture;
+
+import static org.immutables.check.Checkers.check;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.ObjectInputStream;
+import java.io.ObjectOutputStream;
+import java.util.Collections;
+import java.util.concurrent.atomic.AtomicInteger;
+import org.junit.jupiter.api.Test;
+
+public class SeedableLazyTest {
+  @Test void builderSeedsFalsyValuesWithoutInitializingFallbacks() throws Exception {
+    AtomicInteger counter = new AtomicInteger();
+    ImmutableSeedableLazy value = ImmutableSeedableLazy.builder()
+        .counter(counter)
+        .number(0)
+        .nullable(null)
+        .strings(Collections.emptyList())
+        .build();
+
+    check(value.number()).is(0);
+    check(value.nullable()).isNull();
+    check(value.strings()).isEmpty();
+    check(counter.get()).is(0);
+  }
+
+  @Test void copiesPreserveSeedsAndKeepFallbacksCold() throws Exception {
+    AtomicInteger counter = new AtomicInteger();
+    ImmutableSeedableLazy unseeded = ImmutableSeedableLazy.builder().counter(counter).build();
+    check(unseeded.number()).is(1);
+
+    AtomicInteger copiedCounter = new AtomicInteger(10);
+    ImmutableSeedableLazy coldCopy = unseeded.withCounter(copiedCounter);
+    check(counter.get()).is(1);
+    check(coldCopy.number()).is(11);
+
+    ImmutableSeedableLazy seeded = unseeded.withNumber(1);
+    check(seeded.number()).is(1);
+    check(counter.get()).is(1);
+    check(seeded.withCounter(new AtomicInteger()).number()).is(1);
+    check(seeded.toBuilder().build().number()).is(1);
+    check(ImmutableSeedableLazy.builder().from(seeded).build().number()).is(1);
+
+    ImmutableSeedableLazy destinationSeed = ImmutableSeedableLazy.builder()
+        .counter(counter)
+        .number(7)
+        .from(ImmutableSeedableLazy.builder().counter(counter).build())
+        .build();
+    check(destinationSeed.number()).is(7);
+
+    java.util.List<String> fallback = unseeded.strings();
+    ImmutableSeedableLazy collectionSeed = unseeded.withStrings(fallback);
+    int computations = counter.get();
+    check(collectionSeed.withCounter(new AtomicInteger()).strings()).is(fallback);
+    check(counter.get()).is(computations);
+  }
+
+  @Test void externalImplementationsAreNotReadForHybrids() throws Exception {
+    AtomicInteger counter = new AtomicInteger();
+    SeedableLazy external = new SeedableLazy() {
+      @Override public AtomicInteger counter() { return counter; }
+      @Override public int number() { throw new AssertionError(); }
+      @Override public String nullable() { throw new AssertionError(); }
+      @Override public java.util.List<String> strings() { throw new AssertionError(); }
+    };
+
+    ImmutableSeedableLazy copy = ImmutableSeedableLazy.builder().from(external).build();
+    check(copy.number()).is(1);
+  }
+
+  @Test void modifiableFallbacksStayUnsetAndSeedsRoundTrip() throws Exception {
+    AtomicInteger counter = new AtomicInteger();
+    ModifiableSeedableLazy modifiable = ModifiableSeedableLazy.create().setCounter(counter);
+    check(modifiable.number()).is(1);
+    check(modifiable.number()).is(2);
+    check(!modifiable.numberIsSet());
+
+    modifiable.setNumber(0);
+    check(modifiable.toImmutable().number()).is(0);
+    check(ModifiableSeedableLazy.create().setCounter(counter).from(modifiable).number()).is(0);
+    check(ModifiableSeedableLazy.create().setCounter(counter).from(modifiable.toImmutable()).number()).is(0);
+    modifiable.unsetNumber();
+    check(modifiable.toImmutable().number()).is(3);
+    modifiable.setNumber(0).clear().setCounter(counter);
+    check(modifiable.number()).is(4);
+  }
+
+  @Test void javaSerializationResetsLazyAndSeedState() throws Exception {
+    ImmutableSeedableLazy seeded = ImmutableSeedableLazy.builder()
+        .counter(new AtomicInteger())
+        .number(0)
+        .build();
+    ImmutableSeedableLazy restored = roundTrip(seeded);
+    check(restored.number()).is(1);
+  }
+
+  private static ImmutableSeedableLazy roundTrip(ImmutableSeedableLazy value) throws Exception {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    try (ObjectOutputStream output = new ObjectOutputStream(bytes)) {
+      output.writeObject(value);
+    }
+    try (ObjectInputStream input = new ObjectInputStream(
+        new ByteArrayInputStream(bytes.toByteArray()))) {
+      return (ImmutableSeedableLazy) input.readObject();
+    }
+  }
+}
