new file mode 100644
index 0000000..75c03a2
--- /dev/null
+++ b/value-fixture/src/org/immutables/fixture/SeedableLazy.java
@@ -0,0 +1,38 @@
+package org.immutables.fixture;
+
+import java.io.IOException;
+import java.io.Serializable;
+import java.util.List;
+import java.util.concurrent.atomic.AtomicInteger;
+import javax.annotation.Nullable;
+import org.immutables.value.Value;
+
+@Value.Immutable
+@Value.Modifiable
+@Value.Style(toBuilder = "toBuilder")
+public abstract class SeedableLazy implements Serializable {
+  private static final long serialVersionUID = 1L;
+
+  public abstract AtomicInteger counter();
+
+  @Value.Lazy
+  @Value.Default
+  public int number() throws IOException {
+    return counter().incrementAndGet();
+  }
+
+  @Nullable
+  @Value.Lazy
+  @Value.Default
+  public String nullable() {
+    counter().incrementAndGet();
+    return "fallback";
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public List<String> strings() {
+    counter().incrementAndGet();
+    return java.util.Collections.singletonList("fallback");
+  }
+}
