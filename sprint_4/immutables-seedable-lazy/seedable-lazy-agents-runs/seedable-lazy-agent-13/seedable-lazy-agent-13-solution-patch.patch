+package org.immutables.fixture;
+
+import java.io.IOException;
+import java.io.Serializable;
+import java.util.Collections;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.concurrent.atomic.AtomicInteger;
+import javax.annotation.Nullable;
+import org.immutables.gson.Gson;
+import org.immutables.value.Value;
+
+@Gson.TypeAdapters
+@Value.Immutable
+@Value.Modifiable
+@Value.Style(toBuilder = "toBuilder")
+public abstract class SeedableLazy implements Serializable {
+  private static final long serialVersionUID = 1L;
+
+  public abstract AtomicInteger calls();
+
+  @Value.Default
+  public int regular() {
+    return 0;
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public boolean flag() {
+    called();
+    return false;
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public int number() {
+    called();
+    return 0;
+  }
+
+  @Nullable
+  @Value.Lazy
+  @Value.Default
+  public String nullable() {
+    called();
+    return null;
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public Optional<String> optional() {
+    called();
+    return Optional.of("fallback");
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public int[] array() {
+    called();
+    return new int[] {1};
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public List<String> list() {
+    called();
+    return Collections.singletonList("fallback");
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public Map<String, Integer> map() {
+    called();
+    return Collections.singletonMap("fallback", 1);
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public String checked() throws IOException {
+    called();
+    return "fallback";
+  }
+
+  private void called() {
+    calls().incrementAndGet();
+  }
+}
+
+@Value.Immutable
+@Value.Style(from = "")
+abstract class SeedableLazyNoFrom {
+  abstract AtomicInteger calls();
+
+  @Value.Lazy
+  @Value.Default
+  int number() {
+    calls().incrementAndGet();
+    return 0;
+  }
+}
+
+interface SeedableLazyCalls {
+  AtomicInteger calls();
+}
+
+interface SeedableLazyRegular {
+  int regular();
+}
+
+@Value.Immutable
+@Value.Style(mergeFromSupertypesDynamically = false)
+abstract class SeedableLazyStaticFrom implements SeedableLazyCalls, SeedableLazyRegular {
+  @Value.Lazy
+  @Value.Default
+  int number() {
+    calls().incrementAndGet();
+    return 0;
+  }
+}
diff --git a/value-fixture/test/org/immutables/fixture/SeedableLazyTest.java b/value-fixture/test/org/immutables/fixture/SeedableLazyTest.java
new file mode 100644
index 0000000..7f20eef
--- /dev/null
+++ b/value-fixture/test/org/immutables/fixture/SeedableLazyTest.java
@@ -0,0 +1,260 @@
+package org.immutables.fixture;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.ObjectInputStream;
+import java.io.ObjectOutputStream;
+import java.io.Serializable;
+import java.util.Collections;
+import java.util.Optional;
+import java.util.concurrent.atomic.AtomicInteger;
+import org.immutables.fixture.marshal.Marshaling;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+public class SeedableLazyTest {
+  @Test
+  public void builderAcceptsFalsyAndEmptySeedsWithoutWarmingFallbacks() throws Exception {
+    AtomicInteger calls = new AtomicInteger();
+    ImmutableSeedableLazy value = ImmutableSeedableLazy.builder()
+        .calls(calls)
+        .flag(false)
+        .number(0)
+        .nullable(null)
+        .optional(Optional.empty())
+        .array(new int[0])
+        .addAllList(Collections.emptyList())
+        .putAllMap(Collections.emptyMap())
+        .checked("seed")
+        .build();
+
+    assertFalse(value.flag());
+    assertEquals(0, value.number());
+    assertNull(value.nullable());
+    assertEquals(Optional.empty(), value.optional());
+    assertArrayEquals(new int[0], value.array());
+    assertEquals(Collections.emptyList(), value.list());
+    assertEquals(Collections.emptyMap(), value.map());
+    assertEquals("seed", value.checked());
+    assertEquals(0, calls.get());
+  }
+
+  @Test
+  public void withersAndCopiesPreserveOnlyExplicitSeeds() {
+    AtomicInteger calls = new AtomicInteger();
+    ImmutableSeedableLazy unseeded = ImmutableSeedableLazy.builder().calls(calls).build();
+
+    assertEquals(0, unseeded.number());
+    assertEquals(1, calls.get());
+
+    ImmutableSeedableLazy seededWithFallback = unseeded.withNumber(0);
+    assertEquals(0, seededWithFallback.number());
+    assertEquals(1, calls.get());
+
+    ImmutableSeedableLazy seededCopy = seededWithFallback.withRegular(1);
+    assertEquals(0, seededCopy.number());
+    assertEquals(1, calls.get());
+
+    ImmutableSeedableLazy coldCopy = unseeded.withRegular(2);
+    assertEquals(1, calls.get());
+    assertEquals(0, coldCopy.number());
+    assertEquals(2, calls.get());
+
+    ImmutableSeedableLazy coldBuilderCopy = unseeded.toBuilder().regular(3).build();
+    assertEquals(2, calls.get());
+    assertEquals(0, coldBuilderCopy.number());
+    assertEquals(3, calls.get());
+
+    ImmutableSeedableLazy seededBuilderCopy = seededWithFallback.toBuilder().regular(4).build();
+    assertEquals(0, seededBuilderCopy.number());
+    assertEquals(3, calls.get());
+  }
+
+  @Test
+  public void generatedSourcesTransferSeedsButExternalSourcesDoNotReadLazyAccessors() {
+    AtomicInteger sourceCalls = new AtomicInteger();
+    ImmutableSeedableLazy seeded = ImmutableSeedableLazy.builder()
+        .calls(sourceCalls)
+        .number(0)
+        .build();
+
+    ImmutableSeedableLazy copiedSeed = ImmutableSeedableLazy.builder().from(seeded).build();
+    assertEquals(0, copiedSeed.number());
+    assertEquals(0, sourceCalls.get());
+
+    AtomicInteger staticFromCalls = new AtomicInteger();
+    ImmutableSeedableLazyStaticFrom staticFrom = ImmutableSeedableLazyStaticFrom.builder()
+        .calls(staticFromCalls)
+        .regular(1)
+        .number(0)
+        .build();
+    ImmutableSeedableLazyStaticFrom copiedStaticFrom = ImmutableSeedableLazyStaticFrom.builder()
+        .from(staticFrom)
+        .build();
+    assertEquals(0, copiedStaticFrom.number());
+    assertEquals(0, staticFromCalls.get());
+
+    ImmutableSeedableLazy unseeded = ImmutableSeedableLazy.builder().calls(sourceCalls).build();
+    ImmutableSeedableLazy destinationSeed = ImmutableSeedableLazy.builder()
+        .calls(new AtomicInteger())
+        .number(7)
+        .from(unseeded)
+        .build();
+    assertEquals(7, destinationSeed.number());
+    assertEquals(0, sourceCalls.get());
+
+    AtomicInteger externalCalls = new AtomicInteger();
+    SeedableLazy external = external(externalCalls);
+    ImmutableSeedableLazy copiedExternal = ImmutableSeedableLazy.copyOf(external);
+    assertEquals(0, externalCalls.get());
+    assertEquals(0, copiedExternal.number());
+    assertEquals(1, externalCalls.get());
+
+    AtomicInteger noFromCalls = new AtomicInteger();
+    SeedableLazyNoFrom noFromExternal = new SeedableLazyNoFrom() {
+      @Override
+      AtomicInteger calls() {
+        return noFromCalls;
+      }
+
+      @Override
+      int number() {
+        throw new AssertionError("external lazy accessor must not be read");
+      }
+    };
+    ImmutableSeedableLazyNoFrom noFromCopy = ImmutableSeedableLazyNoFrom.copyOf(noFromExternal);
+    assertEquals(0, noFromCalls.get());
+    assertEquals(0, noFromCopy.number());
+    assertEquals(1, noFromCalls.get());
+  }
+
+  @Test
+  public void modifiableUsesFreshFallbacksAndTransfersOnlySeeds() {
+    AtomicInteger calls = new AtomicInteger();
+    ModifiableSeedableLazy modifiable = ModifiableSeedableLazy.create().setCalls(calls);
+
+    assertEquals(0, modifiable.number());
+    assertEquals(0, modifiable.number());
+    assertEquals(2, calls.get());
+    assertFalse(modifiable.numberIsSet());
+
+    modifiable.setNumber(0);
+    assertTrue(modifiable.numberIsSet());
+    assertEquals(0, modifiable.number());
+    assertEquals(2, calls.get());
+
+    ImmutableSeedableLazy immutable = modifiable.toImmutable();
+    assertEquals(0, immutable.number());
+    assertEquals(2, calls.get());
+
+    ModifiableSeedableLazy immutableDestination = ModifiableSeedableLazy.create()
+        .setCalls(new AtomicInteger())
+        .from(immutable);
+    assertTrue(immutableDestination.numberIsSet());
+    assertEquals(0, immutableDestination.number());
+
+    ModifiableSeedableLazy externalDestination = ModifiableSeedableLazy.create()
+        .setCalls(new AtomicInteger())
+        .setNumber(11)
+        .from(external(new AtomicInteger()));
+    assertEquals(11, externalDestination.number());
+
+    modifiable.unsetNumber();
+    assertFalse(modifiable.numberIsSet());
+    assertEquals(0, modifiable.number());
+    assertEquals(3, calls.get());
+
+    ModifiableSeedableLazy destination = ModifiableSeedableLazy.create()
+        .setCalls(new AtomicInteger())
+        .setNumber(9)
+        .from(modifiable);
+    assertEquals(9, destination.number());
+
+    destination.clear().setCalls(calls);
+    assertFalse(destination.numberIsSet());
+
+    destination.addAllList(Collections.emptyList()).putAllMap(Collections.emptyMap());
+    assertTrue(destination.listIsSet());
+    assertTrue(destination.mapIsSet());
+    assertEquals(Collections.emptyList(), destination.list());
+    assertEquals(Collections.emptyMap(), destination.map());
+
+    destination.unsetList().unsetMap();
+    ImmutableSeedableLazy cold = destination.toImmutable();
+    assertEquals(3, calls.get());
+    assertEquals(Collections.singletonList("fallback"), cold.list());
+    assertEquals(4, calls.get());
+  }
+
+  @Test
+  public void serializationAndMarshalingResetOrOmitHybridState() throws Exception {
+    AtomicInteger calls = new AtomicInteger();
+    ImmutableSeedableLazy seeded = ImmutableSeedableLazy.builder()
+        .calls(calls)
+        .number(0)
+        .build();
+
+    ImmutableSeedableLazy deserialized = roundTrip(seeded);
+    assertEquals(0, deserialized.calls().get());
+    assertEquals(0, deserialized.number());
+    assertEquals(1, deserialized.calls().get());
+
+    AtomicInteger computedCalls = new AtomicInteger();
+    ImmutableSeedableLazy computed = ImmutableSeedableLazy.builder().calls(computedCalls).build();
+    assertEquals(0, computed.number());
+    assertEquals(1, computedCalls.get());
+    ImmutableSeedableLazy deserializedComputed = roundTrip(computed);
+    assertEquals(1, deserializedComputed.calls().get());
+    assertEquals(0, deserializedComputed.number());
+    assertEquals(2, deserializedComputed.calls().get());
+
+    String json = Marshaling.toJson(seeded);
+    assertFalse(json.contains("number"));
+    assertEquals(0, calls.get());
+
+    ImmutableSeedableLazy unmarshaled = Marshaling.fromJson(json, ImmutableSeedableLazy.class);
+    assertEquals(0, unmarshaled.number());
+    assertEquals(1, unmarshaled.calls().get());
+
+    ModifiableSeedableLazy modifiable = ModifiableSeedableLazy.create()
+        .setCalls(new AtomicInteger())
+        .setNumber(0);
+    ModifiableSeedableLazy deserializedModifiable = roundTrip(modifiable);
+    assertFalse(deserializedModifiable.numberIsSet());
+    assertEquals(0, deserializedModifiable.number());
+    assertEquals(1, deserializedModifiable.calls().get());
+    deserializedModifiable.addAllList(Collections.emptyList()).putAllMap(Collections.emptyMap());
+    assertTrue(deserializedModifiable.listIsSet());
+    assertTrue(deserializedModifiable.mapIsSet());
+  }
+
+  private static SeedableLazy external(AtomicInteger calls) {
+    return new SeedableLazy() {
+      @Override
+      public AtomicInteger calls() {
+        return calls;
+      }
+
+      @Override
+      public int number() {
+        throw new AssertionError("external lazy accessor must not be read");
+      }
+    };
+  }
+
+  @SuppressWarnings("unchecked")
+  private static <T extends Serializable> T roundTrip(T value) throws Exception {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    try (ObjectOutputStream output = new ObjectOutputStream(bytes)) {
+      output.writeObject(value);
+    }
+    try (ObjectInputStream input = new ObjectInputStream(
+        new ByteArrayInputStream(bytes.toByteArray()))) {
+      return (T) input.readObject();
+    }
+  }
+}
