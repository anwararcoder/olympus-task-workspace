@@ -0,0 +1,46 @@
+package org.immutables.value.processor.meta;
+
+import com.Capella.testing.compile.Compilation;
+import com.Capella.testing.compile.Compiler;
+import com.Capella.testing.compile.JavaFileObjects;
+import javax.tools.JavaFileObject;
+import org.immutables.value.processor.Processor;
+import org.junit.Test;
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertTrue;
+
+public class SeedableLazyDiagnosticsTest {
+  @Test
+  public void rejectsInternedImmutable() {
+    assertRejected("@Value.Immutable(intern = true)");
+  }
+
+  @Test
+  public void rejectsImmutableWithoutBuilder() {
+    assertRejected("@Value.Immutable(builder = false)");
+  }
+
+  @Test
+  public void rejectsImmutableWithoutWithMethods() {
+    assertRejected("@Value.Immutable(copy = false)");
+  }
+
+  private static void assertRejected(String immutableAnnotation) {
+    JavaFileObject source = JavaFileObjects.forSourceString("test.InvalidSeedableLazy", String.join("\n",
+        "package test;",
+        "import org.immutables.value.Value;",
+        immutableAnnotation,
+        "abstract class InvalidSeedableLazy {",
+        "  @Value.Lazy @Value.Default int value() { return 1; }",
+        "}"));
+
+    Compilation compilation = Compiler.javac()
+        .withProcessors(new Processor())
+        .compile(source);
+
+    assertEquals(Compilation.Status.FAILURE, compilation.status());
+    assertTrue(compilation.diagnostics().stream()
+        .anyMatch(diagnostic -> diagnostic.getMessage(null)
+            .contains("@Value.Lazy and @Value.Default")));
+  }
+}
