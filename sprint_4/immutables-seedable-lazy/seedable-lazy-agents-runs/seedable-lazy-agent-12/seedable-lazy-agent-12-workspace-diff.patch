+            -cp "$processor_jar" \
+            -processorpath "$processor_jar" \
+            -d "$NEGATIVE_CLASSES" \
+            "$source" > "$source_log" 2>&1; then
+            cat "$source_log" >> "$NEGATIVE_LOG"
+            echo "Expected annotation processing to reject $source" >> "$NEGATIVE_LOG"
+            return 1
+        fi
+        cat "$source_log" >> "$NEGATIVE_LOG"
+        case "$(basename "$source")" in
+            LazyAbstract.java|LazyFinal.java|LazyDerived.java)
+                EXPECTED_MARKERS=("@Value.Lazy")
+                ;;
+            *)
+                EXPECTED_MARKERS=("@Value.Lazy" "@Value.Default")
+                ;;
+        esac
+        for expected in "${EXPECTED_MARKERS[@]}"; do
+            if ! grep -F "$expected" "$source_log" >/dev/null; then
+                echo "Expected diagnostic marker: $expected" >> "$NEGATIVE_LOG"
+                return 1
+            fi
+        done
+    done
+}
+
+rm -rf "$STAGED_DIR" "$REPORTS"
+if [[ "$MODE" == "new" ]]; then
+    mkdir -p "$(dirname "$STAGED_DIR")"
+    cp -R "$SOURCE_DIR" "$STAGED_DIR"
+fi
+
+if ! run_mvn -pl value-fixture -am clean install -DskipTests -Dmaven.test.skip=true; then
+    write_xml 1
+    exit 1
+fi
+
+rm -rf "$REPORTS"
+
+RC=0
+case "$MODE" in
+    base)
+        run_mvn -pl value-fixture test -Dtest="!$FOCUS_TEST" || RC=$?
+        ;;
+    new)
+        run_mvn -pl value-fixture test -Dtest="$FOCUS_TEST" || RC=$?
+        if [[ "$RC" -eq 0 ]] && ! run_negative_checks; then
+            NEGATIVE_FAILURE=1
+            RC=1
+        fi
+        ;;
+esac
+
+write_xml "$RC"
+exit "$RC"
