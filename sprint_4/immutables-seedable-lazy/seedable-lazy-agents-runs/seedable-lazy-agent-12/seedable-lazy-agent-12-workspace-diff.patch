+    assertEquals(1, SeedableLazy.INITIALIZATIONS.get());
+
+    ImmutableSeedableLazy seededCopy = seeded.withRegular(2);
+    assertEquals(fallback, seededCopy.hybrid());
+    assertEquals(1, SeedableLazy.INITIALIZATIONS.get());
+
+    ImmutableSeedableLazy coldCopy = unseeded.withRegular(2);
+    assertEquals(1, SeedableLazy.INITIALIZATIONS.get());
+    assertEquals(2, coldCopy.hybrid());
+  }
+
+  @Test void toBuilderAndBuilderFromPreserveOnlyExplicitSeeds() throws Exception {
+    ImmutableSeedableLazy seeded = ImmutableSeedableLazy.builder()
+        .regular(1)
+        .hybrid(7)
+        .build();
+    ImmutableSeedableLazy seededCopy = seeded.toBuilder().regular(2).build();
+    assertEquals(7, seededCopy.hybrid());
+    assertEquals(0, SeedableLazy.INITIALIZATIONS.get());
+
+    ImmutableSeedableLazy computed = ImmutableSeedableLazy.builder().regular(1).build();
+    assertEquals(1, computed.hybrid());
+    ImmutableSeedableLazy coldCopy = computed.toBuilder().regular(2).build();
+    assertEquals(1, SeedableLazy.INITIALIZATIONS.get());
+    assertEquals(2, coldCopy.hybrid());
+
+    ImmutableSeedableLazy retained = ImmutableSeedableLazy.builder()
+        .regular(9)
+        .hybrid(11)
+        .from(ImmutableSeedableLazy.builder().regular(3).build())
+        .build();
+    assertEquals(11, retained.hybrid());
+  }
+
+  @Test void externalImplementationsAreNeverReadForHybrids() throws Exception {
+    SeedableLazy external = new ExternalSeedableLazy(3);
+
+    ImmutableSeedableLazy copied = ImmutableSeedableLazy.copyOf(external);
+    assertEquals(0, SeedableLazy.INITIALIZATIONS.get());
+    assertEquals(1, copied.hybrid());
+
+    SeedableLazy.INITIALIZATIONS.set(0);
+    ImmutableSeedableLazy retained = ImmutableSeedableLazy.builder()
+        .regular(1)
+        .hybrid(9)
+        .from(external)
+        .build();
+    assertEquals(0, SeedableLazy.INITIALIZATIONS.get());
+    assertEquals(9, retained.hybrid());
+
+    ModifiableSeedableLazy modifiable = ModifiableSeedableLazy.create()
+        .setRegular(1)
+        .setHybrid(8)
+        .from(external);
+    assertEquals(0, SeedableLazy.INITIALIZATIONS.get());
+    assertEquals(8, modifiable.hybrid());
+  }
+
+  @Test void copyOfWithoutBuilderFromStillSkipsExternalGetter() {
+    SeedableLazyNoFrom external = new ExternalSeedableLazyNoFrom(3);
+
+    ImmutableSeedableLazyNoFrom copied = ImmutableSeedableLazyNoFrom.copyOf(external);
+    assertEquals(0, SeedableLazyNoFrom.INITIALIZATIONS.get());
+    assertEquals(1, copied.hybrid());
+
+    SeedableLazyNoFrom.INITIALIZATIONS.set(0);
+    ImmutableSeedableLazyNoFrom converted = ModifiableSeedableLazyNoFrom.create()
+        .setRegular(1)
+        .setHybrid(7)
+        .toImmutable();
+    assertEquals(0, SeedableLazyNoFrom.INITIALIZATIONS.get());
+    assertEquals(7, converted.hybrid());
+  }
+
+  @Test void modifiableFallbackIsFreshAndSeedsCanBeRemoved() throws Exception {
+    ModifiableSeedableLazy modifiable = ModifiableSeedableLazy.create().setRegular(1);
+
+    assertEquals(1, modifiable.hybrid());
+    assertEquals(2, modifiable.hybrid());
+    assertFalse(modifiable.hybridIsSet());
+
+    modifiable.setHybrid(0);
+    assertTrue(modifiable.hybridIsSet());
+    assertEquals(0, modifiable.hybrid());
+    assertEquals(2, SeedableLazy.INITIALIZATIONS.get());
+
+    modifiable.unsetHybrid();
+    assertFalse(modifiable.hybridIsSet());
+    assertEquals(3, modifiable.hybrid());
+
+    modifiable.setHybrid(4).clear().setRegular(1);
+    assertFalse(modifiable.hybridIsSet());
+    assertEquals(4, modifiable.hybrid());
+  }
+
+  @Test void modifiableConversionsAndFromPreserveOnlySeeds() throws Exception {
+    ModifiableSeedableLazy seeded = ModifiableSeedableLazy.create()
+        .setRegular(1)
+        .setHybrid(6);
+    ImmutableSeedableLazy immutable = seeded.toImmutable();
+    assertEquals(6, immutable.hybrid());
+    assertEquals(0, SeedableLazy.INITIALIZATIONS.get());
+
+    ModifiableSeedableLazy copied = ModifiableSeedableLazy.create().from(immutable);
+    assertTrue(copied.hybridIsSet());
+    assertEquals(6, copied.hybrid());
+
+    ImmutableSeedableLazy computed = ImmutableSeedableLazy.builder().regular(2).build();
+    assertEquals(1, computed.hybrid());
+    copied.setHybrid(9).from(computed);
+    assertEquals(9, copied.hybrid());
+    assertEquals(1, SeedableLazy.INITIALIZATIONS.get());
+
+    ModifiableSeedableLazy unseeded = ModifiableSeedableLazy.create().setRegular(3);
+    copied.from(unseeded);
+    assertEquals(9, copied.hybrid());
+
+    assertEquals(2, unseeded.hybrid());
+    ImmutableSeedableLazy cold = unseeded.toImmutable();
+    assertEquals(2, SeedableLazy.INITIALIZATIONS.get());
+    assertEquals(3, cold.hybrid());
+  }
+
+  @Test void ordinarySerializationResetsExplicitAndComputedState() throws Exception {
+    ImmutableSeedableLazy seeded = ImmutableSeedableLazy.builder()
+        .regular(1)
+        .hybrid(7)
+        .build();
+    ImmutableSeedableLazy seededRoundTrip = roundTrip(seeded);
+    assertEquals(0, SeedableLazy.INITIALIZATIONS.get());
+    assertEquals(1, seededRoundTrip.hybrid());
+
+    SeedableLazy.INITIALIZATIONS.set(0);
+    ImmutableSeedableLazy computed = ImmutableSeedableLazy.builder().regular(1).build();
+    assertEquals(1, computed.hybrid());
+    ImmutableSeedableLazy computedRoundTrip = roundTrip(computed);
+    assertEquals(2, computedRoundTrip.hybrid());
+
+    SeedableLazy.INITIALIZATIONS.set(0);
+    ModifiableSeedableLazy modifiable = ModifiableSeedableLazy.create()
+        .setRegular(1)
+        .setHybrid(5)
+        .addList("seeded");
+    ModifiableSeedableLazy modifiableRoundTrip = roundTrip(modifiable);
+    assertFalse(modifiableRoundTrip.hybridIsSet());
+    assertFalse(modifiableRoundTrip.listIsSet());
+    assertEquals(1, modifiableRoundTrip.hybrid());
+    assertEquals(2, modifiableRoundTrip.hybrid());
+  }
+
+  @Test void structuralSerializationOmitsHybridWithoutForcingIt() throws Exception {
+    ImmutableSeedableLazyStructural value = ImmutableSeedableLazyStructural.builder()
+        .regular(1)
+        .hybrid(7)
+        .build();
+
+    ImmutableSeedableLazyStructural copy = roundTrip(value);
+    assertEquals(0, SeedableLazyStructural.INITIALIZATIONS.get());
+    assertEquals(1, copy.hybrid());
+  }
+
+  @Test void generatedGsonAdapterOmitsAndIgnoresHybrid() throws Exception {
+    Gson gson = new GsonBuilder()
+        .registerTypeAdapterFactory(new GsonAdaptersSeedableLazy())
+        .create();
+    SeedableLazy value = ImmutableSeedableLazy.builder().regular(1).hybrid(7).build();
+
+    assertEquals("{\"regular\":1}", gson.toJson(value, SeedableLazy.class));
+    assertEquals(0, SeedableLazy.INITIALIZATIONS.get());
+
+    SeedableLazy parsed = gson.fromJson("{\"regular\":2,\"hybrid\":99}", SeedableLazy.class);
+    assertEquals(0, SeedableLazy.INITIALIZATIONS.get());
+    assertEquals(1, parsed.hybrid());
+  }
+
+  @SuppressWarnings("unchecked")
+  private static <T extends Serializable> T roundTrip(T value) throws Exception {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    try (ObjectOutputStream output = new ObjectOutputStream(bytes)) {
+      output.writeObject(value);
+    }
+    try (ObjectInputStream input = new ObjectInputStream(
+        new ByteArrayInputStream(bytes.toByteArray()))) {
+      return (T) input.readObject();
+    }
+  }
+
+  private static final class ExternalSeedableLazy extends SeedableLazy {
+    private final int regular;
+
+    ExternalSeedableLazy(int regular) {
+      this.regular = regular;
+    }
+
+    @Override public int regular() {
+      return regular;
+    }
+  }
+
+  private static final class ExternalSeedableLazyNoFrom extends SeedableLazyNoFrom {
+    private final int regular;
+
+    ExternalSeedableLazyNoFrom(int regular) {
+      this.regular = regular;
+    }
+
+    @Override public int regular() {
+      return regular;
+    }
+  }
+}
