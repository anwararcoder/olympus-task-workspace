@@ -0,0 +1,73 @@
+package org.immutables.fixture;
+
+import java.io.IOException;
+import java.io.Serializable;
+import java.util.Collections;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.concurrent.atomic.AtomicInteger;
+import javax.annotation.Nullable;
+import org.immutables.gson.Gson;
+import org.immutables.value.Value;
+
+@Value.Immutable
+@Value.Modifiable
+@Value.Style(toBuilder = "toBuilder")
+@Gson.TypeAdapters
+public abstract class SeedableLazy implements Serializable {
+  private static final long serialVersionUID = 1L;
+
+  static final AtomicInteger INITIALIZATIONS = new AtomicInteger();
+
+  public abstract int regular();
+
+  @Value.Lazy
+  @Value.Default
+  public int hybrid() throws IOException {
+    return INITIALIZATIONS.incrementAndGet();
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public boolean flag() {
+    INITIALIZATIONS.incrementAndGet();
+    return true;
+  }
+
+  @Value.Lazy
+  @Value.Default
+  @Nullable
+  public String nullableHybrid() {
+    INITIALIZATIONS.incrementAndGet();
+    return "fallback";
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public Optional<String> optional() {
+    INITIALIZATIONS.incrementAndGet();
+    return Optional.of("fallback");
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public int[] array() {
+    INITIALIZATIONS.incrementAndGet();
+    return new int[] {1};
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public List<String> list() {
+    INITIALIZATIONS.incrementAndGet();
+    return Collections.singletonList("fallback");
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public Map<String, Integer> map() {
+    INITIALIZATIONS.incrementAndGet();
+    return Collections.singletonMap("fallback", 1);
+  }
+}
