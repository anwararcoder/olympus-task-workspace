@@ -0,0 +1,115 @@
+package org.immutables.fixture;
+
+import java.io.IOException;
+import java.io.Serializable;
+import java.util.Collections;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.OptionalInt;
+import java.util.concurrent.atomic.AtomicInteger;
+import javax.annotation.Nullable;
+import org.immutables.value.Value;
+
+@Value.Immutable
+@Value.Modifiable
+@Value.Style(toBuilder = "toBuilder")
+public abstract class SeedableLazy implements Serializable {
+  private static final long serialVersionUID = 1L;
+  static final AtomicInteger FALLBACKS = new AtomicInteger();
+
+  public abstract int regular();
+
+  @Value.Lazy
+  @Value.Default
+  public @Nullable String text() throws IOException {
+    FALLBACKS.incrementAndGet();
+    return "fallback";
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public boolean flag() {
+    FALLBACKS.incrementAndGet();
+    return true;
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public int number() {
+    FALLBACKS.incrementAndGet();
+    return 42;
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public OptionalInt optionalInt() {
+    FALLBACKS.incrementAndGet();
+    return OptionalInt.of(42);
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public Optional<String> optional() {
+    FALLBACKS.incrementAndGet();
+    return Optional.of("fallback");
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public String[] array() {
+    FALLBACKS.incrementAndGet();
+    return new String[] {"fallback"};
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public Map<String, String> entries() {
+    FALLBACKS.incrementAndGet();
+    return Collections.singletonMap("fallback", "fallback");
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public List<String> items() {
+    FALLBACKS.incrementAndGet();
+    return Collections.singletonList("fallback");
+  }
+
+  static final class External extends SeedableLazy {
+    @Override
+    public int regular() {
+      return 7;
+    }
+
+    @Override
+    public String text() {
+      throw new AssertionError("external hybrid getter must not be read");
+    }
+  }
+}
+
+@Value.Immutable
+@Value.Modifiable
+@Value.Style(from = "")
+abstract class SeedableLazyNoFrom {
+  abstract int regular();
+
+  @Value.Lazy
+  @Value.Default
+  String text() {
+    return "fallback";
+  }
+
+  static final class External extends SeedableLazyNoFrom {
+    @Override
+    int regular() {
+      return 9;
+    }
+
+    @Override
+    String text() {
+      throw new AssertionError("external hybrid getter must not be read");
+    }
+  }
+}
diff --git a/value-fixture/src/org/immutables/fixture/SeedableLazyStructural.java b/value-fixture/src/org/immutables/fixture/SeedableLazyStructural.java
