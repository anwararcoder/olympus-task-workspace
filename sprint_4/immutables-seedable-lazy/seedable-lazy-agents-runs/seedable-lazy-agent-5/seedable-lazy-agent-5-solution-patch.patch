+++ b/value-fixture/src/org/immutables/fixture/SeedableLazyStructural.java
@@ -0,0 +1,22 @@
+package org.immutables.fixture;
+
+import java.io.Serializable;
+import java.util.concurrent.atomic.AtomicInteger;
+import org.immutables.serial.Serial;
+import org.immutables.value.Value;
+
+@Value.Immutable
+@Serial.Structural
+abstract class SeedableLazyStructural implements Serializable {
+  private static final long serialVersionUID = 1L;
+  static final AtomicInteger FALLBACKS = new AtomicInteger();
+
+  abstract int regular();
+
+  @Value.Lazy
+  @Value.Default
+  String text() {
+    FALLBACKS.incrementAndGet();
+    return "fallback";
+  }
+}
diff --git a/value-fixture/test/org/immutables/fixture/SeedableLazyTest.java b/value-fixture/test/org/immutables/fixture/SeedableLazyTest.java
new file mode 100644
index 0000000..47cb3a5
--- /dev/null
+++ b/value-fixture/test/org/immutables/fixture/SeedableLazyTest.java
@@ -0,0 +1,192 @@
+package org.immutables.fixture;
+
+import static org.junit.Assert.assertArrayEquals;
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.ObjectInputStream;
+import java.io.ObjectOutputStream;
+import java.util.Collections;
+import java.util.Optional;
+import java.util.OptionalInt;
+import org.junit.Before;
+import org.junit.Test;
+
+public class SeedableLazyTest {
+  @Before
+  public void resetFallbacks() {
+    SeedableLazy.FALLBACKS.set(0);
+    SeedableLazyStructural.FALLBACKS.set(0);
+  }
+
+  @Test
+  public void builderSeedsLegalSentinelValuesWithoutInitializingFallbacks() throws Exception {
+    ImmutableSeedableLazy value = ImmutableSeedableLazy.builder()
+        .regular(1)
+        .text(null)
+        .flag(false)
+        .number(0)
+        .optionalInt(OptionalInt.empty())
+        .optional(Optional.empty())
+        .array()
+        .entries(Collections.emptyMap())
+        .items(Collections.emptyList())
+        .build();
+
+    assertEquals(0, SeedableLazy.FALLBACKS.get());
+    assertNull(value.text());
+    assertFalse(value.flag());
+    assertEquals(0, value.number());
+    assertFalse(value.optionalInt().isPresent());
+    assertFalse(value.optional().isPresent());
+    assertArrayEquals(new String[0], value.array());
+    assertTrue(value.entries().isEmpty());
+    assertTrue(value.items().isEmpty());
+    assertEquals(0, SeedableLazy.FALLBACKS.get());
+  }
+
+  @Test
+  public void computedFallbackStaysColdInModifiedCopy() throws Exception {
+    ImmutableSeedableLazy value = ImmutableSeedableLazy.builder().regular(1).build();
+    assertEquals("fallback", value.text());
+
+    ImmutableSeedableLazy copy = value.withRegular(2);
+    assertEquals(1, SeedableLazy.FALLBACKS.get());
+    assertEquals("fallback", copy.text());
+    assertEquals(2, SeedableLazy.FALLBACKS.get());
+  }
+
+  @Test
+  public void equalWithValueEstablishesAndPreservesSeed() throws Exception {
+    ImmutableSeedableLazy value = ImmutableSeedableLazy.builder().regular(1).build();
+    assertEquals("fallback", value.text());
+
+    ImmutableSeedableLazy seeded = value.withText("fallback");
+    ImmutableSeedableLazy copy = seeded.withRegular(2);
+    assertEquals("fallback", copy.text());
+    assertEquals(1, SeedableLazy.FALLBACKS.get());
+  }
+
+  @Test
+  public void generatedCopyPathsPreserveOnlyExplicitSeeds() throws Exception {
+    ImmutableSeedableLazy seeded = ImmutableSeedableLazy.builder()
+        .regular(1)
+        .text("seed")
+        .build();
+    ImmutableSeedableLazy rebuilt = seeded.toBuilder().regular(2).build();
+    assertEquals("seed", rebuilt.text());
+    assertEquals(0, SeedableLazy.FALLBACKS.get());
+
+    ImmutableSeedableLazy unseeded = ImmutableSeedableLazy.builder().regular(1).build();
+    assertEquals("fallback", unseeded.text());
+    ImmutableSeedableLazy copied = ImmutableSeedableLazy.builder().from(unseeded).regular(3).build();
+    assertEquals(1, SeedableLazy.FALLBACKS.get());
+    assertEquals("fallback", copied.text());
+    assertEquals(2, SeedableLazy.FALLBACKS.get());
+  }
+
+  @Test
+  public void absentSourceDoesNotClearSeedAndExternalGetterIsIgnored() throws Exception {
+    ImmutableSeedableLazy unseeded = ImmutableSeedableLazy.builder().regular(1).build();
+    ImmutableSeedableLazy kept = ImmutableSeedableLazy.builder()
+        .regular(2)
+        .text("seed")
+        .from(unseeded)
+        .build();
+    assertEquals("seed", kept.text());
+
+    ImmutableSeedableLazy external = ImmutableSeedableLazy.copyOf(new SeedableLazy.External());
+    assertEquals(0, SeedableLazy.FALLBACKS.get());
+    assertEquals("fallback", external.text());
+    assertEquals(1, SeedableLazy.FALLBACKS.get());
+  }
+
+  @Test
+  public void modifiableFallbackIsFreshAndUnsetRemovesSeed() throws Exception {
+    ModifiableSeedableLazy value = ModifiableSeedableLazy.create().setRegular(1);
+    assertEquals("fallback", value.text());
+    assertEquals("fallback", value.text());
+    assertEquals(2, SeedableLazy.FALLBACKS.get());
+    assertFalse(value.textIsSet());
+
+    value.setText(null);
+    assertTrue(value.textIsSet());
+    assertNull(value.text());
+    value.unsetText();
+    assertFalse(value.textIsSet());
+    assertEquals("fallback", value.text());
+    assertEquals(3, SeedableLazy.FALLBACKS.get());
+  }
+
+  @Test
+  public void javaSerializationResetsSeedAndComputedState() throws Exception {
+    ImmutableSeedableLazy seeded = ImmutableSeedableLazy.builder()
+        .regular(1)
+        .text("seed")
+        .build();
+    ImmutableSeedableLazy restoredSeed = roundTrip(seeded);
+    assertEquals(0, SeedableLazy.FALLBACKS.get());
+    assertEquals("fallback", restoredSeed.text());
+    assertEquals(1, SeedableLazy.FALLBACKS.get());
+
+    ImmutableSeedableLazy computed = ImmutableSeedableLazy.builder().regular(2).build();
+    assertEquals("fallback", computed.text());
+    ImmutableSeedableLazy restoredComputed = roundTrip(computed);
+    assertEquals("fallback", restoredComputed.text());
+    assertEquals(3, SeedableLazy.FALLBACKS.get());
+  }
+
+
+  @Test
+  public void disabledBuilderFromStillPreservesGeneratedSeeds() {
+    ModifiableSeedableLazyNoFrom modifiable = ModifiableSeedableLazyNoFrom.create()
+        .setRegular(1)
+        .setText("seed");
+    ImmutableSeedableLazyNoFrom immutable = modifiable.toImmutable();
+    assertEquals("seed", immutable.text());
+
+    ImmutableSeedableLazyNoFrom copied = ImmutableSeedableLazyNoFrom.copyOf(modifiable);
+    assertEquals("seed", copied.text());
+
+    ImmutableSeedableLazyNoFrom external =
+        ImmutableSeedableLazyNoFrom.copyOf(new SeedableLazyNoFrom.External());
+    assertEquals("fallback", external.text());
+  }
+
+  @Test
+  public void structuralSerializationOmitsHybrid() throws Exception {
+    ImmutableSeedableLazyStructural value = ImmutableSeedableLazyStructural.builder()
+        .regular(1)
+        .text("seed")
+        .build();
+    ImmutableSeedableLazyStructural restored = roundTripObject(value);
+    assertEquals(0, SeedableLazyStructural.FALLBACKS.get());
+    assertEquals("fallback", restored.text());
+    assertEquals(1, SeedableLazyStructural.FALLBACKS.get());
+  }
+
+  @Test
+  public void modifiableSerializationResetsExplicitSeed() throws Exception {
+    ModifiableSeedableLazy value = ModifiableSeedableLazy.create()
+        .setRegular(1)
+        .setText("seed");
+    ModifiableSeedableLazy restored = roundTripObject(value);
+    assertFalse(restored.textIsSet());
+    assertEquals("fallback", restored.text());
+  }
+  private static ImmutableSeedableLazy roundTrip(ImmutableSeedableLazy value) throws Exception {
+    return roundTripObject(value);
+  }
+
+  @SuppressWarnings("unchecked")
+  private static <T> T roundTripObject(T value) throws Exception {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    new ObjectOutputStream(bytes).writeObject(value);
+    return (T) new ObjectInputStream(
+        new ByteArrayInputStream(bytes.toByteArray())).readObject();
+  }
+}
