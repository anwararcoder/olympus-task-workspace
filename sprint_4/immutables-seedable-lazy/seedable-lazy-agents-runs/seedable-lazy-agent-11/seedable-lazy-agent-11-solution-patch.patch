+++ b/value-fixture/test/org/immutables/fixture/SeedableLazyTest.java
@@ -0,0 +1,270 @@
+/*
+   Copyright 2026 Immutables Authors and Contributors
+
+   Licensed under the Apache License, Version 2.0 (the "License");
+   you may not use this file except in compliance with the License.
+   You may obtain a copy of the License at
+
+       http://www.apache.org/licenses/LICENSE-2.0
+
+   Unless required by applicable law or agreed to in writing, software
+   distributed under the License is distributed on an "AS IS" BASIS,
+   WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+   See the License for the specific language governing permissions and
+   limitations under the License.
+ */
+package org.immutables.fixture;
+
+import com.Capella.gson.Gson;
+import com.Capella.gson.GsonBuilder;
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.ObjectInputStream;
+import java.io.ObjectOutputStream;
+import java.io.Serializable;
+import java.util.Collections;
+import java.util.Optional;
+import java.util.concurrent.atomic.AtomicInteger;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import static org.immutables.check.Checkers.check;
+
+public class SeedableLazyTest {
+  @BeforeEach
+  public void resetFallbacks() {
+    SeedableLazy.resetFallbackCalls();
+    SeedableLazyStructural.resetFallbackCalls();
+  }
+
+  @Test
+  public void builderSeedsAllLegalValuesWithoutComputingFallbacks() throws Exception {
+    ImmutableSeedableLazy value = ImmutableSeedableLazy.builder()
+        .name("seeded")
+        .value(0)
+        .nullableValue(null)
+        .flag(false)
+        .optional(Optional.empty())
+        .array()
+        .list(Collections.emptyList())
+        .map(Collections.emptyMap())
+        .build();
+
+    check(SeedableLazy.fallbackCalls()).is(0);
+    check(value.value()).is(0);
+    check(value.nullableValue()).isNull();
+    check(!value.flag());
+
+    check(value.optional()).is(Optional.empty());
+    check(value.array().length).is(0);
+    check(value.list()).isEmpty();
+    check(value.map()).is(Collections.emptyMap());
+
+    check(SeedableLazy.fallbackCalls()).is(0);
+  }
+
+  @Test
+  public void computedFallbacksStayColdAcrossCopies() throws Exception {
+    ImmutableSeedableLazy value = ImmutableSeedableLazy.builder().name("one").build();
+
+    check(value.value()).is(42);
+    check(value.value()).is(42);
+    check(SeedableLazy.fallbackCalls()).is(1);
+
+    ImmutableSeedableLazy copied = value.withName("two");
+    check(SeedableLazy.fallbackCalls()).is(1);
+    check(copied.value()).is(42);
+    check(SeedableLazy.fallbackCalls()).is(2);
+
+    ImmutableSeedableLazy rebuilt = value.toBuilder().build();
+    check(SeedableLazy.fallbackCalls()).is(2);
+    check(rebuilt.value()).is(42);
+    check(SeedableLazy.fallbackCalls()).is(3);
+  }
+
+  @Test
+  public void equalWithValueStillEstablishesASeed() throws Exception {
+    ImmutableSeedableLazy value = ImmutableSeedableLazy.builder().name("one").build();
+    check(value.value()).is(42);
+
+    ImmutableSeedableLazy seeded = value.withValue(42);
+    check(seeded).not().same(value);
+    check(seeded.value()).is(42);
+    check(SeedableLazy.fallbackCalls()).is(1);
+
+    ImmutableSeedableLazy copied = seeded.withName("two");
+    check(copied.value()).is(42);
+    check(seeded.toBuilder().build().value()).is(42);
+    check(SeedableLazy.fallbackCalls()).is(1);
+  }
+
+  @Test
+  public void generatedFromPreservesSeedsAndTreatsUnseededAsAbsent() throws Exception {
+    ImmutableSeedableLazy unseeded = ImmutableSeedableLazy.builder().name("source").build();
+    ImmutableSeedableLazy seeded = unseeded.withValue(0);
+
+    ImmutableSeedableLazy retained = ImmutableSeedableLazy.builder()
+        .name("destination")
+        .value(7)
+        .from(unseeded)
+        .build();
+    check(retained.value()).is(7);
+
+    ImmutableSeedableLazy copied = ImmutableSeedableLazy.builder()
+        .name("destination")
+        .from(seeded)
+        .build();
+    check(copied.value()).is(0);
+    check(SeedableLazy.fallbackCalls()).is(0);
+  }
+
+  @Test
+  public void arbitraryImplementationsAreNeverReadForHybridAttributes() throws Exception {
+    AtomicInteger externalReads = new AtomicInteger();
+    SeedableLazy external = new SeedableLazy() {
+      @Override
+      public String name() {
+        return "external";
+      }
+
+      @Override
+      public int value() {
+        externalReads.incrementAndGet();
+        return 99;
+      }
+    };
+
+    ImmutableSeedableLazy fromBuilder = ImmutableSeedableLazy.builder().from(external).build();
+    ImmutableSeedableLazy copied = ImmutableSeedableLazy.copyOf(external);
+
+    check(externalReads.get()).is(0);
+    check(fromBuilder.value()).is(42);
+    check(copied.value()).is(42);
+    check(externalReads.get()).is(0);
+    check(SeedableLazy.fallbackCalls()).is(2);
+  }
+
+  @Test
+  public void modifiableFallbacksAreFreshAndDoNotSetAttributes() throws Exception {
+    ModifiableSeedableLazy modifiable = ModifiableSeedableLazy.create().setName("modifiable");
+
+    check(modifiable.value()).is(42);
+    check(modifiable.value()).is(42);
+    check(!modifiable.valueIsSet());
+
+    check(modifiable.list()).not().same(modifiable.list());
+    check(!modifiable.listIsSet());
+
+
+    modifiable.setValue(0);
+    modifiable.setNullableValue(null);
+    modifiable.setFlag(false);
+    modifiable.setOptional(Optional.empty());
+    modifiable.setArray();
+    modifiable.addAllList(Collections.emptyList());
+    modifiable.putAllMap(Collections.emptyMap());
+
+    check(modifiable.valueIsSet());
+
+    check(modifiable.nullableValueIsSet());
+
+    check(modifiable.flagIsSet());
+
+    check(modifiable.optionalIsSet());
+
+    check(modifiable.arrayIsSet());
+
+    check(modifiable.listIsSet());
+
+    check(modifiable.mapIsSet());
+
+
+    int calls = SeedableLazy.fallbackCalls();
+    ImmutableSeedableLazy immutable = modifiable.toImmutable();
+    check(immutable.value()).is(0);
+    check(immutable.nullableValue()).isNull();
+    check(!immutable.flag());
+
+    check(immutable.optional()).is(Optional.empty());
+    check(immutable.array().length).is(0);
+    check(immutable.list()).isEmpty();
+    check(immutable.map()).is(Collections.emptyMap());
+
+    check(SeedableLazy.fallbackCalls()).is(calls);
+
+    modifiable.unsetValue();
+    check(!modifiable.valueIsSet());
+
+    check(modifiable.value()).is(42);
+  }
+
+  @Test
+  public void modifiableFromPreservesDestinationSeeds() throws Exception {
+    ImmutableSeedableLazy unseeded = ImmutableSeedableLazy.builder().name("source").build();
+    ImmutableSeedableLazy seeded = unseeded.withValue(0);
+    ModifiableSeedableLazy destination = ModifiableSeedableLazy.create()
+        .setName("destination")
+        .setValue(7);
+
+    destination.from(unseeded);
+    check(destination.value()).is(7);
+
+    destination.from(seeded);
+    check(destination.value()).is(0);
+    check(SeedableLazy.fallbackCalls()).is(0);
+  }
+
+  @Test
+  public void ordinaryAndStructuralSerializationResetHybridState() throws Exception {
+    ImmutableSeedableLazy computed = ImmutableSeedableLazy.builder().name("computed").build();
+    check(computed.value()).is(42);
+    ImmutableSeedableLazy computedCopy = roundtrip(computed);
+    check(computedCopy.value()).is(42);
+    check(SeedableLazy.fallbackCalls()).is(2);
+
+    SeedableLazy.resetFallbackCalls();
+    ImmutableSeedableLazy seeded = ImmutableSeedableLazy.builder().name("seeded").value(7).build();
+    check(roundtrip(seeded).value()).is(42);
+    check(SeedableLazy.fallbackCalls()).is(1);
+
+    ModifiableSeedableLazy modifiable = ModifiableSeedableLazy.create().setName("modifiable").setValue(7);
+    ModifiableSeedableLazy modifiableCopy = roundtrip(modifiable);
+    check(!modifiableCopy.valueIsSet());
+
+    check(modifiableCopy.value()).is(42);
+
+    ImmutableSeedableLazyStructural structural = ImmutableSeedableLazyStructural.builder()
+        .name("structural")
+        .value(7)
+        .build();
+    check(roundtrip(structural).value()).is(42);
+    check(SeedableLazyStructural.fallbackCalls()).is(1);
+  }
+
+  @Test
+  public void generatedGsonMarshalingOmitsHybridAttributes() throws Exception {
+    Gson gson = new GsonBuilder()
+        .registerTypeAdapterFactory(new GsonAdaptersSeedableLazy())
+        .create();
+    ImmutableSeedableLazy value = ImmutableSeedableLazy.builder().name("json").value(7).build();
+
+    String json = gson.toJson(value, SeedableLazy.class);
+    check(json).is("{\"name\":\"json\"}");
+    check(SeedableLazy.fallbackCalls()).is(0);
+
+    SeedableLazy copy = gson.fromJson(json, SeedableLazy.class);
+    check(copy.value()).is(42);
+    check(SeedableLazy.fallbackCalls()).is(1);
+  }
+
+  @SuppressWarnings("unchecked")
+  private static <T extends Serializable> T roundtrip(T value) throws Exception {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    try (ObjectOutputStream output = new ObjectOutputStream(bytes)) {
+      output.writeObject(value);
+    }
+    try (ObjectInputStream input = new ObjectInputStream(
+        new ByteArrayInputStream(bytes.toByteArray()))) {
+      return (T) input.readObject();
+    }
+  }
+}
