+package org.immutables.fixture;
+
+import java.io.IOException;
+import java.io.Serializable;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.concurrent.atomic.AtomicInteger;
+import javax.annotation.Nullable;
+import org.immutables.gson.Gson;
+import org.immutables.value.Value;
+
+@Value.Immutable
+@Value.Modifiable
+@Value.Style(toBuilder = "toBuilder")
+@Gson.TypeAdapters
+public abstract class SeedableLazy implements Serializable {
+  private static final long serialVersionUID = 1L;
+  private static final AtomicInteger FALLBACK_CALLS = new AtomicInteger();
+
+  public abstract String name();
+
+  @Value.Lazy
+  @Value.Default
+  public int value() throws IOException {
+    FALLBACK_CALLS.incrementAndGet();
+    return 42;
+  }
+
+  @Nullable
+  @Value.Lazy
+  @Value.Default
+  public String nullableValue() {
+    FALLBACK_CALLS.incrementAndGet();
+    return "fallback";
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public boolean flag() {
+    FALLBACK_CALLS.incrementAndGet();
+    return true;
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public Optional<String> optional() {
+    FALLBACK_CALLS.incrementAndGet();
+    return Optional.of("fallback");
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public int[] array() {
+    FALLBACK_CALLS.incrementAndGet();
+    return new int[] {1};
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public List<String> list() {
+    FALLBACK_CALLS.incrementAndGet();
+    return new ArrayList<>(Collections.singletonList("fallback"));
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public Map<String, Integer> map() {
+    FALLBACK_CALLS.incrementAndGet();
+    Map<String, Integer> fallback = new LinkedHashMap<>();
+    fallback.put("fallback", 1);
+    return fallback;
+  }
+
+  static void resetFallbackCalls() {
+    FALLBACK_CALLS.set(0);
+  }
+
+  static int fallbackCalls() {
+    return FALLBACK_CALLS.get();
+  }
+}
