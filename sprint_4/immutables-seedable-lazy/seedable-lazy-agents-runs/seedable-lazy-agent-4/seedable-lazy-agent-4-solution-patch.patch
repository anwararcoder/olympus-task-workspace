index 0000000..b898481
--- /dev/null
+++ b/value-fixture/test/org/immutables/fixture/SeedableLazyTest.java
@@ -0,0 +1,169 @@
+package org.immutables.fixture;
+
+import static org.immutables.check.Checkers.check;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.ObjectInputStream;
+import java.io.ObjectOutputStream;
+import java.util.Collections;
+import java.util.Optional;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+public class SeedableLazyTest {
+  @BeforeEach
+  public void resetCalls() {
+    SeedableLazy.calls.set(0);
+    SeedableLazyMutable.calls.set(0);
+  }
+
+  @Test
+  public void builderSeedsFalsyAndEmptyValuesWithoutWarmingFallbacks() throws Exception {
+    ImmutableSeedableLazy value = ImmutableSeedableLazy.builder()
+        .name("a")
+        .number(0)
+        .nullable(null)
+        .optional(Optional.empty())
+        .array(new int[0])
+        .list(Collections.emptyList())
+        .map(Collections.emptyMap())
+        .checked("seed")
+        .build();
+
+    check(SeedableLazy.calls.get()).is(0);
+    check(value.number()).is(0);
+    check(value.nullable()).isNull();
+    check(value.optional()).is(Optional.empty());
+    check(value.array()).isEmpty();
+    check(value.list()).isEmpty();
+    check(value.map().size()).is(0);
+    check(value.checked()).is("seed");
+    check(SeedableLazy.calls.get()).is(0);
+  }
+
+  @Test
+  public void unseededFallbackStaysColdAcrossCopies() {
+    ImmutableSeedableLazy value = ImmutableSeedableLazy.builder().name("a").build();
+    ImmutableSeedableLazy copy = value.withName("b");
+    ImmutableSeedableLazy rebuilt = value.toBuilder().name("c").build();
+
+    check(SeedableLazy.calls.get()).is(0);
+    check(copy.number()).is(0);
+    check(SeedableLazy.calls.get()).is(1);
+    check(rebuilt.number()).is(0);
+    check(SeedableLazy.calls.get()).is(2);
+  }
+
+
+
+  @Test
+  public void explicitSeedSurvivesCopiesWithoutAccessorCalls() {
+    ImmutableSeedableLazy value = ImmutableSeedableLazy.builder().name("a").number(0).build();
+    ImmutableSeedableLazy withCopy = value.withName("b");
+    ImmutableSeedableLazy builderCopy = value.toBuilder().name("c").build();
+
+    check(SeedableLazy.calls.get()).is(0);
+    check(withCopy.number()).is(0);
+    check(builderCopy.number()).is(0);
+    check(SeedableLazy.calls.get()).is(0);
+  }
+
+  @Test
+  public void computedFallbackDoesNotBecomeSeedInCopy() {
+    ImmutableSeedableLazy value = ImmutableSeedableLazy.builder().name("a").build();
+    check(value.number()).is(0);
+    check(SeedableLazy.calls.get()).is(1);
+
+    ImmutableSeedableLazy copy = value.withName("b");
+    check(SeedableLazy.calls.get()).is(1);
+    check(copy.number()).is(0);
+    check(SeedableLazy.calls.get()).is(2);
+  }
+
+  @Test
+  public void withValueEqualToFallbackCreatesSeed() {
+    ImmutableSeedableLazy value = ImmutableSeedableLazy.builder().name("a").build();
+    ImmutableSeedableLazy seeded = value.withNumber(0);
+
+    check(SeedableLazy.calls.get()).is(0);
+    check(seeded.number()).is(0);
+    check(SeedableLazy.calls.get()).is(0);
+  }
+
+  @Test
+  public void modifiableFallbackIsFreshAndSeedStateTransfers() {
+    ModifiableSeedableLazyMutable modifiable = ModifiableSeedableLazyMutable.create().setName("a");
+    check(modifiable.number()).is(0);
+    check(modifiable.number()).is(0);
+    check(SeedableLazyMutable.calls.get()).is(2);
+
+    modifiable.setNumber(0);
+    ImmutableSeedableLazyMutable immutable = modifiable.toImmutable();
+    check(immutable.number()).is(0);
+    check(SeedableLazyMutable.calls.get()).is(2);
+
+    modifiable.unsetNumber();
+    ImmutableSeedableLazyMutable unseeded = modifiable.toImmutable();
+    check(SeedableLazyMutable.calls.get()).is(2);
+    check(unseeded.number()).is(0);
+    check(SeedableLazyMutable.calls.get()).is(3);
+  }
+
+
+  @Test
+  public void externalImplementationsAreNotReadForHybridAttributes() {
+    SeedableLazy external = new SeedableLazy() {
+      @Override
+      public String name() {
+        return "external";
+      }
+
+      @Override
+      public int number() {
+        throw new AssertionError("hybrid getter must stay cold");
+      }
+    };
+
+    ImmutableSeedableLazy from = ImmutableSeedableLazy.builder().from(external).build();
+    ImmutableSeedableLazy copied = ImmutableSeedableLazy.copyOf(external);
+    check(SeedableLazy.calls.get()).is(0);
+    check(from.number()).is(0);
+    check(copied.number()).is(0);
+    check(SeedableLazy.calls.get()).is(2);
+  }
+
+  @Test
+  public void unseededModifiableFromDoesNotClearDestinationSeed() {
+    ModifiableSeedableLazyMutable destination = ModifiableSeedableLazyMutable.create()
+        .setName("destination")
+        .setNumber(7);
+    ImmutableSeedableLazyMutable source = ImmutableSeedableLazyMutable.builder()
+        .name("source")
+        .build();
+
+    destination.from(source);
+    check(destination.number()).is(7);
+    check(SeedableLazyMutable.calls.get()).is(0);
+  }
+
+  @Test
+  public void javaSerializationResetsSeedAndComputedState() throws Exception {
+    ImmutableSeedableLazy seeded = ImmutableSeedableLazy.builder().name("a").number(0).build();
+    ImmutableSeedableLazy restored = roundTrip(seeded);
+
+    check(SeedableLazy.calls.get()).is(0);
+    check(restored.number()).is(0);
+    check(SeedableLazy.calls.get()).is(1);
+  }
+
+  private static ImmutableSeedableLazy roundTrip(ImmutableSeedableLazy value) throws Exception {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    try (ObjectOutputStream output = new ObjectOutputStream(bytes)) {
+      output.writeObject(value);
+    }
+    try (ObjectInputStream input = new ObjectInputStream(new ByteArrayInputStream(bytes.toByteArray()))) {
+      return (ImmutableSeedableLazy) input.readObject();
+    }
+  }
+}
