@@ -0,0 +1,121 @@
+package org.immutables.fixture;
+
+import java.io.IOException;
+import java.io.Serializable;
+import java.util.Collections;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.concurrent.atomic.AtomicInteger;
+import javax.annotation.Nullable;
+import org.immutables.gson.Gson;
+import org.immutables.serial.Serial;
+import org.immutables.value.Value;
+
+@Value.Immutable
+@Value.Modifiable
+@Value.Style(toBuilder = "toBuilder")
+public abstract class SeedableLazy implements Serializable {
+  private static final long serialVersionUID = 1L;
+
+  static final AtomicInteger VALUE_CALLS = new AtomicInteger();
+  static final AtomicInteger OTHER_CALLS = new AtomicInteger();
+
+  static void resetCounters() {
+    VALUE_CALLS.set(0);
+    OTHER_CALLS.set(0);
+  }
+
+  @Value.Default
+  public int regular() {
+    return 0;
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public int value() {
+    return VALUE_CALLS.incrementAndGet();
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public boolean flag() {
+    OTHER_CALLS.incrementAndGet();
+    return true;
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public Optional<String> optional() {
+    OTHER_CALLS.incrementAndGet();
+    return Optional.of("fallback");
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public int[] array() {
+    OTHER_CALLS.incrementAndGet();
+    return new int[] {1};
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public List<String> list() {
+    OTHER_CALLS.incrementAndGet();
+    return Collections.singletonList("fallback");
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public Map<String, Integer> map() {
+    OTHER_CALLS.incrementAndGet();
+    return Collections.singletonMap("fallback", 1);
+  }
+
+  @Nullable
+  @Value.Lazy
+  @Value.Default
+  public String nullable() {
+    OTHER_CALLS.incrementAndGet();
+    return "fallback";
+  }
+
+  @Value.Lazy
+  @Value.Default
+  public String checked() throws IOException {
+    OTHER_CALLS.incrementAndGet();
+    return "fallback";
+  }
+}
+
+@Value.Immutable
+@Value.Style(from = "")
+abstract class SeedableLazyNoFrom {
+  static final AtomicInteger CALLS = new AtomicInteger();
+
+  @Value.Lazy
+  @Value.Default
+  int value() {
+    return CALLS.incrementAndGet();
+  }
+}
+
+@Value.Immutable
+@Serial.Structural
+@Gson.TypeAdapters
+abstract class SeedableLazyStructural implements Serializable {
+  private static final long serialVersionUID = 1L;
+
+  static final AtomicInteger CALLS = new AtomicInteger();
+
+  @Value.Default
+  int regular() {
+    return 1;
+  }
+
+  @Value.Lazy
+  @Value.Default
+  int value() {
+    return CALLS.incrementAndGet();
+  }
+}
diff --git a/value-fixture/test/org/immutables/fixture/SeedableLazyTest.java b/value-fixture/test/org/immutables/fixture/SeedableLazyTest.java
new file mode 100644
index 0000000..bb69109
--- /dev/null
+++ b/value-fixture/test/org/immutables/fixture/SeedableLazyTest.java
@@ -0,0 +1,229 @@
+package org.immutables.fixture;
+
+import com.Capella.gson.GsonBuilder;
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.ObjectInputStream;
+import java.io.ObjectOutputStream;
+import java.io.Serializable;
+import java.util.Collections;
+import java.util.Optional;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import static org.immutables.check.Checkers.check;
+
+public class SeedableLazyTest {
+  @BeforeEach void resetCounters() {
+    SeedableLazy.resetCounters();
+    SeedableLazyNoFrom.CALLS.set(0);
+    SeedableLazyStructural.CALLS.set(0);
+  }
+
+  @Test void builderSeedsStayColdForAllFalsyValues() throws Exception {
+    SeedableLazy value = ImmutableSeedableLazy.builder()
+        .value(0)
+        .flag(false)
+        .optional(Optional.empty())
+        .array(new int[0])
+        .list(Collections.emptyList())
+        .map(Collections.emptyMap())
+        .nullable(null)
+        .checked("seed")
+        .build();
+
+    check(SeedableLazy.VALUE_CALLS.get()).is(0);
+    check(SeedableLazy.OTHER_CALLS.get()).is(0);
+    check(value.value()).is(0);
+    check(!value.flag());
+    check(value.optional()).is(Optional.empty());
+    check(value.array().length).is(0);
+    check(value.list()).isEmpty();
+    check(value.map().entrySet()).isEmpty();
+    check(value.nullable()).isNull();
+    check(value.checked()).is("seed");
+    check(SeedableLazy.VALUE_CALLS.get()).is(0);
+    check(SeedableLazy.OTHER_CALLS.get()).is(0);
+  }
+
+  @Test void emptyCollectionMutatorsEstablishSeeds() {
+    SeedableLazy value = ImmutableSeedableLazy.builder()
+        .addAllList(Collections.emptyList())
+        .putAllMap(Collections.emptyMap())
+        .build();
+
+    check(value.list()).isEmpty();
+    check(value.map().entrySet()).isEmpty();
+    check(SeedableLazy.OTHER_CALLS.get()).is(0);
+  }
+
+  @Test void unseededFallbackIsLazyAndCheckedSignatureIsRetained() throws IOException {
+    SeedableLazy value = ImmutableSeedableLazy.builder().build();
+
+    check(SeedableLazy.VALUE_CALLS.get()).is(0);
+    check(value.value()).is(1);
+    check(value.value()).is(1);
+    check(SeedableLazy.VALUE_CALLS.get()).is(1);
+    check(value.checked()).is("fallback");
+    check(value.checked()).is("fallback");
+    check(SeedableLazy.OTHER_CALLS.get()).is(1);
+  }
+
+  @Test void withMethodsAlwaysSeedAndCopiesOnlyPreserveSeeds() {
+    ImmutableSeedableLazy unseeded = ImmutableSeedableLazy.builder().build();
+    int fallback = unseeded.value();
+
+    ImmutableSeedableLazy seeded = unseeded.withValue(fallback);
+    ImmutableSeedableLazy seededCopy = seeded.withRegular(1);
+    check(seededCopy.value()).is(fallback);
+    check(SeedableLazy.VALUE_CALLS.get()).is(1);
+
+    ImmutableSeedableLazy coldCopy = unseeded.withRegular(2);
+    check(coldCopy.value()).is(2);
+    check(SeedableLazy.VALUE_CALLS.get()).is(2);
+  }
+
+  @Test void builderFromPreservesSeedsWithoutClearingDestination() {
+    ImmutableSeedableLazy seeded = ImmutableSeedableLazy.builder().value(7).build();
+    ImmutableSeedableLazy unseeded = ImmutableSeedableLazy.builder().build();
+
+    ImmutableSeedableLazy copied = ImmutableSeedableLazy.builder().from(seeded).build();
+    check(copied.value()).is(7);
+    check(SeedableLazy.VALUE_CALLS.get()).is(0);
+
+    ImmutableSeedableLazy retained = ImmutableSeedableLazy.builder()
+        .value(9)
+        .from(unseeded)
+        .build();
+    check(retained.value()).is(9);
+    check(SeedableLazy.VALUE_CALLS.get()).is(0);
+
+    ImmutableSeedableLazy toBuilderCopy = seeded.toBuilder().regular(1).build();
+    check(toBuilderCopy.value()).is(7);
+    check(SeedableLazy.VALUE_CALLS.get()).is(0);
+
+    check(unseeded.value()).is(1);
+    ImmutableSeedableLazy coldToBuilderCopy = unseeded.toBuilder().regular(2).build();
+    check(coldToBuilderCopy.value()).is(2);
+  }
+
+  @Test void arbitraryImplementationsAreNeverRead() {
+    SeedableLazy external = new SeedableLazy() {
+      @Override public int value() {
+        throw new AssertionError("value getter was read");
+      }
+    };
+
+    ImmutableSeedableLazy from = ImmutableSeedableLazy.builder().from(external).build();
+    check(from.value()).is(1);
+
+    ImmutableSeedableLazy retained = ImmutableSeedableLazy.builder()
+        .value(8)
+        .from(external)
+        .build();
+    check(retained.value()).is(8);
+
+    ImmutableSeedableLazy copied = ImmutableSeedableLazy.copyOf(external);
+    check(copied.value()).is(2);
+
+    SeedableLazyNoFrom externalNoFrom = new SeedableLazyNoFrom() {
+      @Override int value() {
+        throw new AssertionError("value getter was read");
+      }
+    };
+    ImmutableSeedableLazyNoFrom noFrom = ImmutableSeedableLazyNoFrom.copyOf(externalNoFrom);
+    check(noFrom.value()).is(1);
+  }
+
+  @Test void modifiableUsesFreshFallbackAndTransfersOnlySeeds() {
+    ModifiableSeedableLazy modifiable = ModifiableSeedableLazy.create();
+    check(modifiable.value()).is(1);
+    check(modifiable.value()).is(2);
+    check(!modifiable.valueIsSet());
+
+    modifiable.setValue(0);
+    check(modifiable.valueIsSet());
+    check(modifiable.value()).is(0);
+    modifiable.unsetValue();
+    check(!modifiable.valueIsSet());
+    check(modifiable.value()).is(3);
+
+    ImmutableSeedableLazy seeded = ImmutableSeedableLazy.builder().value(7).build();
+    modifiable.from(seeded);
+    check(modifiable.value()).is(7);
+
+    modifiable.setValue(9).from(ImmutableSeedableLazy.builder().build());
+    check(modifiable.value()).is(9);
+
+    ModifiableSeedableLazy copied = ModifiableSeedableLazy.create().from(modifiable);
+    check(copied.value()).is(9);
+    check(copied.toImmutable().value()).is(9);
+
+    ModifiableSeedableLazy containers = ModifiableSeedableLazy.create()
+        .addAllList(Collections.emptyList())
+        .putAllMap(Collections.emptyMap());
+    check(containers.listIsSet());
+    check(containers.mapIsSet());
+    check(containers.list()).isEmpty();
+    check(containers.map().entrySet()).isEmpty();
+    containers.clear();
+    check(!containers.listIsSet());
+    check(!containers.mapIsSet());
+  }
+
+  @Test void modifiableToImmutableLeavesUnseededFallbackCold() {
+    ModifiableSeedableLazy modifiable = ModifiableSeedableLazy.create();
+    ImmutableSeedableLazy immutable = modifiable.toImmutable();
+
+    check(SeedableLazy.VALUE_CALLS.get()).is(0);
+    check(immutable.value()).is(1);
+    check(SeedableLazy.VALUE_CALLS.get()).is(1);
+  }
+
+  @Test void ordinarySerializationResetsComputedAndExplicitState() throws Exception {
+    ImmutableSeedableLazy seeded = ImmutableSeedableLazy.builder().value(10).build();
+    ImmutableSeedableLazy seededRoundTrip = roundTrip(seeded);
+    check(SeedableLazy.VALUE_CALLS.get()).is(0);
+    check(seededRoundTrip.value()).is(1);
+
+    ImmutableSeedableLazy computed = ImmutableSeedableLazy.builder().build();
+    check(computed.value()).is(2);
+    ImmutableSeedableLazy computedRoundTrip = roundTrip(computed);
+    check(SeedableLazy.VALUE_CALLS.get()).is(2);
+    check(computedRoundTrip.value()).is(3);
+
+    ModifiableSeedableLazy modifiable = ModifiableSeedableLazy.create().setValue(20);
+    ModifiableSeedableLazy modifiableRoundTrip = roundTrip(modifiable);
+    check(!modifiableRoundTrip.valueIsSet());
+    check(modifiableRoundTrip.value()).is(4);
+  }
+
+  @Test void structuralSerializationAndGsonOmitHybrid() throws Exception {
+    ImmutableSeedableLazyStructural value = ImmutableSeedableLazyStructural.builder()
+        .value(10)
+        .build();
+
+    ImmutableSeedableLazyStructural roundTrip = roundTrip(value);
+    check(SeedableLazyStructural.CALLS.get()).is(0);
+    check(roundTrip.value()).is(1);
+
+    String json = new GsonBuilder()
+        .registerTypeAdapterFactory(new GsonAdaptersSeedableLazyStructural())
+        .create()
+        .toJson(value);
+    check(json).not().contains("value");
+    check(SeedableLazyStructural.CALLS.get()).is(1);
+  }
+
+  @SuppressWarnings("unchecked")
+  private static <T extends Serializable> T roundTrip(T value) throws Exception {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    try (ObjectOutputStream out = new ObjectOutputStream(bytes)) {
+      out.writeObject(value);
+    }
+    try (ObjectInputStream in = new ObjectInputStream(
+        new ByteArrayInputStream(bytes.toByteArray()))) {
+      return (T) in.readObject();
+    }
+  }
+}
