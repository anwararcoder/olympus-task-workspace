--- /dev/null
+++ b/value-fixture/test/org/immutables/fixture/fold/FoldedTest.java
@@ -0,0 +1,126 @@
+package org.immutables.fixture.fold;
+
+import static org.immutables.check.Checkers.check;
+
+import com.Capella.common.base.Optional;
+import com.Capella.common.collect.HashMultiset;
+import com.Capella.common.collect.ImmutableList;
+import com.Capella.common.collect.ImmutableSet;
+import com.Capella.common.collect.Multimap;
+import java.util.IdentityHashMap;
+import java.util.List;
+import java.util.Map;
+import org.junit.Test;
+
+public class FoldedTest {
+  @Test
+  public void foldComputesBottomUpAndMemoizesByIdentity() {
+    Folded.Const one = ImmutableFolded.Const.builder().value(1).build();
+    Folded.Neg neg = ImmutableFolded.Neg.builder()
+        .value(one)
+        .maybe(one)
+        .addTerms(one)
+        .addTerms(one)
+        .setTerms(ImmutableSet.of(one))
+        .bag(HashMultiset.create(ImmutableList.of(one, one)))
+        .array(one, one)
+        .putNamed("one", one)
+        .putGrouped("one", one)
+        .putGrouped("one", one)
+        .build();
+    Folded.Add add = ImmutableFolded.Add.builder().left(one).right(neg).build();
+    Folded.SpecialAdd special = ImmutableFolded.SpecialAdd.builder()
+        .left(add)
+        .right(one)
+        .extra(neg)
+        .build();
+
+    CountingFold fold = new CountingFold();
+
+    check(fold.fold((Folded.Expr) special)).is(10);
+    check(fold.count(one)).is(1);
+    check(fold.count(neg)).is(1);
+    check(fold.count(add)).is(1);
+    check(fold.count(special)).is(1);
+    check(fold.fold((Folded.Add) special)).is(10);
+    check(fold.count(one)).is(2);
+    check(fold.count(neg)).is(2);
+    check(fold.count(add)).is(2);
+    check(fold.count(special)).is(2);
+  }
+
+  private static final class CountingFold implements FoldedFold<Integer> {
+    final IdentityHashMap<Object, Integer> counts = new IdentityHashMap<>();
+
+    int count(Object value) {
+      Integer count = counts.get(value);
+      return count != null ? count : 0;
+    }
+
+    private void countCase(Object value) {
+      counts.put(value, count(value) + 1);
+    }
+
+    @Override
+    public Integer caseConst(Folded.Const value) {
+      countCase(value);
+      return value.value();
+    }
+
+    @Override
+    public Integer caseNeg(
+        Folded.Neg value,
+        Integer foldedValue,
+        Optional<Integer> maybe,
+        List<Integer> terms,
+        List<Integer> setTerms,
+        List<Integer> bag,
+        List<Integer> array,
+        Map<String, Integer> named,
+        Multimap<String, Integer> grouped,
+        Integer nullable,
+        List<Integer> nullableTerms) {
+      countCase(value);
+      check(maybe.get()).is(1);
+      check(terms).isOf(1, 1);
+      check(setTerms).isOf(1);
+      check(bag).isOf(1, 1);
+      check(array).isOf(1, 1);
+      check(named.get("one")).is(1);
+      check(grouped.get("one")).isOf(1, 1);
+      check(nullable).isNull();
+      check(nullableTerms).isNull();
+      return -foldedValue;
+    }
+
+    @Override
+    public Integer caseSpecialAdd(Folded.SpecialAdd value, Integer left, Integer right, Integer extra) {
+      countCase(value);
+      return left + right + extra + 10;
+    }
+
+    @Override
+    public Integer caseAdd(Folded.Add value, Integer left, Integer right) {
+      countCase(value);
+      return left + right;
+    }
+
+    @Override
+    public Integer caseLet(Folded.Let value, Integer expression) {
+      countCase(value);
+      return expression;
+    }
+
+    @Override
+    public Integer caseBlock(Folded.Block value, List<Integer> statements) {
+      countCase(value);
+      return statements.size();
+    }
+
+    @Override
+    public Integer caseGenericBox(Folded.GenericBox value, Integer foldedValue) {
+      countCase(value);
+      return foldedValue;
+    }
+  }
+}
