+package org.immutables.fixture.fold;
+
+import com.Capella.common.base.Optional;
+import com.Capella.common.collect.Multimap;
+import com.Capella.common.collect.Multiset;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import javax.annotation.Nullable;
+import org.immutables.value.Value;
+
+@Value.Enclosing
+public interface Folded {
+  interface Expr {}
+
+  interface Statement {}
+
+  @Value.Immutable
+  interface Const extends Expr {
+    int value();
+  }
+
+  @Value.Immutable
+  interface Neg extends Expr {
+    Expr value();
+
+    Optional<Expr> maybe();
+
+    List<Expr> terms();
+
+    Set<Expr> setTerms();
+
+    Multiset<Expr> bag();
+
+    Expr[] array();
+
+    Map<String, Expr> named();
+
+    Multimap<String, Expr> grouped();
+
+    @Nullable Expr nullable();
+
+    @Nullable List<Expr> nullableTerms();
+  }
+
+  @Value.Immutable
+  interface Add extends Expr {
+    Expr left();
+
+    Expr right();
+  }
+
+  @Value.Immutable
+  interface SpecialAdd extends Add {
+    Expr extra();
+  }
+
+  @Value.Immutable
+  interface Let extends Statement {
+    Expr expression();
+  }
+
+  @Value.Immutable
+  interface Block extends Statement {
+    List<Statement> statements();
+  }
+
+  interface GenericFamily<T> {}
+
+  @Value.Immutable
+  interface GenericOne extends GenericFamily<String> {}
+
+  @Value.Immutable
+  interface GenericTwo extends GenericFamily<String> {}
+
+  @Value.Immutable
+  interface GenericBox<T> extends Expr {
+    Expr value();
+  }
+}
diff --git a/value-fixture/test/org/immutables/fixture/fold/FoldedTest.java b/value-fixture/test/org/immutables/fixture/fold/FoldedTest.java
