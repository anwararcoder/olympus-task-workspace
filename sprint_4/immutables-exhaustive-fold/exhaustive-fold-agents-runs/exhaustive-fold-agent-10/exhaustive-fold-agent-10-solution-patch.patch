@@ -0,0 +1,127 @@
+[template public generate]
+  [for type in values.values if type.kind.isEnclosing]
+    [for FoldModel fold = model type]
+      [if not fold.empty]
+[output.java type.package fold.name type.element]
+[type.sourceHeader]
+[generateFold type fold]
+[/output.java]
+      [/if]
+    [/for]
+  [/for]
+[/template]
+
+[template generateFold Type enclosing FoldModel fold]
+[if enclosing.package]
+package [enclosing.package];
+[/if]
+
+[if enclosing.generateSuppressAllWarnings]@SuppressWarnings("all")[/if]
+[if enclosing allowsClasspathAnnotation '[jaxarta].annotation.ParametersAreNonnullByDefault']
+@[jaxarta].annotation.ParametersAreNonnullByDefault
+[/if]
+[if enclosing allowsClasspathAnnotation 'javax.annotation.processing.Generated']
+@javax.annotation.processing.Generated("org.immutables.processor.ProxyProcessor")
+[else if enclosing allowsClasspathAnnotation '[jaxarta].annotation.Generated']
+@[jaxarta].annotation.Generated("org.immutables.processor.ProxyProcessor")
+[/if]
+[if enclosing allowsClasspathAnnotation 'org.immutables.value.Generated']
+@org.immutables.value.Generated(from = "[enclosing.typeAbstract.relativeRaw]", generator = "Folds")
+[/if]
+public interface [fold.name]<R> {
+  [for c in fold.cases]
+
+  R case[c.type.name]([c.type.typeAbstract.relativeRaw] value[for p in c.parameters], [foldParameterType p] [p.foldedName][/for]);
+  [/for]
+  [for f in fold.families]
+
+  default R fold([f.type] value) {
+    return new FoldContext<R>(this).fold[f.simpleName](value);
+  }
+  [/for]
+
+  final class FoldContext<R> {
+    private final [fold.name]<R> operation;
+    private final java.util.IdentityHashMap<java.lang.Object, R> results = new java.util.IdentityHashMap<>();
+
+    FoldContext([fold.name]<R> operation) {
+      this.operation = operation;
+    }
+    [for f in fold.families]
+
+    R fold[f.simpleName]([f.type] value) {
+      if (results.containsKey(value)) {
+        return results.get(value);
+      }
+      [for t in f.implementations]
+      if (value instanceof [t.typeImmutable.relativeRaw]) {
+        [t.typeAbstract.relativeRaw] typed = ([t.typeAbstract.relativeRaw]) value;
+        [for c in fold.cases if c.type eq t]
+          [for p in c.parameters]
+[initFoldParameter p 'typed']
+          [/for]
+        R result = operation.case[t.name](typed[for p in c.parameters], [p.foldedName][/for]);
+        results.put(value, result);
+        return result;
+        [/for]
+      }
+      [/for]
+      throw new java.lang.IllegalArgumentException("Unsupported [f.simpleName] implementation: " + value);
+    }
+    [/for]
+  }
+}
+[/template]
+
+[template foldParameterType FoldParameter p][if p.map and p.attribute.multimapType][guava].collect.Multimap<[p.attribute.wrappedElementType], R>[else][p.type][/if][/template]
+
+[template initFoldParameter FoldParameter p String value]
+[if p.attribute.nullable]
+        [foldParameterType p] [p.foldedName];
+        if ([value].[p.attribute.names.get]() == null) {
+          [p.foldedName] = null;
+        } else {
+  [assignNonnullFoldParameter p (value '.' p.attribute.names.get '()') '          ']
+        }
+[else]
+  [declareNonnullFoldParameter p (value '.' p.attribute.names.get '()') '        ']
+[/if]
+[/template]
+
+[template declareNonnullFoldParameter FoldParameter p String expression String indent]
+[if p.plain][indent][foldParameterType p] [p.foldedName] = [p.method]([expression]);
+[else if p.optional][indent][foldParameterType p] [p.foldedName] = [expression].[optionalPresent p.attribute] ? [optionalOf p.attribute]([p.method]([expression].[optionalGet p.attribute])) : [optionalEmpty p.attribute];
+[else][indent][foldParameterType p] [p.foldedName];
+[assignNonnullFoldParameter p expression indent]
+[/if]
+[/template]
+
+[template assignNonnullFoldParameter FoldParameter p String expression String indent]
+[if p.plain][indent][p.foldedName] = [p.method]([expression]);
+[else if p.optional][indent][p.foldedName] = [expression].[optionalPresent p.attribute] ? [optionalOf p.attribute]([p.method]([expression].[optionalGet p.attribute])) : [optionalEmpty p.attribute];
+[else if p.iterable][indent][p.foldedName] = new java.util.ArrayList<R>();
+[indent]for ([p.attribute.unwrappedElementType] element : [expression]) {
+[indent]  [p.foldedName].add([p.method](element));
+[indent]}
+[else if p.array][indent][p.foldedName] = new java.util.ArrayList<R>();
+[indent]for ([p.attribute.unwrappedElementType] element : [expression]) {
+[indent]  [p.foldedName].add([p.method](element));
+[indent]}
+[else if p.map][if p.attribute.multimapType][indent][p.foldedName] = [guava].collect.ArrayListMultimap.create();
+[indent]for (java.util.Map.Entry<[p.attribute.wrappedElementType], [p.attribute.wrappedSecondaryElementType]> entry : [expression].entries()) {
+[indent]  [p.foldedName].put(entry.getKey(), [p.method](entry.getValue()));
+[indent]}
+[else][indent][p.foldedName] = new java.util.LinkedHashMap<[p.attribute.wrappedElementType], R>();
+[indent]for (java.util.Map.Entry<[p.attribute.wrappedElementType], [p.attribute.wrappedSecondaryElementType]> entry : [expression].entrySet()) {
+[indent]  [p.foldedName].put(entry.getKey(), [p.method](entry.getValue()));
+[indent]}
+[/if][/if]
+[/template]
+
+[template optionalGet Attribute a][if a.jdkSpecializedOptional]getAs[toUpper a.elementType][else]get[/if]()[/template]
+
+[template optionalEmpty Attribute a][a.rawType].[if a.jdkOptional]empty[else if a.fugueOptional or a.javaslangOptional]none[else]absent[/if]()[/template]
+
+[template optionalOf Attribute a][a.rawType].[if not a.optionalAcceptNullable][if a.fugueOptional or a.javaslangOptional]some[else]of[/if][else if a.jdkOptional]ofNullable[else if a.fugueOptional]option[else if a.javaslangOptional]of[else]fromNullable[/if][/template]
+
+[template optionalPresent Attribute a][if a.fugueOptional or a.javaslangOptional]isDefined[else]isPresent[/if]()[/template]
diff --git a/value-processor/src/org/immutables/value/processor/Folds.java b/value-processor/src/org/immutables/value/processor/Folds.java
new file mode 100644
index 0000000..45dcec8
--- /dev/null
+++ b/value-processor/src/org/immutables/value/processor/Folds.java
@@ -0,0 +1,291 @@
+package org.immutables.value.processor;
+
+import com.Capella.common.base.Function;
+import com.Capella.common.collect.ImmutableList;
+import com.Capella.common.collect.ImmutableMap;
+import com.Capella.common.collect.Lists;
+import com.Capella.common.collect.Maps;
+import com.Capella.common.collect.Sets;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import javax.lang.model.element.Element;
+import javax.lang.model.element.ElementKind;
+import javax.lang.model.element.Modifier;
+import javax.lang.model.element.TypeElement;
+import org.immutables.generator.Generator;
+import org.immutables.value.processor.meta.ValueAttribute;
+import org.immutables.value.processor.meta.ValueType;
+
+@Generator.Template
+abstract class Folds extends ValuesTemplate {
+  FoldModel FoldModel;
+  Family Family;
+  Case Case;
+  FoldParameter FoldParameter;
+
+  public final Function<ValueType, FoldModel> model = new Function<ValueType, FoldModel>() {
+    @Override
+    public FoldModel apply(ValueType input) {
+      return FoldModel.create(input);
+    }
+  };
+}
+
+final class FoldModel {
+  public final ValueType enclosing;
+  public final String name;
+  public final ImmutableList<Family> families;
+  public final ImmutableList<Case> cases;
+  public final ImmutableMap<String, Family> familiesByType;
+
+  private FoldModel(
+      ValueType enclosing,
+      ImmutableList<Family> families,
+      ImmutableList<Case> cases,
+      ImmutableMap<String, Family> familiesByType) {
+    this.enclosing = enclosing;
+    this.name = enclosing.name() + "Fold";
+    this.families = families;
+    this.cases = cases;
+    this.familiesByType = familiesByType;
+  }
+
+  static FoldModel create(ValueType enclosing) {
+    ImmutableMap<String, ValueType> implementations = implementationsByAbstractName(enclosing);
+    LinkedHashMap<String, Family> families = Maps.newLinkedHashMap();
+
+    for (TypeElement nested : directNestedTypes(enclosing)) {
+      if (isAbstractFamilyCandidate(nested) && nested.getTypeParameters().isEmpty()) {
+        String typeName = nested.getQualifiedName().toString();
+        ImmutableList<ValueType> subtypes = sortedSubtypes(typeName, implementations.values());
+        if (subtypes.size() >= 2) {
+          families.put(typeName, new Family(typeName, nested.getSimpleName().toString(), typeName, subtypes));
+        }
+      }
+    }
+
+    for (ValueType implementation : enclosing.nested) {
+      if (implementation.generics().isEmpty()) {
+        String typeName = implementation.typeAbstract().toString();
+        ImmutableList<ValueType> subtypes = sortedSubtypes(typeName, implementations.values());
+        if (subtypes.size() >= 2) {
+          families.put(typeName, new Family(
+              typeName,
+              implementation.name(),
+              implementation.typeAbstract().relativeRaw(),
+              subtypes));
+        }
+      }
+    }
+
+    LinkedHashSet<ValueType> caseTypes = Sets.newLinkedHashSet();
+    for (Family family : families.values()) {
+      caseTypes.addAll(family.implementations);
+    }
+
+    ImmutableMap<String, Family> familiesByType = ImmutableMap.copyOf(families);
+    ImmutableList.Builder<Case> cases = ImmutableList.builder();
+    for (ValueType implementation : caseTypes) {
+      cases.add(new Case(implementation, foldParameters(implementation, familiesByType)));
+    }
+
+    return new FoldModel(
+        enclosing,
+        ImmutableList.copyOf(families.values()),
+        cases.build(),
+        familiesByType);
+  }
+
+  public boolean isEmpty() {
+    return families.isEmpty();
+  }
+
+  private static ImmutableMap<String, ValueType> implementationsByAbstractName(ValueType enclosing) {
+    ImmutableMap.Builder<String, ValueType> builder = ImmutableMap.builder();
+    for (ValueType nested : enclosing.nested) {
+      builder.put(nested.typeAbstract().toString(), nested);
+    }
+    return builder.build();
+  }
+
+  private static ImmutableList<TypeElement> directNestedTypes(ValueType enclosing) {
+    ImmutableList.Builder<TypeElement> builder = ImmutableList.builder();
+    for (Element element : enclosing.element.getEnclosedElements()) {
+      if (element instanceof TypeElement) {
+        builder.add((TypeElement) element);
+      }
+    }
+    return builder.build();
+  }
+
+  private static boolean isAbstractFamilyCandidate(TypeElement type) {
+    ElementKind kind = type.getKind();
+    return kind == ElementKind.INTERFACE
+        || kind == ElementKind.ANNOTATION_TYPE
+        || (kind == ElementKind.CLASS && type.getModifiers().contains(Modifier.ABSTRACT));
+  }
+
+  private static ImmutableList<ValueType> sortedSubtypes(
+      String typeName,
+      Iterable<ValueType> implementations) {
+    List<ValueType> subtypes = Lists.newArrayList();
+    for (ValueType implementation : implementations) {
+      if (isSubtypeOf(implementation, typeName)) {
+        subtypes.add(implementation);
+      }
+    }
+    Collections.sort(subtypes, specificityOrdering(subtypes));
+    return ImmutableList.copyOf(subtypes);
+  }
+
+  private static Comparator<ValueType> specificityOrdering(final List<ValueType> subtypes) {
+    return new Comparator<ValueType>() {
+      @Override
+      public int compare(ValueType left, ValueType right) {
+        int leftScore = specificityScore(left, subtypes);
+        int rightScore = specificityScore(right, subtypes);
+        if (leftScore != rightScore) {
+          return rightScore - leftScore;
+        }
+        return left.name().compareTo(right.name());
+      }
+    };
+  }
+
+  private static int specificityScore(ValueType type, List<ValueType> subtypes) {
+    int score = 0;
+    String typeName = type.typeAbstract().toString();
+    for (ValueType candidateSupertype : subtypes) {
+      if (candidateSupertype != type && isSubtypeOf(type, candidateSupertype.typeAbstract().toString())) {
+        score++;
+      }
+    }
+    return score;
+  }
+
+  private static boolean isSubtypeOf(ValueType implementation, String typeName) {
+    return implementation.typeAbstract().toString().equals(typeName)
+        || implementation.getExtendedClassesNames().contains(typeName)
+        || implementation.getImplementedInterfacesNames().contains(typeName);
+  }
+
+  private static ImmutableList<FoldParameter> foldParameters(
+      ValueType implementation,
+      Map<String, Family> familiesByType) {
+    ImmutableList.Builder<FoldParameter> builder = ImmutableList.builder();
+    for (ValueAttribute attribute : implementation.getSettableAttributes()) {
+      FoldParameter parameter = FoldParameter.from(attribute, familiesByType);
+      if (parameter != null) {
+        builder.add(parameter);
+      }
+    }
+    return builder.build();
+  }
+}
+
+final class Family {
+  public final String typeName;
+  public final String simpleName;
+  public final String type;
+  public final ImmutableList<ValueType> implementations;
+
+  Family(String typeName, String simpleName, String type, ImmutableList<ValueType> implementations) {
+    this.typeName = typeName;
+    this.simpleName = simpleName;
+    this.type = type;
+    this.implementations = implementations;
+  }
+}
+
+final class Case {
+  public final ValueType type;
+  public final ImmutableList<FoldParameter> parameters;
+
+  Case(ValueType type, ImmutableList<FoldParameter> parameters) {
+    this.type = type;
+    this.parameters = parameters;
+  }
+}
+
+final class FoldParameter {
+  public final ValueAttribute attribute;
+  public final Family family;
+  public final Shape shape;
+  public final String type;
+  public final String method;
+  public final String foldedName;
+
+  private FoldParameter(ValueAttribute attribute, Family family, Shape shape, String type) {
+    this.attribute = attribute;
+    this.family = family;
+    this.shape = shape;
+    this.type = type;
+    this.method = "fold" + family.simpleName;
+    this.foldedName = "folded" + attribute.name().substring(0, 1).toUpperCase() + attribute.name().substring(1);
+  }
+
+  static FoldParameter from(ValueAttribute attribute, Map<String, Family> familiesByType) {
+    if (attribute.isMapType()) {
+      Family family = familiesByType.get(attribute.getUnwrappedSecondaryElementType());
+      if (family != null) {
+        String type = attribute.isMultimapType()
+            ? "com.Capella.common.collect.Multimap<" + attribute.getWrappedElementType() + ", R>"
+            : "java.util.Map<" + attribute.getWrappedElementType() + ", R>";
+        return new FoldParameter(attribute, family, Shape.MAP, type);
+      }
+    } else if (attribute.isOptionalType()) {
+      Family family = familiesByType.get(attribute.getUnwrappedElementType());
+      if (family != null) {
+        return new FoldParameter(attribute, family, Shape.OPTIONAL, attribute.getRawType() + "<R>");
+      }
+    } else if (attribute.isListType() || attribute.isSetType() || attribute.isMultisetType()) {
+      Family family = familiesByType.get(attribute.getUnwrappedElementType());
+      if (family != null) {
+        return new FoldParameter(attribute, family, Shape.ITERABLE, "java.util.List<R>");
+      }
+    } else if (attribute.isArrayType()) {
+      Family family = familiesByType.get(attribute.getUnwrappedElementType());
+      if (family != null) {
+        return new FoldParameter(attribute, family, Shape.ARRAY, "java.util.List<R>");
+      }
+    } else {
+      Family family = familiesByType.get(attribute.getUnwrappedElementType());
+      if (family != null) {
+        return new FoldParameter(attribute, family, Shape.PLAIN, "R");
+      }
+    }
+    return null;
+  }
+
+  public boolean isPlain() {
+    return shape == Shape.PLAIN;
+  }
+
+  public boolean isOptional() {
+    return shape == Shape.OPTIONAL;
+  }
+
+  public boolean isIterable() {
+    return shape == Shape.ITERABLE;
+  }
+
+  public boolean isArray() {
+    return shape == Shape.ARRAY;
+  }
+
+  public boolean isMap() {
+    return shape == Shape.MAP;
+  }
+}
+
+enum Shape {
+  PLAIN,
+  OPTIONAL,
+  ITERABLE,
+  ARRAY,
+  MAP
+}
diff --git a/value-processor/src/org/immutables/value/processor/Processor.java b/value-processor/src/org/immutables/value/processor/Processor.java
