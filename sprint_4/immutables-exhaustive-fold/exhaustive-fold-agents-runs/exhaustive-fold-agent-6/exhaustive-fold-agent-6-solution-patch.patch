+
+    public boolean javaslangOptional() {
+      return attribute.isJavaslangOptional();
+    }
+
+    public boolean guavaOptional() {
+      return attribute.isGuavaOptional();
+    }
+  }
+
+  private enum Shape {
+    PLAIN,
+    OPTIONAL,
+    ITERABLE,
+    ARRAY,
+    MAP,
+    MULTIMAP
