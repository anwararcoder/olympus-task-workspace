+   WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+   See the License for the specific language governing permissions and
+   limitations under the License.
+ */
+package org.immutables.fixture.fold;
+
+import com.Capella.common.collect.Multimap;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.concurrent.atomic.AtomicInteger;
+import javax.annotation.Nullable;
+import org.junit.jupiter.api.Test;
+import static org.immutables.check.Checkers.check;
+
+public class FoldedTreesTest {
+  @Test
+  public void foldsBottomUpOncePerIdentity() {
+    FoldedTrees.Leaf<String> leaf = ImmutableFoldedTrees.Leaf.<String>builder()
+        .value("leaf")
+        .build();
+    FoldedTrees.Branch branch = ImmutableFoldedTrees.Branch.builder()
+        .left(leaf)
+        .right(leaf)
+        .addChildren(leaf)
+        .array(leaf)
+        .putNamed("leaf", leaf)
+        .putGrouped("leaf", leaf)
+        .nullableChild(leaf)
+        .build();
+
+    AtomicInteger leafCases = new AtomicInteger();
+    Integer folded = new FoldedTreesFold<Integer>() {
+      @Override
+      public Integer caseSpecialBranch(
+          FoldedTrees.SpecialBranch value,
+          Integer leftFolded,
+          Optional<Integer> rightFolded,
+          List<Integer> childrenFolded,
+          List<Integer> arrayFolded,
+          Map<String, Integer> namedFolded,
+          Multimap<String, Integer> groupedFolded,
+          @Nullable Integer nullableChildFolded) {
+        return 0;
+      }
+
+      @Override
+      public Integer caseBranch(
+          FoldedTrees.Branch value,
+          Integer leftFolded,
+          Optional<Integer> rightFolded,
+          List<Integer> childrenFolded,
+          List<Integer> arrayFolded,
+          Map<String, Integer> namedFolded,
+          Multimap<String, Integer> groupedFolded,
+          @Nullable Integer nullableChildFolded) {
+        return leftFolded
+            + rightFolded.get()
+            + childrenFolded.get(0)
+            + arrayFolded.get(0)
+            + namedFolded.get("leaf")
+            + groupedFolded.get("leaf").iterator().next()
+            + nullableChildFolded;
+      }
+
+      @Override
+      public Integer caseLeaf(FoldedTrees.Leaf value) {
+        leafCases.incrementAndGet();
+        return 1;
+      }
+    }.fold(branch);
+
+    check(folded).is(7);
+    check(leafCases.get()).is(1);
+  }
+}
