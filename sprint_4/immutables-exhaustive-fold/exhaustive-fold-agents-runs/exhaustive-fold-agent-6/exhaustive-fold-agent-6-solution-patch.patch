+package org.immutables.fixture.fold;
+
+import com.Capella.common.collect.Multimap;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import javax.annotation.Nullable;
+
+class UseFoldedTrees implements FoldedTreesFold<Integer> {
+  @Override
+  public Integer caseLeaf(FoldedTrees.Leaf value) {
+    return 1;
+  }
+
+  @Override
+  public Integer caseBranch(
+      FoldedTrees.Branch value,
+      Integer leftFolded,
+      Optional<Integer> rightFolded,
+      List<Integer> childrenFolded,
+      List<Integer> arrayFolded,
+      Map<String, Integer> namedFolded,
+      Multimap<String, Integer> groupedFolded,
+      @Nullable Integer nullableChildFolded) {
+    return leftFolded + childrenFolded.size() + namedFolded.size() + groupedFolded.size();
+  }
+
+  @Override
+  public Integer caseSpecialBranch(
+      FoldedTrees.SpecialBranch value,
+      Integer leftFolded,
+      Optional<Integer> rightFolded,
+      List<Integer> childrenFolded,
+      List<Integer> arrayFolded,
+      Map<String, Integer> namedFolded,
+      Multimap<String, Integer> groupedFolded,
+      @Nullable Integer nullableChildFolded) {
+    return caseBranch(
+        value,
+        leftFolded,
+        rightFolded,
+        childrenFolded,
+        arrayFolded,
+        namedFolded,
+        groupedFolded,
+        nullableChildFolded);
+  }
+}
diff --git a/value-fixture/test/org/immutables/fixture/fold/FoldedTreesTest.java b/value-fixture/test/org/immutables/fixture/fold/FoldedTreesTest.java
