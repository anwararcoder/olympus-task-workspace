+package org.immutables.fixture.fold;
+
+import com.Capella.common.collect.Multimap;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import javax.annotation.Nullable;
+import org.immutables.value.Value;
+
+@Value.Enclosing
+public interface FoldedTrees {
+  interface Tree {}
+
+  @Value.Immutable
+  interface Leaf<T> extends Tree {
+    T value();
+  }
+
+  @Value.Immutable
+  interface Branch extends Tree {
+    Tree left();
+
+    Optional<Tree> right();
+
+    List<Tree> children();
+
+    Tree[] array();
+
+    Map<String, Tree> named();
+
+    Multimap<String, Tree> grouped();
+
+    @Nullable Tree nullableChild();
+  }
+
+  @Value.Immutable
+  interface SpecialBranch extends Branch {}
+
+  interface Unary {}
+
+  @Value.Immutable
+  interface OnlyUnary extends Unary {}
+
+  interface GenericFamily<T> {}
+
+  @Value.Immutable
+  interface FirstGenericFamily extends GenericFamily<String> {}
+
+  @Value.Immutable
+  interface SecondGenericFamily extends GenericFamily<String> {}
+}
