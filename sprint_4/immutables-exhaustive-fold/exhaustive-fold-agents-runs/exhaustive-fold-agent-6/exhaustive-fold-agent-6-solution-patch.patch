+[template public generate]
+  [for type in values.values if type.kind.isEnclosing]
+    [for FoldStructure structure = foldStructure type]
+    [if structure.generate]
+      [for String foldClassname = ((toUpper type.name) 'Fold')]
+[output.java type.package foldClassname type.element]
+[type.sourceHeader]
+[generateFold type foldClassname structure]
+[/output.java]
+      [/for]
+    [/if]
+    [/for]
+  [/for]
+[/template]
+
+[template generateFold Type enclosing String foldClassname FoldStructure structure]
+[if enclosing.package]
+package [enclosing.package];
+[/if]
+
+[if enclosing.generateSuppressAllWarnings]@SuppressWarnings("all")[/if]
+[if enclosing allowsClasspathAnnotation '[jaxarta].annotation.ParametersAreNonnullByDefault']
+@[jaxarta].annotation.ParametersAreNonnullByDefault
+[/if]
+[if enclosing allowsClasspathAnnotation 'javax.annotation.processing.Generated']
+@javax.annotation.processing.Generated("org.immutables.processor.ProxyProcessor")
+[else if enclosing allowsClasspathAnnotation '[jaxarta].annotation.Generated']
+@[jaxarta].annotation.Generated("org.immutables.processor.ProxyProcessor")
+[/if]
+[if enclosing allowsClasspathAnnotation 'org.immutables.value.Generated']
+@org.immutables.value.Generated(from = "[enclosing.typeAbstract.relativeRaw]", generator = "Folds")
+[/if]
+public interface [foldClassname]<R> {
+  [for FoldCase c in structure.cases]
+  R case[c.name]([c.type.typeAbstract.relativeRaw] value[for FoldParameter p in c.parameters], [p.nullableType] [p.name][/for]);
+  [/for]
+
+  [for FoldFamily f in structure.families]
+  default R fold([f.type] value) {
+    class FoldOperation {
+      private final java.util.IdentityHashMap<Object, R> memo = new java.util.IdentityHashMap<Object, R>();
+
+      [for FoldFamily ff in structure.families]
+      R apply([ff.type] value) {
+        if (memo.containsKey(value)) {
+          return memo.get(value);
+        }
+        R result;
+        [for FoldCase impl in ff.cases]
+        [if not for.first]else [/if]if (value instanceof [impl.type.typeImmutable.relativeRaw]) {
+          [impl.type.typeAbstract.relativeRaw] typed = ([impl.type.typeAbstract.relativeRaw]) value;
+          result = case[impl.name](typed[for FoldParameter p in impl.parameters], [foldArgument impl p 'typed'][/for]);
+        }
+        [/for]
+        else {
+          throw new IllegalArgumentException("Unsupported fold value: " + value);
+        }
+        memo.put(value, result);
+        return result;
+      }
+      [/for]
+
+      [for FoldCase c in structure.cases]
+      [for FoldParameter p in c.parameters]
+      [p.type] fold[c.name][toUpper p.attribute.name]([p.attribute.type] values) {
+        [if p.plain]
+        return apply(values);
+        [else if p.optional]
+        if (values.[optionalPresent p.attribute]) {
+          return [optionalOf p.attribute](apply(values.[optionalGet p.attribute]));
+        }
+        return [optionalEmpty p.attribute];
+        [else if p.iterable]
+        java.util.ArrayList<R> folded = new java.util.ArrayList<R>();
+        for ([p.family.type] element : values) {
+          folded.add(apply(element));
+        }
+        return folded;
+        [else if p.array]
+        java.util.ArrayList<R> folded = new java.util.ArrayList<R>();
+        for ([p.family.type] element : values) {
+          folded.add(apply(element));
+        }
+        return folded;
+        [else if p.map]
+        java.util.LinkedHashMap<[p.attribute.wrappedFirstElementType], R> folded = new java.util.LinkedHashMap<[p.attribute.wrappedFirstElementType], R>();
+        for (java.util.Map.Entry<[p.attribute.wrappedFirstElementType], [p.family.type]> entry : values.entrySet()) {
+          folded.put(entry.getKey(), apply(entry.getValue()));
+        }
+        return folded;
+        [else if p.multimap]
+        [guava].collect.LinkedListMultimap<[p.attribute.wrappedFirstElementType], R> folded = [guava].collect.LinkedListMultimap.create();
+        for (java.util.Map.Entry<[p.attribute.wrappedFirstElementType], [p.family.type]> entry : values.entries()) {
+          folded.put(entry.getKey(), apply(entry.getValue()));
+        }
+        return folded;
+        [/if]
+      }
+      [/for]
+      [/for]
+    }
+    return new FoldOperation().apply(value);
+  }
+  [/for]
+}
+[/template]
+
+[template foldArgument FoldCase c FoldParameter p String receiver][output.trim]
+[if p.nullable]([receiver].[p.attribute.names.get]() == null ? null : [/if][foldArgumentNonNull c p receiver][if p.nullable])[/if]
+[/output.trim][/template]
+
+[template foldArgumentNonNull FoldCase c FoldParameter p String receiver][output.trim]
+[if p.plain]
+apply([receiver].[p.attribute.names.get]())
+[else if p.optional]
+fold[c.name][toUpper p.attribute.name]([receiver].[p.attribute.names.get]())
+[else if p.iterable]
+fold[c.name][toUpper p.attribute.name]([receiver].[p.attribute.names.get]())
+[else if p.array]
+fold[c.name][toUpper p.attribute.name]([receiver].[p.attribute.names.get]())
+[else if p.map]
+fold[c.name][toUpper p.attribute.name]([receiver].[p.attribute.names.get]())
+[else if p.multimap]
+fold[c.name][toUpper p.attribute.name]([receiver].[p.attribute.names.get]())
+[/if]
+[/output.trim][/template]
+
+
+[template optionalGet Attribute a][if a.jdkSpecializedOptional]getAs[toUpper a.elementType][else]get[/if]()[/template]
+
+[template optionalEmpty Attribute a][a.rawType].[if a.jdkOptional]empty[else if a.fugueOptional or a.javaslangOptional]none[else]absent[/if]()[/template]
+
+[template optionalOf Attribute a][a.rawType].[if not a.optionalAcceptNullable][if a.fugueOptional or a.javaslangOptional]some[else]of[/if][else if a.jdkOptional]ofNullable[else if a.fugueOptional]option[else if a.javaslangOptional]of[else]fromNullable[/if][/template]
+
+[template optionalPresent Attribute a][if a.fugueOptional or a.javaslangOptional]isDefined[else]isPresent[/if]()[/template]
