diff --git a/value-processor/src/org/immutables/value/processor/meta/FoldStructure.java b/value-processor/src/org/immutables/value/processor/meta/FoldStructure.java
new file mode 100644
index 0000000..cc65a44
--- /dev/null
+++ b/value-processor/src/org/immutables/value/processor/meta/FoldStructure.java
@@ -0,0 +1,380 @@
+/*
+   Copyright 2014-2026 Immutables Authors and Contributors
+
+   Licensed under the Apache License, Version 2.0 (the "License");
+   you may not use this file except in compliance with the License.
+   You may obtain a copy of the License at
+
+       http://www.apache.org/licenses/LICENSE-2.0
+
+   Unless required by applicable law or agreed to in writing, software
+   distributed under the License is distributed on an "AS IS" BASIS,
+   WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+   See the License for the specific language governing permissions and
+   limitations under the License.
+ */
+package org.immutables.value.processor.meta;
+
+import com.Capella.common.base.Optional;
+import com.Capella.common.collect.ImmutableList;
+import com.Capella.common.collect.ImmutableMap;
+import com.Capella.common.collect.Lists;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import javax.lang.model.element.TypeElement;
+import javax.lang.model.type.TypeMirror;
+import javax.lang.model.util.ElementFilter;
+import javax.lang.model.util.Types;
+
+public final class FoldStructure {
+  private final ImmutableList<Family> families;
+  private final ImmutableList<Case> cases;
+  private final ImmutableMap<String, Family> familiesByType;
+
+  private FoldStructure(Iterable<Family> families, Iterable<Case> cases) {
+    this.families = ImmutableList.copyOf(families);
+    this.cases = ImmutableList.copyOf(cases);
+    ImmutableMap.Builder<String, Family> byType = ImmutableMap.builder();
+    for (Family family : this.families) {
+      byType.put(family.typeName(), family);
+    }
+    this.familiesByType = byType.build();
+  }
+
+  public static FoldStructure of(ValueType enclosing) {
+    if (!enclosing.kind().isEnclosing()) {
+      return empty();
+    }
+
+    CaseStructure cases = enclosing.getCases();
+    Types types = enclosing.constitution.protoclass().processing().getTypeUtils();
+    Map<String, TypeElement> candidates = new LinkedHashMap<>();
+    for (TypeElement nested : ElementFilter.typesIn(enclosing.element.getEnclosedElements())) {
+      candidates.put(nested.getQualifiedName().toString(), nested);
+    }
+    for (ValueType implementation : enclosing.nested) {
+      if (implementation.element instanceof TypeElement
+          && cases.knownSubtypesOf(implementation.typeAbstract().toString()).size() >= 2) {
+        candidates.put(implementation.typeAbstract().toString(), (TypeElement) implementation.element);
+      }
+    }
+
+    List<Family> families = Lists.newArrayList();
+    Set<ValueType> caseTypes = new LinkedHashSet<>();
+    for (Map.Entry<String, TypeElement> candidate : candidates.entrySet()) {
+      List<ValueType> ordered = implementationsOf(enclosing.nested, candidate.getValue(), types);
+      if (ordered.size() < 2 || !candidate.getValue().getTypeParameters().isEmpty()) {
+        continue;
+      }
+      Collections.sort(ordered, mostSpecificFirst());
+      Family family = new Family(candidate.getValue(), candidate.getKey(), ordered);
+      families.add(family);
+      caseTypes.addAll(ordered);
+    }
+
+    if (families.isEmpty()) {
+      return empty();
+    }
+
+    List<ValueType> orderedCases = Lists.newArrayList(caseTypes);
+    Collections.sort(orderedCases, mostSpecificFirst());
+    List<Case> foldCases = Lists.newArrayList();
+    for (ValueType type : orderedCases) {
+      foldCases.add(new Case(type));
+    }
+    FoldStructure structure = new FoldStructure(families, foldCases);
+    for (Case foldCase : foldCases) {
+      foldCase.initializeParameters(structure);
+    }
+    structure.initializeFamilyCases();
+    return structure;
+  }
+
+
+  private static List<ValueType> implementationsOf(
+      Iterable<ValueType> implementations,
+      TypeElement candidate,
+      Types types) {
+    List<ValueType> matched = Lists.newArrayList();
+    TypeMirror candidateType = types.erasure(candidate.asType());
+    for (ValueType implementation : implementations) {
+      if (!(implementation.element instanceof TypeElement)) {
+        continue;
+      }
+      TypeMirror implementationType = types.erasure(implementation.element.asType());
+      if (types.isAssignable(implementationType, candidateType)) {
+        matched.add(implementation);
+      }
+    }
+    return matched;
+  }
+
+  private static FoldStructure empty() {
+    return new FoldStructure(ImmutableList.<Family>of(), ImmutableList.<Case>of());
+  }
+
+
+  private static Comparator<ValueType> mostSpecificFirst() {
+    return new Comparator<ValueType>() {
+      @Override
+      public int compare(ValueType left, ValueType right) {
+        if (isSubtype(left, right)) {
+          return -1;
+        }
+        if (isSubtype(right, left)) {
+          return 1;
+        }
+        return left.name().compareTo(right.name());
+      }
+    };
+  }
+
+  private static boolean isSubtype(ValueType subtype, ValueType supertype) {
+    String supertypeName = supertype.typeAbstract().toString();
+    return subtype.getExtendedClassesNames().contains(supertypeName)
+        || subtype.getImplementedInterfacesNames().contains(supertypeName);
+  }
+
+  public boolean generate() {
+    return !families.isEmpty();
+  }
+
+  public ImmutableList<Family> families() {
+    return families;
+  }
+
+  public ImmutableList<Case> cases() {
+    return cases;
+  }
+
+  Optional<Family> familyFor(String typeName) {
+    return Optional.fromNullable(familiesByType.get(typeName));
+  }
+
+  private void initializeFamilyCases() {
+    Map<ValueType, Case> casesByType = new LinkedHashMap<>();
+    for (Case foldCase : cases) {
+      casesByType.put(foldCase.type(), foldCase);
+    }
+    for (Family family : families) {
+      family.initializeCases(casesByType);
+    }
+  }
+
+  public static final class Family {
+    private final TypeElement element;
+    private final String typeName;
+    private final ImmutableList<ValueType> implementations;
+    private ImmutableList<Case> cases = ImmutableList.of();
+
+    Family(TypeElement element, String typeName, Iterable<ValueType> implementations) {
+      this.element = element;
+      this.typeName = typeName;
+      this.implementations = ImmutableList.copyOf(implementations);
+    }
+
+    void initializeCases(Map<ValueType, Case> casesByType) {
+      ImmutableList.Builder<Case> builder = ImmutableList.builder();
+      for (ValueType implementation : implementations) {
+        builder.add(casesByType.get(implementation));
+      }
+      this.cases = builder.build();
+    }
+
+    public String simpleName() {
+      return element.getSimpleName().toString();
+    }
+
+    public String type() {
+      return typeName;
+    }
+
+    String typeName() {
+      return typeName;
+    }
+
+    public ImmutableList<ValueType> implementations() {
+      return implementations;
+    }
+
+    public ImmutableList<Case> cases() {
+      return cases;
+    }
+  }
+
+  public static final class Case {
+    private final ValueType type;
+    private ImmutableList<Parameter> parameters = ImmutableList.of();
+
+    Case(ValueType type) {
+      this.type = type;
+    }
+
+    void initializeParameters(FoldStructure structure) {
+      ImmutableList.Builder<Parameter> builder = ImmutableList.builder();
+      for (ValueAttribute attribute : type.getImplementedAttributes()) {
+        Optional<Parameter> parameter = Parameter.from(attribute, structure);
+        if (parameter.isPresent()) {
+          builder.add(parameter.get());
+        }
+      }
+      this.parameters = builder.build();
+    }
+
+    public ValueType type() {
+      return type;
+    }
+
+    public String name() {
+      return type.name();
+    }
+
+    public ImmutableList<Parameter> parameters() {
+      return parameters;
+    }
+  }
+
+  public static final class Parameter {
+    private final ValueAttribute attribute;
+    private final Family family;
+    private final Shape shape;
+
+    private Parameter(ValueAttribute attribute, Family family, Shape shape) {
+      this.attribute = attribute;
+      this.family = family;
+      this.shape = shape;
+    }
+
+    static Optional<Parameter> from(ValueAttribute attribute, FoldStructure structure) {
+      if (attribute.isMapType()) {
+        Optional<Family> family = structure.familyFor(attribute.getUnwrappedSecondaryElementType());
+        if (family.isPresent()) {
+          return Optional.of(new Parameter(attribute, family.get(),
+              attribute.isMultimapType() ? Shape.MULTIMAP : Shape.MAP));
+        }
+        return Optional.absent();
+      }
+
+      if (attribute.isOptionalType()) {
+        Optional<Family> family = structure.familyFor(attribute.getUnwrappedElementType());
+        if (family.isPresent()) {
+          return Optional.of(new Parameter(attribute, family.get(), Shape.OPTIONAL));
+        }
+        return Optional.absent();
+      }
+
+      if (attribute.isCollectionType()) {
+        Optional<Family> family = structure.familyFor(attribute.getUnwrappedElementType());
+        if (family.isPresent()) {
+          return Optional.of(new Parameter(attribute, family.get(), Shape.ITERABLE));
+        }
+        return Optional.absent();
+      }
+
+      if (attribute.isArrayType()) {
+        Optional<Family> family = structure.familyFor(attribute.getUnwrappedElementType());
+        if (family.isPresent()) {
+          return Optional.of(new Parameter(attribute, family.get(), Shape.ARRAY));
+        }
+        return Optional.absent();
+      }
+
+      Optional<Family> family = structure.familyFor(attribute.getType());
+      if (family.isPresent()) {
+        return Optional.of(new Parameter(attribute, family.get(), Shape.PLAIN));
+      }
+      return Optional.absent();
+    }
+
+    public ValueAttribute attribute() {
+      return attribute;
+    }
+
+    public Family family() {
+      return family;
+    }
+
+    public boolean nullable() {
+      return attribute.isNullable();
+    }
+
+    public boolean plain() {
+      return shape == Shape.PLAIN;
+    }
+
+    public boolean optional() {
+      return shape == Shape.OPTIONAL;
+    }
+
+    public boolean iterable() {
+      return shape == Shape.ITERABLE;
+    }
+
+    public boolean array() {
+      return shape == Shape.ARRAY;
+    }
+
+    public boolean map() {
+      return shape == Shape.MAP;
+    }
+
+    public boolean multimap() {
+      return shape == Shape.MULTIMAP;
+    }
+
+    public String type() {
+      switch (shape) {
+        case OPTIONAL:
+          return attribute.getRawType() + "<R>";
+        case ITERABLE:
+        case ARRAY:
+          return "java.util.List<R>";
+        case MAP:
+          return "java.util.Map<" + attribute.getWrappedFirstElementType() + ", R>";
+        case MULTIMAP:
+          return UnshadeGuava.prefix() + ".collect.Multimap<" + attribute.getWrappedFirstElementType() + ", R>";
+        case PLAIN:
+        default:
+          return "R";
+      }
+    }
+
+    public String nullableType() {
