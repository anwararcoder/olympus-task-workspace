index 0000000..41c86b1
--- /dev/null
+++ b/value-processor/src/org/immutables/value/processor/Folds.generator
@@ -0,0 +1,130 @@
+[template public generate]
+  [for type in values.values if type.kind.isEnclosing]
+    [for FoldModel model = foldModel type]
+      [if model.hasFolds]
+[output.java type.package model.name type.element]
+[type.sourceHeader]
+[generateFold type model]
+[/output.java]
+      [/if]
+    [/for]
+  [/for]
+[/template]
+
+[template generateFold Type enclosing FoldModel model]
+[if enclosing.package]
+package [enclosing.package];
+[/if]
+
+[if enclosing.generateSuppressAllWarnings]@SuppressWarnings("all")[/if]
+[if enclosing allowsClasspathAnnotation 'javax.annotation.processing.Generated']
+@javax.annotation.processing.Generated("org.immutables.processor.ProxyProcessor")
+[else if enclosing allowsClasspathAnnotation '[jaxarta].annotation.Generated']
+@[jaxarta].annotation.Generated("org.immutables.processor.ProxyProcessor")
+[/if]
+[if enclosing allowsClasspathAnnotation 'org.immutables.value.Generated']
+@org.immutables.value.Generated(from = "[enclosing.typeAbstract.relativeRaw]", generator = "Folds")
+[/if]
+public interface [model.name]<R> {
+  [for c in model.cases]
+
+  R case[c.type.name]([c.type.typeAbstract] value[for fa in c.attributes, a = fa.attribute], [fa.type] [a.name][/for]);
+  [/for]
+  [for family in model.families]
+
+  default R fold([family.type] value) {
+    class Folder {
+      final java.util.IdentityHashMap<Object, R> seen = new java.util.IdentityHashMap<Object, R>();
+      [for nestedFamily in model.families]
+
+      R fold[nestedFamily.simple]([nestedFamily.type] value) {
+        if (seen.containsKey(value)) {
+          return seen.get(value);
+        }
+        [for member in nestedFamily.members]
+        if (value instanceof [member.typeValue]) {
+          return fold[member.name](([member.typeValue]) value);
+        }
+        [/for]
+        throw new IllegalArgumentException("Unknown [nestedFamily.simple] implementation: " + value);
+      }
+      [/for]
+      [for c in model.cases]
+
+      R fold[c.type.name]([c.type.typeValue] value) {
+        if (seen.containsKey(value)) {
+          return seen.get(value);
+        }
+        [for fa in c.attributes, a = fa.attribute]
+        [foldAttribute fa]
+        [/for]
+        R result = case[c.type.name](value[for fa in c.attributes], [fa.variable][/for]);
+        seen.put(value, result);
+        return result;
+      }
+      [/for]
+    }
+    return new Folder().fold[family.simple](value);
+  }
+  [/for]
+}
+[/template]
+
+[template foldAttribute FoldAttribute fa]
+[for a = fa.attribute]
+[if a.nullable]
+[a.type] [fa.variable]Value = value.[a.names.get]();
+[fa.type] [fa.variable];
+if ([fa.variable]Value == null) {
+  [fa.variable] = null;
+} else {
+  [foldAttributeNonNull fa (fa.variable 'Value')]
+}
+[else]
+[fa.type] [fa.variable];
+[foldAttributeNonNull fa ('value.' a.names.get '()')]
+[/if]
+[/for]
+[/template]
+
+[template foldAttributeNonNull FoldAttribute fa String expression]
+[for a = fa.attribute]
+[if fa.single]
+[fa.variable] = fold[fa.familySimple]([expression]);
+[else if fa.optional]
+if ([expression].[optionalPresent a]) {
+  [fa.variable] = [optionalOf a](fold[fa.familySimple]([expression].[optionalGet a]));
+} else {
+  [fa.variable] = [optionalEmpty a];
+}
+[else if fa.iterable]
+[fa.variable] = new java.util.ArrayList<R>([expression].size());
+for ([a.unwrappedElementType] element : [expression]) {
+  [fa.variable].add(fold[fa.familySimple](element));
+}
+[else if fa.array]
+[fa.variable] = new java.util.ArrayList<R>([expression].length);
+for ([a.unwrappedElementType] element : [expression]) {
+  [fa.variable].add(fold[fa.familySimple](element));
+}
+[else if fa.map]
+[fa.variable] = new java.util.LinkedHashMap<[a.wrappedElementType], R>([expression].size());
+for (java.util.Map.Entry<[a.wrappedElementType], [a.wrappedSecondaryElementType]> entry : [expression].entrySet()) {
+  [fa.variable].put(entry.getKey(), fold[fa.familySimple](entry.getValue()));
+}
+[else if fa.multimap]
+[fa.variable] = [guava].collect.ArrayListMultimap.create([expression].size(), 3);
+for (java.util.Map.Entry<[a.wrappedElementType], [a.wrappedSecondaryElementType]> entry : [expression].entries()) {
+  [fa.variable].put(entry.getKey(), fold[fa.familySimple](entry.getValue()));
+}
+[/if]
+[/for]
+[/template]
+
+[template optionalGet Attribute a][if a.jdkSpecializedOptional]getAs[toUpper a.elementType][else]get[/if]()[/template]
+
+[template optionalEmpty Attribute a][a.rawType].[if a.jdkOptional]empty[else if a.fugueOptional or a.javaslangOptional]none[else]absent[/if]()[/template]
+
+[template optionalOf Attribute a][a.rawType].[if not a.optionalAcceptNullable][if a.fugueOptional or a.javaslangOptional]some[else]of[/if][else if a.jdkOptional]ofNullable[else if a.fugueOptional]option[else if a.javaslangOptional]of[else]fromNullable[/if][/template]
+
+[template optionalPresent Attribute a][if a.fugueOptional or a.javaslangOptional]isDefined[else]isPresent[/if]()[/template]
diff --git a/value-processor/src/org/immutables/value/processor/Folds.java b/value-processor/src/org/immutables/value/processor/Folds.java
new file mode 100644
index 0000000..998dd97
--- /dev/null
+++ b/value-processor/src/org/immutables/value/processor/Folds.java
@@ -0,0 +1,263 @@
+package org.immutables.value.processor;
+
+import com.Capella.common.base.Function;
+import com.Capella.common.collect.ImmutableList;
+import com.Capella.common.collect.Lists;
+import com.Capella.common.collect.Sets;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Set;
+import javax.lang.model.element.Element;
+import javax.lang.model.element.ElementKind;
+import javax.lang.model.element.Modifier;
+import javax.lang.model.element.TypeElement;
+import org.immutables.generator.Generator;
+import org.immutables.value.processor.meta.ValueAttribute;
+import org.immutables.value.processor.meta.ValueType;
+
+@Generator.Template
+abstract class Folds extends ValuesTemplate {
+  public final Function<ValueType, FoldModel> foldModel = new Function<ValueType, FoldModel>() {
+    @Override
+    public FoldModel apply(ValueType input) {
+      return FoldModel.from(input);
+    }
+  };
+}
+
+final class FoldModel {
+  public final ValueType enclosing;
+  public final List<FoldFamily> families;
+  public final List<FoldCase> cases;
+  public final String name;
+  public final boolean hasFolds;
+
+  private FoldModel(ValueType enclosing, List<FoldFamily> families, List<FoldCase> cases) {
+    this.enclosing = enclosing;
+    this.families = families;
+    this.cases = cases;
+    this.name = enclosing.typeAbstract().simple() + "Fold";
+    this.hasFolds = !families.isEmpty();
+  }
+
+  static FoldModel from(ValueType enclosing) {
+    List<FoldFamily> families = Lists.newArrayList();
+    Set<ValueType> caseTypes = Sets.newLinkedHashSet();
+    Set<String> discoveredFamilyTypes = Sets.newHashSet();
+
+    for (Element element : enclosing.element.getEnclosedElements()) {
+      if (element instanceof TypeElement && isAbstractFamilyDeclaration((TypeElement) element)) {
+        TypeElement familyElement = (TypeElement) element;
+        String familyType = familyElement.getQualifiedName().toString();
+        List<ValueType> members = membersOf(enclosing, familyType);
+        if (members.size() >= 2 && familyElement.getTypeParameters().isEmpty()) {
+          FoldFamily family = new FoldFamily(
+              familyType,
+              familyElement.getSimpleName().toString(),
+              sortedMostSpecific(members, enclosing));
+          families.add(family);
+          discoveredFamilyTypes.add(familyType);
+          caseTypes.addAll(members);
+        }
+      }
+    }
+
+    for (ValueType implementation : enclosing.nested) {
+      String familyType = implementation.typeAbstract().toString();
+      List<ValueType> members = membersOf(enclosing, familyType);
+      members.remove(implementation);
+      if (!members.isEmpty()
+          && implementation.generics().vars().length == 0
+          && !discoveredFamilyTypes.contains(familyType)) {
+        List<ValueType> includingSelf = membersOf(enclosing, familyType);
+        FoldFamily family = new FoldFamily(
+            familyType,
+            implementation.name(),
+            sortedMostSpecific(includingSelf, enclosing));
+        families.add(family);
+        discoveredFamilyTypes.add(familyType);
+        caseTypes.addAll(includingSelf);
+      }
+    }
+
+    Set<String> foldableFamilyTypes = Sets.newHashSet();
+    for (FoldFamily family : families) {
+      foldableFamilyTypes.add(family.type);
+    }
+
+    List<FoldCase> cases = Lists.newArrayList();
+    for (ValueType type : enclosing.nested) {
+      if (caseTypes.contains(type)) {
+        cases.add(new FoldCase(type, foldAttributes(type, foldableFamilyTypes)));
+      }
+    }
+
+    sortFamilies(families, enclosing);
+    return new FoldModel(enclosing, ImmutableList.copyOf(families), ImmutableList.copyOf(cases));
+  }
+
+  private static boolean isAbstractFamilyDeclaration(TypeElement element) {
+    ElementKind kind = element.getKind();
+    return kind == ElementKind.INTERFACE
+        || kind == ElementKind.ANNOTATION_TYPE
+        || (kind == ElementKind.CLASS && element.getModifiers().contains(Modifier.ABSTRACT));
+  }
+
+  private static List<ValueType> membersOf(ValueType enclosing, String familyType) {
+    return Lists.newArrayList(enclosing.getCases().knownSubtypesOf(familyType));
+  }
+
+  private static List<ValueType> sortedMostSpecific(List<ValueType> types, final ValueType enclosing) {
+    Collections.sort(types, new Comparator<ValueType>() {
+      @Override
+      public int compare(ValueType left, ValueType right) {
+        return Integer.compare(
+            enclosing.getCases().knownSubtypesOf(left.typeAbstract().toString()).size(),
+            enclosing.getCases().knownSubtypesOf(right.typeAbstract().toString()).size());
+      }
+    });
+    return types;
+  }
+
+  private static List<FoldAttribute> foldAttributes(ValueType type, Set<String> familyTypes) {
+    List<FoldAttribute> attributes = Lists.newArrayList();
+    int index = 0;
+    for (ValueAttribute attribute : type.getSettableAttributes()) {
+      FoldShape shape = FoldShape.from(attribute, familyTypes);
+      if (shape != FoldShape.NONE) {
+        attributes.add(new FoldAttribute(
+            attribute,
+            shape,
+            familyType(attribute, shape),
+            "folded" + toUpper(attribute.name()) + index++));
+      }
+    }
+    return attributes;
+  }
+
+  private static String familyType(ValueAttribute attribute, FoldShape shape) {
+    return shape == FoldShape.MAP || shape == FoldShape.MULTIMAP
+        ? attribute.getUnwrappedSecondaryElementType()
+        : attribute.getUnwrappedElementType();
+  }
+
+  private static void sortFamilies(List<FoldFamily> families, final ValueType enclosing) {
+    Collections.sort(families, new Comparator<FoldFamily>() {
+      @Override
+      public int compare(FoldFamily left, FoldFamily right) {
+        return Integer.compare(
+            enclosing.getCases().knownSubtypesOf(right.type).size(),
+            enclosing.getCases().knownSubtypesOf(left.type).size());
+      }
+    });
+  }
+
+  static String toUpper(String name) {
+    return name.isEmpty() ? name : Character.toUpperCase(name.charAt(0)) + name.substring(1);
+  }
+}
+
+final class FoldFamily {
+  public final String type;
+  public final String simple;
+  public final List<ValueType> members;
+
+  FoldFamily(String type, String simple, List<ValueType> members) {
+    this.type = type;
+    this.simple = simple;
+    this.members = ImmutableList.copyOf(members);
+  }
+}
+
+final class FoldCase {
+  public final ValueType type;
+  public final List<FoldAttribute> attributes;
+
+  FoldCase(ValueType type, List<FoldAttribute> attributes) {
+    this.type = type;
+    this.attributes = ImmutableList.copyOf(attributes);
+  }
+}
+
+enum FoldShape {
+  NONE,
+  SINGLE,
+  OPTIONAL,
+  ITERABLE,
+  ARRAY,
+  MAP,
+  MULTIMAP;
+
+  static FoldShape from(ValueAttribute attribute, Set<String> familyTypes) {
+    if (attribute.isMapType()) {
+      if (familyTypes.contains(attribute.getUnwrappedSecondaryElementType())) {
+        return attribute.isMultimapType() ? MULTIMAP : MAP;
+      }
+      return NONE;
+    }
+    if (attribute.isOptionalType()) {
+      return familyTypes.contains(attribute.getUnwrappedElementType()) ? OPTIONAL : NONE;
+    }
+    if (attribute.isArrayType()) {
+      return familyTypes.contains(attribute.getUnwrappedElementType()) ? ARRAY : NONE;
+    }
+    if (attribute.isListType() || attribute.isSetType() || attribute.isMultisetType()) {
+      return familyTypes.contains(attribute.getUnwrappedElementType()) ? ITERABLE : NONE;
+    }
+    return familyTypes.contains(attribute.getUnwrappedElementType()) ? SINGLE : NONE;
+  }
+}
+
+final class FoldAttribute {
+  public final ValueAttribute attribute;
+  public final FoldShape shape;
+  public final String familyType;
+  public final String familySimple;
+  public final String variable;
+  public final String type;
+  public final boolean single;
+  public final boolean optional;
+  public final boolean iterable;
+  public final boolean array;
+  public final boolean map;
+  public final boolean multimap;
+
+  FoldAttribute(ValueAttribute attribute, FoldShape shape, String familyType, String variable) {
+    this.attribute = attribute;
+    this.shape = shape;
+    this.familyType = familyType;
+    this.familySimple = FoldModel.toUpper(simpleName(familyType));
+    this.variable = variable;
+    this.type = type(attribute, shape);
+    this.single = shape == FoldShape.SINGLE;
+    this.optional = shape == FoldShape.OPTIONAL;
+    this.iterable = shape == FoldShape.ITERABLE;
+    this.array = shape == FoldShape.ARRAY;
+    this.map = shape == FoldShape.MAP;
+    this.multimap = shape == FoldShape.MULTIMAP;
+  }
+
+  private static String type(ValueAttribute attribute, FoldShape shape) {
+    switch (shape) {
+      case SINGLE:
+        return "R";
+      case OPTIONAL:
+        return attribute.getRawType() + "<R>";
+      case ITERABLE:
+      case ARRAY:
+        return "java.util.List<R>";
+      case MAP:
+        return "java.util.Map<" + attribute.getWrappedElementType() + ", R>";
+      case MULTIMAP:
+        return "com.Capella.common.collect.Multimap<" + attribute.getWrappedElementType() + ", R>";
+      default:
+        throw new AssertionError(shape);
+    }
+  }
+
+  private static String simpleName(String name) {
+    int indexOfLastDot = name.lastIndexOf('.');
+    return indexOfLastDot < 0 ? name : name.substring(indexOfLastDot + 1);
+  }
+}
