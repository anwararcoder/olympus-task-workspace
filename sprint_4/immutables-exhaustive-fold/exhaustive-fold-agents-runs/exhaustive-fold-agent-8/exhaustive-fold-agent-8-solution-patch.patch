--- /dev/null
+++ b/value-fixture/test/org/immutables/fixture/fold/FoldValuesTest.java
@@ -0,0 +1,78 @@
+package org.immutables.fixture.fold;
+
+import static org.immutables.check.Checkers.check;
+
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import org.junit.Test;
+
+public class FoldValuesTest {
+  @Test
+  public void foldsBottomUpAndMemoizesByIdentity() {
+    FoldValues.Leaf left = ImmutableFoldValues.Leaf.builder().value(1).build();
+    FoldValues.Leaf shared = ImmutableFoldValues.Leaf.builder().value(2).build();
+    FoldValues.Branch branch = ImmutableFoldValues.Branch.builder()
+        .left(left)
+        .right(shared)
+        .addChildren(shared)
+        .addChildren(left)
+        .putNamed("shared", shared)
+        .build();
+
+    CountingFold fold = new CountingFold();
+
+    check(fold.fold(branch)).is(8);
+    check(fold.cases).is(3);
+  }
+
+  @Test
+  public void foldsMostSpecificImplementation() {
+    FoldValues.Weighted weighted = ImmutableFoldValues.Weighted.builder()
+        .left(ImmutableFoldValues.Leaf.builder().value(3).build())
+        .weight(4)
+        .build();
+
+    check(new CountingFold().fold((FoldValues.Branch) weighted)).is(7);
+  }
+
+  private static final class CountingFold implements FoldValuesFold<Integer> {
+    int cases;
+
+    @Override
+    public Integer caseLeaf(FoldValues.Leaf value) {
+      cases++;
+      return value.value();
+    }
+
+    @Override
+    public Integer caseBranch(
+        FoldValues.Branch value,
+        Integer left,
+        Optional<Integer> right,
+        List<Integer> children,
+        Integer nullable,
+        Map<String, Integer> named) {
+      cases++;
+      int sum = left + (right.isPresent() ? right.get() : 0);
+      for (Integer child : children) {
+        sum += child;
+      }
+      for (Integer entry : named.values()) {
+        sum += entry;
+      }
+      return sum + (nullable != null ? nullable : 0);
+    }
+
+    @Override
+    public Integer caseWeighted(
+        FoldValues.Weighted value,
+        Integer left,
+        Optional<Integer> right,
+        List<Integer> children,
+        Integer nullable,
+        Map<String, Integer> named) {
+      return caseBranch(value, left, right, children, nullable, named) + value.weight();
+    }
+  }
+}
diff --git a/value-processor/src/org/immutables/value/processor/Folds.generator b/value-processor/src/org/immutables/value/processor/Folds.generator
