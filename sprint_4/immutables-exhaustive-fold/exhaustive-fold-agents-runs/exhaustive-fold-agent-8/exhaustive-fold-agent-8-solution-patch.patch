+package org.immutables.fixture.fold;
+
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import javax.annotation.Nullable;
+import org.immutables.value.Value;
+
+@Value.Enclosing
+public interface FoldValues {
+  interface Node {}
+
+  @Value.Immutable
+  interface Leaf extends Node {
+    int value();
+  }
+
+  @Value.Immutable
+  interface Branch extends Node {
+    Node left();
+
+    Optional<Node> right();
+
+    List<Node> children();
+
+    @Nullable
+    Node nullable();
+
+    Map<String, Node> named();
+  }
+
+  @SuppressWarnings("immutables")
+  @Value.Immutable
+  interface Weighted extends Branch {
+    int weight();
+  }
+
+  @Value.Immutable
+  interface SingleFamilyIgnored {}
+
+  interface GenericFamily<T> {}
+
+  @Value.Immutable
+  interface GenericLeaf<T> extends GenericFamily<T> {}
+
+  @Value.Immutable
+  interface GenericBranch<T> extends GenericFamily<T> {}
+}
diff --git a/value-fixture/test/org/immutables/fixture/fold/FoldValuesTest.java b/value-fixture/test/org/immutables/fixture/fold/FoldValuesTest.java
