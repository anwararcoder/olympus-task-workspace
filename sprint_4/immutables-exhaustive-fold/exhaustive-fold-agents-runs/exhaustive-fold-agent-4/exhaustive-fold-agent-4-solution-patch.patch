+
+  R [foldCase.methodName]([foldCase.declaredType] value[for contribution in foldCase.contributions], [contribution.parameterType] [contribution.variableName][/for]);
+  [/for]
+  [for family in type.fold.families]
+
+  default R fold([family.type] value) {
+    class Folder {
+      final java.util.IdentityHashMap<java.lang.Object, R> seen = new java.util.IdentityHashMap<java.lang.Object, R>();
+      [for dispatchFamily in type.fold.families]
