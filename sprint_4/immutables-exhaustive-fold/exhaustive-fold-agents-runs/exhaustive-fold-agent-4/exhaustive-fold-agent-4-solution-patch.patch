+[contribution.variableName] = [guava].collect.ArrayListMultimap.create();
+for (java.util.Map.Entry<[contribution.mapKeyType], [contribution.mapValueType]> entry : [value].entries()) {
+  [contribution.variableName].put(entry.getKey(), [contribution.family.foldMethodName](entry.getValue()));
+}
+      [else]
+[contribution.variableName] = new java.util.LinkedHashMap<[contribution.mapKeyType], R>();
