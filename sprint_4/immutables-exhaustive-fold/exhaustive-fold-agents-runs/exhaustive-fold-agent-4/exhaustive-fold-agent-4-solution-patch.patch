diff --git a/value-processor/src/org/immutables/value/processor/meta/FoldStructure.java b/value-processor/src/org/immutables/value/processor/meta/FoldStructure.java
new file mode 100644
index 0000000..b1ea63e
--- /dev/null
+++ b/value-processor/src/org/immutables/value/processor/meta/FoldStructure.java
@@ -0,0 +1,370 @@
+package org.immutables.value.processor.meta;
+
+import com.Capella.common.base.Ascii;
+import com.Capella.common.collect.ImmutableList;
+import com.Capella.common.collect.Lists;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import javax.annotation.Nullable;
+import javax.lang.model.element.Element;
+import javax.lang.model.element.ElementKind;
+import javax.lang.model.element.Modifier;
+import javax.lang.model.element.TypeElement;
+import javax.lang.model.util.ElementFilter;
+
+public final class FoldStructure {
+  private final ValueType enclosingType;
+  private final List<Family> families;
+  private final List<Case> cases;
+
+  public FoldStructure(ValueType enclosingType) {
+    this.enclosingType = enclosingType;
+    if (!enclosingType.kind().isEnclosing()) {
+      this.families = Collections.emptyList();
+      this.cases = Collections.emptyList();
+      return;
+    }
+
+    List<CandidateFamily> candidates = discoverCandidateFamilies(enclosingType);
+    List<Family> receivingFamilies = Lists.newArrayList();
+    Set<ValueType> caseTypes = new LinkedHashSet<>();
+
+    for (CandidateFamily candidate : candidates) {
+      List<ValueType> implementations = implementationsOf(candidate.qualifiedName, enclosingType.nested);
+      boolean implementationFamily = candidate.implementationType != null && implementations.size() > 1;
+      boolean abstractFamily = candidate.implementationType == null && implementations.size() >= 2;
+      if ((implementationFamily || abstractFamily) && !candidate.hasTypeParameters) {
+        Family family = new Family(candidate.element, implementations);
+        receivingFamilies.add(family);
+        caseTypes.addAll(implementations);
+      }
+    }
+
+    this.families = ImmutableList.copyOf(receivingFamilies);
+    this.cases = buildCases(caseTypes, receivingFamilies);
+  }
+
+  public boolean isGenerate() {
+    return !families.isEmpty();
+  }
+
+  public String getInterfaceSimpleName() {
+    return enclosingType.typeAbstract().simple() + "Fold";
+  }
+
+  public String getPackageName() {
+    return enclosingType.typeAbstract().packageOf();
+  }
+
+  public List<Family> getFamilies() {
+    return families;
+  }
+
+  public List<Case> getCases() {
+    return cases;
+  }
+
+  private static List<CandidateFamily> discoverCandidateFamilies(ValueType enclosingType) {
+    Map<String, ValueType> nestedImplementations = new LinkedHashMap<>();
+    for (ValueType nested : enclosingType.nested) {
+      nestedImplementations.put(nested.typeAbstract().toString(), nested);
+    }
+
+    ImmutableList.Builder<CandidateFamily> builder = ImmutableList.builder();
+    for (TypeElement element : ElementFilter.typesIn(enclosingType.element.getEnclosedElements())) {
+      if (isAbstractType(element)) {
+        String qualifiedName = SourceNames.sourceQualifiedNameFor(element);
+        builder.add(new CandidateFamily(
+            element,
+            qualifiedName,
+            !element.getTypeParameters().isEmpty(),
+            nestedImplementations.get(qualifiedName)));
+      }
+    }
+    return builder.build();
+  }
+
+  private static boolean isAbstractType(TypeElement element) {
+    ElementKind kind = element.getKind();
+    return kind.isInterface()
+        || kind == ElementKind.ANNOTATION_TYPE
+        || element.getModifiers().contains(Modifier.ABSTRACT);
+  }
+
+  private static List<ValueType> implementationsOf(String familyName, List<ValueType> implementations) {
+    ImmutableList.Builder<ValueType> builder = ImmutableList.builder();
+    for (ValueType implementation : implementations) {
+      if (isImplementationOf(implementation, familyName)) {
+        builder.add(implementation);
+      }
+    }
+    return builder.build();
+  }
+
+  private static boolean isImplementationOf(ValueType implementation, String familyName) {
+    if (implementation.typeAbstract().toString().equals(familyName)) {
+      return true;
+    }
+    return implementation.getExtendedClassesNames().contains(familyName)
+        || implementation.getImplementedInterfacesNames().contains(familyName);
+  }
+
+  private List<Case> buildCases(Set<ValueType> caseTypes, List<Family> receivingFamilies) {
+    ImmutableList.Builder<Case> builder = ImmutableList.builder();
+    for (ValueType caseType : caseTypes) {
+      builder.add(new Case(caseType, buildContributions(caseType, receivingFamilies)));
+    }
+    return builder.build();
+  }
+
+  private List<Contribution> buildContributions(ValueType caseType, List<Family> receivingFamilies) {
+    ImmutableList.Builder<Contribution> builder = ImmutableList.builder();
+    for (ValueAttribute attribute : caseType.getImplementedAttributes()) {
+      @Nullable Family family = findContributionFamily(attribute, receivingFamilies);
+      if (family != null) {
+        builder.add(new Contribution(attribute, family));
+      }
+    }
+    return builder.build();
+  }
+
+  private @Nullable Family findContributionFamily(ValueAttribute attribute, List<Family> receivingFamilies) {
+    for (Family family : receivingFamilies) {
+      if (attribute.isMapType()) {
+        TypeElement element = attribute.getContainedSecondaryTypeElement();
+        if (element != null && family.matches(element)) {
+          return family;
+        }
+      } else if (attribute.isOptionalType()
+          || attribute.isSuppressedOptional
+          || attribute.isCollectionType()
+          || attribute.isArrayType()) {
+        TypeElement element = attribute.getContainedTypeElement();
+        if (element != null && family.matches(element)) {
+          return family;
+        }
+      } else if (!attribute.isContainerType()) {
+        TypeElement element = attribute.getContainedTypeElement();
+        if (element != null && family.matches(element)) {
+          return family;
+        }
+      }
+    }
+    return null;
+  }
+
+  public static final class Family {
+    private final TypeElement element;
+    private final String qualifiedName;
+    private final String simpleName;
+    private final List<ValueType> implementations;
+
+    Family(TypeElement element, List<ValueType> implementations) {
+      this.element = element;
+      this.qualifiedName = SourceNames.sourceQualifiedNameFor(element);
+      this.simpleName = element.getSimpleName().toString();
+      this.implementations = sortMostSpecificFirst(implementations);
+    }
+
+    public String getType() {
+      return qualifiedName;
+    }
+
+    public String getSimpleName() {
+      return simpleName;
+    }
+
+    public String getFoldMethodName() {
+      return "fold" + simpleName;
+    }
+
+    public List<ValueType> getImplementations() {
+      return implementations;
+    }
+
+    boolean matches(TypeElement element) {
+      return SourceNames.sourceQualifiedNameFor(element).equals(qualifiedName);
+    }
+
+    private static List<ValueType> sortMostSpecificFirst(List<ValueType> implementations) {
+      List<ValueType> sorted = Lists.newArrayList(implementations);
+      Collections.sort(sorted, new Comparator<ValueType>() {
+        @Override
+        public int compare(ValueType left, ValueType right) {
+          return specificity(right, implementations) - specificity(left, implementations);
+        }
+      });
+      return ImmutableList.copyOf(sorted);
+    }
+
+    private static int specificity(ValueType type, List<ValueType> implementations) {
+      int depth = 0;
+      String typeName = type.typeAbstract().toString();
+      for (ValueType possibleSupertype : implementations) {
+        if (possibleSupertype != type && isImplementationOf(type, possibleSupertype.typeAbstract().toString())) {
+          depth++;
+        }
+      }
+      if (type.getExtendedClassesNames().contains(typeName)
+          || type.getImplementedInterfacesNames().contains(typeName)) {
+        depth++;
+      }
+      return depth;
+    }
+  }
+
+  public static final class Case {
+    private final ValueType type;
+    private final List<Contribution> contributions;
+
+    Case(ValueType type, List<Contribution> contributions) {
+      this.type = type;
+      this.contributions = contributions;
+    }
+
+    public ValueType getType() {
+      return type;
+    }
+
+    public String getSimpleName() {
+      return type.name();
+    }
+
+    public String getMethodName() {
+      return "case" + type.name();
+    }
+
+    public String getDeclaredType() {
+      return type.typeAbstract().toString();
+    }
+
+    public String getImplementationClassName() {
+      return type.typeImmutable().toString();
+    }
+
+    public List<Contribution> getContributions() {
+      return contributions;
+    }
+  }
+
+  public static final class Contribution {
+    private final ValueAttribute attribute;
+    private final Family family;
+    private final String variableName;
+
+    Contribution(ValueAttribute attribute, Family family) {
+      this.attribute = attribute;
+      this.family = family;
+      this.variableName = "folded" + Ascii.toUpperCase(attribute.name().substring(0, 1)) + attribute.name().substring(1);
+    }
+
+    public ValueAttribute getAttribute() {
+      return attribute;
+    }
+
+    public Family getFamily() {
+      return family;
+    }
+
+    public String getVariableName() {
+      return variableName;
+    }
+
+    public String getParameterType() {
+      if (isOptionalShape()) {
+        return attribute.getRawType() + "<R>";
+      }
+      if (attribute.isMapType()) {
+        return attribute.isMultimapType()
+            ? UnshadeGuava.qualify("collect.Multimap") + "<" + attribute.getWrappedElementType() + ", R>"
+            : "java.util.Map<" + attribute.getWrappedElementType() + ", R>";
+      }
+      if (attribute.isCollectionType() || attribute.isArrayType()) {
+        return "java.util.List<R>";
+      }
+      return "R";
+    }
+
+
+    public boolean isOptionalShape() {
+      return attribute.isOptionalType() || attribute.isSuppressedOptional;
+    }
+
+    public boolean isMapShape() {
+      return attribute.isMapType();
+    }
+
+    public boolean isIterableShape() {
+      return attribute.isCollectionType() || attribute.isArrayType();
+    }
+
+    public String getOptionalPresent() {
+      return isDefinedOptional() ? "isDefined()" : "isPresent()";
+    }
+
+    public String getOptionalGet() {
+      return "get()";
+    }
+
+    public String getOptionalEmpty() {
+      String rawType = attribute.getRawType();
+      if (rawType.equals("java.util.Optional")) {
+        return rawType + ".empty()";
+      }
+      if (isDefinedOptional()) {
+        return rawType + ".none()";
+      }
+      return rawType + ".absent()";
+    }
+
+    public String getOptionalOf() {
+      String rawType = attribute.getRawType();
+      if (isDefinedOptional()) {
+        return rawType + ".some";
+      }
+      return rawType + ".of";
+    }
+
+    private boolean isDefinedOptional() {
+      String rawType = attribute.getRawType();
+      return rawType.equals("io.atlassian.fugue.Option")
+          || rawType.equals("com.javaslang.control.Option")
+          || rawType.equals("javaslang.control.Option");
+    }
+
+    public String getElementType() {
+      return attribute.getUnwrappedElementType();
+    }
+
+    public String getMapKeyType() {
+      return attribute.getWrappedElementType();
+    }
+
+    public String getMapValueType() {
+      return attribute.getUnwrappedSecondaryElementType();
+    }
+  }
+
+  private static final class CandidateFamily {
+    final TypeElement element;
+    final String qualifiedName;
+    final boolean hasTypeParameters;
+    final @Nullable ValueType implementationType;
+
+    CandidateFamily(
+        TypeElement element,
+        String qualifiedName,
+        boolean hasTypeParameters,
+        @Nullable ValueType implementationType) {
+      this.element = element;
+      this.qualifiedName = qualifiedName;
+      this.hasTypeParameters = hasTypeParameters;
+      this.implementationType = implementationType;
+    }
+  }
+}
