+package org.immutables.fixture.fold;
+
+import com.Capella.common.collect.Multimap;
+import com.Capella.common.collect.Multiset;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import javax.annotation.Nullable;
+import org.immutables.value.Value;
+
+@SuppressWarnings("immutables")
+@Value.Enclosing
+public interface FoldTrees {
+  interface Node {}
+
+  interface Unary extends Node {}
+
+  interface IgnoredSingle {}
+
+  interface IgnoredGeneric<T> {}
+
+  @Value.Immutable
+  interface Leaf extends Node {
+    int value();
+  }
+
+  @Value.Immutable
+  interface FancyLeaf extends Leaf {
+    String label();
+  }
+
+  @Value.Immutable
+  interface Branch extends Node {
+    Node left();
+
+    Optional<Node> right();
+
+    @Nullable Optional<Node> maybe();
+
+    List<Node> children();
+
+    Map<String, Node> named();
+
+    @Nullable Node nullableNode();
+
+    Node[] array();
+
+    Multimap<String, Node> grouped();
+
+    Multiset<Node> bag();
+  }
+
+  @Value.Immutable
+  interface Label extends Node {
+    String label();
+  }
+
+  @Value.Immutable
+  interface Neg extends Unary {
+    Node node();
+  }
+
+  @Value.Immutable
+  interface Abs extends Unary {
+    Node node();
+  }
+
+  @Value.Immutable
+  interface Single extends IgnoredSingle {}
+
+  @Value.Immutable
+  interface GenericImpl extends IgnoredGeneric<String> {}
+}
+
+final class UseFoldTrees {
+  private UseFoldTrees() {}
+
+  static Integer count(FoldTrees.Node node) {
+    return new FoldTreesFold<Integer>() {
+      @Override
+      public Integer caseLeaf(FoldTrees.Leaf value) {
+        return 1;
+      }
+
+      @Override
+      public Integer caseFancyLeaf(FoldTrees.FancyLeaf value) {
+        return 1;
+      }
+
+      @Override
+      public Integer caseBranch(
+          FoldTrees.Branch value,
+          Integer left,
+          Optional<Integer> right,
+          @Nullable Optional<Integer> maybe,
+          List<Integer> children,
+          Map<String, Integer> named,
+          Integer nullableNode,
+          List<Integer> array,
+          Multimap<String, Integer> grouped,
+          List<Integer> bag) {
+        return 1 + left + right.orElse(0) + (maybe != null ? maybe.orElse(0) : 0) + children.size() + named.size()
+            + (nullableNode != null ? nullableNode : 0) + array.size() + grouped.size() + bag.size();
+      }
+
+      @Override
+      public Integer caseLabel(FoldTrees.Label value) {
+        return 1;
+      }
+
+      @Override
+      public Integer caseNeg(FoldTrees.Neg value, Integer node) {
+        return 1 + node;
+      }
+
+      @Override
+      public Integer caseAbs(FoldTrees.Abs value, Integer node) {
+        return 1 + node;
+      }
+    }.fold(node);
+  }
+
+  static Integer countLeafFamily(FoldTrees.Leaf leaf) {
+    return new FoldTreesFold<Integer>() {
+      @Override
+      public Integer caseLeaf(FoldTrees.Leaf value) {
+        return 1;
+      }
+
+      @Override
+      public Integer caseFancyLeaf(FoldTrees.FancyLeaf value) {
+        return 2;
+      }
+
+      @Override
+      public Integer caseBranch(
+          FoldTrees.Branch value,
+          Integer left,
+          Optional<Integer> right,
+          @Nullable Optional<Integer> maybe,
+          List<Integer> children,
+          Map<String, Integer> named,
+          Integer nullableNode,
+          List<Integer> array,
+          Multimap<String, Integer> grouped,
+          List<Integer> bag) {
+        return 0;
+      }
+
+      @Override
+      public Integer caseLabel(FoldTrees.Label value) {
+        return 0;
+      }
+
+      @Override
+      public Integer caseNeg(FoldTrees.Neg value, Integer node) {
+        return 0;
+      }
+
+      @Override
+      public Integer caseAbs(FoldTrees.Abs value, Integer node) {
+        return 0;
+      }
+    }.fold(leaf);
+  }
+}
