+  private @Nullable FoldModel foldModel;
+
+  public FoldModel getFold() {
+    if (foldModel == null) {
+      foldModel = new FoldModel();
+    }
+    return foldModel;
+  }
+
+  public boolean isGenerateFold() {
+    return getFold().is();
+  }
+
+  public final class FoldModel {
+    private final ImmutableList<FoldFamily> families;
+    private final ImmutableList<FoldCase> cases;
+
+    FoldModel() {
+      if ((!kind().isEnclosing() && !constitution.hasEnclosingNonvalue()) || nested.size() < 2) {
+        this.families = ImmutableList.of();
+        this.cases = ImmutableList.of();
+        return;
+      }
+
+      Types types = constitution.protoclass().processing().getTypeUtils();
+      ImmutableList.Builder<FoldFamily> familyBuilder = ImmutableList.builder();
+      LinkedHashMap<String, FoldCase> caseBuilder = new LinkedHashMap<>();
+
+      LinkedHashMap<String, TypeElement> candidates = new LinkedHashMap<>();
+      for (ValueType implementation : nested) {
+        collectFamilyCandidates(types, (TypeElement) implementation.element, candidates);
+      }
+
+      Set<String> generatedFamilies = new LinkedHashSet<>();
+      for (TypeElement candidate : candidates.values()) {
+        ImmutableList<ValueType> implementations = implementationsOf(types, candidate);
+        if (implementations.size() < 2
+            || !candidate.getTypeParameters().isEmpty()
+            || !generatedFamilies.add(candidate.getQualifiedName().toString())) {
+          continue;
+        }
+
+        FoldFamily family = new FoldFamily(candidate, implementations);
+        familyBuilder.add(family);
+        for (ValueType implementation : implementations) {
+          TypeElement implementationElement = (TypeElement) implementation.element;
+          String implementationName = implementationElement.getQualifiedName().toString();
+          if (!caseBuilder.containsKey(implementationName)) {
+            caseBuilder.put(implementationName, new FoldCase(implementation));
+          }
+        }
+      }
+
+      this.families = familyBuilder.build();
+      ImmutableList.Builder<FoldCase> orderedCases = ImmutableList.builder();
+      for (FoldCase foldCase : caseBuilder.values()) {
+        orderedCases.add(foldCase.withAttributes(foldAttributes(foldCase.implementation)));
+      }
+      this.cases = orderMostSpecificFirst(types, orderedCases.build());
+    }
+
+    public boolean is() {
+      return !families.isEmpty();
+    }
+
+    public String name() {
+      return element.getSimpleName().toString() + "Fold";
+    }
+
+    public List<FoldFamily> families() {
+      return families;
+    }
+
+    public List<FoldCase> cases() {
+      return cases;
+    }
+
+    private boolean isFoldFamilyCandidate(TypeElement candidate) {
+      if (!CachingElements.equals(candidate.getEnclosingElement(), element)) {
+        return false;
+      }
+      if (candidate.getKind() == ElementKind.INTERFACE) {
+        return true;
+      }
+      return candidate.getKind() == ElementKind.CLASS
+          && candidate.getModifiers().contains(Modifier.ABSTRACT);
+    }
+
+    private void collectFamilyCandidates(Types types, TypeElement candidate, Map<String, TypeElement> candidates) {
+      if (isFoldFamilyCandidate(candidate)) {
+        candidates.put(candidate.getQualifiedName().toString(), candidate);
+      }
+      for (TypeMirror supertype : types.directSupertypes(candidate.asType())) {
+        if (supertype.getKind() == TypeKind.DECLARED) {
+          Element superElement = ((DeclaredType) supertype).asElement();
+          if (superElement instanceof TypeElement) {
+            collectFamilyCandidates(types, (TypeElement) superElement, candidates);
+          }
+        }
+      }
+    }
+
+    private ImmutableList<ValueType> implementationsOf(Types types, TypeElement family) {
+      ImmutableList.Builder<ValueType> builder = ImmutableList.builder();
+      TypeMirror familyType = types.erasure(family.asType());
+      for (ValueType implementation : nested) {
+        TypeElement implementationElement = (TypeElement) implementation.element;
+        if (types.isAssignable(types.erasure(implementationElement.asType()), familyType)) {
+          builder.add(implementation);
+        }
+      }
+      return builder.build();
+    }
+
+    private ImmutableList<FoldCase> orderMostSpecificFirst(Types types, ImmutableList<FoldCase> unordered) {
+      List<FoldCase> ordered = Lists.newArrayList(unordered);
+      Collections.sort(ordered, (left, right) -> {
+        TypeMirror leftType = types.erasure(((TypeElement) left.implementation.element).asType());
+        TypeMirror rightType = types.erasure(((TypeElement) right.implementation.element).asType());
+        boolean leftAssignableFromRight = types.isAssignable(rightType, leftType);
+        boolean rightAssignableFromLeft = types.isAssignable(leftType, rightType);
+        if (leftAssignableFromRight && !rightAssignableFromLeft) {
+          return 1;
+        }
+        if (rightAssignableFromLeft && !leftAssignableFromRight) {
+          return -1;
+        }
+        return 0;
+      });
+      return ImmutableList.copyOf(ordered);
+    }
+
+    private ImmutableList<FoldAttribute> foldAttributes(ValueType implementation) {
+      ImmutableList.Builder<FoldAttribute> builder = ImmutableList.builder();
+      for (ValueAttribute attribute : implementation.getAllAccessibleAttributes()) {
+        FoldAttribute foldAttribute = foldAttribute(attribute);
+        if (foldAttribute != null) {
+          builder.add(foldAttribute);
+        }
+      }
+      return builder.build();
+    }
+
+    private @Nullable FoldAttribute foldAttribute(ValueAttribute attribute) {
+      AttributeTypeKind kind = attribute.typeKind();
+      if (kind.isRegular()) {
+        return attributeFor(attribute, FoldShape.VALUE, attribute.returnType);
+      }
+      if (kind.isOptionalKind() && !kind.isOptionalSpecializedJdk()) {
+        return attributeFor(attribute, FoldShape.OPTIONAL, firstTypeArgument(attribute.returnType));
+      }
+      if (kind.isCollectionKind() || kind.isMultisetKind()) {
+        return attributeFor(attribute, FoldShape.ITERABLE, firstTypeArgument(attribute.returnType));
+      }
+      if (kind.isArray()) {
+        return attributeFor(attribute, FoldShape.ARRAY, arrayComponent(attribute.returnType));
+      }
+      if (kind.isPlainMapKind() || kind.isSortedMap()) {
+        return attributeFor(attribute, FoldShape.MAP, secondTypeArgument(attribute.returnType));
+      }
+      if (kind.isMultimapKind()) {
+        return attributeFor(attribute, FoldShape.MULTIMAP, secondTypeArgument(attribute.returnType));
+      }
+      return null;
+    }
+
+    private @Nullable FoldAttribute attributeFor(
+        ValueAttribute attribute,
+        FoldShape shape,
+        @Nullable TypeMirror foldedType) {
+      FoldFamily family = familyFor(foldedType);
+      if (family == null) {
+        return null;
+      }
+      return new FoldAttribute(attribute, family, shape);
+    }
+
+    private @Nullable FoldFamily familyFor(@Nullable TypeMirror typeMirror) {
+      if (typeMirror == null) {
+        return null;
+      }
+      Types types = constitution.protoclass().processing().getTypeUtils();
+      TypeMirror erased = types.erasure(typeMirror);
+      for (FoldFamily family : families) {
+        if (types.isSameType(erased, types.erasure(family.element.asType()))) {
+          return family;
+        }
+      }
+      return null;
+    }
+
+    private @Nullable TypeMirror firstTypeArgument(TypeMirror typeMirror) {
+      if (typeMirror.getKind() == TypeKind.DECLARED) {
+        List<? extends TypeMirror> arguments = ((DeclaredType) typeMirror).getTypeArguments();
+        if (!arguments.isEmpty()) {
+          return arguments.get(0);
+        }
+      }
+      return null;
+    }
+
+    private @Nullable TypeMirror secondTypeArgument(TypeMirror typeMirror) {
+      if (typeMirror.getKind() == TypeKind.DECLARED) {
+        List<? extends TypeMirror> arguments = ((DeclaredType) typeMirror).getTypeArguments();
+        if (arguments.size() > 1) {
+          return arguments.get(1);
+        }
+      }
+      return null;
+    }
+
+    private @Nullable TypeMirror arrayComponent(TypeMirror typeMirror) {
+      if (typeMirror.getKind() == TypeKind.ARRAY) {
+        return ((javax.lang.model.type.ArrayType) typeMirror).getComponentType();
+      }
+      return null;
+    }
+  }
+
+  public enum FoldShape {
+    VALUE,
+    OPTIONAL,
+    ITERABLE,
+    ARRAY,
+    MAP,
+    MULTIMAP
+  }
+
+  public final class FoldFamily {
+    final TypeElement element;
+    private final ImmutableList<ValueType> implementations;
+
+    FoldFamily(TypeElement element, ImmutableList<ValueType> implementations) {
+      this.element = element;
+      this.implementations = implementations;
+    }
+
+    public String type() {
+      return element.getQualifiedName().toString();
+    }
+
+    public String name() {
+      return element.getSimpleName().toString();
+    }
+
+    public List<ValueType> implementations() {
+      return implementations;
+    }
+
+    public List<FoldCase> cases() {
+      ImmutableList.Builder<FoldCase> builder = ImmutableList.builder();
+      for (FoldCase foldCase : getFold().cases) {
+        if (foldCase.belongsTo(this)) {
+          builder.add(foldCase);
+        }
+      }
+      return builder.build();
+    }
+  }
+
+  public final class FoldCase {
+    final ValueType implementation;
+    private final ImmutableList<FoldAttribute> attributes;
+
+    FoldCase(ValueType implementation) {
+      this(implementation, ImmutableList.of());
+    }
+
+    FoldCase(ValueType implementation, ImmutableList<FoldAttribute> attributes) {
+      this.implementation = implementation;
+      this.attributes = attributes;
+    }
+
+    FoldCase withAttributes(ImmutableList<FoldAttribute> attributes) {
+      return new FoldCase(implementation, attributes);
+    }
+
+    public ValueType implementation() {
+      return implementation;
+    }
+
+    public String name() {
+      return implementation.element.getSimpleName().toString();
+    }
+
+    public String method() {
+      return "case" + name();
+    }
+
+    public String caseType() {
+      return implementation.typeAbstract().toString();
+    }
+
+    public String implementationType() {
+      return implementation.typeImmutable().absoluteRaw();
+    }
+
+    public String typeParameters() {
+      return implementation.generics().def();
+    }
+
+    public List<FoldAttribute> attributes() {
+      return attributes;
+    }
+
+    public boolean needsUncheckedCast() {
+      return !implementation.generics().def().isEmpty();
+    }
+
+    public boolean belongsTo(FoldFamily family) {
+      for (ValueType familyImplementation : family.implementations) {
+        if (CachingElements.equals(familyImplementation.element, implementation.element)) {
+          return true;
+        }
+      }
+      return false;
+    }
+  }
+
+  public final class FoldAttribute {
+    private final ValueAttribute attribute;
+    private final FoldFamily family;
+    private final FoldShape shape;
+
+    FoldAttribute(ValueAttribute attribute, FoldFamily family, FoldShape shape) {
+      this.attribute = attribute;
+      this.family = family;
+      this.shape = shape;
+    }
+
+    public String name() {
+      return attribute.name() + "Folded";
+    }
+
+    public String accessor() {
+      return attribute.names.get;
+    }
+
+    public String type() {
+      switch (shape) {
+      case VALUE:
+        return "R";
+      case OPTIONAL:
+        return attribute.getRawType() + "<R>";
+      case ITERABLE:
+      case ARRAY:
+        return "java.util.List<R>";
+      case MAP:
+        return "java.util.Map<" + attribute.firstTypeParameter() + ", R>";
+      case MULTIMAP:
+        return UnshadeGuava.qualify("collect.Multimap") + "<" + attribute.firstTypeParameter() + ", R>";
+      default:
+        throw new AssertionError(shape);
+      }
+    }
+
+    public String initializer() {
+      String source = "value." + accessor() + "()";
+      StringBuilder builder = new StringBuilder();
+      appendInitializer(builder, source, false);
+      return builder.toString();
+    }
+
+    private void appendInitializer(StringBuilder builder, String source, boolean skipNullableGuard) {
+      if (attribute.isNullable() && !skipNullableGuard) {
+        builder.append(type()).append(' ').append(name()).append(";\n")
+            .append("if (").append(source).append(" == null) {\n")
+            .append("  ").append(name()).append(" = null;\n")
+            .append("} else {\n");
+        appendNonNullableInitializer(builder, source, "  ", false);
+        builder.append("}\n");
+      } else {
+        appendNonNullableInitializer(builder, source, "", true);
+      }
+    }
+
+    private void appendNonNullableInitializer(StringBuilder builder, String source, String indent, boolean declare) {
+      switch (shape) {
+      case VALUE:
+        builder.append(indent).append(declare ? type() + " " : "").append(name())
+            .append(" = fold").append(family.name()).append('(').append(source).append(");\n");
+        break;
+      case OPTIONAL:
+        appendOptionalInitializer(builder, source, indent, declare);
+        break;
+      case ITERABLE:
+        builder.append(indent).append(declare ? type() + " " : "").append(name())
+            .append(" = new java.util.ArrayList<R>();\n")
+            .append(indent).append("for (").append(family.type()).append(" element : ").append(source).append(") {\n")
+            .append(indent).append("  ").append(name()).append(".add(fold").append(family.name()).append("(element));\n")
+            .append(indent).append("}\n");
+        break;
+      case ARRAY:
+        builder.append(indent).append(declare ? type() + " " : "").append(name())
+            .append(" = new java.util.ArrayList<R>(").append(source).append(".length);\n")
+            .append(indent).append("for (").append(family.type()).append(" element : ").append(source).append(") {\n")
+            .append(indent).append("  ").append(name()).append(".add(fold").append(family.name()).append("(element));\n")
+            .append(indent).append("}\n");
+        break;
+      case MAP:
+        builder.append(indent).append(declare ? type() + " " : "").append(name())
+            .append(" = new java.util.LinkedHashMap<").append(attribute.firstTypeParameter()).append(", R>();\n")
+            .append(indent).append("for (java.util.Map.Entry<").append(attribute.firstTypeParameter()).append(", ")
+            .append(family.type()).append("> entry : ").append(source).append(".entrySet()) {\n")
+            .append(indent).append("  ").append(name()).append(".put(entry.getKey(), fold")
+            .append(family.name()).append("(entry.getValue()));\n")
+            .append(indent).append("}\n");
+        break;
+      case MULTIMAP:
+        builder.append(indent).append(declare ? type() + " " : "").append(name())
