+package org.immutables.fixture.nested;
+
+import com.Capella.common.collect.Multimap;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.concurrent.atomic.AtomicInteger;
+import org.junit.jupiter.api.Test;
+import static org.immutables.check.Checkers.check;
+
+public class FoldedTest {
+  @Test
+  public void foldsEnclosedFamiliesBottomUpOncePerIdentity() {
+    Folded.Lit one = ImmutableFolded.Lit.builder().number(1).build();
+    Folded.Lit two = ImmutableFolded.Lit.builder().number(2).build();
+    Folded.Box<String> box = ImmutableFolded.Box.<String>builder().item("x").build();
+
+    Folded.Add add = ImmutableFolded.Add.builder()
+        .left(one)
+        .right(two)
+        .addTerms(one)
+        .addRepeated(one)
+        .addRepeated(one)
+        .putNamed("one", one)
+        .putGrouped("one", one)
+        .array(new Folded.Expr[] {two, box})
+        .build();
+
+    AtomicInteger litCases = new AtomicInteger();
+    AtomicInteger boxCases = new AtomicInteger();
+
+    FoldedFold<String> fold = new FoldedFold<String>() {
+      @Override
+      public String caseLit(Folded.Lit value) {
+        litCases.incrementAndGet();
+        return Integer.toString(value.number());
+      }
+
+      @Override
+      public String caseAdd(
+          Folded.Add value,
+          String leftFolded,
+          Optional<String> rightFolded,
+          List<String> termsFolded,
+          List<String> repeatedFolded,
+          Map<String, String> namedFolded,
+          Multimap<String, String> groupedFolded,
+          String maybeNullFolded,
+          List<String> arrayFolded,
+          Optional<String> nextFolded) {
+        return "add(" + leftFolded + "," + rightFolded.get() + "," + termsFolded
+            + "," + repeatedFolded + "," + namedFolded + "," + groupedFolded
+            + "," + maybeNullFolded + "," + arrayFolded + "," + nextFolded + ")";
+      }
+
+      @Override
+      public String caseMul(
+          Folded.Mul value,
+          String leftFolded,
+          Optional<String> rightFolded,
+          List<String> termsFolded,
+          List<String> repeatedFolded,
+          Map<String, String> namedFolded,
+          Multimap<String, String> groupedFolded,
+          String maybeNullFolded,
+          List<String> arrayFolded,
+          Optional<String> nextFolded) {
+        return "mul(" + leftFolded + ")";
+      }
+
+      @Override
+      public <T> String caseBox(Folded.Box<T> value) {
+        boxCases.incrementAndGet();
+        return "box(" + value.item() + ")";
+      }
+    };
+
+    check(fold.foldExpr(add)).is("add(1,2,[1],[1, 1],{one=1},{one=[1]},null,[2, box(x)],Optional.empty)");
+    check(litCases.get()).is(2);
+    check(boxCases.get()).is(1);
+  }
+
+  @Test
+  public void foldsMostSpecificImplementationForSubfamilies() {
+    Folded.Lit one = ImmutableFolded.Lit.builder().number(1).build();
+    Folded.Mul mul = ImmutableFolded.Mul.builder()
+        .left(one)
+        .array(new Folded.Expr[0])
+        .factor(3)
+        .build();
+
+    FoldedFold<String> fold = new FoldedFold<String>() {
+      @Override
+      public String caseLit(Folded.Lit value) {
+        return "lit";
+      }
+
+      @Override
+      public String caseAdd(
+          Folded.Add value,
+          String leftFolded,
+          Optional<String> rightFolded,
+          List<String> termsFolded,
+          List<String> repeatedFolded,
+          Map<String, String> namedFolded,
+          Multimap<String, String> groupedFolded,
+          String maybeNullFolded,
+          List<String> arrayFolded,
+          Optional<String> nextFolded) {
+        return "add";
+      }
+
+      @Override
+      public String caseMul(
+          Folded.Mul value,
+          String leftFolded,
+          Optional<String> rightFolded,
+          List<String> termsFolded,
+          List<String> repeatedFolded,
+          Map<String, String> namedFolded,
+          Multimap<String, String> groupedFolded,
+          String maybeNullFolded,
+          List<String> arrayFolded,
+          Optional<String> nextFolded) {
+        return "mul(" + leftFolded + ")";
+      }
+
+      @Override
+      public <T> String caseBox(Folded.Box<T> value) {
+        return "box";
+      }
+    };
+
+    check(fold.foldAdd(mul)).is("mul(lit)");
+  }
+}
