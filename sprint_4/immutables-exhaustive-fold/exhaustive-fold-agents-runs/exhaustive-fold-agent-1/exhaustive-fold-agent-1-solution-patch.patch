+[template generateFold Type type]
+[packageWhenTopLevel type true]
+
+/**
+ * Exhaustive fold over immutable value families enclosed by {@link [type.typeAbstract.relativeRaw]}.
+ */
+[annotationsWhenTopLevel type true]
+public interface [type.fold.name]<R> {
+[for c in type.fold.cases]
+  [c.typeParameters] R [c.method]([c.caseType] value[for a in c.attributes], [a.type] [a.name][/for]);
+[/for]
+
+[for f in type.fold.families]
+  default R fold[f.name]([f.type] value) {
+    final java.util.IdentityHashMap<Object, R> folded = new java.util.IdentityHashMap<Object, R>();
+    class FoldDispatcher {
+[for localFamily in type.fold.families]
+      R fold[localFamily.name]([localFamily.type] value) {
+        if (folded.containsKey(value)) {
+          return folded.get(value);
+        }
+[for c in localFamily.cases]
+        if (value instanceof [c.implementationType]) {
+          [c.implementationType] typed = ([c.implementationType]) value;
+          R result = fold(typed);
+          folded.put(value, result);
+          return result;
+        }
+[/for]
+        throw new IllegalArgumentException("Unsupported fold value: " + value);
+      }
+[/for]
+[for c in type.fold.cases]
+      R fold([c.implementationType] value) {
+[for a in c.attributes]
+[a.initializer]
+[/for]
+        return [if c.needsUncheckedCast](R) [/if][c.method](value[for a in c.attributes], [a.name][/for]);
+      }
+[/for]
+    }
+    return new FoldDispatcher().fold[f.name](value);
+  }
+[/for]
+}
+[/template]
