diff --git a/value-processor/src/org/immutables/value/processor/meta/FoldStructure.java b/value-processor/src/org/immutables/value/processor/meta/FoldStructure.java
new file mode 100644
index 0000000..1778ad4
--- /dev/null
+++ b/value-processor/src/org/immutables/value/processor/meta/FoldStructure.java
@@ -0,0 +1,317 @@
+package org.immutables.value.processor.meta;
+
+import com.Capella.common.base.Ascii;
+import com.Capella.common.collect.ImmutableList;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import javax.lang.model.element.Element;
+import javax.lang.model.element.ElementKind;
+import javax.lang.model.element.Parameterizable;
+import javax.lang.model.element.TypeElement;
+import javax.lang.model.type.DeclaredType;
+import javax.lang.model.type.TypeKind;
+import javax.lang.model.type.TypeMirror;
+
+public final class FoldStructure {
+  public final String interfaceSimpleName;
+  public final ImmutableList<Family> families;
+  public final ImmutableList<Case> cases;
+
+  FoldStructure(ValueType enclosingType) {
+    this.interfaceSimpleName = enclosingType.typeAbstract().simple() + "Fold";
+
+    ImmutableList<ValueType> implementations = ImmutableList.copyOf(enclosingType.nested);
+    Map<String, Family> familyBuilder = new LinkedHashMap<>();
+    for (TypeElement candidate : directNestedTypes(enclosingType.element)) {
+      if (hasTypeParameters(candidate)) {
+        continue;
+      }
+      String typeName = candidate.getQualifiedName().toString();
+      List<ValueType> members = new ArrayList<>();
+      for (ValueType implementation : implementations) {
+        if (implementation.element instanceof TypeElement
+            && isSourceSubtype((TypeElement) implementation.element, typeName)) {
+          members.add(implementation);
+        }
+      }
+      if (members.size() >= 2 || isExtendedImplementation(typeName, members)) {
+        sortMostSpecificFirst(members);
+        familyBuilder.put(typeName, new Family(typeName, candidate.getSimpleName().toString(), members));
+      }
+    }
+
+    Map<ValueType, Case> caseBuilder = new LinkedHashMap<>();
+    for (Family family : familyBuilder.values()) {
+      for (ValueType implementation : family.implementationTypes) {
+        if (!caseBuilder.containsKey(implementation)) {
+          caseBuilder.put(implementation, new Case(implementation));
+        }
+      }
+    }
+
+    for (Case foldCase : caseBuilder.values()) {
+      foldCase.collectParameters(familyBuilder);
+    }
+    for (Family family : familyBuilder.values()) {
+      family.bindCases(caseBuilder);
+    }
+
+    this.families = ImmutableList.copyOf(familyBuilder.values());
+    this.cases = ImmutableList.copyOf(caseBuilder.values());
+  }
+
+  private static List<TypeElement> directNestedTypes(Element element) {
+    List<TypeElement> types = new ArrayList<>();
+    for (Element enclosed : element.getEnclosedElements()) {
+      ElementKind kind = enclosed.getKind();
+      if (kind.isClass() || kind.isInterface()) {
+        types.add((TypeElement) enclosed);
+      }
+    }
+    return types;
+  }
+
+  private static boolean hasTypeParameters(TypeElement element) {
+    return element instanceof Parameterizable
+        && !((Parameterizable) element).getTypeParameters().isEmpty();
+  }
+
+  private static boolean isExtendedImplementation(String typeName, List<ValueType> members) {
+    boolean hasSelf = false;
+    boolean hasOther = false;
+    for (ValueType member : members) {
+      if (member.typeAbstract().absoluteRaw().equals(typeName)) {
+        hasSelf = true;
+      } else {
+        hasOther = true;
+      }
+    }
+    return hasSelf && hasOther;
+  }
+
+  private static void sortMostSpecificFirst(List<ValueType> members) {
+    Collections.sort(members, new Comparator<ValueType>() {
+      @Override
+      public int compare(ValueType left, ValueType right) {
+        if (left == right) {
+          return 0;
+        }
+        if (isSubtype(left, right)) {
+          return -1;
+        }
+        if (isSubtype(right, left)) {
+          return 1;
+        }
+        return 0;
+      }
+    });
+  }
+
+  private static boolean isSubtype(ValueType subtype, ValueType supertype) {
+    return subtype != supertype
+        && isSourceSubtype((TypeElement) subtype.element, supertype.typeAbstract().absoluteRaw());
+  }
+
+  private static boolean isSourceSubtype(TypeElement type, String expectedTypeName) {
+    if (type.getQualifiedName().contentEquals(expectedTypeName)) {
+      return true;
+    }
+    for (TypeMirror interfaceMirror : type.getInterfaces()) {
+      if (isMirrorSubtype(interfaceMirror, expectedTypeName)) {
+        return true;
+      }
+    }
+    TypeMirror superclass = type.getSuperclass();
+    return superclass.getKind() != TypeKind.NONE
+        && isMirrorSubtype(superclass, expectedTypeName);
+  }
+
+  private static boolean isMirrorSubtype(TypeMirror mirror, String expectedTypeName) {
+    if (mirror.getKind() != TypeKind.DECLARED) {
+      return false;
+    }
+    Element element = ((DeclaredType) mirror).asElement();
+    if (!(element instanceof TypeElement)) {
+      return false;
+    }
+    return isSourceSubtype((TypeElement) element, expectedTypeName);
+  }
+
+  public boolean isPresent() {
+    return !families.isEmpty();
+  }
+
+  public static final class Family {
+    public final String type;
+    public final String simpleName;
+    private final ImmutableList<ValueType> implementationTypes;
+    public ImmutableList<Case> implementations = ImmutableList.of();
+
+    Family(String type, String simpleName, Iterable<ValueType> implementations) {
+      this.type = type;
+      this.simpleName = simpleName;
+      this.implementationTypes = ImmutableList.copyOf(implementations);
+    }
+
+    void bindCases(Map<ValueType, Case> casesByType) {
+      ImmutableList.Builder<Case> builder = ImmutableList.builder();
+      for (ValueType implementationType : implementationTypes) {
+        builder.add(casesByType.get(implementationType));
+      }
+      this.implementations = builder.build();
+    }
+
+    public String methodName() {
+      return "fold" + simpleName;
+    }
+  }
+
+  public static final class Case {
+    public final ValueType implementation;
+    public final String name;
+    public final String type;
+    private final List<Parameter> parameterBuilder = new ArrayList<>();
+
+    Case(ValueType implementation) {
+      this.implementation = implementation;
+      this.name = implementation.name();
+      this.type = implementation.typeAbstract().absoluteRaw();
+    }
+
+    private void collectParameters(Map<String, Family> families) {
+      for (ValueAttribute attribute : implementation.getSettableAttributes()) {
+        Parameter parameter = Parameter.from(attribute, families, name);
+        if (parameter != null) {
+          parameterBuilder.add(parameter);
+        }
+      }
+    }
+
+    public ImmutableList<Parameter> parameters() {
+      return ImmutableList.copyOf(parameterBuilder);
+    }
+
+    public String methodName() {
+      return "case" + name;
+    }
+
+    public String foldMethodName() {
+      return "fold" + name;
+    }
+  }
+
+  public static final class Parameter {
+    enum Shape {
+      PLAIN,
+      OPTIONAL,
+      LIST,
+      ARRAY,
+      MAP,
+      MULTIMAP
+    }
+
+    public final ValueAttribute attribute;
+    public final Family family;
+    public final Shape shape;
+    public final String name;
+    public final String type;
+    public final String valueType;
+    public final String keyType;
+    public final String helperName;
+
+    private Parameter(ValueAttribute attribute, Family family, Shape shape, String caseName) {
+      this.attribute = attribute;
+      this.family = family;
+      this.shape = shape;
+      this.name = attribute.name();
+      this.valueType = family.type;
+      this.keyType = attribute.isMapType() ? attribute.getWrappedElementType() : "";
+      this.type = parameterType(attribute, shape, family);
+      this.helperName = "fold" + caseName + Ascii.toUpperCase(name.charAt(0)) + name.substring(1);
+    }
+
+    static Parameter from(ValueAttribute attribute, Map<String, Family> families, String caseName) {
+      if (attribute.isMapType()) {
+        Family family = families.get(raw(attribute.getUnwrappedSecondaryElementType()));
+        if (family != null) {
+          return new Parameter(attribute, family,
+              attribute.isMultimapType() ? Shape.MULTIMAP : Shape.MAP, caseName);
+        }
+        return null;
+      }
+      if (attribute.isOptionalType()) {
+        Family family = families.get(raw(attribute.getUnwrappedElementType()));
+        return family != null ? new Parameter(attribute, family, Shape.OPTIONAL, caseName) : null;
+      }
+      if (attribute.isArrayType()) {
+        Family family = families.get(raw(attribute.getUnwrappedElementType()));
+        return family != null ? new Parameter(attribute, family, Shape.ARRAY, caseName) : null;
+      }
+      if (attribute.isCollectionType()) {
+        Family family = families.get(raw(attribute.getUnwrappedElementType()));
+        return family != null ? new Parameter(attribute, family, Shape.LIST, caseName) : null;
+      }
+      Family family = families.get(raw(attribute.getUnwrappedElementType()));
+      return family != null ? new Parameter(attribute, family, Shape.PLAIN, caseName) : null;
+    }
+
+    private static String parameterType(ValueAttribute attribute, Shape shape, Family family) {
+      switch (shape) {
+      case PLAIN:
+        return "R";
+      case OPTIONAL:
+        return attribute.getRawType() + "<R>";
+      case LIST:
+      case ARRAY:
+        return "java.util.List<R>";
+      case MAP:
+        return "java.util.Map<" + attribute.getWrappedElementType() + ", R>";
+      case MULTIMAP:
+        return UnshadeGuava.prefix() + ".collect.Multimap<" + attribute.getWrappedElementType() + ", R>";
+      default:
+        throw new AssertionError(shape);
+      }
+    }
+
+    private static String raw(String type) {
+      int generics = type.indexOf('<');
+      if (generics >= 0) {
+        type = type.substring(0, generics);
+      }
+      int annotation = type.lastIndexOf(' ');
+      if (annotation >= 0) {
+        type = type.substring(annotation + 1);
+      }
+      return type;
+    }
+
+    public boolean isPlain() {
+      return shape == Shape.PLAIN;
+    }
+
+    public boolean isOptional() {
+      return shape == Shape.OPTIONAL;
+    }
+
+    public boolean isList() {
+      return shape == Shape.LIST;
+    }
+
+    public boolean isArray() {
+      return shape == Shape.ARRAY;
+    }
+
+    public boolean isMap() {
+      return shape == Shape.MAP;
+    }
+
+    public boolean isMultimap() {
+      return shape == Shape.MULTIMAP;
+    }
+
+  }
+}
