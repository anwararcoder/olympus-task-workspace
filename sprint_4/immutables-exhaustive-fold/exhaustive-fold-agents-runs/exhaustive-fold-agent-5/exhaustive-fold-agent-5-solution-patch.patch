+package org.immutables.fixture.fold;
+
+import com.Capella.common.collect.Multimap;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import javax.annotation.Nullable;
+import org.immutables.value.Value;
+
+@Value.Enclosing
+public abstract class Folded {
+  public interface Expr {}
+
+  @Value.Immutable
+  public interface Lit extends Expr {
+    int value();
+  }
+
+  @Value.Immutable
+  public interface Add extends Expr {
+    Expr left();
+
+    Expr right();
+
+    Optional<Expr> maybe();
+
+    List<Expr> terms();
+
+    Expr[] array();
+
+    Map<String, Expr> named();
+
+    Multimap<String, Expr> grouped();
+
+    @Nullable
+    Expr nullableChild();
+
+    @Nullable
+    List<Expr> nullableTerms();
+  }
+
+  @Value.Immutable
+  public interface SpecialAdd extends Add {}
+
+  @Value.Immutable
+  public interface Single {}
+
+  @Value.Immutable
+  public interface Generic<T> extends Expr {
+    T value();
+  }
+}
