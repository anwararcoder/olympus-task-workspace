@@ -0,0 +1,102 @@
+package org.immutables.fixture.fold;
+
+import com.Capella.common.collect.ArrayListMultimap;
+import java.util.Arrays;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import org.junit.jupiter.api.Test;
+import static org.immutables.check.Checkers.check;
+
+public class FoldedTest {
+  @Test
+  public void foldsBottomUpWithSupportedShapesAndIdentityCache() {
+    Folded.Lit one = ImmutableFolded.Lit.builder().value(1).build();
+    Folded.Lit two = ImmutableFolded.Lit.builder().value(2).build();
+
+    ArrayListMultimap<String, Folded.Expr> grouped = ArrayListMultimap.create();
+    grouped.put("a", one);
+    grouped.put("a", two);
+    grouped.put("a", one);
+
+    Folded.SpecialAdd root = ImmutableFolded.SpecialAdd.builder()
+        .left(one)
+        .right(one)
+        .maybe(Optional.of(two))
+        .addTerms(one)
+        .addTerms(two)
+        .array(one, two)
+        .putNamed("first", one)
+        .putNamed("second", two)
+        .putAllGrouped(grouped)
+        .nullableChild(null)
+        .nullableTerms(null)
+        .build();
+
+    CountingFold fold = new CountingFold();
+    String result = fold.foldExpr(root);
+
+    check(result).is("special(1,1,Optional[2],[1, 2],[1, 2],{first=1, second=2},{a=[1, 2, 1]},null,null)");
+    check(fold.litCases).is(2);
+    check(fold.addCases).is(0);
+    check(fold.specialCases).is(1);
+  }
+
+  private static final class CountingFold implements FoldedFold<String> {
+    int litCases;
+    int addCases;
+    int specialCases;
+
+    @Override
+    public String caseLit(Folded.Lit value) {
+      litCases++;
+      return Integer.toString(value.value());
+    }
+
+    @Override
+    public String caseAdd(
+        Folded.Add value,
+        String left,
+        String right,
+        Optional<String> maybe,
+        List<String> terms,
+        List<String> array,
+        Map<String, String> named,
+        com.Capella.common.collect.Multimap<String, String> grouped,
+        String nullableChild,
+        List<String> nullableTerms) {
+      addCases++;
+      return "add";
+    }
+
+    @Override
+    public String caseSpecialAdd(
+        Folded.SpecialAdd value,
+        String left,
+        String right,
+        Optional<String> maybe,
+        List<String> terms,
+        List<String> array,
+        Map<String, String> named,
+        com.Capella.common.collect.Multimap<String, String> grouped,
+        String nullableChild,
+        List<String> nullableTerms) {
+      specialCases++;
+      return "special(" + String.join(",", Arrays.asList(
+          left,
+          right,
+          maybe.toString(),
+          terms.toString(),
+          array.toString(),
+          named.toString(),
+          grouped.asMap().toString(),
+          String.valueOf(nullableChild),
+          String.valueOf(nullableTerms))) + ")";
+    }
+
+    @Override
+    public String caseGeneric(Folded.Generic value) {
+      return String.valueOf(value.value());
+    }
+  }
+}
