+   WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+   See the License for the specific language governing permissions and
+   limitations under the License.
+ */
+package org.immutables.value.processor.meta;
+
+import com.google.common.collect.ImmutableList;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import javax.lang.model.element.Element;
+import javax.lang.model.element.ElementKind;
+import javax.lang.model.element.Modifier;
+import javax.lang.model.element.TypeElement;
+
+public final class FoldModel {
+  public final ImmutableList<Root> roots;
+  public final ImmutableList<Case> cases;
+
+  private FoldModel(ImmutableList<Root> roots, ImmutableList<Case> cases) {
+    this.roots = roots;
+    this.cases = cases;
+  }
+
+  public boolean isEligible() {
+    return !roots.isEmpty();
+  }
+
+  public static final class Root {
+    public final String type;
+    public final String simple;
+    public final ImmutableList<Case> dispatch;
+
+    Root(String type, ImmutableList<Case> dispatch) {
+      this.type = type;
+      this.simple = simple(type);
+      this.dispatch = dispatch;
+    }
+  }
+
+  public static final class Case {
+    public final String valueParam;
+    public final String instanceOf;
+    public final String simple;
+    public final ImmutableList<Child> children;
+
+    Case(ValueType value, ImmutableList<Child> children) {
+      String abstractType = value.typeAbstract().toString();
+      int firstArgument = abstractType.indexOf('<');
+      String raw = firstArgument < 0 ? abstractType : abstractType.substring(0, firstArgument);
+      this.simple = simple(raw);
+      this.instanceOf = raw;
+      this.valueParam = value.generics().isEmpty()
+          ? abstractType
+          : raw + wildcards(value.generics().vars().length);
+      this.children = children;
+    }
+  }
+
+  private enum Shape {
+    DIRECT,
+    OPTIONAL,
+    LIST,
+    ARRAY,
+    MAP,
+    MULTIMAP
+  }
+
+  public static final class Child {
+    public final ValueAttribute attribute;
+    public final String paramType;
+    public final String elementType;
+    public final String keyType;
+    public final String memberSimple;
+    public final String paramName;
+    public final boolean direct;
+    public final boolean optional;
+    public final boolean list;
+    public final boolean array;
+    public final boolean map;
+    public final boolean multimap;
+    public final boolean nullable;
+
+    private Child(
+        ValueAttribute attribute,
+        Shape shape,
+        String paramType,
+        String elementType,
+        String keyType) {
+      this.attribute = attribute;
+      this.paramType = paramType;
+      this.elementType = elementType;
+      this.keyType = keyType;
+      this.memberSimple = simple(elementType);
+      this.paramName = attribute.name().equals("value") ? "valueResult" : attribute.name();
+      this.direct = shape == Shape.DIRECT;
+      this.optional = shape == Shape.OPTIONAL;
+      this.list = shape == Shape.LIST;
+      this.array = shape == Shape.ARRAY;
+      this.map = shape == Shape.MAP;
+      this.multimap = shape == Shape.MULTIMAP;
+      this.nullable = shape == Shape.DIRECT && attribute.isNullable();
+    }
+
+    static Child direct(ValueAttribute attribute, String element) {
+      return new Child(attribute, Shape.DIRECT, "R", element, "");
+    }
+
+    static Child optional(ValueAttribute attribute, String element) {
+      return new Child(attribute, Shape.OPTIONAL, attribute.getRawType() + "<R>", element, "");
+    }
+
+    static Child list(ValueAttribute attribute, String element) {
+      return new Child(attribute, Shape.LIST, "java.util.List<R>", element, "");
+    }
+
+    static Child array(ValueAttribute attribute, String element) {
+      return new Child(attribute, Shape.ARRAY, "java.util.List<R>", element, "");
+    }
+
+    static Child map(ValueAttribute attribute, String key, String element) {
+      return new Child(attribute, Shape.MAP, "java.util.Map<" + key + ", R>", element, key);
+    }
+
+    static Child multimap(ValueAttribute attribute, String key, String element) {
+      return new Child(attribute, Shape.MULTIMAP,
+          UnshadeGuava.qualify("collect.Multimap") + "<" + key + ", R>", element, key);
+    }
+  }
+
+  static FoldModel of(ValueType enclosing) {
+    Map<String, TypeElement> abstractMembers = new LinkedHashMap<>();
+    for (Element enclosed : enclosing.element.getEnclosedElements()) {
+      if (enclosed.getKind() == ElementKind.INTERFACE || enclosed.getKind() == ElementKind.CLASS) {
+        TypeElement member = (TypeElement) enclosed;
+        boolean abstractMember = member.getKind() == ElementKind.INTERFACE
+            || member.getModifiers().contains(Modifier.ABSTRACT);
+        if (abstractMember && !member.getTypeParameters().isEmpty()) {
+          continue;
+        }
+        if (abstractMember && !isImmutableValue(enclosing, member)) {
+          abstractMembers.put(member.getQualifiedName().toString(), member);
+        }
+      }
+    }
+    if (abstractMembers.isEmpty()) {
+      return new FoldModel(ImmutableList.<Root>of(), ImmutableList.<Case>of());
+    }
+
+    Map<String, List<ValueType>> implsByRoot = new LinkedHashMap<>();
+    Set<String> foldEntryNames = new LinkedHashSet<>();
+    Map<ValueType, Set<String>> supertypeNames = new LinkedHashMap<>();
+    for (ValueType nested : enclosing.nested) {
+      supertypeNames.put(nested, supertypeNamesOf(nested));
+    }
+
+    for (ValueType nested : enclosing.nested) {
+      for (String supertypeName : supertypeNames.get(nested)) {
+        if (abstractMembers.containsKey(supertypeName)) {
+          List<ValueType> impls = implsByRoot.get(supertypeName);
+          if (impls == null) {
+            impls = new ArrayList<>();
+            implsByRoot.put(supertypeName, impls);
+          }
+          impls.add(nested);
+        }
+      }
+    }
+
+    Map<String, List<ValueType>> eligible = new LinkedHashMap<>();
+    for (Map.Entry<String, List<ValueType>> entry : implsByRoot.entrySet()) {
+      if (entry.getValue().size() >= 2) {
+        eligible.put(entry.getKey(), entry.getValue());
+        foldEntryNames.add(entry.getKey());
+      }
+    }
+    for (ValueType extended : enclosing.nested) {
+      if (!extended.generics().isEmpty()) {
+        continue;
+      }
+      String extendedQualified = ((TypeElement) extended.element).getQualifiedName().toString();
+      List<ValueType> descendants = new ArrayList<>();
+      for (ValueType nested : enclosing.nested) {
+        if (nested != extended
+            && nested.generics().isEmpty()
+            && supertypeNames.get(nested).contains(extendedQualified)) {
+          descendants.add(nested);
+        }
+      }
+      if (!descendants.isEmpty()) {
+        descendants.add(extended);
+        String extendedName = extended.typeAbstract().toString();
+        eligible.put(extendedName, descendants);
+        foldEntryNames.add(extendedName);
+      }
+    }
+    if (eligible.isEmpty()) {
+      return new FoldModel(ImmutableList.<Root>of(), ImmutableList.<Case>of());
+    }
+
+    Map<String, Case> caseByName = new LinkedHashMap<>();
+    for (List<ValueType> impls : eligible.values()) {
+      for (ValueType impl : impls) {
+        String name = impl.typeAbstract().toString();
+        if (!caseByName.containsKey(name)) {
+          caseByName.put(name, new Case(impl, childrenOf(impl, foldEntryNames)));
+        }
+      }
+    }
+
+    ImmutableList.Builder<Root> roots = ImmutableList.builder();
+    for (Map.Entry<String, List<ValueType>> entry : eligible.entrySet()) {
+      List<Case> dispatch = new ArrayList<>();
+      for (ValueType impl : mostSpecificFirst(entry.getValue(), supertypeNames)) {
+        dispatch.add(caseByName.get(impl.typeAbstract().toString()));
+      }
+      roots.add(new Root(entry.getKey(), ImmutableList.copyOf(dispatch)));
+    }
+    return new FoldModel(roots.build(), ImmutableList.copyOf(caseByName.values()));
+  }
+
+  private static boolean isImmutableValue(ValueType enclosing, TypeElement member) {
+    for (ValueType nested : enclosing.nested) {
+      if (nested.element.equals(member)) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  private static Set<String> supertypeNamesOf(ValueType impl) {
+    Set<String> names = new LinkedHashSet<>();
+    names.addAll(impl.getExtendedClassesNames());
+    names.addAll(impl.getImplementedInterfacesNames());
+    return names;
+  }
+
+  private static List<ValueType> mostSpecificFirst(
+      List<ValueType> impls, Map<ValueType, Set<String>> supertypeNames) {
+    List<ValueType> remaining = new ArrayList<>(impls);
+    List<ValueType> ordered = new ArrayList<>(impls.size());
+    while (!remaining.isEmpty()) {
+      ValueType picked = null;
+      for (ValueType candidate : remaining) {
+        boolean extendedByOther = false;
+        for (ValueType other : remaining) {
+          if (other != candidate
+              && supertypeNames.get(other).contains(candidate.typeAbstract().toString())) {
+            extendedByOther = true;
+            break;
+          }
+        }
+        if (!extendedByOther) {
+          picked = candidate;
+          break;
+        }
+      }
+      if (picked == null) {
+        picked = remaining.get(0);
+      }
+      remaining.remove(picked);
+      ordered.add(picked);
+    }
+    return ordered;
+  }
+
+  private static ImmutableList<Child> childrenOf(ValueType impl, Set<String> foldEntryNames) {
+    ImmutableList.Builder<Child> children = ImmutableList.builder();
+    for (ValueAttribute attribute : impl.attributes) {
+      if (attribute.isOptionalType() && foldEntryNames.contains(attribute.getWrappedElementType())) {
+        String element = attribute.getWrappedElementType();
+        children.add(Child.optional(attribute, element));
+      } else if (foldsAsList(attribute) && foldEntryNames.contains(attribute.getWrappedElementType())) {
+        String element = attribute.getWrappedElementType();
+        children.add(Child.list(attribute, element));
+      } else if (attribute.isArrayType() && foldEntryNames.contains(attribute.getUnwrappedElementType())) {
+        String element = attribute.getUnwrappedElementType();
+        children.add(Child.array(attribute, element));
+      } else if (attribute.isMultimapType()
+          && foldEntryNames.contains(attribute.getWrappedSecondaryElementType())) {
+        String element = attribute.getWrappedSecondaryElementType();
+        String key = attribute.getWrappedElementType();
+        children.add(Child.multimap(attribute, key, element));
+      } else if (attribute.isMapType()
+          && foldEntryNames.contains(attribute.getWrappedSecondaryElementType())) {
+        String element = attribute.getWrappedSecondaryElementType();
+        String key = attribute.getWrappedElementType();
+        children.add(Child.map(attribute, key, element));
+      } else if (attribute.typeKind().isRegular() && foldEntryNames.contains(attribute.getType())) {
+        String element = attribute.getType();
+        children.add(Child.direct(attribute, element));
+      }
+    }
+    return children.build();
+  }
+
+  private static boolean foldsAsList(ValueAttribute attribute) {
+    return attribute.isListType()
+        || attribute.isSetType()
+        || attribute.isSortedSetType()
+        || attribute.isMultisetType();
+  }
+
+  private static String simple(String qualifiedName) {
+    int lastDot = qualifiedName.lastIndexOf('.');
+    return lastDot < 0 ? qualifiedName : qualifiedName.substring(lastDot + 1);
+  }
+
+  private static String wildcards(int count) {
+    StringBuilder builder = new StringBuilder("<");
+    for (int i = 0; i < count; i++) {
+      builder.append(i == 0 ? "?" : ", ?");
+    }
+    return builder.append('>').toString();
+  }
+}
