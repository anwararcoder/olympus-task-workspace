+[template public generate]
+  [for type in values.values if type.generateFold]
+[for String foldClassname = ((toUpper type.name) 'Fold')]
+[output.java type.package foldClassname type.element]
+[type.sourceHeader]
+[generateFold type foldClassname]
+[/output.java]
+[/for]
+  [/for]
+[/template]
+
+[template generateFold Type type String foldClassname]
+[if type.package]
+package [type.package];
+[/if]
+
+[if type.generateSuppressAllWarnings]@SuppressWarnings("all")[/if]
+[if type allowsClasspathAnnotation 'javax.annotation.processing.Generated']
+@javax.annotation.processing.Generated("org.immutables.processor.ProxyProcessor")
+[/if]
+[if type allowsClasspathAnnotation 'org.immutables.value.Generated']
+@org.immutables.value.Generated(from = "[type.typeAbstract.relativeRaw]", generator = "Folds")
+[/if]
+[type.typeValue.access]interface [foldClassname]<R> {
+  [for c in type.foldModel.cases]
+
+  R case[c.simple]([c.valueParam] value[for ch in c.children], [ch.paramType] [ch.paramName][/for]);
+  [/for]
+  [for root in type.foldModel.roots]
+
+  default R fold([root.type] value) {
+    return fold[root.simple](this, new java.util.IdentityHashMap<Object, R>(), value);
+  }
+  [/for]
+  [for root in type.foldModel.roots]
+
+  static <R> R fold[root.simple]([foldClassname]<R> fold, java.util.IdentityHashMap<Object, R> results, [root.type] value) {
+    java.util.Objects.requireNonNull(value, "value");
+    [for c in root.dispatch]
+    if (value instanceof [c.instanceOf]) {
+      return fold[c.simple]Case(fold, results, ([c.valueParam]) value);
+    }
+    [/for]
+    throw new IllegalArgumentException(value.getClass().getName());
+  }
+  [/for]
+  [for c in type.foldModel.cases]
+
+  static <R> R fold[c.simple]Case([foldClassname]<R> fold, java.util.IdentityHashMap<Object, R> results, [c.valueParam] value) {
+    if (results.containsKey(value)) {
+      return results.get(value);
+    }
+    [for ch in c.children]
+      [if ch.direct]
+        [if ch.nullable]
+    [ch.elementType] [ch.attribute.name]Held = value.[ch.attribute.names.get]();
+    R [ch.attribute.name]Folded = [ch.attribute.name]Held == null ? null : fold[ch.memberSimple](fold, results, [ch.attribute.name]Held);
+        [else]
+    R [ch.attribute.name]Folded = fold[ch.memberSimple](fold, results, value.[ch.attribute.names.get]());
+        [/if]
+      [else if ch.optional]
+    [ch.attribute.type] [ch.attribute.name]Held = value.[ch.attribute.names.get]();
+    [ch.paramType] [ch.attribute.name]Folded = [ch.attribute.name]Held.[optionalPresent ch.attribute]
+        ? [ch.attribute.rawType].<R>[optionalOf ch.attribute](fold[ch.memberSimple](fold, results, [ch.attribute.name]Held.[optionalGet ch.attribute]))
+        : [ch.attribute.rawType].<R>[optionalEmpty ch.attribute]();
+      [else if ch.list or ch.array]
+    java.util.List<R> [ch.attribute.name]Folded = [if ch.attribute.nullable]value.[ch.attribute.names.get]() == null ? null : [/if]new java.util.ArrayList<R>();
+    [if ch.attribute.nullable]if ([ch.attribute.name]Folded != null) [/if]for ([ch.elementType] element : value.[ch.attribute.names.get]()) {
+      [ch.attribute.name]Folded.add(fold[ch.memberSimple](fold, results, element));
+    }
+      [else if ch.multimap]
+    [guava].collect.Multimap<[ch.keyType], R> [ch.attribute.name]Folded = [if ch.attribute.nullable]value.[ch.attribute.names.get]() == null ? null : [/if][guava].collect.ArrayListMultimap.<[ch.keyType], R>create();
+    [if ch.attribute.nullable]if ([ch.attribute.name]Folded != null) [/if]for (java.util.Map.Entry<[ch.keyType], [ch.elementType]> entry : value.[ch.attribute.names.get]().entries()) {
+      [ch.attribute.name]Folded.put(entry.getKey(), fold[ch.memberSimple](fold, results, entry.getValue()));
+    }
+      [else if ch.map]
+    java.util.Map<[ch.keyType], R> [ch.attribute.name]Folded = [if ch.attribute.nullable]value.[ch.attribute.names.get]() == null ? null : [/if]new java.util.LinkedHashMap<[ch.keyType], R>();
+    [if ch.attribute.nullable]if ([ch.attribute.name]Folded != null) [/if]for (java.util.Map.Entry<[ch.keyType], [ch.elementType]> entry : value.[ch.attribute.names.get]().entrySet()) {
+      [ch.attribute.name]Folded.put(entry.getKey(), fold[ch.memberSimple](fold, results, entry.getValue()));
+    }
+      [/if]
+    [/for]
+    R result = fold.case[c.simple](value[for ch in c.children], [ch.attribute.name]Folded[/for]);
+    results.put(value, result);
+    return result;
+  }
+  [/for]
+}
+[/template]
+
+[template optionalPresent Attribute a][if a.fugueOptional or a.javaslangOptional]isDefined()[else]isPresent()[/if][/template]
+
+[template optionalGet Attribute a]get()[/template]
+
+[template optionalOf Attribute a][if a.fugueOptional or a.javaslangOptional]some[else]of[/if][/template]
+
+[template optionalEmpty Attribute a][if a.jdkOptional]empty[else if a.fugueOptional or a.javaslangOptional]none[else]absent[/if][/template]
