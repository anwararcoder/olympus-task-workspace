   }
 
+  @Nullable
+  private FoldModel foldModel;
+
+  public FoldModel getFoldModel() {
+    if (foldModel == null) {
+      foldModel = FoldModel.of(this);
+    }
+    return foldModel;
+  }
+
+  public boolean isGenerateFold() {
+    return kind().isEnclosing() && getFoldModel().isEligible();
+  }
+
   public boolean isGenerateJdkOnly() {
     return style().jdkOnly() || noGuavaInClasspath() || isGenerateJdk9();
   }
