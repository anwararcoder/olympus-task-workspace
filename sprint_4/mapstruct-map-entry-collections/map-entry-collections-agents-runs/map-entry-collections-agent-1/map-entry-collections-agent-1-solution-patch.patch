+/*
+ * Copyright MapStruct Authors.
+ *
+ * Licensed under the Apache License version 2.0, available at http://www.apache.org/licenses/LICENSE-2.0
+ */
+package org.mapstruct.ap.test.collection.entrymapping;
+
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+import org.mapstruct.ap.testutil.ProcessorTest;
+import org.mapstruct.ap.testutil.WithClasses;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+@WithClasses({ EntryMapper.class, SourceValue.class, FlattenedValue.class, EntryContainer.class })
+public class EntryMappingTest {
+
+    @ProcessorTest
+    public void shouldMapMapEntriesToIterableAndArrayInIterationOrder() {
+        Map<String, SourceValue> source = new LinkedHashMap<>();
+        source.put( "first", new SourceValue( "one" ) );
+        source.put( "second", new SourceValue( "two" ) );
+
+        List<FlattenedValue> list = EntryMapper.INSTANCE.toList( source );
+        FlattenedValue[] array = EntryMapper.INSTANCE.toArray( source );
+
+        assertThat( list ).extracting( FlattenedValue::getKey ).containsExactly( "first", "second" );
+        assertThat( list ).extracting( FlattenedValue::getName ).containsExactly( "one", "two" );
+        assertThat( array ).extracting( FlattenedValue::getKey ).containsExactly( "first", "second" );
+    }
+
+    @ProcessorTest
+    public void shouldMapIterableElementsToEntriesAndMapProperties() {
+        FlattenedValue first = flattenedValue( "first", "one" );
+        FlattenedValue second = flattenedValue( "second", "two" );
+
+        Map<String, SourceValue> result = EntryMapper.INSTANCE.toMap( Arrays.asList( first, second ) );
+        Map<String, SourceValue> arrayResult = EntryMapper.INSTANCE.toMap( new FlattenedValue[] { first, second } );
+
+        assertThat( result ).containsOnlyKeys( "first", "second" );
+        assertThat( result.get( "first" ).getName() ).isEqualTo( "one" );
+        assertThat( arrayResult ).containsOnlyKeys( "first", "second" );
+
+        EntryContainer container = new EntryContainer();
+        Map<String, SourceValue> source = new LinkedHashMap<>();
+        source.put( "first", new SourceValue( "one" ) );
+        container.setSource( source );
+        assertThat( EntryMapper.INSTANCE.mapContainer( container ).getTarget() )
+            .extracting( FlattenedValue::getKey )
+            .containsExactly( "first" );
+    }
+
+    @ProcessorTest
+    public void shouldUseIterableQualifierForLowerBoundedMap() {
+        Map<? super String, ? super SourceValue> result = EntryMapper.INSTANCE.toLowerBoundedMap(
+            Arrays.asList( flattenedValue( "first", "one" ) )
+        );
+
+        assertThat( result ).containsKey( "first" );
+        assertThat( ( (SourceValue) result.get( "first" ) ).getName() ).isEqualTo( "one" );
+    }
+
+    private static FlattenedValue flattenedValue(String key, String name) {
+        FlattenedValue value = new FlattenedValue();
+        value.setKey( key );
+        value.setName( name );
+        return value;
+    }
+}
