+/*
+ * Copyright MapStruct Authors.
+ *
+ * Licensed under the Apache License version 2.0, available at http://www.apache.org/licenses/LICENSE-2.0
+ */
+package org.mapstruct.ap.test.collection.entrymapping;
+
+import java.util.AbstractMap;
+import java.util.List;
+import java.util.Map;
+
+import org.mapstruct.IterableMapping;
+import org.mapstruct.Mapper;
+import org.mapstruct.Mapping;
+import org.mapstruct.Named;
+import org.mapstruct.factory.Mappers;
+
+@Mapper
+public interface EntryMapper {
+
+    EntryMapper INSTANCE = Mappers.getMapper( EntryMapper.class );
+
+    List<FlattenedValue> toList(Map<String, SourceValue> source);
+
+    FlattenedValue[] toArray(Map<String, SourceValue> source);
+
+    Map<String, SourceValue> toMap(List<FlattenedValue> source);
+
+    Map<String, SourceValue> toMap(FlattenedValue[] source);
+
+    @IterableMapping(qualifiedByName = "lowerBoundedEntry")
+    Map<? super String, ? super SourceValue> toLowerBoundedMap(List<FlattenedValue> source);
+
+    @Mapping(target = "target", source = "source")
+    EntryContainer mapContainer(EntryContainer source);
+
+    @Mapping(target = "key", source = "key")
+    @Mapping(target = "name", source = "value.name")
+    FlattenedValue fromEntry(Map.Entry<String, SourceValue> source);
+
+    @Mapping(target = "key", source = "key")
+    @Mapping(target = "value.name", source = "name")
+    Map.Entry<String, SourceValue> toEntry(FlattenedValue source);
+
+    @Named("lowerBoundedEntry")
+    default AbstractMap.SimpleEntry<String, SourceValue> toLowerBoundedEntry(FlattenedValue source) {
+        return new AbstractMap.SimpleEntry<>( source.getKey(), new SourceValue( source.getName() ) );
+    }
+}
