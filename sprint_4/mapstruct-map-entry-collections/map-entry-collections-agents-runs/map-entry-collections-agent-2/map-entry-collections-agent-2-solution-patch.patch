+ */
+package org.mapstruct.ap.test.collection.mapentry;
+
+import java.util.AbstractMap;
+import java.util.List;
+import java.util.Map;
+
+import org.mapstruct.IterableMapping;
+import org.mapstruct.Mapper;
+import org.mapstruct.Mapping;
+import org.mapstruct.Named;
+import org.mapstruct.factory.Mappers;
+
+@Mapper
+public interface MapEntryMapper {
+
+    MapEntryMapper INSTANCE = Mappers.getMapper( MapEntryMapper.class );
+
+    List<EntryDto> toList(Map<String, String> source);
+
+    EntryDto[] toArray(Map<String, String> source);
+
+    Map<String, String> toMap(List<Source> source);
+
+    Map<String, String> toMap(Source[] source);
+
+    @IterableMapping(qualifiedByName = "upperCaseEntry")
+    Map<? super String, ? super String> toLowerBoundedMap(List<Source> source);
+
+    TargetContainer toTargetContainer(SourceContainer source);
+
+    EntryDto toEntryDto(Map.Entry<String, String> source);
+
+    @Mapping(target = "key", source = "id")
+    @Mapping(target = "value", source = "value")
+    Map.Entry<String, String> toEntry(Source source);
+
+    @Named("upperCaseEntry")
+    default AbstractMap.SimpleEntry<String, String> toUpperCaseEntry(Source source) {
+        return new AbstractMap.SimpleEntry<>( source.getId().toUpperCase(), source.getValue().toUpperCase() );
+    }
+}
