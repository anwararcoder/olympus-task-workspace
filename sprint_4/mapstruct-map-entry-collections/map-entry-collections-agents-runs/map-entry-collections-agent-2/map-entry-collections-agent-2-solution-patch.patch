@@ -0,0 +1,73 @@
+/*
+ * Copyright MapStruct Authors.
+ *
+ * Licensed under the Apache License version 2.0, available at http://www.apache.org/licenses/LICENSE-2.0
+ */
+package org.mapstruct.ap.test.collection.mapentry;
+
+import java.util.AbstractMap;
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+import org.mapstruct.ap.testutil.ProcessorTest;
+import org.mapstruct.ap.testutil.WithClasses;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+@WithClasses({ MapEntryMapper.class, Source.class, EntryDto.class, SourceContainer.class, TargetContainer.class })
+class MapEntryMappingTest {
+
+    @ProcessorTest
+    void shouldMapMapEntriesToIterableAndArrayInIterationOrder() {
+        Map<String, String> source = new LinkedHashMap<>();
+        source.put( "first", "one" );
+        source.put( "second", "two" );
+
+        List<EntryDto> list = MapEntryMapper.INSTANCE.toList( source );
+        EntryDto[] array = MapEntryMapper.INSTANCE.toArray( source );
+
+        assertThat( list ).extracting( EntryDto::getKey ).containsExactly( "first", "second" );
+        assertThat( list ).extracting( EntryDto::getValue ).containsExactly( "one", "two" );
+        assertThat( array ).extracting( EntryDto::getKey ).containsExactly( "first", "second" );
+    }
+
+    @ProcessorTest
+    void shouldMapIterableAndArrayElementsToMapEntries() {
+        List<Source> source = Arrays.asList( new Source( "first", "one" ), new Source( "second", "two" ) );
+
+        assertThat( MapEntryMapper.INSTANCE.toMap( source ) )
+            .containsExactly(
+                new AbstractMap.SimpleEntry<>( "first", "one" ),
+                new AbstractMap.SimpleEntry<>( "second", "two" )
+            );
+        assertThat( MapEntryMapper.INSTANCE.toMap( source.toArray( new Source[0] ) ) )
+            .containsExactly(
+                new AbstractMap.SimpleEntry<>( "first", "one" ),
+                new AbstractMap.SimpleEntry<>( "second", "two" )
+            );
+    }
+
+    @ProcessorTest
+    void shouldApplyIterableQualifierAndSupportLowerBoundedMap() {
+        List<Source> source = Arrays.asList( new Source( "first", "one" ) );
+
+        Map<? super String, ? super String> result = MapEntryMapper.INSTANCE.toLowerBoundedMap( source );
+
+        assertThat( result ).containsEntry( "FIRST", "ONE" );
+    }
+
+    @ProcessorTest
+    void shouldForgeMapEntryContainerPropertyMappings() {
+        SourceContainer source = new SourceContainer();
+        Map<String, String> entries = new LinkedHashMap<>();
+        entries.put( "first", "one" );
+        source.setEntries( entries );
+
+        TargetContainer target = MapEntryMapper.INSTANCE.toTargetContainer( source );
+
+        assertThat( target.getEntries() ).extracting( EntryDto::getKey ).containsExactly( "first" );
+        assertThat( target.getEntries() ).extracting( EntryDto::getValue ).containsExactly( "one" );
+    }
+}
