+import java.util.AbstractMap;
+import java.util.List;
+import java.util.Map;
+
+import org.mapstruct.IterableMapping;
+import org.mapstruct.Mapper;
+import org.mapstruct.Named;
+import org.mapstruct.factory.Mappers;
+
+@Mapper
+public interface QualifiedMapEntryMapper {
+
+    QualifiedMapEntryMapper INSTANCE = Mappers.getMapper( QualifiedMapEntryMapper.class );
+
+    @IterableMapping(qualifiedByName = "selectedFlatten")
+    List<FlattenedSchedule> flatten(Map<String, Schedule> source);
+
+    @IterableMapping(qualifiedByName = "selectedEntry")
+    Map<String, Schedule> expand(List<FlattenedSchedule> source);
+
+    @Named("selectedFlatten")
+    default FlattenedSchedule selectedFlatten(Map.Entry<String, Schedule> entry) {
+        FlattenedSchedule flattened = new FlattenedSchedule();
+        flattened.setDay( "selected-" + entry.getKey() );
+        flattened.setTime( entry.getValue().getTime() );
+        return flattened;
+    }
+
+    @Named("otherFlatten")
+    default FlattenedSchedule otherFlatten(Map.Entry<String, Schedule> entry) {
+        FlattenedSchedule flattened = new FlattenedSchedule();
+        flattened.setDay( "other-" + entry.getKey() );
+        return flattened;
+    }
+
+    @Named("selectedEntry")
+    default Map.Entry<String, Schedule> selectedEntry(FlattenedSchedule source) {
+        return new AbstractMap.SimpleEntry<>( source.getDay().substring( 9 ), schedule( source ) );
+    }
+
+    @Named("otherEntry")
+    default Map.Entry<String, Schedule> otherEntry(FlattenedSchedule source) {
+        return new AbstractMap.SimpleEntry<>( "other", schedule( source ) );
+    }
+
+    default Schedule schedule(FlattenedSchedule source) {
+        Schedule schedule = new Schedule();
+        schedule.setTime( source.getTime() );
+        return schedule;
+    }
+}
