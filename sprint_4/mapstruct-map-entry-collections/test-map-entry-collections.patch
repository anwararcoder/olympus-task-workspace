diff --git a/processor/src/test/java/org/mapstruct/ap/test/mapping/mapentry/c4e2/MapEntryCollectionsC4e2Test.java b/processor/src/test/java/org/mapstruct/ap/test/mapping/mapentry/c4e2/MapEntryCollectionsC4e2Test.java
