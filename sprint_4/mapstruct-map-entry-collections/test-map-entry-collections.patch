index 00000000..4776f0d8
--- /dev/null
+++ b/processor/src/test/java/org/mapstruct/ap/test/mapping/mapentry/c4e2/MapEntryCollectionsC4e2Test.java
@@ -0,0 +1,255 @@
+/*
+ * Copyright MapStruct Authors.
+ *
+ * Licensed under the Apache License version 2.0, available at http://www.apache.org/licenses/LICENSE-2.0
+ */
+package org.mapstruct.ap.test.mapping.mapentry.c4e2;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+import org.mapstruct.ap.testutil.ProcessorTest;
+import org.mapstruct.ap.testutil.WithClasses;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+@WithClasses({
+    Schedule.class,
+    FlattenedSchedule.class,
+    MapToIterableMapper.class,
+    IterableToMapMapper.class,
+    ReturnDefaultMapEntryMapper.class,
+    ScheduleBook.class,
+    FlattenedScheduleBook.class,
+    ScheduleBookMapper.class,
+    ScheduleMap.class,
+    FlattenedScheduleList.class,
+    SubtypeMapEntryMapper.class,
+    ConversionMapEntryMapper.class,
+    QualifiedMapEntryMapper.class,
+    BaseMapEntryMapperbaa4fa.class,
+    InheritedMapEntryMapper.class,
+    EntryBoundaryMapper517e60.class
+})
+public class MapEntryCollectionsC4e2Test {
+
+    @ProcessorTest
+    public void mapsEachMapEntryToAnIterableElement() {
+        Schedule monday = schedule( "11:00", "office" );
+        Schedule friday = schedule( "16:00", "remote" );
+        Map<String, Schedule> schedules = new LinkedHashMap<>();
+        schedules.put( "monday", monday );
+        schedules.put( "friday", friday );
+
+        List<FlattenedSchedule> result = MapToIterableMapper.INSTANCE.map( schedules );
+
+        assertThat( result ).extracting( FlattenedSchedule::getDay )
+            .containsExactly( "monday", "friday" );
+        assertThat( result ).extracting( FlattenedSchedule::getTime )
+            .containsExactly( "11:00", "16:00" );
+        assertThat( result ).extracting( FlattenedSchedule::getKind )
+            .containsExactly( "office", "remote" );
+    }
+
+    @ProcessorTest
+    public void mapsEachIterableElementThroughAMapEntry() {
+        FlattenedSchedule monday = flattened( "monday", "11:00", "office" );
+        FlattenedSchedule friday = flattened( "friday", "16:00", "remote" );
+
+        Map<String, Schedule> result = IterableToMapMapper.INSTANCE.map( Arrays.asList( monday, friday ) );
+
+        assertThat( result ).containsOnlyKeys( "monday", "friday" );
+        assertThat( result.get( "monday" ).getTime() ).isEqualTo( "11:00" );
+        assertThat( result.get( "monday" ).getKind() ).isEqualTo( "office" );
+        assertThat( result.get( "friday" ).getTime() ).isEqualTo( "16:00" );
+        assertThat( result.get( "friday" ).getKind() ).isEqualTo( "remote" );
+    }
+
+    @ProcessorTest
+    public void mapsAnOrdinaryObjectToAnEntry() {
+        FlattenedSchedule source = flattened( "monday", "11:00", "office" );
+
+        Map.Entry<String, Schedule> result = IterableToMapMapper.INSTANCE.mapEntry( source );
+
+        assertThat( result.getKey() ).isEqualTo( "monday" );
+        assertThat( result.getValue().getTime() ).isEqualTo( "11:00" );
+        assertThat( result.getValue().getKind() ).isEqualTo( "office" );
+    }
+
+    @ProcessorTest
+    public void returnsNullForNullSourcesByDefault() {
+        assertThat( MapToIterableMapper.INSTANCE.map( (Map<String, Schedule>) null ) ).isNull();
+        assertThat( IterableToMapMapper.INSTANCE.map( (List<FlattenedSchedule>) null ) ).isNull();
+        assertThat( IterableToMapMapper.INSTANCE.mapEntry( (FlattenedSchedule) null ) ).isNull();
+    }
+
+    @ProcessorTest
+    public void returnsEmptyContainersForNullSourcesWhenConfigured() {
+        assertThat( ReturnDefaultMapEntryMapper.INSTANCE.toList( null ) ).isEmpty();
+        assertThat( ReturnDefaultMapEntryMapper.INSTANCE.toMap( null ) ).isEmpty();
+    }
+
+    @ProcessorTest
+    public void mapsMapAndIterableBeanProperties() {
+        ScheduleBook source = new ScheduleBook();
+        Map<String, Schedule> schedules = new LinkedHashMap<>();
+        schedules.put( "monday", schedule( "11:00", "office" ) );
+        source.setSchedules( schedules );
+
+        FlattenedScheduleBook flattened = ScheduleBookMapper.INSTANCE.flatten( source );
+        ScheduleBook expanded = ScheduleBookMapper.INSTANCE.expand( flattened );
+
+        assertThat( flattened.getSchedules() ).hasSize( 1 );
+        assertThat( flattened.getSchedules().get( 0 ).getDay() ).isEqualTo( "monday" );
+        assertThat( flattened.getSchedules().get( 0 ).getTime() ).isEqualTo( "11:00" );
+        assertThat( expanded.getSchedules() ).containsOnlyKeys( "monday" );
+        assertThat( expanded.getSchedules().get( "monday" ).getKind() ).isEqualTo( "office" );
+    }
+
+    @ProcessorTest
+    public void supportsConcreteMapAndIterableSubtypes() {
+        ScheduleMap source = new ScheduleMap();
+        source.put( "monday", schedule( "11:00", "office" ) );
+
+        FlattenedScheduleList flattened = SubtypeMapEntryMapper.INSTANCE.flatten( source );
+        ScheduleMap expanded = SubtypeMapEntryMapper.INSTANCE.expand( flattened );
+
+        assertThat( flattened ).hasSize( 1 );
+        assertThat( flattened.get( 0 ).getDay() ).isEqualTo( "monday" );
+        assertThat( expanded ).isInstanceOf( ScheduleMap.class );
+        assertThat( expanded.get( "monday" ).getTime() ).isEqualTo( "11:00" );
+    }
+
+    @ProcessorTest
+    public void appliesExistingConversionsToEntryKeys() {
+        Map<Integer, Schedule> source = new LinkedHashMap<>();
+        source.put( 12, schedule( "11:00", "office" ) );
+
+        List<FlattenedSchedule> flattened = ConversionMapEntryMapper.INSTANCE.flatten( source );
+        Map<Integer, Schedule> expanded = ConversionMapEntryMapper.INSTANCE.expand( flattened );
+
+        assertThat( flattened ).hasSize( 1 );
+        assertThat( flattened.get( 0 ).getDay() ).isEqualTo( "12" );
+        assertThat( expanded ).containsOnlyKeys( 12 );
+        assertThat( expanded.get( 12 ).getKind() ).isEqualTo( "office" );
+    }
+
+    @ProcessorTest
+    public void selectsEntryMappingMethodsWithIterableQualifiers() {
+        Map<String, Schedule> source = new LinkedHashMap<>();
+        source.put( "monday", schedule( "11:00", "office" ) );
+
+        List<FlattenedSchedule> flattened = QualifiedMapEntryMapper.INSTANCE.flatten( source );
+        Map<String, Schedule> expanded = QualifiedMapEntryMapper.INSTANCE.expand( flattened );
+
+        assertThat( flattened ).hasSize( 1 );
+        assertThat( flattened.get( 0 ).getDay() ).isEqualTo( "selected-monday" );
+        assertThat( expanded ).containsOnlyKeys( "monday" );
+        assertThat( expanded.get( "monday" ).getTime() ).isEqualTo( "11:00" );
+    }
+
+    @ProcessorTest
+    public void supportsInheritedCrossContainerMappingMethods() {
+        Map<String, Schedule> source = new LinkedHashMap<>();
+        source.put( "monday", schedule( "11:00", "office" ) );
+
+        List<FlattenedSchedule> flattened = InheritedMapEntryMapper.INSTANCE.flatten( source );
+        Map<String, Schedule> expanded = InheritedMapEntryMapper.INSTANCE.expand( flattened );
+
+        assertThat( flattened ).hasSize( 1 );
+        assertThat( flattened.get( 0 ).getDay() ).isEqualTo( "monday" );
+        assertThat( expanded ).containsOnlyKeys( "monday" );
+        assertThat( expanded.get( "monday" ).getKind() ).isEqualTo( "office" );
+    }
+
+    @ProcessorTest
+    public void replacesExistingEntriesInMappingTargets() {
+        Map<String, Schedule> sourceMap = new LinkedHashMap<>();
+        sourceMap.put( "monday", schedule( "11:00", "office" ) );
+        List<FlattenedSchedule> targetList = Arrays.asList( flattened( "old", "08:00", "remote" ) );
+
+        List<FlattenedSchedule> mutableTargetList = new ArrayList<>( targetList );
+        MapToIterableMapper.INSTANCE.map( sourceMap, mutableTargetList );
+
+        List<FlattenedSchedule> sourceList = Arrays.asList( flattened( "friday", "16:00", "remote" ) );
+        Map<String, Schedule> targetMap = new LinkedHashMap<>();
+        targetMap.put( "old", schedule( "08:00", "office" ) );
+        IterableToMapMapper.INSTANCE.map( sourceList, targetMap );
+
+        assertThat( mutableTargetList ).hasSize( 1 );
+        assertThat( mutableTargetList.get( 0 ).getDay() ).isEqualTo( "monday" );
+        assertThat( targetMap ).containsOnlyKeys( "friday" );
+        assertThat( targetMap.get( "friday" ).getTime() ).isEqualTo( "16:00" );
+    }
+
+    @ProcessorTest
+    public void mapsMapEntriesToArrayElementsInIterationOrder() {
+        Map<String, Schedule> source = new LinkedHashMap<>();
+        source.put( "monday", schedule( "11:00", "office" ) );
+        source.put( "friday", schedule( "16:00", "remote" ) );
+
+        FlattenedSchedule[] result = MapToIterableMapper.INSTANCE.mapToArray( source );
+
+        assertThat( result ).extracting( FlattenedSchedule::getDay )
+            .containsExactly( "monday", "friday" );
+        assertThat( result ).extracting( FlattenedSchedule::getTime )
+            .containsExactly( "11:00", "16:00" );
+    }
+
+    @ProcessorTest
+    public void mapsArrayElementsThroughMapEntries() {
+        FlattenedSchedule[] source = {
+            flattened( "monday", "11:00", "office" ),
+            flattened( "friday", "16:00", "remote" )
+        };
+
+        Map<String, Schedule> result = IterableToMapMapper.INSTANCE.mapFromArray( source );
+
+        assertThat( result ).containsOnlyKeys( "monday", "friday" );
+        assertThat( result.get( "monday" ).getKind() ).isEqualTo( "office" );
+        assertThat( result.get( "friday" ).getTime() ).isEqualTo( "16:00" );
+    }
+
+    @ProcessorTest
+    public void usesConcreteSelectedEntryTypesForLowerBoundedMapResults() {
+        FlattenedSchedule source = flattened( "bounded-monday", "11:00", "office" );
+
+        Map<? super String, ? super String> result = EntryBoundaryMapper517e60.INSTANCE.mapLowerBounded(
+            Arrays.asList( source )
+        );
+
+        assertThat( result ).containsEntry( "bounded-monday", "11:00" );
+    }
+
+    @ProcessorTest
+    @WithClasses(ContextEntryMapper538db4.class)
+    public void avoidsEntryLocalCollisionsWithContextParameters() {
+        FlattenedSchedule source = flattened( "monday", "11:00", "office" );
+
+        Map<String, String> result = ContextEntryMapper538db4.INSTANCE.map(
+            Arrays.asList( source ),
+            "context-"
+        );
+
+        assertThat( result ).containsOnlyKeys( "context-monday" );
+        assertThat( result.get( "context-monday" ) ).isEqualTo( "11:00" );
+    }
+
+    private static Schedule schedule(String time, String kind) {
+        Schedule schedule = new Schedule();
+        schedule.setTime( time );
+        schedule.setKind( kind );
+        return schedule;
+    }
+
+    private static FlattenedSchedule flattened(String day, String time, String kind) {
+        FlattenedSchedule flattened = new FlattenedSchedule();
+        flattened.setDay( day );
+        flattened.setTime( time );
+        flattened.setKind( kind );
+        return flattened;
+    }
+}
