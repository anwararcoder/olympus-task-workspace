+// ─── replacePattern ─────────────────────────────────────────────────────
+
+func TestReplacePattern_string_template(t *testing.T) {
+	tests := []struct {
+		name  string
+		input string
+		env   map[string]any
+		want  any
+	}{
+		{
+			name:  "basic replacement",
+			input: `replacePattern("hello world", "world", "Go")`,
+			want:  "hello Go",
+		},
+		{
+			name:  "back reference $1",
+			input: `replacePattern("foo bar", "(\\w+)", "[$1]")`,
+			want:  "[foo] [bar]",
+		},
+		{
+			name:  "back reference ${1}",
+			input: `replacePattern("foo bar", "(\\w+)", "[${1}]")`,
+			want:  "[foo] [bar]",
+		},
+		{
+			name:  "named back reference ${name}",
+			input: `replacePattern("2024-01-15", "(?P<y>\\d{4})-(?P<m>\\d{2})-(?P<d>\\d{2})", "${m}/${d}/${y}")`,
+			want:  "01/15/2024",
+		},
+		{
+			name:  "literal dollar $$",
+			input: `replacePattern("price 10", "(\\d+)", "$$${1}")`,
+			want:  "price $10",
+		},
+		{
+			name:  "with limit",
+			input: `replacePattern("a b c d", "\\w+", "x", 2)`,
+			want:  "x x c d",
+		},
+		{
+			name:  "no match returns original",
+			input: `replacePattern("hello", "\\d+", "x")`,
+			want:  "hello",
+		},
+		{
+			name:  "nil text returns nil",
+			input: `replacePattern(nil_val, "\\d+", "x")`,
