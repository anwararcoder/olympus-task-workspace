+func TestCapture_no_groups(t *testing.T) {
+	// Pattern with no capture groups should return empty map
+	program, err := expr.Compile(`capture("hello", "hello")`)
+	require.NoError(t, err)
+	out, err := expr.Run(program, nil)
+	require.NoError(t, err)
+	assert.Equal(t, map[string]any{}, out)
+}
+
+func TestCapture_no_metadata(t *testing.T) {
+	// Verify capture result has NO "0" or "_index" keys
+	program, err := expr.Compile(`capture("abc 123", "(\\w+)\\s+(\\d+)")`)
+	require.NoError(t, err)
+	out, err := expr.Run(program, nil)
+	require.NoError(t, err)
+	m := out.(map[string]any)
+	_, has0 := m["0"]
+	_, hasIndex := m["_index"]
+	assert.False(t, has0, "capture should not include '0' key")
+	assert.False(t, hasIndex, "capture should not include '_index' key")
+	assert.Equal(t, 2, len(m), "capture should only have group keys")
+}
+
+func TestCaptureAll_no_metadata(t *testing.T) {
+	// Verify captureAll without closure has NO "0" or "_index" keys
+	program, err := expr.Compile(`captureAll("a1 b2", "([a-z])(\\d)")`)
+	require.NoError(t, err)
+	out, err := expr.Run(program, nil)
+	require.NoError(t, err)
+	arr := out.([]any)
+	for _, item := range arr {
+		m := item.(map[string]any)
+		_, has0 := m["0"]
+		_, hasIndex := m["_index"]
+		assert.False(t, has0, "captureAll without closure should not include '0' key")
+		assert.False(t, hasIndex, "captureAll without closure should not include '_index' key")
+		assert.Equal(t, 2, len(m), "captureAll without closure should only have group keys")
+	}
+}
+
+func TestCaptureAll_closure_has_metadata(t *testing.T) {
+	// Verify closure # map HAS "0" and "_index" keys
+	program, err := expr.Compile(`captureAll("a1 b2", "([a-z])(\\d)", {len(keys(#))})`)
+	require.NoError(t, err)
+	out, err := expr.Run(program, nil)
+	require.NoError(t, err)
+	// 4 keys: "0", "_index", "1", "2"
+	assert.Equal(t, []any{4, 4}, out)
+}
+
+func TestCaptureAll_no_groups(t *testing.T) {
+	// Pattern with no capture groups should return array of empty maps
+	program, err := expr.Compile(`captureAll("hello world", "\\w+")`)
+	require.NoError(t, err)
+	out, err := expr.Run(program, nil)
+	require.NoError(t, err)
+	assert.Equal(t, []any{
+		map[string]any{},
+		map[string]any{},
+	}, out)
+}
+
+func TestReplacePattern_dynamic_pattern_with_closure(t *testing.T) {
+	env := map[string]any{
+		"text":    "hello world",
+		"pattern": `(\w+)`,
+	}
+	program, err := expr.Compile(`replacePattern(text, pattern, {upper(#["0"])})`, expr.Env(env))
+	require.NoError(t, err)
+	out, err := expr.Run(program, env)
+	require.NoError(t, err)
+	assert.Equal(t, "HELLO WORLD", out)
+}
