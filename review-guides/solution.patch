@@ -0,0 +1,128 @@
+package builtin
+
+import (
+	"fmt"
+	"regexp"
+	"strconv"
+)
+
+// buildCaptureGroups builds a map[string]any from a regexp match.
+// If withMeta is true, it includes "0" (full match) and "_index" keys.
+// If withMeta is false, it only includes explicit capture groups (numbered 1..N, named by name).
+func buildCaptureGroups(re *regexp.Regexp, match []string, withMeta bool, matchIndex int) map[string]any {
+	result := make(map[string]any)
+	if withMeta {
+		result["0"] = match[0]
+		result["_index"] = matchIndex
+	}
+	names := re.SubexpNames()
+	for i := 1; i < len(match); i++ {
+		if i < len(names) && names[i] != "" {
+			result[names[i]] = match[i]
+		} else {
+			result[strconv.Itoa(i)] = match[i]
+		}
+	}
+	return result
+}
+
+// Capture extracts capture groups from the first match of pattern in text.
+// Returns nil if text is nil, nil if no match found, or a map[string]any of groups.
+func Capture(args ...any) (any, error) {
+	if len(args) != 2 {
+		return nil, fmt.Errorf("invalid number of arguments for capture (expected 2, got %d)", len(args))
+	}
+	if args[0] == nil {
+		return nil, nil
+	}
+	text, ok := args[0].(string)
+	if !ok {
+		return nil, fmt.Errorf("first argument to capture must be a string (got %T)", args[0])
+	}
+	pattern, ok := args[1].(string)
+	if !ok {
+		return nil, fmt.Errorf("second argument to capture must be a string (got %T)", args[1])
+	}
+	re, err := regexp.Compile(pattern)
+	if err != nil {
+		return nil, fmt.Errorf("invalid regex pattern: %v", err)
+	}
+	match := re.FindStringSubmatch(text)
+	if match == nil {
+		return nil, nil
+	}
+	return buildCaptureGroups(re, match, false, 0), nil
+}
+
+// CaptureConst is the runtime implementation for capture when the pattern was
+// compiled at compile time. args[0] = text, args[1] = *regexp.Regexp
+func CaptureConst(args ...any) (any, error) {
+	if args[0] == nil {
+		return nil, nil
+	}
+	text := args[0].(string)
+	re := args[1].(*regexp.Regexp)
+	match := re.FindStringSubmatch(text)
+	if match == nil {
+		return nil, nil
+	}
+	return buildCaptureGroups(re, match, false, 0), nil
+}
+
+// CaptureAll returns all matches of pattern in text as an array of maps.
+// Returns nil if text is nil, empty array if no matches found.
+func CaptureAll(args ...any) (any, error) {
+	if len(args) != 2 {
+		return nil, fmt.Errorf("invalid number of arguments for captureAll (expected 2, got %d)", len(args))
+	}
+	if args[0] == nil {
+		return nil, nil
+	}
+	text, ok := args[0].(string)
+	if !ok {
+		return nil, fmt.Errorf("first argument to captureAll must be a string (got %T)", args[0])
+	}
+	pattern, ok := args[1].(string)
+	if !ok {
+		return nil, fmt.Errorf("second argument to captureAll must be a string (got %T)", args[1])
+	}
+	re, err := regexp.Compile(pattern)
+	if err != nil {
+		return nil, fmt.Errorf("invalid regex pattern: %v", err)
+	}
+	matches := re.FindAllStringSubmatch(text, -1)
+	if matches == nil {
+		return []any{}, nil
+	}
+	result := make([]any, len(matches))
+	for i, match := range matches {
+		result[i] = buildCaptureGroups(re, match, false, i)
+	}
+	return result, nil
+}
+
+// BuildCaptureGroupsMeta builds capture groups with metadata (0 and _index).
+// This is used by the compiler for closure-based captureAll and replacePattern.
+func BuildCaptureGroupsMeta(re *regexp.Regexp, match []string, matchIndex int) map[string]any {
+	return buildCaptureGroups(re, match, true, matchIndex)
+}
+
+// ReplaceWithTemplateFn performs regex replacement supporting backreferences
+// like $1, ${1}, ${name}, and $$ for literal $.
+func ReplaceWithTemplateFn(text string, re *regexp.Regexp, template string, limit int) string {
+	if limit == 0 {
+		return text
+	}
+	count := 0
+	return re.ReplaceAllStringFunc(text, func(match string) string {
+		if limit >= 0 && count >= limit {
+			return match
+		}
+		count++
+		// Use Go's regexp Expand for backreference substitution
+		submatch := re.FindStringSubmatchIndex(match)
+		var dst []byte
+		dst = re.ExpandString(dst, template, match, submatch)
+		return string(dst)
+	})
+}
