+			want:  nil,
+		},
+		{
+			name:  "no metadata keys without closure",
+			input: `captureAll("a1 b2", "([a-z])(\\d)")`,
+			want: []any{
+				map[string]any{"1": "a", "2": "1"},
+				map[string]any{"1": "b", "2": "2"},
+			},
+		},
