+func TestCaptureAll_dynamic_pattern_with_closure(t *testing.T) {
+	env := map[string]any{
+		"text":    "a1 b2",
+		"pattern": `([a-z])(\d)`,
+	}
+	program, err := expr.Compile(`captureAll(text, pattern, {#["1"] + #["2"]})`, expr.Env(env))
+	require.NoError(t, err)
+	out, err := expr.Run(program, env)
