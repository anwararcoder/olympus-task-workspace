+package builtin_test
+
+import (
+	"testing"
+
+	"github.com/expr-lang/expr"
+	"github.com/expr-lang/expr/internal/testify/assert"
+	"github.com/expr-lang/expr/internal/testify/require"
+)
+
+// ─── capture ────────────────────────────────────────────────────────────
+
+func TestCapture_basic(t *testing.T) {
+	tests := []struct {
+		name  string
+		input string
+		env   map[string]any
+		want  any
+	}{
+		{
+			name:  "unnamed groups",
+			input: `capture("hello world 42", "(\\w+)\\s+(\\w+)\\s+(\\d+)")`,
+			want: map[string]any{
+				"1": "hello",
+				"2": "world",
+				"3": "42",
+			},
+		},
+		{
+			name:  "named groups",
+			input: `capture("2024-01-15", "(?P<year>\\d{4})-(?P<month>\\d{2})-(?P<day>\\d{2})")`,
+			want: map[string]any{
+				"year":  "2024",
+				"month": "01",
+				"day":   "15",
+			},
+		},
+		{
+			name:  "mixed named and unnamed groups",
+			input: `capture("John 30", "(?P<name>\\w+)\\s+(\\d+)")`,
+			want: map[string]any{
+				"name": "John",
+				"2":    "30",
+			},
+		},
+		{
+			name:  "no match returns nil",
+			input: `capture("hello", "\\d+")`,
+			want:  nil,
+		},
+		{
+			name:  "nil text returns nil",
+			input: `capture(nil_val, "\\d+")`,
+			env:   map[string]any{"nil_val": nil},
+			want:  nil,
+		},
+		{
+			name:  "first match only",
+			input: `capture("abc 123 def 456", "(\\d+)")`,
+			want:  map[string]any{"1": "123"},
+		},
+		{
+			name:  "no metadata keys in result",
+			input: `capture("hello 42", "(\\w+)\\s+(\\d+)")`,
+			want: map[string]any{
+				"1": "hello",
+				"2": "42",
+			},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			env := tt.env
+			if env == nil {
+				env = map[string]any{}
+			}
+			program, err := expr.Compile(tt.input, expr.Env(env))
+			require.NoError(t, err)
+			out, err := expr.Run(program, env)
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, out)
+		})
+	}
+}
+
+func TestCapture_dynamic_pattern(t *testing.T) {
+	env := map[string]any{
+		"text":    "hello 123",
+		"pattern": `(\w+)\s+(\d+)`,
+	}
+	program, err := expr.Compile(`capture(text, pattern)`, expr.Env(env))
+	require.NoError(t, err)
+	out, err := expr.Run(program, env)
+	require.NoError(t, err)
+	assert.Equal(t, map[string]any{"1": "hello", "2": "123"}, out)
+}
+
+func TestCapture_invalid_const_pattern(t *testing.T) {
+	_, err := expr.Compile(`capture("hello", "[invalid")`)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "error parsing regexp")
+}
+
+func TestCapture_invalid_dynamic_pattern(t *testing.T) {
+	env := map[string]any{
+		"text":    "hello",
+		"pattern": "[invalid",
+	}
+	program, err := expr.Compile(`capture(text, pattern)`, expr.Env(env))
+	require.NoError(t, err)
+	_, err = expr.Run(program, env)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "invalid regex pattern")
+}
+
+// ─── captureAll ─────────────────────────────────────────────────────────
+
+func TestCaptureAll_basic(t *testing.T) {
+	tests := []struct {
+		name  string
+		input string
+		env   map[string]any
+		want  any
+	}{
+		{
+			name:  "multiple matches unnamed",
+			input: `captureAll("abc 123 def 456", "([a-z]+)\\s+(\\d+)")`,
+			want: []any{
+				map[string]any{"1": "abc", "2": "123"},
+				map[string]any{"1": "def", "2": "456"},
+			},
+		},
+		{
+			name:  "multiple matches named",
+			input: `captureAll("2024-01-15 2023-12-25", "(?P<year>\\d{4})-(?P<month>\\d{2})-(?P<day>\\d{2})")`,
+			want: []any{
+				map[string]any{"year": "2024", "month": "01", "day": "15"},
+				map[string]any{"year": "2023", "month": "12", "day": "25"},
+			},
