+			if env == nil {
+				env = map[string]any{}
+			}
+			program, err := expr.Compile(tt.input, expr.Env(env))
+			require.NoError(t, err)
+			out, err := expr.Run(program, env)
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, out)
+		})
+	}
+}
+
+func TestCaptureAll_with_closure(t *testing.T) {
+	tests := []struct {
+		name  string
+		input string
+		env   map[string]any
+		want  any
+	}{
+		{
+			name:  "transform with closure",
+			input: `captureAll("abc 123 def 456", "([a-z]+)\\s+(\\d+)", {#["1"] + "=" + #["2"]})`,
+			want:  []any{"abc=123", "def=456"},
+		},
+		{
+			name:  "closure has 0 key for full match",
+			input: `captureAll("abc 123 def 456", "([a-z]+)\\s+(\\d+)", {#["0"]})`,
+			want:  []any{"abc 123", "def 456"},
+		},
+		{
+			name:  "closure has _index key",
+			input: `captureAll("a1 b2 c3", "([a-z])(\\d)", {#["_index"]})`,
+			want:  []any{0, 1, 2},
+		},
+		{
+			name:  "nil text with closure returns nil",
+			input: `captureAll(nil_val, "\\d+", {#["0"]})`,
+			env:   map[string]any{"nil_val": nil},
+			want:  nil,
+		},
+		{
+			name:  "named groups in closure",
+			input: `captureAll("2024-01 2023-12", "(?P<y>\\d{4})-(?P<m>\\d{2})", {#["y"] + "/" + #["m"]})`,
+			want:  []any{"2024/01", "2023/12"},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			env := tt.env
+			if env == nil {
+				env = map[string]any{}
+			}
+			program, err := expr.Compile(tt.input, expr.Env(env))
+			require.NoError(t, err)
+			out, err := expr.Run(program, env)
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, out)
+		})
+	}
+}
