+
+class TextFileBasedViolationStoreIntegrityTest {
+
+    @TempDir
+    Path temporaryFolder;
+
+    @Test
+    void description_file_names_are_safe_stable_and_keep_a_late_word() throws IOException {
+        File folder = temporaryFolder.resolve("store").toFile();
+        TextFileBasedViolationStore store = new TextFileBasedViolationStore();
+        store.initialize(properties(folder, "default.fileNames", "description"));
+
+        String description = repeat("prefix ", 50) + "LateWord";
+        ArchRule first = rule(description);
+        ArchRule second = rule(description + " other");
+        store.save(first, ImmutableList.of("one"));
+        store.save(second, ImmutableList.of("two"));
+
+        Properties index = readIndex(folder);
+        String firstName = index.getProperty(description);
+        String secondName = index.getProperty(second.getDescription());
+        assertThat(firstName).contains("LateWord").matches("[A-Za-z0-9_-]{1,200}");
+        assertThat(firstName).isNotEqualTo("stored.rules").isNotEqualTo(secondName);
+    }
+
+    @Test
+    void fail_does_not_create_an_index_when_an_absent_store_is_unowned() throws IOException {
+        File folder = temporaryFolder.resolve("store").toFile();
+        assertThat(folder.mkdirs()).isTrue();
+        Files.write(new File(folder, "unowned").toPath(), "data".getBytes(UTF_8));
+
+        assertThatThrownBy(() -> new TextFileBasedViolationStore().initialize(properties(
+                folder, "default.allowStoreCreation", "true", "default.integrity", "fail")))
+                .isInstanceOf(StoreInitializationFailedException.class)
+                .hasMessageContaining("unowned");
+        assertThat(new File(folder, "stored.rules")).doesNotExist();
+    }
+
+    @Test
+    void repair_discards_broken_and_empty_entries_moves_misplaced_entries_and_keeps_unowned_files() throws IOException {
+        File folder = temporaryFolder.resolve("store").toFile();
+        assertThat(folder.mkdirs()).isTrue();
+        Properties index = new Properties();
+        index.setProperty("broken", "missing");
+        index.setProperty("empty", "empty-file");
+        index.setProperty("misplaced", "old-file");
+        writeIndex(folder, index);
+        Files.write(new File(folder, "empty-file").toPath(), "\r".getBytes(UTF_8));
+        Files.write(new File(folder, "old-file").toPath(), "violation\n".getBytes(UTF_8));
+        Files.write(new File(folder, "unowned").toPath(), "keep".getBytes(UTF_8));
+
+        TextFileBasedViolationStore store = new TextFileBasedViolationStore(description -> description);
+        store.initialize(properties(folder, "default.integrity", "repair"));
+
+        Properties repaired = readIndex(folder);
+        assertThat(repaired).containsOnlyKeys("misplaced");
+        assertThat(repaired.getProperty("misplaced")).isEqualTo("misplaced");
+        assertThat(new File(folder, "old-file")).doesNotExist();
+        assertThat(new File(folder, "empty-file")).doesNotExist();
+        assertThat(new File(folder, "unowned")).exists();
+        assertThat(store.getViolations(rule("misplaced"))).containsExactly("violation");
+    }
+
+    @Test
+    void carriage_return_inside_a_violation_is_preserved() {
+        File folder = temporaryFolder.resolve("store").toFile();
+        TextFileBasedViolationStore store = new TextFileBasedViolationStore(description -> "rule-file");
+        store.initialize(properties(folder));
+
+        ArchRule rule = rule("description\r\nwith break");
+        store.save(rule, Collections.singletonList("first\rsecond"));
+
+        assertThat(store.getViolations(rule)).containsExactly("first\rsecond");
+    }
+
+    private Properties properties(File folder, String... additional) {
+        List<String> values = new LinkedList<>();
+        values.add("default.path");
+        values.add(folder.getAbsolutePath());
+        values.add("default.allowStoreCreation");
+        values.add("true");
+        values.addAll(Arrays.asList(additional));
+        Properties result = new Properties();
+        while (!values.isEmpty()) {
+            result.setProperty(values.remove(0), values.remove(0));
+        }
+        return result;
+    }
+
+    private Properties readIndex(File folder) throws IOException {
+        Properties result = new Properties();
+        try (FileInputStream input = new FileInputStream(new File(folder, "stored.rules"))) {
+            result.load(input);
+        }
+        return result;
+    }
+
+    private void writeIndex(File folder, Properties index) throws IOException {
+        try (FileOutputStream output = new FileOutputStream(new File(folder, "stored.rules"))) {
+            index.store(output, "");
+        }
+    }
+
+    private ArchRule rule(String description) {
+        return classes().should().bePublic().as(description);
+    }
+
+    private String repeat(String value, int count) {
+        StringBuilder result = new StringBuilder();
+        for (int i = 0; i < count; i++) {
+            result.append(value);
+        }
+        return result.toString();
+    }
+}
