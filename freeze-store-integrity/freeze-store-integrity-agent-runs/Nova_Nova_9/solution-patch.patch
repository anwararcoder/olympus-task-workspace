+    }
+
+    private Properties loadIndex() throws IOException {
+        Properties result = new Properties();
+        try (java.io.FileInputStream input = new java.io.FileInputStream(new File(folder(), "stored.rules"))) {
+            result.load(input);
+        }
+        return result;
+    }
+
+    private Properties properties(String... values) {
+        Properties result = new Properties();
+        for (int i = 0; i < values.length; i += 2) {
+            result.setProperty(values[i], values[i + 1]);
+        }
+        return result;
+    }
+
+    private ArchRule rule(String description) {
+        return classes().should().bePublic().as(description);
+    }
+
+    private String repeat(char character, int count) {
+        StringBuilder result = new StringBuilder(count);
+        for (int i = 0; i < count; i++) {
+            result.append(character);
+        }
+        return result.toString();
+    }
