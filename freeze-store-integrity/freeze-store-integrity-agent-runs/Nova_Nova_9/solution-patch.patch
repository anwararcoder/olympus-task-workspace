+                "default.allowStoreCreation", "true",
+                "default.fileNames", "description");
+        store.initialize(properties);
+
+        ArchRule first = rule(repeat('a', 300) + " lateWord");
+        ArchRule second = rule("another description");
+        store.save(first, ImmutableList.of("one"));
+        store.save(second, ImmutableList.of("two"));
+
+        Properties index = readIndex();
+        String firstName = index.getProperty(first.getDescription());
+        String secondName = index.getProperty(second.getDescription());
+        assertThat(firstName).contains("lateWord").matches("[A-Za-z0-9_-]+").hasSizeLessThanOrEqualTo(200);
+        assertThat(secondName).matches("[A-Za-z0-9_-]+").hasSizeLessThanOrEqualTo(200);
+        assertThat(firstName).isNotEqualTo(secondName).isNotEqualTo("stored.rules");
+    }
