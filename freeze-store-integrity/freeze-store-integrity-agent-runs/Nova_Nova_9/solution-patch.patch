+package com.tngtech.archunit.library.freeze;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.Properties;
+
+import com.tngtech.archunit.lang.ArchRule;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+import static com.tngtech.archunit.lang.syntax.ArchRuleDefinition.classes;
+import static java.nio.charset.StandardCharsets.UTF_8;
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+class TextFileBasedViolationStoreIntegrityTest {
+
+    @TempDir
+    Path temporaryFolder;
+
+    @Test
+    void description_file_names_are_stable_safe_and_keep_a_late_word() throws IOException {
+        Properties properties = properties("default.path", folder().getAbsolutePath(),
+                "default.allowStoreCreation", "true", "default.fileNames", "description");
+        TextFileBasedViolationStore store = new TextFileBasedViolationStore();
+        store.initialize(properties);
+
+        ArchRule first = rule("prefix " + repeat('x', 500) + " LateWord");
+        ArchRule second = rule("prefix " + repeat('x', 500) + " AnotherWord");
+        store.save(first, Arrays.asList("violation"));
+        store.save(second, Arrays.asList("violation"));
+
+        Properties index = loadIndex();
+        String firstName = index.getProperty(first.getDescription());
+        String secondName = index.getProperty(second.getDescription());
+        assertThat(firstName).contains("LateWord").matches("[A-Za-z0-9_-]+").hasSizeLessThanOrEqualTo(200);
+        assertThat(firstName).isNotEqualTo("stored.rules");
+        assertThat(secondName).isNotEqualTo(firstName);
+    }
+
+    @Test
+    void constructor_strategy_receives_the_unmodified_description() {
+        List<String> descriptions = new ArrayList<>();
+        TextFileBasedViolationStore store = new TextFileBasedViolationStore(description -> {
+            descriptions.add(description);
+            return "violations";
+        });
+        store.initialize(properties("default.path", folder().getAbsolutePath(), "default.allowStoreCreation", "true"));
+
+        String description = "line one\r\nline two";
+        store.save(rule(description), Arrays.asList("violation"));
+
+        assertThat(descriptions).containsExactly(description);
+    }
+
+    @Test
+    void carriage_returns_in_violations_are_preserved() {
+        TextFileBasedViolationStore store = new TextFileBasedViolationStore(description -> "violations");
+        store.initialize(properties("default.path", folder().getAbsolutePath(), "default.allowStoreCreation", "true"));
+
+        store.save(rule("carriage returns"), Arrays.asList("before\r", "inside\rtext"));
+
+        assertThat(store.getViolations(rule("carriage returns")))
+                .containsExactly("before\r", "inside\rtext");
+    }
+
+    @Test
+    void repair_discards_broken_and_empty_entries_and_moves_misplaced_files() throws IOException {
+        File storeFolder = folder();
+        assertThat(storeFolder.mkdirs()).isTrue();
+        Properties index = new Properties();
+        index.setProperty("broken rule", "missing");
+        index.setProperty("empty rule", "empty");
+        index.setProperty("surviving rule", "wrong");
+        try (FileOutputStream output = new FileOutputStream(new File(storeFolder, "stored.rules"))) {
+            index.store(output, "");
+        }
+        Files.write(new File(storeFolder, "empty").toPath(), new byte[0]);
+        Files.write(new File(storeFolder, "wrong").toPath(), "violation\n".getBytes(UTF_8));
+
+        TextFileBasedViolationStore store = new TextFileBasedViolationStore();
+        store.initialize(properties("default.path", storeFolder.getAbsolutePath(),
+                "default.allowStoreCreation", "true", "default.fileNames", "description",
+                "default.integrity", "repair"));
+
+        Properties repaired = loadIndex();
+        assertThat(repaired).containsOnlyKeys("surviving rule");
+        String movedName = repaired.getProperty("surviving rule");
+        assertThat(new File(storeFolder, movedName)).isFile();
+        assertThat(new File(storeFolder, "wrong")).doesNotExist();
+        assertThat(new File(storeFolder, "empty")).doesNotExist();
+        assertThat(store.getViolations(rule("surviving rule"))).containsExactly("violation");
+    }
+
+    @Test
+    void invalid_integrity_value_names_all_accepted_values() {
+        Properties properties = properties("default.path", folder().getAbsolutePath(),
+                "default.allowStoreCreation", "true", "default.integrity", "anything");
+
+        assertThatThrownBy(() -> new TextFileBasedViolationStore().initialize(properties))
