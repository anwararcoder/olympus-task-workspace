+    private ArchRule rule(String description) {
+        return classes().should().bePublic().as(description);
+    }
+
+    private String repeated(String value, int count) {
+        StringBuilder result = new StringBuilder();
+        for (int i = 0; i < count; i++) {
+            result.append(value);
+        }
+        return result.toString();
+    }
+}
diff --git a/docs/userguide/008_The_Library_API.adoc b/docs/userguide/008_The_Library_API.adoc
index 10ed830..5142227 100644
--- a/docs/userguide/008_The_Library_API.adoc
+++ b/docs/userguide/008_The_Library_API.adoc
@@ -481,8 +481,20 @@ freeze.store.default.allowStoreCreation=true
 # can be set to false to forbid updates of the violations stored for frozen rules
 # default is true
 freeze.store.default.allowStoreUpdate=false
+
+# names new violation files randomly (the default), from the rule description,
+# or with a fully qualified RuleViolationFileNameStrategy class name
+freeze.store.default.fileNames=description
+
+# checks the index and folder during initialization; values are ignore (the default), repair, or fail
+freeze.store.default.integrity=repair
 ----
 
+The `description` file naming mode is deterministic and produces safe, bounded file names. The `repair` integrity
+mode removes broken or empty entries and moves misplaced files when the update permission is enabled. The `fail`
+mode reports integrity problems without changing the store; it also leaves an absent index absent when initialization
+is rejected.
+
 This can help in CI environments to prevent misconfiguration:
 For example, a CI build should probably never create a new the violation store, but operate on
 an existing one.
