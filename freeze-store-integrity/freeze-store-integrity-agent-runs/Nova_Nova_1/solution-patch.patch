+                    // link in a path such as "link/../file".
+                    parentRealPath = absolute.getParent().toRealPath();
+                } catch (IOException ignored) {
+                    // The target cannot be created directly in the folder if its parent is absent.
+                }
+            }
+            boolean directLocation = realPath != null
+                    ? storeFolderRealPath.equals(realPath.getParent())
+                    : lexicalDirect && storeFolderRealPath.equals(parentRealPath);
+            boolean regular = Files.isRegularFile(path);
+            return new PathInfo(path, realPath, existsWithoutFollowingLink, reachesIndex, !directLocation, regular, true);
+        } catch (InvalidPathException | NullPointerException e) {
