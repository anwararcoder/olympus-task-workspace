+
+    private Properties properties(File folder, String... additional) {
+        Properties result = new Properties();
+        result.setProperty("default.path", folder.getAbsolutePath());
+        result.setProperty("default.allowStoreCreation", "true");
+        for (int i = 0; i < additional.length; i += 2) {
+            result.setProperty(additional[i], additional[i + 1]);
+        }
+        return result;
+    }
+
+    private Properties readProperties(File file) throws IOException {
+        Properties result = new Properties();
+        try (FileInputStream inputStream = new FileInputStream(file)) {
+            result.load(inputStream);
+        }
+        return result;
+    }
+
+    private void writeProperties(File file, Properties properties) throws IOException {
+        try (FileOutputStream outputStream = new FileOutputStream(file)) {
+            properties.store(outputStream, "");
+        }
+    }
+
+    private ArchRule rule(String description) {
+        return classes().should().bePublic().as(description);
+    }
