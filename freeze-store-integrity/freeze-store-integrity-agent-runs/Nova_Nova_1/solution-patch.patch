+    private static String descriptionFileName(String description) {
+        String normalized = description.replace("\r\n", "\n");
+        Matcher matcher = DESCRIPTION_WORD.matcher(normalized);
+        String retainedWord = null;
+        while (matcher.find()) {
+            String candidate = matcher.group(1);
+            if (retainedWord == null || candidate.length() > retainedWord.length()) {
+                retainedWord = candidate;
+            }
+        }
+        String hash = sha256(normalized);
+        String prefix = retainedWord == null ? "rule" : retainedWord;
+        String result = prefix + "-" + hash;
+        if (result.length() > 200) {
+            result = result.substring(0, 200);
+        }
+        if (STORED_RULES_FILE_NAME.equals(result)) {
+            result = "rule-" + hash;
+        }
+        return result;
+    }
