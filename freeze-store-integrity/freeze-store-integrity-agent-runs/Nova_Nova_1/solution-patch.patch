+        assertThat(repaired).doesNotContainKeys("broken", "empty").containsEntry("misplaced", "derived-misplaced");
+        assertThat(new File(folder, "old")).doesNotExist();
+        assertThat(new File(folder, "derived-misplaced")).hasContent("survivor\n");
+        assertThat(new File(folder, "unowned")).exists();
+    }
