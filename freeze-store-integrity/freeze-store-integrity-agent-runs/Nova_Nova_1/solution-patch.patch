+    private static class DescriptionRuleViolationFileNameStrategy implements RuleViolationFileNameStrategy {
+        @Override
+        public String createRuleFileName(String ruleDescription) {
+            String sanitized = ruleDescription.replaceAll("[^A-Za-z0-9_-]", "_");
+            if (sanitized.isEmpty()) {
+                sanitized = "rule";
+            }
+            String hash = sha256(ruleDescription);
+            String suffix = "-" + hash;
+            int available = MAX_FILE_NAME_LENGTH - suffix.length();
+            if (sanitized.length() <= available) {
+                return sanitized + suffix;
+            }
+
+            Matcher matcher = DESCRIPTION_WORD_PATTERN.matcher(ruleDescription);
+            String wordToKeep = null;
+            while (matcher.find()) {
+                wordToKeep = matcher.group();
+            }
+            if (wordToKeep == null) {
+                wordToKeep = "rule";
+            }
+            if (wordToKeep.length() > available - 1) {
+                wordToKeep = wordToKeep.substring(0, Math.max(4, available - 1));
+            }
+            int prefixLength = Math.max(0, available - wordToKeep.length() - 1);
+            String prefix = sanitized.substring(0, Math.min(prefixLength, sanitized.length()));
+            String result = prefix.isEmpty() ? wordToKeep + suffix : prefix + "_" + wordToKeep + suffix;
+            return result.substring(0, Math.min(MAX_FILE_NAME_LENGTH, result.length()));
+        }
+
+        private static String sha256(String value) {
+            try {
+                byte[] digest = MessageDigest.getInstance("SHA-256").digest(value.getBytes(UTF_8));
+                StringBuilder result = new StringBuilder();
+                for (byte current : digest) {
+                    result.append(String.format("%02x", current & 0xff));
+                }
+                return result.toString();
+            } catch (NoSuchAlgorithmException e) {
+                throw new IllegalStateException(e);
+            }
+        }
+    }
