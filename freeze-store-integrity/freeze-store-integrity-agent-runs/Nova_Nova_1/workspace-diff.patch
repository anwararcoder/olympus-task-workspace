+        for (String integrityValue : Arrays.asList("repair", "fail")) {
+            threads.add(new Thread(() -> initialize(integrity(store, integrityValue))));
+        }
+        threads.forEach(thread -> thread.setUncaughtExceptionHandler((failed, e) -> failures.add(e)));
