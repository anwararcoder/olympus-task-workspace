+package com.tngtech.archunit.library.freeze;
+
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.LinkedList;
+import java.util.List;
+import java.util.Properties;
+
+import com.google.common.collect.ImmutableList;
+import com.tngtech.archunit.lang.ArchRule;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+import static com.tngtech.archunit.lang.syntax.ArchRuleDefinition.classes;
+import static java.nio.charset.StandardCharsets.UTF_8;
+import static java.util.Arrays.asList;
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+public class TextFileBasedViolationStoreIntegrityTest {
+
+    @TempDir
+    Path temporaryFolder;
+
+    @Test
+    public void description_names_are_safe_deterministic_and_keep_a_late_word() throws IOException {
+        File folder = temporaryFolder.resolve("description").toFile();
+        TextFileBasedViolationStore store = new TextFileBasedViolationStore();
+        store.initialize(properties(folder, "default.fileNames", "description"));
+
+        String description = "xxxx xxxx xxxx xxxx xxxx xxxx xxxx xxxx xxxx xxxx xxxx xxxx "
+                + "xxxx xxxx xxxx xxxx xxxx xxxx xxxx xxxx xxxx xxxx xxxx xxxx "
+                + "LateMeaningfulRule";
+        store.save(rule(description), ImmutableList.of("violation"));
+
+        String fileName = readIndex(folder).getProperty(description);
+        assertThat(fileName).contains("LateMeaningfulRule");
+        assertThat(fileName).matches("[A-Za-z0-9_-]+");
+        assertThat(fileName).hasSizeLessThanOrEqualTo(200);
+        assertThat(fileName).isNotEqualTo("stored.rules");
+
+        TextFileBasedViolationStore secondStore = new TextFileBasedViolationStore();
+        secondStore.initialize(properties(folder, "default.fileNames", "description"));
+        secondStore.save(rule(description + " other"), ImmutableList.of("violation"));
+        assertThat(readIndex(folder).getProperty(description + " other")).isNotEqualTo(fileName);
+    }
+
+    @Test
+    public void repair_removes_broken_and_resolved_entries_and_moves_misplaced_files() throws IOException {
+        File folder = temporaryFolder.resolve("repair").toFile();
+        folder.mkdirs();
+        ArchRule broken = rule("broken rule");
+        ArchRule resolved = rule("resolved rule");
+        ArchRule misplaced = rule("misplaced rule");
+        Properties index = new Properties();
+        index.setProperty(broken.getDescription(), "missing");
+        index.setProperty(resolved.getDescription(), "empty");
+        index.setProperty(misplaced.getDescription(), "old");
+        writeIndex(folder, index);
+        Files.write(new File(folder, "empty").toPath(), "\r\n".getBytes(UTF_8));
+        Files.write(new File(folder, "old").toPath(), "violation\n".getBytes(UTF_8));
+        Files.write(new File(folder, "unowned").toPath(), "keep\n".getBytes(UTF_8));
+
+        TextFileBasedViolationStore store = new TextFileBasedViolationStore(description -> description.replace(' ', '-'));
+        store.initialize(properties(folder, "default.integrity", "repair"));
+
+        Properties repaired = readIndex(folder);
+        assertThat(repaired).doesNotContainKey(broken.getDescription());
+        assertThat(repaired).doesNotContainKey(resolved.getDescription());
+        assertThat(repaired.getProperty(misplaced.getDescription())).isEqualTo("misplaced-rule");
+        assertThat(new File(folder, "empty")).doesNotExist();
+        assertThat(new File(folder, "old")).doesNotExist();
+        assertThat(new File(folder, "misplaced-rule")).hasContent("violation\n");
+        assertThat(new File(folder, "unowned")).hasContent("keep\n");
+    }
+
+    @Test
+    public void fail_reports_problems_without_changing_the_index() throws IOException {
+        File folder = temporaryFolder.resolve("fail").toFile();
+        folder.mkdirs();
+        ArchRule broken = rule("broken rule");
+        Properties index = new Properties();
+        index.setProperty(broken.getDescription(), "missing");
+        writeIndex(folder, index);
+        Files.write(new File(folder, "unowned").toPath(), "keep\n".getBytes(UTF_8));
+        byte[] originalIndex = Files.readAllBytes(new File(folder, "stored.rules").toPath());
+
+        TextFileBasedViolationStore store = new TextFileBasedViolationStore();
+        assertThatThrownBy(() -> store.initialize(properties(folder, "default.integrity", "fail")))
+                .isInstanceOf(StoreInitializationFailedException.class)
+                .hasMessageContaining("broken entry")
+                .hasMessageContaining("unowned file");
+        assertThat(Files.readAllBytes(new File(folder, "stored.rules").toPath())).isEqualTo(originalIndex);
+    }
+
+    @Test
+    public void fail_does_not_create_an_absent_index_when_the_folder_has_an_unowned_file() throws IOException {
+        File folder = temporaryFolder.resolve("absent-index").toFile();
+        folder.mkdirs();
+        Files.write(new File(folder, "unowned").toPath(), "keep\n".getBytes(UTF_8));
+
+        TextFileBasedViolationStore store = new TextFileBasedViolationStore();
+        assertThatThrownBy(() -> store.initialize(properties(folder,
+                "default.allowStoreCreation", "true",
+                "default.integrity", "fail")))
+                .isInstanceOf(StoreInitializationFailedException.class)
+                .hasMessageContaining("unowned file");
+        assertThat(new File(folder, "stored.rules")).doesNotExist();
+    }
+
+    @Test
+    public void repair_forgets_empty_known_rules_and_does_not_store_empty_unknown_rules() throws IOException {
+        File folder = temporaryFolder.resolve("forget").toFile();
+        TextFileBasedViolationStore store = new TextFileBasedViolationStore();
+        Properties properties = properties(folder, "default.integrity", "repair");
+        store.initialize(properties);
+        ArchRule known = rule("known rule");
+        store.save(known, ImmutableList.of("violation"));
+        String fileName = readIndex(folder).getProperty(known.getDescription());
+
+        store.save(known, ImmutableList.of());
+        store.save(rule("unknown rule"), ImmutableList.of());
+
+        assertThat(readIndex(folder)).doesNotContainKey(known.getDescription());
+        assertThat(readIndex(folder)).doesNotContainKey("unknown rule");
+        assertThat(new File(folder, fileName)).doesNotExist();
+        assertThat(folder.list()).containsExactly("stored.rules");
+    }
+
+    @Test
+    public void carriage_returns_are_preserved_in_stored_violations() throws IOException {
+        File folder = temporaryFolder.resolve("carriage-return").toFile();
+        TextFileBasedViolationStore store = new TextFileBasedViolationStore();
+        store.initialize(properties(folder));
+        List<String> expected = ImmutableList.of("before\rafter", "\r");
+
+        store.save(rule("carriage returns"), expected);
+
+        assertThat(store.getViolations(rule("carriage returns"))).containsExactlyElementsOf(expected);
+    }
+
+    @Test
+    public void save_rejects_a_strategy_that_names_the_index() throws IOException {
+        File folder = temporaryFolder.resolve("index-protection").toFile();
+        TextFileBasedViolationStore store = new TextFileBasedViolationStore(__ -> "stored.rules");
+        store.initialize(properties(folder));
+
+        assertThatThrownBy(() -> store.save(rule("unsafe"), ImmutableList.of("violation")))
+                .isInstanceOf(StoreUpdateFailedException.class);
+        assertThat(readIndex(folder)).isEmpty();
+        assertThat(folder.list()).containsExactly("stored.rules");
+    }
+
+    private Properties properties(File folder, String... additional) {
+        List<String> values = new LinkedList<>();
+        values.add("default.path");
+        values.add(folder.getAbsolutePath());
+        values.add("default.allowStoreCreation");
+        values.add("true");
+        values.addAll(asList(additional));
+        Properties result = new Properties();
+        while (!values.isEmpty()) {
+            result.setProperty(values.remove(0), values.remove(0));
+        }
+        return result;
+    }
+
+    private Properties readIndex(File folder) throws IOException {
+        Properties result = new Properties();
+        try (FileInputStream input = new FileInputStream(new File(folder, "stored.rules"))) {
+            result.load(input);
+        }
+        return result;
+    }
+
+    private void writeIndex(File folder, Properties properties) throws IOException {
+        try (java.io.FileOutputStream output = new java.io.FileOutputStream(new File(folder, "stored.rules"))) {
+            properties.store(output, "");
+        }
+    }
+
+    private ArchRule rule(String description) {
+        return classes().should().bePublic().as(description);
+    }
+}
