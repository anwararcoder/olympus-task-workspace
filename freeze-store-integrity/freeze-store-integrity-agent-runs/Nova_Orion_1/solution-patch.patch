+
+        String fileName = readProperties(new File(configuredFolder, "stored.rules")).getProperty(rule1.getDescription());
+        File ruleFile = new File(configuredFolder, fileName);
+
+        // Share the same file with rule2
+        ArchRule rule2 = rule("rule2");
+        Properties properties = readProperties(new File(configuredFolder, "stored.rules"));
+        properties.setProperty(rule2.getDescription(), fileName);
+        writeProperties(new File(configuredFolder, "stored.rules"), properties);
+
+        // re-initialize repairStore so it reloads the shared property
+        repairStore.initialize(repairStoreProperties());
+
+        // Save no violations for rule1
+        repairStore.save(rule1, ImmutableList.of());
+
+        assertThat(repairStore.contains(rule1)).isFalse();
+        assertThat(repairStore.contains(rule2)).isTrue();
+        assertThat(ruleFile).exists();
+
+        // Now save no violations for rule2 (no longer shared)
+        repairStore.save(rule2, ImmutableList.of());
+
+        assertThat(repairStore.contains(rule2)).isFalse();
+        assertThat(ruleFile).doesNotExist();
+    }
