+#!/usr/bin/env bash
+set -euo pipefail
+
+INVOKE_DIR="$PWD"
+cd "$(dirname "$0")"
+
+usage() {
+  echo "Usage: $0 --output_path <path> {base|new}" >&2
+  exit 2
+}
+
+OUTPUT_PATH=""
+MODE=""
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --output_path)
+      [[ $# -ge 2 ]] || usage
+      OUTPUT_PATH="$2"
+      shift 2
+      ;;
+    base|new)
+      MODE="$1"
+      shift
+      ;;
+    *)
+      usage
+      ;;
+  esac
+done
+
+if [[ -z "$OUTPUT_PATH" || -z "$MODE" ]]; then
+  usage
+fi
+
+case "$OUTPUT_PATH" in
+  /*) ;;
+  *) OUTPUT_PATH="$INVOKE_DIR/$OUTPUT_PATH" ;;
+esac
+
+if [[ -L "$OUTPUT_PATH" || ( -e "$OUTPUT_PATH" && ! -f "$OUTPUT_PATH" ) ]]; then
+  echo "Output path $OUTPUT_PATH is not a regular file" >&2
+  exit 2
+fi
+
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+# a report an earlier run left at the output path must never pass for the result of this run
+rm -f "$OUTPUT_PATH"
+
+case "$MODE" in
+  base)
+    GRADLE_TARGET="freezeStoreBaselineTest"
+    RESULT_DIR="archunit/build/test-results/freezeStoreBaselineTest"
+    # the baseline suites guard existing behaviour, so they always run as the base commit ships them,
+    # whatever a change did to their sources, committed or not
+    BASELINE_TESTS=(
+      archunit/src/test/java/com/tngtech/archunit/library/freeze/TextFileBasedViolationStoreTest.java
+      archunit/src/test/java/com/tngtech/archunit/library/freeze/TextFileBasedViolationStoreConcurrencyTest.java
+      archunit/src/test/java/com/tngtech/archunit/library/freeze/FreezingArchRuleTest.java
+    )
+    git -c safe.directory="$PWD" checkout ab6a677dd4b678f0ab1d9481df17222916705170 -- "${BASELINE_TESTS[@]}" \
+      || git -c safe.directory="$PWD" checkout HEAD -- "${BASELINE_TESTS[@]}" \
+      || echo "Could not restore the baseline test sources, running them as they are" >&2
+    ;;
+  new)
+    GRADLE_TARGET="freezeStoreMaintenanceTest"
+    RESULT_DIR="archunit/build/test-results/freezeStoreMaintenanceTest"
+    ;;
+esac
+
+SCRATCH="$(mktemp -d)"
+STAGED=""
+trap 'rm -rf "$SCRATCH"; [[ -z "$STAGED" ]] || rm -f "$STAGED"' EXIT
+
+rm -rf "$RESULT_DIR"
+
+# the jdk9main compilation shares this output directory and can prune classes of an incremental
+# build, so every run compiles it from scratch
+rm -rf archunit/build/classes/java/main
