+    @Test
+    public void description_names_are_deterministic_safe_and_keep_a_late_word() throws IOException {
+        Properties properties = propertiesOf(
+                "default.path", folder().getAbsolutePath(),
+                "default.allowStoreCreation", "true",
+                "default.fileNames", "description");
+        ArchRule first = rule("a very long description " + repeat("prefix ", 80) + "lateword");
+        ArchRule second = rule("a very long description " + repeat("prefix ", 80) + "otherword");
+
+        TextFileBasedViolationStore firstStore = new TextFileBasedViolationStore();
+        firstStore.initialize(properties);
+        firstStore.save(first, ImmutableList.of("violation"));
+        firstStore.save(second, ImmutableList.of("violation"));
+        Properties storedRules = readProperties(index());
+
+        String firstName = storedRules.getProperty(first.getDescription());
+        String secondName = storedRules.getProperty(second.getDescription());
+        assertThat(firstName).contains("lateword").matches("[A-Za-z0-9_-]+").hasSizeLessThanOrEqualTo(200);
+        assertThat(secondName).contains("otherword").isNotEqualTo(firstName).doesNotContain("stored.rules");
+    }
+
+    @Test
+    public void repair_removes_empty_and_broken_entries_moves_misplaced_files_and_leaves_unsafe_files_alone() throws IOException {
+        ArchRule empty = rule("empty");
+        ArchRule broken = rule("broken");
+        ArchRule misplaced = rule("misplaced");
+        ArchRule occupied = rule("occupied");
+        Map<String, String> index = new LinkedHashMap<>();
+        index.put(empty.getDescription(), "empty-old");
+        index.put(broken.getDescription(), "missing");
+        index.put(misplaced.getDescription(), "misplaced-old");
+        index.put(occupied.getDescription(), "occupied-old");
+        writeIndex(index);
+        Files.write(folder().toPath().resolve("empty-old"), "\r\n\r".getBytes(UTF_8));
+        Files.write(folder().toPath().resolve("misplaced-old"), "kept violation\n".getBytes(UTF_8));
+        Files.write(folder().toPath().resolve("occupied-old"), "occupied violation\n".getBytes(UTF_8));
+        Files.write(folder().toPath().resolve("target"), "unowned target\n".getBytes(UTF_8));
+
+        TextFileBasedViolationStore store = new TextFileBasedViolationStore(description -> {
+            if (description.equals("misplaced")) return "misplaced-new";
+            if (description.equals("occupied")) return "target";
+            return description;
+        });
+        store.initialize(propertiesOf(
+                "default.path", folder().getAbsolutePath(),
+                "default.allowStoreUpdate", "true",
+                "default.integrity", "repair"));
+
+        Properties repaired = readProperties(index());
+        assertThat(repaired).doesNotContainKey(empty.getDescription()).doesNotContainKey(broken.getDescription());
+        assertThat(repaired.getProperty(misplaced.getDescription())).isEqualTo("misplaced-new");
+        assertThat(repaired.getProperty(occupied.getDescription())).isEqualTo("occupied-old");
+        assertThat(folder().toPath().resolve("empty-old")).doesNotExist();
+        assertThat(folder().toPath().resolve("misplaced-old")).doesNotExist();
+        assertThat(content(folder().toPath().resolve("misplaced-new"))).isEqualTo("kept violation\n");
+        assertThat(content(folder().toPath().resolve("occupied-old"))).isEqualTo("occupied violation\n");
+        assertThat(content(folder().toPath().resolve("target"))).isEqualTo("unowned target\n");
+    }
