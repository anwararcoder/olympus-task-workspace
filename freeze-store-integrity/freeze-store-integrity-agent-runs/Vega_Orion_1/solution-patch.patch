+
+    private void createHardLinkOrSkip(Path link, Path existing) throws IOException {
+        try {
+            Files.createLink(link, existing);
+        } catch (UnsupportedOperationException e) {
+            assumeThat(false).as("hard links are supported").isTrue();
+        }
+    }
+
+    private ViolationStore initializedStore(Properties properties) {
+        ViolationStore store = new TextFileBasedViolationStore();
+        store.initialize(properties);
+        return store;
+    }
+
+    private Path writeFile(Path file, String content) throws IOException {
+        return Files.write(file, content.getBytes(UTF_8));
+    }
+
+    private void writeIndex(String... ruleDescriptionsAndFileNames) throws IOException {
+        writeIndex(propertiesOf(ruleDescriptionsAndFileNames));
+    }
+
+    private void writeIndex(Properties index) throws IOException {
+        try (FileOutputStream outputStream = new FileOutputStream(storeFolder.resolve("stored.rules").toFile())) {
+            index.store(outputStream, "");
+        }
+    }
+
+    private Properties readIndex() throws IOException {
+        Properties properties = new Properties();
+        try (FileInputStream inputStream = new FileInputStream(storeFolder.resolve("stored.rules").toFile())) {
+            properties.load(inputStream);
+        }
+        return properties;
+    }
+
+    private Properties repairProperties(String... additionalKeyValuePairs) {
+        Properties result = storeProperties("default.integrity", "repair");
+        result.putAll(propertiesOf(additionalKeyValuePairs));
+        return result;
+    }
+
+    private Properties storeProperties(String... additionalKeyValuePairs) {
+        Properties result = propertiesOf(
+                "default.path", storeFolder.toAbsolutePath().toString(),
+                "default.allowStoreCreation", String.valueOf(true));
+        result.putAll(propertiesOf(additionalKeyValuePairs));
+        return result;
+    }
+
+    private Properties propertiesOf(String... keyValuePairs) {
+        Properties result = new Properties();
+        List<String> keyValues = new LinkedList<>(asList(keyValuePairs));
+        while (!keyValues.isEmpty()) {
+            result.setProperty(keyValues.remove(0), keyValues.remove(0));
+        }
+        return result;
+    }
+
+    private ArchRule rule(String description) {
+        return classes().should().bePublic().as(description);
+    }
+}
