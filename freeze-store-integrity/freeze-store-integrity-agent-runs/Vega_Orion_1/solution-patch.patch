+    private enum Integrity {
+        IGNORE,
+        REPAIR;
+
+        static Integrity parse(String value) {
+            for (Integrity integrity : values()) {
+                if (integrity.toString().equals(value.trim().toLowerCase(Locale.ROOT))) {
+                    return integrity;
+                }
+            }
