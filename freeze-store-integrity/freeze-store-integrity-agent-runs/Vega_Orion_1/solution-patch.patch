+    private static class RuleFile {
+        private final Path path;
+        private final Object fileKey;
+
+        RuleFile(Path path, Object fileKey) {
+            this.path = path;
+            this.fileKey = fileKey;
+        }
+
+        /**
+         * @return An object that is equal for all {@link RuleFile RuleFiles} denoting the same file, even through symbolic or hard links
+         */
+        Object identityAmong(Set<Object> knownIdentities) {
+            if (fileKey != null) {
+                return fileKey;
+            }
+            // the file system does not provide file keys, so we have to compare with all files known so far
+            return knownIdentities.stream()
+                    .filter(identity -> identity instanceof Path && isSameFile((Path) identity))
+                    .findFirst()
+                    .orElse(path);
+        }
+
+        private boolean isSameFile(Path other) {
+            try {
+                return Files.isSameFile(path, other);
+            } catch (IOException e) {
+                return false;
+            }
+        }
+
+        boolean isResolved() {
+            try (InputStream inputStream = new BufferedInputStream(Files.newInputStream(path))) {
+                for (int next = inputStream.read(); next != -1; next = inputStream.read()) {
+                    if (next != '\n' && next != '\r') {
+                        return false;
+                    }
+                }
+                return true;
+            } catch (IOException e) {
+                log.warn("Cannot read rule violation file {}", path, e);
+                return false;
+            }
+        }
+
+        void delete() throws IOException {
+            if (Files.isSymbolicLink(path)) {
+                Files.deleteIfExists(path.toRealPath());
+            }
+            Files.deleteIfExists(path);
+        }
+
+        @Override
+        public String toString() {
+            return path.toAbsolutePath().toString();
+        }
+    }
