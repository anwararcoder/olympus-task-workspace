+
+    @Test
+    public void repair_fails_to_save_if_file_of_forgotten_rule_cannot_be_deleted() throws IOException {
+        writeFile(storeFolder.resolve("file"), "violation");
+        writeIndex("some rule", "file");
+        ViolationStore store = initializedStore(repairProperties());
+        assumeThat(storeFolder.toFile().setWritable(false)).as("store folder can be made read-only").isTrue();
+        assumeThat(Files.isWritable(storeFolder)).as("store folder is read-only").isFalse();
+
+        assertThatThrownBy(() -> store.save(rule("some rule"), ImmutableList.of()))
+                .isInstanceOf(StoreUpdateFailedException.class)
+                .hasMessageContaining("some rule");
+
+        assertThat(store.contains(rule("some rule"))).isTrue();
+        assertThat(readIndex()).containsOnlyKeys("some rule");
+        assertThat(storeFolder.resolve("file")).hasContent("violation");
