+
+    @Test
+    public void repair_only_removes_entry_when_forgetting_rule_sharing_its_file() throws IOException {
+        Path target = writeFile(outsideFolder.resolve("target"), "violation");
+        Files.createSymbolicLink(storeFolder.resolve("firstLink"), target);
+        Files.createSymbolicLink(storeFolder.resolve("secondLink"), target);
+        writeFile(storeFolder.resolve("shared"), "violation");
+        writeIndex(
+                "first outside rule", "firstLink",
+                "second outside rule", "secondLink",
+                "first shared rule", "shared",
+                "second shared rule", "shared");
+        ViolationStore store = initializedStore(repairProperties());
+
+        store.save(rule("first outside rule"), ImmutableList.of());
