+    }
+
+    @Test
+    void repair_discards_links_outside_the_store_root_even_if_their_targets_are_inside() throws IOException {
+        Path nestedTarget = writeFile("nested-target", "");
+        Path outsideTarget = writeFile("outside-target", "");
+        Path directory = Files.createDirectory(storeFolder.resolve("directory"));
+        Path nestedLink = createLink(directory.resolve("link"), nestedTarget, true);
+        Path outsideLink = createLink(temporaryFolder.resolve("outside-link"), outsideTarget, true);
+        writeIndex("nested rule", "directory/link", "outside rule", outsideLink.toString());
+
+        initializeStore("repair");
+
+        assertThat(readIndex()).isEmpty();
+        assertThat(nestedTarget).exists();
+        assertThat(outsideTarget).exists();
+        assertThat(Files.isSymbolicLink(nestedLink)).isTrue();
+        assertThat(Files.isSymbolicLink(outsideLink)).isTrue();
+    }
+
+    @Test
+    void repair_deletes_only_the_indexed_hard_link_of_a_resolved_file() throws IOException {
+        Path target = writeFile("unindexed", "");
+        Path alias = createLink("alias", target, false);
+        writeIndex("some rule", "alias");
+
+        initializeStore("repair");
+
+        assertThat(readIndex()).isEmpty();
+        assertThat(target).exists();
+        assertThat(alias).doesNotExist();
+    }
+
+    @Test
+    void saving_no_violations_for_an_unknown_rule_does_not_create_an_entry_or_file() throws IOException {
+        TextFileBasedViolationStore store = new TextFileBasedViolationStore(description -> {
+            throw new AssertionError("No file name should be requested");
+        });
+        store.initialize(storeProperties("repair"));
+        byte[] originalIndex = Files.readAllBytes(indexFile());
+
+        store.save(rule("unknown rule"), ImmutableList.of());
+
+        assertThat(store.contains(rule("unknown rule"))).isFalse();
+        assertThat(Files.readAllBytes(indexFile())).isEqualTo(originalIndex);
+        assertThat(storeFolder.toFile().list()).containsExactly("stored.rules");
+    }
+
+    @ParameterizedTest
+    @ValueSource(strings = {"some rule", "multi\nline rule", "multi\r\nline rule"})
+    void saving_no_violations_for_a_known_rule_forgets_the_rule_and_its_file(String description) throws IOException {
+        TextFileBasedViolationStore store = initializeStore("repair");
+        ArchRule rule = rule(description);
+        store.save(rule, ImmutableList.of("violation"));
+        Path violations = storeFolder.resolve((String) readIndex().values().iterator().next());
+
+        store.save(rule, ImmutableList.of());
+
+        assertThat(store.contains(rule)).isFalse();
+        assertThat(readIndex()).isEmpty();
+        assertThat(violations).doesNotExist();
+    }
+
+    @Test
+    void saving_no_violations_forgets_a_rule_even_if_its_file_is_already_missing() throws IOException {
+        writeFile("violations", "violation\n");
+        writeIndex("some rule", "violations");
+        TextFileBasedViolationStore store = initializeStore("repair");
+        Files.delete(storeFolder.resolve("violations"));
+
+        store.save(rule("some rule"), ImmutableList.of());
+
+        assertThat(store.contains(rule("some rule"))).isFalse();
+        assertThat(readIndex()).isEmpty();
+    }
+
+    @ParameterizedTest
+    @ValueSource(strings = {"shared", "missing", "invalid\0name", "../outside"})
+    void saving_no_violations_removes_only_the_entry_when_its_file_name_is_shared(String fileName) throws IOException {
+        Path shared = writeFile("shared", "\n");
+        Path outside = Files.write(temporaryFolder.resolve("outside"), new byte[0]);
+        writeIndex("first rule", fileName, "second rule", fileName);
+        TextFileBasedViolationStore store = initializeStore("repair");
+
+        store.save(rule("first rule"), ImmutableList.of());
+
+        assertThat(store.contains(rule("first rule"))).isFalse();
+        assertThat(store.contains(rule("second rule"))).isTrue();
+        assertThat(readIndex()).containsOnlyKeys("second rule").containsEntry("second rule", fileName);
+        assertThat(shared).hasContent("\n");
+        assertThat(outside).exists();
+    }
+
+    @ParameterizedTest
+    @MethodSource("sharedFiles")
+    void saving_no_violations_preserves_shared_links_then_deletes_only_the_last_referenced_path(
+            boolean symbolic, boolean outside, String contents) throws IOException {
+        Path target = Files.write((outside ? temporaryFolder : storeFolder).resolve("target"), contents.getBytes(UTF_8));
+        Path alias = createLink("alias", target, symbolic);
+        writeIndex("target rule", target.toString(), "alias rule", "alias");
+        TextFileBasedViolationStore store = initializeStore("repair");
+
+        store.save(rule("target rule"), ImmutableList.of());
+
+        assertThat(readIndex()).containsOnlyKeys("alias rule");
+        assertThat(Files.exists(alias, NOFOLLOW_LINKS)).isTrue();
+        assertThat(Files.readAllBytes(target)).isEqualTo(contents.getBytes(UTF_8));
+
+        store.save(rule("alias rule"), ImmutableList.of());
+
+        assertThat(readIndex()).isEmpty();
+        assertThat(Files.exists(alias, NOFOLLOW_LINKS)).isFalse();
+        assertThat(Files.exists(target)).isEqualTo(!symbolic);
+    }
+
+    @Test
+    void saving_no_violations_deletes_an_outside_file_when_its_last_shared_entry_is_forgotten() throws IOException {
+        Path outside = Files.write(temporaryFolder.resolve("outside"), new byte[0]);
+        writeIndex("first rule", "../outside", "second rule", "../outside");
+        TextFileBasedViolationStore store = initializeStore("repair");
+
+        store.save(rule("first rule"), ImmutableList.of());
+        assertThat(outside).exists();
+
+        store.save(rule("second rule"), ImmutableList.of());
+
+        assertThat(readIndex()).isEmpty();
+        assertThat(outside).doesNotExist();
+    }
+
+    @Test
+    void saving_no_violations_fails_and_leaves_the_entry_if_the_file_cannot_be_deleted() throws IOException {
+        writeFile("violations", "violation\n");
+        writeIndex("some rule", "violations");
+        TextFileBasedViolationStore store = initializeStore("repair");
+        Files.delete(storeFolder.resolve("violations"));
+        Path directory = Files.createDirectory(storeFolder.resolve("violations"));
+        Path child = Files.write(directory.resolve("child"), new byte[0]);
+        byte[] originalIndex = Files.readAllBytes(indexFile());
+
+        assertThatThrownBy(() -> store.save(rule("some rule"), ImmutableList.of()))
+                .isInstanceOf(StoreUpdateFailedException.class)
+                .hasCauseInstanceOf(IOException.class);
+
+        assertThat(store.contains(rule("some rule"))).isTrue();
+        assertThat(Files.readAllBytes(indexFile())).isEqualTo(originalIndex);
+        assertThat(child).exists();
+    }
+
+    private TextFileBasedViolationStore initializeStore(String integrity) {
+        TextFileBasedViolationStore store = new TextFileBasedViolationStore();
+        store.initialize(storeProperties(integrity));
+        return store;
+    }
+
+    private Properties storeProperties(String integrity) {
+        Properties properties = new Properties();
+        properties.setProperty("default.path", storeFolder.toString());
+        properties.setProperty("default.allowStoreCreation", "true");
+        if (integrity != null) {
+            properties.setProperty("default.integrity", integrity);
+        }
+        return properties;
+    }
+
+    private Path writeFile(String fileName, String contents) throws IOException {
+        return Files.write(storeFolder.resolve(fileName), contents.getBytes(UTF_8));
+    }
+
+    private Path createLink(String fileName, Path target, boolean symbolic) throws IOException {
+        return createLink(storeFolder.resolve(fileName), target, symbolic);
+    }
+
+    private Path createLink(Path link, Path target, boolean symbolic) throws IOException {
+        try {
+            return symbolic ? Files.createSymbolicLink(link, target) : Files.createLink(link, target);
+        } catch (UnsupportedOperationException e) {
+            throw new TestAbortedException("File system does not support links", e);
+        } catch (FileSystemException e) {
+            if (symbolic && System.getProperty("os.name").startsWith("Windows")) {
+                throw new TestAbortedException("Creating symbolic links requires privileges on Windows", e);
+            }
+            throw e;
+        }
+    }
+
+    private void writeIndex(String... keyValuePairs) throws IOException {
+        Properties properties = new Properties();
+        for (int index = 0; index < keyValuePairs.length; index += 2) {
+            properties.setProperty(keyValuePairs[index], keyValuePairs[index + 1]);
+        }
+        try (OutputStream output = Files.newOutputStream(indexFile())) {
+            properties.store(output, "");
+        }
+    }
+
+    private Properties readIndex() throws IOException {
+        Properties properties = new Properties();
+        try (InputStream input = Files.newInputStream(indexFile())) {
+            properties.load(input);
+        }
+        return properties;
+    }
+
+    private Path indexFile() {
+        return storeFolder.resolve("stored.rules");
+    }
+
+    private ArchRule rule(String description) {
+        return classes().should().bePublic().as(description);
+    }
+}
