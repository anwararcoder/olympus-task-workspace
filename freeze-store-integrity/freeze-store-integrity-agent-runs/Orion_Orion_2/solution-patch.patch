+
+    @ParameterizedTest
+    @NullSource
+    @ValueSource(strings = "ignore")
+    void ignores_integrity_by_default_and_when_configured(String integrity) throws IOException {
+        Path resolved = writeFile("resolved", "\n\r\n");
+        Path orphan = writeFile("orphan", "");
+        Path directory = Files.createDirectory(storeFolder.resolve("directory"));
+        writeIndex("resolved rule", "resolved", "missing rule", "missing", "directory rule", "directory", "invalid rule", "invalid\0name");
+        byte[] originalIndex = Files.readAllBytes(indexFile());
+
+        TextFileBasedViolationStore store = initializeStore(integrity);
+
+        assertThat(store.contains(rule("resolved rule"))).isTrue();
+        assertThat(store.contains(rule("missing rule"))).isTrue();
+        assertThat(store.contains(rule("directory rule"))).isTrue();
+        assertThat(store.contains(rule("invalid rule"))).isTrue();
+        assertThat(Files.readAllBytes(indexFile())).isEqualTo(originalIndex);
+        assertThat(resolved).hasContent("\n\r\n");
+        assertThat(orphan).exists();
+        assertThat(directory).isDirectory();
+    }
+
+    @Test
+    void repair_discards_broken_entries_without_deleting_their_targets() throws IOException {
+        Path valid = writeFile("valid", "violation\n");
+        Path directory = Files.createDirectory(storeFolder.resolve("directory"));
+        Path nested = Files.write(directory.resolve("nested"), new byte[0]);
+        Path relativeOutside = Files.write(temporaryFolder.resolve("relative-outside"), new byte[0]);
+        Path absoluteOutside = Files.write(temporaryFolder.resolve("absolute-outside"), new byte[0]);
+        writeIndex("valid rule", "valid", "missing rule", "missing", "directory rule", "directory", "nested rule", "directory/nested",
+                "relative outside rule", "../relative-outside", "absolute outside rule", absoluteOutside.toString(),
+                "invalid rule", "invalid\0name", "empty name rule", "");
+
+        TextFileBasedViolationStore store = initializeStore("repair");
+
+        assertThat(readIndex()).containsOnlyKeys("valid rule");
+        assertThat(store.contains(rule("valid rule"))).isTrue();
+        assertThat(store.contains(rule("missing rule"))).isFalse();
+        assertThat(valid).hasContent("violation\n");
+        assertThat(directory).isDirectory();
+        assertThat(nested).exists();
+        assertThat(relativeOutside).exists();
+        assertThat(absoluteOutside).exists();
+    }
+
+    @ParameterizedTest
