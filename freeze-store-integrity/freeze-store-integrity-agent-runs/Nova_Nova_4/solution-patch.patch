+        }
+    }
+
+    private static class IntegrityReport {
+        private final List<StoreEntry> entries;
+        private final List<Path> unownedFiles;
+
+        private IntegrityReport(List<StoreEntry> entries, List<Path> unownedFiles) {
+            this.entries = entries;
+            this.unownedFiles = unownedFiles;
+        }
+
+        private boolean hasProblems() {
+            return !unownedFiles.isEmpty() || entries.stream().anyMatch(entry -> entry.shared || entry.broken || entry.empty
+                    || entry.misplaced || entry.colliding || entry.occupied);
+        }
+
+        private List<StoreEntry> entriesInDescriptionOrder() {
+            return entries.stream().sorted(Comparator.comparing(entry -> entry.description)).collect(toList());
+        }
+    }
+
+    @FunctionalInterface
+    private interface EntryCondition {
+        boolean matches(StoreEntry entry);
+    }
