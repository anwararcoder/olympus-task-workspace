+            Path recordedPath = storeFolder.toPath().resolve(recordedName).normalize();
+            if (!recordedPath.equals(resolvedPath)) {
+                Files.deleteIfExists(recordedPath);
+            }
+        } catch (IOException e) {
+            throw new StoreInitializationFailedException(e);
+        }
+    }
+
+    private void moveNamedFile(Path resolvedPath, Path recordedPath, String derivedName) {
+        Path destination = storeFolder.toPath().resolve(derivedName).normalize();
+        try {
+            Files.move(resolvedPath, destination);
+            if (!recordedPath.equals(resolvedPath)) {
