+
+    @Test
+    void description_names_are_safe_deterministic_and_distinct() throws IOException {
+        File folder = temporaryFolder.resolve("store").toFile();
+        TextFileBasedViolationStore first = new TextFileBasedViolationStore();
+        first.initialize(properties(folder, "default.fileNames", "description"));
+        ArchRule firstRule = rule("a very long description whose final meaningfulword survives truncation");
+        ArchRule secondRule = rule("a very long description whose final anotherword survives truncation");
+
+        first.save(firstRule, ImmutableList.of("violation"));
+        first.save(secondRule, ImmutableList.of("violation"));
+
+        Properties index = readProperties(new File(folder, "stored.rules"));
+        String firstName = index.getProperty(firstRule.getDescription());
+        String secondName = index.getProperty(secondRule.getDescription());
+        assertThat(firstName).isNotEqualTo(secondName)
+                .matches("[A-Za-z0-9_-]+")
+                .hasSizeLessThanOrEqualTo(200)
+                .contains("meaningfulword");
+        assertThat(firstName).isNotEqualTo("stored.rules");
+
+        TextFileBasedViolationStore second = new TextFileBasedViolationStore();
+        second.initialize(properties(folder, "default.fileNames", "description"));
+        second.save(rule("a different rule"), ImmutableList.of("violation"));
+        assertThat(readProperties(new File(folder, "stored.rules")).getProperty("a different rule"))
+                .matches("[A-Za-z0-9_-]+");
+    }
+
+    @Test
+    void repair_discards_broken_and_empty_entries_moves_misplaced_entries_and_leaves_unowned_files() throws IOException {
+        File folder = temporaryFolder.resolve("store").toFile();
+        folder.mkdirs();
+        Properties index = new Properties();
+        index.setProperty("broken rule", "missing");
+        index.setProperty("empty rule", "empty");
+        index.setProperty("moved rule", "wrong");
+        writeProperties(new File(folder, "stored.rules"), index);
+        Files.write(new File(folder, "empty").toPath(), "\r".getBytes(UTF_8));
+        Files.write(new File(folder, "wrong").toPath(), "violation\n".getBytes(UTF_8));
+        Files.write(new File(folder, "unowned").toPath(), "unowned\n".getBytes(UTF_8));
+
+        TextFileBasedViolationStore store = new TextFileBasedViolationStore(description -> description + ".txt");
+        store.initialize(properties(folder,
+                "default.integrity", "repair",
+                "default.allowStoreUpdate", "true"));
+
+        Properties repaired = readProperties(new File(folder, "stored.rules"));
+        assertThat(repaired).containsOnlyKeys("moved rule");
+        assertThat(repaired.getProperty("moved rule")).isEqualTo("moved rule.txt");
+        assertThat(new File(folder, "moved rule.txt")).hasContent("violation\n");
+        assertThat(new File(folder, "wrong")).doesNotExist();
+        assertThat(new File(folder, "unowned")).exists();
+    }
