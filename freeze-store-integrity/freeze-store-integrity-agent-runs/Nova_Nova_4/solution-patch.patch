+    private static String createDescriptionFileName(String description) {
+        String sanitized = DESCRIPTION_FILE_CHARACTER_PATTERN.matcher(description).replaceAll("_");
+        Matcher words = DESCRIPTION_WORD_PATTERN.matcher(description);
+        String lastWord = null;
+        while (words.find()) {
+            lastWord = words.group();
+        }
+        if (lastWord == null) {
+            lastWord = "rule";
+        }
+        if (lastWord.length() > 60) {
+            lastWord = lastWord.substring(lastWord.length() - 60);
+        }
+
+        String digest = sha256(description);
+        int prefixLength = Math.min(sanitized.length(), 200 - 2 - lastWord.length() - digest.length());
+        String prefix = prefixLength > 0 ? sanitized.substring(0, prefixLength) : "rule";
+        String result = prefix + "-" + lastWord + "-" + digest;
+        if (result.equals(STORED_RULES_FILE_NAME)) {
+            result = "rule-" + digest;
+        }
+        return result.substring(0, Math.min(result.length(), 200));
+    }
+
+    private static String sha256(String value) {
+        try {
+            byte[] digest = MessageDigest.getInstance("SHA-256").digest(value.getBytes(UTF_8));
+            StringBuilder result = new StringBuilder();
+            for (byte item : digest) {
+                result.append(String.format("%02x", item & 0xff));
+            }
+            return result.toString();
+        } catch (NoSuchAlgorithmException e) {
+            throw new IllegalStateException(e);
+        }
+    }
+
+    private enum IntegrityMode {
+        REPAIR,
+        FAIL,
+        IGNORE;
+
+        static IntegrityMode from(String value) {
+            if (INTEGRITY_REPAIR.equals(value)) {
+                return REPAIR;
+            }
+            if (INTEGRITY_FAIL.equals(value)) {
+                return FAIL;
+            }
+            if (INTEGRITY_IGNORE.equals(value)) {
+                return IGNORE;
+            }
+            throw new StoreInitializationFailedException(String.format(
+                    "Invalid %s value '%s'; accepted values are repair, fail and ignore", INTEGRITY_PROPERTY_NAME, value));
+        }
+    }
