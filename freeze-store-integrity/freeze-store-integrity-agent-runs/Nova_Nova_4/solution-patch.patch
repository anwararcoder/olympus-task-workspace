+        }
+    }
+
+    private List<Path> findDirectRegularFiles(Path folder) throws IOException {
+        if (!Files.exists(folder, NOFOLLOW_LINKS) || !Files.isDirectory(folder)) {
+            return Collections.emptyList();
+        }
+        try (java.util.stream.Stream<Path> files = Files.list(folder)) {
+            return files.filter(file -> !file.getFileName().toString().equals(STORED_RULES_FILE_NAME))
