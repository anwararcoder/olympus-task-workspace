+        try (java.io.FileOutputStream output = new java.io.FileOutputStream(new File(folder, "stored.rules"))) {
+            index.store(output, "");
+        }
+    }
+
+    private Properties loadIndex(File folder) throws IOException {
+        Properties result = new Properties();
+        try (FileInputStream input = new FileInputStream(new File(folder, "stored.rules"))) {
+            result.load(input);
+        }
+        return result;
+    }
+
+    private Properties properties(String... keyValues) {
+        Properties result = new Properties();
+        for (int i = 0; i < keyValues.length; i += 2) {
+            result.setProperty(keyValues[i], keyValues[i + 1]);
+        }
+        return result;
+    }
+
+    private ArchRule rule(String description) {
+        return classes().should().bePublic().as(description);
+    }
+
+    private static String repeat(char value, int count) {
+        StringBuilder result = new StringBuilder(count);
+        for (int i = 0; i < count; i++) {
+            result.append(value);
+        }
+        return result.toString();
+    }
+}
