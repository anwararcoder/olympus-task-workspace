+    }
+
+    private boolean sameFile(Path first, Path second) {
+        if (first.equals(second)) {
+            return true;
+        }
+        try {
+            return Files.isSameFile(first, second);
+        } catch (IOException e) {
+            return false;
+        }
+    }
