+    @Test
+    public void save_with_repair_fails_and_leaves_entry_if_file_cannot_be_deleted() throws IOException {
+        ViolationStore repairStore = new TextFileBasedViolationStore();
+        repairStore.initialize(repairStoreProperties());
+
+        ArchRule rule = rule("cannotDeleteRule");
+        repairStore.save(rule, ImmutableList.of("violation"));
+
+        File storedRulesFile = new File(configuredFolder, "stored.rules");
+        Properties props = readProperties(storedRulesFile);
+        String fileName = props.getProperty(rule.getDescription());
+        File ruleFile = new File(configuredFolder, fileName);
+        assertThat(ruleFile).exists();
+
+        // Make parent folder read-only so file cannot be deleted
+        configuredFolder.setWritable(false);
+        try {
+            assertThatThrownBy(() -> repairStore.save(rule, emptyList()))
+                    .isInstanceOf(StoreUpdateFailedException.class);
+
+            configuredFolder.setWritable(true);
+
+            assertThat(repairStore.contains(rule)).isTrue();
+            Properties propsAfter = readProperties(storedRulesFile);
+            assertThat(propsAfter).containsKey(rule.getDescription());
+        } finally {
+            configuredFolder.setWritable(true);
+        }
+    }
