+    @Test
+    public void repair_mode_checks_disk_state_even_if_folder_was_initialized_before() throws IOException {
+        ViolationStore store1 = new TextFileBasedViolationStore();
+        store1.initialize(defaultStoreProperties());
+
+        ArchRule rule1 = rule("rule1");
+        store1.save(rule1, ImmutableList.of("violation 1"));
+
+        // Now modify on disk: empty rule1's file (resolved) and add a broken rule directly to stored.rules
+        Properties storedRules = readProperties(new File(configuredFolder, "stored.rules"));
+        String rule1FileName = storedRules.getProperty(rule1.getDescription());
+        File rule1File = new File(configuredFolder, rule1FileName);
+        Files.write(rule1File.toPath(), new byte[0]);
+
+        storedRules.setProperty("brokenRule", "doesNotExist.txt");
+        writeStoredRules(storedRules);
+
+        // Second initialization on the same folder with repair
+        ViolationStore store2 = new TextFileBasedViolationStore();
+        store2.initialize(repairStoreProperties());
+
+        assertThat(store2.contains(rule1)).as("resolved rule1 is discarded").isFalse();
+        assertThat(rule1File).doesNotExist();
+        assertThat(store2.contains(rule("brokenRule"))).as("broken rule is discarded").isFalse();
+
+        // store1 also reflects the repaired state
+        assertThat(store1.contains(rule1)).isFalse();
+    }
