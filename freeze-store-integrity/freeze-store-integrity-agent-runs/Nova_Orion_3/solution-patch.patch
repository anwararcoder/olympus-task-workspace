+
+    private static boolean isBroken(Path storeFolderPath, String fileName) {
+        if (fileName == null || fileName.isEmpty()) {
+            return true;
+        }
+        if (fileName.contains("/") || fileName.contains("\\")) {
+            return true;
+        }
+        Path path;
+        try {
+            Path direct = Paths.get(fileName);
+            if (direct.isAbsolute() || direct.getNameCount() != 1 || fileName.equals(".") || fileName.equals("..")) {
+                return true;
+            }
+            path = storeFolderPath.resolve(fileName);
+            if (!storeFolderPath.normalize().equals(path.normalize().getParent())) {
+                return true;
+            }
+        } catch (InvalidPathException e) {
+            return true;
+        }
+
+        try {
+            return !Files.isRegularFile(path);
+        } catch (SecurityException e) {
+            return true;
+        }
+    }
+
+    private static boolean isResolved(Path storeFolderPath, String fileName) {
+        Path path = storeFolderPath.resolve(fileName);
+        try {
+            byte[] bytes = Files.readAllBytes(path);
+            String content = new String(bytes, UTF_8);
+            return hasNoViolations(content);
+        } catch (IOException e) {
+            throw new StoreInitializationFailedException("Failed to read violation file: " + fileName, e);
+        }
+    }
+
+    private static boolean hasNoViolations(String content) {
+        if (content.isEmpty()) {
+            return true;
+        }
+        boolean onlyLineBreaks = true;
+        for (int i = 0; i < content.length(); i++) {
+            char c = content.charAt(i);
+            if (c != '\r' && c != '\n') {
+                onlyLineBreaks = false;
+                break;
+            }
+        }
+        if (onlyLineBreaks) {
+            return true;
+        }
+        String unixContent = ensureUnixLineBreaks(content);
+        List<String> violations = Splitter.on(UNESCAPED_LINE_BREAK_PATTERN).omitEmptyStrings().splitToList(unixContent);
+        return violations.isEmpty();
+    }
+
+    private static Path resolvePath(Path storeFolderPath, String fileName) {
+        try {
+            Path path = Paths.get(fileName);
+            if (path.isAbsolute()) {
+                return path;
+            }
+            return storeFolderPath.resolve(fileName);
+        } catch (InvalidPathException e) {
+            return null;
+        }
+    }
+
+    private static Path resolveSymlinkTarget(Path path) {
+        Path current = path;
+        Set<Path> visited = new HashSet<>();
+        while (Files.isSymbolicLink(current)) {
+            if (!visited.add(current.normalize())) {
+                break;
+            }
+            try {
+                Path link = Files.readSymbolicLink(current);
+                if (!link.isAbsolute() && current.getParent() != null) {
+                    current = current.getParent().resolve(link);
+                } else {
+                    current = link;
+                }
+            } catch (IOException e) {
+                break;
+            }
+        }
+        return current;
+    }
+
+    private static boolean pointsToSameFile(Path storeFolderPath, String val1, String val2) {
+        if (val1.equals(val2)) {
+            return true;
+        }
+        Path path1 = resolvePath(storeFolderPath, val1);
+        Path path2 = resolvePath(storeFolderPath, val2);
+        if (path1 == null || path2 == null) {
+            return false;
+        }
+        if (path1.normalize().equals(path2.normalize())) {
+            return true;
+        }
+        try {
+            if (Files.isSameFile(path1, path2)) {
+                return true;
+            }
+        } catch (IOException | SecurityException ignored) {
+        }
+        Path target1 = resolveSymlinkTarget(path1);
+        Path target2 = resolveSymlinkTarget(path2);
+        if (Files.isSymbolicLink(path1) || Files.isSymbolicLink(path2)) {
+            if (target1.normalize().equals(target2.normalize())) {
+                return true;
+            }
+            try {
+                if (Files.isSameFile(target1, target2)) {
+                    return true;
+                }
+            } catch (IOException | SecurityException ignored) {
+            }
+        }
+        return false;
+    }
+
+    private static Set<String> findSharedKeys(Path storeFolderPath, Map<String, String> entries) {
+        Set<String> sharedKeys = new HashSet<>();
+        List<Map.Entry<String, String>> entryList = new ArrayList<>(entries.entrySet());
+        for (int i = 0; i < entryList.size(); i++) {
+            Map.Entry<String, String> entry1 = entryList.get(i);
+            for (int j = i + 1; j < entryList.size(); j++) {
+                Map.Entry<String, String> entry2 = entryList.get(j);
