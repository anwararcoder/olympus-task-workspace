+    private Set<String> findSharedKeys(Map<String, String> entries) {
+        Set<String> sharedKeys = new HashSet<>();
+        List<Map.Entry<String, String>> entryList = new ArrayList<>(entries.entrySet());
+        for (int i = 0; i < entryList.size(); i++) {
+            Map.Entry<String, String> entryI = entryList.get(i);
+            String fileNameI = entryI.getValue();
+            Path pathI = resolvePath(fileNameI);
+
+            for (int j = i + 1; j < entryList.size(); j++) {
+                Map.Entry<String, String> entryJ = entryList.get(j);
+                String fileNameJ = entryJ.getValue();
+                Path pathJ = resolvePath(fileNameJ);
+
+                if (areShared(fileNameI, pathI, fileNameJ, pathJ)) {
+                    sharedKeys.add(entryI.getKey());
+                    sharedKeys.add(entryJ.getKey());
+                }
+            }
+        }
