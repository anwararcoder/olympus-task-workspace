+    private void checkAndRepairIntegrity() {
+        synchronized (storedRules) {
+            storedRules.reloadFromDisk();
+            Map<String, String> entries = storedRules.getEntries();
+            Set<String> sharedKeys = findSharedKeys(entries);
+            Set<String> keysToDiscard = new HashSet<>();
+
+            for (Map.Entry<String, String> entry : entries.entrySet()) {
+                String ruleKey = entry.getKey();
+                if (sharedKeys.contains(ruleKey)) {
+                    continue;
+                }
+                String fileName = entry.getValue();
+                if (isBroken(fileName)) {
+                    keysToDiscard.add(ruleKey);
+                } else if (isResolved(fileName)) {
+                    keysToDiscard.add(ruleKey);
+                    discardResolvedFile(fileName);
+                }
+            }
+
+            if (!keysToDiscard.isEmpty()) {
+                storedRules.removeAll(keysToDiscard);
+            }
+        }
+    }
+
+    private void handleSaveNoViolationsWithRepair(ArchRule rule) {
+        synchronized (storedRules) {
+            if (!storedRules.containsKey(rule.getDescription())) {
+                return;
+            }
+
+            String ruleFileName = storedRules.getProperty(rule.getDescription());
+            if (isFileSharedWithAnotherEntry(rule.getDescription(), ruleFileName)) {
+                storedRules.remove(rule.getDescription());
+                return;
+            }
+
+            Path ruleFilePath = resolvePath(ruleFileName);
+            if (ruleFilePath == null) {
+                throw new StoreUpdateFailedException("Cannot delete file: invalid path " + ruleFileName);
+            }
+
+            deleteFileForForgottenRule(ruleFilePath);
+            storedRules.remove(rule.getDescription());
+        }
+    }
+
+    private boolean isFileSharedWithAnotherEntry(String currentRuleDescription, String ruleFileName) {
+        Path currentPath = resolvePath(ruleFileName);
+        Map<String, String> entries = storedRules.getEntries();
+        for (Map.Entry<String, String> entry : entries.entrySet()) {
+            if (entry.getKey().equals(currentRuleDescription)) {
+                continue;
+            }
+            String otherFileName = entry.getValue();
+            Path otherPath = resolvePath(otherFileName);
+            if (areShared(ruleFileName, currentPath, otherFileName, otherPath)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private void deleteFileForForgottenRule(Path path) {
+        try {
+            if (Files.isSymbolicLink(path)) {
+                Path target = path.toRealPath();
+                if (!target.equals(path)) {
+                    Files.delete(target);
+                }
+                Files.delete(path);
+            } else {
+                Files.delete(path);
+            }
+        } catch (IOException | SecurityException e) {
+            throw new StoreUpdateFailedException(e);
+        }
+    }
