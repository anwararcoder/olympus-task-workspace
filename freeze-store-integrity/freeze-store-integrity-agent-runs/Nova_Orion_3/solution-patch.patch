+    @Test
+    public void saving_no_violations_with_repair_fails_if_cannot_delete_file_and_leaves_entry() throws IOException {
+        ViolationStore repairStore = new TextFileBasedViolationStore();
+        repairStore.initialize(repairStoreProperties());
+
+        ArchRule rule = rule("rule with undeletable file");
+        repairStore.save(rule, ImmutableList.of("violation"));
+        assertThat(repairStore.contains(rule)).isTrue();
+
+        Properties properties = readProperties(new File(configuredFolder, "stored.rules"));
+        String fileName = properties.getProperty(rule.getDescription());
+        File file = new File(configuredFolder, fileName);
+        assertThat(file).exists();
+
+        // Make folder non-writable to prevent file deletion
+        configuredFolder.setWritable(false);
+        try {
+            assertThatThrownBy(() -> repairStore.save(rule, ImmutableList.of()))
+                    .isInstanceOf(StoreUpdateFailedException.class);
+
+            assertThat(repairStore.contains(rule)).as("entry must be left").isTrue();
+            Properties afterProperties = readProperties(new File(configuredFolder, "stored.rules"));
+            assertThat(afterProperties.getProperty(rule.getDescription())).isEqualTo(fileName);
+        } finally {
+            configuredFolder.setWritable(true);
+        }
+    }
