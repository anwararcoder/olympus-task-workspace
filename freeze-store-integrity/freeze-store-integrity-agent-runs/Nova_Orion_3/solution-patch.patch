+    @Test
+    public void saving_no_violations_fails_to_save_and_leaves_entry_if_cannot_delete_file() throws IOException {
+        ViolationStore store = new TextFileBasedViolationStore();
+        store.initialize(propertiesOf(
+                "default.path", storeFolder.getAbsolutePath(),
+                "default.allowStoreCreation", "true",
+                "default.integrity", "repair"));
+
+        ArchRule rule = rule("rule with undeletable file");
+        store.save(rule, ImmutableList.of("violation 1"));
+        assertThat(store.contains(rule)).isTrue();
+
+        Properties storedRules = readProperties(new File(storeFolder, "stored.rules"));
+        String fileName = storedRules.getProperty(rule.getDescription());
+        File violationFile = new File(storeFolder, fileName);
+        assertThat(violationFile).exists();
+
+        // Make storeFolder non-writable so that deleting violationFile will fail
+        assertThat(storeFolder.setWritable(false)).isTrue();
+        try {
+            assertThatThrownBy(() -> store.save(rule, Collections.emptyList()))
+                    .isInstanceOf(StoreUpdateFailedException.class);
+
+            // Entry must remain in memory and on disk!
+            assertThat(store.contains(rule)).isTrue();
+            Properties rulesAfterFailedSave = readProperties(new File(storeFolder, "stored.rules"));
+            assertThat(rulesAfterFailedSave).containsKey(rule.getDescription());
+            assertThat(violationFile).exists();
+        } finally {
+            storeFolder.setWritable(true);
+        }
+    }
