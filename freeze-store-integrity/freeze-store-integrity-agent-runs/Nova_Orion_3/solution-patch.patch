+    private void setupStoreWithBrokenAndResolvedEntries() throws IOException {
+        assertThat(storeFolder.mkdirs()).isTrue();
+
+        File emptyFile = new File(storeFolder, "empty.txt");
+        Files.write(emptyFile.toPath(), new byte[0]);
+
+        Properties initialRules = new Properties();
+        initialRules.setProperty("broken nonexistent", "nonexistent.txt");
+        initialRules.setProperty("resolved empty", "empty.txt");
+        writeProperties(new File(storeFolder, "stored.rules"), initialRules);
+    }
+
+    private Properties readProperties(File file) throws IOException {
+        Properties properties = new Properties();
+        try (FileInputStream inputStream = new FileInputStream(file)) {
+            properties.load(inputStream);
+        }
+        return properties;
+    }
+
+    private void writeProperties(File file, Properties properties) throws IOException {
+        try (FileOutputStream outputStream = new FileOutputStream(file)) {
+            properties.store(outputStream, "");
+        }
+    }
+
+    private Properties propertiesOf(String... keyValuePairs) {
+        Properties result = new Properties();
+        LinkedList<String> keyValues = new LinkedList<>(asList(keyValuePairs));
+        while (!keyValues.isEmpty()) {
+            result.setProperty(keyValues.poll(), keyValues.poll());
+        }
+        return result;
+    }
+
+    private ArchRule rule(String description) {
+        return classes().should().bePublic().as(description);
+    }
