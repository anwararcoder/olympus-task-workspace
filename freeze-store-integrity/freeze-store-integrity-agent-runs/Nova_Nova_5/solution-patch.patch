+
+        String newName = load(folder.resolve("stored.rules")).getProperty("move me");
+        assertThat(newName).isNotEqualTo("old-file");
+        assertThat(new String(Files.readAllBytes(folder.resolve(newName)), UTF_8)).isEqualTo("violation\n");
+        assertThat(folder.resolve("old-file")).doesNotExist();
+    }
+
+    @Test
+    void save_rejects_a_name_which_escapes_the_folder_without_changing_the_index() throws IOException {
+        Path folder = temporaryFolder.resolve("store");
+        TextFileBasedViolationStore store = new TextFileBasedViolationStore(description -> "../outside");
+        store.initialize(properties(folder));
+
+        assertThatThrownBy(() -> store.save(rule("unsafe"), ImmutableList.of("violation")))
+                .isInstanceOf(StoreUpdateFailedException.class);
+        assertThat(load(folder.resolve("stored.rules"))).isEmpty();
+        assertThat(folder.resolve("../outside")).doesNotExist();
+    }
+
+    @Test
+    void carriage_returns_in_violations_are_preserved_but_line_break_only_files_are_empty() throws IOException {
+        Path folder = temporaryFolder.resolve("store");
+        TextFileBasedViolationStore store = new TextFileBasedViolationStore(description -> "file");
+        store.initialize(properties(folder));
+        ArchRule rule = rule("carriage returns");
+
+        store.save(rule, ImmutableList.of("before\rafter"));
+
+        assertThat(store.getViolations(rule)).containsExactly("before\rafter");
+        Files.write(folder.resolve("file"), "\r".getBytes(UTF_8));
+        assertThat(store.getViolations(rule)).isEmpty();
+    }
+
+    private Properties properties(Path folder, String... extras) {
+        Properties result = new Properties();
+        result.setProperty("default.path", folder.toString());
+        result.setProperty("default.allowStoreCreation", "true");
+        for (int i = 0; i < extras.length; i += 2) {
+            result.setProperty(extras[i], extras[i + 1]);
+        }
+        return result;
+    }
+
+    private Properties load(Path file) throws IOException {
+        Properties result = new Properties();
+        try (java.io.InputStream input = Files.newInputStream(file)) {
+            result.load(input);
+        }
+        return result;
+    }
+
+    private ArchRule rule(String description) {
+        return classes().should().bePublic().as(description);
+    }
+}
