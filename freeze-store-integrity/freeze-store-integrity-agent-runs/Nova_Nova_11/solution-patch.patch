+    @Test
+    public void description_names_are_stable_distinct_safe_and_keep_a_late_word() throws IOException {
+        File folder = temporaryFolder.toFile();
+        TextFileBasedViolationStore store = new TextFileBasedViolationStore();
+        store.initialize(properties(folder, "default.fileNames", "description"));
+
+        ArchRule first = rule("a very long description " + repeat("prefix", 80) + " lateWord");
+        ArchRule second = rule("a very long description " + repeat("prefix", 80) + " otherWord");
+        store.save(first, ImmutableList.of("one"));
+        store.save(second, ImmutableList.of("two"));
+
+        Properties index = readIndex(folder);
+        String firstName = index.getProperty(first.getDescription());
+        String secondName = index.getProperty(second.getDescription());
+        assertThat(firstName).contains("lateWord");
+        assertThat(firstName).isNotEqualTo(secondName);
+        assertThat(firstName).matches("[A-Za-z0-9_-]{1,200}");
+        assertThat(firstName).isNotEqualTo("stored.rules");
+    }
+
+    @Test
+    public void carriage_returns_in_violations_are_preserved_and_line_break_only_files_are_empty() throws IOException {
+        File folder = temporaryFolder.toFile();
+        TextFileBasedViolationStore store = new TextFileBasedViolationStore();
+        store.initialize(properties(folder));
+        ArchRule rule = rule("line endings");
+
+        store.save(rule, ImmutableList.of("before\rinside"));
+        assertThat(store.getViolations(rule)).containsExactly("before\rinside");
+
+        String fileName = readIndex(folder).getProperty(rule.getDescription());
+        Files.write(new File(folder, fileName).toPath(), "\r\n\r".getBytes(UTF_8));
+        assertThat(store.getViolations(rule)).isEmpty();
+    }
+
