+        File folder = temporaryFolder.toFile();
+        TextFileBasedViolationStore customNames = new TextFileBasedViolationStore(description -> description + ".derived");
+        customNames.initialize(properties(folder, "default.integrity", "ignore"));
+        ArchRule moved = rule("moved");
+        ArchRule forgotten = rule("forgotten");
+        customNames.save(moved, ImmutableList.of("violation"));
+        customNames.save(forgotten, ImmutableList.of("old"));
+
+        Properties index = readIndex(folder);
+        String movedName = index.getProperty(moved.getDescription());
+        index.setProperty(moved.getDescription(), "legacy-name");
