+
+import static com.tngtech.archunit.lang.syntax.ArchRuleDefinition.classes;
+import static java.nio.charset.StandardCharsets.UTF_8;
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+class TextFileBasedViolationStoreIntegrityTest {
+    @TempDir
+    Path temporaryFolder;
+
+    @Test
+    void repairs_entries_and_leaves_shared_and_unowned_files_alone() throws IOException {
+        File folder = temporaryFolder.toFile();
+        ArchRule good = rule("good rule");
+        ArchRule solved = rule("solved rule");
+        ArchRule broken = rule("broken rule");
+        ArchRule sharedOne = rule("shared one");
+        ArchRule sharedTwo = rule("shared two");
+
+        Properties index = new Properties();
+        index.setProperty(good.getDescription(), "wrong");
+        index.setProperty(solved.getDescription(), "solved");
+        index.setProperty(broken.getDescription(), "missing");
+        index.setProperty(sharedOne.getDescription(), "shared");
+        index.setProperty(sharedTwo.getDescription(), "shared");
+        try (FileOutputStream output = new FileOutputStream(new File(folder, "stored.rules"))) {
+            index.store(output, "");
+        }
+        Files.write(new File(folder, "wrong").toPath(), "violation\n".getBytes(UTF_8));
+        Files.write(new File(folder, "solved").toPath(), "\r\n".getBytes(UTF_8));
+        Files.write(new File(folder, "unowned").toPath(), "orphan\n".getBytes(UTF_8));
+
+        TextFileBasedViolationStore store = new TextFileBasedViolationStore(this::derivedName);
+        store.initialize(properties(folder, "repair"));
+
+        assertThat(store.getViolations(good)).containsExactly("violation");
+        assertThat(new File(folder, "wrong")).doesNotExist();
+        assertThat(new File(folder, derivedName(good.getDescription()))).isFile();
+        assertThat(store.contains(solved)).isFalse();
+        assertThat(new File(folder, "solved")).doesNotExist();
+        assertThat(store.contains(broken)).isFalse();
+        assertThat(store.contains(sharedOne)).isTrue();
+        assertThat(store.contains(sharedTwo)).isTrue();
+        assertThat(new File(folder, "unowned")).isFile();
+    }
+
+    @Test
+    void fail_reports_problems_without_creating_an_absent_index() {
+        File folder = new File(temporaryFolder.toFile(), "missing");
+        Properties properties = properties(folder, "fail");
+        properties.setProperty("default.allowStoreCreation", "true");
+
+        assertThatThrownBy(() -> new TextFileBasedViolationStore().initialize(properties))
+                .isInstanceOf(StoreInitializationFailedException.class);
+        assertThat(new File(folder, "stored.rules")).doesNotExist();
+    }
+
+    private Properties properties(File folder, String integrity) {
+        Properties result = new Properties();
+        result.setProperty("default.path", folder.getAbsolutePath());
+        result.setProperty("default.allowStoreCreation", "true");
+        result.setProperty("default.allowStoreUpdate", "true");
+        result.setProperty("default.integrity", integrity);
+        return result;
+    }
+
+    private String derivedName(String description) {
+        return "derived-" + Integer.toHexString(description.hashCode());
+    }
+
+    private ArchRule rule(String description) {
+        return classes().should().bePublic().as(description);
+    }
+}
