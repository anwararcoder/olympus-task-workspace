+
+    private void initialize(String integrity) {
+        store.initialize(storeProperties(integrity));
+    }
+
+    private Properties storeProperties(String integrity) {
+        Properties properties = new Properties();
+        properties.setProperty("default.path", storeFolder.toString());
+        properties.setProperty("default.allowStoreCreation", "true");
+        if (!integrity.isEmpty()) {
+            properties.setProperty("default.integrity", integrity);
+        }
+        return properties;
+    }
+
+    private Path write(String fileName, String contents) throws IOException {
+        Path file = storeFolder.resolve(fileName);
+        Files.createDirectories(file.getParent());
+        return Files.write(file, contents.getBytes(UTF_8));
+    }
+
+    private void writeIndex(String... descriptionsAndFiles) throws IOException {
+        Properties properties = new Properties();
+        for (int index = 0; index < descriptionsAndFiles.length; index += 2) {
+            properties.setProperty(descriptionsAndFiles[index], descriptionsAndFiles[index + 1]);
+        }
+        try (OutputStream output = Files.newOutputStream(indexFile())) {
+            properties.store(output, "");
+        }
+    }
+
+    private Properties readIndex() throws IOException {
+        Properties properties = new Properties();
+        try (InputStream input = Files.newInputStream(indexFile())) {
+            properties.load(input);
+        }
+        return properties;
+    }
+
+    private Path indexFile() {
+        return storeFolder.resolve("stored.rules");
+    }
+
+    private Path storedFile(ArchRule rule) throws IOException {
+        return storeFolder.resolve(readIndex().getProperty(ensureUnixLineBreaks(rule.getDescription())));
+    }
+
+    private ArchRule rule(String description) {
+        return classes().should().bePublic().as(description);
+    }
+
+    private void createLink(String fileName, Path target, LinkType type) throws IOException {
+        Path link = storeFolder.resolve(fileName);
+        try {
+            if (type == LinkType.SYMBOLIC) {
+                Files.createSymbolicLink(link, link.getParent().relativize(target));
+            } else {
+                Files.createLink(link, target);
+            }
+        } catch (FileSystemException | UnsupportedOperationException exception) {
+            assumeTrue(false, exception.toString());
+        }
+    }
+
+    private enum LinkType {
+        SYMBOLIC, HARD
+    }
+}
