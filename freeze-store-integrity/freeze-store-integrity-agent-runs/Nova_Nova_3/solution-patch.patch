+class TextFileBasedViolationStoreIntegrityTest {
+
+    @TempDir
+    Path temporaryFolder;
+
+    @Test
+    void description_file_names_are_stable_bounded_and_keep_a_late_word() throws IOException {
+        File folder = new File(temporaryFolder.toFile(), "store");
+        TextFileBasedViolationStore store = new TextFileBasedViolationStore();
+        Properties properties = propertiesOf(
+                "default.path", folder.getAbsolutePath(),
+                "default.allowStoreCreation", "true",
+                "default.fileNames", "description");
+        store.initialize(properties);
+
+        ArchRule first = rule(longDescription("first", "lastWord"));
+        ArchRule second = rule(longDescription("second", "lastWord"));
+        store.save(first, ImmutableList.of("violation"));
+        store.save(second, ImmutableList.of("violation"));
+
+        Properties index = readProperties(new File(folder, "stored.rules"));
+        String firstName = index.getProperty(first.getDescription());
+        String secondName = index.getProperty(second.getDescription());
+        assertThat(firstName).isNotEqualTo(secondName);
+        assertThat(firstName).contains("lastWord").matches("[A-Za-z0-9_-]+").hasSizeLessThanOrEqualTo(200);
+        assertThat(secondName).contains("lastWord").matches("[A-Za-z0-9_-]+").hasSizeLessThanOrEqualTo(200);
+
+        TextFileBasedViolationStore reread = new TextFileBasedViolationStore();
+        reread.initialize(properties);
+        assertThat(readProperties(new File(folder, "stored.rules")).getProperty(first.getDescription())).isEqualTo(firstName);
+    }
+
+    @Test
+    void repair_discards_empty_entries_and_moves_misplaced_entries() throws IOException {
+        File folder = new File(temporaryFolder.toFile(), "store");
+        assertThat(folder.mkdirs()).isTrue();
+        ArchRule emptyRule = rule("empty rule");
+        ArchRule misplacedRule = rule("misplaced rule");
+        Properties index = new Properties();
+        index.setProperty(emptyRule.getDescription(), "empty");
+        index.setProperty(misplacedRule.getDescription(), "old");
+        try (java.io.FileOutputStream output = new java.io.FileOutputStream(new File(folder, "stored.rules"))) {
+            index.store(output, "");
+        }
+        Files.asCharSink(new File(folder, "empty"), UTF_8).write("\r\n\r");
+        Files.asCharSink(new File(folder, "old"), UTF_8).write("violation\n");
+
+        TextFileBasedViolationStore store = new TextFileBasedViolationStore(description ->
+                description.equals(misplacedRule.getDescription()) ? "derived" : "empty-derived");
+        store.initialize(propertiesOf(
+                "default.path", folder.getAbsolutePath(),
+                "default.allowStoreUpdate", "true",
+                "default.integrity", "repair"));
+
+        assertThat(new File(folder, "empty")).doesNotExist();
+        assertThat(new File(folder, "old")).doesNotExist();
+        assertThat(new File(folder, "derived")).isFile();
+        assertThat(readProperties(new File(folder, "stored.rules")))
+                .containsEntry(misplacedRule.getDescription(), "derived")
+                .doesNotContainKey(emptyRule.getDescription());
+    }
+
+    @Test
