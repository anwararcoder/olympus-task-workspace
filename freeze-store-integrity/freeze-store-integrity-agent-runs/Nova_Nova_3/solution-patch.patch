+class TextFileBasedViolationStoreIntegrityTest {
+
+    @TempDir
+    Path temporaryFolder;
+
+    @Test
+    void description_names_are_safe_deterministic_and_keep_late_words() throws IOException {
+        File folder = temporaryFolder.resolve("store").toFile();
+        TextFileBasedViolationStore store = new TextFileBasedViolationStore();
+        store.initialize(properties(folder, "default.fileNames", "description"));
+
+        ArchRule first = rule("a very long description that has a lateWord at its end");
+        ArchRule second = rule("a very long description that has a lateWord at its end!");
+        store.save(first, ImmutableList.of("violation"));
+        store.save(second, ImmutableList.of("violation"));
+
+        Properties index = readProperties(new File(folder, "stored.rules"));
+        String firstName = index.getProperty(first.getDescription());
+        String secondName = index.getProperty(second.getDescription());
+        assertThat(firstName).contains("lateWord").matches("[A-Za-z0-9_-]+").hasSizeLessThanOrEqualTo(200);
+        assertThat(firstName).isNotEqualTo(secondName).isNotEqualTo("stored.rules");
+    }
+
+    @Test
+    void custom_strategy_receives_the_original_description_and_constructor_strategy_rejects_configuration_defaults() throws IOException {
+        List<String> descriptions = new LinkedList<>();
+        TextFileBasedViolationStore store = new TextFileBasedViolationStore(description -> {
+            descriptions.add(description);
+            return "custom-file";
+        });
+        File folder = temporaryFolder.resolve("store").toFile();
+        store.initialize(properties(folder));
+        String description = "first\r\nsecond";
+        store.save(rule(description), ImmutableList.of("violation"));
+        assertThat(descriptions).containsExactly(description);
+
+        Properties defaults = new Properties();
+        defaults.setProperty("default.fileNames", "random");
+        Properties configured = new Properties(defaults);
+        configured.setProperty("default.path", temporaryFolder.resolve("other").toString());
+        configured.setProperty("default.allowStoreCreation", "true");
+        assertThatThrownBy(() -> new TextFileBasedViolationStore(descriptionValue -> "file").initialize(configured))
+                .isInstanceOf(StoreInitializationFailedException.class);
+    }
+
+    @Test
+    void repair_discards_broken_and_empty_entries_and_moves_misplaced_files() throws IOException {
+        File folder = temporaryFolder.resolve("store").toFile();
+        TextFileBasedViolationStore initial = new TextFileBasedViolationStore();
+        initial.initialize(properties(folder, "default.fileNames", "description"));
+        ArchRule movedRule = rule("moved rule");
+        initial.save(movedRule, ImmutableList.of("kept violation"));
+        Properties index = readProperties(new File(folder, "stored.rules"));
+        String derivedName = index.getProperty(movedRule.getDescription());
+        Files.move(new File(folder, derivedName).toPath(), new File(folder, "old-name").toPath());
+        index.setProperty(movedRule.getDescription(), "old-name");
+        index.setProperty("empty rule", "empty-file");
+        index.setProperty("broken rule", "missing-file");
+        try (FileOutputStream output = new FileOutputStream(new File(folder, "stored.rules"))) {
+            index.store(output, "");
+        }
+        Files.write(new File(folder, "empty-file").toPath(), "\r".getBytes(UTF_8));
+        Files.write(new File(folder, "unowned").toPath(), "unowned".getBytes(UTF_8));
+
+        TextFileBasedViolationStore repaired = new TextFileBasedViolationStore();
+        repaired.initialize(properties(folder, "default.fileNames", "description", "default.integrity", "repair"));
+
+        assertThat(new File(folder, derivedName)).hasContent("kept violation\n");
+        assertThat(new File(folder, "old-name")).doesNotExist();
+        assertThat(new File(folder, "empty-file")).doesNotExist();
+        assertThat(new File(folder, "unowned")).hasContent("unowned");
+        assertThat(repaired.contains(movedRule)).isTrue();
+        assertThat(repaired.contains(rule("empty rule"))).isFalse();
+        assertThat(repaired.contains(rule("broken rule"))).isFalse();
+    }
+
+    @Test
+    void fail_does_not_create_an_absent_index_when_the_folder_is_not_empty() {
+        File folder = temporaryFolder.resolve("store").toFile();
+        assertThat(folder.mkdirs()).isTrue();
+        File unowned = new File(folder, "unowned");
+        assertThat(unowned).doesNotExist();
+        try {
+            Files.write(unowned.toPath(), "unowned".getBytes(UTF_8));
+        } catch (IOException e) {
+            throw new AssertionError(e);
+        }
+
+        assertThatThrownBy(() -> new TextFileBasedViolationStore().initialize(properties(folder,
+                "default.allowStoreCreation", "true", "default.integrity", "fail")))
+                .isInstanceOf(StoreInitializationFailedException.class)
+                .hasMessageContaining("unowned");
+        assertThat(new File(folder, "stored.rules")).doesNotExist();
+        assertThat(unowned).hasContent("unowned");
+    }
+
+    @Test
+    void unsafe_new_file_names_are_rejected_without_changing_the_store() throws IOException {
+        File folder = temporaryFolder.resolve("store").toFile();
+        TextFileBasedViolationStore store = new TextFileBasedViolationStore(description -> "stored.rules");
+        store.initialize(properties(folder));
+
+        assertThatThrownBy(() -> store.save(rule("unsafe"), ImmutableList.of("violation")))
+                .isInstanceOf(StoreUpdateFailedException.class);
+        assertThat(readProperties(new File(folder, "stored.rules"))).isEmpty();
+        assertThat(folder.list()).containsExactly("stored.rules");
+    }
+
+    @Test
+    void repair_moves_a_symbolic_link_target_and_leaves_shared_files_alone() throws IOException {
+        File folder = temporaryFolder.resolve("store").toFile();
+        TextFileBasedViolationStore initial = new TextFileBasedViolationStore();
+        initial.initialize(properties(folder, "default.fileNames", "description"));
+        ArchRule movedRule = rule("symbolic move");
+        initial.save(movedRule, ImmutableList.of("violation"));
+        Properties index = readProperties(new File(folder, "stored.rules"));
+        String derivedName = index.getProperty(movedRule.getDescription());
+        Files.move(new File(folder, derivedName).toPath(), new File(folder, "target-file").toPath());
+        try {
+            Files.createSymbolicLink(new File(folder, "old-link").toPath(), Paths.get("target-file"));
+        } catch (IOException | UnsupportedOperationException | SecurityException e) {
+            Assumptions.assumeTrue(false, "Symbolic links are not available");
+        }
+        index.setProperty(movedRule.getDescription(), "old-link");
+        try (FileOutputStream output = new FileOutputStream(new File(folder, "stored.rules"))) {
+            index.store(output, "");
+        }
+
+        TextFileBasedViolationStore repaired = new TextFileBasedViolationStore();
+        repaired.initialize(properties(folder, "default.fileNames", "description", "default.integrity", "repair"));
+
+        assertThat(new File(folder, derivedName)).hasContent("violation\n");
+        assertThat(new File(folder, "target-file")).doesNotExist();
+        assertThat(Files.isSymbolicLink(new File(folder, "old-link").toPath())).isTrue();
+        assertThat(repaired.getViolations(movedRule)).containsExactly("violation");
+    }
+
+    @Test
+    void repair_removes_an_entry_pointing_to_a_directory_without_deleting_the_directory() throws IOException {
+        File folder = temporaryFolder.resolve("store").toFile();
+        TextFileBasedViolationStore initial = new TextFileBasedViolationStore();
+        initial.initialize(properties(folder, "default.fileNames", "description"));
+        Properties index = readProperties(new File(folder, "stored.rules"));
+        File directory = new File(folder, "directory");
+        assertThat(directory.mkdir()).isTrue();
+        index.setProperty("directory rule", "directory");
+        try (FileOutputStream output = new FileOutputStream(new File(folder, "stored.rules"))) {
+            index.store(output, "");
+        }
+
+        TextFileBasedViolationStore repaired = new TextFileBasedViolationStore();
+        repaired.initialize(properties(folder, "default.fileNames", "description", "default.integrity", "repair"));
+
+        assertThat(directory).isDirectory();
+        assertThat(repaired.contains(rule("directory rule"))).isFalse();
+    }
+
+    private Properties properties(File folder, String... additional) {
+        Properties result = new Properties();
+        result.setProperty("default.path", folder.getAbsolutePath());
+        result.setProperty("default.allowStoreCreation", "true");
+        LinkedList<String> values = new LinkedList<>(asList(additional));
+        while (!values.isEmpty()) {
+            result.setProperty(values.poll(), values.poll());
+        }
+        return result;
+    }
+
+    private Properties readProperties(File file) throws IOException {
+        Properties result = new Properties();
+        try (FileInputStream input = new FileInputStream(file)) {
+            result.load(input);
+        }
+        return result;
+    }
+
+    private ArchRule rule(String description) {
+        return classes().should().bePublic().as(description);
+    }
