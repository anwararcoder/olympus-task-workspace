+
+    private ResolvedFile resolveFile(Path path) {
+        return resolveFile(path, storeFolder.toPath());
+    }
+
+    private ResolvedFile resolveFile(Path path, Path folderPath) {
+        if (path == null || !pathExists(path)) {
+            return null;
+        }
+        try {
+            Path realPath = path.toRealPath();
+            BasicFileAttributes attributes = Files.readAttributes(realPath, BasicFileAttributes.class, LinkOption.NOFOLLOW_LINKS);
+            return new ResolvedFile(path, realPath, attributes.isRegularFile(), identityOf(attributes, realPath),
+                    isDirectPath(path, folderPath)
+                            && realPath.getParent() != null && realPath.getParent().equals(realPath(folderPath)));
+        } catch (IOException | SecurityException e) {
+            return null;
+        }
+    }
+
+    private Path realPath(Path path) {
+        try {
+            return path.toRealPath();
+        } catch (IOException e) {
+            throw new StoreInitializationFailedException(e);
+        }
+    }
+
+    private boolean containsNoViolations(Path file) {
+        try {
+            byte[] bytes = Files.readAllBytes(file);
+            for (byte value : bytes) {
+                if (value != '\n' && value != '\r') {
+                    return false;
+                }
+            }
+            return true;
+        } catch (IOException e) {
+            throw new StoreInitializationFailedException(e);
+        }
+    }
+
+    private boolean sameFileAsIndex(Path path) {
+        if (path == null) {
+            return false;
+        }
+        try {
+            return samePath(path, new File(storeFolder, STORED_RULES_FILE_NAME).toPath())
+                    || (pathExists(path) && pathExists(new File(storeFolder, STORED_RULES_FILE_NAME).toPath())
+                    && Files.isSameFile(path, new File(storeFolder, STORED_RULES_FILE_NAME).toPath()));
+        } catch (IOException | SecurityException e) {
+            return false;
+        }
+    }
+
+    private boolean sameFile(ResolvedFile file, Path other) {
+        try {
+            if (!pathExists(other)) {
+                return false;
+            }
+            BasicFileAttributes otherAttributes = Files.readAttributes(other, BasicFileAttributes.class);
+            return file.identity.equals(identityOf(otherAttributes, other.toRealPath()));
+        } catch (IOException | SecurityException e) {
+            return false;
+        }
+    }
+
+    private boolean samePath(Path left, Path right) {
+        return left.toAbsolutePath().normalize().equals(right.toAbsolutePath().normalize());
+    }
+
+    private String identityOf(Path path) throws IOException {
+        BasicFileAttributes attributes = Files.readAttributes(path, BasicFileAttributes.class, LinkOption.NOFOLLOW_LINKS);
+        return identityOf(attributes, path.toRealPath());
+    }
+
+    private String identityOf(BasicFileAttributes attributes, Path path) {
+        Object fileKey = attributes.fileKey();
+        return fileKey == null ? "path:" + path.toAbsolutePath().normalize() : "key:" + fileKey;
+    }
+
+    private static String createDescriptionFileName(String description) {
+        String normalizedDescription = ensureUnixLineBreaks(description);
+        Matcher matcher = DESCRIPTION_WORD_PATTERN.matcher(normalizedDescription);
+        String keptWord = null;
+        while (matcher.find()) {
+            keptWord = matcher.group(1);
+        }
+        String hash = sha256(normalizedDescription);
+        String prefix = keptWord == null ? "rule" : keptWord;
+        return prefix + "-" + hash;
+    }
+
+    private static String sha256(String value) {
+        try {
+            byte[] digest = MessageDigest.getInstance("SHA-256").digest(value.getBytes(UTF_8));
+            StringBuilder result = new StringBuilder(digest.length * 2);
+            for (byte current : digest) {
+                result.append(String.format("%02x", current & 0xff));
+            }
+            return result.toString();
+        } catch (NoSuchAlgorithmException e) {
+            throw new IllegalStateException(e);
+        }
+    }
+
+    private static boolean pathExists(Path path) {
+        return path != null && (Files.exists(path, LinkOption.NOFOLLOW_LINKS) || Files.isSymbolicLink(path));
+    }
+
+    private static boolean isRegularFileWithoutFollowingLinks(Path path) {
+        return Files.isRegularFile(path, LinkOption.NOFOLLOW_LINKS);
+    }
