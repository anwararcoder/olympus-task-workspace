+    private boolean isDirectPath(Path path, Path folderPath) {
+        Path folder = folderPath.toAbsolutePath().normalize();
+        return path.getParent() != null && folder.equals(path.getParent().toAbsolutePath().normalize());
+    }
+
+    private ResolvedFile resolveFile(Path folderPath, String fileName) {
+        Path path = resolveAnyPath(folderPath, fileName);
+        return resolveFile(path, folderPath);
