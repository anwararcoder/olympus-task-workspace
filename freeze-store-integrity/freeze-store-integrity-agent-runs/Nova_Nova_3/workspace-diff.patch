+    private void assertKeepsAWordOf(String fileName, String ruleDescription) {
+        List<String> words = new ArrayList<>();
+        for (String word : ruleDescription.split("[^A-Za-z0-9]+")) {
+            if (word.length() >= 4) {
+                words.add(word.toLowerCase(Locale.ROOT));
+            }
+        }
