+    private static class IntegrityAnalysis {
+        private final List<RuleEntry> entries;
+        private final List<String> unownedFiles;
+
+        private IntegrityAnalysis(List<RuleEntry> entries, List<String> unownedFiles) {
+            this.entries = entries;
+            this.unownedFiles = unownedFiles;
+        }
+
+        private boolean hasProblems() {
+            if (!unownedFiles.isEmpty()) {
+                return true;
+            }
+            for (RuleEntry entry : entries) {
+                if (entry.shared || entry.broken || entry.resolved || entry.misplaced || entry.colliding || entry.occupied) {
+                    return true;
+                }
+            }
+            return false;
+        }
+
+        private String report() {
+            StringBuilder result = new StringBuilder("Violation store integrity check failed");
+            appendEntries(result, "broken", entry -> entry.broken && !entry.shared);
+            appendEntries(result, "resolved", entry -> entry.resolved && !entry.shared);
+            appendEntries(result, "shared", entry -> entry.shared);
+            appendEntries(result, "misplaced", entry -> entry.misplaced && !entry.shared && !entry.broken && !entry.resolved);
+            appendEntries(result, "colliding", entry -> entry.colliding && !entry.shared && !entry.broken && !entry.resolved && !entry.misplaced);
+            appendEntries(result, "occupied", entry -> entry.occupied && !entry.shared && !entry.broken && !entry.resolved
+                    && !entry.misplaced && !entry.colliding);
+            if (!unownedFiles.isEmpty()) {
+                result.append("\nunowned:\n");
+                for (String file : unownedFiles) {
+                    result.append("  ").append(file).append('\n');
+                }
+            }
+            return result.toString();
+        }
+
+        private void appendEntries(StringBuilder result, String condition, EntryPredicate predicate) {
+            List<RuleEntry> matching = entries.stream().filter(predicate::test).collect(toList());
+            if (matching.isEmpty()) {
+                return;
+            }
+            result.append('\n').append(condition).append(":\n");
+            for (RuleEntry entry : matching) {
+                result.append("  ").append(entry.description).append(" -> ").append(entry.recordedName);
+                List<String> details = new ArrayList<>();
+                if (entry.broken) details.add("broken");
+                if (entry.resolved) details.add("resolved");
+                if (entry.shared) details.add("shared");
+                if (entry.misplaced) details.add("misplaced");
+                if (entry.colliding) details.add("colliding");
+                if (entry.occupied) details.add("occupied");
+                if (!details.isEmpty()) {
+                    result.append(" [").append(String.join(", ", details)).append(']');
+                }
+                result.append('\n');
+            }
+        }
+    }
