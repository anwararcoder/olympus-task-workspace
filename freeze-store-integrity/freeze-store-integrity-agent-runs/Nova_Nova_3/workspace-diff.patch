+    }
+
+    @Test
+    void repair_discards_empty_entries_and_moves_misplaced_entries() throws IOException {
+        File folder = new File(temporaryFolder.toFile(), "store");
+        assertThat(folder.mkdirs()).isTrue();
+        ArchRule emptyRule = rule("empty rule");
+        ArchRule misplacedRule = rule("misplaced rule");
+        Properties index = new Properties();
+        index.setProperty(emptyRule.getDescription(), "empty");
+        index.setProperty(misplacedRule.getDescription(), "old");
+        try (java.io.FileOutputStream output = new java.io.FileOutputStream(new File(folder, "stored.rules"))) {
+            index.store(output, "");
+        }
+        Files.asCharSink(new File(folder, "empty"), UTF_8).write("\r\n\r");
+        Files.asCharSink(new File(folder, "old"), UTF_8).write("violation\n");
+
+        TextFileBasedViolationStore store = new TextFileBasedViolationStore(description ->
+                description.equals(misplacedRule.getDescription()) ? "derived" : "empty-derived");
+        store.initialize(propertiesOf(
+                "default.path", folder.getAbsolutePath(),
+                "default.allowStoreUpdate", "true",
+                "default.integrity", "repair"));
+
+        assertThat(new File(folder, "empty")).doesNotExist();
+        assertThat(new File(folder, "old")).doesNotExist();
+        assertThat(new File(folder, "derived")).isFile();
+        assertThat(readProperties(new File(folder, "stored.rules")))
+                .containsEntry(misplacedRule.getDescription(), "derived")
+                .doesNotContainKey(emptyRule.getDescription());
+    }
+
+    @Test
+    void fail_reports_unowned_files_without_modifying_the_store() throws IOException {
+        File folder = new File(temporaryFolder.toFile(), "store");
+        assertThat(folder.mkdirs()).isTrue();
+        Files.asCharSink(new File(folder, "unowned"), UTF_8).write("unowned\n");
+        File index = new File(folder, "stored.rules");
+
+        assertThatThrownBy(() -> new TextFileBasedViolationStore().initialize(propertiesOf(
+                "default.path", folder.getAbsolutePath(),
+                "default.allowStoreCreation", "true",
+                "default.integrity", "fail")))
+                .isInstanceOf(StoreInitializationFailedException.class)
+                .hasMessageContaining("unowned");
+        assertThat(index).doesNotExist();
+        assertThat(new File(folder, "unowned")).isFile();
+    }
+
+    @Test
+    void save_rejects_the_index_as_a_rule_file() throws IOException {
+        File folder = new File(temporaryFolder.toFile(), "store");
+        TextFileBasedViolationStore store = new TextFileBasedViolationStore(description -> "stored.rules");
+        store.initialize(propertiesOf(
+                "default.path", folder.getAbsolutePath(),
+                "default.allowStoreCreation", "true"));
+
+        assertThatThrownBy(() -> store.save(rule("unsafe rule"), ImmutableList.of("violation")))
+                .isInstanceOf(StoreUpdateFailedException.class);
+        assertThat(readProperties(new File(folder, "stored.rules"))).isEmpty();
+    }
+
+    private String longDescription(String first, String last) {
+        StringBuilder result = new StringBuilder(first);
+        for (int i = 0; i < 80; i++) {
+            result.append(" x");
+        }
+        return result.append(' ').append(last).toString();
+    }
+
+    private ArchRule rule(String description) {
+        return classes().should().bePublic().as(description);
+    }
+
+    private Properties readProperties(File file) throws IOException {
+        Properties properties = new Properties();
+        try (FileInputStream inputStream = new FileInputStream(file)) {
+            properties.load(inputStream);
+        }
+        return properties;
+    }
+
+    private Properties propertiesOf(String... keyValuePairs) {
+        Properties result = new Properties();
+        LinkedList<String> keyValues = new LinkedList<>(asList(keyValuePairs));
+        while (!keyValues.isEmpty()) {
+            result.setProperty(keyValues.poll(), keyValues.poll());
+        }
+        return result;
+    }
+}
