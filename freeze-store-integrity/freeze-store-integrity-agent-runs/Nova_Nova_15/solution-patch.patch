+    private void repairIntegrity(IntegrityReport report) {
+        boolean indexChanged = false;
+        for (EntryInfo info : report.entriesByDescription()) {
+            if (info.shared) {
+                continue;
+            }
+            if (info.broken) {
+                storedRules.remove(info.description);
+                indexChanged = true;
+            } else if (info.resolved) {
+                try {
+                    deleteResolvedFile(info.path);
+                } catch (IOException e) {
+                    throw new StoreInitializationFailedException(e);
+                }
+                storedRules.remove(info.description);
+                indexChanged = true;
+            } else if (info.misplaced && !info.colliding && !info.occupied) {
+                try {
+                    moveResolvedFile(info.path, info.derivedPath);
+                } catch (IOException e) {
+                    throw new StoreInitializationFailedException(e);
+                }
+                storedRules.put(info.description, info.derivedName);
+                indexChanged = true;
+            }
+        }
+        if (indexChanged) {
+            storedRules.syncFileSystem();
+        }
+    }
