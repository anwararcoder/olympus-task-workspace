+    private String requireIntegrityFileName(String description) {
+        String result;
+        try {
+            result = ruleViolationFileNameStrategy.createRuleFileName(description);
+        } catch (RuntimeException e) {
+            throw new StoreInitializationFailedException(e);
+        }
+        if (result == null || result.isEmpty()) {
+            throw new StoreInitializationFailedException(
+                    "The rule violation filename strategy returned no name for a stored rule");
+        }
