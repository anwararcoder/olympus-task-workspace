+        String asMessage(boolean allowStoreUpdate) {
+            StringBuilder result = new StringBuilder();
+            result.append("Violation store integrity check failed (default.allowStoreUpdate=")
+                    .append(allowStoreUpdate).append("):");
+            appendEntries(result, "broken", entry -> entry.broken);
+            appendEntries(result, "resolved", entry -> entry.resolved);
+            appendEntries(result, "shared", entry -> entry.shared);
+            if (!unownedFiles.isEmpty()) {
+                result.append("\nunowned files:");
+                for (String file : unownedFiles) {
+                    result.append("\n  ").append(file);
+                }
+            }
+            appendEntries(result, "misplaced", entry -> entry.misplaced);
+            appendEntries(result, "colliding", entry -> entry.colliding);
+            appendEntries(result, "occupied", entry -> entry.occupied);
+            return result.toString();
+        }
+
+        private void appendEntries(StringBuilder result, String condition, EntryCondition predicate) {
+            List<EntryInfo> matching = new ArrayList<>();
+            for (EntryInfo entry : entries) {
+                if (predicate.matches(entry)) {
+                    matching.add(entry);
+                }
+            }
+            matching.sort(Comparator.comparing(entry -> entry.description));
+            if (!matching.isEmpty()) {
+                result.append('\n').append(condition).append(" entries:");
+                for (EntryInfo entry : matching) {
+                    result.append("\n  ").append(entry.description).append(" -> ").append(entry.fileName);
+                }
+            }
+        }
+    }
