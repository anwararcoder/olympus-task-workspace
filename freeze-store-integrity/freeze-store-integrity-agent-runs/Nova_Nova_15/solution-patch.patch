+    private boolean reachSameFile(Path first, Path second) {
+        if (first == null || second == null || !existsWithoutFollowingLinks(first) || !existsWithoutFollowingLinks(second)
+                || !Files.isRegularFile(first) || !Files.isRegularFile(second)) {
+            return false;
+        }
+        try {
+            return Files.isSameFile(first, second);
+        } catch (IOException e) {
+            return false;
+        }
+    }
