+    private List<String> findUnownedFiles(List<EntryInfo> entries) {
+        List<String> result = new ArrayList<>();
+        Path folder = storeFolder.toPath().toAbsolutePath().normalize();
+        try (DirectoryStream<Path> files = Files.newDirectoryStream(folder)) {
+            for (Path file : files) {
+                if (STORED_RULES_FILE_NAME.equals(file.getFileName().toString()) || !isRegularFileDirectly(file)) {
+                    continue;
+                }
+                boolean owned = false;
+                for (EntryInfo entry : entries) {
+                    if (reachSameFile(entry.path, file)) {
+                        owned = true;
+                        break;
+                    }
+                }
+                if (!owned) {
+                    result.add(file.getFileName().toString());
+                }
+            }
+        } catch (IOException e) {
+            throw new StoreInitializationFailedException(e);
+        }
+        Collections.sort(result);
+        return result;
+    }
