+        private final List<EntryInfo> entries;
+        private final List<String> unownedFiles;
+
+        IntegrityReport(List<EntryInfo> entries, List<String> unownedFiles) {
+            this.entries = entries;
+            this.unownedFiles = unownedFiles;
+        }
+
+        boolean hasProblems() {
+            if (!unownedFiles.isEmpty()) {
+                return true;
+            }
+            for (EntryInfo entry : entries) {
+                if (entry.broken || entry.resolved || entry.shared || entry.misplaced || entry.colliding || entry.occupied) {
+                    return true;
+                }
+            }
+            return false;
+        }
+
