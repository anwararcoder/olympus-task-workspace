+    private IntegrityReport inspectIntegrity(Map<String, String> entries) {
+        List<EntryInfo> infos = new ArrayList<>();
+        for (Map.Entry<String, String> entry : entries.entrySet()) {
+            String derivedName = randomFileNames ? entry.getValue() : requireIntegrityFileName(entry.getKey());
+            Path currentPath = pathForName(entry.getValue());
+            Path derivedPath = pathForName(derivedName);
+            EntryInfo info = new EntryInfo(entry.getKey(), entry.getValue(), derivedName, currentPath, derivedPath);
+            info.broken = !isRegularFileDirectly(currentPath);
+            if (!info.broken) {
+                try {
+                    info.resolved = parseViolations(new String(toByteArray(currentPath.toFile()), UTF_8)).isEmpty();
+                } catch (IOException e) {
+                    info.broken = true;
+                }
+            }
+            info.misplaced = !entry.getValue().equals(derivedName);
+            infos.add(info);
+        }
+
+        for (EntryInfo info : infos) {
+            for (EntryInfo other : infos) {
+                if (info == other) {
+                    continue;
+                }
+                if (info.fileName.equals(other.fileName)) {
+                    info.shared = true;
+                } else if (reachSameFile(info.path, other.path)) {
+                    info.shared = true;
+                }
+            }
+        }
+
+        Set<String> derivedNames = new HashSet<>();
+        for (EntryInfo info : infos) {
+            if (info.derivedName != null && !info.derivedName.isEmpty()) {
+                if (!derivedNames.add(info.derivedName)) {
+                    info.colliding = true;
+                    for (EntryInfo other : infos) {
+                        if (info != other && info.derivedName.equals(other.derivedName)) {
+                            other.colliding = true;
+                        }
+                    }
+                }
+            }
+        }
+        for (EntryInfo info : infos) {
+            if (info.misplaced) {
+                boolean recordedByAnother = false;
+                for (EntryInfo other : infos) {
+                    if (info != other && info.derivedName != null && info.derivedName.equals(other.fileName)) {
+                        recordedByAnother = true;
+                        break;
+                    }
+                }
+                info.occupied = !isDirectLocation(info.derivedPath)
+                        || existsWithoutFollowingLinks(info.derivedPath) || recordedByAnother;
+            }
+        }
+
+        List<String> unownedFiles = findUnownedFiles(infos);
+        return new IntegrityReport(infos, unownedFiles);
+    }
