+    private Set<String> findSharedFileNames(Collection<String> fileNames) {
+        List<String> names = new ArrayList<>(fileNames);
+        Set<String> sharedFileNames = new HashSet<>();
+        for (int firstIndex = 0; firstIndex < names.size(); firstIndex++) {
+            for (int secondIndex = firstIndex + 1; secondIndex < names.size(); secondIndex++) {
+                String firstName = names.get(firstIndex);
+                String secondName = names.get(secondIndex);
