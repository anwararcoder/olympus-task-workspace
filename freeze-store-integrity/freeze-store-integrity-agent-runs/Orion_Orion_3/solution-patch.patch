+        store.initialize(storeProperties("repair"));
+        byte[] originalIndex = indexContents();
+
+        store.save(rule("unknown rule"), emptyList());
+
+        assertThat(store.contains(rule("unknown rule"))).isFalse();
+        assertThat(indexContents()).isEqualTo(originalIndex);
+        assertThat(storeFolder.toFile().list()).containsExactly("stored.rules");
+    }
+
+    @ParameterizedTest
+    @ValueSource(strings = {"same name", "missing", "invalid", "symbolic", "hard", "outside symbolic", "outside hard"})
+    public void forgetting_a_shared_rule_removes_only_its_entry(String sharing) throws IOException {
+        String firstFileName = "shared";
+        String secondFileName = firstFileName;
+        Path target = null;
+        Path link = null;
+        if (sharing.equals("missing")) {
+            firstFileName = secondFileName = "missing";
+        } else if (sharing.equals("invalid")) {
+            firstFileName = secondFileName = "invalid\0name";
+        } else if (sharing.equals("same name")) {
+            target = writeFile(firstFileName, "\n");
+        } else {
+            firstFileName = sharing.startsWith("outside") ? "../outside" : "target";
+            secondFileName = "link";
+            target = writeFile(firstFileName, "\n");
+            link = createLink(sharing.endsWith("symbolic") ? "symbolic" : "hard", storeFolder.resolve(secondFileName), target);
+        }
+        writeIndex("first rule", firstFileName, "second rule", secondFileName);
+        ViolationStore store = newStore("repair");
+
+        store.save(rule("first rule"), emptyList());
+
+        assertThat(store.contains(rule("first rule"))).isFalse();
+        assertThat(store.contains(rule("second rule"))).isTrue();
+        assertThat(readIndex()).isEqualTo(indexProperties("second rule", secondFileName));
+        if (target != null) {
+            assertThat(target).hasContent("\n");
+        }
+        if (link != null) {
+            assertThat(Files.isSameFile(link, target)).isTrue();
+        }
+    }
+
+    @ParameterizedTest
+    @ValueSource(strings = {"relative", "absolute", "symbolic"})
+    public void forgetting_a_rule_deletes_its_unshared_file_even_outside_the_folder(String pathType) throws IOException {
+        Path outsideFile = writeFile("../outside", "previous violation\n").normalize();
+        String fileName = pathType.equals("absolute") ? outsideFile.toString() : "../outside";
+        Path link = null;
+        if (pathType.equals("symbolic")) {
+            fileName = "link";
+            link = createLink("symbolic", storeFolder.resolve(fileName), outsideFile);
+        }
+        String ruleFileName = fileName;
+        ViolationStore store = new TextFileBasedViolationStore(__ -> ruleFileName);
+        store.initialize(storeProperties("repair"));
+        store.save(rule("known rule"), singletonList("violation"));
+
+        store.save(rule("known rule"), emptyList());
+
+        assertThat(store.contains(rule("known rule"))).isFalse();
+        assertThat(readIndex()).isEmpty();
+        assertDeleted(outsideFile);
+        if (link != null) {
+            assertDeleted(link);
+        }
+    }
+
+    @Test
+    public void fails_to_forget_a_rule_and_preserves_its_entry_if_its_file_cannot_be_deleted() throws IOException {
+        ViolationStore store = new TextFileBasedViolationStore(__ -> "violations");
+        store.initialize(storeProperties("repair"));
+        store.save(rule("known rule"), singletonList("violation"));
+        byte[] originalIndex = indexContents();
+        Files.delete(storeFolder.resolve("violations"));
+        Path directoryContent = writeFile("violations/content", "prevents deletion");
+
+        assertThatThrownBy(() -> store.save(rule("known rule"), emptyList()))
+                .isInstanceOf(StoreUpdateFailedException.class)
+                .hasCauseInstanceOf(DirectoryNotEmptyException.class);
+
+        assertThat(store.contains(rule("known rule"))).isTrue();
+        assertThat(indexContents()).isEqualTo(originalIndex);
+        assertThat(directoryContent).hasContent("prevents deletion");
+    }
+
+    @Test
+    public void fails_to_forget_a_rule_and_preserves_its_entry_if_its_file_has_disappeared() throws IOException {
+        ViolationStore store = new TextFileBasedViolationStore(__ -> "violations");
+        store.initialize(storeProperties("repair"));
+        store.save(rule("known rule"), singletonList("violation"));
+        byte[] originalIndex = indexContents();
+        Files.delete(storeFolder.resolve("violations"));
+
+        assertThatThrownBy(() -> store.save(rule("known rule"), emptyList()))
+                .isInstanceOf(StoreUpdateFailedException.class)
+                .hasCauseInstanceOf(NoSuchFileException.class);
+
+        assertThat(store.contains(rule("known rule"))).isTrue();
+        assertThat(indexContents()).isEqualTo(originalIndex);
+    }
+
+    @Test
+    public void cannot_forget_a_rule_when_store_updates_are_disabled() throws IOException {
+        Path file = writeFile("violations", "violation\n");
+        writeIndex("known rule", "violations");
+        Properties properties = storeProperties("repair");
+        properties.setProperty("default.allowStoreUpdate", "false");
+        ViolationStore store = new TextFileBasedViolationStore();
+        store.initialize(properties);
+        byte[] originalIndex = indexContents();
+
+        assertThatThrownBy(() -> store.save(rule("known rule"), emptyList()))
+                .isInstanceOf(StoreUpdateFailedException.class);
+
+        assertThat(store.contains(rule("known rule"))).isTrue();
+        assertThat(indexContents()).isEqualTo(originalIndex);
+        assertThat(file).hasContent("violation\n");
+    }
+
+    private ViolationStore newStore(String integrity) {
+        ViolationStore store = new TextFileBasedViolationStore();
+        store.initialize(storeProperties(integrity));
+        return store;
+    }
+
+    private Properties storeProperties(String integrity) {
+        Properties properties = new Properties();
+        properties.setProperty("default.path", storeFolder.toString());
+        properties.setProperty("default.allowStoreCreation", "true");
+        if (!integrity.isEmpty()) {
+            properties.setProperty("default.integrity", integrity);
+        }
+        return properties;
+    }
+
+    private Path writeFile(String fileName, String contents) throws IOException {
+        Path file = storeFolder.resolve(fileName);
+        Files.createDirectories(file.getParent());
+        return Files.write(file, contents.getBytes(UTF_8));
+    }
+
+    private Path createLink(String linkType, Path link, Path target) throws IOException {
+        try {
+            return linkType.equals("symbolic") ? Files.createSymbolicLink(link, target) : Files.createLink(link, target);
+        } catch (UnsupportedOperationException | FileSystemException exception) {
+            assumeTrue(false, linkType + " links are unavailable: " + exception.getMessage());
+            return link;
+        }
+    }
+
+    private void writeIndex(String... entries) throws IOException {
+        try (OutputStream outputStream = Files.newOutputStream(storeFolder.resolve("stored.rules"))) {
+            indexProperties(entries).store(outputStream, "");
+        }
+    }
+
+    private Properties indexProperties(String... entries) {
+        Properties properties = new Properties();
+        for (int entryIndex = 0; entryIndex < entries.length; entryIndex += 2) {
+            properties.setProperty(entries[entryIndex], entries[entryIndex + 1]);
+        }
+        return properties;
+    }
+
+    private Properties readIndex() throws IOException {
+        Properties properties = new Properties();
+        try (InputStream inputStream = Files.newInputStream(storeFolder.resolve("stored.rules"))) {
+            properties.load(inputStream);
+        }
+        return properties;
+    }
+
+    private byte[] indexContents() throws IOException {
+        return Files.readAllBytes(storeFolder.resolve("stored.rules"));
+    }
+
+    private void assertDeleted(Path path) {
+        assertThat(Files.exists(path, NOFOLLOW_LINKS)).as("exists without following links: %s", path).isFalse();
+    }
+
+    private ArchRule rule(String description) {
+        return classes().should().bePublic().as(description);
+    }
+}
