+    @Test
+    public void rechecks_files_when_the_same_folder_is_initialized_again() throws IOException {
+        Path file = writeFile("violations", "violation\n");
+        writeIndex("known rule", "violations");
+        ViolationStore store = newStore("repair");
+        Files.write(file, new byte[0]);
+
+        store.initialize(storeProperties("repair"));
+
+        assertThat(store.contains(rule("known rule"))).isFalse();
+        assertThat(readIndex()).isEmpty();
+        assertDeleted(file);
+    }
+
+    @Test
+    public void repairs_broken_entries_with_windows_line_breaks_in_their_descriptions() throws IOException {
+        writeIndex("broken\r\nrule", "missing");
+
+        newStore("repair");
+
+        assertThat(readIndex()).isEmpty();
+    }
+
+    @Test
+    public void recreates_a_deleted_index_when_store_creation_is_allowed() throws IOException {
+        Path previouslyIndexedFile = writeFile("violations", "violation\n");
+        writeIndex("known rule", "violations");
+        ViolationStore store = newStore("repair");
+        Files.delete(storeFolder.resolve("stored.rules"));
+
+        store.initialize(storeProperties("repair"));
+
+        assertThat(store.contains(rule("known rule"))).isFalse();
+        assertThat(readIndex()).isEmpty();
+        assertThat(previouslyIndexedFile).exists();
+    }
+
+    @ParameterizedTest
+    @ValueSource(strings = {"known rule", "known\r\nrule"})
+    public void forgets_known_rules_when_saving_no_violations(String description) throws IOException {
+        ViolationStore store = new TextFileBasedViolationStore(__ -> "violations");
+        store.initialize(storeProperties("repair"));
+        store.save(rule(description), singletonList("violation"));
+        Path unreferencedFile = writeFile("unreferenced", "");
+
+        store.save(rule(description), emptyList());
+
+        assertThat(store.contains(rule(description))).isFalse();
+        assertThat(readIndex()).isEmpty();
+        assertDeleted(storeFolder.resolve("violations"));
+        assertThat(unreferencedFile).exists();
+    }
+
+    @Test
+    public void does_not_store_unknown_rules_without_violations() throws IOException {
+        ViolationStore store = new TextFileBasedViolationStore(description -> {
+            throw new AssertionError("No file name should be created for an unknown rule without violations");
+        });
+        store.initialize(storeProperties("repair"));
+        byte[] originalIndex = indexContents();
+
+        store.save(rule("unknown rule"), emptyList());
+
+        assertThat(store.contains(rule("unknown rule"))).isFalse();
+        assertThat(indexContents()).isEqualTo(originalIndex);
+        assertThat(storeFolder.toFile().list()).containsExactly("stored.rules");
+    }
+
+    @ParameterizedTest
+    @ValueSource(strings = {"same name", "missing", "invalid", "symbolic", "hard", "outside symbolic", "outside hard"})
+    public void forgetting_a_shared_rule_removes_only_its_entry(String sharing) throws IOException {
+        String firstFileName = "shared";
+        String secondFileName = firstFileName;
+        Path target = null;
+        Path link = null;
+        if (sharing.equals("missing")) {
+            firstFileName = secondFileName = "missing";
+        } else if (sharing.equals("invalid")) {
+            firstFileName = secondFileName = "invalid\0name";
+        } else if (sharing.equals("same name")) {
+            target = writeFile(firstFileName, "\n");
+        } else {
+            firstFileName = sharing.startsWith("outside") ? "../outside" : "target";
+            secondFileName = "link";
+            target = writeFile(firstFileName, "\n");
+            link = createLink(sharing.endsWith("symbolic") ? "symbolic" : "hard", storeFolder.resolve(secondFileName), target);
+        }
+        writeIndex("first rule", firstFileName, "second rule", secondFileName);
+        ViolationStore store = newStore("repair");
+
+        store.save(rule("first rule"), emptyList());
+
+        assertThat(store.contains(rule("first rule"))).isFalse();
+        assertThat(store.contains(rule("second rule"))).isTrue();
+        assertThat(readIndex()).isEqualTo(indexProperties("second rule", secondFileName));
+        if (target != null) {
+            assertThat(target).hasContent("\n");
+        }
+        if (link != null) {
+            assertThat(Files.isSameFile(link, target)).isTrue();
+        }
+    }
+
+    @ParameterizedTest
+    @ValueSource(strings = {"relative", "absolute", "symbolic"})
+    public void forgetting_a_rule_deletes_its_unshared_file_even_outside_the_folder(String pathType) throws IOException {
+        Path outsideFile = writeFile("../outside", "previous violation\n").normalize();
+        String fileName = pathType.equals("absolute") ? outsideFile.toString() : "../outside";
+        Path link = null;
+        if (pathType.equals("symbolic")) {
+            fileName = "link";
+            link = createLink("symbolic", storeFolder.resolve(fileName), outsideFile);
+        }
+        String ruleFileName = fileName;
+        ViolationStore store = new TextFileBasedViolationStore(__ -> ruleFileName);
+        store.initialize(storeProperties("repair"));
+        store.save(rule("known rule"), singletonList("violation"));
+
+        store.save(rule("known rule"), emptyList());
+
+        assertThat(store.contains(rule("known rule"))).isFalse();
+        assertThat(readIndex()).isEmpty();
+        assertDeleted(outsideFile);
+        if (link != null) {
+            assertDeleted(link);
+        }
+    }
+
+    @Test
+    public void fails_to_forget_a_rule_and_preserves_its_entry_if_its_file_cannot_be_deleted() throws IOException {
+        ViolationStore store = new TextFileBasedViolationStore(__ -> "violations");
+        store.initialize(storeProperties("repair"));
+        store.save(rule("known rule"), singletonList("violation"));
+        byte[] originalIndex = indexContents();
+        Files.delete(storeFolder.resolve("violations"));
+        Path directoryContent = writeFile("violations/content", "prevents deletion");
+
+        assertThatThrownBy(() -> store.save(rule("known rule"), emptyList()))
+                .isInstanceOf(StoreUpdateFailedException.class)
+                .hasCauseInstanceOf(DirectoryNotEmptyException.class);
+
+        assertThat(store.contains(rule("known rule"))).isTrue();
+        assertThat(indexContents()).isEqualTo(originalIndex);
+        assertThat(directoryContent).hasContent("prevents deletion");
+    }
+
+    @Test
+    public void fails_to_forget_a_rule_and_preserves_its_entry_if_its_file_has_disappeared() throws IOException {
+        ViolationStore store = new TextFileBasedViolationStore(__ -> "violations");
+        store.initialize(storeProperties("repair"));
+        store.save(rule("known rule"), singletonList("violation"));
+        byte[] originalIndex = indexContents();
+        Files.delete(storeFolder.resolve("violations"));
+
+        assertThatThrownBy(() -> store.save(rule("known rule"), emptyList()))
+                .isInstanceOf(StoreUpdateFailedException.class)
+                .hasCauseInstanceOf(NoSuchFileException.class);
+
+        assertThat(store.contains(rule("known rule"))).isTrue();
+        assertThat(indexContents()).isEqualTo(originalIndex);
+    }
+
+    @Test
+    public void cannot_forget_a_rule_when_store_updates_are_disabled() throws IOException {
+        Path file = writeFile("violations", "violation\n");
+        writeIndex("known rule", "violations");
+        Properties properties = storeProperties("repair");
+        properties.setProperty("default.allowStoreUpdate", "false");
+        ViolationStore store = new TextFileBasedViolationStore();
+        store.initialize(properties);
+        byte[] originalIndex = indexContents();
+
+        assertThatThrownBy(() -> store.save(rule("known rule"), emptyList()))
+                .isInstanceOf(StoreUpdateFailedException.class);
+
+        assertThat(store.contains(rule("known rule"))).isTrue();
+        assertThat(indexContents()).isEqualTo(originalIndex);
+        assertThat(file).hasContent("violation\n");
+    }
+
+    private ViolationStore newStore(String integrity) {
+        ViolationStore store = new TextFileBasedViolationStore();
+        store.initialize(storeProperties(integrity));
+        return store;
+    }
+
+    private Properties storeProperties(String integrity) {
+        Properties properties = new Properties();
+        properties.setProperty("default.path", storeFolder.toString());
+        properties.setProperty("default.allowStoreCreation", "true");
+        if (!integrity.isEmpty()) {
+            properties.setProperty("default.integrity", integrity);
+        }
+        return properties;
+    }
+
+    private Path writeFile(String fileName, String contents) throws IOException {
+        Path file = storeFolder.resolve(fileName);
+        Files.createDirectories(file.getParent());
+        return Files.write(file, contents.getBytes(UTF_8));
+    }
+
+    private Path createLink(String linkType, Path link, Path target) throws IOException {
+        try {
+            return linkType.equals("symbolic") ? Files.createSymbolicLink(link, target) : Files.createLink(link, target);
+        } catch (UnsupportedOperationException | FileSystemException exception) {
+            assumeTrue(false, linkType + " links are unavailable: " + exception.getMessage());
+            return link;
+        }
+    }
+
+    private void writeIndex(String... entries) throws IOException {
+        try (OutputStream outputStream = Files.newOutputStream(storeFolder.resolve("stored.rules"))) {
+            indexProperties(entries).store(outputStream, "");
+        }
+    }
+
+    private Properties indexProperties(String... entries) {
+        Properties properties = new Properties();
+        for (int entryIndex = 0; entryIndex < entries.length; entryIndex += 2) {
+            properties.setProperty(entries[entryIndex], entries[entryIndex + 1]);
+        }
+        return properties;
+    }
+
+    private Properties readIndex() throws IOException {
+        Properties properties = new Properties();
+        try (InputStream inputStream = Files.newInputStream(storeFolder.resolve("stored.rules"))) {
+            properties.load(inputStream);
+        }
+        return properties;
+    }
+
+    private byte[] indexContents() throws IOException {
+        return Files.readAllBytes(storeFolder.resolve("stored.rules"));
+    }
+
+    private void assertDeleted(Path path) {
+        assertThat(Files.exists(path, NOFOLLOW_LINKS)).as("exists without following links: %s", path).isFalse();
+    }
+
+    private ArchRule rule(String description) {
+        return classes().should().bePublic().as(description);
+    }
+}
diff --git a/docs/userguide/008_The_Library_API.adoc b/docs/userguide/008_The_Library_API.adoc
index 10ed830..3fd182b 100644
--- a/docs/userguide/008_The_Library_API.adoc
+++ b/docs/userguide/008_The_Library_API.adoc
@@ -495,6 +495,18 @@ For example to allow the creation of the violation store in a specific environme
 -Darchunit.freeze.store.default.allowStoreCreation=true
 ----
 
+To repair the integrity of an existing store on initialization, configure
+`freeze.store.default.integrity=repair` (the default is `ignore`, which performs no integrity checks).
+Every initialization checks the current index and files on disk, even if the store was already initialized.
+Repair removes entries whose paths are invalid or do not point to regular files directly within the store folder.
+It also removes entries and their files when no violations remain, including files containing only line breaks.
+For symbolic links to resolved files, both the link and its target are deleted.
+Entries sharing a file name or referring to the same file, including through symbolic or hard links, are left untouched,
+as are files not referenced by any entry.
+In repair mode, saving an empty list of violations forgets a known rule instead of storing an empty file.
+Its file is deleted unless another entry refers to it; an unknown rule with no violations is not stored.
+If the file cannot be deleted, saving fails and the rule's entry is retained.
+
 It is also possible to allow all violations to be "refrozen", i.e. the store will just be updated
 with the current state, and the reported result will be success. Thus, it is effectively the same behavior
 as if all rules would never have been frozen.
diff --git a/test.sh b/test.sh
new file mode 100755
index 0000000..a702759
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,173 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+INVOKE_DIR="$PWD"
+cd "$(dirname "$0")"
+
+usage() {
+  echo "Usage: $0 --output_path <path> {base|new}" >&2
+  exit 2
+}
+
+OUTPUT_PATH=""
+MODE=""
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --output_path)
+      [[ $# -ge 2 ]] || usage
+      OUTPUT_PATH="$2"
+      shift 2
+      ;;
+    base|new)
+      MODE="$1"
+      shift
+      ;;
+    *)
+      usage
+      ;;
+  esac
+done
+
+if [[ -z "$OUTPUT_PATH" || -z "$MODE" ]]; then
+  usage
+fi
+
+case "$OUTPUT_PATH" in
+  /*) ;;
+  *) OUTPUT_PATH="$INVOKE_DIR/$OUTPUT_PATH" ;;
+esac
+
+if [[ -L "$OUTPUT_PATH" || ( -e "$OUTPUT_PATH" && ! -f "$OUTPUT_PATH" ) ]]; then
+  echo "Output path $OUTPUT_PATH is not a regular file" >&2
+  exit 2
+fi
+
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+# a report an earlier run left at the output path must never pass for the result of this run
+rm -f "$OUTPUT_PATH"
+
+case "$MODE" in
+  base)
+    GRADLE_TARGET="freezeStoreBaselineTest"
+    RESULT_DIR="archunit/build/test-results/freezeStoreBaselineTest"
+    ;;
+  new)
+    GRADLE_TARGET="freezeStoreMaintenanceTest"
+    RESULT_DIR="archunit/build/test-results/freezeStoreMaintenanceTest"
+    ;;
+esac
+
+SCRATCH="$(mktemp -d)"
+STAGED=""
+trap 'rm -rf "$SCRATCH"; [[ -z "$STAGED" ]] || rm -f "$STAGED"' EXIT
+
+rm -rf "$RESULT_DIR"
+
+# the jdk9main compilation shares this output directory and can prune classes of an incremental
+# build, so every run compiles it from scratch
+rm -rf archunit/build/classes/java/main
+
+set +e
+./gradlew --offline --no-daemon -Dscan=false ":archunit:${GRADLE_TARGET}" 2>&1 | tee "$SCRATCH/gradle.log"
+STATUS="${PIPESTATUS[0]}"
+set -e
+
+cat > "$SCRATCH/MalformedXml.java" <<'EOF'
+import java.io.File;
+import javax.xml.XMLConstants;
+import javax.xml.parsers.DocumentBuilder;
+import javax.xml.parsers.DocumentBuilderFactory;
+import org.xml.sax.helpers.DefaultHandler;
+
+public class MalformedXml {
+    public static void main(String[] args) throws Exception {
+        DocumentBuilderFactory factory = DocumentBuilderFactory.newInstance();
+        factory.setFeature("http://apache.org/xml/features/disallow-doctype-decl", true);
+        factory.setFeature(XMLConstants.FEATURE_SECURE_PROCESSING, true);
+        factory.setAttribute(XMLConstants.ACCESS_EXTERNAL_DTD, "");
+        factory.setAttribute(XMLConstants.ACCESS_EXTERNAL_SCHEMA, "");
+        factory.setXIncludeAware(false);
+        factory.setExpandEntityReferences(false);
+        DocumentBuilder builder = factory.newDocumentBuilder();
+        builder.setErrorHandler(new DefaultHandler());
+        for (String path : args) {
+            try {
+                builder.parse(new File(path));
+            } catch (Exception e) {
+                System.out.println(path);
+            }
+        }
+    }
+}
+EOF
+
+# prints every given file that is not well-formed XML, or all of them if they cannot be checked
+malformed_among() {
+  local checked
+  if checked="$(java "$SCRATCH/MalformedXml.java" "$@")"; then
+    [[ -z "$checked" ]] || printf '%s\n' "$checked"
+  else
+    printf '%s\n' "$@"
+  fi
+}
+
+error_suite() {
+  local name="$1" message="$2" details="$3"
+  echo "<testsuite name=\"${name}\" tests=\"1\" skipped=\"0\" failures=\"0\" errors=\"1\">"
+  echo "<testcase classname=\"${GRADLE_TARGET}\" name=\"${name}\">"
+  echo "<error message=\"${message}\"><![CDATA["
+  tail -n 200 "$details" | tr -d '\000-\010\013\014\016-\037' | sed 's/]]>/]]]]><![CDATA[>/g'
+  echo ']]></error>'
+  echo '</testcase>'
+  echo '</testsuite>'
+}
+
+REPORT="$SCRATCH/report.xml"
+shopt -s nullglob
+RESULT_FILES=("$RESULT_DIR"/*.xml)
+shopt -u nullglob
+
+MALFORMED=()
+if [[ ${#RESULT_FILES[@]} -gt 0 ]]; then
+  mapfile -t MALFORMED < <(malformed_among "${RESULT_FILES[@]}")
+fi
+
+{
+  echo '<?xml version="1.0" encoding="UTF-8"?>'
+  echo '<testsuites>'
+  for result_file in "${RESULT_FILES[@]}"; do
+    if [[ " ${MALFORMED[*]} " == *" ${result_file} "* ]]; then
+      echo "Malformed JUnit XML: $result_file" >&2
+      error_suite "$(basename "$result_file" .xml)" "Malformed JUnit XML produced by ${GRADLE_TARGET}" "$result_file"
+    else
+      sed '1{/^<?xml/d;}' "$result_file"
+    fi
+  done
+  if [[ ${#RESULT_FILES[@]} -eq 0 ]]; then
+    echo "No JUnit XML was produced by $GRADLE_TARGET" >&2
+    error_suite "build" "Gradle produced no JUnit XML for ${GRADLE_TARGET}" "$SCRATCH/gradle.log"
+  fi
+  echo '</testsuites>'
+} > "$REPORT"
+
+if [[ ${#RESULT_FILES[@]} -eq 0 || ${#MALFORMED[@]} -gt 0 ]] && [[ "$STATUS" -eq 0 ]]; then
+  STATUS=1
+fi
+
+if [[ -n "$(malformed_among "$REPORT")" ]]; then
+  echo "The merged JUnit XML is malformed" >&2
+  printf '%s\n' '<?xml version="1.0" encoding="UTF-8"?>' '<testsuites>' \
+    "<testsuite name=\"report\" tests=\"1\" skipped=\"0\" failures=\"0\" errors=\"1\">" \
+    "<testcase classname=\"${GRADLE_TARGET}\" name=\"report\"><error message=\"Malformed JUnit XML\"/></testcase>" \
+    '</testsuite>' '</testsuites>' > "$REPORT"
+  STATUS=1
+fi
+
+# publish the report of this run in one step, so the output path never holds a partial one
+STAGED="$(mktemp "$(dirname "$OUTPUT_PATH")/.results.XXXXXX")"
+cp "$REPORT" "$STAGED"
+chmod 644 "$STAGED"
+mv -f "$STAGED" "$OUTPUT_PATH"
+STAGED=""
+exit "$STATUS"
