+                "direct outside rule 2", "../direct_outside.txt"
+        ));
+
+        ViolationStore repairStore = new TextFileBasedViolationStore();
+        repairStore.initialize(repairStoreProperties());
+
+        ArchRule outsideRule1 = rule("direct outside rule 1");
+        ArchRule outsideRule2 = rule("direct outside rule 2");
+        assertThat(repairStore.contains(outsideRule1)).isTrue();
+        assertThat(repairStore.contains(outsideRule2)).isTrue();
+
