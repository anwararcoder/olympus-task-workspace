+    public void repair_saving_no_violations_for_known_rule_pointing_outside_deletes_outside_file() throws IOException {
+        configuredFolder.mkdirs();
+        File outsideFile = new File(temporaryFolder.toFile(), "direct_outside.txt");
+        java.nio.file.Files.write(outsideFile.toPath(), "violation\n".getBytes(UTF_8));
