+    @Test
+    public void saving_no_violations_fails_and_leaves_entry_if_file_cannot_be_deleted() throws IOException {
+        ViolationStore repairStore = new TextFileBasedViolationStore();
+        repairStore.initialize(storePropertiesWith("default.integrity", "repair"));
+
+        ArchRule knownRule = rule("known rule");
+        repairStore.save(knownRule, ImmutableList.of("some violation"));
+
+        Properties propertiesBefore = readProperties(new File(configuredFolder, "stored.rules"));
+        String ruleFileName = propertiesBefore.getProperty(knownRule.getDescription());
+        File violationFile = new File(configuredFolder, ruleFileName);
+        assertThat(violationFile).exists();
+
+        configuredFolder.setWritable(false);
+        try {
+            assertThatThrownBy(() -> repairStore.save(knownRule, ImmutableList.of()))
+                    .isInstanceOf(StoreUpdateFailedException.class);
+
+            assertThat(repairStore.contains(knownRule)).isTrue();
+            Properties propertiesAfter = readProperties(new File(configuredFolder, "stored.rules"));
+            assertThat(propertiesAfter).containsKey(knownRule.getDescription());
+            assertThat(violationFile).exists();
+        } finally {
+            configuredFolder.setWritable(true);
+        }
+    }
