+    private void writeStoredRules(Properties properties) throws IOException {
+        writeStoredRulesTo(configuredFolder, properties);
+    }
+
+    private void writeStoredRulesTo(File folder, Properties properties) throws IOException {
+        folder.mkdirs();
+        try (FileOutputStream outputStream = new FileOutputStream(new File(folder, "stored.rules"))) {
+            properties.store(outputStream, "");
+        }
+    }
+
+    private Properties storePropertiesWith(String... keyValuePairs) {
+        Properties properties = defaultStoreProperties();
+        LinkedList<String> keyValues = new LinkedList<>(asList(keyValuePairs));
+        while (!keyValues.isEmpty()) {
+            properties.setProperty(keyValues.poll(), keyValues.poll());
+        }
+        return properties;
+    }
