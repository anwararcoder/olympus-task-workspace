+    @Test
+    public void save_no_violations_fails_if_cannot_delete_file_and_leaves_entry() throws IOException {
+        ViolationStore store = new TextFileBasedViolationStore();
+        store.initialize(repairStoreProperties());
+
+        ArchRule rule = rule("rule with locked file");
+        store.save(rule, ImmutableList.of("violation"));
+        assertThat(store.contains(rule)).isTrue();
+
+        File rulesFile = new File(configuredFolder, "stored.rules");
+        String fileName = readProperties(rulesFile).getProperty(rule.getDescription());
+        File file = new File(configuredFolder, fileName);
+        assertThat(file).exists();
+
+        // Make store folder non-writable so file cannot be deleted
+        configuredFolder.setWritable(false);
+        try {
+            assertThatThrownBy(() -> store.save(rule, Collections.emptyList()))
+                    .isInstanceOf(StoreUpdateFailedException.class);
+
+            // Entry must remain in the store
+            assertThat(store.contains(rule)).isTrue();
+            assertThat(readProperties(rulesFile).getProperty(rule.getDescription())).isEqualTo(fileName);
+        } finally {
+            configuredFolder.setWritable(true);
+        }
+    }
+
+    private Properties readProperties(File file) throws IOException {
+        Properties properties = new Properties();
+        try (FileInputStream inputStream = new FileInputStream(file)) {
+            properties.load(inputStream);
+        }
+        return properties;
+    }
+
+    private Properties defaultStoreProperties() {
+        return propertiesOf(
+                "default.path", configuredFolder.getAbsolutePath(),
+                "default.allowStoreCreation", String.valueOf(true));
+    }
+
+    private Properties repairStoreProperties() {
+        return propertiesOf(
+                "default.path", configuredFolder.getAbsolutePath(),
+                "default.allowStoreCreation", String.valueOf(true),
+                "default.integrity", "repair");
+    }
+
+    private Properties propertiesOf(String... keyValuePairs) {
+        Properties result = new Properties();
+        LinkedList<String> keyValues = new LinkedList<>(asList(keyValuePairs));
+        while (!keyValues.isEmpty()) {
+            result.setProperty(keyValues.poll(), keyValues.poll());
+        }
+        return result;
+    }
+
+    private ArchRule rule(String description) {
+        return classes().should().bePublic().as(description);
+    }
