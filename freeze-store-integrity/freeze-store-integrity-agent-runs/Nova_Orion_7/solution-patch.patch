+    @Test
+    public void save_no_violations_for_known_rule_shared_file_only_removes_entry() throws IOException {
+        ViolationStore store = new TextFileBasedViolationStore();
+        store.initialize(repairStoreProperties());
+
+        ArchRule rule1 = rule("rule 1");
+        ArchRule rule2 = rule("rule 2");
+
+        // Manually create two rules pointing to the same file in stored.rules
+        File rulesFile = new File(configuredFolder, "stored.rules");
+        File sharedFile = new File(configuredFolder, "shared_violation.txt");
+        Files.write(sharedFile.toPath(), "shared violation\n".getBytes(UTF_8));
+
+        Properties props = new Properties();
+        props.setProperty(rule1.getDescription(), "shared_violation.txt");
+        props.setProperty(rule2.getDescription(), "shared_violation.txt");
+        try (FileOutputStream out = new FileOutputStream(rulesFile)) {
+            props.store(out, "");
+        }
+
+        // Re-initialize to load properties
+        store.initialize(repairStoreProperties());
+        assertThat(store.contains(rule1)).isTrue();
+        assertThat(store.contains(rule2)).isTrue();
+
+        // Save no violations for rule1
+        store.save(rule1, Collections.emptyList());
+
+        // rule1 removed, but sharedFile must NOT be deleted because rule2 shares it
+        assertThat(store.contains(rule1)).isFalse();
+        assertThat(store.contains(rule2)).isTrue();
+        assertThat(sharedFile).exists();
+
+        Properties afterProps = readProperties(rulesFile);
+        assertThat(afterProps.getProperty(rule1.getDescription())).isNull();
+        assertThat(afterProps.getProperty(rule2.getDescription())).isEqualTo("shared_violation.txt");
+
+        // Now save no violations for rule2 (no longer shared)
+        store.save(rule2, Collections.emptyList());
+
+        assertThat(store.contains(rule2)).isFalse();
+        assertThat(sharedFile).doesNotExist();
+        assertThat(readProperties(rulesFile)).isEmpty();
+    }
