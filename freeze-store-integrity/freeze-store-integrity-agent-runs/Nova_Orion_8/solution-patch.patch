+    private void forgetRule(ArchRule rule) {
+        String ruleDescription = rule.getDescription();
+        String fileName = storedRules.getProperty(ruleDescription);
+        if (fileName == null) {
+            return;
+        }
+        boolean isShared = isSharedWithAnotherEntry(ruleDescription, fileName);
+        if (!isShared) {
+            Path filePath = resolvePathSafely(storeFolder, fileName);
+            if (filePath == null) {
+                throw new StoreUpdateFailedException(String.format("Cannot resolve file '%s' for rule '%s'", fileName, ruleDescription));
+            }
+            try {
+                deleteFileAndSymlinkTarget(filePath);
+            } catch (IOException e) {
+                throw new StoreUpdateFailedException(e);
+            }
+        }
+        storedRules.remove(ruleDescription);
+    }
+
+    private void repairStore() {
+        Map<String, String> entries = storedRules.getAllProperties();
+        if (entries.isEmpty()) {
+            return;
+        }
+
+        Set<String> sharedRuleDescriptions = findSharedEntries(entries);
+        List<String> entriesToDiscard = new ArrayList<>();
+        List<String> resolvedFilesToDelete = new ArrayList<>();
+
+        for (Map.Entry<String, String> entry : entries.entrySet()) {
+            String ruleDescription = entry.getKey();
+            String fileName = entry.getValue();
+
+            if (sharedRuleDescriptions.contains(ruleDescription)) {
+                continue;
+            }
+
+            if (isBroken(storeFolder, fileName)) {
+                entriesToDiscard.add(ruleDescription);
+            } else if (isResolved(fileName)) {
+                entriesToDiscard.add(ruleDescription);
+                resolvedFilesToDelete.add(fileName);
+            }
+        }
+
+        for (String fileName : resolvedFilesToDelete) {
+            Path resolved = storeFolder.toPath().resolve(fileName);
+            try {
+                deleteFileAndSymlinkTarget(resolved);
+            } catch (IOException e) {
+                throw new StoreInitializationFailedException(e);
+            }
+        }
+
+        for (String ruleDescription : entriesToDiscard) {
+            storedRules.removeWithoutSync(ruleDescription);
+        }
+
+        if (!entriesToDiscard.isEmpty()) {
+            try {
+                storedRules.syncFileSystem();
+            } catch (StoreUpdateFailedException e) {
+                throw new StoreInitializationFailedException(e.getCause() != null ? e.getCause() : e);
+            }
+        }
+    }
+
+    private boolean isBroken(File storeFolder, String fileName) {
+        if (fileName == null || fileName.isEmpty()) {
+            return true;
+        }
+        if (fileName.contains("/") || fileName.contains("\\")) {
+            return true;
+        }
+        if (".".equals(fileName) || "..".equals(fileName)) {
+            return true;
+        }
+        Path path;
+        try {
+            path = Paths.get(fileName);
+        } catch (InvalidPathException e) {
+            return true;
+        }
+        if (path.isAbsolute() || path.getParent() != null || path.getNameCount() != 1) {
+            return true;
+        }
+        Path resolved = storeFolder.toPath().resolve(path);
+        return !Files.isRegularFile(resolved);
+    }
+
+    private boolean isResolved(String fileName) {
+        try {
+            return readLines(fileName).isEmpty();
+        } catch (StoreReadException e) {
+            return false;
+        }
+    }
+
+    private Set<String> findSharedEntries(Map<String, String> entries) {
+        Set<String> shared = new HashSet<>();
+        List<Map.Entry<String, String>> entryList = new ArrayList<>(entries.entrySet());
+        int size = entryList.size();
+        for (int i = 0; i < size; i++) {
+            Map.Entry<String, String> e1 = entryList.get(i);
+            for (int j = i + 1; j < size; j++) {
+                Map.Entry<String, String> e2 = entryList.get(j);
+                if (areShared(e1.getValue(), e2.getValue())) {
+                    shared.add(e1.getKey());
+                    shared.add(e2.getKey());
+                }
+            }
+        }
+        return shared;
+    }
+
+    private boolean areShared(String fileName1, String fileName2) {
+        if (Objects.equals(fileName1, fileName2)) {
+            return true;
+        }
+        Path path1 = resolvePathSafely(storeFolder, fileName1);
+        Path path2 = resolvePathSafely(storeFolder, fileName2);
+        if (path1 != null && path2 != null) {
+            try {
+                if (Files.isRegularFile(path1) && Files.isRegularFile(path2)) {
+                    return Files.isSameFile(path1, path2);
+                }
+            } catch (IOException ignored) {
+            }
+        }
+        return false;
+    }
+
+    private boolean isSharedWithAnotherEntry(String ruleDescription, String fileName) {
+        for (Map.Entry<String, String> otherEntry : storedRules.getAllProperties().entrySet()) {
+            if (!otherEntry.getKey().equals(ruleDescription)) {
+                if (areShared(fileName, otherEntry.getValue())) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+
+    private Path resolvePathSafely(File storeFolder, String fileName) {
+        if (fileName == null || fileName.isEmpty()) {
+            return null;
+        }
+        try {
+            Path p = Paths.get(fileName);
+            if (p.isAbsolute()) {
+                return p;
+            }
+            return storeFolder.toPath().resolve(p);
+        } catch (InvalidPathException e) {
+            return null;
+        }
+    }
+
+    private void deleteFileAndSymlinkTarget(Path path) throws IOException {
+        if (Files.isSymbolicLink(path)) {
+            Path target = path.toRealPath();
+            if (!target.equals(path)) {
+                Files.delete(target);
+            }
+            Files.delete(path);
+        } else {
+            Files.delete(path);
+        }
+    }
