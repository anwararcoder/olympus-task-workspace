+    private static void repairStore(File storeFolder, FileSyncedProperties storedRules) {
+        Map<String, String> rules = storedRules.getAllRules();
+        Set<String> sharedRuleNames = findSharedRuleNames(rules, storeFolder);
+
+        Set<String> entriesToDiscard = new HashSet<>();
+        for (Map.Entry<String, String> entry : rules.entrySet()) {
+            String ruleDescription = entry.getKey();
+            if (sharedRuleNames.contains(ruleDescription)) {
+                continue;
+            }
+            String fileName = entry.getValue();
+            if (isBroken(storeFolder, fileName)) {
+                entriesToDiscard.add(ruleDescription);
+            } else if (isResolved(storeFolder, fileName)) {
+                entriesToDiscard.add(ruleDescription);
+                Path filePath = resolvePath(storeFolder, fileName);
+                if (filePath != null) {
+                    try {
+                        deleteFileAndSymlinkTarget(filePath);
+                    } catch (IOException e) {
+                        throw new StoreInitializationFailedException(e);
+                    }
+                }
+            }
+        }
+
+        if (!entriesToDiscard.isEmpty()) {
+            storedRules.removeAll(entriesToDiscard);
+        }
+    }
+
+    private static Set<String> findSharedRuleNames(Map<String, String> rules, File storeFolder) {
+        Set<String> shared = new HashSet<>();
+        List<Map.Entry<String, String>> entryList = new ArrayList<>(rules.entrySet());
+        for (int i = 0; i < entryList.size(); i++) {
+            Map.Entry<String, String> e1 = entryList.get(i);
+            for (int j = i + 1; j < entryList.size(); j++) {
+                Map.Entry<String, String> e2 = entryList.get(j);
+                if (areEntriesShared(e1.getValue(), e2.getValue(), storeFolder)) {
+                    shared.add(e1.getKey());
+                    shared.add(e2.getKey());
+                }
+            }
+        }
+        return shared;
+    }
+
+    private static boolean areEntriesShared(String val1, String val2, File storeFolder) {
+        if (val1.equals(val2)) {
+            return true;
+        }
+        Path path1 = resolvePath(storeFolder, val1);
+        Path path2 = resolvePath(storeFolder, val2);
+        if (path1 == null || path2 == null) {
+            return false;
+        }
+        if (path1.toAbsolutePath().normalize().equals(path2.toAbsolutePath().normalize())) {
+            return true;
+        }
+        try {
+            if (Files.exists(path1) && Files.exists(path2) && Files.isSameFile(path1, path2)) {
+                return true;
+            }
+        } catch (IOException ignored) {
+        }
+        if (Files.isSymbolicLink(path1) || Files.isSymbolicLink(path2)) {
+            Path target1 = resolveLinkTarget(path1);
+            Path target2 = resolveLinkTarget(path2);
+            if (target1 != null && target2 != null) {
+                if (target1.equals(target2)) {
+                    return true;
+                }
+                try {
+                    if (Files.exists(target1) && Files.exists(target2) && Files.isSameFile(target1, target2)) {
+                        return true;
+                    }
+                } catch (IOException ignored) {
+                }
+            }
+        }
+        return false;
+    }
+
+    private static Path resolveLinkTarget(Path path) {
+        Path current = path;
+        int depth = 0;
+        while (Files.isSymbolicLink(current) && depth < 20) {
+            try {
+                Path target = Files.readSymbolicLink(current);
+                if (current.getParent() != null) {
+                    current = current.getParent().resolve(target).normalize();
+                } else {
+                    current = target.normalize();
+                }
+                depth++;
+            } catch (IOException e) {
+                return null;
+            }
+        }
+        return current.toAbsolutePath().normalize();
+    }
+
+    private static Path resolvePath(File storeFolder, String fileName) {
+        try {
+            Path storePath = storeFolder.toPath().toAbsolutePath().normalize();
+            Path raw = Paths.get(fileName);
+            if (raw.isAbsolute()) {
+                return raw.normalize();
+            }
+            return storePath.resolve(raw).normalize();
+        } catch (Exception e) {
+            return null;
+        }
+    }
+
+    private static boolean isBroken(File storeFolder, String fileName) {
+        Path storeDir = storeFolder.toPath().toAbsolutePath().normalize();
+        Path path;
+        try {
+            Path raw = Paths.get(fileName);
+            if (raw.isAbsolute()) {
+                path = raw.normalize();
+            } else {
+                path = storeDir.resolve(raw).normalize();
+            }
+        } catch (Exception e) {
+            return true;
+        }
+
+        Path parent = path.getParent();
+        if (parent == null || !parent.equals(storeDir)) {
+            return true;
+        }
+
+        if (!Files.isRegularFile(path)) {
+            return true;
+        }
+
+        return false;
+    }
+
+    private static boolean isResolved(File storeFolder, String fileName) {
+        if (isBroken(storeFolder, fileName)) {
+            return false;
+        }
+        Path path = storeFolder.toPath().toAbsolutePath().normalize().resolve(fileName).normalize();
+        try {
+            byte[] bytes = Files.readAllBytes(path);
+            String text = new String(bytes, UTF_8);
+            String unixText = ensureUnixLineBreaks(text);
+            if (unixText.chars().allMatch(c -> c == '\n' || c == '\r')) {
+                return true;
+            }
+            List<String> violations = Splitter.on(UNESCAPED_LINE_BREAK_PATTERN).omitEmptyStrings().splitToStream(unixText)
+                    .collect(toList());
+            return violations.isEmpty();
+        } catch (IOException e) {
+            return false;
+        }
+    }
+
+    private static void deleteFileAndSymlinkTarget(Path filePath) throws IOException {
+        if (Files.isSymbolicLink(filePath)) {
+            Path target = null;
+            try {
+                target = filePath.toRealPath();
+            } catch (IOException ignored) {
+            }
+            if (target != null && !target.equals(filePath)) {
+                Files.delete(target);
+            }
+            Files.delete(filePath);
+        } else {
+            Files.delete(filePath);
+        }
+    }
