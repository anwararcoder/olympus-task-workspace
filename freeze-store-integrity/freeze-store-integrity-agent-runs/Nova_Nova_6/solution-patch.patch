+    private class IntegrityReport {
+        private final List<EntryAnalysis> entries;
+        private final List<String> unownedFiles;
+        private final Map<String, String> originalNames = new HashMap<>();
+
+        private IntegrityReport(List<EntryAnalysis> entries, List<String> unownedFiles) {
+            this.entries = entries;
+            this.unownedFiles = unownedFiles;
+            for (EntryAnalysis entry : entries) {
+                originalNames.put(entry.description, entry.fileName);
+            }
+        }
+
+        private boolean hasProblems() {
+            for (EntryAnalysis entry : entries) {
+                if (entry.hasProblem()) {
+                    return true;
+                }
+            }
+            return !unownedFiles.isEmpty();
+        }
+
+        private boolean entriesChanged(Properties properties) {
+            if (properties.size() != originalNames.size()) {
+                return true;
+            }
+            for (Map.Entry<String, String> original : originalNames.entrySet()) {
+                if (!original.getValue().equals(properties.getProperty(original.getKey()))) {
+                    return true;
+                }
+            }
+            return false;
+        }
+
+        private String failureMessage(boolean allowUpdate) {
+            StringBuilder result = new StringBuilder("Violation store integrity check failed (default.allowStoreUpdate=")
+                    .append(allowUpdate).append("):");
+            appendEntries(result, "broken", filter(entry -> entry.broken));
+            appendEntries(result, "resolved", filter(entry -> entry.resolved));
+            appendEntries(result, "shared", filter(entry -> entry.shared));
+            appendEntries(result, "misplaced", filter(entry -> entry.misplaced));
+            appendEntries(result, "colliding", filter(entry -> entry.colliding));
+            appendEntries(result, "occupied", filter(entry -> entry.occupied));
+            for (String file : unownedFiles) {
+                result.append("\nunowned file '").append(file).append("'");
+            }
+            return result.toString();
+        }
+
+        private List<EntryAnalysis> filter(EntryPredicate predicate) {
+            List<EntryAnalysis> result = new ArrayList<>();
+            for (EntryAnalysis entry : entries) {
+                if (predicate.test(entry)) {
+                    result.add(entry);
+                }
+            }
+            Collections.sort(result, Comparator.comparing(entry -> entry.description));
+            return result;
+        }
+
+        private void appendEntries(StringBuilder result, String condition, List<EntryAnalysis> entries) {
+            for (EntryAnalysis entry : entries) {
+                result.append("\n").append(condition).append(" entry '").append(entry.description)
+                        .append("' -> '").append(entry.fileName).append("'");
+            }
+        }
+    }
