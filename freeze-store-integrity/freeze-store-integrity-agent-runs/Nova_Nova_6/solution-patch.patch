+        private void markGroupsShared(Map<String, List<Entry>> groups) {
+            for (List<Entry> group : groups.values()) {
+                if (group.size() > 1) {
+                    for (Entry entry : group) {
+                        entry.shared = true;
+                    }
+                }
+            }
+        }
+
+        private void markCollisionsAndOccupancy(List<Entry> entries) {
+            Map<String, List<Entry>> byDerivedName = new HashMap<>();
+            for (Entry entry : entries) {
+                byDerivedName.computeIfAbsent(entry.derivedName, ignored -> new ArrayList<>()).add(entry);
+            }
+            for (List<Entry> group : byDerivedName.values()) {
+                if (group.size() > 1) {
+                    for (Entry entry : group) {
+                        entry.colliding = true;
+                    }
+                }
+            }
+
+            Set<String> recordedNames = new HashSet<>();
+            for (Entry entry : entries) {
+                recordedNames.add(entry.recordedName);
+            }
+            for (Entry entry : entries) {
+                if (!entry.misplaced) {
+                    continue;
+                }
+                Path derivedPath = folderPath.resolve(entry.derivedName).normalize();
+                boolean escapesOrIsNotDirect = !isDirectChild(derivedPath, entry.derivedName);
+                boolean recordedByAnother = recordedNames.contains(entry.derivedName) && !entry.recordedName.equals(entry.derivedName);
+                boolean alreadyExists = !escapesOrIsNotDirect && Files.exists(derivedPath, LinkOption.NOFOLLOW_LINKS);
+                entry.occupied = escapesOrIsNotDirect || recordedByAnother || alreadyExists;
+            }
+        }
+
+        private List<String> findUnownedFiles(List<Entry> entries) {
+            Set<String> ownedNames = new HashSet<>();
+            Set<String> ownedResolvedPaths = new HashSet<>();
+            for (Entry entry : entries) {
+                ownedNames.add(entry.recordedName);
+                if (entry.resolvedPath != null && !entry.broken) {
+                    ownedResolvedPaths.add(entry.resolvedPath.toString());
+                }
+            }
+            List<String> result = new ArrayList<>();
+            try (DirectoryStream<Path> files = Files.newDirectoryStream(folderPath)) {
+                for (Path file : files) {
+                    String name = file.getFileName().toString();
+                    if (STORED_RULES_FILE_NAME.equals(name)) {
+                        continue;
+                    }
+                    if (Files.isRegularFile(file, LinkOption.NOFOLLOW_LINKS)
+                            && !ownedNames.contains(name)
+                            && !ownedResolvedPaths.contains(file.toRealPath().toString())) {
+                        result.add(name);
+                    }
+                }
+            } catch (IOException e) {
+                throw new StoreInitializationFailedException(e);
+            }
+            Collections.sort(result);
+            return result;
+        }
+
+        private boolean isDirectChild(Path path, String originalName) {
+            return folderPath.equals(path.getParent())
+                    && path.getFileName() != null
+                    && path.getFileName().toString().equals(originalName);
+        }
+
+        private void repair(IntegrityReport report, boolean indexExists) {
+            Properties original = copyOf(loadedProperties);
+            Properties updated = copyOf(loadedProperties);
+            List<FileUndo> changes = new ArrayList<>();
+            boolean entryChanged = false;
+            boolean indexWritten = false;
+            try {
+                List<Entry> sortedEntries = new ArrayList<>(report.entries);
+                sortedEntries.sort(Comparator.comparing(entry -> entry.description));
+                for (Entry entry : sortedEntries) {
+                    if (entry.shared) {
+                        continue;
+                    }
+                    if (entry.broken) {
+                        updated.remove(entry.description);
+                        entryChanged = true;
+                    } else if (entry.resolved) {
+                        changes.add(deleteResolvedFile(entry));
+                        updated.remove(entry.description);
+                        entryChanged = true;
+                    } else if (entry.misplaced && !entry.colliding && !entry.occupied) {
+                        changes.add(moveMisplacedFile(entry));
+                        updated.setProperty(entry.description, entry.derivedName);
+                        entryChanged = true;
+                    }
+                }
+
+                if (entryChanged) {
+                    indexWritten = true;
+                    writeProperties(updated, true);
+                } else if (!indexExists) {
+                    indexWritten = true;
+                    writeProperties(updated, true);
+                }
+                for (FileUndo change : changes) {
+                    try {
+                        change.commit();
+                    } catch (IOException e) {
+                        throw new StoreInitializationFailedException("Could not finish violation store repair", e);
+                    }
+                }
+                loadedProperties = updated;
+            } catch (RuntimeException e) {
+                rollback(changes);
+                if (indexWritten) {
+                    try {
+                        writeProperties(original, true);
+                    } catch (RuntimeException rollbackFailure) {
+                        e.addSuppressed(rollbackFailure);
+                    }
+                }
+                throw e;
+            }
+        }
+
+        private FileUndo deleteResolvedFile(Entry entry) {
+            try {
+                Path backup = Files.createTempFile(folderPath, ".archunit-delete-", ".tmp");
+                Files.delete(backup);
+                Path linkTarget = Files.isSymbolicLink(entry.namedPath) ? Files.readSymbolicLink(entry.namedPath) : null;
+                Files.move(entry.resolvedPath, backup);
+                boolean linkDeleted = false;
+                try {
+                    if (linkTarget != null) {
+                        Files.delete(entry.namedPath);
+                        linkDeleted = true;
+                    }
+                } catch (IOException e) {
+                    Files.move(backup, entry.resolvedPath);
+                    throw e;
+                }
+                final boolean wasLink = linkTarget != null;
+                final boolean wasLinkDeleted = linkDeleted;
+                return new FileUndo() {
+                    @Override
+                    void undo() throws IOException {
+                        if (wasLinkDeleted && !Files.exists(entry.namedPath, LinkOption.NOFOLLOW_LINKS)) {
+                            Files.createSymbolicLink(entry.namedPath, linkTarget);
+                        }
+                        if (!Files.exists(entry.resolvedPath, LinkOption.NOFOLLOW_LINKS)) {
+                            Files.move(backup, entry.resolvedPath);
+                        }
+                    }
+
+                    @Override
+                    void commit() throws IOException {
+                        Files.deleteIfExists(backup);
+                    }
+                };
+            } catch (IOException e) {
+                throw new StoreInitializationFailedException("Could not discard resolved entry '" + entry.description + "'", e);
+            }
+        }
+
+        private FileUndo moveMisplacedFile(Entry entry) {
+            Path destination = folderPath.resolve(entry.derivedName).normalize();
+            try {
+                Path linkTarget = Files.isSymbolicLink(entry.namedPath) ? Files.readSymbolicLink(entry.namedPath) : null;
+                Files.move(entry.resolvedPath, destination);
+                boolean linkDeleted = false;
+                try {
+                    if (linkTarget != null) {
+                        Files.delete(entry.namedPath);
+                        linkDeleted = true;
+                    }
+                } catch (IOException e) {
+                    Files.move(destination, entry.resolvedPath);
+                    throw e;
+                }
+                final boolean wasLinkDeleted = linkDeleted;
+                return new FileUndo() {
+                    @Override
+                    void undo() throws IOException {
+                        if (!Files.exists(entry.resolvedPath, LinkOption.NOFOLLOW_LINKS)) {
+                            Files.move(destination, entry.resolvedPath);
+                        }
+                        if (wasLinkDeleted && !Files.exists(entry.namedPath, LinkOption.NOFOLLOW_LINKS)) {
+                            Files.createSymbolicLink(entry.namedPath, linkTarget);
+                        }
+                    }
+
+                    @Override
+                    void commit() {
+                        // The source was moved to the derived name permanently.
+                    }
+                };
+            } catch (IOException e) {
+                throw new StoreInitializationFailedException(String.format(
+                        "Could not move file for rule '%s' to '%s'", entry.description, entry.derivedName), e);
+            }
+        }
+
+        private void rollback(List<FileUndo> changes) {
+            List<FileUndo> reverse = new ArrayList<>(changes);
+            Collections.reverse(reverse);
+            for (FileUndo change : reverse) {
+                try {
+                    change.undo();
+                } catch (IOException rollbackFailure) {
+                    log.warn("Could not roll back a violation store repair", rollbackFailure);
+                }
+            }
+        }
+
+        synchronized void save(String description, List<String> violations, FileNameConfiguration names) {
+            String existingName = loadedProperties.getProperty(description);
+            if (violations.isEmpty()) {
+                if (existingName == null) {
+                    return;
+                }
+                removeRule(description, existingName);
+                return;
+            }
+
+            String targetName = existingName;
+            boolean newEntry = existingName == null;
+            if (newEntry) {
+                targetName = names.strategy.createRuleFileName(description);
+                if (hasNoName(targetName)) {
+                    throw new StoreUpdateFailedException(String.format(
+                            "RuleViolationFileNameStrategy produced no name for rule '%s'", description));
+                }
+            }
+            Path target = validateWritableTarget(targetName, description, newEntry);
+            Properties updated = copyOf(loadedProperties);
+            if (newEntry) {
+                updated.setProperty(description, ensureUnixLineBreaks(targetName));
+            }
+            writeRuleFile(target, serialize(violations));
+            if (newEntry) {
+                try {
+                    writeProperties(updated, false);
+                } catch (RuntimeException e) {
+                    try {
+                        Files.deleteIfExists(target);
+                    } catch (IOException cleanupFailure) {
+                        e.addSuppressed(cleanupFailure);
+                    }
+                    throw e;
+                }
+                loadedProperties = updated;
+            }
+        }
+
+        private void removeRule(String description, String recordedName) {
+            boolean shared = isSharedByAnotherEntry(description, recordedName);
+            Path file = shared ? null : validateRemovableTarget(recordedName);
+            Properties original = copyOf(loadedProperties);
+            Properties updated = copyOf(loadedProperties);
+            updated.remove(description);
+            FileUndo removal = null;
+            try {
+                if (!shared && file != null) {
+                    removal = stageDelete(folderPath.resolve(recordedName).normalize(), file);
+                }
+                writeProperties(updated, false);
+                if (removal != null) {
+                    try {
+                        removal.commit();
+                    } catch (IOException e) {
+                        throw new StoreUpdateFailedException(e);
+                    }
+                }
+                loadedProperties = updated;
+            } catch (RuntimeException e) {
+                if (removal != null) {
+                    try {
+                        removal.undo();
+                    } catch (IOException rollbackFailure) {
+                        e.addSuppressed(rollbackFailure);
+                    }
+                }
+                try {
+                    writeProperties(original, false);
+                } catch (RuntimeException rollbackFailure) {
+                    e.addSuppressed(rollbackFailure);
+                }
+                throw e;
+            }
+        }
+
+        private boolean isSharedByAnotherEntry(String description, String recordedName) {
+            Path current = folderPath.resolve(recordedName).normalize();
+            String currentResolved = realPathKey(current);
+            for (String otherDescription : loadedProperties.stringPropertyNames()) {
+                if (description.equals(otherDescription)) {
+                    continue;
+                }
+                String otherName = loadedProperties.getProperty(otherDescription);
+                if (recordedName.equals(otherName)) {
+                    return true;
+                }
+                if (currentResolved != null && currentResolved.equals(realPathKey(folderPath.resolve(otherName).normalize()))) {
+                    return true;
+                }
+            }
+            return false;
+        }
+
+        private Path validateRemovableTarget(String name) {
+            Path target = folderPath.resolve(name).normalize();
+            if (!isDirectChild(target, name) || target.equals(indexPath)) {
+                throw new StoreUpdateFailedException("Refusing to remove a violation file outside the store folder or the index");
+            }
+            if (!Files.exists(target, LinkOption.NOFOLLOW_LINKS)) {
+                return null;
+            }
+            try {
+                Path real = target.toRealPath();
+                if (!Files.isRegularFile(real, LinkOption.NOFOLLOW_LINKS) || !folderPath.equals(real.getParent())) {
+                    throw new StoreUpdateFailedException("Cannot remove a violation file that is not a regular file in the store folder");
+                }
+                if (Files.isSymbolicLink(target) && real.equals(indexPath)) {
+                    throw new StoreUpdateFailedException("Refusing to remove the store index through a link");
+                }
+                return real;
+            } catch (IOException e) {
+                throw new StoreUpdateFailedException(e);
+            }
+        }
+
+        private FileUndo stageDelete(Path named, Path real) {
+            Path backup = null;
+            try {
+                backup = Files.createTempFile(folderPath, ".archunit-delete-", ".tmp");
+                Files.delete(backup);
+                Path linkTarget = Files.isSymbolicLink(named) ? Files.readSymbolicLink(named) : null;
+                Files.move(real, backup);
+                boolean linkDeleted = false;
+                if (linkTarget != null) {
+                    try {
+                        Files.delete(named);
+                        linkDeleted = true;
+                    } catch (IOException e) {
+                        Files.move(backup, real);
+                        throw e;
+                    }
+                }
+                final Path backupPath = backup;
+                final boolean wasLinkDeleted = linkDeleted;
+                return new FileUndo() {
+                    @Override
+                    void undo() throws IOException {
+                        if (wasLinkDeleted && !Files.exists(named, LinkOption.NOFOLLOW_LINKS)) {
+                            Files.createSymbolicLink(named, linkTarget);
+                        }
+                        if (!Files.exists(real, LinkOption.NOFOLLOW_LINKS)) {
+                            Files.move(backupPath, real);
+                        }
+                    }
+
+                    @Override
+                    void commit() throws IOException {
+                        Files.deleteIfExists(backupPath);
+                    }
+                };
+            } catch (IOException e) {
+                deleteQuietly(backup);
+                throw new StoreUpdateFailedException(e);
+            }
+        }
+
+        private Path validateWritableTarget(String name, String description, boolean newEntry) {
+            Path target = folderPath.resolve(name).normalize();
+            if (!isDirectChild(target, name) || target.equals(indexPath) || STORED_RULES_FILE_NAME.equals(name)) {
+                throw new StoreUpdateFailedException(String.format(
+                        "Refusing to write violations for rule '%s' outside the store folder or over the store index", description));
+            }
+            if (Files.exists(target, LinkOption.NOFOLLOW_LINKS)) {
+                if (Files.isSymbolicLink(target) || !Files.isRegularFile(target, LinkOption.NOFOLLOW_LINKS)) {
+                    throw new StoreUpdateFailedException(String.format(
+                            "Refusing to write violations for rule '%s' over a non-regular or linked file", description));
+                }
+                if (newEntry) {
+                    throw new StoreUpdateFailedException(String.format(
+                            "Refusing to write violations for rule '%s' over a file its entry does not record", description));
+                }
+            }
+            return target;
+        }
+
+        private boolean hasNoName(String name) {
+            return name == null || name.trim().length() == 0;
+        }
+
+        private void writeRuleFile(Path target, byte[] content) {
+            Path temporary = null;
+            try {
+                temporary = Files.createTempFile(folderPath, ".archunit-write-", ".tmp");
+                Files.write(temporary, content, StandardOpenOption.TRUNCATE_EXISTING, StandardOpenOption.WRITE);
+                atomicReplace(temporary, target);
+                temporary = null;
+            } catch (IOException e) {
+                throw new StoreUpdateFailedException(e);
+            } finally {
+                deleteQuietly(temporary);
+            }
+        }
+
+        private Properties copyOf(Properties source) {
+            Properties result = new Properties();
+            for (String key : source.stringPropertyNames()) {
+                result.setProperty(key, source.getProperty(key));
+            }
+            return result;
+        }
+
+        private void writeProperties(Properties properties, boolean initialization) {
+            Path temporary = null;
+            try {
+                temporary = Files.createTempFile(folderPath, ".archunit-index-", ".tmp");
+                try (java.io.FileOutputStream output = new java.io.FileOutputStream(temporary.toFile())) {
+                    properties.store(output, "");
+                }
+                atomicReplace(temporary, indexPath);
+                temporary = null;
+            } catch (IOException e) {
+                if (initialization) {
+                    throw new StoreInitializationFailedException(e);
+                }
                 throw new StoreUpdateFailedException(e);
+            } finally {
+                deleteQuietly(temporary);
+            }
+        }
+
+        private void atomicReplace(Path source, Path target) throws IOException {
+            try {
+                Files.move(source, target, StandardCopyOption.ATOMIC_MOVE, StandardCopyOption.REPLACE_EXISTING);
+            } catch (AtomicMoveNotSupportedException e) {
+                Files.move(source, target, StandardCopyOption.REPLACE_EXISTING);
+            }
+        }
+
+        private String realPathKey(Path path) {
+            try {
+                return path.toRealPath().toString();
+            } catch (IOException e) {
+                return null;
+            }
+        }
+
+        private void deleteQuietly(Path path) {
+            if (path != null) {
+                try {
+                    Files.deleteIfExists(path);
+                } catch (IOException ignored) {
+                    // The original operation already failed; retain its exception.
+                }
             }
         }
     }
 
