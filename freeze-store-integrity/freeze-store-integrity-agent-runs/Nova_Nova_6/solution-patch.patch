+
+    @Test
+    public void description_names_are_safe_distinct_and_retain_a_late_word() throws IOException {
+        File folder = temporaryFolder.resolve("store").toFile();
+        TextFileBasedViolationStore store = new TextFileBasedViolationStore();
+        store.initialize(propertiesOf(
+                "default.path", folder.getAbsolutePath(),
+                "default.allowStoreCreation", "true",
+                "default.fileNames", "description"));
+
+        ArchRule first = rule("a very long description with a lateWord");
+        ArchRule second = rule("a very long description with anotherWord");
+        store.save(first, asList("one"));
+        store.save(second, asList("two"));
+
+        Properties index = readProperties(new File(folder, "stored.rules"));
+        String firstName = index.getProperty(first.getDescription());
+        String secondName = index.getProperty(second.getDescription());
+        assertThat(firstName).contains("lateWord").matches("[A-Za-z0-9_-]+").doesNotContain("stored.rules");
+        assertThat(firstName).hasSizeLessThanOrEqualTo(200).isNotEqualTo(secondName);
+        assertThat(secondName).contains("anotherWord");
+    }
+
+    @Test
+    public void repair_discards_broken_and_resolved_entries_and_moves_misplaced_entries() throws IOException {
+        File folder = temporaryFolder.resolve("store").toFile();
+        assertThat(folder.mkdirs()).isTrue();
+        Properties index = new Properties();
+        index.setProperty("broken rule", "missing");
+        index.setProperty("resolved rule", "resolved");
+        index.setProperty("misplaced rule", "old");
+        storeIndex(folder, index);
+        Files.write(new File(folder, "resolved").toPath(), "\r\n\r".getBytes(UTF_8));
+        Files.write(new File(folder, "old").toPath(), "still violated\n".getBytes(UTF_8));
+
+        TextFileBasedViolationStore store = new TextFileBasedViolationStore(
+                description -> description.replace(' ', '_') + ".new");
+        store.initialize(propertiesOf(
+                "default.path", folder.getAbsolutePath(),
+                "default.allowStoreCreation", "true",
+                "default.allowStoreUpdate", "true",
+                "default.integrity", "repair"));
+
+        Properties repaired = readProperties(new File(folder, "stored.rules"));
+        assertThat(repaired).doesNotContainKey("broken rule").doesNotContainKey("resolved rule");
+        assertThat(repaired.getProperty("misplaced rule")).isEqualTo("misplaced_rule.new");
+        assertThat(new File(folder, "resolved")).doesNotExist();
+        assertThat(new File(folder, "old")).doesNotExist();
+        assertThat(new File(folder, "misplaced_rule.new")).hasContent("still violated\n");
+    }
+
