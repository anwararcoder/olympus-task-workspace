+                "default.path", temporaryFolder.toString(),
+                "default.allowStoreCreation", "true"));
+
+        assertThatThrownBy(() -> store.save(rule("new"), ImmutableList.of("violation")))
+                .isInstanceOf(StoreUpdateFailedException.class);
+        assertThat(readIndex(temporaryFolder)).isEmpty();
+        assertThat(temporaryFolder.toFile().list()).containsExactly("stored.rules");
+    }
+
+    private Properties readIndex(Path folder) throws IOException {
+        Properties properties = new Properties();
+        try (java.io.InputStream input = Files.newInputStream(folder.resolve("stored.rules"))) {
+            properties.load(input);
+        }
+        return properties;
+    }
+
+    private Properties readIndexUnchecked(Path folder) {
+        try {
+            return readIndex(folder);
+        } catch (IOException e) {
+            throw new AssertionError(e);
+        }
+    }
+
+    private Properties properties(String... pairs) {
+        Properties result = new Properties();
+        LinkedList<String> values = new LinkedList<>(asList(pairs));
+        while (!values.isEmpty()) {
+            result.setProperty(values.poll(), values.poll());
+        }
+        return result;
+    }
+
+    private ArchRule rule(String description) {
+        return classes().should().bePublic().as(description);
+    }
