+
+        configuredFolder.setWritable(false, false);
+        try {
+            assertThatThrownBy(() -> repairStore.save(rule("rule 1"), ImmutableList.of()))
+                    .isInstanceOf(StoreUpdateFailedException.class);
+
+            assertThat(repairStore.contains(rule("rule 1"))).isTrue();
+            Properties loaded = readProperties(new File(configuredFolder, "stored.rules"));
+            assertThat(loaded).containsEntry("rule 1", "undeletable.txt");
+        } finally {
+            configuredFolder.setWritable(true, false);
+        }
+    }
