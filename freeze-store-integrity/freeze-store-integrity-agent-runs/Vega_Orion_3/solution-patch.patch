+
+    private Set<PosixFilePermission> makeReadOnly(File folder) throws IOException {
+        assumeTrue(Files.getFileAttributeView(folder.toPath(), PosixFileAttributeView.class) != null, "POSIX permissions are supported");
+        Set<PosixFilePermission> originalPermissions = Files.getPosixFilePermissions(folder.toPath());
+        Files.setPosixFilePermissions(folder.toPath(), EnumSet.of(OWNER_READ, OWNER_EXECUTE));
+        assumeTrue(!Files.isWritable(folder.toPath()), "permissions are enforced for the current user");
+        return originalPermissions;
+    }
+
+    private static void createSymbolicLink(File link, File target) throws IOException {
+        try {
+            Files.createSymbolicLink(link.toPath(), target.toPath());
+        } catch (UnsupportedOperationException | FileSystemException e) {
+            assumeTrue(false, "symbolic links are supported: " + e);
+        }
+    }
+
+    private ViolationStore initializedRepairingStore() {
+        return initializedStore("default.integrity", "repair");
+    }
+
+    private ViolationStore initializedStore(String... keyValuePairs) {
+        ViolationStore store = new TextFileBasedViolationStore();
+        store.initialize(storeProperties(keyValuePairs));
+        return store;
+    }
+
+    private Properties storeProperties(String... keyValuePairs) {
+        Properties result = new Properties();
+        result.setProperty("default.path", storeFolder.getAbsolutePath());
+        result.setProperty("default.allowStoreCreation", String.valueOf(true));
+        for (int i = 0; i < keyValuePairs.length; i += 2) {
+            result.setProperty(keyValuePairs[i], keyValuePairs[i + 1]);
+        }
+        return result;
+    }
+
+    private static Map<String, String> entries(String... ruleFilePairs) {
+        Map<String, String> result = new LinkedHashMap<>();
+        for (int i = 0; i < ruleFilePairs.length; i += 2) {
+            result.put(ruleFilePairs[i], ruleFilePairs[i + 1]);
+        }
+        return result;
+    }
+
+    private void writeIndex(Map<String, String> entries) throws IOException {
+        Properties properties = new Properties();
+        properties.putAll(entries);
+        try (FileOutputStream outputStream = new FileOutputStream(new File(storeFolder, "stored.rules"))) {
+            properties.store(outputStream, "");
+        }
+    }
+
+    private Map<String, String> readIndex() throws IOException {
+        Properties properties = new Properties();
+        try (FileInputStream inputStream = new FileInputStream(new File(storeFolder, "stored.rules"))) {
+            properties.load(inputStream);
+        }
+        Map<String, String> result = new LinkedHashMap<>();
+        properties.stringPropertyNames().forEach(key -> result.put(key, properties.getProperty(key)));
+        return result;
+    }
+
+    private static File writeFile(File folder, String name, String content) throws IOException {
+        File file = new File(folder, name);
+        Files.write(file.toPath(), content.getBytes(UTF_8));
+        return file;
+    }
+
+    private static ArchRule rule(String description) {
+        return classes().should().bePublic().as(description);
+    }
+}
diff --git a/docs/userguide/008_The_Library_API.adoc b/docs/userguide/008_The_Library_API.adoc
index 10ed830..41354af 100644
--- a/docs/userguide/008_The_Library_API.adoc
+++ b/docs/userguide/008_The_Library_API.adoc
@@ -495,6 +495,29 @@ For example to allow the creation of the violation store in a specific environme
 -Darchunit.freeze.store.default.allowStoreCreation=true
 ----
 
+Over time, the index file `stored.rules` and the individual violation files can get out of sync,
+e.g. if violation files are deleted manually or if all violations of a rule have been fixed.
+The violation store can maintain its integrity by itself:
+
+[source,options="nowrap"]
+.archunit.properties
+----
+# can be set to repair to maintain the integrity of the index and the violation files
+# default is ignore, which checks nothing
+freeze.store.default.integrity=repair
+----
+
+With `repair` the index and the violation files are checked as they are on disk every time the store is initialized.
+Index entries that do not point to a regular file directly within the store folder are broken and will be discarded
+without touching whatever they point to. Index entries whose file contains no violations (i.e. at most line breaks)
+are resolved and will be discarded together with their file (and, if the file is a symbolic link, together with the file it points to).
+Index entries that point to the same file name as another entry, or to the same regular file (also through symbolic or hard links),
+are shared and will never be touched by the repair. Neither will any file that no index entry points to.
+Furthermore, once there are no violations left for a frozen rule, the store will forget the rule,
+i.e. remove its index entry together with its file (unless another entry shares that file, in which case only the entry is removed).
+Rules without any violations will not be stored at all.
+Note that the repair respects `allowStoreUpdate`, i.e. if updates are forbidden, the store will not be modified.
+
 It is also possible to allow all violations to be "refrozen", i.e. the store will just be updated
 with the current state, and the reported result will be success. Thus, it is effectively the same behavior
 as if all rules would never have been frozen.
