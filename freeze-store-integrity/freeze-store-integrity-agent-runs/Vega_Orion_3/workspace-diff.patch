+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.Properties;
+import java.util.Set;
+
+import com.google.common.collect.ImmutableList;
+import com.tngtech.archunit.lang.ArchRule;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+import static com.tngtech.archunit.lang.syntax.ArchRuleDefinition.classes;
+import static java.nio.charset.StandardCharsets.UTF_8;
+import static java.nio.file.LinkOption.NOFOLLOW_LINKS;
+import static java.nio.file.attribute.PosixFilePermission.OWNER_EXECUTE;
+import static java.nio.file.attribute.PosixFilePermission.OWNER_READ;
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+import static org.junit.jupiter.api.Assumptions.assumeTrue;
+
+public class TextFileBasedViolationStoreIntegrityTest {
+
+    @TempDir
+    Path temporaryFolder;
+
+    private File storeFolder;
+    private File outsideFolder;
+
+    @BeforeEach
+    public void setUp() {
+        storeFolder = new File(temporaryFolder.toFile(), "store");
+        outsideFolder = temporaryFolder.toFile();
+        assertThat(storeFolder.mkdirs()).isTrue();
+    }
+
+    @Test
+    public void ignores_integrity_by_default() throws IOException {
+        writeFile(storeFolder, "resolved", "");
+        writeIndex(entries("resolved rule", "resolved", "broken rule", "missing"));
+
+        ViolationStore store = initializedStore();
+        store.save(rule("known rule"), ImmutableList.of());
+
+        assertThat(readIndex()).containsOnlyKeys("resolved rule", "broken rule", "known rule");
+        assertThat(new File(storeFolder, "resolved")).exists();
+        assertThat(store.getViolations(rule("known rule"))).isEmpty();
+    }
+
+    @Test
+    public void rejects_unsupported_integrity() {
+        ViolationStore store = new TextFileBasedViolationStore();
+
+        assertThatThrownBy(() -> store.initialize(storeProperties("default.integrity", "fix")))
+                .isInstanceOf(StoreInitializationFailedException.class)
+                .hasMessageContaining("'fix'")
+                .hasMessageContaining("freeze.store.default.integrity")
+                .hasMessageContaining("ignore, repair");
+    }
+
+    @Test
+    public void accepts_integrity_case_insensitively() throws IOException {
+        writeIndex(entries("broken rule", "missing"));
+
+        initializedStore("default.integrity", "Repair");
+
+        assertThat(readIndex()).isEmpty();
+    }
+
+    @Test
+    public void repair_checks_index_and_folder_on_disk_even_if_folder_was_initialized_before() throws IOException {
+        ViolationStore store = initializedStore();
+        store.save(rule("known rule"), ImmutableList.of("known violation"));
+
+        Map<String, String> index = readIndex();
+        index.put("added rule", "added");
+        index.put("broken rule", "missing");
+        writeIndex(index);
+        writeFile(storeFolder, "added", "added violation\n");
+        writeFile(storeFolder, index.get("known rule"), "");
+
+        ViolationStore repairingStore = initializedRepairingStore();
+
+        assertThat(repairingStore.contains(rule("added rule"))).isTrue();
+        assertThat(repairingStore.getViolations(rule("added rule"))).containsExactly("added violation");
+        assertThat(repairingStore.contains(rule("known rule"))).isFalse();
+        assertThat(repairingStore.contains(rule("broken rule"))).isFalse();
+        assertThat(readIndex()).containsOnlyKeys("added rule");
+        assertThat(new File(storeFolder, index.get("known rule"))).doesNotExist();
+    }
+
+    @Test
+    public void repair_discards_broken_entries_without_touching_what_they_point_to() throws IOException {
+        File directory = new File(storeFolder, "directory");
+        assertThat(directory.mkdir()).isTrue();
+        File subFolder = new File(storeFolder, "sub");
+        assertThat(subFolder.mkdir()).isTrue();
+        File nestedFile = writeFile(subFolder, "nested", "nested violation\n");
+        File outsideFile = writeFile(outsideFolder, "outside", "");
+        File danglingLink = new File(storeFolder, "dangling");
+        createSymbolicLink(danglingLink, new File(storeFolder, "missing"));
+        writeIndex(entries(
+                "missing rule", "missing",
+                "directory rule", "directory",
+                "folder rule", "",
+                "nested rule", "sub/nested",
+                "outside rule", "../outside",
+                "invalid rule", "in\0valid",
+                "dangling rule", "dangling",
+                "valid rule", "valid"));
+        writeFile(storeFolder, "valid", "valid violation\n");
+
+        ViolationStore store = initializedRepairingStore();
+
+        assertThat(readIndex()).containsOnlyKeys("valid rule");
+        assertThat(store.getViolations(rule("valid rule"))).containsExactly("valid violation");
+        assertThat(directory).isDirectory();
+        assertThat(nestedFile).hasContent("nested violation");
+        assertThat(outsideFile).exists();
+        assertThat(Files.isSymbolicLink(danglingLink.toPath())).isTrue();
+    }
+
+    @Test
+    public void repair_discards_resolved_entries_and_their_files() throws IOException {
+        File emptyFile = writeFile(storeFolder, "empty", "");
+        File lineBreaksFile = writeFile(storeFolder, "line-breaks", "\n\r\n\n");
+        File violationsFile = writeFile(storeFolder, "violations", "\nviolation\n");
+        writeIndex(entries(
+                "empty rule", "empty",
+                "line breaks rule", "line-breaks",
+                "violations rule", "violations"));
+
+        ViolationStore store = initializedRepairingStore();
+
+        assertThat(readIndex()).containsOnlyKeys("violations rule");
+        assertThat(store.getViolations(rule("violations rule"))).containsExactly("violation");
+        assertThat(emptyFile).doesNotExist();
+        assertThat(lineBreaksFile).doesNotExist();
+        assertThat(violationsFile).exists();
+    }
+
+    @Test
+    public void repair_discards_resolved_symbolic_link_and_the_file_it_points_to() throws IOException {
+        File target = writeFile(outsideFolder, "target", "\n");
+        File link = new File(storeFolder, "link");
+        createSymbolicLink(link, target);
+        writeIndex(entries("linked rule", "link"));
+
+        initializedRepairingStore();
+
+        assertThat(readIndex()).isEmpty();
+        assertThat(Files.exists(link.toPath(), NOFOLLOW_LINKS)).isFalse();
+        assertThat(target).doesNotExist();
+    }
+
+    @Test
+    public void repair_does_not_touch_entries_sharing_the_same_file_name() throws IOException {
+        File emptyFile = writeFile(storeFolder, "empty", "");
+        writeIndex(entries(
+                "first missing rule", "missing",
+                "second missing rule", "missing",
+                "first empty rule", "empty",
+                "second empty rule", "empty",
+                "first outside rule", "../missing",
+                "second outside rule", "../missing"));
+
+        initializedRepairingStore();
+
+        assertThat(readIndex()).containsOnlyKeys(
+                "first missing rule", "second missing rule",
+                "first empty rule", "second empty rule",
+                "first outside rule", "second outside rule");
+        assertThat(emptyFile).exists();
+    }
+
+    @Test
+    public void repair_does_not_touch_entries_sharing_the_same_file_through_links() throws IOException {
+        File symbolicTarget = writeFile(storeFolder, "symbolic-target", "");
+        createSymbolicLink(new File(storeFolder, "symbolic-link"), symbolicTarget);
+        File hardTarget = writeFile(storeFolder, "hard-target", "");
+        Files.createLink(new File(storeFolder, "hard-link").toPath(), hardTarget.toPath());
+        File outsideTarget = writeFile(outsideFolder, "outside-target", "");
+        createSymbolicLink(new File(storeFolder, "outside-link"), outsideTarget);
+        writeIndex(entries(
+                "symbolic target rule", "symbolic-target",
+                "symbolic link rule", "symbolic-link",
+                "hard target rule", "hard-target",
+                "hard link rule", "hard-link",
+                "outside target rule", "../outside-target",
+                "outside link rule", "outside-link"));
+
+        initializedRepairingStore();
+
+        assertThat(readIndex()).containsOnlyKeys(
+                "symbolic target rule", "symbolic link rule",
+                "hard target rule", "hard link rule",
+                "outside target rule", "outside link rule");
+        assertThat(symbolicTarget).exists();
+        assertThat(new File(storeFolder, "symbolic-link")).exists();
+        assertThat(hardTarget).exists();
+        assertThat(new File(storeFolder, "hard-link")).exists();
+        assertThat(outsideTarget).exists();
+        assertThat(new File(storeFolder, "outside-link")).exists();
+    }
+
+    @Test
+    public void repair_does_not_touch_files_no_entry_points_to() throws IOException {
+        File unreferencedFile = writeFile(storeFolder, "unreferenced", "");
+        writeIndex(entries());
+
+        initializedRepairingStore();
+
+        assertThat(unreferencedFile).exists();
+    }
+
+    @Test
+    public void repair_does_not_modify_store_if_updates_are_disallowed() throws IOException {
+        File emptyFile = writeFile(storeFolder, "empty", "");
+        writeIndex(entries("empty rule", "empty", "broken rule", "missing"));
+
+        ViolationStore store = initializedStore("default.integrity", "repair", "default.allowStoreUpdate", "false");
+
+        assertThat(store.contains(rule("empty rule"))).isTrue();
+        assertThat(store.contains(rule("broken rule"))).isTrue();
+        assertThat(readIndex()).containsOnlyKeys("empty rule", "broken rule");
+        assertThat(emptyFile).exists();
+    }
+
+    @Test
+    public void repair_forgets_known_rule_saved_without_violations() throws IOException {
+        ViolationStore store = initializedRepairingStore();
+        store.save(rule("known rule"), ImmutableList.of("violation"));
+        File ruleFile = new File(storeFolder, readIndex().get("known rule"));
+
+        store.save(rule("known rule"), ImmutableList.of());
+
+        assertThat(store.contains(rule("known rule"))).isFalse();
+        assertThat(readIndex()).isEmpty();
+        assertThat(ruleFile).doesNotExist();
+    }
+
+    @Test
+    public void repair_does_not_save_unknown_rule_without_violations() throws IOException {
+        ViolationStore store = initializedRepairingStore();
+
+        store.save(rule("unknown rule"), ImmutableList.of());
+
+        assertThat(store.contains(rule("unknown rule"))).isFalse();
+        assertThat(readIndex()).isEmpty();
+        assertThat(storeFolder.list()).containsOnly("stored.rules");
+    }
+
+    @Test
+    public void repair_forgets_rule_sharing_its_file_without_deleting_the_file() throws IOException {
+        File sharedFile = writeFile(storeFolder, "shared", "violation\n");
+        writeIndex(entries("first rule", "shared", "second rule", "shared"));
+        ViolationStore store = initializedRepairingStore();
+
+        store.save(rule("first rule"), ImmutableList.of());
+
+        assertThat(readIndex()).containsOnlyKeys("second rule");
+        assertThat(sharedFile).exists();
+        assertThat(store.getViolations(rule("second rule"))).containsExactly("violation");
+    }
+
+    @Test
+    public void repair_forgets_rule_sharing_file_outside_the_folder_without_deleting_the_file() throws IOException {
+        File outsideFile = writeFile(outsideFolder, "outside", "violation\n");
+        File link = new File(storeFolder, "link");
+        createSymbolicLink(link, outsideFile);
+        writeIndex(entries("outside rule", "../outside", "linked rule", "link"));
+        ViolationStore store = initializedRepairingStore();
+
+        store.save(rule("outside rule"), ImmutableList.of());
+
+        assertThat(readIndex()).containsOnlyKeys("linked rule");
+        assertThat(outsideFile).exists();
+        assertThat(link).exists();
+    }
+
+    @Test
+    public void repair_forgets_symbolic_link_rule_and_deletes_the_file_it_points_to() throws IOException {
+        File target = writeFile(outsideFolder, "target", "violation\n");
+        File link = new File(storeFolder, "link");
+        createSymbolicLink(link, target);
+        writeIndex(entries("linked rule", "link"));
+        ViolationStore store = initializedRepairingStore();
+
+        store.save(rule("linked rule"), ImmutableList.of());
+
+        assertThat(readIndex()).isEmpty();
+        assertThat(Files.exists(link.toPath(), NOFOLLOW_LINKS)).isFalse();
+        assertThat(target).doesNotExist();
+    }
+
+    @Test
+    public void repair_forgets_broken_rule_without_touching_what_it_points_to() throws IOException {
+        File ruleFile = writeFile(storeFolder, "rule", "violation\n");
+        writeIndex(entries("known rule", "rule"));
+        ViolationStore store = initializedRepairingStore();
+        Files.delete(ruleFile.toPath());
+        assertThat(ruleFile.mkdir()).isTrue();
+
+        store.save(rule("known rule"), ImmutableList.of());
+
+        assertThat(store.contains(rule("known rule"))).isFalse();
+        assertThat(readIndex()).isEmpty();
+        assertThat(ruleFile).isDirectory();
+    }
+
+    @Test
+    public void repair_fails_to_forget_rule_whose_file_cannot_be_deleted() throws IOException {
+        File ruleFile = writeFile(storeFolder, "rule", "violation\n");
+        writeIndex(entries("known rule", "rule"));
+        ViolationStore store = initializedRepairingStore();
+
+        Set<PosixFilePermission> originalPermissions = makeReadOnly(storeFolder);
+        try {
+            assertThatThrownBy(() -> store.save(rule("known rule"), ImmutableList.of()))
+                    .isInstanceOf(StoreUpdateFailedException.class)
+                    .hasMessageContaining("known rule");
+        } finally {
+            Files.setPosixFilePermissions(storeFolder.toPath(), originalPermissions);
+        }
+
+        assertThat(store.contains(rule("known rule"))).isTrue();
+        assertThat(readIndex()).containsOnlyKeys("known rule");
+        assertThat(ruleFile).exists();
+    }
+
+    private Set<PosixFilePermission> makeReadOnly(File folder) throws IOException {
+        assumeTrue(Files.getFileAttributeView(folder.toPath(), PosixFileAttributeView.class) != null, "POSIX permissions are supported");
+        Set<PosixFilePermission> originalPermissions = Files.getPosixFilePermissions(folder.toPath());
+        Files.setPosixFilePermissions(folder.toPath(), EnumSet.of(OWNER_READ, OWNER_EXECUTE));
+        assumeTrue(!Files.isWritable(folder.toPath()), "permissions are enforced for the current user");
+        return originalPermissions;
+    }
+
+    private static void createSymbolicLink(File link, File target) throws IOException {
+        try {
+            Files.createSymbolicLink(link.toPath(), target.toPath());
+        } catch (UnsupportedOperationException | FileSystemException e) {
+            assumeTrue(false, "symbolic links are supported: " + e);
+        }
+    }
+
+    private ViolationStore initializedRepairingStore() {
+        return initializedStore("default.integrity", "repair");
+    }
+
+    private ViolationStore initializedStore(String... keyValuePairs) {
+        ViolationStore store = new TextFileBasedViolationStore();
+        store.initialize(storeProperties(keyValuePairs));
+        return store;
+    }
+
+    private Properties storeProperties(String... keyValuePairs) {
+        Properties result = new Properties();
+        result.setProperty("default.path", storeFolder.getAbsolutePath());
+        result.setProperty("default.allowStoreCreation", String.valueOf(true));
+        for (int i = 0; i < keyValuePairs.length; i += 2) {
+            result.setProperty(keyValuePairs[i], keyValuePairs[i + 1]);
+        }
+        return result;
+    }
+
+    private static Map<String, String> entries(String... ruleFilePairs) {
+        Map<String, String> result = new LinkedHashMap<>();
+        for (int i = 0; i < ruleFilePairs.length; i += 2) {
+            result.put(ruleFilePairs[i], ruleFilePairs[i + 1]);
+        }
+        return result;
+    }
+
+    private void writeIndex(Map<String, String> entries) throws IOException {
+        Properties properties = new Properties();
+        properties.putAll(entries);
+        try (FileOutputStream outputStream = new FileOutputStream(new File(storeFolder, "stored.rules"))) {
+            properties.store(outputStream, "");
+        }
+    }
+
+    private Map<String, String> readIndex() throws IOException {
+        Properties properties = new Properties();
+        try (FileInputStream inputStream = new FileInputStream(new File(storeFolder, "stored.rules"))) {
+            properties.load(inputStream);
+        }
+        Map<String, String> result = new LinkedHashMap<>();
+        properties.stringPropertyNames().forEach(key -> result.put(key, properties.getProperty(key)));
+        return result;
+    }
+
+    private static File writeFile(File folder, String name, String content) throws IOException {
+        File file = new File(folder, name);
+        Files.write(file.toPath(), content.getBytes(UTF_8));
+        return file;
+    }
+
+    private static ArchRule rule(String description) {
+        return classes().should().bePublic().as(description);
+    }
+}
diff --git a/docs/userguide/008_The_Library_API.adoc b/docs/userguide/008_The_Library_API.adoc
index 10ed830..41354af 100644
--- a/docs/userguide/008_The_Library_API.adoc
+++ b/docs/userguide/008_The_Library_API.adoc
@@ -495,6 +495,29 @@ For example to allow the creation of the violation store in a specific environme
 -Darchunit.freeze.store.default.allowStoreCreation=true
 ----
 
+Over time, the index file `stored.rules` and the individual violation files can get out of sync,
+e.g. if violation files are deleted manually or if all violations of a rule have been fixed.
+The violation store can maintain its integrity by itself:
+
+[source,options="nowrap"]
+.archunit.properties
+----
+# can be set to repair to maintain the integrity of the index and the violation files
+# default is ignore, which checks nothing
+freeze.store.default.integrity=repair
+----
+
+With `repair` the index and the violation files are checked as they are on disk every time the store is initialized.
+Index entries that do not point to a regular file directly within the store folder are broken and will be discarded
+without touching whatever they point to. Index entries whose file contains no violations (i.e. at most line breaks)
+are resolved and will be discarded together with their file (and, if the file is a symbolic link, together with the file it points to).
+Index entries that point to the same file name as another entry, or to the same regular file (also through symbolic or hard links),
+are shared and will never be touched by the repair. Neither will any file that no index entry points to.
+Furthermore, once there are no violations left for a frozen rule, the store will forget the rule,
+i.e. remove its index entry together with its file (unless another entry shares that file, in which case only the entry is removed).
+Rules without any violations will not be stored at all.
+Note that the repair respects `allowStoreUpdate`, i.e. if updates are forbidden, the store will not be modified.
+
 It is also possible to allow all violations to be "refrozen", i.e. the store will just be updated
 with the current state, and the reported result will be success. Thus, it is effectively the same behavior
 as if all rules would never have been frozen.
diff --git a/test.sh b/test.sh
new file mode 100755
index 0000000..79eb0c8
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,183 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+INVOKE_DIR="$PWD"
+cd "$(dirname "$0")"
+
+usage() {
+  echo "Usage: $0 --output_path <path> {base|new}" >&2
+  exit 2
+}
+
+OUTPUT_PATH=""
+MODE=""
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --output_path)
+      [[ $# -ge 2 ]] || usage
+      OUTPUT_PATH="$2"
+      shift 2
+      ;;
+    base|new)
+      MODE="$1"
+      shift
+      ;;
+    *)
+      usage
+      ;;
+  esac
+done
+
+if [[ -z "$OUTPUT_PATH" || -z "$MODE" ]]; then
+  usage
+fi
+
+case "$OUTPUT_PATH" in
+  /*) ;;
+  *) OUTPUT_PATH="$INVOKE_DIR/$OUTPUT_PATH" ;;
+esac
+
+if [[ -L "$OUTPUT_PATH" || ( -e "$OUTPUT_PATH" && ! -f "$OUTPUT_PATH" ) ]]; then
+  echo "Output path $OUTPUT_PATH is not a regular file" >&2
+  exit 2
+fi
+
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+# a report an earlier run left at the output path must never pass for the result of this run
+rm -f "$OUTPUT_PATH"
+
+case "$MODE" in
+  base)
+    GRADLE_TARGET="freezeStoreBaselineTest"
+    RESULT_DIR="archunit/build/test-results/freezeStoreBaselineTest"
+    # the baseline suites guard existing behaviour, so they always run as the base commit ships them,
+    # whatever a change did to their sources, committed or not
+    BASELINE_TESTS=(
+      archunit/src/test/java/com/tngtech/archunit/library/freeze/TextFileBasedViolationStoreTest.java
+      archunit/src/test/java/com/tngtech/archunit/library/freeze/TextFileBasedViolationStoreConcurrencyTest.java
+      archunit/src/test/java/com/tngtech/archunit/library/freeze/FreezingArchRuleTest.java
+    )
+    git -c safe.directory="$PWD" checkout ab6a677dd4b678f0ab1d9481df17222916705170 -- "${BASELINE_TESTS[@]}" \
+      || git -c safe.directory="$PWD" checkout HEAD -- "${BASELINE_TESTS[@]}" \
+      || echo "Could not restore the baseline test sources, running them as they are" >&2
+    ;;
+  new)
+    GRADLE_TARGET="freezeStoreMaintenanceTest"
+    RESULT_DIR="archunit/build/test-results/freezeStoreMaintenanceTest"
+    ;;
+esac
+
+SCRATCH="$(mktemp -d)"
+STAGED=""
+trap 'rm -rf "$SCRATCH"; [[ -z "$STAGED" ]] || rm -f "$STAGED"' EXIT
+
+rm -rf "$RESULT_DIR"
+
+# the jdk9main compilation shares this output directory and can prune classes of an incremental
+# build, so every run compiles it from scratch
+rm -rf archunit/build/classes/java/main
+
+set +e
+./gradlew --offline --no-daemon -Dscan=false ":archunit:${GRADLE_TARGET}" 2>&1 | tee "$SCRATCH/gradle.log"
+STATUS="${PIPESTATUS[0]}"
+set -e
+
+cat > "$SCRATCH/MalformedXml.java" <<'EOF'
+import java.io.File;
+import javax.xml.XMLConstants;
+import javax.xml.parsers.DocumentBuilder;
+import javax.xml.parsers.DocumentBuilderFactory;
+import org.xml.sax.helpers.DefaultHandler;
+
+public class MalformedXml {
+    public static void main(String[] args) throws Exception {
+        DocumentBuilderFactory factory = DocumentBuilderFactory.newInstance();
+        factory.setFeature("http://apache.org/xml/features/disallow-doctype-decl", true);
+        factory.setFeature(XMLConstants.FEATURE_SECURE_PROCESSING, true);
+        factory.setAttribute(XMLConstants.ACCESS_EXTERNAL_DTD, "");
+        factory.setAttribute(XMLConstants.ACCESS_EXTERNAL_SCHEMA, "");
+        factory.setXIncludeAware(false);
+        factory.setExpandEntityReferences(false);
+        DocumentBuilder builder = factory.newDocumentBuilder();
+        builder.setErrorHandler(new DefaultHandler());
+        for (String path : args) {
+            try {
+                builder.parse(new File(path));
+            } catch (Exception e) {
+                System.out.println(path);
+            }
+        }
+    }
+}
+EOF
+
+# prints every given file that is not well-formed XML, or all of them if they cannot be checked
+malformed_among() {
+  local checked
+  if checked="$(java "$SCRATCH/MalformedXml.java" "$@")"; then
+    [[ -z "$checked" ]] || printf '%s\n' "$checked"
+  else
+    printf '%s\n' "$@"
+  fi
+}
+
+error_suite() {
+  local name="$1" message="$2" details="$3"
+  echo "<testsuite name=\"${name}\" tests=\"1\" skipped=\"0\" failures=\"0\" errors=\"1\">"
+  echo "<testcase classname=\"${GRADLE_TARGET}\" name=\"${name}\">"
+  echo "<error message=\"${message}\"><![CDATA["
+  tail -n 200 "$details" | tr -d '\000-\010\013\014\016-\037' | sed 's/]]>/]]]]><![CDATA[>/g'
+  echo ']]></error>'
+  echo '</testcase>'
+  echo '</testsuite>'
+}
+
+REPORT="$SCRATCH/report.xml"
+shopt -s nullglob
+RESULT_FILES=("$RESULT_DIR"/*.xml)
+shopt -u nullglob
+
+MALFORMED=()
+if [[ ${#RESULT_FILES[@]} -gt 0 ]]; then
+  mapfile -t MALFORMED < <(malformed_among "${RESULT_FILES[@]}")
+fi
+
+{
+  echo '<?xml version="1.0" encoding="UTF-8"?>'
+  echo '<testsuites>'
+  for result_file in "${RESULT_FILES[@]}"; do
+    if [[ " ${MALFORMED[*]} " == *" ${result_file} "* ]]; then
+      echo "Malformed JUnit XML: $result_file" >&2
+      error_suite "$(basename "$result_file" .xml)" "Malformed JUnit XML produced by ${GRADLE_TARGET}" "$result_file"
+    else
+      sed '1{/^<?xml/d;}' "$result_file"
+    fi
+  done
+  if [[ ${#RESULT_FILES[@]} -eq 0 ]]; then
+    echo "No JUnit XML was produced by $GRADLE_TARGET" >&2
+    error_suite "build" "Gradle produced no JUnit XML for ${GRADLE_TARGET}" "$SCRATCH/gradle.log"
+  fi
+  echo '</testsuites>'
+} > "$REPORT"
+
+if [[ ${#RESULT_FILES[@]} -eq 0 || ${#MALFORMED[@]} -gt 0 ]] && [[ "$STATUS" -eq 0 ]]; then
+  STATUS=1
+fi
+
+if [[ -n "$(malformed_among "$REPORT")" ]]; then
+  echo "The merged JUnit XML is malformed" >&2
+  printf '%s\n' '<?xml version="1.0" encoding="UTF-8"?>' '<testsuites>' \
+    "<testsuite name=\"report\" tests=\"1\" skipped=\"0\" failures=\"0\" errors=\"1\">" \
+    "<testcase classname=\"${GRADLE_TARGET}\" name=\"report\"><error message=\"Malformed JUnit XML\"/></testcase>" \
+    '</testsuite>' '</testsuites>' > "$REPORT"
+  STATUS=1
+fi
+
+# publish the report of this run in one step, so the output path never holds a partial one
+STAGED="$(mktemp "$(dirname "$OUTPUT_PATH")/.results.XXXXXX")"
+cp "$REPORT" "$STAGED"
+chmod 644 "$STAGED"
+mv -f "$STAGED" "$OUTPUT_PATH"
+STAGED=""
+exit "$STATUS"
