+                // resolve the same way as when reading or writing the rule violation file
+                path = new File(storeFolder, fileName).toPath();
+            } catch (InvalidPathException e) {
+                return new RuleFile(fileName, null, null, false);
+            }
+            return new RuleFile(fileName, path, readRegularFileAttributes(path), isDirectlyWithin(storeFolder, path));
+        }
+
+        private static BasicFileAttributes readRegularFileAttributes(Path path) {
+            try {
+                BasicFileAttributes attributes = Files.readAttributes(path, BasicFileAttributes.class);
+                return attributes.isRegularFile() ? attributes : null;
+            } catch (IOException e) {
+                return null;
+            }
+        }
+
+        private static boolean isDirectlyWithin(File folder, Path path) {
+            // the path itself might be a symbolic link pointing anywhere, but the folder containing it must be the store folder
+            Path parent = path.getParent();
+            try {
+                return parent != null && Files.isSameFile(parent, folder.toPath());
+            } catch (IOException e) {
+                return false;
+            }
+        }
+
+        boolean isRegularFile() {
+            return attributes != null;
+        }
+
+        boolean isBroken() {
+            return !isRegularFile() || !directlyWithinStoreFolder;
+        }
+
+        boolean isResolved() {
+            try {
+                return !isBroken() && containsOnlyLineBreaks();
+            } catch (IOException e) {
+                return false;
+            }
+        }
+
+        private boolean containsOnlyLineBreaks() throws IOException {
+            try (InputStream inputStream = new BufferedInputStream(Files.newInputStream(path))) {
+                for (int next = inputStream.read(); next != -1; next = inputStream.read()) {
+                    if (next != '\n' && next != '\r') {
+                        return false;
+                    }
+                }
+                return true;
+            }
+        }
+
+        boolean pointsToSameFileAs(RuleFile other) {
+            if (fileName.equals(other.fileName)) {
+                return true;
+            }
+            try {
+                return isRegularFile() && other.isRegularFile() && Files.isSameFile(path, other.path);
+            } catch (IOException e) {
+                return false;
+            }
+        }
+
+        void delete() throws IOException {
+            if (Files.isSymbolicLink(path)) {
+                Files.deleteIfExists(path.toRealPath());
+            }
+            Files.deleteIfExists(path);
+        }
+
+        @Override
+        public String toString() {
+            return path != null ? path.toString() : fileName;
+        }
+    }
