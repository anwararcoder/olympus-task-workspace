+    private static boolean isDirectlyWithinFolder(String fileName, Path storeFolderPath) {
+        if (fileName == null || fileName.trim().isEmpty()) {
+            return false;
+        }
+        try {
+            Path p = Paths.get(fileName);
+            if (p.isAbsolute()) {
+                Path parent = p.normalize().getParent();
+                return parent != null && parent.equals(storeFolderPath);
+            }
+            if (fileName.contains("/") || fileName.contains("\\")) {
+                return false;
+            }
+            return p.getNameCount() == 1 && !p.toString().equals(".") && !p.toString().equals("..");
+        } catch (Exception e) {
+            return false;
+        }
+    }
+
