+    private static String descriptionFileName(String description) {
+        String word = "rule";
+        Matcher matcher = DESCRIPTION_WORD_PATTERN.matcher(description);
+        while (matcher.find()) {
+            word = matcher.group();
+        }
+
+        StringBuilder sanitized = new StringBuilder();
+        for (int i = 0; i < description.length(); i++) {
+            char character = description.charAt(i);
+            if ((character >= 'a' && character <= 'z') || (character >= 'A' && character <= 'Z')
+                    || (character >= '0' && character <= '9') || character == '_' || character == '-') {
+                sanitized.append(character);
+            } else {
+                sanitized.append('_');
+            }
+        }
+        String hash = sha256(description);
+        String full = "description_" + sanitized + "_" + hash;
+        if (full.length() <= MAX_BUILT_IN_FILE_NAME_LENGTH) {
+            return full;
+        }
+
+        int wordLength = Math.min(word.length(), 120);
+        String preservedWord = word.substring(0, wordLength);
+        String prefix = "description_" + preservedWord + "_";
+        int remaining = MAX_BUILT_IN_FILE_NAME_LENGTH - prefix.length() - hash.length();
+        if (remaining < 0) {
+            return (prefix + hash).substring(0, MAX_BUILT_IN_FILE_NAME_LENGTH);
+        }
+        String shortened = sanitized.substring(0, Math.min(remaining, sanitized.length()));
+        return prefix + shortened + hash;
+    }
