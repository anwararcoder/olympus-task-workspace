+        } finally {
+            assertThat(storeFolder.setWritable(true)).isTrue();
+        }
+
+        assertThat(readIndex()).containsOnlyKeys("resolved");
+        assertThat(new File(storeFolder, "resolved-file")).exists();
+    }
+
+    @Test
+    public void does_not_touch_entries_sharing_a_file_name() throws IOException {
+        writeStoreFile("shared-file", "");
+        writeIndex(
+                "shared resolved 1", "shared-file",
+                "shared resolved 2", "./shared-file",
+                "shared missing 1", "missing",
+                "shared missing 2", "missing",
+                "shared invalid 1", "in\0valid",
+                "shared invalid 2", "in\0valid",
+                "shared outside 1", "../outside/missing",
+                "shared outside 2", "../outside/missing");
+
+        initializedRepairingStore();
+
+        assertThat(readIndex()).containsOnlyKeys(
+                "shared resolved 1", "shared resolved 2",
+                "shared missing 1", "shared missing 2",
+                "shared invalid 1", "shared invalid 2",
+                "shared outside 1", "shared outside 2");
+        assertThat(new File(storeFolder, "shared-file")).exists();
+    }
+
+    @Test
+    public void does_not_touch_entries_sharing_a_regular_file_through_links() throws IOException {
+        File outsideFile = writeFile(new File(outsideFolder, "outside"), "");
+        Files.createSymbolicLink(storeFolder.toPath().resolve("symbolic-link"), outsideFile.toPath());
+        File resolvedFile = writeStoreFile("resolved-file", "");
+        Files.createLink(storeFolder.toPath().resolve("hard-link"), resolvedFile.toPath());
+        writeIndex(
+                "symbolic link", "symbolic-link",
+                "outside", outsideFile.getAbsolutePath(),
+                "resolved", "resolved-file",
+                "hard link", "hard-link");
+
+        initializedRepairingStore();
+
+        assertThat(readIndex()).containsOnlyKeys("symbolic link", "outside", "resolved", "hard link");
+        assertThat(outsideFile).exists();
+        assertThat(new File(storeFolder, "symbolic-link")).exists();
+        assertThat(resolvedFile).exists();
+        assertThat(new File(storeFolder, "hard-link")).exists();
+    }
+
+    @Test
+    public void does_not_touch_files_no_entry_points_to() throws IOException {
+        File orphan = writeStoreFile("orphan", "");
+        writeIndex();
+
+        initializedRepairingStore();
+
+        assertThat(orphan).exists();
+    }
+
+    @Test
+    public void does_not_repair_if_store_update_is_disabled() throws IOException {
+        writeIndex("resolved", "resolved-file", "broken", "missing");
+        writeStoreFile("resolved-file", "");
+
+        initializedStore(storeProperties("default.integrity", "repair", "default.allowStoreUpdate", "false"));
+
+        assertThat(readIndex()).containsOnlyKeys("resolved", "broken");
+        assertThat(new File(storeFolder, "resolved-file")).exists();
+    }
+
+    @Test
+    public void forgets_known_rule_when_saving_no_violations() {
+        ViolationStore store = initializedRepairingStore();
+        store.save(rule("known"), ImmutableList.of("violation"));
+        String fileName = readIndex().getProperty("known");
+
+        store.save(rule("known"), ImmutableList.of());
+
+        assertThat(store.contains(rule("known"))).isFalse();
+        assertThat(readIndex()).isEmpty();
+        assertThat(new File(storeFolder, fileName)).doesNotExist();
+    }
+
+    @Test
+    public void forgets_known_symbolic_link_and_the_file_it_points_to_when_saving_no_violations() throws IOException {
+        File target = writeFile(new File(outsideFolder, "target"), "violation\n");
+        Path link = Files.createSymbolicLink(storeFolder.toPath().resolve("link"), target.toPath());
+        writeIndex("known", "link");
+        ViolationStore store = initializedRepairingStore();
+
+        store.save(rule("known"), ImmutableList.of());
+
+        assertThat(readIndex()).isEmpty();
+        assertThat(Files.exists(link, NOFOLLOW_LINKS)).isFalse();
+        assertThat(target).doesNotExist();
+    }
+
+    @Test
+    public void only_removes_entry_of_shared_rule_when_saving_no_violations() throws IOException {
+        File sharedFile = writeStoreFile("shared-file", "violation\n");
+        File outsideFile = writeFile(new File(outsideFolder, "outside"), "violation\n");
+        writeIndex(
+                "shared 1", "shared-file",
+                "shared 2", "shared-file",
+                "shared outside 1", "../outside/outside",
+                "shared outside 2", "../outside/outside");
+        ViolationStore store = initializedRepairingStore();
+
+        store.save(rule("shared 1"), ImmutableList.of());
+        store.save(rule("shared outside 1"), ImmutableList.of());
+
+        assertThat(readIndex()).containsOnlyKeys("shared 2", "shared outside 2");
+        assertThat(sharedFile).exists();
+        assertThat(outsideFile).exists();
+        assertThat(store.getViolations(rule("shared 2"))).containsExactly("violation");
+    }
+
+    @Test
+    public void saves_nothing_for_unknown_rule_without_violations() {
+        ViolationStore store = initializedRepairingStore();
+
+        store.save(rule("unknown"), ImmutableList.of());
+
+        assertThat(store.contains(rule("unknown"))).isFalse();
+        assertThat(readIndex()).isEmpty();
+        assertThat(storeFolder.list()).containsOnly("stored.rules");
+    }
+
+    @Test
+    public void fails_to_save_and_keeps_entry_if_file_of_forgotten_rule_cannot_be_deleted() {
+        ViolationStore store = initializedRepairingStore();
+        store.save(rule("known"), ImmutableList.of("violation"));
+        String fileName = readIndex().getProperty("known");
+        makeStoreFolderReadOnly();
+
+        try {
+            assertThatThrownBy(() -> store.save(rule("known"), ImmutableList.of()))
+                    .isInstanceOf(StoreUpdateFailedException.class)
+                    .hasMessageContaining(fileName);
+        } finally {
+            assertThat(storeFolder.setWritable(true)).isTrue();
+        }
+
+        assertThat(store.getViolations(rule("known"))).containsExactly("violation");
+        assertThat(readIndex()).containsOnlyKeys("known");
+    }
+
+    private void makeStoreFolderReadOnly() {
+        assertThat(storeFolder.setWritable(false)).isTrue();
+        assumeFalse(storeFolder.canWrite(), "store folder cannot be made read only (e.g. when running as root)");
+    }
+
+    private ViolationStore initializedRepairingStore() {
+        return initializedStore(storeProperties("default.integrity", "repair"));
+    }
+
+    private ViolationStore initializedStore(Properties properties) {
+        ViolationStore store = new TextFileBasedViolationStore();
+        store.initialize(properties);
+        return store;
+    }
+
+    private Properties storeProperties(String... additionalKeyValuePairs) {
+        Properties result = propertiesOf(additionalKeyValuePairs);
+        result.setProperty("default.path", storeFolder.getAbsolutePath());
+        result.setProperty("default.allowStoreCreation", String.valueOf(true));
+        return result;
+    }
+
+    private void writeIndex(String... ruleFileNamePairs) throws IOException {
+        try (FileOutputStream outputStream = new FileOutputStream(new File(storeFolder, "stored.rules"))) {
+            propertiesOf(ruleFileNamePairs).store(outputStream, "");
+        }
+    }
+
+    private Properties readIndex() {
+        Properties properties = new Properties();
+        try (FileInputStream inputStream = new FileInputStream(new File(storeFolder, "stored.rules"))) {
+            properties.load(inputStream);
+        } catch (IOException e) {
+            throw new RuntimeException(e);
+        }
+        return properties;
+    }
+
+    private File writeStoreFile(String fileName, String content) throws IOException {
+        return writeFile(new File(storeFolder, fileName), content);
+    }
+
+    private File writeFile(File file, String content) throws IOException {
+        Files.write(file.toPath(), content.getBytes(UTF_8));
+        return file;
+    }
+
+    private Properties propertiesOf(String... keyValuePairs) {
+        Properties result = new Properties();
+        LinkedList<String> keyValues = new LinkedList<>(asList(keyValuePairs));
+        while (!keyValues.isEmpty()) {
+            result.setProperty(keyValues.poll(), keyValues.poll());
+        }
+        return result;
+    }
+
+    private ArchRule rule(String description) {
+        return classes().should().bePublic().as(description);
+    }
+}
