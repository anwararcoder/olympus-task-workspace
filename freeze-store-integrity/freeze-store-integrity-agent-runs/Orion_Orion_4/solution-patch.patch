+
+    @ParameterizedTest
+    @ValueSource(strings = {"missing", "resolved", "directory", "nested/violations", "../outside", "invalid\u0000"})
+    public void forgets_only_the_entry_when_file_names_are_shared(String fileName) throws IOException {
+        createSharedFileFixtures();
+        writeIndex("first rule", fileName, "second rule", fileName);
+        store.initialize(storeProperties("repair"));
+
+        store.save(rule("first rule"), ImmutableList.of());
+
+        assertThat(store.contains(rule("first rule"))).isFalse();
+        assertThat(store.contains(rule("second rule"))).isTrue();
+        assertThat(readIndex()).isEqualTo(properties("second rule", fileName));
+        assertSharedFileFixturesUnchanged();
+    }
+
+    @ParameterizedTest
+    @CsvSource({"symbolic, false", "symbolic, true", "hard, false", "hard, true"})
+    public void forgets_only_the_entry_when_files_are_shared_through_links(String linkType, boolean outside) throws IOException {
+        Path target = writeFile((outside ? temporaryFolder : storeFolder).resolve("target"), "");
+        Path link = storeFolder.resolve("link");
+        createLink(link, target, linkType);
+        String targetName = outside ? "../target" : "target";
+        writeIndex("first rule", "link", "second rule", targetName);
+        store.initialize(storeProperties("repair"));
+
+        store.save(rule("first rule"), ImmutableList.of());
+
+        assertThat(readIndex()).isEqualTo(properties("second rule", targetName));
+        assertThat(link).exists();
+        assertThat(target).exists();
+    }
+
+    @ParameterizedTest
+    @ValueSource(booleans = {false, true})
+    public void forgets_the_last_entry_and_deletes_its_file_even_outside_the_folder(boolean absolute) throws IOException {
+        Path target = writeFile(temporaryFolder.resolve("target"), "violation");
+        String targetName = absolute ? target.toString() : "../target";
+        writeIndex("first rule", targetName, "second rule", targetName);
+        store.initialize(storeProperties("repair"));
+        store.save(rule("first rule"), ImmutableList.of());
+        assertThat(target).exists();
+
+        store.save(rule("second rule"), ImmutableList.of());
+
+        assertThat(readIndex()).isEmpty();
+        assertThat(target).doesNotExist();
