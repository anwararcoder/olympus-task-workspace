+
+    @ParameterizedTest
+    @ValueSource(booleans = {false, true})
+    public void forgets_symbolic_links_and_deletes_their_targets(boolean outside) throws IOException {
+        Path target = writeFile((outside ? temporaryFolder : storeFolder).resolve("target"), "violation");
+        Path link = storeFolder.resolve("link");
+        createLink(link, target, "symbolic");
+        writeIndex("first rule", "link");
+        store.initialize(storeProperties("repair"));
+
+        store.save(rule("first rule"), ImmutableList.of());
+
+        assertThat(readIndex()).isEmpty();
+        assertThat(Files.exists(link, NOFOLLOW_LINKS)).isFalse();
+        assertThat(target).doesNotExist();
+    }
+
+    @ParameterizedTest
+    @ValueSource(booleans = {false, true})
+    public void forgets_rules_whose_files_have_already_been_deleted(boolean symbolicLink) throws IOException {
+        Path target = writeFile(storeFolder.resolve("target"), "violation");
+        Path indexedFile = symbolicLink ? storeFolder.resolve("link") : target;
+        if (symbolicLink) {
+            createLink(indexedFile, target, "symbolic");
+        }
+        writeIndex("first rule", indexedFile.getFileName().toString());
+        store.initialize(storeProperties("repair"));
+        Files.delete(target);
+
+        store.save(rule("first rule"), ImmutableList.of());
+
+        assertThat(store.contains(rule("first rule"))).isFalse();
+        assertThat(readIndex()).isEmpty();
+        assertThat(Files.exists(indexedFile, NOFOLLOW_LINKS)).isFalse();
+    }
+
+    @ParameterizedTest
+    @ValueSource(booleans = {false, true})
+    public void keeps_the_entry_if_deleting_its_file_fails(boolean symbolicLink) throws IOException {
+        Path target = writeFile(storeFolder.resolve("target"), "violation");
+        Path indexedFile = symbolicLink ? storeFolder.resolve("link") : target;
+        if (symbolicLink) {
+            createLink(indexedFile, target, "symbolic");
+        }
+        writeIndex("first rule", indexedFile.getFileName().toString());
+        store.initialize(storeProperties("repair"));
+        Files.delete(target);
+        Files.createDirectory(target);
+        Path child = writeFile(target.resolve("child"), "keep me");
+        byte[] originalIndex = Files.readAllBytes(indexFile());
+
+        assertThatThrownBy(() -> store.save(rule("first rule"), ImmutableList.of()))
+                .isInstanceOf(StoreUpdateFailedException.class);
+
+        assertThat(store.contains(rule("first rule"))).isTrue();
+        assertThat(Files.readAllBytes(indexFile())).isEqualTo(originalIndex);
+        assertThat(indexedFile).exists();
+        assertThat(new String(Files.readAllBytes(child), UTF_8)).isEqualTo("keep me");
+    }
+
+    @ParameterizedTest
+    @ValueSource(booleans = {false, true})
+    public void keeps_the_entry_if_permissions_prevent_deleting_its_file(boolean symbolicLink) throws IOException {
+        assumeTrue(Files.getFileStore(storeFolder).supportsFileAttributeView("posix"));
+        Path targetFolder = symbolicLink ? Files.createDirectory(temporaryFolder.resolve("targets")) : storeFolder;
+        Path target = writeFile(targetFolder.resolve("target"), "violation");
+        Path indexedFile = symbolicLink ? storeFolder.resolve("link") : target;
+        if (symbolicLink) {
+            createLink(indexedFile, target, "symbolic");
+        }
+        writeIndex("first rule", indexedFile.getFileName().toString());
+        store.initialize(storeProperties("repair"));
+        byte[] originalIndex = Files.readAllBytes(indexFile());
+        Set<PosixFilePermission> originalPermissions = Files.getPosixFilePermissions(targetFolder);
+        try {
+            Files.setPosixFilePermissions(targetFolder, PosixFilePermissions.fromString("r-xr-xr-x"));
+            assumeTrue(!Files.isWritable(targetFolder), "File system permissions must prevent deletion");
+
+            assertThatThrownBy(() -> store.save(rule("first rule"), ImmutableList.of()))
+                    .isInstanceOf(StoreUpdateFailedException.class);
+
+            assertThat(store.contains(rule("first rule"))).isTrue();
+            assertThat(Files.readAllBytes(indexFile())).isEqualTo(originalIndex);
+            assertThat(indexedFile).exists();
+            assertThat(new String(Files.readAllBytes(target), UTF_8)).isEqualTo("violation");
+        } finally {
+            Files.setPosixFilePermissions(targetFolder, originalPermissions);
+        }
+    }
+
+    private void createSharedFileFixtures() throws IOException {
+        writeFile(storeFolder.resolve("resolved"), "");
+        Files.createDirectory(storeFolder.resolve("directory"));
+        writeFile(Files.createDirectory(storeFolder.resolve("nested")).resolve("violations"), "");
+        writeFile(temporaryFolder.resolve("outside"), "");
+    }
+
+    private void assertSharedFileFixturesUnchanged() throws IOException {
+        assertThat(Files.size(storeFolder.resolve("resolved"))).isZero();
+        assertThat(storeFolder.resolve("directory")).isDirectory();
+        assertThat(Files.size(storeFolder.resolve("nested/violations"))).isZero();
+        assertThat(Files.size(temporaryFolder.resolve("outside"))).isZero();
+    }
+
+    private Path writeFile(Path path, String contents) throws IOException {
+        return Files.write(path, contents.getBytes(UTF_8));
+    }
+
+    private void createLink(Path link, Path target, String type) {
+        try {
+            if (type.equals("symbolic")) {
+                Files.createSymbolicLink(link, target.toAbsolutePath());
+            } else {
+                Files.createLink(link, target);
+            }
+        } catch (IOException | UnsupportedOperationException exception) {
+            assumeTrue(false, "Cannot create " + type + " link: " + exception);
+        }
+    }
+
+    private void writeIndex(String... entries) throws IOException {
+        try (OutputStream outputStream = Files.newOutputStream(indexFile())) {
+            properties(entries).store(outputStream, "");
+        }
+    }
+
+    private Properties readIndex() throws IOException {
+        Properties result = new Properties();
+        try (InputStream inputStream = Files.newInputStream(indexFile())) {
+            result.load(inputStream);
+        }
+        return result;
+    }
+
+    private Path indexFile() {
+        return storeFolder.resolve("stored.rules");
+    }
+
+    private Properties storeProperties(String integrity) {
+        Properties result = properties("default.path", storeFolder.toString(), "default.allowStoreCreation", "true");
+        if (integrity != null) {
+            result.setProperty("default.integrity", integrity);
+        }
+        return result;
+    }
+
+    private Properties properties(String... entries) {
+        Properties result = new Properties();
+        for (int index = 0; index < entries.length; index += 2) {
+            result.setProperty(entries[index], entries[index + 1]);
+        }
+        return result;
+    }
+
+    private ArchRule rule(String description) {
+        return classes().should().bePublic().as(description);
+    }
+}
