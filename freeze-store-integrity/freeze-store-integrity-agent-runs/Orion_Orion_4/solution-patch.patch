+        writeFile(changedFile, "\n");
+        writeFile(storeFolder.resolve("current"), "current violation");
+        writeIndex("current rule", "current", "changed rule", "changed", "broken rule", "missing");
+        ViolationStore reinitializedStore = newInstance ? new TextFileBasedViolationStore() : store;
+
+        reinitializedStore.initialize(storeProperties("repair"));
+
+        assertThat(readIndex()).isEqualTo(properties("current rule", "current"));
+        assertThat(reinitializedStore.contains(rule("previous rule"))).isFalse();
+        assertThat(reinitializedStore.contains(rule("changed rule"))).isFalse();
+        assertThat(reinitializedStore.getViolations(rule("current rule"))).containsExactly("current violation");
+        assertThat(store.contains(rule("current rule"))).isTrue();
+        assertThat(previousFile).exists();
+        assertThat(changedFile).doesNotExist();
+    }
+
+    @ParameterizedTest
+    @ValueSource(booleans = {false, true})
+    public void recreates_a_deleted_index_without_restoring_cached_entries(boolean deleteFolder) throws IOException {
+        Path violationFile = writeFile(storeFolder.resolve("violations"), "violation");
+        writeIndex("first rule", "violations");
+        store.initialize(storeProperties("repair"));
+        Files.delete(indexFile());
+        if (deleteFolder) {
+            Files.delete(violationFile);
+            Files.delete(storeFolder);
+        }
+
+        store.initialize(storeProperties("repair"));
+
+        assertThat(indexFile()).exists();
+        assertThat(readIndex()).isEmpty();
+        assertThat(store.contains(rule("first rule"))).isFalse();
+        if (!deleteFolder) {
+            assertThat(violationFile).exists();
+        }
+    }
+
+    @ParameterizedTest
+    @ValueSource(strings = {"first rule", "first\r\nrule"})
+    public void forgets_known_rules_when_saving_no_violations(String description) throws IOException {
+        store.initialize(storeProperties("repair"));
+        ArchRule firstRule = rule(description);
+        store.save(firstRule, ImmutableList.of("first violation"));
+        store.save(rule("second rule"), ImmutableList.of("second violation"));
+        Path violationFile = storeFolder.resolve(readIndex().getProperty(description.replace("\r\n", "\n")));
+
+        store.save(firstRule, ImmutableList.of());
+
+        assertThat(store.contains(firstRule)).isFalse();
+        assertThat(readIndex()).containsOnlyKeys("second rule");
+        assertThat(violationFile).doesNotExist();
+        assertThat(store.getViolations(rule("second rule"))).containsExactly("second violation");
+    }
+
+    @Test
+    public void does_not_save_unknown_rules_without_violations() throws IOException {
+        ViolationStore storeWithFailingFileNameStrategy = new TextFileBasedViolationStore(description -> {
+            throw new AssertionError("No file name should be generated for an unknown rule without violations");
+        });
+        storeWithFailingFileNameStrategy.initialize(storeProperties("repair"));
+        byte[] originalIndex = Files.readAllBytes(indexFile());
+
+        storeWithFailingFileNameStrategy.save(rule("unknown rule"), ImmutableList.of());
+
+        assertThat(storeWithFailingFileNameStrategy.contains(rule("unknown rule"))).isFalse();
+        assertThat(Files.readAllBytes(indexFile())).isEqualTo(originalIndex);
+        assertThat(storeFolder.toFile().list()).containsExactly("stored.rules");
