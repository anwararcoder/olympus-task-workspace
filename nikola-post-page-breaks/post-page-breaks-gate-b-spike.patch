 TEASER_REGEXP = re.compile(r'<!--\s*(TEASER_END|END_TEASER)(:(.+))?\s*-->', re.IGNORECASE)
+PAGE_BREAK_REGEXP = re.compile(r'\s*PAGE_BREAK(:(.+))?\s*$', re.IGNORECASE)
+
+
+def _page_breaks(document):
+    """Return the page break comments in a document, in document order."""
+    return [node for node in document.iter(lxml.etree.Comment) if PAGE_BREAK_REGEXP.match(node.text or '')]
+
+
+def _has_content(element):
+    """Tell whether an element holds anything besides whitespace and comments."""
+    if element.text and element.text.strip():
+        return True
+    return any(child.tag is not lxml.etree.Comment or (child.tail and child.tail.strip()) for child in element)
+
+
+def _append_text(element, text):
+    """Append text after the last child of an element."""
+    if not text:
+        return
+    if len(element):
+        element[-1].tail = (element[-1].tail or '') + text
+    else:
+        element.text = (element.text or '') + text
+
+
+def _split_at(element, marker):
+    """Split an element around a page break it contains.
+
+    The part before the break keeps the element's attributes; the part
+    after it repeats them, except for the id.
+    """
+    before = lxml.html.Element(element.tag, element.attrib)
+    before.text = element.text
+    after = lxml.html.Element(element.tag, {k: v for k, v in element.attrib.items() if k != 'id'})
+    target = before
+    items_before = 0
+    for child in list(element):
+        if child is marker:
+            target = after
+            _append_text(after, child.tail)
+        elif target is before and any(node is marker for node in child.iterdescendants()):
+            head, rest = _split_at(child, marker)
+            before.append(head)
+            target = after
+            if _has_content(rest):
+                rest.tail = child.tail
+                after.append(rest)
+            else:
+                _append_text(after, child.tail)
+        else:
+            if target is before and child.tag == 'li':
+                items_before += 1
+            target.append(child)
+    if element.tag == 'ol' and items_before:
+        after.set('start', str(int(element.get('start', 1)) + items_before))
+    return before, after
+
+
+def split_pages(document):
+    """Split a post document into pages at its page breaks.
+
+    Return a list of (page, label) pairs, the label being the one given by
+    the break the page follows. A break that would leave a page without
+    content is ignored.
+    """
+    pages = []
+    rest = document
+    label = None
+    for marker in _page_breaks(document):
