+    {% if post_page_links|length > 1 %}
+        <nav class="postpages hidden-print">
+        <ul class="pager">
+        {% if post_page != 'all' and post_page > 1 %}
+            <li class="previous"><a href="{{ post_page_links[post_page - 2] }}" rel="prev">{{ messages("Previous") }}</a></li>
+        {% endif %}
+        {% for number, link in enumerate(post_page_links, 1) %}
+            {% if number == post_page %}
+            <li class="current-page">{{ (post_page_labels[number - 1] or number)|e }}</li>
+            {% else %}
+            <li><a href="{{ link }}">{{ (post_page_labels[number - 1] or number)|e }}</a></li>
+            {% endif %}
+        {% endfor %}
+        {% if post_page != 'all' and post_page < post_page_links|length %}
+            <li class="next"><a href="{{ post_page_links[post_page] }}" rel="next">{{ messages("Next") }}</a></li>
+        {% endif %}
+        {% if post_single_page_link and post_page != 'all' %}
+            <li class="single-page"><a href="{{ post_single_page_link }}">{{ messages("All on one page") }}</a></li>
+        {% endif %}
+        </ul>
+        </nav>
+    {% endif %}
+{% endmacro %}
